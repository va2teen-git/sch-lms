        document.getElementById('p3-param-constraint').textContent = tpl.constraint;

        p3Slider.value = '1';
        updateP3SliderDisplay();

        const tokens = [
            { role: 'storage', label: tpl.correctStorage },
            { role: 'protection', label: tpl.correctProtection },
            ...tpl.distractors.map((label) => ({ role: 'distractor', label }))
        ];

        shuffle(tokens).forEach((item, idx) => {
