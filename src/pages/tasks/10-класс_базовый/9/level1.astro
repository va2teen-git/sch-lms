    p3SubmitBtn.addEventListener('click', () => {
        if (isProcessing || !p3Current) return;
        const userTime = Number(p3Slider.value);
        const storageTok = document.getElementById('slot-p3-storage').querySelector('.p3-token');
        const protectionTok = document.getElementById('slot-p3-protection').querySelector('.p3-token');

        if (userTime !== p3Current.expectedTime) {
            triggerError('Время передачи откалибровано неверно! Не забудьте перевести Мбайты в Мбиты (× 8) перед делением на скорость.', initPhase3);
            return;
        }
        if (!storageTok || storageTok.dataset.role !== 'storage') {
            triggerError('Выбранный носитель не соответствует требованиям хранения (проверьте энергозависимость, емкость и условия доступа)!', initPhase3);
            return;
        }
        if (!protectionTok || protectionTok.dataset.role !== 'protection') {
            triggerError('Метод защиты от помех или потери данных подобран неверно!', initPhase3);
            return;
        }

        finishLevel();
    });

    // =====================================================
    // ПЕРЕХОДЫ МЕЖДУ ФАЗАМИ И ЗАВЕРШЕНИЕ
    // =====================================================
    function goToPhase2() {
        currentPhase = 2;
        telemetry.advanceStage(2);
        document.getElementById('phase1-container').classList.add('d-none');
        document.getElementById('phase2-container').classList.remove('d-none');
        document.getElementById('phase-badge').textContent = 'Шаг 2 из 3';
        document.getElementById('phase-title').textContent = 'Схема канала связи К. Шеннона';
        document.getElementById('phase-desc').innerHTML = 'Перетащите 6 подходящих узлов в слоты схемы передачи данных. Помните: 2 блока в палитре — лишние дистракторы!';
        initPhase2();
    }

    function goToPhase3() {
        currentPhase = 3;
        telemetry.advanceStage(3);
        document.getElementById('phase2-container').classList.add('d-none');
        document.getElementById('phase3-container').classList.remove('d-none');
        document.getElementById('phase-badge').textContent = 'Шаг 3 из 3';
        document.getElementById('phase-title').textContent = 'Калибратор канала и подбор защищенного хранилища';
        document.getElementById('phase-desc').innerHTML = 'Выставьте точное время передачи файла на калибраторе и установите в слоты верные модули хранения и защиты от потерь (остерегайтесь ловушек!).';
        initPhase3();
    }

    function finishLevel() {
        if (isLevelCompleted) return;
        isLevelCompleted = true;
        const timeSpent = Math.max(1, telemetry.getTimeSpentSec());
        const m = String(Math.floor(timeSpent / 60)).padStart(2, '0');
        const s = String(timeSpent % 60).padStart(2, '0');

        document.getElementById('phase3-container').classList.add('d-none');
        document.getElementById('phase-badge').classList.replace('bg-success', 'bg-info');
        document.getElementById('phase-badge').textContent = 'Пройдено';
        document.getElementById('phase-title').textContent = 'Аттестация Уровня 1 завершена';
        document.getElementById('phase-desc').classList.add('d-none');

        document.getElementById('victory-screen').classList.remove('d-none');
        document.getElementById('final-time').textContent = `${m}:${s}`;
        document.getElementById('final-attempts').textContent = String(telemetry.getState().attemptsCount);

        telemetry.complete({ stage: 3 });
    }

    document.getElementById('restart-level-btn').addEventListener('click', () => {
        location.reload();
    });

    // DEV-состояние для автотестов Playwright
    window.__DEV_LEVEL1_STATE__ = {
        getPhase: () => currentPhase,
        getAttempts: () => telemetry.getState().attemptsCount,
        getPhase3Target: () => p3Current ? { ...p3Current } : null
    };

    initPhase1();
});
</script>
