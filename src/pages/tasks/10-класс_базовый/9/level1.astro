    // =====================================================
    const P3_TRANSMISSION_CASES = [
        { sizeMB: 20, speedMbps: 16 },   // 10s
        { sizeMB: 30, speedMbps: 16 },   // 15s
        { sizeMB: 40, speedMbps: 16 },   // 20s
        { sizeMB: 45, speedMbps: 24 },   // 15s
        { sizeMB: 60, speedMbps: 24 },   // 20s
        { sizeMB: 75, speedMbps: 24 },   // 25s
