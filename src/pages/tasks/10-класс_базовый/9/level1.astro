    const p3Slots = Array.from(document.querySelectorAll('#phase3-container .p3-slot'));

    let p3Current = null;

    function updateP3SliderDisplay() {
        if (p3SliderVal && p3Slider) {
            p3SliderVal.textContent = String(p3Slider.value);
