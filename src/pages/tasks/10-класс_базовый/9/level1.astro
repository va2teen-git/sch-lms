    const p2Slots = Array.from(document.querySelectorAll('#phase2-container .p2-slot'));
    let p2CurrentScenario = null;

    function updateP2State() {
        let filled = 0;
        p2Slots.forEach((slot) => {
            if (slot.querySelector('.p2-token')) filled++;
        });
        if (p2SubmitBtn) {
            p2SubmitBtn.disabled = filled !== 6;
            p2SubmitBtn.textContent = `Запустить контур связи (${filled}/6)`;
        }
    }

    function returnP2SlotTokensToPool(slot) {
        const existing = slot.querySelector('.p2-token');
        if (existing) {
            p2PoolEl.appendChild(existing);
        }
        if (!slot.querySelector('.p2-token') && slot.dataset.placeholder) {
            slot.textContent = slot.dataset.placeholder;
            slot.classList.add('text-secondary');
        }
    }

    function placeP2Token(token, slot) {
        if (!token || !slot || !token.classList.contains('p2-token')) return;
        const oldParent = token.parentElement;
        if (slot === p2PoolEl) {
            p2PoolEl.appendChild(token);
            if (oldParent && oldParent.classList.contains('p2-slot')) {
                returnP2SlotTokensToPool(oldParent);
            }
        } else {
            returnP2SlotTokensToPool(slot);
            slot.textContent = '';
            slot.classList.remove('text-secondary');
            slot.appendChild(token);
            if (oldParent && oldParent.classList.contains('p2-slot') && oldParent !== slot) {
                returnP2SlotTokensToPool(oldParent);
            }
        }
        clearSelection();
        updateP2State();
    }

    function initPhase2() {
        clearSelection();
        p2PoolEl.innerHTML = '';
        p2Slots.forEach((slot) => {
            if (!slot.dataset.placeholder) {
                slot.dataset.placeholder = slot.textContent.trim();
            }
            slot.innerHTML = '';
            slot.textContent = slot.dataset.placeholder;
            slot.classList.add('text-secondary');
        });

        p2CurrentScenario = P2_SCENARIOS[Math.floor(Math.random() * P2_SCENARIOS.length)];
        document.getElementById('p2-scenario-title').textContent = p2CurrentScenario.title;
        document.getElementById('p2-scenario-hint').textContent = p2CurrentScenario.hint;

        const tokens = Object.entries(p2CurrentScenario.roles).map(([role, label]) => ({ role, label }));
        p2CurrentScenario.distractors.forEach((label) => {
            tokens.push({ role: 'distractor', label });
        });

        shuffle(tokens).forEach((item, idx) => {
            const btn = document.createElement('div');
            btn.id = `p2-tok-${idx}-${Date.now()}`;
            btn.className = 'p2-token badge bg-dark border border-secondary text-light rounded-0 p-2 text-start text-wrap lh-sm d-flex align-items-center w-auto';
            btn.style.cursor = 'grab';
            btn.style.minHeight = '48px';
            btn.style.maxWidth = '100%';
            btn.dataset.role = item.role;
            btn.textContent = item.label;
            attachTokenInteraction(btn);
            p2PoolEl.appendChild(btn);
        });

        updateP2State();
    }

    // Однократная привязка для Фазы 2
    p2Slots.forEach((slot) => {
        slot.addEventListener('dragover', (e) => e.preventDefault());
        slot.addEventListener('drop', (e) => {
            e.preventDefault();
            const id = e.dataTransfer.getData('text/plain');
            placeP2Token(document.getElementById(id), slot);
        });
        slot.addEventListener('click', () => {
            if (selectedItem && selectedItem.classList.contains('p2-token')) {
                placeP2Token(selectedItem, slot);
            }
        });
    });

    p2PoolEl.addEventListener('dragover', (e) => e.preventDefault());
    p2PoolEl.addEventListener('drop', (e) => {
        e.preventDefault();
        const id = e.dataTransfer.getData('text/plain');
        placeP2Token(document.getElementById(id), p2PoolEl);
    });
    p2PoolEl.addEventListener('click', () => {
        if (selectedItem && selectedItem.classList.contains('p2-token')) {
            placeP2Token(selectedItem, p2PoolEl);
        }
    });

    p2ResetBtn.addEventListener('click', () => {
        if (isProcessing) return;
        p2Slots.forEach((slot) => returnP2SlotTokensToPool(slot));
        clearSelection();
        updateP2State();
    });

    p2SubmitBtn.addEventListener('click', () => {
        if (isProcessing) return;
        let allCorrect = true;
        let hasDistractor = false;
        p2Slots.forEach((slot) => {
            const tok = slot.querySelector('.p2-token');
            if (!tok) {
                allCorrect = false;
                return;
            }
            if (tok.dataset.role === 'distractor') hasDistractor = true;
            if (tok.dataset.role !== slot.dataset.role) allCorrect = false;
        });

        if (!allCorrect) {
            const msg = hasDistractor
                ? 'В схему передачи попал лишний элемент-дистрактор, не относящийся к каналу связи!'
                : 'Звенья цепи передачи данных перепутаны! Восстановите порядок от источника к получателю.';
            triggerError(msg, initPhase2);
            return;
        }

        goToPhase3();
    });

    // =====================================================
