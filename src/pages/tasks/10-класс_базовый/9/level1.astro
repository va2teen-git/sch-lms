---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={1} title="Урок 9 :: Информационные процессы (Уровень 1)">
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h5 text-success mb-0">Тренажер: Информационные процессы. Передача и хранение (Уровень 1)</h2>
            <span class="badge border border-success text-success bg-dark rounded-0 px-3 py-2">Манипуляции мышью // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-success rounded-0">
            <div class="card-body p-3 p-md-4">

                <!-- Заголовок и прогресс -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="phase-badge" class="badge bg-success text-dark rounded-0 fs-6 me-2">Шаг 1 из 3</span>
                        <span id="phase-title" class="text-light fw-bold fs-6">Классификация информационных процессов</span>
                    </div>
                    <div class="text-secondary small">
                        Ошибки: <span id="attempts-display" class="text-warning fw-bold">0</span> | Время: <span id="timer-display" class="text-light fw-bold">00:00</span>
                    </div>
                </div>

                <!-- Описание задания -->
                <p id="phase-desc" class="text-light mb-3 small">
                    Перетащите карточки (или кликните по карточке, затем по целевому шлюзу) в соответствующие контейнеры процессов: <strong>Передача</strong>, <strong>Хранение</strong> и <strong>Защита от помех и потерь</strong>. Лишнюю карточку-дистрактор оставьте в пуле!
                </p>

                <!-- Окно системных уведомлений / ошибок -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <span>[СБОЙ КОНТУРА] <span id="feedback-text">Ошибка конфигурации!</span> Генерация нового варианта...</span>
                        <span class="spinner-border spinner-border-sm text-danger flex-shrink-0" role="status"></span>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ФАЗА 1: СОРТИРОВКА ПО ШЛЮЗАМ (DRAG-TO-BIN) -->
                <!-- ========================================== -->
                <div id="phase1-container" class="phase-section">
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <span class="text-secondary small">ПУЛ СИТУАЦИЙ (6 ЦЕЛЕВЫХ + 1 ДИСТРАКТОР):</span>
                            <button id="p1-reset-pool-btn" type="button" class="btn btn-sm btn-outline-secondary rounded-0 text-light" style="min-height: 48px; min-width: 140px;">
                                Сбросить в пул
                            </button>
                        </div>
                        <div id="p1-cards-pool" class="d-flex flex-wrap gap-2 p-2 border border-secondary bg-dark" style="min-height: 84px;">
                            <!-- Генерируется через JS -->
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-4">
                            <div class="card bg-black border-success rounded-0 h-100 target-bucket" data-category="transfer" id="bucket-transfer">
                                <div class="card-header bg-dark border-bottom border-success text-success d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold small">1. ПЕРЕДАЧА</span>
                                    <span class="badge border border-success text-success bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Перемещение сигнала от источника к получателю по каналу связи.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-success bg-dark d-flex flex-column gap-2" style="min-height: 150px;"></div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-4">
                            <div class="card bg-black border-info rounded-0 h-100 target-bucket" data-category="storage" id="bucket-storage">
                                <div class="card-header bg-dark border-bottom border-info text-info d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold small">2. ХРАНЕНИЕ</span>
                                    <span class="badge border border-info text-info bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Фиксация сведений на материальном или облачном носителе.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-info bg-dark d-flex flex-column gap-2" style="min-height: 150px;"></div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-4">
                            <div class="card bg-black border-warning rounded-0 h-100 target-bucket" data-category="protection" id="bucket-protection">
                                <div class="card-header bg-dark border-bottom border-warning text-warning d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold small">3. ЗАЩИТА ОТ ПОМЕХ / ПОТЕРЬ</span>
                                    <span class="badge border border-warning text-warning bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Контроль ошибок при передаче и резервные копии.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-warning bg-dark d-flex flex-column gap-2" style="min-height: 150px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p1-submit-btn" type="button" class="btn btn-success text-dark fw-bold rounded-0 px-4 py-2" style="min-height: 48px;" disabled>
                            Проверить распределение (0/6)
                        </button>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ФАЗА 2: СХЕМА КАНАЛА СВЯЗИ ШЕННОНА (SLOT & SNAP) -->
                <!-- ========================================== -->
                <div id="phase2-container" class="phase-section d-none">
                    <div class="card bg-black border-success rounded-0 p-3 mb-3">
                        <div class="small text-secondary mb-1">СЦЕНАРИЙ ПЕРЕДАЧИ ДАННЫХ:</div>
                        <div id="p2-scenario-title" class="text-light fw-bold fs-6 mb-1">Загрузка сценария...</div>
                        <div id="p2-scenario-hint" class="text-secondary small"></div>
                    </div>

                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <span class="text-secondary small">ПАЛИТРА УЗЛОВ (6 ЦЕЛЕВЫХ + 2 ДИСТРАКТОРА):</span>
                            <button id="p2-reset-pool-btn" type="button" class="btn btn-sm btn-outline-secondary rounded-0 text-light" style="min-height: 48px; min-width: 140px;">
                                Сбросить схему
                            </button>
                        </div>
                        <div id="p2-tokens-pool" class="d-flex flex-wrap gap-2 p-2 border border-secondary bg-dark" style="min-height: 76px;">
                            <!-- Генерируется через JS -->
                        </div>
                    </div>

                    <!-- Цепь Шеннона -->
                    <div class="row g-2 mb-3">
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="card bg-black border-secondary rounded-0 p-2 h-100">
                                <div class="small text-success fw-bold mb-1">1. ИСТОЧНИК ИНФОРМАЦИИ</div>
                                <div class="p2-slot border border-success bg-dark p-2 d-flex align-items-center justify-content-center text-center text-secondary small" data-role="source" id="slot-p2-source" style="min-height: 58px;">
                                    [Поместите источник]
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="card bg-black border-secondary rounded-0 p-2 h-100">
                                <div class="small text-success fw-bold mb-1">2. КОДИРУЮЩЕЕ УСТРОЙСТВО</div>
                                <div class="p2-slot border border-success bg-dark p-2 d-flex align-items-center justify-content-center text-center text-secondary small" data-role="encoder" id="slot-p2-encoder" style="min-height: 58px;">
                                    [Поместите кодер]
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="card bg-black border-secondary rounded-0 p-2 h-100">
                                <div class="small text-info fw-bold mb-1">3. КАНАЛ СВЯЗИ</div>
                                <div class="p2-slot border border-info bg-dark p-2 d-flex align-items-center justify-content-center text-center text-secondary small" data-role="channel" id="slot-p2-channel" style="min-height: 58px;">
                                    [Поместите канал]
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="card bg-black border-secondary rounded-0 p-2 h-100">
                                <div class="small text-danger fw-bold mb-1">ПОМЕХИ (ШУМ В КАНАЛЕ)</div>
                                <div class="p2-slot border border-danger bg-dark p-2 d-flex align-items-center justify-content-center text-center text-secondary small" data-role="noise" id="slot-p2-noise" style="min-height: 58px;">
                                    [Поместите источник шума]
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="card bg-black border-secondary rounded-0 p-2 h-100">
                                <div class="small text-warning fw-bold mb-1">4. ДЕКОДИРУЮЩЕЕ УСТРОЙСТВО</div>
                                <div class="p2-slot border border-warning bg-dark p-2 d-flex align-items-center justify-content-center text-center text-secondary small" data-role="decoder" id="slot-p2-decoder" style="min-height: 58px;">
                                    [Поместите декодер]
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="card bg-black border-secondary rounded-0 p-2 h-100">
                                <div class="small text-success fw-bold mb-1">5. ПОЛУЧАТЕЛЬ ИНФОРМАЦИИ</div>
                                <div class="p2-slot border border-success bg-dark p-2 d-flex align-items-center justify-content-center text-center text-secondary small" data-role="receiver" id="slot-p2-receiver" style="min-height: 58px;">
                                    [Поместите получателя]
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p2-submit-btn" type="button" class="btn btn-success text-dark fw-bold rounded-0 px-4 py-2" style="min-height: 48px;" disabled>
                            Запустить контур связи (0/6)
                        </button>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ФАЗА 3: КАЛИБРАТОР КАНАЛА И АРХИВА (SLIDER + SLOT & SNAP) -->
                <!-- ========================================== -->
                <div id="phase3-container" class="phase-section d-none">
                    <div class="card bg-black border-success rounded-0 p-3 mb-3">
                        <div class="small text-secondary mb-1">ИНЖЕНЕРНОЕ ЗАДАНИЕ НА ПЕРЕДАЧУ И ХРАНЕНИЕ:</div>
                        <div id="p3-scenario-desc" class="text-light mb-2"></div>
                        <div class="d-flex flex-wrap gap-2 small">
                            <span class="badge bg-dark border border-info text-info rounded-0 px-2 py-1">Объем файла: <strong id="p3-param-size">--</strong></span>
                            <span class="badge bg-dark border border-success text-success rounded-0 px-2 py-1">Канал: <strong id="p3-param-speed">--</strong></span>
                            <span class="badge bg-dark border border-warning text-warning rounded-0 px-2 py-1">Условие хранения: <strong id="p3-param-constraint">--</strong></span>
                        </div>
                    </div>

                    <!-- Контур 1: Калибратор времени передачи -->
                    <div class="card bg-black border-info rounded-0 p-3 mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <span class="text-info fw-bold small">1. КАЛИБРАТОР ВРЕМЕНИ ПЕРЕДАЧИ (t = I / v, 1 байт = 8 бит):</span>
                            <span class="badge bg-info text-dark rounded-0 fs-6 px-3 py-1">
                                <span id="p3-slider-val">1</span> сек
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button id="p3-dec-btn" type="button" class="btn btn-outline-info rounded-0 fw-bold" style="min-width: 48px; min-height: 48px;" aria-label="Уменьшить время на 1 секунду">-1</button>
                            <input id="p3-time-slider" type="range" class="form-range flex-grow-1" min="1" max="60" step="1" value="1" style="min-height: 48px;">
                            <button id="p3-inc-btn" type="button" class="btn btn-outline-info rounded-0 fw-bold" style="min-width: 48px; min-height: 48px;" aria-label="Увеличить время на 1 секунду">+1</button>
                        </div>
                        <div class="d-flex justify-content-between text-secondary small mt-1">
                            <span>1 с</span>
                            <span>15 с</span>
                            <span>30 с</span>
                            <span>45 с</span>
                            <span>60 с</span>
                        </div>
                    </div>

                    <!-- Контур 2: Слоты носителя и защиты с дистракторами-ловушками -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <span class="text-secondary small">2. ПАЛИТРА МОДУЛЕЙ ХРАНЕНИЯ И ЗАЩИТЫ (2 ВЕРНЫХ + 4 ЛОВУШКИ):</span>
                            <button id="p3-reset-pool-btn" type="button" class="btn btn-sm btn-outline-secondary rounded-0 text-light" style="min-height: 48px; min-width: 140px;">
                                Сбросить модули
                            </button>
                        </div>
                        <div id="p3-tokens-pool" class="d-flex flex-wrap gap-2 p-2 border border-secondary bg-dark mb-3" style="min-height: 76px;">
                            <!-- Генерируется через JS -->
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <div class="card bg-dark border-success rounded-0 p-2 h-100">
                                    <div class="small text-success fw-bold mb-1">ЦЕЛЕВОЙ НОСИТЕЛЬ / ХРАНИЛИЩЕ</div>
                                    <div class="p3-slot border border-success bg-black p-2 d-flex align-items-center justify-content-center text-center text-secondary small" data-role="storage" id="slot-p3-storage" style="min-height: 60px;">
                                        [Установите подходящий носитель]
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <div class="card bg-dark border-warning rounded-0 p-2 h-100">
                                    <div class="small text-warning fw-bold mb-1">МЕРА ЗАЩИТЫ ОТ ПОМЕХ / ПОТЕРЬ</div>
                                    <div class="p3-slot border border-warning bg-black p-2 d-flex align-items-center justify-content-center text-center text-secondary small" data-role="protection" id="slot-p3-protection" style="min-height: 60px;">
                                        [Установите метод защиты]
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p3-submit-btn" type="button" class="btn btn-success text-dark fw-bold rounded-0 px-4 py-2" style="min-height: 48px;" disabled>
                            Подтвердить конфигурацию (0/2)
                        </button>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ЭКРАН ПОБЕДЫ -->
                <!-- ========================================== -->
                <div id="victory-screen" class="d-none text-center py-4">
                    <div class="border border-success bg-black p-4 mx-auto" style="max-width: 560px;">
                        <div class="badge bg-success text-dark rounded-0 px-3 py-2 mb-3">УРОВЕНЬ 1 ПРОЙДЕН</div>
                        <h3 class="h4 text-success mb-2">Контуры передачи и хранения настроены</h3>
                        <p class="text-light small mb-3">
                            Вы успешно классифицировали информационные процессы, собрали схему канала связи Шеннона и откалибровали параметры передачи с защитой от потерь.
                        </p>
                        <div class="d-flex justify-content-center gap-4 mb-3 text-secondary small">
                            <div>Время: <strong id="final-time" class="text-light">00:00</strong></div>
                            <div>Ошибки: <strong id="final-attempts" class="text-warning">0</strong></div>
                        </div>
                        <button id="restart-level-btn" type="button" class="btn btn-outline-success rounded-0 px-4" style="min-height: 48px;">
                            Пройти тренажер еще раз
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
    const telemetry = window.LMSTelemetry.create({
        missionName: 'Урок 9 :: Информационные процессы. Передача и хранение информации (Уровень 1)',
        level: 1,
        totalStages: 3
    });

    let currentPhase = 1;
    let selectedItem = null;
    let isProcessing = false;
    let isLevelCompleted = false;

    const timerDisplay = document.getElementById('timer-display');
    const attemptsDisplay = document.getElementById('attempts-display');
    const feedbackBox = document.getElementById('feedback-box');
    const feedbackText = document.getElementById('feedback-text');

    setInterval(() => {
        if (isLevelCompleted) return;
        const elapsed = telemetry.getTimeSpentSec();
        const m = String(Math.floor(elapsed / 60)).padStart(2, '0');
        const s = String(elapsed % 60).padStart(2, '0');
        if (timerDisplay) timerDisplay.textContent = `${m}:${s}`;
    }, 1000);

    function clearSelection() {
        if (selectedItem) {
            selectedItem.classList.remove('border-warning', 'border-2');
            selectedItem = null;
        }
    }

    function triggerError(msg, onRecover) {
        if (isProcessing || isLevelCompleted) return;
        isProcessing = true;
        clearSelection();
        telemetry.fail({ stage: currentPhase });
        if (attemptsDisplay) {
            attemptsDisplay.textContent = String(telemetry.getState().attemptsCount);
        }
        if (feedbackText) feedbackText.textContent = msg;
        if (feedbackBox) feedbackBox.classList.remove('d-none');

        setTimeout(() => {
            if (feedbackBox) feedbackBox.classList.add('d-none');
            if (onRecover) onRecover();
            isProcessing = false;
        }, 1250);
    }

    function shuffle(arr) {
        const copy = arr.slice();
        for (let i = copy.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            const tmp = copy[i];
            copy[i] = copy[j];
            copy[j] = tmp;
        }
        return copy;
    }

    function attachTokenInteraction(el) {
        el.setAttribute('draggable', 'true');
        el.addEventListener('dragstart', (e) => {
            if (isProcessing) {
                e.preventDefault();
                return;
            }
            e.dataTransfer.setData('text/plain', el.id);
            el.classList.add('opacity-50');
        });
        el.addEventListener('dragend', () => {
            el.classList.remove('opacity-50');
        });
        el.addEventListener('click', (e) => {
            e.stopPropagation();
            if (isProcessing) return;
            if (selectedItem === el) {
                clearSelection();
            } else {
                clearSelection();
                selectedItem = el;
                el.classList.add('border-warning', 'border-2');
            }
        });
    }

    // =====================================================
    // ФАЗА 1: СОРТИРОВКА ПО ШЛЮЗАМ (процедурная генерация)
    // =====================================================
    const P1_BANK = {
        transfer: [
            'Отправка голосового сообщения в мессенджере',
            'Радиовещание прогноза погоды в FM-диапазоне',
            'Передача видеопотока по оптоволоконному кабелю',
            'Устный ответ ученика у доски перед классом',
            'Отправка электронного письма с вложением',
            'Синхронизация данных фитнес-браслета по Bluetooth'
        ],
        storage: [
            'Запись презентации на твердотельный SSD-накопитель',
            'Сохранение семейного фотоархива в облачном хранилище',
            'Размещение редких рукописей в бумажном архиве библиотеки',
            'Запись резервного образа системы на магнитную ленту LTO',
            'Фиксация учебного фильма на оптическом диске Blu-ray',
            'Сохранение реферата в энергонезависимую флеш-память USB'
        ],
        protection: [
            'Добавление контрольного бита четности к пакету данных',
            'Использование кода коррекции ошибок в структуре QR-кода',
            'Применение правила резервного копирования «3–2–1»',
            'Повторная передача искаженного кадра по запросу приемника',
            'Проверка контрольной суммы файла после скачивания',
            'Дублирование файлов пользователя на серверах в разных ЦОД'
        ],
        distractor: [
            'Сортировка списка учеников по алфавиту в таблице',
            'Вычисление среднего балла класса за четверть',
            'Перевод художественного текста с английского на русский',
            'Измерение температуры воздуха уличным термометром'
        ]
    };

    const p1PoolEl = document.getElementById('p1-cards-pool');
    const p1SubmitBtn = document.getElementById('p1-submit-btn');
    const p1ResetBtn = document.getElementById('p1-reset-pool-btn');
    const p1BucketSlots = Array.from(document.querySelectorAll('#phase1-container .target-bucket .bucket-slot'));

    function updateP1State() {
        let totalPlaced = 0;
        document.querySelectorAll('#phase1-container .target-bucket').forEach((bucket) => {
            const count = bucket.querySelectorAll('.p1-card').length;
            totalPlaced += count;
            const badge = bucket.querySelector('.count-badge');
            if (badge) badge.textContent = String(count);
        });
