    function moveP1Card(card, targetContainer) {
        if (!card || !targetContainer || !card.classList.contains('p1-card')) return;
        targetContainer.appendChild(card);
        clearSelection();
        updateP1State();
    }

    function initPhase1() {
        clearSelection();
        p1PoolEl.innerHTML = '';
        p1BucketSlots.forEach((slot) => { slot.innerHTML = ''; });

        const picked = [
            ...shuffle(P1_BANK.transfer).slice(0, 2).map((t) => ({ text: t, category: 'transfer' })),
            ...shuffle(P1_BANK.storage).slice(0, 2).map((t) => ({ text: t, category: 'storage' })),
            ...shuffle(P1_BANK.protection).slice(0, 2).map((t) => ({ text: t, category: 'protection' })),
            ...shuffle(P1_BANK.distractor).slice(0, 1).map((t) => ({ text: t, category: 'distractor' }))
        ];

        shuffle(picked).forEach((item, idx) => {
            const card = document.createElement('div');
            card.id = `p1-card-${idx}-${Date.now()}`;
            card.className = 'p1-card badge bg-dark border border-secondary text-light rounded-0 p-2 text-start text-wrap lh-sm d-flex align-items-center';
            card.style.cursor = 'grab';
            card.style.minHeight = '48px';
            card.style.maxWidth = '100%';
            card.dataset.category = item.category;
            card.textContent = item.text;
            attachTokenInteraction(card);
            p1PoolEl.appendChild(card);
        });

        updateP1State();
    }

    // Привязка постоянных обработчиков Фазы 1 (однократно!)
    p1BucketSlots.forEach((slot) => {
        slot.addEventListener('dragover', (e) => {
            e.preventDefault();
            slot.classList.add('bg-black');
        });
        slot.addEventListener('dragleave', () => {
            slot.classList.remove('bg-black');
        });
        slot.addEventListener('drop', (e) => {
            e.preventDefault();
            slot.classList.remove('bg-black');
            const id = e.dataTransfer.getData('text/plain');
            moveP1Card(document.getElementById(id), slot);
        });
        slot.addEventListener('click', () => {
            if (selectedItem && selectedItem.classList.contains('p1-card')) {
                moveP1Card(selectedItem, slot);
            }
        });
    });

    p1PoolEl.addEventListener('dragover', (e) => e.preventDefault());
    p1PoolEl.addEventListener('drop', (e) => {
        e.preventDefault();
        const id = e.dataTransfer.getData('text/plain');
        moveP1Card(document.getElementById(id), p1PoolEl);
    });
    p1PoolEl.addEventListener('click', () => {
        if (selectedItem && selectedItem.classList.contains('p1-card')) {
            moveP1Card(selectedItem, p1PoolEl);
        }
    });

    p1ResetBtn.addEventListener('click', () => {
        if (isProcessing) return;
        document.querySelectorAll('#phase1-container .target-bucket .p1-card').forEach((card) => {
            p1PoolEl.appendChild(card);
        });
        clearSelection();
        updateP1State();
    });

    p1SubmitBtn.addEventListener('click', () => {
        if (isProcessing) return;
        let allCorrect = true;
        let distractorPlaced = false;

        document.querySelectorAll('#phase1-container .target-bucket').forEach((bucket) => {
            const expectedCat = bucket.dataset.category;
            const cards = Array.from(bucket.querySelectorAll('.p1-card'));
            if (cards.length !== 2) allCorrect = false;
            cards.forEach((card) => {
                if (card.dataset.category === 'distractor') distractorPlaced = true;
                if (card.dataset.category !== expectedCat) allCorrect = false;
            });
        });

        if (!allCorrect) {
            const msg = distractorPlaced
                ? 'В шлюз попала карточка-дистрактор (процесс обработки/сбора, а не передачи/хранения/защиты)!'
                : 'Неверное распределение карточек по шлюзам! Проверьте назначение каждого процесса.';
            triggerError(msg, initPhase1);
            return;
        }

        goToPhase2();
    });

    // =====================================================
