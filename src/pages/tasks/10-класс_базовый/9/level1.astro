    const P3_MISSION_TEMPLATES = [
        {
            text: (sz, sp) => `Нужно передать видеоархив размером ${sz} Мбайт по каналу ${sp} Мбит/с (1 байт = 8 бит, приставки одного масштаба), сохранить копию в автономном карманном устройстве без потери данных при отключении питания и защитить архив от сбоев носителя.`,
