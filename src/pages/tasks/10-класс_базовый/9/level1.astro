    function returnP3SlotTokenToPool(slot) {
        const existing = slot.querySelector('.p3-token');
        if (existing) p3PoolEl.appendChild(existing);
        if (!slot.querySelector('.p3-token') && slot.dataset.placeholder) {
            slot.textContent = slot.dataset.placeholder;
            slot.classList.add('text-secondary');
