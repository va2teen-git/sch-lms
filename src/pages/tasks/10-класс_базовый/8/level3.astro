                const variants = waveBank[wave] || waveBank[1];
                const selected = variants[Math.floor(Math.random() * variants.length)];
                return { duration, packet: selected };
            },

            loadWave(wave) {
                if (this.waveTimerId) clearInterval(this.waveTimerId);

                const cfg = this.getWaveConfig(wave);
                this.currentWave = wave;
                this.currentWaveDuration = cfg.duration;
                this.timeLeft = cfg.duration;
                this.currentPacket = cfg.packet;

                const tickInterval = 50; // каждые 50 мс для плавной анимации
                this.waveTimerId = setInterval(() => {
                    this.timeLeft -= tickInterval / 1000;
                    if (this.timeLeft <= 0) {
                        this.timeLeft = 0;
                        clearInterval(this.waveTimerId);
                        this.triggerHardcoreReset('Время такта истекло! Шлюз заблокирован.');
                    }
                }, tickInterval);
            },

            handleGateChoice(choice) {
                if (this.gameState !== 'playing') return;
                if (this.showErrorAlert) return;

                if (choice === this.currentPacket.isSufficient) {
                    // Верное решение
                    playSuccessChime();
                    if (this.currentWave < this.totalWaves) {
                        this.loadWave(this.currentWave + 1);
                    } else {
                        this.finishGame();
                    }
                } else {
                    // Ошибка
                    playErrorBuzzer();
                    const reason = this.currentPacket.isSufficient 
                        ? 'Емкость была ДЕЙСТВИТЕЛЬНО достаточна! Ложная отбраковка.' 
                        : 'Входящий объем превышал лимит! Допущен сбой переполнения.';
                    this.triggerHardcoreReset(reason);
                }
            },

            handleKeyDown(e) {
                if (this.gameState !== 'playing') return;
                if (this.showErrorAlert) return;
                const key = e.key.toLowerCase();
                const code = e.code;
                if (key === '1' || code === 'Digit1' || code === 'Numpad1' || key === 'a' || key === 'arrowleft') {
                    e.preventDefault();
                    this.handleGateChoice(true);
                } else if (key === '2' || code === 'Digit2' || code === 'Numpad2' || key === 'd' || key === 'arrowright') {
                    e.preventDefault();
                    this.handleGateChoice(false);
                }
            },

            triggerHardcoreReset(msg) {
                if (this.waveTimerId) clearInterval(this.waveTimerId);
                playAlarmSiren();

                this.attempts++;
                this.errorMessage = msg;
                this.showErrorAlert = true;
                this.sendTelemetry('hardcore_reset', false);

                setTimeout(() => {
                    this.showErrorAlert = false;
                    this.loadWave(1);
                }, 1600);
            },

            finishGame() {
                if (this.waveTimerId) clearInterval(this.waveTimerId);
                if (this.sessionTimerId) clearInterval(this.sessionTimerId);
                window.removeEventListener('keydown', this.handleKeyDown);

                this.gameState = 'victory';
                this.sendTelemetry('level_complete', true);
            },

            restartGame() {
                this.startGame();
            }
        },
        mounted() {
            window.__DEV_LEVEL3_STATE__ = {
                getCurrentWave: () => this.currentWave,
                getAttempts: () => this.attempts,
                getCurrentPacket: () => this.currentPacket,
                solveCurrentWave: () => {
                    this.handleGateChoice(this.currentPacket.isSufficient);
                },
                submitChoice: (choice) => {
                    this.handleGateChoice(choice);
                }
            };
        },
        beforeUnmount() {
            if (this.waveTimerId) clearInterval(this.waveTimerId);
            if (this.sessionTimerId) clearInterval(this.sessionTimerId);
            window.removeEventListener('keydown', this.handleKeyDown);
        }
    }).mount('#vue-app');
</script>
