---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={2}>
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Шапка тренажера -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h4 text-warning mb-0">Тренажер: Аналитические расчеты сложности (Уровень 2)</h2>
                <div class="text-secondary small">Урок 25 // Технологический профиль (углубленный курс)</div>
            </div>
            <span class="badge border border-warning text-warning bg-dark rounded-0 px-3 py-2">
                Ручной ввод // Zero Multiple Choice
            </span>
        </div>

        <div id="game-container" class="card bg-dark border-warning rounded-0 shadow">
            <div class="card-body p-3 p-md-4">

                <!-- Индикатор шагов и времени -->
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="level-badge" class="badge bg-warning text-dark rounded-0 fs-6 me-2">Шаг 1 из 5</span>
                        <span id="level-title" class="text-light fw-bold fs-6">Масштабирование времени выполнения</span>
                    </div>
                    <div class="text-secondary small">
                        Ошибок: <span id="attempts-display" class="text-warning fw-bold">0</span> | 
                        Время: <span id="timer-display" class="text-info fw-bold">00:00</span>
                    </div>
                </div>

                <!-- Системный баннер ошибки / сброса -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between">
                        <span>
                            <strong>[ОШИБКА РАСЧЕТА]</strong> <span id="feedback-text">Неверное значение!</span> 
                            Регенерация параметров...
                        </span>
                        <div class="spinner-border spinner-border-sm text-danger" role="status"></div>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ФАЗА 1: Масштабирование времени -->
                <!-- ========================================== -->
                <div id="phase1" class="phase-container">
                    <h5 class="text-warning mb-2">Шаг 1: Аналитический расчет кратности возрастания времени выполнения</h5>
                    <p class="text-light">
                        Теоретическая сложность позволяет точно предсказать, во сколько раз увеличится время работы программы 
                        при изменении объема входных данных.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">[УСЛОВИЯ АНАЛИТИЧЕСКОЙ ЗАДАЧИ]:</div>
                        <div class="text-light fs-6 mb-2">
                            Алгоритм обработки данных имеет асимптотическую сложность 
                            <span id="p1-complexity" class="text-warning fw-bold fs-5"></span>.
                        </div>
                        <div class="text-light fs-6">
                            Объем обрабатываемых входных данных <span id="p1-scaling-desc" class="text-info fw-bold"></span>.
                        </div>
                    </div>

                    <p class="text-secondary small mb-2">
                        Во сколько раз увеличится количество элементарных операций процессора? Введите точное целое число:
                    </p>

                    <div class="input-group mb-3" style="max-width: 480px;">
                        <input type="number" id="p1-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Кратность роста времени" autocomplete="off">
                        <button id="p1-btn" class="btn btn-outline-warning rounded-0 px-4 font-monospace fw-bold">ПРОВЕРИТЬ</button>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ФАЗА 2: Асимптотический анализ кода -->
                <!-- ========================================== -->
                <div id="phase2" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 2: Определение O-нотации по алгоритмической структуре</h5>
                    <p class="text-light">
                        Проанализируйте представленный фрагмент алгоритма на псевдокоде и определите его наихудшую временную сложность 
                        в стандартной нотации $O(f(n))$.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <pre id="p2-code-snippet" class="text-light font-monospace mb-0"></pre>
                    </div>

                    <p class="text-secondary small mb-2">
                        Введите класс асимптотической сложности (например: <code>O(n)</code>, <code>O(n^2)</code>, <code>O(log n)</code>, <code>O(n log n)</code>, <code>O(n^3)</code>):
                    </p>

                    <div class="input-group mb-3" style="max-width: 480px;">
                        <input type="text" id="p2-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Например: O(n^2)" autocomplete="off">
                        <button id="p2-btn" class="btn btn-outline-warning rounded-0 px-4 font-monospace fw-bold">ПРОВЕРИТЬ</button>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ФАЗА 3: Теоретические предикаты P vs NP -->
                <!-- ========================================== -->
                <div id="phase3" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 3: Верификация истинности предикатов теории сложности</h5>
                    <p class="text-light">
                        Опираясь на материал учебника К.Ю. Полякова о соотношении классов P, NP, NP-полных и NP-трудных задач, 
                        определите логическую истинность приведенного математического высказывания.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">[ПРОВЕРЯЕМОЕ УТВЕРЖДЕНИЕ]:</div>
                        <div id="p3-statement" class="text-light fs-6 fw-bold"></div>
                    </div>

                    <p class="text-secondary small mb-2">
                        Введите вердикт (<code>ИСТИНА</code> или <code>ЛОЖЬ</code>, допускается <code>TRUE</code> или <code>FALSE</code>):
                    </p>

                    <div class="input-group mb-3" style="max-width: 480px;">
                        <input type="text" id="p3-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="ИСТИНА / ЛОЖЬ" autocomplete="off">
                        <button id="p3-btn" class="btn btn-outline-warning rounded-0 px-4 font-monospace fw-bold">ПРОВЕРИТЬ</button>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ФАЗА 4: Полиномиальная сводимость Карпа -->
                <!-- ========================================== -->
                <div id="phase4" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 4: Восстановление промежуточного звена полиномиального сведения</h5>
                    <p class="text-light">
                        В каноническом дереве Ричарда Карпа доказательство NP-полноты строится путем транзитивного сведения 
                        <code>A ≤<sub>p</sub> X ≤<sub>p</sub> B</code> от ранее доказанных задач.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">[ЦЕПОЧКА ПОЛИНОМИАЛЬНЫХ СВЕДЕНИЙ]:</div>
                        <div id="p4-chain-display" class="text-warning fs-5 fw-bold mb-2"></div>
                        <div id="p4-hint-display" class="text-secondary small"></div>
                    </div>

                    <p class="text-secondary small mb-2">
                        Введите наименование пропущенной задачи <code>[ ? ]</code> (например: <code>3-SAT</code>, <code>КЛИКА</code>, <code>ВЕРШИННОЕ ПОКРЫТИЕ</code>, <code>НЕЗАВИСИМОЕ МНОЖЕСТВО</code>):
                    </p>

                    <div class="input-group mb-3" style="max-width: 480px;">
                        <input type="text" id="p4-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Название пропущенной задачи" autocomplete="off">
                        <button id="p4-btn" class="btn btn-outline-warning rounded-0 px-4 font-monospace fw-bold">ПРОВЕРИТЬ</button>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ФАЗА 5: Предел суперкомпьютера -->
                <!-- ========================================== -->
                <div id="phase5" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 5: Оценка предела применимости суперкомпьютера</h5>
                    <p class="text-light">
                        Экспоненциальный взрыв делает полный перебор невозможным даже для мощнейших вычислительных кластеров.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">[ПАРАМЕТРЫ ВЫЧИСЛИТЕЛЬНОЙ СИСТЕМЫ]:</div>
                        <div class="text-light mb-1">
                            Быстродействие суперкомпьютера: <span id="p5-clock-speed" class="text-info fw-bold"></span> оп/сек.
                        </div>
                        <div class="text-light mb-1">
                            Временная сложность алгоритма полного перебора: <span id="p5-func" class="text-warning fw-bold"></span>.
                        </div>
                        <div class="text-light">
                            Выделенный лимит времени на расчет: <span class="text-success fw-bold">ровно 1 секунда</span>.
                        </div>
                    </div>

                    <p class="text-secondary small mb-2">
                        Каков максимально возможный размер задачи <code>n</code> (целое число), который суперкомпьютер 
                        гарантированно успеет решить за 1 секунду? Введите целое число <code>n</code>:
                    </p>

                    <div class="input-group mb-3" style="max-width: 480px;">
                        <input type="number" id="p5-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Максимальный размер входа n" autocomplete="off">
                        <button id="p5-btn" class="btn btn-outline-warning rounded-0 px-4 font-monospace fw-bold">ПРОВЕРИТЬ</button>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ЭКРАН ПОБЕДЫ -->
                <!-- ========================================== -->
                <div id="victory-screen" class="d-none text-center py-5">
                    <div class="display-3 text-warning mb-3">✓</div>
                    <h3 class="h2 text-warning font-monospace mb-2">УРОВЕНЬ 2 УСПЕШНО ЗАВЕРШЕН!</h3>
                    <p class="text-light mb-4">
                        Вы продемонстрировали глубокие аналитические навыки: точно рассчитали масштабирование функций роста, 
                        провели асимптотический анализ алгоритмических структур, верифицировали свойства классов P и NP, 
                        восстановили редукции Карпа и оценили барьеры экспоненциального взрыва.
                    </p>

                    <div class="card bg-black border-warning rounded-0 d-inline-block p-4 mb-4 text-start font-monospace">
                        <div class="text-secondary small mb-2 border-bottom border-secondary pb-1">[ФИНАЛЬНЫЙ ПРОТОКОЛ ТЕЛЕМЕТРИИ]</div>
                        <div class="text-light mb-1">Статус миссии: <span class="text-warning fw-bold">COMPLETED</span></div>
                        <div class="text-light mb-1">Число ошибок / сбросов: <span id="final-attempts" class="text-warning">0</span></div>
                        <div class="text-light mb-1">Затраченное время: <span id="final-time" class="text-info">00:00</span></div>
                        <div class="text-light">Режим проверки: <span class="text-success">Zero Multiple Choice OK</span></div>
                    </div>

                    <div>
                        <button id="btn-restart-level" class="btn btn-outline-warning rounded-0 px-4 py-2 font-monospace">
                            Пройти уровень заново
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(function() {
    // --- Состояние и метрики ---
    let currentPhase = 1;
    let attemptsCount = 0;
    let startTime = Date.now();
    let timerInterval = null;
    let isLocked = false;

    // Таймер
    function startTimer() {
        if (timerInterval) clearInterval(timerInterval);
        timerInterval = setInterval(() => {
            const elapsed = Math.floor((Date.now() - startTime) / 1000);
            const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
            const secs = String(elapsed % 60).padStart(2, '0');
            const el = document.getElementById('timer-display');
            if (el) el.textContent = `${mins}:${secs}`;
        }, 1000);
    }
    startTimer();

    function updateAttemptsDisplay() {
        const el = document.getElementById('attempts-display');
        if (el) el.textContent = String(attemptsCount);
    }

    function triggerErrorReset(msg, callback) {
        attemptsCount++;
        updateAttemptsDisplay();
        isLocked = true;

        const fb = document.getElementById('feedback-box');
        const ft = document.getElementById('feedback-text');
        if (fb && ft) {
            ft.textContent = msg;
            fb.classList.remove('d-none');
        }

        // Отправка сигнала телеметрии
        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: 'Урок 25 :: Сложность вычислений (Уровень 2)',
            action_type: 'hardcore_reset'
        }, '*');

        setTimeout(() => {
            if (fb) fb.classList.add('d-none');
            isLocked = false;
            if (callback) callback();
        }, 2200);
    }

    function completeLevel() {
        if (timerInterval) clearInterval(timerInterval);
        const elapsed = Math.floor((Date.now() - startTime) / 1000);
        const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
        const secs = String(elapsed % 60).padStart(2, '0');

        document.getElementById('phase1').classList.add('d-none');
        document.getElementById('phase2').classList.add('d-none');
        document.getElementById('phase3').classList.add('d-none');
        document.getElementById('phase4').classList.add('d-none');
        document.getElementById('phase5').classList.add('d-none');
        document.getElementById('victory-screen').classList.remove('d-none');

        const fa = document.getElementById('final-attempts');
        const ft = document.getElementById('final-time');
        if (fa) fa.textContent = String(attemptsCount);
        if (ft) ft.textContent = `${mins}:${secs}`;

        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: 'Урок 25 :: Сложность вычислений (Уровень 2)',
            action_type: 'level_complete',
            success: true,
            attempts_count: attemptsCount,
            time_spent_sec: elapsed
        }, '*');
    }

    function setPhaseHeader(num, title) {
        const b = document.getElementById('level-badge');
        const t = document.getElementById('level-title');
        if (b) b.textContent = `Шаг ${num} из 5`;
        if (t) t.textContent = title;
    }

    function randInt(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    // =========================================================================
    // ФАЗА 1: Масштабирование времени
    // =========================================================================
    let p1TargetAnswer = null;

    function initPhase1() {
        const compEl = document.getElementById('p1-complexity');
        const descEl = document.getElementById('p1-scaling-desc');
        const inputEl = document.getElementById('p1-input');
        if (inputEl) inputEl.value = '';

        const problemType = randInt(1, 3);
        if (problemType === 1) {
            // Квадратичная сложность O(n^2)
            const k = [2, 3, 4, 5, 10][randInt(0, 4)];
            compEl.textContent = 'O(n²)';
            descEl.textContent = `увеличился в ${k} раз(а)`;
            p1TargetAnswer = k * k;
        } else if (problemType === 2) {
            // Кубическая сложность O(n^3)
            const k = [2, 3, 4, 5][randInt(0, 3)];
            compEl.textContent = 'O(n³)';
            descEl.textContent = `увеличился в ${k} раз(а)`;
            p1TargetAnswer = k * k * k;
        } else {
            // Экспоненциальная сложность O(2^n) при росте на d элементов
            const d = [3, 4, 5, 6, 10][randInt(0, 4)];
            compEl.textContent = 'O(2ⁿ)';
            descEl.textContent = `увеличился на ${d} элементов (n + ${d})`;
            p1TargetAnswer = Math.pow(2, d);
        }
    }

    function verifyPhase1() {
        if (isLocked) return;
        const inputEl = document.getElementById('p1-input');
        const val = parseInt(inputEl.value.trim(), 10);

        if (isNaN(val)) {
            triggerErrorReset('Введите целое числовое значение кратности!');
            return;
        }

        if (val === p1TargetAnswer) {
            currentPhase = 2;
            setPhaseHeader(2, 'Определение асимптотики по структуре кода');
            document.getElementById('phase1').classList.add('d-none');
            document.getElementById('phase2').classList.remove('d-none');
            initPhase2();
        } else {
            triggerErrorReset(`Ошибка! Ожидалось значение ${p1TargetAnswer}, получено ${val}.`, () => initPhase1());
        }
    }

    // =========================================================================
    // ФАЗА 2: Асимптотический анализ кода
    // =========================================================================
    const CODE_SNIPPETS_BANK = [
        {
            code: `# Поиск пар элементов с одинаковой суммой:
total = 0
for i in range(n):
    for j in range(i + 1, n):
        total += matrix[i][j]`,
            expected: ['O(N^2)', 'O(N²)', 'N^2', 'N²']
        },
        {
            code: `# Двоичный логарифмический редуктор:
count = 0
while n > 1:
    n = n // 2
    count += 1`,
            expected: ['O(LOG N)', 'O(LOGN)', 'LOG N', 'LOGN']
        },
        {
            code: `# Вложенный цикл с логарифмическим шагом:
result = 0
for i in range(n):
    k = n
    while k > 1:
        k = k // 2
        result += 1`,
            expected: ['O(N LOG N)', 'O(NLOGN)', 'N LOG N', 'NLOGN']
        },
        {
            code: `# Классическое умножение квадратных матриц:
for i in range(n):
    for j in range(n):
        for k in range(n):
            C[i][j] += A[i][k] * B[k][j]`,
            expected: ['O(N^3)', 'O(N³)', 'N^3', 'N³']
        },
        {
            code: `# Линейный проход с накоплением суммы:
accumulator = 0
for i in range(n):
    accumulator += array[i]`,
            expected: ['O(N)', 'N']
        }
    ];

    let p2CurrentExpected = [];

    function initPhase2() {
        const snippetEl = document.getElementById('p2-code-snippet');
        const inputEl = document.getElementById('p2-input');
        if (inputEl) inputEl.value = '';

        const chosen = CODE_SNIPPETS_BANK[randInt(0, CODE_SNIPPETS_BANK.length - 1)];
        snippetEl.textContent = chosen.code;
        p2CurrentExpected = chosen.expected;
    }

    function verifyPhase2() {
        if (isLocked) return;
        const inputEl = document.getElementById('p2-input');
        const raw = inputEl.value.trim().toUpperCase().replace(/\s+/g, ' ');

        if (!raw) {
            triggerErrorReset('Введите асимптотическую формулу в O-нотации!');
            return;
        }

        // Нормализация: убираем лишние пробелы внутри скобок
        const clean = raw.replace(/\s*\(\s*/g, '(').replace(/\s*\)\s*/g, ')');
        const matched = p2CurrentExpected.some(exp => clean === exp || clean === `O(${exp})` || raw === exp);

        if (matched) {
            currentPhase = 3;
            setPhaseHeader(3, 'Верификация теоретических предикатов сложности');
            document.getElementById('phase2').classList.add('d-none');
            document.getElementById('phase3').classList.remove('d-none');
            initPhase3();
        } else {
            triggerErrorReset(`Неверная асимптотическая оценка! Проверьте число вложенных итераций.`, () => initPhase2());
        }
    }

    // =========================================================================
    // ФАЗА 3: Теоретические предикаты P vs NP
    // =========================================================================
    const STATEMENTS_BANK = [
        {
            text: 'Всякая вычислительная задача из класса P одновременно принадлежит классу NP (P ⊆ NP).',
            isTrue: true
        },
        {
            text: 'Если для хотя бы одной NP-полной задачи будет найден полиномиальный детерминированный алгоритм, то доказано равенство P = NP.',
            isTrue: true
        },
        {
            text: 'Задача 2-SAT (выполнимость КНФ с 2 литералами в дизъюнкте) является NP-полной.',
            isTrue: false // Она в P
        },
        {
            text: 'Проблема остановки машины Тьюринга принадлежит классу NP-полных задач.',
            isTrue: false // Она NP-трудная, но алгоритмически неразрешима и не в NP
        },
        {
            text: 'Любая задача из класса NP может быть полиномиально сведена к любой NP-полной задаче.',
            isTrue: true // Это определение NP-полноты
        },
        {
            text: 'Точная оптимизационная задача коммивояжера является NP-трудной.',
            isTrue: true
        },
        {
            text: 'При экспоненциальной сложности O(2ⁿ) увеличение быстродействия компьютера в 1000 раз позволяет увеличить размер решаемой задачи в 1000 раз.',
            isTrue: false // Всего на ~10 элементов
        }
    ];

    let p3CurrentStatement = null;

    function initPhase3() {
        const stmtEl = document.getElementById('p3-statement');
        const inputEl = document.getElementById('p3-input');
        if (inputEl) inputEl.value = '';

        p3CurrentStatement = STATEMENTS_BANK[randInt(0, STATEMENTS_BANK.length - 1)];
        stmtEl.textContent = `«${p3CurrentStatement.text}»`;
    }

    function verifyPhase3() {
        if (isLocked) return;
        const inputEl = document.getElementById('p3-input');
        const val = inputEl.value.trim().toUpperCase();

        if (!val) {
            triggerErrorReset('Введите ИСТИНА или ЛОЖЬ!');
            return;
        }

        const isTrueInput = ['ИСТИНА', 'TRUE', 'ДА', '1', 'ВЕРНО', 'ПРАВДА'].includes(val);
        const isFalseInput = ['ЛОЖЬ', 'FALSE', 'НЕТ', '0', 'НЕВЕРНО'].includes(val);

        if (!isTrueInput && !isFalseInput) {
            triggerErrorReset('Некорректный формат ввода! Используйте: ИСТИНА или ЛОЖЬ.');
            return;
        }

        const userVerdict = isTrueInput;
        if (userVerdict === p3CurrentStatement.isTrue) {
            currentPhase = 4;
            setPhaseHeader(4, 'Восстановление цепочки сводимости Ричарда Карпа');
            document.getElementById('phase3').classList.add('d-none');
            document.getElementById('phase4').classList.remove('d-none');
            initPhase4();
        } else {
            triggerErrorReset(`Неверная логическая оценка утверждения!`, () => initPhase3());
        }
    }

    // =========================================================================
    // ФАЗА 4: Полиномиальная сводимость Карпа
    // =========================================================================
    const KARP_CHAINS_BANK = [
        {
            display: 'SAT (Кук-Левин)  →  [  ?  ]  →  КЛИКА (CLIQUE)',
            hint: 'Формула булевой выполнимости в КНФ, содержащая ровно по 3 литерала в каждой скобке.',
            expected: ['3-SAT', '3SAT', '3 САТ', '3САТ']
        },
        {
            display: '3-SAT  →  [  ?  ]  →  НЕЗАВИСИМОЕ МНОЖЕСТВО',
            hint: 'Задача поиска полного подграфа из k попарно смежных вершин.',
            expected: ['КЛИКА', 'CLIQUE', 'ЗАДАЧА О КЛИКЕ', 'ПОЛНЫЙ ПОДГРАФ']
        },
        {
            display: '3-SAT  →  КЛИКА  →  [  ?  ]',
            hint: 'Множество k вершин графа, между которыми нет ни одного общего ребра.',
            expected: ['НЕЗАВИСИМОЕ МНОЖЕСТВО', 'INDEPENDENT SET']
        },
        {
            display: '3-SAT  →  ВЕРШИННОЕ ПОКРЫТИЕ  →  [  ?  ]',
            hint: 'Замкнутый маршрут, проходящий через каждую вершину графа ровно по одному разу (TSP).',
            expected: ['ГАМИЛЬТОНОВ ЦИКЛ', 'ГАМИЛЬТОНОВ ПУТЬ', 'HAMILTONIAN CYCLE', 'КОММИВОЯЖЕР', 'TSP']
        }
    ];

    let p4CurrentExpected = [];

    function initPhase4() {
        const chainEl = document.getElementById('p4-chain-display');
        const hintEl = document.getElementById('p4-hint-display');
        const inputEl = document.getElementById('p4-input');
        if (inputEl) inputEl.value = '';

        const chosen = KARP_CHAINS_BANK[randInt(0, KARP_CHAINS_BANK.length - 1)];
        chainEl.textContent = chosen.display;
        hintEl.textContent = `Подсказка структуры: ${chosen.hint}`;
        p4CurrentExpected = chosen.expected;
    }

    function verifyPhase4() {
        if (isLocked) return;
        const inputEl = document.getElementById('p4-input');
        const val = inputEl.value.trim().toUpperCase().replace(/\s+/g, ' ');

        if (!val) {
            triggerErrorReset('Введите название пропущенной задачи!');
            return;
        }

        const isMatch = p4CurrentExpected.some(exp => val === exp || val.includes(exp));

        if (isMatch) {
            currentPhase = 5;
            setPhaseHeader(5, 'Оценка предела применимости суперкомпьютера');
            document.getElementById('phase4').classList.add('d-none');
            document.getElementById('phase5').classList.remove('d-none');
            initPhase5();
        } else {
            triggerErrorReset(`Неверное звено сведения Карпа! Ознакомьтесь со структурой редукций.`, () => initPhase4());
        }
    }

    // =========================================================================
    // ФАЗА 5: Предел суперкомпьютера
    // =========================================================================
    let p5TargetN = null;

    function initPhase5() {
        const speedEl = document.getElementById('p5-clock-speed');
        const funcEl = document.getElementById('p5-func');
        const inputEl = document.getElementById('p5-input');
        if (inputEl) inputEl.value = '';

        // Генерируем задачу: 2^n <= Speed
        // Например: 10^9 (1 ГГц) -> log2(10^9) = 29.897 -> 29
        // 10^6 (1 МГц) -> log2(10^6) = 19.93 -> 19
        // 10^7 -> log2(10^7) = 23.25 -> 23
        // 10^8 -> log2(10^8) = 26.57 -> 26
        const configs = [
            { speedStr: '1 000 000 000 (10⁹)', speed: 1000000000, maxN: 29 },
            { speedStr: '1 000 000 (10⁶)', speed: 1000000, maxN: 19 },
            { speedStr: '100 000 000 (10⁸)', speed: 100000000, maxN: 26 },
            { speedStr: '10 000 000 (10⁷)', speed: 10000000, maxN: 23 }
        ];

        const cfg = configs[randInt(0, configs.length - 1)];
        speedEl.textContent = cfg.speedStr;
        funcEl.textContent = 'T(n) = 2ⁿ операций';
        p5TargetN = cfg.maxN;
    }

    function verifyPhase5() {
        if (isLocked) return;
        const inputEl = document.getElementById('p5-input');
        const val = parseInt(inputEl.value.trim(), 10);

        if (isNaN(val)) {
            triggerErrorReset('Введите целое числовое значение n!');
            return;
        }

        if (val === p5TargetN) {
            completeLevel();
        } else {
            triggerErrorReset(`Неверный предел! При n=${val} операций 2ⁿ = ${Math.pow(2, val).toExponential(2)}, что превышает 1 секунду.`, () => initPhase5());
        }
    }

    // Привязка кнопок
    document.getElementById('p1-btn')?.addEventListener('click', verifyPhase1);
    document.getElementById('p2-btn')?.addEventListener('click', verifyPhase2);
    document.getElementById('p3-btn')?.addEventListener('click', verifyPhase3);
    document.getElementById('p4-btn')?.addEventListener('click', verifyPhase4);
    document.getElementById('p5-btn')?.addEventListener('click', verifyPhase5);

    // Поддержка нажатия Enter в полях ввода
    ['p1-input', 'p2-input', 'p3-input', 'p4-input', 'p5-input'].forEach((id, idx) => {
        const input = document.getElementById(id);
        const handlers = [verifyPhase1, verifyPhase2, verifyPhase3, verifyPhase4, verifyPhase5];
        input?.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                handlers[idx]();
            }
        });
    });

    document.getElementById('btn-restart-level')?.addEventListener('click', () => {
        window.location.reload();
    });

    // Старт
    initPhase1();
})();
</script>
