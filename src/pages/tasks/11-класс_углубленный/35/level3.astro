---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={3} title="Урок 35 :: Стеки. Анализ правильности скобочного выражения (Уровень 3)" bodyClass="font-monospace m-0 p-0">
    <div id="vue-app" class="container-fluid min-vh-100 p-2 p-md-3 bg-black text-danger font-monospace" v-cloak>

        <!-- ========================================== -->
        <!-- 1. СТАРТОВЫЙ ЭКРАН (INTRO / БРИФИНГ) -->
        <!-- ========================================== -->
        <div v-if="gameState === 'intro'" class="text-center py-3 py-md-4">
            <div class="d-inline-block border border-danger p-3 p-md-4 bg-dark rounded-0 mb-3 text-start shadow-lg w-100" style="max-width: 820px;">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom border-danger pb-2 mb-3">
                    <h1 class="h4 text-danger mb-0 fw-bold">⚡ STACK PARSER DEFUSER // КОНТРОЛЛЕР СТЕКА LIFO</h1>
                    <span class="badge bg-danger text-black rounded-0 fw-bold px-3 py-2">АРКАДНЫЙ БОСС</span>
                </div>

                <p class="text-light mb-3">
                    На вход синтаксического анализатора поступают <span class="text-danger fw-bold">10 скоростных волн</span> скобочных выражений.
                    Стек анализатора изначально пуст — вам предстоит мысленно протрассировать дисциплину <strong>LIFO</strong> за доли секунды.
                </p>

                <div class="alert alert-danger bg-black border border-danger rounded-0 mb-3 text-light small">
                    <div class="fw-bold text-danger mb-2 text-uppercase">[ПРОТОКОЛ ПРЯМОГО УПРАВЛЕНИЯ]:</div>
                    <ul class="mb-0 ps-3">
                        <li class="mb-1"><strong>Если в потоке есть синтаксическая ошибка</strong> (<code>Underflow</code> при пустом стеке или конфликт парности вроде <code>([)]</code>): <strong>кликните прямо по первому сбойному символу на ленте</strong> (или наведите <kbd class="bg-dark text-warning border border-warning">←</kbd><kbd class="bg-dark text-warning border border-warning">→</kbd> + <kbd class="bg-dark text-warning border border-warning">X</kbd>), чтобы перехватить баг!</li>
                        <li class="mb-1"><strong>Если префикс корректен, но остались незакрытые скобки:</strong> достройте закрывающий LIFO-хвост кнопками <code>) ] } &gt;</code> (или клавишами <kbd class="bg-dark text-info border border-info">1</kbd>–<kbd class="bg-dark text-info border border-info">4</kbd> / скобками, <kbd class="bg-dark text-secondary border border-secondary">Backspace</kbd> — удалить).</li>
                        <li class="mb-1"><strong>Запуск парсера:</strong> нажмите <kbd class="bg-dark text-success border border-success">ПРОБЕЛ</kbd> или кнопку <strong>«▶ ПУСК ПАРСЕРА»</strong>. Луч прогонит выражение через визуальный стек LIFO.</li>
                        <li><strong>Режим Хардкор:</strong> неверно указанная позиция ошибки, пропуск бага, нарушение LIFO в хвосте или тайм-аут вызывают сирену и <strong>СБРОС НА ВОЛНУ 1</strong>!</li>
                    </ul>
                </div>

                <button id="start-btn" type="button" class="btn btn-danger btn-lg rounded-0 w-100 fw-bold font-monospace py-3 text-uppercase" style="min-height: 54px;" @click="startGame">
                    ▶ НАЧАТЬ ШТУРМ ПАРСЕРА (ВОЛНА 1 ИЗ 10)
                </button>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- 2. ИГРОВОЙ ЭКРАН (АРКАДНАЯ СЕССИЯ) -->
        <!-- ========================================== -->
        <div v-if="gameState === 'playing'" class="mx-auto" style="max-width: 980px;">

            <!-- ВЕРХНИЙ HUD -->
            <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom border-danger pb-2 mb-2 gap-2">
                <div>
                    <div class="h6 text-danger mb-0 fw-bold">⚡ STACK PARSER DEFUSER // КОНВЕЙЕР СИНТАКСИСА</div>
                    <div class="small text-secondary">ХАРДКОР: ОШИБКА ИЛИ ТАЙМ-АУТ = СБРОС НА ВОЛНУ 1</div>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span id="wave-counter-badge" class="badge bg-danger text-black rounded-0 fs-6 px-3 py-2 fw-bold">
                        Волна <span v-text="currentWave"></span> из <span v-text="totalWaves"></span>
                    </span>
                    <span class="badge bg-dark border border-secondary text-light rounded-0 px-2 py-2">
                        Сбоев: <span class="text-warning fw-bold" v-text="attempts"></span> | <span v-text="formatTime(sessionTime)"></span>
                    </span>
                </div>
            </div>

            <!-- ДИНАМИЧЕСКИЙ ТАЙМЕР ВОЛНЫ -->
            <div class="card bg-black border border-secondary rounded-0 p-2 mb-2">
                <div class="d-flex justify-content-between text-secondary small mb-1">
                    <span>ОКНО АНАЛИЗА ПОТОКА (УСКОРЯЕТСЯ С КАЖДОЙ ВОЛНОЙ):</span>
                    <span class="fw-bold" :class="timeLeft < 3.0 ? 'text-danger' : 'text-warning'">
                        <span v-text="timeLeft.toFixed(1)"></span> с / <span v-text="currentWaveDuration.toFixed(1)"></span> с
                    </span>
                </div>
                <div class="progress rounded-0 bg-dark" style="height: 12px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         :class="timerBarClass"
                         role="progressbar"
                         :style="{ width: Math.max(0, (timeLeft / currentWaveDuration * 100)) + '%' }">
                    </div>
                </div>
            </div>

            <!-- АВАРИЙНАЯ СИРЕНА (#alarm-box) -->
            <div id="alarm-box" v-if="alarmActive" class="alert alert-danger bg-black text-danger border border-danger rounded-0 mb-2 py-2 text-center" role="alert">
                <div class="fw-bold">🚨 [СИРЕНА // STACK PANIC] <span v-text="alarmReason"></span></div>
                <div class="small text-warning">ТОТАЛЬНЫЙ СБРОС НА ВОЛНУ 1 И ПЕРЕГЕНЕРАЦИЯ ПОТОКОВ...</div>
            </div>

            <!-- РАБОЧАЯ АРЕНА: ЛЕНТА ВЫРАЖЕНИЯ + СТАКАН СТЕКА LIFO -->
            <div v-if="currentWaveData" class="row g-2 align-items-stretch">

                <!-- ЛЕВАЯ/ОСНОВНАЯ ЗОНА: ЛЕНТА КОДА И ПАНЕЛЬ ДОЗАКРЫТИЯ -->
                <div class="col-12 col-md-8 d-flex flex-column gap-2">

                    <!-- Лента входящего скобочного выражения (Data Source + Direct Surface) -->
                    <div class="card bg-dark border border-danger rounded-0 p-2 p-md-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <span class="small text-light fw-bold text-uppercase">
                                Входная лента токенов (<span class="text-warning" v-text="currentWaveData.tokens.length"></span> симв.):
                            </span>
                            <span class="badge bg-black border border-secondary text-secondary rounded-0">
                                Алфавит: <span class="text-info" v-text="currentWaveData.bracketBadge"></span>
                            </span>
                        </div>

                        <div class="d-flex flex-wrap gap-2 justify-content-start align-items-center py-2">
                            <button
                                v-for="(tok, idx) in currentWaveData.tokens"
                                :key="'tok-' + currentWave + '-' + idx"
                                type="button"
                                @click="toggleErrorMarker(idx)"
                                class="btn rounded-0 fw-bold p-1 d-flex flex-column align-items-center justify-content-center position-relative"
                                :class="getTokenClass(idx)"
                                style="min-width: 48px; min-height: 54px; transition: transform 0.1s ease;"
                            >
                                <span class="fs-4 lh-1" v-text="tok"></span>
                                <span class="lh-1 mt-1" style="font-size: 0.6rem;" v-text="selectedErrorIndex === idx ? 'ERR!' : '#' + idx"></span>
                            </button>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top border-secondary pt-2 mt-1 small">
                            <span v-if="selectedErrorIndex !== null" class="text-danger fw-bold">
                                ✕ Выбрана точка отказа: индекс #<span v-text="selectedErrorIndex"></span> (<span v-text="currentWaveData.tokens[selectedErrorIndex]"></span>)
                            </span>
                            <span v-else class="text-secondary">
                                Если сбой внутри ленты — кликните по первой ошибочной скобке
                            </span>
                            <button v-if="selectedErrorIndex !== null" type="button" class="btn btn-outline-secondary btn-sm rounded-0" style="min-height: 36px;" @click="selectedErrorIndex = null">
                                Снять метку
                            </button>
                        </div>
                    </div>

                    <!-- Буфер закрывающего хвоста LIFO (Direct Surface) -->
                    <div class="card bg-black border border-secondary rounded-0 p-2 p-md-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <span class="small text-info fw-bold text-uppercase">
                                Буфер закрывающего хвоста LIFO (если в ленте нет ошибок):
                            </span>
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-0" style="min-height: 38px;" @click="clearTail" :disabled="tailBuffer.length === 0 || isAnimatingPulse">
                                Очистить хвост
                            </button>
                        </div>

                        <!-- Отображение собранного хвоста -->
                        <div class="d-flex flex-wrap gap-2 align-items-center p-2 bg-dark border border-secondary mb-2" style="min-height: 58px;">
                            <span v-if="tailBuffer.length === 0" class="text-secondary small fst-italic">
                                Хвост пуст. Нажмите ), ], }, &gt; или клавиши 1–4 для закрытия стека...
                            </span>
                            <div
                                v-for="(ch, tIdx) in tailBuffer"
                                :key="'tail-' + tIdx"
                                class="border rounded-0 fw-bold d-flex align-items-center justify-content-center px-3"
                                :class="pulsePhase === 'tail' && pulsePos === tIdx ? 'bg-warning text-dark border-warning' : 'bg-black text-info border-info'"
                                style="min-width: 48px; min-height: 48px;"
                            >
                                <span class="fs-4 lh-1" v-text="ch"></span>
                            </div>
                        </div>

                        <!-- Крупные кнопки ввода закрывающих скобок >= 48x48 px -->
                        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                            <div class="d-flex flex-wrap gap-2">
                                <button
                                    v-for="(item, bIdx) in closingPalette"
                                    :key="'pal-' + item.char"
                                    type="button"
                                    @click="appendTail(item.char)"
                                    class="btn btn-outline-info rounded-0 fw-bold d-flex flex-column align-items-center justify-content-center"
                                    style="min-width: 56px; min-height: 52px;"
                                >
                                    <span class="fs-4 lh-1" v-text="item.char"></span>
                                    <span class="text-secondary lh-1 mt-1" style="font-size: 0.65rem;">[<span v-text="bIdx + 1"></span>]</span>
                                </button>
                                <button
                                    type="button"
                                    @click="popTailInput"
                                    class="btn btn-outline-warning rounded-0 fw-bold d-flex flex-column align-items-center justify-content-center"
                                    style="min-width: 56px; min-height: 52px;"
                                    :disabled="tailBuffer.length === 0 || isAnimatingPulse"
                                >
                                    <span class="fs-5 lh-1">⌫</span>
                                    <span class="text-secondary lh-1 mt-1" style="font-size: 0.65rem;">DEL</span>
                                </button>
                            </div>

                            <!-- Кнопка форсажа / запуска импульса -->
                            <button
                                id="launch-btn"
                                type="button"
                                @click="launchPulse(false)"
                                class="btn btn-success rounded-0 fw-bold px-4 text-uppercase"
                                style="min-height: 52px;"
                                :disabled="isAnimatingPulse || alarmActive || (selectedErrorIndex === null && tailBuffer.length === 0)"
                            >
                                ▶ ПУСК [ПРОБЕЛ]
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ПРАВАЯ ЗОНА: ВИЗУАЛЬНЫЙ СТАКАН СТЕКА LIFO (АНИМАЦИЯ РАБОТЫ ПАРСЕРА) -->
                <div class="col-12 col-md-4 d-flex">
                    <div class="card bg-black border border-secondary rounded-0 p-2 p-md-3 w-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-2 mb-2">
                                <span class="small fw-bold text-warning text-uppercase">Стек LIFO (Диспетчер)</span>
                                <span class="badge bg-dark border border-secondary text-light rounded-0">
                                    Глубина: <span v-text="visualStack.length"></span>
                                </span>
                            </div>

                            <!-- Контейнер стакана (сверху вершина, снизу дно) -->
                            <div class="border border-secondary border-top-0 bg-dark p-2 d-flex flex-column-reverse gap-1" style="min-height: 240px;">
                                <div v-if="visualStack.length === 0" class="text-center text-secondary small my-auto">
                                    [ СТЕК ПУСТ ]<br>
                                    <span style="font-size: 0.7rem;" v-text="isAnimatingPulse ? 'Синхронизация...' : 'Ожидание запуска луча'"></span>
                                </div>
                                <div
                                    v-for="(item, sIdx) in visualStack"
                                    :key="'stk-' + sIdx + '-' + item"
                                    class="border rounded-0 py-2 px-3 d-flex justify-content-between align-items-center fw-bold"
                                    :class="sIdx === visualStack.length - 1 ? 'bg-warning text-dark border-warning' : 'bg-black text-info border-info'"
                                >
                                    <span class="small" v-text="sIdx === visualStack.length - 1 ? 'TOP →' : 'LVL ' + sIdx"></span>
                                    <span class="fs-5 lh-1" v-text="item"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-2 pt-2 border-top border-secondary small text-secondary">
                            Статус сканера: <span class="text-light fw-bold" v-text="scannerStatus"></span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- ========================================== -->
        <!-- 3. ЭКРАН ПОБЕДЫ -->
        <!-- ========================================== -->
        <div v-if="gameState === 'victory'" class="text-center py-4">
            <div class="d-inline-block border border-success p-4 bg-dark rounded-0 w-100" style="max-width: 620px;">
                <div class="display-6 text-success fw-bold mb-3">✔ МИССИЯ ВЫПОЛНЕНА</div>
                <p class="lead text-light mb-3">
                    Все 10 волн синтаксического анализа пройдены без единого сбоя стека LIFO!
                </p>
                <div class="card bg-black border-success rounded-0 p-3 mb-4">
                    <div class="d-flex justify-content-around text-center">
                        <div>
                            <div class="text-secondary small">ПРОЙДЕНО ВОЛН</div>
                            <div class="fs-4 fw-bold text-success" v-text="totalWaves + ' / ' + totalWaves"></div>
                        </div>
                        <div>
                            <div class="text-secondary small">СБРОСОВ (FAILS)</div>
                            <div id="final-attempts" class="fs-4 fw-bold text-warning" v-text="attempts"></div>
                        </div>
                        <div>
                            <div class="text-secondary small">ИТОГОВОЕ ВРЕМЯ</div>
                            <div id="final-time" class="fs-4 fw-bold text-info" v-text="formatTime(sessionTime)"></div>
                        </div>
                    </div>
                </div>
                <span class="badge bg-success text-dark rounded-0 px-4 py-2 fs-6">
                    Уровень 3 завершен. Телеметрия передана.
                </span>
            </div>
        </div>

    </div>
</TaskLayout>

<script is:inline src="/static/vue.global.js"></script>
<script is:inline>
(function() {
    const { createApp } = Vue;

    // =========================================================================
    // ЗВУКОВОЙ СИНТЕЗАТОР (WEB AUDIO API)
    // =========================================================================
    let audioCtx = null;
    function getAudioCtx() {
        try {
            if (!audioCtx) {
                const Ctx = window.AudioContext || window.webkitAudioContext;
                if (Ctx) audioCtx = new Ctx();
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume().catch(() => {});
            }
            return audioCtx;
        } catch (e) {
            return null;
        }
    }

    function playTone(freq, type, duration, gainVal) {
        const ctx = getAudioCtx();
        if (!ctx) return;
        try {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = type || 'sine';
            osc.frequency.setValueAtTime(freq, ctx.currentTime);
            gain.gain.setValueAtTime(gainVal || 0.06, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + duration);
        } catch (e) {}
    }

    function playClickSound() { playTone(540, 'triangle', 0.05, 0.05); }
    function playPushSound() { playTone(660, 'sine', 0.045, 0.04); }
    function playPopSound() { playTone(880, 'sine', 0.045, 0.04); }
    function playWaveSuccessSound() {
        playTone(523.25, 'triangle', 0.1, 0.08);
        setTimeout(() => playTone(659.25, 'triangle', 0.12, 0.08), 80);
        setTimeout(() => playTone(783.99, 'triangle', 0.18, 0.08), 160);
    }
    function playAlarmSound() {
        playTone(220, 'sawtooth', 0.22, 0.09);
        setTimeout(() => playTone(165, 'sawtooth', 0.28, 0.09), 180);
    }

    // =========================================================================
    // СЛОВАРИ И НЕЗАВИСИМЫЙ СТЕКОВЫЙ ВАЛИДАТОР
    // =========================================================================
    const OPEN_TO_CLOSE = { '(': ')', '[': ']', '{': '}', '<': '>' };
    const CLOSE_TO_OPEN = { ')': '(', ']': '[', '}': '{', '>': '<' };
    const NOISE_TOKENS = ['a', 'x', '+', '1', 'b'];

    function pickRandom(arr) {
        return arr[Math.floor(Math.random() * arr.length)];
    }

    function randInt(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    function analyzeSequence(tokens) {
        const stack = [];
        for (let i = 0; i < tokens.length; i++) {
            const ch = tokens[i];
            if (OPEN_TO_CLOSE[ch]) {
                stack.push(ch);
            } else if (CLOSE_TO_OPEN[ch]) {
                if (stack.length === 0) {
                    return { ok: false, errorIndex: i, reason: 'Stack Underflow: закрывающая скобка при пустом стеке' };
                }
                const top = stack.pop();
                if (top !== CLOSE_TO_OPEN[ch]) {
                    return { ok: false, errorIndex: i, reason: `Несоответствие типов: на вершине стека "${top}", а встречена "${ch}"` };
                }
            }
        }
        return {
            ok: true,
            errorIndex: -1,
            remainingStack: stack,
            expectedTail: stack.slice().reverse().map((op) => OPEN_TO_CLOSE[op])
        };
    }

    // =========================================================================
    // ПРОЦЕДУРНЫЙ ГЕНЕРАТОР 10 ВОЛН С НАРАСТАЮЩЕЙ СЛОЖНОСТЬЮ
    // =========================================================================
    function buildWaveData(waveNum, forceMode) {
        const durations = [12.0, 11.2, 10.5, 9.8, 9.2, 8.6, 8.0, 8.8, 7.4, 6.8];
        const duration = durations[waveNum - 1] || 7.5;

        const allowedOpen = waveNum <= 2
            ? ['(', '[']
            : waveNum <= 4
                ? ['(', '[', '{']
                : ['(', '[', '{', '<'];

        const bracketBadge = allowedOpen.map((o) => o + OPEN_TO_CLOSE[o]).join(' ');
        const mode = forceMode || (Math.random() < 0.5 ? 'fix_error' : 'close_tail');

        if (mode === 'close_tail') {
            const targetTail = waveNum <= 2 ? 2 : waveNum <= 5 ? randInt(2, 3) : waveNum <= 8 ? randInt(3, 4) : randInt(3, 5);
            const totalBrackets = waveNum <= 2 ? randInt(5, 6) : waveNum <= 5 ? randInt(7, 9) : randInt(9, 11);

            const stack = [];
            const tokens = [];
            for (let step = 0; step < totalBrackets; step++) {
                const stepsLeft = totalBrackets - step;
                // Нужно гарантировать, что к концу цикла stack.length === targetTail
                const minNeededPushes = Math.max(0, targetTail - stack.length);
                if (stack.length === 0 || stepsLeft === minNeededPushes) {
                    const op = pickRandom(allowedOpen);
                    stack.push(op);
                    tokens.push(op);
                } else if (stack.length - stepsLeft === targetTail) {
                    const op = stack.pop();
                    tokens.push(OPEN_TO_CLOSE[op]);
                } else if (Math.random() < 0.62 && stack.length < 6) {
                    const op = pickRandom(allowedOpen);
                    stack.push(op);
                    tokens.push(op);
                } else {
                    const op = stack.pop();
                    tokens.push(OPEN_TO_CLOSE[op]);
                }
            }

            // На волнах 6–10 добавляем 1–2 шумовых символа кода (переменные/операторы)
            if (waveNum >= 6) {
                const noiseCount = waveNum >= 8 ? 2 : 1;
                for (let n = 0; n < noiseCount; n++) {
                    const pos = randInt(1, tokens.length - 1);
                    tokens.splice(pos, 0, pickRandom(NOISE_TOKENS));
                }
            }

            const audit = analyzeSequence(tokens);
            if (!audit.ok || audit.expectedTail.length === 0) {
                return buildWaveData(waveNum, 'close_tail');
            }

            return {
                waveNumber: waveNum,
                duration,
                bracketBadge,
                mode: 'close_tail',
                tokens,
                errorIndex: -1,
                expectedTail: audit.expectedTail
            };
        }

        // Режим 'fix_error': гарантированная ровно 1 первая ошибка (mismatch или underflow)
        const prefixBrackets = waveNum <= 2 ? randInt(2, 4) : waveNum <= 5 ? randInt(3, 6) : randInt(4, 7);
        const stack = [];
        const tokens = [];
        for (let step = 0; step < prefixBrackets; step++) {
            if (stack.length === 0 || (Math.random() < 0.65 && stack.length < 5)) {
                const op = pickRandom(allowedOpen);
                stack.push(op);
                tokens.push(op);
            } else {
                const op = stack.pop();
                tokens.push(OPEN_TO_CLOSE[op]);
            }
        }

        let badBracket = ')';
        if (stack.length === 0) {
            badBracket = OPEN_TO_CLOSE[pickRandom(allowedOpen)];
        } else {
            const topOp = stack[stack.length - 1];
            // На поздних волнах стараемся ставить скобку, парную предпоследней в стеке — ловушка перекрестья ([)]
            if (stack.length >= 2 && stack[stack.length - 2] !== topOp && Math.random() < 0.75) {
                badBracket = OPEN_TO_CLOSE[stack[stack.length - 2]];
            } else {
                const wrongOps = allowedOpen.filter((o) => o !== topOp);
                badBracket = OPEN_TO_CLOSE[pickRandom(wrongOps)];
            }
        }

        const rawErrorIdx = tokens.length;
        tokens.push(badBracket);

        // Хвост после ошибки (1–3 скобки), чтобы ошибка была не всегда последней
        const trailingCount = waveNum <= 2 ? 1 : randInt(1, 3);
        for (let t = 0; t < trailingCount; t++) {
            if (Math.random() < 0.5) {
                tokens.push(pickRandom(allowedOpen));
            } else {
                tokens.push(OPEN_TO_CLOSE[pickRandom(allowedOpen)]);
            }
        }

        if (waveNum >= 6) {
            const pos = randInt(0, Math.max(0, rawErrorIdx - 1));
            tokens.splice(pos, 0, pickRandom(NOISE_TOKENS));
        }

        const audit = analyzeSequence(tokens);
        if (audit.ok || audit.errorIndex < 0) {
            return buildWaveData(waveNum, 'fix_error');
        }

        return {
            waveNumber: waveNum,
            duration,
            bracketBadge,
            mode: 'fix_error',
            tokens,
            errorIndex: audit.errorIndex,
            expectedTail: []
        };
    }

    function generateAll10Waves() {
        const list = [];
        for (let w = 1; w <= 10; w++) {
            // Волна 1 чередует оба режима; гарантируем наличие обоих режимов на первых волнах
            const forced = w === 1 ? 'fix_error' : w === 2 ? 'close_tail' : null;
            list.push(buildWaveData(w, forced));
        }
        return list;
    }

    // =========================================================================
    // VUE 3 ПРИЛОЖЕНИЕ
    // =========================================================================
    const app = createApp({
        data() {
            return {
                gameState: 'intro', // 'intro', 'playing', 'victory'
                totalWaves: 10,
                currentWave: 1,
                wavesList: [],
                attempts: 0,
                sessionTime: 0,
                startTimeMs: 0,
                timeLeft: 12.0,
                currentWaveDuration: 12.0,

                cursorIdx: 0,
                selectedErrorIndex: null,
                tailBuffer: [],
                visualStack: [],
                pulsePhase: 'idle', // 'idle', 'tape', 'tail'
                pulsePos: -1,
                scannerStatus: 'Ожидание команды',
                isAnimatingPulse: false,
                alarmActive: false,
                alarmReason: '',

                closingPalette: [
                    { char: ')', open: '(' },
                    { char: ']', open: '[' },
                    { char: '}', open: '{' },
                    { char: '>', open: '<' }
                ],

                waveTimerId: null,
                sessionTimerId: null,
                resetTimeoutId: null,
                pulseTimerId: null,
                telemetry: null
            };
        },
        computed: {
            currentWaveData() {
                return this.wavesList[this.currentWave - 1] || null;
            },
            timerBarClass() {
                if (!this.currentWaveDuration) return 'bg-success';
                const ratio = this.timeLeft / this.currentWaveDuration;
                if (ratio > 0.5) return 'bg-success';
                if (ratio > 0.25) return 'bg-warning';
                return 'bg-danger';
            }
        },
        mounted() {
            const self = this;
            this.telemetry = window.LMSTelemetry.create({
                missionName: 'Урок 35 :: Стеки. Анализ правильности скобочного выражения (Уровень 3)',
                level: 3,
                totalWaves: this.totalWaves,
                showAfkOverlay: true,
                onAfkStop: () => {
                    self.stopAllTimers();
                    self.alarmActive = false;
                },
                onAfkRetry: () => {
                    self.alarmActive = false;
                    self.wavesList = generateAll10Waves();
                    self.currentWave = 1;
                    self.telemetry.setWave(1, self.totalWaves);
                    self.initWave(1);
                }
            });

            window.addEventListener('keydown', this.handleKeydown);

            window.__DEV_LEVEL3_STATE__ = {
                get waves() { return self.wavesList; },
                get currentWaveIndex() { return self.currentWave - 1; },
                get currentWave() { return self.currentWave; },
                solveCurrentWave: () => self.devSolveCurrentWave(),
                submitAction: (action, payload) => self.devSubmitAction(action, payload)
            };
        },
        beforeUnmount() {
            window.removeEventListener('keydown', this.handleKeydown);
            this.stopAllTimers();
            if (this.telemetry) {
                this.telemetry.destroy();
            }
        },
        methods: {
            formatTime(sec) {
                const m = String(Math.floor(sec / 60)).padStart(2, '0');
                const s = String(sec % 60).padStart(2, '0');
                return `${m}:${s}`;
            },

            stopAllTimers() {
                if (this.waveTimerId) { clearInterval(this.waveTimerId); this.waveTimerId = null; }
                if (this.sessionTimerId) { clearInterval(this.sessionTimerId); this.sessionTimerId = null; }
                if (this.resetTimeoutId) { clearTimeout(this.resetTimeoutId); this.resetTimeoutId = null; }
                if (this.pulseTimerId) { clearTimeout(this.pulseTimerId); this.pulseTimerId = null; }
            },

            startGame() {
                this.stopAllTimers();
                this.wavesList = generateAll10Waves();
                this.attempts = 0;
                this.sessionTime = 0;
                this.startTimeMs = Date.now();
                this.currentWave = 1;
                this.alarmActive = false;
                this.isAnimatingPulse = false;
                this.gameState = 'playing';

                if (this.telemetry) {
                    this.telemetry.reset({ allowRecomplete: true });
                    this.telemetry.start();
                    this.telemetry.markActivity();
                    this.telemetry.setWave(1, this.totalWaves);
                    this.telemetry.progress({
                        wave: 1,
                        total_waves: this.totalWaves,
                        stage: 1,
                        total_stages: this.totalWaves
                    });
                }

                this.sessionTimerId = setInterval(() => {
                    this.sessionTime = this.telemetry
                        ? this.telemetry.getTimeSpentSec()
                        : Math.floor((Date.now() - this.startTimeMs) / 1000);
                }, 1000);

                this.initWave(1);
            },

            initWave(waveNum) {
                if (this.waveTimerId) { clearInterval(this.waveTimerId); this.waveTimerId = null; }
                if (this.pulseTimerId) { clearTimeout(this.pulseTimerId); this.pulseTimerId = null; }

                this.currentWave = waveNum;
                this.alarmActive = false;
                this.isAnimatingPulse = false;
                this.selectedErrorIndex = null;
                this.tailBuffer = [];
                this.visualStack = [];
                this.pulsePhase = 'idle';
                this.pulsePos = -1;
                this.cursorIdx = 0;
                this.scannerStatus = 'Ожидание команды';

                const data = this.currentWaveData;
                if (!data) return;
                this.currentWaveDuration = data.duration;
                this.timeLeft = data.duration;

                this.waveTimerId = setInterval(() => {
                    if (this.gameState !== 'playing' || this.alarmActive || this.isAnimatingPulse) return;
                    this.timeLeft = Math.max(0, Number((this.timeLeft - 0.1).toFixed(1)));
                    if (this.timeLeft <= 0) {
                        clearInterval(this.waveTimerId);
                        this.waveTimerId = null;
                        this.triggerHardcoreReset('Истекло время анализа стека!', true);
                    }
                }, 100);
            },

            getTokenClass(idx) {
                const isPulse = this.pulsePhase === 'tape' && this.pulsePos === idx;
                const isErr = this.selectedErrorIndex === idx;
                const isCursor = this.cursorIdx === idx;
                if (isPulse) return 'btn-warning text-dark border-warning';
                if (isErr) return 'btn-danger text-black border-danger';
                if (isCursor) return 'btn-dark text-light border-warning border-2';
                return 'btn-dark text-light border-secondary';
            },

            toggleErrorMarker(idx) {
                if (this.gameState !== 'playing' || this.alarmActive || this.isAnimatingPulse) return;
                if (this.telemetry && this.telemetry.getState().isAfkPaused) return;
                if (this.telemetry) this.telemetry.markActivity();

                this.cursorIdx = idx;
                if (this.selectedErrorIndex === idx) {
                    this.selectedErrorIndex = null;
                } else {
                    this.selectedErrorIndex = idx;
                    this.tailBuffer = [];
                }
                playClickSound();
            },

            appendTail(ch) {
                if (this.gameState !== 'playing' || this.alarmActive || this.isAnimatingPulse) return;
                if (this.telemetry && this.telemetry.getState().isAfkPaused) return;
                if (this.tailBuffer.length >= 8) return;
                if (this.telemetry) this.telemetry.markActivity();

                this.selectedErrorIndex = null;
                this.tailBuffer.push(ch);
                playClickSound();
            },

            popTailInput() {
                if (this.gameState !== 'playing' || this.alarmActive || this.isAnimatingPulse) return;
                if (this.tailBuffer.length === 0) return;
                if (this.telemetry) this.telemetry.markActivity();
                this.tailBuffer.pop();
                playClickSound();
            },

            clearTail() {
                if (this.gameState !== 'playing' || this.alarmActive || this.isAnimatingPulse) return;
                if (this.telemetry) this.telemetry.markActivity();
                this.tailBuffer = [];
                playClickSound();
            },

            evaluateInstant() {
                const data = this.currentWaveData;
                if (!data) return;

                if (this.selectedErrorIndex !== null) {
                    if (data.mode !== 'fix_error') {
                        this.triggerHardcoreReset('Ложная тревога: префикс ленты корректен, требовалось закрыть хвост стека!', false);
                        return;
                    }
                    if (this.selectedErrorIndex !== data.errorIndex) {
                        const msg = this.selectedErrorIndex < data.errorIndex
                            ? `Ложное срабатывание на позиции #${this.selectedErrorIndex}: ошибка произошла позже!`
                            : `Пропущен первый сбой стека на позиции #${data.errorIndex}!`;
                        this.triggerHardcoreReset(msg, false);
                        return;
                    }
                    this.advanceOrWin();
                    return;
                }

                // Режим закрытия хвоста
                if (data.mode === 'fix_error') {
                    this.triggerHardcoreReset(`Сбой стека на позиции #${data.errorIndex} не был перехвачен!`, false);
                    return;
                }
                const expectedStr = data.expectedTail.join('');
                const actualStr = this.tailBuffer.join('');
                if (actualStr !== expectedStr) {
                    this.triggerHardcoreReset(`Нарушен порядок LIFO при закрытии стека (получено "${actualStr}", ожидалось "${expectedStr}")!`, false);
                    return;
                }
                this.advanceOrWin();
            },

            launchPulse(instant) {
                if (this.gameState !== 'playing' || this.alarmActive || this.isAnimatingPulse) return;
                if (this.telemetry && this.telemetry.getState().isAfkPaused) return;
                if (this.selectedErrorIndex === null && this.tailBuffer.length === 0) return;
                if (this.telemetry) this.telemetry.markActivity();

                if (instant) {
                    this.evaluateInstant();
                    return;
                }

                const data = this.currentWaveData;
                if (!data) return;

                this.isAnimatingPulse = true;
                this.visualStack = [];
                this.pulsePhase = 'tape';
                this.pulsePos = -1;
                this.scannerStatus = 'Сканирование ленты...';

                const tapeTokens = data.tokens;
                const tailTokens = this.selectedErrorIndex === null ? this.tailBuffer.slice() : [];
                let step = 0;

                const stepTape = () => {
                    if (this.gameState !== 'playing' || this.alarmActive) return;

                    if (step < tapeTokens.length) {
                        this.pulsePos = step;
                        const ch = tapeTokens[step];

                        if (this.selectedErrorIndex === step) {
                            // Проверяем, действительно ли тут сбой
                            const isEmptyErr = Boolean(CLOSE_TO_OPEN[ch]) && this.visualStack.length === 0;
                            const isMismatchErr = Boolean(CLOSE_TO_OPEN[ch]) && this.visualStack.length > 0 && this.visualStack[this.visualStack.length - 1] !== CLOSE_TO_OPEN[ch];
                            if (isEmptyErr || isMismatchErr) {
                                this.isAnimatingPulse = false;
                                this.scannerStatus = `Перехват на #${step}!`;
                                this.advanceOrWin();
                                return;
                            }
                            this.isAnimatingPulse = false;
                            this.triggerHardcoreReset(`Ложная тревога: символ "${ch}" на позиции #${step} не нарушает стек!`, false);
                            return;
                        }

                        if (OPEN_TO_CLOSE[ch]) {
                            this.visualStack.push(ch);
                            playPushSound();
                        } else if (CLOSE_TO_OPEN[ch]) {
                            if (this.visualStack.length === 0) {
                                this.isAnimatingPulse = false;
                                this.triggerHardcoreReset(`Stack Underflow на позиции #${step}: лишняя "${ch}" при пустом стеке!`, false);
                                return;
                            }
                            const top = this.visualStack[this.visualStack.length - 1];
                            if (top !== CLOSE_TO_OPEN[ch]) {
                                this.isAnimatingPulse = false;
                                this.triggerHardcoreReset(`Конфликт LIFO на позиции #${step}: "${top}" не сочетается с "${ch}"!`, false);
                                return;
                            }
                            this.visualStack.pop();
                            playPopSound();
                        }

                        step++;
                        this.pulseTimerId = setTimeout(stepTape, 50);
                    } else {
                        // Лента пройдена без сбоев
                        if (this.selectedErrorIndex !== null) {
                            this.isAnimatingPulse = false;
                            this.triggerHardcoreReset('Позиция отказа не достигнута или сбой отсутствовал!', false);
                            return;
                        }
                        this.pulsePhase = 'tail';
                        this.scannerStatus = 'Разгрузка стека LIFO...';
                        let tailStep = 0;

                        const stepTail = () => {
                            if (this.gameState !== 'playing' || this.alarmActive) return;
                            if (tailStep < tailTokens.length) {
                                this.pulsePos = tailStep;
                                const ch = tailTokens[tailStep];
                                if (this.visualStack.length === 0) {
                                    this.isAnimatingPulse = false;
                                    this.triggerHardcoreReset(`Лишняя закрывающая "${ch}" в хвосте при пустом стеке!`, false);
                                    return;
                                }
                                const top = this.visualStack[this.visualStack.length - 1];
                                if (top !== CLOSE_TO_OPEN[ch]) {
                                    this.isAnimatingPulse = false;
                                    this.triggerHardcoreReset(`Нарушение LIFO в хвосте: на вершине "${top}", а подана "${ch}"!`, false);
                                    return;
                                }
                                this.visualStack.pop();
                                playPopSound();
                                tailStep++;
                                this.pulseTimerId = setTimeout(stepTail, 55);
                            } else {
                                this.isAnimatingPulse = false;
                                if (this.visualStack.length > 0) {
                                    this.triggerHardcoreReset(`В стеке осталось незакрытых скобок: ${this.visualStack.length}!`, false);
                                    return;
                                }
                                this.scannerStatus = 'Стек пуст [OK]';
                                this.advanceOrWin();
                            }
                        };
                        stepTail();
                    }
                };

                stepTape();
            },

            advanceOrWin() {
                playWaveSuccessSound();
                if (this.waveTimerId) { clearInterval(this.waveTimerId); this.waveTimerId = null; }

                if (this.currentWave >= this.totalWaves) {
                    this.finishLevel();
                } else {
                    const nextWave = this.currentWave + 1;
                    if (this.telemetry) {
                        this.telemetry.advanceWave(nextWave);
                    }
                    this.initWave(nextWave);
                }
            },

            triggerHardcoreReset(reason, isTimeout) {
                if (this.alarmActive || this.gameState !== 'playing') return;
                if (this.waveTimerId) { clearInterval(this.waveTimerId); this.waveTimerId = null; }
                if (this.pulseTimerId) { clearTimeout(this.pulseTimerId); this.pulseTimerId = null; }
                this.isAnimatingPulse = false;
                this.scannerStatus = 'STACK PANIC!';

                if (this.telemetry) {
                    const sent = this.telemetry.fail({
                        wave: this.currentWave,
                        isTimeout: Boolean(isTimeout)
                    });
                    this.attempts = this.telemetry.getState().attemptsCount;
                    if (sent === false) {
                        this.alarmActive = false;
                        return;
                    }
                } else {
                    this.attempts++;
                }

                playAlarmSound();
                this.alarmReason = reason;
                this.alarmActive = true;
                this.wavesList = generateAll10Waves();

                this.resetTimeoutId = setTimeout(() => {
                    if (this.gameState !== 'playing') return;
                    if (this.telemetry && this.telemetry.getState().isAfkPaused) return;
                    this.alarmActive = false;
                    if (this.telemetry) {
                        this.telemetry.setWave(1, this.totalWaves);
                    }
                    this.initWave(1);
                }, 1300);
            },

            finishLevel() {
                this.stopAllTimers();
                this.gameState = 'victory';
                this.sessionTime = this.telemetry
                    ? Math.max(1, this.telemetry.getTimeSpentSec())
                    : Math.max(1, Math.round((Date.now() - this.startTimeMs) / 1000));
                if (this.telemetry) {
                    this.telemetry.complete({ wave: this.totalWaves });
                }
            },

            handleKeydown(e) {
                if (this.gameState === 'intro') {
                    if (e.code === 'Space' || e.key === 'Enter') {
                        e.preventDefault();
                        this.startGame();
                    }
                    return;
                }
                if (this.gameState !== 'playing' || this.alarmActive || this.isAnimatingPulse) return;
                if (this.telemetry && this.telemetry.getState().isAfkPaused) return;

                const data = this.currentWaveData;
                if (!data) return;

                if (e.key === 'ArrowLeft') {
                    e.preventDefault();
                    this.cursorIdx = Math.max(0, this.cursorIdx - 1);
                } else if (e.key === 'ArrowRight') {
                    e.preventDefault();
                    this.cursorIdx = Math.min(data.tokens.length - 1, this.cursorIdx + 1);
                } else if (e.key === 'x' || e.key === 'X' || e.key === 'ч' || e.key === 'Ч' || e.key === 'Delete') {
                    e.preventDefault();
                    this.toggleErrorMarker(this.cursorIdx);
                } else if (e.key === ')' || e.code === 'Digit1') {
                    e.preventDefault();
                    this.appendTail(')');
                } else if (e.key === ']' || e.code === 'Digit2') {
                    e.preventDefault();
                    this.appendTail(']');
                } else if (e.key === '}' || e.code === 'Digit3') {
                    e.preventDefault();
                    this.appendTail('}');
                } else if (e.key === '>' || e.code === 'Digit4') {
                    e.preventDefault();
                    this.appendTail('>');
                } else if (e.key === 'Backspace') {
                    e.preventDefault();
                    this.popTailInput();
                } else if (e.code === 'Space' || e.key === 'Enter') {
                    e.preventDefault();
                    this.launchPulse(false);
                }
            },

            devSolveCurrentWave() {
                if (this.gameState !== 'playing' || this.alarmActive) return;
                const data = this.currentWaveData;
                if (!data) return;
                if (this.telemetry) this.telemetry.markActivity();

                if (data.mode === 'fix_error') {
                    this.selectedErrorIndex = data.errorIndex;
                    this.tailBuffer = [];
                } else {
                    this.selectedErrorIndex = null;
                    this.tailBuffer = data.expectedTail.slice();
                }
                this.launchPulse(true);
            },

            devSubmitAction(action, payload) {
                if (action === 'select_error') {
                    this.toggleErrorMarker(Number(payload));
                } else if (action === 'append_tail') {
                    this.appendTail(String(payload));
                } else if (action === 'launch') {
                    this.launchPulse(Boolean(payload && payload.instant));
                } else if (action === 'solve') {
                    this.devSolveCurrentWave();
                } else if (action === 'fail') {
                    this.triggerHardcoreReset(payload || 'Тестовый принудительный сбой', false);
                } else if (action === 'timeout') {
                    this.triggerHardcoreReset('Тайм-аут волны', true);
                }
            }
        }
    });

    app.mount('#vue-app');
})();
</script>
