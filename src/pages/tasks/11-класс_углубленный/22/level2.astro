---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={2}>
    <div class="container my-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 text-warning font-monospace mb-0">Тренажер: Машина Поста (Уровень 2: Продвинутый)</h2>
            <span class="badge border border-warning text-warning bg-dark rounded-0 px-3 py-2 font-monospace">Продвинутый режим (Ручной ввод)</span>
        </div>

        <div id="game-container" class="card bg-dark border-warning rounded-0">
            <div class="card-body p-4">
                
                <!-- Фаза 1: Инъекция команды Поста -->
                <div id="phase1" class="phase-container">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-warning font-monospace mb-0">Шаг 1 из 5: Синтаксис и инъекция команды Поста</h4>
                        <span class="badge bg-warning text-dark rounded-0">Фаза 1</span>
                    </div>
                    <p class="text-light">
                        Для управления машиной Поста требуется восстановить точную синтаксическую запись команды под предписанным номером.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3 font-monospace">
                        <div class="text-secondary small mb-2">ТЕХНИЧЕСКОЕ ЗАДАНИЕ ДЛЯ КОМАНДЫ №<span id="p1-cmd-num" class="text-warning fw-bold"></span>:</div>
                        <div id="p1-task-desc" class="text-light fs-6 mb-2"></div>
                        <div class="small text-secondary">
                            Справка по синтаксису: <span class="text-warning">V j</span> (метка), <span class="text-warning">. j</span> (стереть), <span class="text-warning">→ j</span> (вправо), <span class="text-warning">← j</span> (влево), <span class="text-warning">? j, k</span> (ветвление), <span class="text-warning">!</span> (останов).
                        </div>
                    </div>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <label for="p1-input" class="form-label text-light font-monospace small mb-2">
                            Введите правую часть команды (без номера строки, например: <span class="text-warning">V 3</span> или <span class="text-warning">? 4, 1</span> или <span class="text-warning">!</span>):
                        </label>
                        <div class="input-group">
                            <span id="p1-prefix" class="input-group-text bg-black text-warning border-secondary font-monospace rounded-0"></span>
                            <input type="text" id="p1-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace fs-5" placeholder="например: V 3" autocomplete="off">
                            <button id="p1-btn" class="btn btn-outline-warning rounded-0 font-monospace px-4">ВВОД</button>
                        </div>
                    </div>

                    <div id="p1-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [СИНТАКСИЧЕСКАЯ ОШИБКА] Неверная команда Поста! Генерация новой спецификации...
                    </div>
                </div>

                <!-- Фаза 2: Построчная строковая трассировка ленты -->
                <div id="phase2" class="phase-container d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-warning font-monospace mb-0">Шаг 2 из 5: Построчная трассировка ленты</h4>
                        <span class="badge bg-warning text-dark rounded-0">Фаза 2</span>
                    </div>
                    <p class="text-light">
                        Выполните мысленную пошаговую трассировку микропрограммы машины Поста от команды №1 до останова <code class="text-warning">!</code>. Введите итоговое состояние ленты в виде символьной строки из меток <code class="text-warning">V</code> и пустых клеток <code class="text-warning">.</code>.
                    </p>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="card bg-black border-warning rounded-0 p-3 h-100 font-monospace">
                                <div class="text-secondary small mb-2">ПРОГРАММА ВЫЧИСЛЕНИЯ:</div>
                                <div id="p2-prog-lines" class="text-light fs-5"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-black border-secondary rounded-0 p-3 h-100 font-monospace text-center">
                                <div class="text-secondary small mb-2">НАЧАЛЬНАЯ ЛЕНТА (5 ЯЧЕЕК):</div>
                                <div id="p2-tape-display" class="d-flex justify-content-center align-items-center gap-1 fs-4 mb-2"></div>
                                <div class="small text-secondary">
                                    Каретка <span class="text-warning">▲</span> установлена над указанной ячейкой.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <label for="p2-input" class="form-label text-light font-monospace small mb-2">
                            Введите итоговое состояние всех 5 ячеек ленты (строка из 5 символов <span class="text-warning">V</span> и <span class="text-warning">.</span>, например: <span class="text-warning">VV...</span> или <span class="text-warning">.V.V.</span>):
                        </label>
                        <div class="input-group">
                            <input type="text" id="p2-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace fs-5" placeholder="например: VV..." autocomplete="off">
                            <button id="p2-btn" class="btn btn-outline-warning rounded-0 font-monospace px-4">ВВОД</button>
                        </div>
                    </div>

                    <div id="p2-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [ОШИБКА ТРАССИРОВКИ] Неверное итоговое состояние ленты! Новая программа...
                    </div>
                </div>

                <!-- Фаза 3: Расчет количества тактов -->
                <div id="phase3" class="phase-container d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-warning font-monospace mb-0">Шаг 3 из 5: Аналитический расчет машинных тактов</h4>
                        <span class="badge bg-warning text-dark rounded-0">Фаза 3</span>
                    </div>
                    <p class="text-light">
                        Каждая выполненная команда машины Поста (включая проверку <code class="text-warning">?</code> и команду останова <code class="text-warning">!</code>) занимает ровно 1 неделимый машинный такт. Рассчитайте точное общее число тактов до полного завершения вычислений.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3 font-monospace">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <div class="text-secondary small mb-2">ПРОГРАММА СКАНИРОВАНИЯ МАССИВА:</div>
                                <div id="p3-program-code" class="text-light fs-5"></div>
                            </div>
                            <div class="col-md-6 border-start border-secondary ps-md-3 mt-3 mt-md-0">
                                <div class="text-secondary small mb-1">КОНФИГУРАЦИЯ ДАННЫХ:</div>
                                <div class="mb-2">Унарный массив меток на ленте: <span id="p3-word-display" class="text-warning fw-bold fs-5"></span></div>
                                <div class="mb-2">Длина массива: <span id="p3-count-display" class="text-success fw-bold"></span> меток</div>
                                <div id="p3-pos-desc" class="small text-secondary"></div>
                            </div>
                        </div>
                    </div>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <label for="p3-input" class="form-label text-light font-monospace small mb-2">
                            Сколько тактов выполнит машина Поста до останова включительно? Введите целое число:
                        </label>
                        <div class="input-group">
                            <input type="number" id="p3-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace fs-5" placeholder="например: 7" autocomplete="off">
                            <button id="p3-btn" class="btn btn-outline-warning rounded-0 font-monospace px-4">ВВОД</button>
                        </div>
                    </div>

                    <div id="p3-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [ОШИБКА РАСЧЕТА ТАКТОВ] Неверное количество выполненных тактов! Новая конфигурация...
                    </div>
                </div>

                <!-- Фаза 4: Унарный сумматор Полякова -->
                <div id="phase4" class="phase-container d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-warning font-monospace mb-0">Шаг 4 из 5: Унарный сумматор Полякова (Сложение a + b)</h4>
                        <span class="badge bg-warning text-dark rounded-0">Фаза 4</span>
                    </div>
                    <p class="text-light">
                        В учебнике К.Ю. Полякова сложение двух унарных чисел <code class="text-warning">a</code> и <code class="text-warning">b</code>, разделенных пустой ячейкой, выполняется путем объединения массивов меткой <code class="text-warning">V</code> и последующего стирания крайней правой метки.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3 font-monospace">
                        <div class="text-secondary small mb-2">ВХОДНЫЕ ДАННЫЕ НА ЛЕНТЕ:</div>
                        <div class="text-light mb-2">
                            Первое слагаемое <code class="text-warning">a</code> = <span id="p4-val-a" class="text-warning fw-bold fs-5"></span>, 
                            Второе слагаемое <code class="text-warning">b</code> = <span id="p4-val-b" class="text-warning fw-bold fs-5"></span>
                        </div>
                        <div class="text-secondary small mb-1">СХЕМА ЛЕНТЫ:</div>
                        <div id="p4-tape-preview" class="text-success fs-5 fw-bold mb-2"></div>
                        <div class="small text-secondary">
                            Каретка стоит над первой меткой первого числа. Алгоритм гарантированно вычисляет сумму <span class="text-warning">a + b</span>.
                        </div>
                    </div>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <label for="p4-input" class="form-label text-light font-monospace small mb-2">
                            Сколько меток <span class="text-warning">V</span> окажется на ленте после штатного останова алгоритма? Введите десятичное число:
                        </label>
                        <div class="input-group">
                            <input type="number" id="p4-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace fs-5" placeholder="например: 5" autocomplete="off">
                            <button id="p4-btn" class="btn btn-outline-warning rounded-0 font-monospace px-4">ВВОД</button>
                        </div>
                    </div>

                    <div id="p4-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [АРИФМЕТИЧЕСКИЙ СБОЙ] Неверная сумма унарных чисел! Новые слагаемые...
                    </div>
                </div>

                <!-- Фаза 5: Предиктивный статический анализ (Halting & Crash) -->
                <div id="phase5" class="phase-container d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-warning font-monospace mb-0">Шаг 5 из 5: Предиктивный анализ останова (Halting & Crash)</h4>
                        <span class="badge bg-warning text-dark rounded-0">Фаза 5</span>
                    </div>
                    <p class="text-light">
                        Проанализируйте начальное состояние ленты и программу машины Поста без предварительного запуска.
                        Определите, к какому исходу приведет исполнение программы:
                        штатный останов (<code class="text-success">OK</code>), аварийный останов (<code class="text-danger">CRASH</code>) или зацикливание (<code class="text-warning">LOOP</code>).
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3 font-monospace">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="text-secondary small mb-2">ПРОГРАММА АВТОМАТА:</div>
                                <div id="p5-prog-listing" class="text-light fs-5"></div>
                            </div>
                            <div class="col-md-6 border-start border-secondary ps-md-3 mt-3 mt-md-0">
                                <div class="text-secondary small mb-1">НАЧАЛЬНАЯ ЛЕНТА:</div>
                                <div id="p5-tape-view" class="d-flex align-items-center gap-1 fs-5 mb-2"></div>
                                <div class="small text-secondary">
                                    Напоминание: команда <code class="text-warning">V</code> в ячейку с меткой или команда <code class="text-warning">.</code> в пустую ячейку вызывает немедленный аварийный останов.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <label for="p5-input" class="form-label text-light font-monospace small mb-2">
                            Введите вердикт анализа: <span class="text-success fw-bold">OK</span> (нормальный останов), <span class="text-danger fw-bold">CRASH</span> (авария) или <span class="text-warning fw-bold">LOOP</span> (бесконечный цикл):
                        </label>
                        <div class="input-group">
                            <input type="text" id="p5-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace fs-5" placeholder="OK, CRASH или LOOP" autocomplete="off">
                            <button id="p5-btn" class="btn btn-outline-warning rounded-0 font-monospace px-4">ВВОД</button>
                        </div>
                    </div>

                    <div id="p5-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [ОШИБКА ДИАГНОСТИКИ] Неверный вердикт останова! Новая тестовая конфигурация...
                    </div>
                </div>

                <!-- Экран завершения -->
                <div id="success-screen" class="phase-container d-none text-center py-5">
                    <div class="mb-3 text-warning font-monospace display-4">★ УРОВЕНЬ 2 УСПЕШНО ПРОЙДЕН</div>
                    <h3 class="text-light font-monospace mb-3">Продвинутый анализ машины Поста освоен</h3>
                    <p class="text-secondary max-w-md mx-auto mb-4">
                        Вы успешно овладели ручным синтезом команд, пошаговой строковой трассировкой ленты, расчетом машинных тактов, унарным сложением и предиктивным статическим анализом останова.
                    </p>
                    <div class="badge border border-warning text-warning bg-black p-3 font-monospace fs-6 rounded-0">
                        Уровень 2 пройден. Переходите на Уровень 3 в верхней панели!
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script is:inline>
        const missionName = 'Урок 22 :: Машина Поста (Уровень 2)';
        const startTime = Date.now();
        let attempts = 0;

        function sendTelemetry(action_type, success = false) {
            const timeSpent = Math.floor((Date.now() - startTime) / 1000);
            window.parent.postMessage({
                type: 'TELEMETRY_EVENT',
                mission_name: missionName,
                action_type: action_type,
                status: action_type === 'level_complete' ? 'completed' : 'in_progress',
                start_time: new Date(startTime).toISOString(),
                time_spent_sec: timeSpent,
                attempts_count: attempts,
                success: success
            }, '*');
        }

        function rnd(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function normalizeCommand(str) {
            return str.trim().replace(/\s+/g, ' ').replace(/\s*,\s*/g, ', ');
        }

        function renderTapeRow(containerId, tape, headIndex) {
            const container = document.getElementById(containerId);
            container.innerHTML = '';
            tape.forEach((val, idx) => {
                const col = document.createElement('div');
                col.className = 'd-flex flex-column align-items-center';

                const cell = document.createElement('div');
                cell.className = `border px-3 py-2 ${idx === headIndex ? 'border-warning text-warning bg-dark fw-bold' : 'border-secondary text-light'}`;
                cell.textContent = val === 1 ? 'V' : '.';

                const pointer = document.createElement('div');
                pointer.className = 'small mt-1 font-monospace';
                if (idx === headIndex) {
                    pointer.className += ' text-warning fw-bold';
                    pointer.textContent = '▲';
                } else {
                    pointer.innerHTML = '&nbsp;';
                }

                col.appendChild(cell);
                col.appendChild(pointer);
                container.appendChild(col);
            });
        }

        // ==========================================
        // ФАЗА 1: Инъекция команды Поста
        // ==========================================
        let p1ExpectedAnswer = '';

        function initPhase1() {
            const cmdNum = rnd(1, 4);
            document.getElementById('p1-cmd-num').textContent = cmdNum;
            document.getElementById('p1-prefix').textContent = `${cmdNum}.`;

            const cmdType = rnd(0, 4);
            const targetJ = rnd(1, 5);
            const targetK = targetJ === 5 ? 1 : targetJ + 1;

            let desc = '';
            let expected = '';

            if (cmdType === 0) {
                desc = `Поставить метку V в текущую ячейку и передать управление команде номер ${targetJ}.`;
                expected = `V ${targetJ}`;
            } else if (cmdType === 1) {
                desc = `Стереть метку в текущей ячейке и передать управление команде номер ${targetJ}.`;
                expected = `. ${targetJ}`;
            } else if (cmdType === 2) {
                desc = `Сдвинуть каретку на одну ячейку вправо и передать управление команде номер ${targetJ}.`;
                expected = `→ ${targetJ}`;
            } else if (cmdType === 3) {
                desc = `Сдвинуть каретку на одну ячейку влево и передать управление команде номер ${targetJ}.`;
                expected = `← ${targetJ}`;
            } else if (cmdType === 4) {
                desc = `Проверить метку: если в текущей ячейке есть V — перейти к команде ${targetJ}, если ячейка пуста — перейти к команде ${targetK}.`;
                expected = `? ${targetJ}, ${targetK}`;
            }

            document.getElementById('p1-task-desc').textContent = desc;
            p1ExpectedAnswer = expected;

            const input = document.getElementById('p1-input');
            input.value = '';
            input.disabled = false;
            document.getElementById('p1-btn').disabled = false;
        }

        function handlePhase1Submit() {
            const input = document.getElementById('p1-input');
            const btn = document.getElementById('p1-btn');
            const feedback = document.getElementById('p1-feedback');

            let userVal = normalizeCommand(input.value);
            // Нормализация стрелок и русских/английских букв
            userVal = userVal.replace(/->/g, '→').replace(/<-/g, '←');
            // Если ввели с точкой в начале "1. V 2", убираем
            userVal = userVal.replace(/^\d+\.\s*/, '');

            let expectedNorm = normalizeCommand(p1ExpectedAnswer);

            if (userVal === expectedNorm) {
                document.getElementById('phase1').classList.add('d-none');
                document.getElementById('phase2').classList.remove('d-none');
                sendTelemetry('in_progress');
                initPhase2();
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                input.disabled = true;
                btn.disabled = true;
                feedback.classList.remove('d-none');

                setTimeout(() => {
                    initPhase1();
                    feedback.classList.add('d-none');
                    input.focus();
                }, 1200);
            }
        }

        document.getElementById('p1-btn').addEventListener('click', handlePhase1Submit);
        document.getElementById('p1-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') handlePhase1Submit();
        });

        // ==========================================
        // ФАЗА 2: Построчная строковая трассировка ленты
        // ==========================================
        let p2ExpectedTapeString = '';

        function initPhase2() {
            // Лента из 5 ячеек
            const tapeType = rnd(0, 3);
            let tape = [0, 0, 0, 0, 0];
            let head = 1;
            let program = [];

            if (tapeType === 0) {
                // Инкремент вправо: [., V, ., ., .], каретка на 1 (где V)
                // 1. → 2
                // 2. V 3
                // 3. !
                tape = [0, 1, 0, 0, 0];
                head = 1;
                program = ['1. → 2', '2. V 3', '3. !'];
                // Результат: [., V, V, ., .]
                tape[2] = 1;
            } else if (tapeType === 1) {
                // Стирание влево: [., V, V, ., .], каретка на 2
                // 1. . 2
                // 2. ← 3
                // 3. !
                tape = [0, 1, 1, 0, 0];
                head = 2;
                program = ['1. . 2', '2. ← 3', '3. !'];
                // Результат: [., V, ., ., .]
                tape[2] = 0;
            } else if (tapeType === 2) {
                // Условный сдвиг: если V -> вправо, если пусто -> V
                // [., V, ., V, .], каретка на 1 (там V)
                // 1. ? 2, 4
                // 2. → 3
                // 3. !
                // 4. V 3
                tape = [0, 1, 0, 1, 0];
                head = 1;
                program = ['1. ? 2, 4', '2. → 3', '3. !', '4. V 3'];
                // Лента не меняется, так как каретка на V просто шагнула на 2 и остановилась
            } else {
                // Поставить две метки: каретка на 1
                // 1. V 2
                // 2. → 3
                // 3. V 4
                // 4. !
                tape = [0, 0, 0, 0, 0];
                head = 1;
                program = ['1. V 2', '2. → 3', '3. V 4', '4. !'];
                tape[1] = 1;
                tape[2] = 1;
            }

            // Формируем начальную ленту до выполнения
            let initialTape = [...tape];
            if (tapeType === 0) initialTape[2] = 0;
            if (tapeType === 1) initialTape[2] = 1;
            if (tapeType === 3) { initialTape[1] = 0; initialTape[2] = 0; }

            p2ExpectedTapeString = tape.map(x => x === 1 ? 'V' : '.').join('');

            renderTapeRow('p2-tape-display', initialTape, head);

            const linesEl = document.getElementById('p2-prog-lines');
            linesEl.innerHTML = program.map(l => `<div>${l}</div>`).join('');

            const input = document.getElementById('p2-input');
            input.value = '';
            input.disabled = false;
            document.getElementById('p2-btn').disabled = false;
        }

        function handlePhase2Submit() {
            const input = document.getElementById('p2-input');
            const btn = document.getElementById('p2-btn');
            const feedback = document.getElementById('p2-feedback');

            let userVal = input.value.trim().toUpperCase().replace(/\s+/g, '');
            // Поддержка 1/0 как V/.
            userVal = userVal.replace(/1/g, 'V').replace(/0/g, '.');

            if (userVal === p2ExpectedTapeString) {
                document.getElementById('phase2').classList.add('d-none');
                document.getElementById('phase3').classList.remove('d-none');
                sendTelemetry('in_progress');
                initPhase3();
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                input.disabled = true;
                btn.disabled = true;
                feedback.classList.remove('d-none');

                setTimeout(() => {
                    initPhase2();
                    feedback.classList.add('d-none');
                    input.focus();
                }, 1200);
            }
        }

        document.getElementById('p2-btn').addEventListener('click', handlePhase2Submit);
        document.getElementById('p2-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') handlePhase2Submit();
        });

        // ==========================================
        // ФАЗА 3: Расчет количества тактов
        // ==========================================
        let p3ExpectedTicks = 0;

        function initPhase3() {
            // Программа сканирования унарного массива меток V
            // 1. → 2      (Шаг вправо)
            // 2. ? 1, 3   (Метка V? Продолжаем шагать на 1. Пусто? Нашли край! Переход на 3)
            // 3. !        (Останов)
            const count = rnd(2, 4);
            const word = 'V'.repeat(count);

            document.getElementById('p3-program-code').innerHTML = `
                <div>1. → 2</div>
                <div>2. ? 1, 3</div>
                <div>3. !</div>
            `;

            // Пусть каретка стартует на пустой ячейке ровно перед первой меткой массива
            // Такт 1: 1. → 2 (сместились на метку 1)
            // Такт 2: 2. ? 1, 3 (метка V -> переход на 1)
            // Такт 3: 1. → 2 (сместились на метку 2)
            // Такт 4: 2. ? 1, 3 (метка V -> переход на 1)
            // ...
            // Для каждой метки: 2 такта (шаг → и проверка ?).
            // После последней метки count:
            // Шаг → на пустую ячейку (1 такт)
            // Проверка ? (пусто -> переход на 3) (1 такт)
            // Останов 3. ! (1 такт)
            // Итого: 2 * count + 2 + 1 = 2 * count + 3 такта!
            p3ExpectedTicks = 2 * count + 3;

            document.getElementById('p3-word-display').textContent = `[${word}]`;
            document.getElementById('p3-count-display').textContent = count;
            document.getElementById('p3-pos-desc').textContent = 'Каретка стартует на пустой ячейке непосредственно слева от первой метки массива.';

            const input = document.getElementById('p3-input');
            input.value = '';
            input.disabled = false;
            document.getElementById('p3-btn').disabled = false;
        }

        function handlePhase3Submit() {
            const input = document.getElementById('p3-input');
            const btn = document.getElementById('p3-btn');
            const feedback = document.getElementById('p3-feedback');

            const userVal = parseInt(input.value.trim(), 10);

            if (userVal === p3ExpectedTicks) {
                document.getElementById('phase3').classList.add('d-none');
                document.getElementById('phase4').classList.remove('d-none');
                sendTelemetry('in_progress');
                initPhase4();
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                input.disabled = true;
                btn.disabled = true;
                feedback.classList.remove('d-none');

                setTimeout(() => {
                    initPhase3();
                    feedback.classList.add('d-none');
                    input.focus();
                }, 1200);
            }
        }

        document.getElementById('p3-btn').addEventListener('click', handlePhase3Submit);
        document.getElementById('p3-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') handlePhase3Submit();
        });

        // ==========================================
        // ФАЗА 4: Унарный сумматор Полякова (a + b)
        // ==========================================
        let p4ExpectedSum = 0;

        function initPhase4() {
            const a = rnd(1, 4);
            const b = rnd(1, 4);
            p4ExpectedSum = a + b;

            document.getElementById('p4-val-a').textContent = a;
            document.getElementById('p4-val-b').textContent = b;

            const tapeStr = `... [.] ${' [V]'.repeat(a)} [.] ${' [V]'.repeat(b)} [.] ...`;
            document.getElementById('p4-tape-preview').textContent = tapeStr;

            const input = document.getElementById('p4-input');
            input.value = '';
            input.disabled = false;
            document.getElementById('p4-btn').disabled = false;
        }

        function handlePhase4Submit() {
            const input = document.getElementById('p4-input');
            const btn = document.getElementById('p4-btn');
            const feedback = document.getElementById('p4-feedback');

            const userVal = parseInt(input.value.trim(), 10);

            if (userVal === p4ExpectedSum) {
                document.getElementById('phase4').classList.add('d-none');
                document.getElementById('phase5').classList.remove('d-none');
                sendTelemetry('in_progress');
                initPhase5();
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                input.disabled = true;
                btn.disabled = true;
                feedback.classList.remove('d-none');

                setTimeout(() => {
                    initPhase4();
                    feedback.classList.add('d-none');
                    input.focus();
                }, 1200);
            }
        }

        document.getElementById('p4-btn').addEventListener('click', handlePhase4Submit);
        document.getElementById('p4-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') handlePhase4Submit();
        });

        // ==========================================
        // ФАЗА 5: Предиктивный статический анализ (Halting & Crash)
        // ==========================================
        let p5ExpectedVerdict = 'OK';

        function initPhase5() {
            // Тип исхода:
            // 0: OK (штатный останов)
            // 1: CRASH (аварийный останов)
            // 2: LOOP (бесконечный цикл)
            const scenarioType = rnd(0, 2);

            let prog = [];
            let tape = [0, 0, 0];
            let head = 1;

            if (scenarioType === 0) {
                // OK: каретка на пустой ячейке, ставит V и останавливается
                tape = [0, 0, 0];
                head = 1;
                prog = ['1. V 2', '2. → 3', '3. !'];
                p5ExpectedVerdict = 'OK';
            } else if (scenarioType === 1) {
                // CRASH: каретка на ячейке с V, и программа выполняет V!
                // Или на пустой клетке выполняет .!
                if (Math.random() > 0.5) {
                    tape = [0, 1, 0];
                    head = 1;
                    prog = ['1. V 2', '2. !'];
                } else {
                    tape = [0, 0, 0];
                    head = 1;
                    prog = ['1. . 2', '2. !'];
                }
                p5ExpectedVerdict = 'CRASH';
            } else {
                // LOOP: челночный бег или бесконечный цикл без останова
                tape = [0, 1, 0];
                head = 1;
                if (Math.random() > 0.5) {
                    prog = ['1. → 2', '2. ← 1'];
                } else {
                    prog = ['1. → 2', '2. ? 1, 1'];
                }
                p5ExpectedVerdict = 'LOOP';
            }

            document.getElementById('p5-prog-listing').innerHTML = prog.map(l => `<div>${l}</div>`).join('');
            renderTapeRow('p5-tape-view', tape, head);

            const input = document.getElementById('p5-input');
            input.value = '';
            input.disabled = false;
            document.getElementById('p5-btn').disabled = false;
        }

        function handlePhase5Submit() {
            const input = document.getElementById('p5-input');
            const btn = document.getElementById('p5-btn');
            const feedback = document.getElementById('p5-feedback');

            let userVal = input.value.trim().toUpperCase();
            // Поддержка русских эквивалентов
            if (userVal === 'ОК') userVal = 'OK';
            if (userVal === 'КРАШ' || userVal === 'АВАРИЯ') userVal = 'CRASH';
            if (userVal === 'ЦИКЛ' || userVal === 'ЗАЦИКЛИВАНИЕ') userVal = 'LOOP';

            if (userVal === p5ExpectedVerdict) {
                document.getElementById('phase5').classList.add('d-none');
                document.getElementById('success-screen').classList.remove('d-none');
                sendTelemetry('level_complete', true);
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                input.disabled = true;
                btn.disabled = true;
                feedback.classList.remove('d-none');

                setTimeout(() => {
                    initPhase5();
                    feedback.classList.add('d-none');
                    input.focus();
                }, 1200);
            }
        }

        document.getElementById('p5-btn').addEventListener('click', handlePhase5Submit);
        document.getElementById('p5-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') handlePhase5Submit();
        });

        // Запуск
        sendTelemetry('in_progress');
        initPhase1();
    </script>
</TaskLayout>
