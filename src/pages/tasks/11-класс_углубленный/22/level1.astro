---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={1}>
    <div class="container my-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 text-success font-monospace mb-0">Тренажер: Машина Поста (Уровень 1)</h2>
            <span class="badge border border-success text-success bg-dark rounded-0 px-3 py-2 font-monospace">Базовый режим</span>
        </div>

        <div id="game-container" class="card bg-dark border-success rounded-0">
            <div class="card-body p-4">
                
                <!-- Фаза 1: Прямая манипуляция лентой и тактом -->
                <div id="phase1" class="phase-container">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-success font-monospace mb-0">Шаг 1 из 3: Моделирование такта на ленте</h4>
                        <span class="badge bg-success text-dark rounded-0">Фаза 1</span>
                    </div>
                    <p class="text-light">
                        Проанализируйте начальное состояние ленты, положение каретки и выполняемую команду машины Поста.
                        Своими руками приведите интерактивную ленту и каретку в состояние <strong>после выполнения команды</strong>, либо зафиксируйте аварийный останов при недопустимой операции (попытка поставить метку на метку или стереть пустоту).
                    </p>

                    <!-- Исходная лента -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3 text-center">
                        <div class="text-secondary small font-monospace mb-2">ИСХОДНОЕ СОСТОЯНИЕ ЛЕНТЫ:</div>
                        <div id="p1-initial-tape" class="d-flex justify-content-center align-items-center gap-1 font-monospace fs-4"></div>
                    </div>

                    <!-- Карточка выполняемой команды -->
                    <div class="card bg-black border-success rounded-0 p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-secondary font-monospace small d-block">ВЫПОЛНЯЕМАЯ КОМАНДА:</span>
                                <span id="p1-command-display" class="font-monospace fs-4 text-warning fw-bold"></span>
                            </div>
                            <div class="text-end text-secondary small font-monospace">
                                Правило: <span class="text-light">1 такт Поста</span>
                            </div>
                        </div>
                    </div>

                    <!-- Рабочая интерактивная лента -->
                    <div class="card bg-black border-success rounded-0 p-3 mb-3 text-center">
                        <div class="text-success small font-monospace mb-2">ВАША РАБОЧАЯ ЛЕНТА (КЛИКАЙТЕ ДЛЯ УСТАНОВКИ/СНЯТИЯ МЕТКИ V):</div>
                        <div id="p1-work-tape" class="d-flex justify-content-center align-items-center gap-1 font-monospace fs-4 mb-3"></div>
                        <div class="d-flex justify-content-center align-items-center gap-2">
                            <button id="p1-shift-left" class="btn btn-outline-secondary font-monospace rounded-0 btn-sm px-3">← Сдвинуть каретку влево</button>
                            <span class="text-secondary font-monospace small px-2">Каретка: ячейка #<span id="p1-head-index" class="text-success fw-bold"></span></span>
                            <button id="p1-shift-right" class="btn btn-outline-secondary font-monospace rounded-0 btn-sm px-3">Сдвинуть каретку вправо →</button>
                        </div>
                    </div>

                    <!-- Кнопки подтверждения -->
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button id="p1-submit-step" class="btn btn-success text-dark font-monospace fw-bold rounded-0 px-4 py-2 flex-grow-1">
                            ПРИМЕНИТЬ ТАКТ К ЛЕНТЕ
                        </button>
                        <button id="p1-submit-crash" class="btn btn-outline-danger font-monospace rounded-0 px-4 py-2">
                            ⚠️ ЗАФИКСИРОВАТЬ АВАРИЙНЫЙ ОСТАНОВ (CRASH)
                        </button>
                    </div>

                    <div id="p1-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [СБОЙ ТАКТА] Неверное моделирование состояния машины Поста! Новая конфигурация...
                    </div>
                </div>

                <!-- Фаза 2: Слот-пазл / Конструирование команды -->
                <div id="phase2" class="phase-container d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-success font-monospace mb-0">Шаг 2 из 3: Конструирование команды токенами</h4>
                        <span class="badge bg-success text-dark rounded-0">Фаза 2</span>
                    </div>
                    <p class="text-light">
                        Соберите требуемую команду машины Поста из токенов палитры. Нажимайте на токены в палитре, чтобы заполнить активные слоты команды. Лишние токены верните повторным кликом.
                    </p>

                    <!-- Описание цели шага -->
                    <div class="card bg-black border-success rounded-0 p-3 mb-3">
                        <div class="text-secondary small font-monospace mb-1">ТЕХНИЧЕСКОЕ ЗАДАНИЕ ДЛЯ КОМАНДЫ №<span id="p2-cmd-number" class="text-warning"></span>:</div>
                        <div id="p2-task-desc" class="font-monospace text-light fs-6 mb-2"></div>
                        <div class="small text-secondary font-monospace">
                            Синтаксис: <span class="text-light">i. V j</span> | <span class="text-light">i. . j</span> | <span class="text-light">i. → j</span> | <span class="text-light">i. ← j</span> | <span class="text-light">i. ? j, k</span> | <span class="text-light">i. !</span>
                        </div>
                    </div>

                    <!-- Зона слотов команды -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small font-monospace mb-2">СЛОТЫ СИНТАКСИЧЕСКОЙ СБОРКИ:</div>
                        <div id="p2-slots-container" class="d-flex align-items-center gap-2 font-monospace fs-4 flex-wrap"></div>
                    </div>

                    <!-- Палитра токенов -->
                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small font-monospace mb-2">ПАЛИТРА СТРОИТЕЛЬНЫХ БЛОКОВ (КЛИКАЙТЕ ДЛЯ ДОБАВЛЕНИЯ В СЛОТ):</div>
                        <div id="p2-tokens-palette" class="d-flex flex-wrap gap-2"></div>
                    </div>

                    <!-- Кнопки действия -->
                    <div class="d-flex gap-2 mb-3">
                        <button id="p2-submit-btn" class="btn btn-success text-dark font-monospace fw-bold rounded-0 px-4 py-2 flex-grow-1">
                            СКОМПИЛИРОВАТЬ И ПРОВЕРИТЬ КОМАНДУ
                        </button>
                        <button id="p2-reset-btn" class="btn btn-outline-secondary font-monospace rounded-0 px-3">
                            Очистить слоты
                        </button>
                    </div>

                    <div id="p2-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [СИНТАКСИЧЕСКИЙ СБОЙ] Ошибка структуры или переходов команды! Новая спецификация...
                    </div>
                </div>

                <!-- Фаза 3: Трассировка микроалгоритма на ленте -->
                <div id="phase3" class="phase-container d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-success font-monospace mb-0">Шаг 3 из 3: Исполнение микропрограммы Поста</h4>
                        <span class="badge bg-success text-dark rounded-0">Фаза 3</span>
                    </div>
                    <p class="text-light">
                        Проведите трассировку микропрограммы машины Поста от начальной команды №1 до останова <code class="text-warning">!</code>.
                        Своими руками приведите рабочую ленту и положение каретки в <strong>итоговое состояние</strong>, в котором машина завершит вычисления.
                    </p>

                    <div class="row g-3 mb-3">
                        <!-- Программа -->
                        <div class="col-md-6">
                            <div class="card bg-black border-success rounded-0 p-3 h-100">
                                <div class="text-secondary small font-monospace mb-2">ПРОГРАММА ВЫЧИСЛЕНИЯ:</div>
                                <div id="p3-program-listing" class="font-monospace text-light fs-5"></div>
                                <div class="small text-secondary font-monospace mt-2">
                                    Старт с команды №1. Останов по команде <span class="text-warning">!</span>.
                                </div>
                            </div>
                        </div>

                        <!-- Исходная лента -->
                        <div class="col-md-6">
                            <div class="card bg-black border-secondary rounded-0 p-3 h-100 text-center">
                                <div class="text-secondary small font-monospace mb-2">ИСХОДНАЯ ЛЕНТА ПЕРЕД ЗАПУСКОМ:</div>
                                <div id="p3-initial-tape" class="d-flex justify-content-center align-items-center gap-1 font-monospace fs-5 mb-2"></div>
                                <div class="small text-secondary font-monospace">
                                    Все остальные ячейки слева и справа бесконечно пусты.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Интерактивная лента для итогового результата -->
                    <div class="card bg-black border-success rounded-0 p-3 mb-3 text-center">
                        <div class="text-success small font-monospace mb-2">ИТОГОВОЕ СОСТОЯНИЕ ЛЕНТЫ (КЛИКАЙТЕ ПО КЛЕТКАМ ДЛЯ УСТАНОВКИ/СНЯТИЯ V):</div>
                        <div id="p3-work-tape" class="d-flex justify-content-center align-items-center gap-1 font-monospace fs-4 mb-3"></div>
                        <div class="d-flex justify-content-center align-items-center gap-2">
                            <button id="p3-shift-left" class="btn btn-outline-secondary font-monospace rounded-0 btn-sm px-3">← Сдвинуть каретку влево</button>
                            <span class="text-secondary font-monospace small px-2">Финальная каретка: ячейка #<span id="p3-head-index" class="text-success fw-bold"></span></span>
                            <button id="p3-shift-right" class="btn btn-outline-secondary font-monospace rounded-0 btn-sm px-3">Сдвинуть каретку вправо →</button>
                        </div>
                    </div>

                    <button id="p3-submit-btn" class="btn btn-success text-dark font-monospace fw-bold rounded-0 px-4 py-2 w-100 mb-3">
                        ПРОВЕРИТЬ ИТОГОВОЕ СОСТОЯНИЕ ЛЕНТЫ
                    </button>

                    <div id="p3-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [ОШИБКА ТРАССИРОВКИ] Конечное состояние ленты или каретки неверно! Генерация новой программы...
                    </div>
                </div>

                <!-- Экран завершения -->
                <div id="success-screen" class="phase-container d-none text-center py-5">
                    <div class="mb-3 text-success font-monospace display-4">✓ СЕССИЯ УСПЕШНО ЗАВЕРШЕНА</div>
                    <h3 class="text-light font-monospace mb-3">Базовая модель машины Поста освоена</h3>
                    <p class="text-secondary max-w-md mx-auto mb-4">
                        Вы успешно смоделировали такты на ленте, сконструировали команды системы команд исполнителя (СКИ) и провели трассировку алгоритмов до штатного останова.
                    </p>
                    <div class="badge border border-success text-success bg-black p-3 font-monospace fs-6 rounded-0">
                        Уровень 1 пройден. Переходите на Уровень 2 в верхней панели!
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script is:inline>
        const missionName = 'Урок 22 :: Машина Поста (Уровень 1)';
        const startTime = Date.now();
        let attempts = 0;

        function sendTelemetry(action_type, success = false) {
            const timeSpent = Math.floor((Date.now() - startTime) / 1000);
            window.parent.postMessage({
                type: 'TELEMETRY_EVENT',
                mission_name: missionName,
                action_type: action_type,
                status: action_type === 'level_complete' ? 'completed' : 'in_progress',
                start_time: new Date(startTime).toISOString(),
                time_spent_sec: timeSpent,
                attempts_count: attempts,
                success: success
            }, '*');
        }

        function rnd(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function shuffle(arr) {
            const a = [...arr];
            for (let i = a.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [a[i], a[j]] = [a[j], a[i]];
            }
            return a;
        }

        // ==========================================
        // ФАЗА 1: Моделирование такта на ленте
        // ==========================================
        let p1InitialTape = [];
        let p1InitialHead = 2;
        let p1WorkTape = [];
        let p1WorkHead = 2;
        let p1ExpectedTape = [];
        let p1ExpectedHead = 2;
        let p1IsCrash = false;

        function renderTapeUI(containerId, tape, headIndex, isInteractive = false, onCellClick = null) {
            const container = document.getElementById(containerId);
            container.innerHTML = '';
            tape.forEach((val, idx) => {
                const cellWrapper = document.createElement('div');
                cellWrapper.className = 'd-flex flex-column align-items-center';

                const box = document.createElement('div');
                box.className = `border px-3 py-2 ${idx === headIndex ? 'border-warning text-warning bg-dark fw-bold' : 'border-secondary text-light'}`;
                if (isInteractive) {
                    box.style.cursor = 'pointer';
                    box.title = 'Нажмите для изменения метки';
                }
                box.textContent = val === 1 ? 'V' : '.';

                if (isInteractive && onCellClick) {
                    box.addEventListener('click', () => onCellClick(idx));
                }

                const pointer = document.createElement('div');
                pointer.className = 'small mt-1 font-monospace';
                if (idx === headIndex) {
                    pointer.className += ' text-warning fw-bold';
                    pointer.innerHTML = '▲';
                } else {
                    pointer.innerHTML = '&nbsp;';
                }

                cellWrapper.appendChild(box);
                cellWrapper.appendChild(pointer);
                container.appendChild(cellWrapper);
            });
        }

        function initPhase1() {
            // 7 ячеек, каретка стартует в ячейках 2..4
            p1InitialTape = [0, rnd(0, 1), rnd(0, 1), rnd(0, 1), rnd(0, 1), rnd(0, 1), 0];
            p1InitialHead = rnd(2, 4);

            // Клонируем в рабочую ленту
            p1WorkTape = [...p1InitialTape];
            p1WorkHead = p1InitialHead;

            // Выбираем тип команды:
            // 0: V (поставить метку)
            // 1: . (стереть метку)
            // 2: → (вправо)
            // 3: ← (влево)
            // 4: ? (ветвление - каретка и лента не меняются)
            const cmdType = rnd(0, 4);
            const cmdNum = rnd(1, 3);
            const nextNum = rnd(2, 5);
            let cmdStr = '';

            p1ExpectedTape = [...p1InitialTape];
            p1ExpectedHead = p1InitialHead;
            p1IsCrash = false;

            const currCell = p1InitialTape[p1InitialHead];

            if (cmdType === 0) {
                // Команда V: если уже стоит V -> авария! Если пусто -> ставит V
                cmdStr = `${cmdNum}. V ${nextNum}`;
                if (currCell === 1) {
                    p1IsCrash = true;
                } else {
                    p1ExpectedTape[p1InitialHead] = 1;
                }
            } else if (cmdType === 1) {
                // Команда .: если пусто -> авария! Если стоит V -> стирает
                cmdStr = `${cmdNum}. . ${nextNum}`;
                if (currCell === 0) {
                    p1IsCrash = true;
                } else {
                    p1ExpectedTape[p1InitialHead] = 0;
                }
            } else if (cmdType === 2) {
                // Команда →
                cmdStr = `${cmdNum}. → ${nextNum}`;
                p1ExpectedHead = Math.min(p1InitialTape.length - 1, p1InitialHead + 1);
            } else if (cmdType === 3) {
                // Команда ←
                cmdStr = `${cmdNum}. ← ${nextNum}`;
                p1ExpectedHead = Math.max(0, p1InitialHead - 1);
            } else {
                // Команда ? j, k: каретка и лента не меняются
                const altNum = nextNum + 1;
                cmdStr = `${cmdNum}. ? ${nextNum}, ${altNum}`;
            }

            document.getElementById('p1-command-display').textContent = cmdStr;
            document.getElementById('p1-head-index').textContent = p1WorkHead + 1;

            renderTapeUI('p1-initial-tape', p1InitialTape, p1InitialHead, false);
            updatePhase1WorkUI();
        }

        function updatePhase1WorkUI() {
            document.getElementById('p1-head-index').textContent = p1WorkHead + 1;
            renderTapeUI('p1-work-tape', p1WorkTape, p1WorkHead, true, (idx) => {
                p1WorkTape[idx] = p1WorkTape[idx] === 1 ? 0 : 1;
                updatePhase1WorkUI();
            });
        }

        document.getElementById('p1-shift-left').addEventListener('click', () => {
            if (p1WorkHead > 0) {
                p1WorkHead--;
                updatePhase1WorkUI();
            }
        });

        document.getElementById('p1-shift-right').addEventListener('click', () => {
            if (p1WorkHead < p1WorkTape.length - 1) {
                p1WorkHead++;
                updatePhase1WorkUI();
            }
        });

        function checkPhase1Result(userReportedCrash) {
            const feedback = document.getElementById('p1-feedback');
            const submitStep = document.getElementById('p1-submit-step');
            const submitCrash = document.getElementById('p1-submit-crash');

            let isCorrect = false;

            if (p1IsCrash) {
                isCorrect = userReportedCrash === true;
            } else {
                if (userReportedCrash === false) {
                    const tapeMatch = p1WorkTape.every((v, i) => v === p1ExpectedTape[i]);
                    const headMatch = p1WorkHead === p1ExpectedHead;
                    isCorrect = tapeMatch && headMatch;
                }
            }

            if (isCorrect) {
                document.getElementById('phase1').classList.add('d-none');
                document.getElementById('phase2').classList.remove('d-none');
                sendTelemetry('in_progress');
                initPhase2();
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                submitStep.disabled = true;
                submitCrash.disabled = true;
                feedback.classList.remove('d-none');

                setTimeout(() => {
                    initPhase1();
                    submitStep.disabled = false;
                    submitCrash.disabled = false;
                    feedback.classList.add('d-none');
                }, 1200);
            }
        }

        document.getElementById('p1-submit-step').addEventListener('click', () => checkPhase1Result(false));
        document.getElementById('p1-submit-crash').addEventListener('click', () => checkPhase1Result(true));

        // ==========================================
        // ФАЗА 2: Слот-пазл / Конструирование команды
        // ==========================================
        let p2ExpectedTokens = [];
        let p2CurrentSlots = [];
        let p2SlotCount = 2;

        const p2Templates = [
            {
                type: 'action',
                actionToken: 'V',
                text: 'Поставить метку V в текущую ячейку и передать управление команде номер',
                slotType: 'standard'
            },
            {
                type: 'action',
                actionToken: '.',
                text: 'Стереть метку в текущей ячейке и передать управление команде номер',
                slotType: 'standard'
            },
            {
                type: 'action',
                actionToken: '→',
                text: 'Сдвинуть каретку на одну ячейку вправо и передать управление команде номер',
                slotType: 'standard'
            },
            {
                type: 'action',
                actionToken: '←',
                text: 'Сдвинуть каретку на одну ячейку влево и передать управление команде номер',
                slotType: 'standard'
            },
            {
                type: 'branch',
                text: 'Проверить метку: если есть V, перейти к команде',
                textElse: '; если ячейка пуста — перейти к команде',
                slotType: 'branch'
            },
            {
                type: 'stop',
                text: 'Завершить выполнение алгоритма (штатный останов программы)',
                slotType: 'stop'
            }
        ];

        function initPhase2() {
            const cmdNum = rnd(1, 4);
            document.getElementById('p2-cmd-number').textContent = cmdNum;

            const scenario = p2Templates[rnd(0, p2Templates.length - 1)];
            const targetNext = rnd(1, 5);
            const targetElse = targetNext === 5 ? 1 : targetNext + 1;

            let taskText = '';
            p2ExpectedTokens = [];

            if (scenario.slotType === 'standard') {
                taskText = `${scenario.text} ${targetNext}.`;
                p2ExpectedTokens = [scenario.actionToken, targetNext.toString()];
                p2SlotCount = 2;
            } else if (scenario.slotType === 'branch') {
                taskText = `${scenario.text} ${targetNext}${scenario.textElse} ${targetElse}.`;
                p2ExpectedTokens = ['?', targetNext.toString(), targetElse.toString()];
                p2SlotCount = 3;
            } else {
                taskText = scenario.text;
                p2ExpectedTokens = ['!'];
                p2SlotCount = 1;
            }

            document.getElementById('p2-task-desc').textContent = taskText;
            p2CurrentSlots = new Array(p2SlotCount).fill(null);

            // Формируем токены палитры (правильные + дистракторы)
            const allPossibleActions = ['V', '.', '→', '←', '?', '!'];
            const allPossibleNums = ['1', '2', '3', '4', '5'];

            const paletteSet = new Set(p2ExpectedTokens);
            while (paletteSet.size < Math.max(6, p2ExpectedTokens.length + 4)) {
                if (Math.random() > 0.5) {
                    paletteSet.add(allPossibleActions[rnd(0, allPossibleActions.length - 1)]);
                } else {
                    paletteSet.add(allPossibleNums[rnd(0, allPossibleNums.length - 1)]);
                }
            }

            const paletteList = shuffle(Array.from(paletteSet));
            renderPhase2Slots();
            renderPhase2Palette(paletteList);
        }

        function renderPhase2Slots() {
            const container = document.getElementById('p2-slots-container');
            container.innerHTML = '';

            const cmdPrefix = document.createElement('span');
            cmdPrefix.className = 'text-warning fw-bold me-2';
            cmdPrefix.textContent = `${document.getElementById('p2-cmd-number').textContent}.`;
            container.appendChild(cmdPrefix);

            p2CurrentSlots.forEach((token, idx) => {
                const slot = document.createElement('div');
                slot.className = `border px-3 py-2 text-center rounded-0 ${token ? 'border-success text-success bg-black' : 'border-secondary text-secondary border-dashed'}`;
                slot.style.minWidth = '54px';
                slot.style.cursor = 'pointer';
                slot.textContent = token || '[ ? ]';
                slot.title = token ? 'Нажмите для удаления токена' : 'Свободный слот';

                if (token) {
                    slot.addEventListener('click', () => {
                        p2CurrentSlots[idx] = null;
                        renderPhase2Slots();
                    });
                }
                container.appendChild(slot);
            });
        }

        function renderPhase2Palette(paletteList) {
            const paletteEl = document.getElementById('p2-tokens-palette');
            paletteEl.innerHTML = '';

            paletteList.forEach(item => {
                const btn = document.createElement('button');
                btn.className = 'btn btn-outline-success font-monospace rounded-0 px-3 py-2 fs-5 fw-bold';
                btn.textContent = item;
                btn.addEventListener('click', () => {
                    const emptyIdx = p2CurrentSlots.indexOf(null);
                    if (emptyIdx !== -1) {
                        p2CurrentSlots[emptyIdx] = item;
                        renderPhase2Slots();
                    }
                });
                paletteEl.appendChild(btn);
            });
        }

        document.getElementById('p2-reset-btn').addEventListener('click', () => {
            p2CurrentSlots = new Array(p2SlotCount).fill(null);
            renderPhase2Slots();
        });

        document.getElementById('p2-submit-btn').addEventListener('click', () => {
            const feedback = document.getElementById('p2-feedback');
            const submitBtn = document.getElementById('p2-submit-btn');

            const isFilled = p2CurrentSlots.every(t => t !== null);
            const isMatch = isFilled && p2CurrentSlots.every((t, i) => t === p2ExpectedTokens[i]);

            if (isMatch) {
                document.getElementById('phase2').classList.add('d-none');
                document.getElementById('phase3').classList.remove('d-none');
                sendTelemetry('in_progress');
                initPhase3();
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                submitBtn.disabled = true;
                feedback.classList.remove('d-none');

                setTimeout(() => {
                    initPhase2();
                    submitBtn.disabled = false;
                    feedback.classList.add('d-none');
                }, 1200);
            }
        });

        // ==========================================
        // ФАЗА 3: Трассировка микроалгоритма на ленте
        // ==========================================
        let p3InitialTape = [];
        let p3InitialHead = 2;
        let p3WorkTape = [];
        let p3WorkHead = 2;
        let p3ExpectedTape = [];
        let p3ExpectedHead = 2;

        function initPhase3() {
            // Варианты классических микроалгоритмов Полякова:
            // 0: Инкремент числа (шаг влево, V, останов)
            // 1: Удаление метки справа (шаг вправо, ., останов)
            // 2: Заполнение двух пустых клеток подряд (V, шаг вправо, V, останов)
            // 3: Стирание двух меток подряд (., шаг вправо, ., останов)
            const algoType = rnd(0, 3);
            p3InitialTape = [0, 0, 0, 0, 0, 0, 0];
            p3ExpectedTape = [0, 0, 0, 0, 0, 0, 0];

            let programLines = [];

            if (algoType === 0) {
                // Инкремент унарного числа: число из 2 меток на позициях 3 и 4, каретка на 3.
                // 1. ← 2
                // 2. V 3
                // 3. !
                p3InitialTape = [0, 0, 0, 1, 1, 0, 0];
                p3InitialHead = 3;

                programLines = [
                    '1. ← 2',
                    '2. V 3',
                    '3. !'
                ];

                p3ExpectedTape = [0, 0, 1, 1, 1, 0, 0];
                p3ExpectedHead = 2; // Шагнули влево на 2 и поставили V
            } else if (algoType === 1) {
                // Удаление метки: 3 метки на позициях 2, 3, 4. Каретка на 3.
                // 1. → 2
                // 2. . 3
                // 3. !
                p3InitialTape = [0, 0, 1, 1, 1, 0, 0];
                p3InitialHead = 3;

                programLines = [
                    '1. → 2',
                    '2. . 3',
                    '3. !'
                ];

                p3ExpectedTape = [0, 0, 1, 1, 0, 0, 0];
                p3ExpectedHead = 4; // Шагнули вправо на 4 и стерли метку
            } else if (algoType === 2) {
                // Заполнение двух клеток: каретка на 2
                // 1. V 2
                // 2. → 3
                // 3. V 4
                // 4. !
                p3InitialTape = [0, 0, 0, 0, 0, 0, 0];
                p3InitialHead = 2;

                programLines = [
                    '1. V 2',
                    '2. → 3',
                    '3. V 4',
                    '4. !'
                ];

                p3ExpectedTape = [0, 0, 1, 1, 0, 0, 0];
                p3ExpectedHead = 3; // На 2 поставили V, перешли на 3 и поставили V
            } else {
                // Стирание двух меток подряд: метки на 2 и 3, каретка на 2
                // 1. . 2
                // 2. → 3
                // 3. . 4
                // 4. !
                p3InitialTape = [0, 0, 1, 1, 0, 0, 0];
                p3InitialHead = 2;

                programLines = [
                    '1. . 2',
                    '2. → 3',
                    '3. . 4',
                    '4. !'
                ];

                p3ExpectedTape = [0, 0, 0, 0, 0, 0, 0];
                p3ExpectedHead = 3;
            }

            p3WorkTape = [...p3InitialTape];
            p3WorkHead = p3InitialHead;

            // Отображаем листинг
            const listing = document.getElementById('p3-program-listing');
            listing.innerHTML = programLines.map(line => `<div class="py-1">${line}</div>`).join('');

            renderTapeUI('p3-initial-tape', p3InitialTape, p3InitialHead, false);
            updatePhase3WorkUI();
        }

        function updatePhase3WorkUI() {
            document.getElementById('p3-head-index').textContent = p3WorkHead + 1;
            renderTapeUI('p3-work-tape', p3WorkTape, p3WorkHead, true, (idx) => {
                p3WorkTape[idx] = p3WorkTape[idx] === 1 ? 0 : 1;
                updatePhase3WorkUI();
            });
        }

        document.getElementById('p3-shift-left').addEventListener('click', () => {
            if (p3WorkHead > 0) {
                p3WorkHead--;
                updatePhase3WorkUI();
            }
        });

        document.getElementById('p3-shift-right').addEventListener('click', () => {
            if (p3WorkHead < p3WorkTape.length - 1) {
                p3WorkHead++;
                updatePhase3WorkUI();
            }
        });

        document.getElementById('p3-submit-btn').addEventListener('click', () => {
            const feedback = document.getElementById('p3-feedback');
            const submitBtn = document.getElementById('p3-submit-btn');

            const tapeMatch = p3WorkTape.every((v, i) => v === p3ExpectedTape[i]);
            const headMatch = p3WorkHead === p3ExpectedHead;

            if (tapeMatch && headMatch) {
                document.getElementById('phase3').classList.add('d-none');
                document.getElementById('success-screen').classList.remove('d-none');
                sendTelemetry('level_complete', true);
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                submitBtn.disabled = true;
                feedback.classList.remove('d-none');

                setTimeout(() => {
                    initPhase3();
                    submitBtn.disabled = false;
                    feedback.classList.add('d-none');
                }, 1200);
            }
        });

        // Старт симуляции
        sendTelemetry('in_progress');
        initPhase1();
    </script>
</TaskLayout>
