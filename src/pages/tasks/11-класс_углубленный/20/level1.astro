---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={1}>
    <div class="container my-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 text-success font-monospace mb-0">Тренажер: Эмуляция Машины Тьюринга (Уровень 1)</h2>
            <span class="badge border border-success text-success bg-dark rounded-0 px-3 py-2 font-monospace">Базовый режим</span>
        </div>

        <div id="game-container" class="card bg-dark border-success rounded-0">
            <div class="card-body p-4">
                
                <!-- Фаза 1 -->
                <div id="phase1" class="phase-container">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-success font-monospace mb-0">Шаг 1 из 3: Анатомия команды Машины Тьюринга</h4>
                        <span class="badge bg-success text-dark rounded-0">Фаза 1</span>
                    </div>
                    <p class="text-light">
                        Проанализируйте текущее состояние ленты, положение каретки и предписанную команду.
                        Определите, какое элементарное действие совершит машина Тьюринга на текущем такте.
                    </p>

                    <!-- Визуализатор ленты -->
                    <div class="card bg-black border-success rounded-0 p-3 mb-4 text-center">
                        <div class="text-secondary small font-monospace mb-2">СОСТОЯНИЕ ЛЕНТЫ И ПОЛОЖЕНИЕ КАРЕТКИ:</div>
                        <div id="p1-tape-container" class="d-flex justify-content-center align-items-center gap-1 font-monospace fs-4">
                            <!-- Генерируется через JS -->
                        </div>
                    </div>

                    <!-- Карточка команды -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-secondary font-monospace small d-block">ВЫПОЛНЯЕМАЯ КОМАНДА:</span>
                                <span id="p1-command-display" class="font-monospace fs-4 text-warning fw-bold"></span>
                            </div>
                            <div class="text-end text-secondary small font-monospace">
                                Правило: <span class="text-light">q<sub>i</sub> a<sub>j</sub> → a<sub>l</sub> D q<sub>k</sub></span>
                            </div>
                        </div>
                    </div>

                    <p class="text-light mb-2">Выберите правильный результат выполнения такта:</p>
                    <div id="p1-options" class="d-grid gap-2 mb-3">
                        <!-- Кнопки вариантов -->
                    </div>

                    <div id="p1-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [СБОЙ ДЕСКРИПТОРА] Неверная интерпретация команды! Генерация новой конфигурации...
                    </div>
                </div>

                <!-- Фаза 2 -->
                <div id="phase2" class="phase-container d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-success font-monospace mb-0">Шаг 2 из 3: Чтение функциональной матрицы переходов</h4>
                        <span class="badge bg-success text-dark rounded-0">Фаза 2</span>
                    </div>
                    <p class="text-light">
                        Машина Тьюринга управляется таблицей команд. Сопоставьте текущее состояние внутреннего автомата и обозреваемый символ на ленте, чтобы выбрать нужную команду из матрицы.
                    </p>

                    <!-- Таблица переходов -->
                    <div class="table-responsive mb-4">
                        <table class="table table-dark table-bordered border-success text-center font-monospace align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="bg-black text-secondary">Состояние</th>
                                    <th class="bg-black text-light">Символ λ (пусто)</th>
                                    <th class="bg-black text-light">Символ 0</th>
                                    <th class="bg-black text-light">Символ 1</th>
                                </tr>
                            </thead>
                            <tbody id="p2-table-body">
                                <!-- Генерируется через JS -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Текущие условия -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="font-monospace">
                            ТЕКУЩИЙ СТАТУС: Каретка в состоянии <span id="p2-curr-state" class="badge bg-success text-dark fs-6 rounded-0"></span> 
                            обозревает ячейку с символом <span id="p2-curr-symbol" class="badge bg-warning text-dark fs-6 rounded-0"></span>.
                        </div>
                    </div>

                    <p class="text-light mb-2">Какое правило перехода должно быть активировано?</p>
                    <div id="p2-options" class="d-grid gap-2 mb-3">
                        <!-- Варианты выбора -->
                    </div>

                    <div id="p2-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [ОШИБКА АДРЕСАЦИИ] Неверная ячейка таблицы команд! Реконфигурация матрицы...
                    </div>
                </div>

                <!-- Фаза 3 -->
                <div id="phase3" class="phase-container d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-success font-monospace mb-0">Шаг 3 из 3: Трассировка микро-программы до останова</h4>
                        <span class="badge bg-success text-dark rounded-0">Фаза 3</span>
                    </div>
                    <p class="text-light">
                        Выполните пошаговую трассировку вычислений до достижения терминального состояния <code class="text-warning">q0</code>. 
                        Введите двоичное слово, которое останется на ленте после полной остановки машины.
                    </p>

                    <div class="row g-3 mb-4">
                        <div class="col-md-7">
                            <div class="card bg-black border-success rounded-0 p-3 h-100">
                                <div class="text-secondary small font-monospace mb-2">ПРОГРАММА АВТОМАТА (ТАБЛИЦА ПЕРЕХОДОВ):</div>
                                <div class="table-responsive">
                                    <table class="table table-dark table-sm table-bordered border-secondary text-center font-monospace mb-0">
                                        <thead>
                                            <tr>
                                                <th class="bg-black text-secondary">Q</th>
                                                <th>λ</th>
                                                <th>0</th>
                                                <th>1</th>
                                            </tr>
                                        </thead>
                                        <tbody id="p3-program-table">
                                            <!-- Генерируется через JS -->
                                        </tbody>
                                    </table>
                                </div>
                                <div class="small text-secondary mt-2 font-monospace">
                                    Примечание: переход в <span class="text-warning">q0</span> завершает алгоритм.
                                </div>
                            </div>
                        </div>

                        <div class="col-md-5">
                            <div class="card bg-black border-secondary rounded-0 p-3 h-100 font-monospace">
                                <div class="text-secondary small mb-2">НАЧАЛЬНЫЕ УСЛОВИЯ:</div>
                                <div class="mb-2">
                                    Слово на ленте: <span id="p3-initial-word" class="fw-bold text-success fs-5"></span>
                                </div>
                                <div class="mb-2">
                                    Старт каретки: <span id="p3-start-pos" class="text-light"></span>
                                </div>
                                <div class="text-secondary small">
                                    Слева и справа лента заполнена пустыми символами λ.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <label for="p3-input" class="form-label text-light font-monospace mb-2">
                            Введите результирующее слово на ленте (только непустые символы, например <span class="text-success">101</span>):
                        </label>
                        <div class="input-group">
                            <input type="text" id="p3-input" class="form-control bg-black text-success border-success rounded-0 font-monospace fs-5" placeholder="Например: 11" autocomplete="off">
                            <button id="p3-btn" class="btn btn-outline-success rounded-0 font-monospace px-4">ВЫПОЛНИТЬ ТРАССИРОВКУ</button>
                        </div>
                    </div>

                    <div id="p3-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [ОШИБКА ТРАССИРОВКИ] Неверное результирующее слово на ленте! Генерация нового задания...
                    </div>
                </div>

                <!-- Экран завершения -->
                <div id="success-screen" class="phase-container d-none text-center py-5">
                    <div class="mb-3 text-success font-monospace display-4">✓ СЕССИЯ УСПЕШНО ЗАВЕРШЕНА</div>
                    <h3 class="text-light font-monospace mb-3">Базовая модель машины Тьюринга освоена</h3>
                    <p class="text-secondary max-w-md mx-auto mb-4">
                        Вы успешно изучили формат элементарных команд, сопоставление состояний в матрице переходов и выполнили трассировку алгоритма до останова.
                    </p>
                    <div class="badge border border-success text-success bg-black p-3 font-monospace fs-6 rounded-0">
                        Уровень 1 пройден. Переходите на Уровень 2 в верхней панели!
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script is:inline>
        const missionName = 'Урок 20 :: Машина Тьюринга (Уровень 1)';
        const startTime = Date.now();
        let attempts = 0;

        function sendTelemetry(action_type, success = false) {
            const timeSpent = Math.floor((Date.now() - startTime) / 1000);
            window.parent.postMessage({
                type: 'TELEMETRY_EVENT',
                mission_name: missionName,
                action_type: action_type,
                status: action_type === 'level_complete' ? 'completed' : 'in_progress',
                start_time: new Date(startTime).toISOString(),
                time_spent_sec: timeSpent,
                attempts_count: attempts,
                success: success
            }, '*');
        }

        function rnd(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function shuffle(arr) {
            const a = [...arr];
            for (let i = a.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [a[i], a[j]] = [a[j], a[i]];
            }
            return a;
        }

        // ==========================================
        // ФАЗА 1: Анатомия команды
        // ==========================================
        let p1CorrectIndex = -1;

        function initPhase1() {
            const states = ['q1', 'q2', 'q3'];
            const nextStates = ['q0', 'q1', 'q2'];
            const symbols = ['0', '1'];
            const replaceSymbols = ['0', '1', 'λ'];
            const directions = ['L', 'R', 'S'];
            const dirNames = { 'L': 'влево (L)', 'R': 'вправо (R)', 'S': 'на месте (S)' };

            const currState = states[rnd(0, states.length - 1)];
            const currSymbol = symbols[rnd(0, symbols.length - 1)];
            const newSymbol = replaceSymbols[rnd(0, replaceSymbols.length - 1)];
            const direction = directions[rnd(0, directions.length - 1)];
            const nextState = nextStates[rnd(0, nextStates.length - 1)];

            // Сборка ленты: 5 ячеек, активная ячейка по центру (индекс 2)
            const tape = ['λ', symbols[rnd(0, 1)], currSymbol, symbols[rnd(0, 1)], 'λ'];
            const activeIndex = 2;

            const tapeContainer = document.getElementById('p1-tape-container');
            tapeContainer.innerHTML = '';
            tape.forEach((sym, idx) => {
                const cell = document.createElement('div');
                cell.className = 'd-flex flex-column align-items-center';
                
                const box = document.createElement('div');
                box.className = `border px-3 py-2 ${idx === activeIndex ? 'border-warning text-warning bg-dark fw-bold shadow' : 'border-secondary text-light'}`;
                box.textContent = sym;

                const pointer = document.createElement('div');
                pointer.className = 'small mt-1 font-monospace';
                if (idx === activeIndex) {
                    pointer.className += ' text-warning fw-bold';
                    pointer.innerHTML = `▲ [${currState}]`;
                } else {
                    pointer.innerHTML = '&nbsp;';
                }

                cell.appendChild(box);
                cell.appendChild(pointer);
                tapeContainer.appendChild(cell);
            });

            const commandStr = `${currState} ${currSymbol} → ${newSymbol} ${direction} ${nextState}`;
            document.getElementById('p1-command-display').textContent = commandStr;

            // Формирование вариантов ответа
            const correctText = `Записать '${newSymbol}', сдвинуть каретку ${dirNames[direction]}, перейти в состояние ${nextState}`;

            const distractors = new Set();
            while (distractors.size < 3) {
                const altSym = replaceSymbols.filter(s => s !== newSymbol)[rnd(0, replaceSymbols.length - 2)];
                const altDir = directions.filter(d => d !== direction)[rnd(0, directions.length - 2)];
                const altState = nextStates.filter(s => s !== nextState)[rnd(0, nextStates.length - 2)];

                const variantType = rnd(1, 3);
                let variant = '';
                if (variantType === 1) {
                    variant = `Записать '${altSym}', сдвинуть каретку ${dirNames[direction]}, перейти в состояние ${nextState}`;
                } else if (variantType === 2) {
                    variant = `Записать '${newSymbol}', сдвинуть каретку ${dirNames[altDir]}, перейти в состояние ${nextState}`;
                } else {
                    variant = `Записать '${newSymbol}', сдвинуть каретку ${dirNames[direction]}, перейти в состояние ${altState}`;
                }
                if (variant !== correctText) {
                    distractors.add(variant);
                }
            }

            const allOptions = shuffle([correctText, ...Array.from(distractors)]);
            p1CorrectIndex = allOptions.indexOf(correctText);

            const optionsContainer = document.getElementById('p1-options');
            optionsContainer.innerHTML = '';
            allOptions.forEach((optText, idx) => {
                const btn = document.createElement('button');
                btn.className = 'btn btn-outline-success text-start font-monospace rounded-0 py-2 px-3';
                btn.textContent = `${idx + 1}. ${optText}`;
                btn.addEventListener('click', () => handlePhase1Answer(idx));
                optionsContainer.appendChild(btn);
            });
        }

        function handlePhase1Answer(selectedIdx) {
            const feedback = document.getElementById('p1-feedback');
            const buttons = document.querySelectorAll('#p1-options button');
            buttons.forEach(b => b.disabled = true);

            if (selectedIdx === p1CorrectIndex) {
                document.getElementById('phase1').classList.add('d-none');
                document.getElementById('phase2').classList.remove('d-none');
                sendTelemetry('in_progress');
                initPhase2();
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                feedback.classList.remove('d-none');
                setTimeout(() => {
                    initPhase1();
                    feedback.classList.add('d-none');
                }, 1200);
            }
        }

        // ==========================================
        // ФАЗА 2: Чтение функциональной матрицы
        // ==========================================
        let p2CorrectIndex = -1;

        function initPhase2() {
            const states = ['q1', 'q2'];
            const symbols = ['λ', '0', '1'];
            const directions = ['L', 'R', 'S'];

            // Создаем процедурную таблицу переходов
            const matrix = {};
            states.forEach(st => {
                matrix[st] = {};
                symbols.forEach(sym => {
                    const newSym = sym === 'λ' ? (Math.random() > 0.5 ? '1' : 'λ') : (sym === '0' ? '1' : '0');
                    const dir = directions[rnd(0, 2)];
                    const nSt = Math.random() > 0.35 ? (st === 'q1' ? 'q2' : 'q1') : 'q0';
                    matrix[st][sym] = `${newSym} ${dir} ${nSt}`;
                });
            });

            // Заполняем HTML таблицы
            const tbody = document.getElementById('p2-table-body');
            tbody.innerHTML = '';
            states.forEach(st => {
                const tr = document.createElement('tr');
                tr.innerHTML = `<td class="text-success fw-bold bg-black">${st}</td>
                    <td>${matrix[st]['λ']}</td>
                    <td>${matrix[st]['0']}</td>
                    <td>${matrix[st]['1']}</td>`;
                tbody.appendChild(tr);
            });

            // Выбираем текущий вопрос
            const targetState = states[rnd(0, 1)];
            const targetSymbol = symbols[rnd(0, 2)];
            const targetCmd = matrix[targetState][targetSymbol];

            document.getElementById('p2-curr-state').textContent = targetState;
            document.getElementById('p2-curr-symbol').textContent = targetSymbol;

            const correctOption = `${targetState} ${targetSymbol} → ${targetCmd}`;

            // Собираем дистракторы из других ячеек таблицы
            const distractors = new Set();
            states.forEach(st => {
                symbols.forEach(sym => {
                    const opt = `${targetState} ${targetSymbol} → ${matrix[st][sym]}`;
                    if (opt !== correctOption) {
                        distractors.add(opt);
                    }
                });
            });

            const chosenDistractors = shuffle(Array.from(distractors)).slice(0, 3);
            const allOptions = shuffle([correctOption, ...chosenDistractors]);
            p2CorrectIndex = allOptions.indexOf(correctOption);

            const optionsContainer = document.getElementById('p2-options');
            optionsContainer.innerHTML = '';
            allOptions.forEach((optText, idx) => {
                const btn = document.createElement('button');
                btn.className = 'btn btn-outline-success text-start font-monospace rounded-0 py-2 px-3';
                btn.textContent = `${idx + 1}. Команда: [ ${optText} ]`;
                btn.addEventListener('click', () => handlePhase2Answer(idx));
                optionsContainer.appendChild(btn);
            });
        }

        function handlePhase2Answer(selectedIdx) {
            const feedback = document.getElementById('p2-feedback');
            const buttons = document.querySelectorAll('#p2-options button');
            buttons.forEach(b => b.disabled = true);

            if (selectedIdx === p2CorrectIndex) {
                document.getElementById('phase2').classList.add('d-none');
                document.getElementById('phase3').classList.remove('d-none');
                sendTelemetry('in_progress');
                initPhase3();
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                feedback.classList.remove('d-none');
                setTimeout(() => {
                    initPhase2();
                    feedback.classList.add('d-none');
                }, 1200);
            }
        }

        // ==========================================
        // ФАЗА 3: Трассировка микро-программы
        // ==========================================
        let p3ExpectedAnswer = '';

        function initPhase3() {
            const taskType = rnd(1, 2); // 1 = побитовая инверсия, 2 = двоичный инкремент
            const pTable = document.getElementById('p3-program-table');
            pTable.innerHTML = '';

            let word = '';
            let startPosText = '';

            if (taskType === 1) {
                // Побитовая инверсия 2-битного слова
                const b1 = rnd(0, 1).toString();
                const b2 = rnd(0, 1).toString();
                word = b1 + b2;
                startPosText = 'над первым (левым) символом';

                // Таблица инвертора
                pTable.innerHTML = `
                    <tr>
                        <td class="text-success fw-bold">q1</td>
                        <td>λ S q0</td>
                        <td>1 R q1</td>
                        <td>0 R q1</td>
                    </tr>
                `;

                // Ожидаемый ответ: инвертированные биты
                const inv1 = b1 === '1' ? '0' : '1';
                const inv2 = b2 === '1' ? '0' : '1';
                p3ExpectedAnswer = inv1 + inv2;

            } else {
                // Двоичный инкремент
                const num = rnd(1, 3); // 1='01', 2='10', 3='11'
                word = num === 1 ? '01' : (num === 2 ? '10' : '11');
                startPosText = 'над последним (правым) символом';

                // Таблица инкремента
                pTable.innerHTML = `
                    <tr>
                        <td class="text-success fw-bold">q1</td>
                        <td>1 S q0</td>
                        <td>1 S q0</td>
                        <td>0 L q1</td>
                    </tr>
                `;

                // Вычисление инкремента
                const inc = (num + 1).toString(2);
                p3ExpectedAnswer = inc;
            }

            document.getElementById('p3-initial-word').textContent = word;
            document.getElementById('p3-start-pos').textContent = startPosText;
            document.getElementById('p3-input').value = '';
            document.getElementById('p3-input').focus();
        }

        function handlePhase3Submit() {
            const input = document.getElementById('p3-input');
            const btn = document.getElementById('p3-btn');
            const feedback = document.getElementById('p3-feedback');

            const userVal = input.value.trim();

            if (userVal === p3ExpectedAnswer) {
                document.getElementById('phase3').classList.add('d-none');
                document.getElementById('success-screen').classList.remove('d-none');
                sendTelemetry('level_complete', true);
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                input.disabled = true;
                btn.disabled = true;
                feedback.classList.remove('d-none');

                setTimeout(() => {
                    initPhase3();
                    input.disabled = false;
                    btn.disabled = false;
                    feedback.classList.add('d-none');
                    input.focus();
                }, 1200);
            }
        }

        document.getElementById('p3-btn').addEventListener('click', handlePhase3Submit);
        document.getElementById('p3-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') handlePhase3Submit();
        });

        // Запуск
        sendTelemetry('in_progress');
        initPhase1();
    </script>
</TaskLayout>
