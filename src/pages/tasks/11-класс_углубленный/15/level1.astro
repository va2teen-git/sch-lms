---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
const missionName = 'Урок 15 :: Деревья :: Уровень 1';
---

<TaskLayout title="Уровень 1 — Свойства и структура деревьев" level={1} bodyClass="font-monospace">
    <div class="container-fluid px-2 px-md-3 my-3">
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-success pb-2 flex-wrap gap-2">
            <h2 class="h5 m-0 text-success fw-bold text-uppercase" id="phaseTitle">Этап 1 из 3: Топология дерева</h2>
            <span class="badge bg-black border border-secondary text-light rounded-0 fs-6 px-3 py-2">
                Ошибки: <span id="errorsCount">0</span>
            </span>
        </div>

        <div class="progress rounded-0 bg-black border border-success mb-3" style="height: 12px;">
            <div class="progress-bar bg-success" id="progressBar" role="progressbar" style="width: 0%;"></div>
        </div>

        <div id="statusBanner" class="alert rounded-0 border-0 fw-bold d-none mb-3"></div>

        <div class="card bg-dark border-success rounded-0" id="mainCard">
            <div class="card-body p-3 p-md-4">
                <div class="bg-black border border-success p-3 mb-3">
                    <div class="text-success small fw-bold text-uppercase mb-1">Задание:</div>
                    <div class="fs-5 text-white fw-bold" id="questionText">Инициализация графа...</div>
                    <div class="small text-secondary mt-1" id="questionHint">Кликайте непосредственно по узлам дерева, чтобы выделить их, затем нажмите «Проверить».</div>
                </div>

                <div class="position-relative bg-black border border-secondary mb-3" id="treeCanvas" style="height: 330px; overflow: hidden;">
                    <svg id="treeSvg" viewBox="0 0 600 330" preserveAspectRatio="none" class="w-100 h-100 position-absolute top-0 start-0" style="pointer-events: none;"></svg>
                    <div id="treeNodes" class="position-absolute top-0 start-0 w-100 h-100"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <span class="small text-light">Выделено узлов: <strong class="text-success" id="selectedCount">0</strong> (<span id="selectedList" class="text-warning">—</span>)</span>
                    <button type="button" id="clearBtn" class="btn btn-outline-secondary rounded-0 btn-sm px-3" style="min-height: 40px;">Сбросить выделение</button>
                </div>

                <button type="button" id="checkBtn" class="btn btn-success text-dark rounded-0 fw-bold px-4 py-2 w-100 text-uppercase" style="min-height: 48px;" disabled>
                    Проверить выделение
                </button>
            </div>
        </div>

        <div id="victoryBox" class="alert alert-success bg-success text-dark rounded-0 border-0 text-center py-5 mt-3 d-none">
            <h3 class="fw-bold text-uppercase mb-2">УРОВЕНЬ ПРОЙДЕН</h3>
            <p class="fs-5 mb-0 fw-semibold">Структура и свойства иерархических деревьев успешно восстановлены.</p>
        </div>
    </div>

    <script is:inline define:vars={{ missionName }}>
        (function () {
            const TOTAL_PHASES = 3;
            const telemetry = window.LMSTelemetry.create({
                missionName: missionName,
                level: 1,
                totalStages: TOTAL_PHASES
            });

            let currentPhase = 1;
            let errorsCount = 0;
            let locked = false;
            let expectedNodes = new Set();
            let selectedNodes = new Set();
            const actionLog = [];

            const phaseTitleEl = document.getElementById('phaseTitle');
            const progressBarEl = document.getElementById('progressBar');
            const errorsCountEl = document.getElementById('errorsCount');
            const statusBannerEl = document.getElementById('statusBanner');
            const questionTextEl = document.getElementById('questionText');
            const treeSvgEl = document.getElementById('treeSvg');
            const treeNodesEl = document.getElementById('treeNodes');
            const selectedCountEl = document.getElementById('selectedCount');
            const selectedListEl = document.getElementById('selectedList');
            const clearBtn = document.getElementById('clearBtn');
            const checkBtn = document.getElementById('checkBtn');
            const mainCardEl = document.getElementById('mainCard');
            const victoryBoxEl = document.getElementById('victoryBox');

            function showBanner(msg, isError) {
                statusBannerEl.textContent = msg;
                statusBannerEl.className = isError
                    ? 'alert alert-danger bg-danger text-white rounded-0 border-0 fw-bold mb-3'
                    : 'alert alert-success bg-success text-dark rounded-0 border-0 fw-bold mb-3';
                statusBannerEl.classList.remove('d-none');
            }

            function hideBanner() {
                statusBannerEl.classList.add('d-none');
                statusBannerEl.textContent = '';
            }

            function updateSelectionUI() {
                const sorted = Array.from(selectedNodes).sort();
                selectedCountEl.textContent = String(sorted.length);
                selectedListEl.textContent = sorted.length > 0 ? sorted.join(', ') : '—';
                checkBtn.disabled = locked || sorted.length === 0;
            }

            function generateRandomTree() {
                const names = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
                const count = currentPhase === 1 ? 7 : 8;
                const nodes = names.slice(0, count);
                const edges = [];
                const parentMap = { A: null };
                const childrenMap = { A: [] };
                const depthMap = { A: 0 };
                const inTree = ['A'];

                for (let i = 1; i < nodes.length; i++) {
                    const child = nodes[i];
                    // Prefer parents with depth <= 2 so tree fits cleanly in 4 levels (depth 0..3)
                    const eligible = inTree.filter(n => depthMap[n] < 3 && childrenMap[n].length < 3);
                    const pool = eligible.length > 0 ? eligible : inTree.filter(n => depthMap[n] < 3);
                    const parent = pool[Math.floor(Math.random() * pool.length)];
                    edges.push([parent, child]);
                    parentMap[child] = parent;
                    childrenMap[parent].push(child);
                    childrenMap[child] = [];
                    depthMap[child] = depthMap[parent] + 1;
                    inTree.push(child);
                }

                const leaves = nodes.filter(n => childrenMap[n].length === 0);
                const internals = nodes.filter(n => n !== 'A' && childrenMap[n].length > 0);
                // Ensure at least 2 internal nodes for phase 3
                if (internals.length < 2) {
                    return generateRandomTree();
                }

                return { nodes, edges, parentMap, childrenMap, depthMap, leaves, internals };
            }

            function renderTree(tree) {
                const levels = [[], [], [], []];
                for (const n of tree.nodes) {
                    levels[tree.depthMap[n]].push(n);
                }

                const coords = {};
                const yStep = 76;
                const yStart = 42;
                for (let d = 0; d < levels.length; d++) {
                    const row = levels[d];
                    if (row.length === 0) continue;
                    const y = yStart + d * yStep;
                    for (let i = 0; i < row.length; i++) {
                        const x = (600 / (row.length + 1)) * (i + 1);
                        coords[row[i]] = { x, y };
                    }
                }

                let svgHtml = '<defs><marker id="treeArrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M 0 0 L 10 5 L 0 10 z" fill="#198754" /></marker></defs>';
                for (const [p, c] of tree.edges) {
                    const n1 = coords[p];
                    const n2 = coords[c];
                    const dx = n2.x - n1.x;
                    const dy = n2.y - n1.y;
                    const len = Math.hypot(dx, dy) || 1;
                    const shrink = 22;
                    const x2 = n2.x - (dx / len) * shrink;
                    const y2 = n2.y - (dy / len) * shrink;
                    svgHtml += `<line x1="${n1.x}" y1="${n1.y}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}" stroke="#198754" stroke-width="2" marker-end="url(#treeArrow)" />`;
                }
                treeSvgEl.innerHTML = svgHtml;

                treeNodesEl.innerHTML = '';
                for (const n of tree.nodes) {
                    const pt = coords[n];
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.dataset.node = n;
                    btn.className = 'tree-node btn btn-outline-success bg-dark text-light rounded-0 fw-bold position-absolute d-flex align-items-center justify-content-center p-0';
                    btn.style.width = '48px';
                    btn.style.height = '48px';
                    btn.style.left = `calc(${(pt.x / 600) * 100}% - 24px)`;
                    btn.style.top = `calc(${(pt.y / 330) * 100}% - 24px)`;
                    btn.textContent = n;
                    treeNodesEl.appendChild(btn);
                }
            }

            function initPhase() {
                locked = false;
                selectedNodes.clear();
                hideBanner();

                phaseTitleEl.textContent = `Этап ${currentPhase} из ${TOTAL_PHASES}: Топология дерева`;
                progressBarEl.style.width = `${((currentPhase - 1) / TOTAL_PHASES) * 100}%`;

                const tree = generateRandomTree();
                renderTree(tree);

                if (currentPhase === 1) {
                    expectedNodes = new Set(tree.leaves);
                    questionTextEl.textContent = 'Выделите на схеме ВСЕ ЛИСТЬЯ данного дерева (узлы без потомков).';
                } else if (currentPhase === 2) {
                    const depthCounts = [1, 2, 3].filter(d => tree.nodes.filter(n => tree.depthMap[n] === d).length >= 2);
                    const targetDepth = depthCounts[Math.floor(Math.random() * depthCounts.length)] || 1;
                    expectedNodes = new Set(tree.nodes.filter(n => tree.depthMap[n] === targetDepth));
                    questionTextEl.textContent = `Выделите все узлы, находящиеся на ГЛУБИНЕ ${targetDepth} (глубина корня A равна 0).`;
                } else {
                    expectedNodes = new Set(tree.internals);
                    questionTextEl.textContent = 'Выделите все ВНУТРЕННИЕ УЗЛЫ дерева (не являющиеся ни корнем, ни листьями).';
                }

                updateSelectionUI();
                actionLog.push({ time: new Date().toISOString(), action: `phase_${currentPhase}_started` });
            }

            // Single delegated click listener on treeNodesEl
            treeNodesEl.addEventListener('click', (e) => {
                if (locked) return;
                const btn = e.target.closest('.tree-node');
                if (!btn) return;
                telemetry.start();
                const node = btn.dataset.node;
                if (selectedNodes.has(node)) {
                    selectedNodes.delete(node);
                    btn.classList.remove('btn-success', 'text-dark');
                    btn.classList.add('btn-outline-success', 'bg-dark', 'text-light');
                } else {
                    selectedNodes.add(node);
                    btn.classList.remove('btn-outline-success', 'bg-dark', 'text-light');
                    btn.classList.add('btn-success', 'text-dark');
                }
                updateSelectionUI();
            });

            clearBtn.addEventListener('click', () => {
                if (locked) return;
                selectedNodes.clear();
                treeNodesEl.querySelectorAll('.tree-node').forEach(btn => {
                    btn.classList.remove('btn-success', 'text-dark');
                    btn.classList.add('btn-outline-success', 'bg-dark', 'text-light');
                });
                updateSelectionUI();
            });

            checkBtn.addEventListener('click', () => {
                if (locked) return;
                telemetry.start();
                const isSameSize = selectedNodes.size === expectedNodes.size;
                const allMatch = isSameSize && Array.from(selectedNodes).every(n => expectedNodes.has(n));

                if (allMatch) {
                    actionLog.push({ time: new Date().toISOString(), action: `phase_${currentPhase}_passed` });
                    if (currentPhase < TOTAL_PHASES) {
                        currentPhase += 1;
                        telemetry.advanceStage(currentPhase, { action_log: actionLog });
                        showBanner('Верно! Генерируем новую топологию дерева...', false);
                        locked = true;
                        setTimeout(() => initPhase(), 650);
                    } else {
                        locked = true;
                        progressBarEl.style.width = '100%';
                        phaseTitleEl.textContent = 'ТОПОЛОГИЯ ВОССТАНОВЛЕНА';
                        mainCardEl.classList.add('d-none');
                        victoryBoxEl.classList.remove('d-none');
                        hideBanner();
                        telemetry.complete({ stage: TOTAL_PHASES, action_log: actionLog });
                    }
                } else {
                    locked = true;
                    errorsCount += 1;
                    errorsCountEl.textContent = String(errorsCount);
                    actionLog.push({ time: new Date().toISOString(), action: `phase_${currentPhase}_failed` });
                    telemetry.hardcoreReset({ stage: currentPhase, action_log: actionLog });
                    showBanner('Ошибка! Выделен неверный набор узлов. Перегенерация дерева...', true);
                    setTimeout(() => initPhase(), 1100);
                }
                updateSelectionUI();
            });

            initPhase();
        })();
    </script>
</TaskLayout>
