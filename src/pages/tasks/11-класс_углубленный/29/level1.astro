---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={1}>
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Заголовок тренажера -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h4 text-success mb-0">Тренажер: Длинная арифметика и архитектура многоразрядных чисел (Уровень 1)</h2>
                <div class="text-secondary small">Урок 29 // 11 класс (технологический профиль)</div>
            </div>
            <span class="badge border border-success text-success bg-dark rounded-0 px-3 py-2">
                Манипуляция мышью // Zero Multiple Choice
            </span>
        </div>

        <div id="game-container" class="card bg-dark border-success rounded-0 shadow">
            <div class="card-body p-3 p-md-4">

                <!-- Индикатор прогресса, ошибки и таймер -->
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="phase-badge" class="badge bg-success text-dark rounded-0 fs-6 me-2">Шаг 1 из 3</span>
                        <span id="phase-title" class="text-light fw-bold fs-6">Архитектура Little-Endian и нормализация блоков</span>
                    </div>
                    <div class="text-secondary small">
                        Ошибки: <span id="attempts-display" class="text-warning fw-bold">0</span> | 
                        Время: <span id="timer-display" class="text-info fw-bold">00:00</span>
                    </div>
                </div>

                <!-- Системный баннер ошибки / сбоя -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between">
                        <span>
                            <strong>[ОШИБКА АРХИТЕКТУРЫ]</strong> <span id="feedback-text">Неверная компоновка разрядов!</span> 
                            Регенерация фазы...
                        </span>
                        <div class="spinner-border spinner-border-sm text-danger" role="status"></div>
                    </div>
                </div>

                <!-- ========================================================= -->
                <!-- ФАЗА 1: Слот-пазл Little-Endian и нормализация блоков      -->
                <!-- ========================================================= -->
                <div id="phase1" class="phase-container">
                    <div class="bg-black p-3 border border-secondary mb-3">
                        <div class="text-light mb-2">
                            Целевое многоразрядное число: <strong id="p1-target-number" class="text-warning fs-5">40500120007</strong>
                        </div>
                        <div class="text-secondary small">
                            Основание системы счисления: <span class="text-info">B = 10⁴ = 10 000</span> (блоки по 4 десятичных знака).
                            <br>
                            ИНСТРУКЦИЯ: Распределите блоки цифр по ячейкам массива в памяти.
                            Помните о стандарте <strong>Little-Endian</strong>: младший разряд (единицы) хранится в <code>A[0]</code>, 
                            а неполные внутренние блоки обязательно сохраняют <strong>ведущие нули</strong>!
                        </div>
                    </div>

                    <!-- Слоты массива A[i] -->
                    <div class="row g-2 mb-4">
                        <div class="col-12 col-md-4">
                            <div class="card bg-black border-secondary rounded-0 p-3 h-100">
                                <div class="text-success small fw-bold mb-1">ЯЧЕЙКА A[0] (Вес: B⁰ = 1)</div>
                                <div class="text-secondary small mb-2">Младший блок (единицы)</div>
                                <div id="p1-slot-0" class="slot-box border border-dashed border-success p-2 text-center rounded-0 d-flex align-items-center justify-content-center" style="min-height: 52px;" data-slot="0">
                                    <span class="text-secondary small placeholder-text">[Слот A[0]]</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="card bg-black border-secondary rounded-0 p-3 h-100">
                                <div class="text-info small fw-bold mb-1">ЯЧЕЙКА A[1] (Вес: B¹ = 10 000)</div>
                                <div class="text-secondary small mb-2">Средний блок (десятки тысяч)</div>
                                <div id="p1-slot-1" class="slot-box border border-dashed border-info p-2 text-center rounded-0 d-flex align-items-center justify-content-center" style="min-height: 52px;" data-slot="1">
                                    <span class="text-secondary small placeholder-text">[Слот A[1]]</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="card bg-black border-secondary rounded-0 p-3 h-100">
                                <div class="text-warning small fw-bold mb-1">ЯЧЕЙКА A[2] (Вес: B² = 100 000 000)</div>
                                <div class="text-secondary small mb-2">Старший блок (сотни миллионов)</div>
                                <div id="p1-slot-2" class="slot-box border border-dashed border-warning p-2 text-center rounded-0 d-flex align-items-center justify-content-center" style="min-height: 52px;" data-slot="2">
                                    <span class="text-secondary small placeholder-text">[Слот A[2]]</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Палитра токенов -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-2">ПАЛИТРА БЛОКОВ ЦИФР (кликните токен, затем целевой слот, либо перетащите мышью):</div>
                        <div id="p1-tokens-palette" class="d-flex flex-wrap gap-2" style="min-height: 48px;">
                            <!-- Генерируется динамически через JS -->
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <button id="p1-reset-btn" class="btn btn-outline-secondary rounded-0 px-3" style="min-height: 48px;">
                            СБРОСИТЬ СЛОТЫ
                        </button>
                        <button id="p1-submit-btn" class="btn btn-success rounded-0 px-4 fw-bold" style="min-height: 48px;">
                            ПОДТВЕРДИТЬ КОМПОНОВКУ
                        </button>
                    </div>
                </div>

                <!-- ========================================================= -->
                <!-- ФАЗА 2: Поразрядный сумматор и перенос разряда (Carry)    -->
                <!-- ========================================================= -->
                <div id="phase2" class="phase-container d-none">
                    <div class="bg-black p-3 border border-secondary mb-3">
                        <div class="text-light mb-1">
                            Основание сумматора: <span class="text-info fw-bold">B = 1000</span> (по 3 десятичных разряда на блок).
                        </div>
                        <div class="text-secondary small">
                            ИНСТРУКЦИЯ: Смоделируйте поразрядное сложение в столбик: <code>A + B = C</code>.
                            Распределите токены <strong>переносов (carry)</strong> в верхние слоты и <strong>разряды суммы</strong> в нижние слоты результата.
                            Помните формулы: <code>sum = A[i] + B[i] + carry</code>, <code>C[i] = sum % B</code>, <code>next_carry = sum // B</code>.
                        </div>
                    </div>

                    <!-- Интерактивная таблица сумматора -->
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered border-secondary bg-black text-center align-middle mb-0">
                            <thead>
                                <tr class="text-secondary small">
                                    <th style="width: 25%;">Разряд 2 (B² = 1 000 000)</th>
                                    <th style="width: 25%;">Разряд 1 (B¹ = 1 000)</th>
                                    <th style="width: 25%;">Разряд 0 (B⁰ = 1)</th>
                                    <th style="width: 25%;">Уровень регистра</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Строка переноса -->
                                <tr class="bg-dark">
                                    <td>
                                        <div id="p2-slot-carry2" class="slot-box border border-dashed border-warning p-1 rounded-0 d-flex align-items-center justify-content-center" style="min-height: 48px;" data-slot="carry2">
                                            <span class="text-secondary small">[carry 2]</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div id="p2-slot-carry1" class="slot-box border border-dashed border-warning p-1 rounded-0 d-flex align-items-center justify-content-center" style="min-height: 48px;" data-slot="carry1">
                                            <span class="text-secondary small">[carry 1]</span>
                                        </div>
                                    </td>
                                    <td class="text-secondary small">—</td>
                                    <td class="text-warning small text-start ps-3 fw-bold">ПЕРЕНОС (CARRY)</td>
                                </tr>
                                <!-- Строка A -->
                                <tr>
                                    <td class="text-secondary">—</td>
                                    <td id="p2-val-a1" class="text-light fs-5 fw-bold font-monospace">425</td>
                                    <td id="p2-val-a0" class="text-light fs-5 fw-bold font-monospace">684</td>
                                    <td class="text-info small text-start ps-3 fw-bold">ЧИСЛО A[i]</td>
                                </tr>
                                <!-- Строка B -->
                                <tr>
                                    <td class="text-secondary">—</td>
                                    <td id="p2-val-b1" class="text-light fs-5 fw-bold font-monospace">+ 812</td>
                                    <td id="p2-val-b0" class="text-light fs-5 fw-bold font-monospace">+ 739</td>
                                    <td class="text-info small text-start ps-3 fw-bold">ЧИСЛО B[i]</td>
                                </tr>
                                <!-- Строка C (Результат) -->
                                <tr class="border-top border-2 border-success bg-dark">
                                    <td>
                                        <div id="p2-slot-res2" class="slot-box border border-dashed border-success p-1 rounded-0 d-flex align-items-center justify-content-center" style="min-height: 48px;" data-slot="res2">
                                            <span class="text-secondary small">[C[2]]</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div id="p2-slot-res1" class="slot-box border border-dashed border-success p-1 rounded-0 d-flex align-items-center justify-content-center" style="min-height: 48px;" data-slot="res1">
                                            <span class="text-secondary small">[C[1]]</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div id="p2-slot-res0" class="slot-box border border-dashed border-success p-1 rounded-0 d-flex align-items-center justify-content-center" style="min-height: 48px;" data-slot="res0">
                                            <span class="text-secondary small">[C[0]]</span>
                                        </div>
                                    </td>
                                    <td class="text-success small text-start ps-3 fw-bold">СУММА C[i]</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Палитра токенов Фазы 2 -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-2">ПАЛИТРА ЗНАЧЕНИЙ (кликните токен, затем целевой слот, либо перетащите мышью):</div>
                        <div id="p2-tokens-palette" class="d-flex flex-wrap gap-2" style="min-height: 48px;">
                            <!-- Генерируется динамически через JS -->
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <button id="p2-reset-btn" class="btn btn-outline-secondary rounded-0 px-3" style="min-height: 48px;">
                            ОЧИСТИТЬ СУММАТОР
                        </button>
                        <button id="p2-submit-btn" class="btn btn-success rounded-0 px-4 fw-bold" style="min-height: 48px;">
                            ПРОВЕРИТЬ СЛОЖЕНИЕ
                        </button>
                    </div>
                </div>

                <!-- ========================================================= -->
                <!-- ФАЗА 3: Сортировка операций по сложности (Buckets)        -->
                <!-- ========================================================= -->
                <div id="phase3" class="phase-container d-none">
                    <p class="text-light mb-3">
                        Распределите алгоритмы и операции длинной арифметики по 3 целевым контейнерам в соответствии с их 
                        <strong>асимптотической сложностью</strong>.
                        <br>
                        <span class="text-secondary small">Кликните на карточку алгоритма в пуле, затем кликните на целевую корзину для перемещения.</span>
                    </p>

                    <!-- Пул доступных карточек -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-2">ОПЕРАЦИИ ДЛЯ КЛАССИФИКАЦИИ:</div>
                        <div id="p3-pool" class="d-flex flex-wrap gap-2 align-items-center" style="min-height: 48px;">
                            <!-- Карточки операций -->
                        </div>
                    </div>

                    <!-- 3 Целевые корзины -->
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-4">
                            <div id="bucket-linear" class="bucket-card card bg-black border border-primary rounded-0 p-3 h-100" data-bucket="linear" style="cursor: pointer;">
                                <div class="text-primary fw-bold mb-1">КОРЗИНА 1: ЛИНЕЙНАЯ O(N)</div>
                                <div class="text-secondary small mb-2">Операции одного прохода по разрядам (сложение, вычитание, скаляры)</div>
                                <div class="bucket-items d-flex flex-wrap gap-2 p-2 border border-secondary rounded-0 bg-dark" style="min-height: 64px;">
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div id="bucket-poly" class="bucket-card card bg-black border border-warning rounded-0 p-3 h-100" data-bucket="poly" style="cursor: pointer;">
                                <div class="text-warning fw-bold mb-1">КОРЗИНА 2: O(N² / N¹·⁵⁸⁵)</div>
                                <div class="text-secondary small mb-2">Перемножение и деление двух N-значных чисел (столбик, Карацуба, Кнут)</div>
                                <div class="bucket-items d-flex flex-wrap gap-2 p-2 border border-secondary rounded-0 bg-dark" style="min-height: 64px;">
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div id="bucket-log" class="bucket-card card bg-black border border-success rounded-0 p-3 h-100" data-bucket="log" style="cursor: pointer;">
                                <div class="text-success fw-bold mb-1">КОРЗИНА 3: O(log K · T(N))</div>
                                <div class="text-secondary small mb-2">Сублинейные по шагам степени алгоритмы (бинарное и модульное возведение)</div>
                                <div class="bucket-items d-flex flex-wrap gap-2 p-2 border border-secondary rounded-0 bg-dark" style="min-height: 64px;">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p3-submit-btn" class="btn btn-success rounded-0 px-4 fw-bold" style="min-height: 48px;">
                            ПРОВЕРИТЬ КЛАССИФИКАЦИЮ
                        </button>
                    </div>
                </div>

                <!-- ========================================================= -->
                <!-- ФИНАЛЬНЫЙ ЭКРАН ПОБЕДЫ                                    -->
                <!-- ========================================================= -->
                <div id="victory-screen" class="text-center py-5 d-none">
                    <div class="display-1 text-success mb-3">✓</div>
                    <h3 class="text-success mb-2">УРОВЕНЬ 1 УСПЕШНО ПРОЙДЕН!</h3>
                    <p class="text-secondary mb-4">
                        Вы успешно освоили архитектуру представления многоразрядных чисел Little-Endian, 
                        поразрядный сумматор с переносами и асимптотическую сложность алгоритмов длинной арифметики.
                    </p>
                    <div class="d-inline-flex border border-success p-3 bg-black gap-4 text-start rounded-0 mb-4">
                        <div>
                            <div class="text-secondary small">Затраченное время:</div>
                            <div id="final-time" class="text-info fw-bold fs-5">00:00</div>
                        </div>
                        <div class="border-start border-secondary ps-4">
                            <div class="text-secondary small">Количество ошибок:</div>
                            <div id="final-attempts" class="text-warning fw-bold fs-5">0</div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(() => {
    const missionName = 'Урок 29 :: Многоразрядные целые числа, задачи длинной арифметики (Уровень 1)';
    let currentPhase = 1;
    let attemptsCount = 0;
    let startTime = Date.now();
    let timerInterval = null;
    let isLocked = false;

    // Таймер
    function startTimer() {
        const timerDisplay = document.getElementById('timer-display');
        timerInterval = setInterval(() => {
            const elapsed = Math.floor((Date.now() - startTime) / 1000);
            const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
            const secs = String(elapsed % 60).padStart(2, '0');
            if (timerDisplay) timerDisplay.textContent = `${mins}:${secs}`;
        }, 1000);
    }

    function updateAttemptsDisplay() {
        const el = document.getElementById('attempts-display');
        if (el) el.textContent = String(attemptsCount);
    }

    // Обработка ошибок с процедурной перегенерацией текущей фазы
    function triggerErrorReset(msg, callback) {
        if (isLocked) return;
        isLocked = true;
        attemptsCount++;
        updateAttemptsDisplay();

        const fb = document.getElementById('feedback-box');
        const ft = document.getElementById('feedback-text');
        if (fb && ft) {
            ft.textContent = msg;
            fb.classList.remove('d-none');
        }

        // Телеметрия сбоя
        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: 'hardcore_reset',
            status: 'failed',
            attempts_count: attemptsCount
        }, '*');

        setTimeout(() => {
            if (fb) fb.classList.add('d-none');
            isLocked = false;
            if (callback) callback();
        }, 1500);
    }

    // Завершение всего 1-го уровня
    function completeLevel() {
        if (timerInterval) clearInterval(timerInterval);
        const elapsed = Math.floor((Date.now() - startTime) / 1000);
        const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
        const secs = String(elapsed % 60).padStart(2, '0');

        document.getElementById('phase1').classList.add('d-none');
        document.getElementById('phase2').classList.add('d-none');
        document.getElementById('phase3').classList.add('d-none');
        document.getElementById('victory-screen').classList.remove('d-none');

        const fa = document.getElementById('final-attempts');
        const ft = document.getElementById('final-time');
        if (fa) fa.textContent = String(attemptsCount);
        if (ft) ft.textContent = `${mins}:${secs}`;

        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: 'level_complete',
            status: 'completed',
            success: true,
            attempts_count: attemptsCount,
            time_spent_sec: elapsed
        }, '*');
    }

    // =========================================================================
    // ФАЗА 1: Слот-пазл Little-Endian и нормализация блоков (B = 10 000)
    // =========================================================================
    let p1TargetNumberStr = '';
    let p1ExpectedBlocks = []; // [block0_str, block1_str, block2_str]
    let p1SelectedToken = null;
    let p1SlotsState = [null, null, null]; // [val0, val1, val2]

    function initPhase1() {
        p1SlotsState = [null, null, null];
        p1SelectedToken = null;

        // Генерация случайных блоков
        // Блок 0: единицы, 1..999, форматируется до 4 знаков с ведущими нулями
        const raw0 = Math.floor(Math.random() * 950) + 7;
        const block0 = String(raw0).padStart(4, '0');

        // Блок 1: десятки тысяч, 1..999, форматируется до 4 знаков с ведущими нулями
        const raw1 = Math.floor(Math.random() * 950) + 12;
        const block1 = String(raw1).padStart(4, '0');

        // Блок 2: старший блок, 12..985 (без ведущих нулей)
        const raw2 = Math.floor(Math.random() * 880) + 15;
        const block2 = String(raw2);

        p1ExpectedBlocks = [block0, block1, block2];
        p1TargetNumberStr = block2 + block1 + block0;

        const targetEl = document.getElementById('p1-target-number');
        if (targetEl) targetEl.textContent = p1TargetNumberStr;

        // Очистка слотов
        for (let i = 0; i < 3; i++) {
            const slot = document.getElementById(`p1-slot-${i}`);
            slot.innerHTML = `<span class="text-secondary small placeholder-text">[Слот A[${i}]]</span>`;
            slot.classList.remove('bg-dark', 'border-warning');
            slot.classList.add('border-dashed');
        }

        // Подготовка токенов и дистракторов
        const distractor1 = String(raw0); // без ведущих нулей (например "7" вместо "0007")
        const distractor2 = block1.slice(2) + block1.slice(0, 2); // переставленные цифры
        const distractor3 = block2 + '0'; // ошибочный сдвиг

        const tokens = [
            { text: block0, val: block0 },
            { text: block1, val: block1 },
            { text: block2, val: block2 },
            { text: distractor1, val: distractor1 },
            { text: distractor2, val: distractor2 },
            { text: distractor3, val: distractor3 }
        ];

        // Перемешивание токенов
        tokens.sort(() => Math.random() - 0.5);

        const palette = document.getElementById('p1-tokens-palette');
        palette.innerHTML = '';

        tokens.forEach(t => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn btn-outline-info rounded-0 px-3 py-2 fw-bold font-monospace p1-token-btn';
            btn.style.minHeight = '48px';
            btn.style.minWidth = '72px';
            btn.textContent = t.text;
            btn.dataset.val = t.val;
            btn.draggable = true;

            // Двойное управление: клик и Drag & Drop
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (isLocked) return;
                document.querySelectorAll('.p1-token-btn').forEach(b => b.classList.remove('border-warning', 'text-warning'));
                if (p1SelectedToken === btn) {
                    p1SelectedToken = null;
                } else {
                    p1SelectedToken = btn;
                    btn.classList.add('border-warning', 'text-warning');
                }
            });

            btn.addEventListener('dragstart', (e) => {
                if (isLocked) return;
                p1SelectedToken = btn;
                e.dataTransfer.setData('text/plain', t.val);
            });

            palette.appendChild(btn);
        });

        // Настройка слотов Фазы 1
        for (let i = 0; i < 3; i++) {
            const slot = document.getElementById(`p1-slot-${i}`);

            slot.onclick = () => {
                if (isLocked) return;
                if (!p1SelectedToken) return;

                p1SlotsState[i] = p1SelectedToken.dataset.val;
                slot.innerHTML = `<span class="text-success fw-bold fs-5 font-monospace">${p1SelectedToken.dataset.val}</span>`;
                slot.classList.remove('border-dashed');
                slot.classList.add('bg-dark');

                p1SelectedToken.classList.remove('border-warning', 'text-warning');
                p1SelectedToken.classList.add('d-none');
                p1SelectedToken = null;
            };

            slot.ondragover = (e) => e.preventDefault();
            slot.ondrop = (e) => {
                e.preventDefault();
                if (isLocked) return;
                if (!p1SelectedToken) return;
                slot.click();
            };
        }
    }

    // Сброс слотов Фазы 1
    document.getElementById('p1-reset-btn').addEventListener('click', () => {
        if (isLocked) return;
        p1SlotsState = [null, null, null];
        p1SelectedToken = null;
        for (let i = 0; i < 3; i++) {
            const slot = document.getElementById(`p1-slot-${i}`);
            slot.innerHTML = `<span class="text-secondary small placeholder-text">[Слот A[${i}]]</span>`;
            slot.classList.remove('bg-dark');
            slot.classList.add('border-dashed');
        }
        document.querySelectorAll('.p1-token-btn').forEach(btn => {
            btn.classList.remove('d-none', 'border-warning', 'text-warning');
        });
    });

    // Проверка Фазы 1
    document.getElementById('p1-submit-btn').addEventListener('click', () => {
        if (isLocked) return;

        if (p1SlotsState.some(v => v === null)) {
            triggerErrorReset('Заполните все 3 слота массива A[0], A[1], A[2]!');
            return;
        }

        const [s0, s1, s2] = p1SlotsState;
        const [e0, e1, e2] = p1ExpectedBlocks;

        if (s0 === e0 && s1 === e1 && s2 === e2) {
            // Переход на Фазу 2
            currentPhase = 2;
            document.getElementById('phase-badge').textContent = 'Шаг 2 из 3';
            document.getElementById('phase-title').textContent = 'Поразрядный сумматор и перенос (Carry)';
            document.getElementById('phase1').classList.add('d-none');
            document.getElementById('phase2').classList.remove('d-none');
            initPhase2();
        } else {
            let errorMsg = 'Неверное распределение блоков!';
            if (s0 === e2 && s2 === e0) {
                errorMsg = 'Вы расположили блоки в прямом порядке (Big-Endian)! По правилу Little-Endian младшие разряды (единицы) обязаны быть в ячейке A[0].';
            } else if (s0 !== e0 && s0 === String(Number(e0))) {
                errorMsg = `Потеря ведущих нулей в A[0]! Значение '${s0}' искажает число. Блок обязан дополняться нулями до 4 знаков: '${e0}'.`;
            } else if (s1 !== e1 && s1 === String(Number(e1))) {
                errorMsg = `Потеря ведущих нулей в A[1]! Блок обязан дополняться нулями до 4 знаков: '${e1}'.`;
            }
            triggerErrorReset(errorMsg, () => {
                initPhase1();
            });
        }
    });

    // =========================================================================
    // ФАЗА 2: Поразрядный сумматор с переносами (B = 1000)
    // =========================================================================
    let p2Expected = {};
    let p2SlotsState = { carry1: null, carry2: null, res0: null, res1: null, res2: null };
    let p2SelectedToken = null;

    function initPhase2() {
        p2SlotsState = { carry1: null, carry2: null, res0: null, res1: null, res2: null };
        p2SelectedToken = null;

        // Генерация слагаемых A и B (B = 1000)
        // Чтобы гарантировать перенос в обоих разрядах:
        const a0 = Math.floor(Math.random() * 350) + 550; // 550..899
        const b0 = Math.floor(Math.random() * 350) + 550; // 550..899
        const sum0 = a0 + b0;
        const res0 = sum0 % 1000;
        const carry1 = Math.floor(sum0 / 1000); // строго 1

        const a1 = Math.floor(Math.random() * 350) + 550;
        const b1 = Math.floor(Math.random() * 350) + 550;
        const sum1 = a1 + b1 + carry1;
        const res1 = sum1 % 1000;
        const carry2 = Math.floor(sum1 / 1000); // строго 1
        const res2 = carry2; // 1

        p2Expected = {
            carry1: String(carry1),
            carry2: String(carry2),
            res0: String(res0),
            res1: String(res1),
            res2: String(res2)
        };

        // Заполнение значений слагаемых в таблице
        document.getElementById('p2-val-a0').textContent = String(a0);
        document.getElementById('p2-val-a1').textContent = String(a1);
        document.getElementById('p2-val-b0').textContent = `+ ${b0}`;
        document.getElementById('p2-val-b1').textContent = `+ ${b1}`;

        // Сброс слотов
        ['carry1', 'carry2', 'res0', 'res1', 'res2'].forEach(slotKey => {
            const slot = document.getElementById(`p2-slot-${slotKey}`);
            slot.innerHTML = `<span class="text-secondary small">[${slotKey}]</span>`;
            slot.classList.remove('bg-dark');
            slot.classList.add('border-dashed');
        });

        // Пул токенов Фазы 2
        const rawTokens = [
            String(carry1),
            String(carry2),
            String(res0),
            String(res1),
            String(res2),
            // Дистракторы
            '0',
            String(sum0), // сырая сумма без % 1000
            String(a1 + b1), // сырая сумма без carry
            String((res0 + 40) % 1000)
        ];

        // Убираем дубликаты токенов для отображения независимых кнопок
        const tokensPalette = document.getElementById('p2-tokens-palette');
        tokensPalette.innerHTML = '';

        rawTokens.sort(() => Math.random() - 0.5).forEach((val, idx) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn btn-outline-warning rounded-0 px-3 py-2 fw-bold font-monospace p2-token-btn';
            btn.style.minHeight = '48px';
            btn.style.minWidth = '60px';
            btn.textContent = val;
            btn.dataset.val = val;
            btn.dataset.tokenId = `tok_${idx}`;
            btn.draggable = true;

            btn.onclick = (e) => {
                e.stopPropagation();
                if (isLocked) return;
                document.querySelectorAll('.p2-token-btn').forEach(b => b.classList.remove('border-success', 'text-success'));
                if (p2SelectedToken === btn) {
                    p2SelectedToken = null;
                } else {
                    p2SelectedToken = btn;
                    btn.classList.add('border-success', 'text-success');
                }
            };

            btn.ondragstart = (e) => {
                if (isLocked) return;
                p2SelectedToken = btn;
                e.dataTransfer.setData('text/plain', val);
            };

            tokensPalette.appendChild(btn);
        });

        // Настройка кликов по слотам
        ['carry1', 'carry2', 'res0', 'res1', 'res2'].forEach(slotKey => {
            const slot = document.getElementById(`p2-slot-${slotKey}`);

            slot.onclick = () => {
                if (isLocked) return;
                if (!p2SelectedToken) return;

                p2SlotsState[slotKey] = p2SelectedToken.dataset.val;
                slot.innerHTML = `<span class="text-warning fw-bold fs-5 font-monospace">${p2SelectedToken.dataset.val}</span>`;
                slot.classList.remove('border-dashed');
                slot.classList.add('bg-dark');

                p2SelectedToken.classList.remove('border-success', 'text-success');
                p2SelectedToken.classList.add('d-none');
                p2SelectedToken = null;
            };

            slot.ondragover = (e) => e.preventDefault();
            slot.ondrop = (e) => {
                e.preventDefault();
                if (isLocked) return;
                if (!p2SelectedToken) return;
                slot.click();
            };
        });
    }

    // Сброс сумматора
    document.getElementById('p2-reset-btn').addEventListener('click', () => {
        if (isLocked) return;
        p2SlotsState = { carry1: null, carry2: null, res0: null, res1: null, res2: null };
        p2SelectedToken = null;

        ['carry1', 'carry2', 'res0', 'res1', 'res2'].forEach(slotKey => {
            const slot = document.getElementById(`p2-slot-${slotKey}`);
            slot.innerHTML = `<span class="text-secondary small">[${slotKey}]</span>`;
            slot.classList.remove('bg-dark');
            slot.classList.add('border-dashed');
        });

        document.querySelectorAll('.p2-token-btn').forEach(btn => {
            btn.classList.remove('d-none', 'border-success', 'text-success');
        });
    });

    // Проверка Фазы 2
    document.getElementById('p2-submit-btn').addEventListener('click', () => {
        if (isLocked) return;

        if (Object.values(p2SlotsState).some(v => v === null)) {
            triggerErrorReset('Заполните все слоты переносов и разрядов суммы!');
            return;
        }

        let isCorrect = true;
        let errorMsg = 'Ошибка в вычислениях поразрядного сумматора!';

        if (p2SlotsState.res0 !== p2Expected.res0) {
            isCorrect = false;
            errorMsg = `Неверный разряд C[0]! sum % B = (${document.getElementById('p2-val-a0').textContent} + ${document.getElementById('p2-val-b0').textContent.replace('+ ', '')}) % 1000 = ${p2Expected.res0}.`;
        } else if (p2SlotsState.carry1 !== p2Expected.carry1) {
            isCorrect = false;
            errorMsg = `Неверный перенос carry1! Перенос рассчитывается как целочисленное деление sum // B.`;
        } else if (p2SlotsState.carry2 !== p2Expected.carry2) {
            isCorrect = false;
            errorMsg = `Неверный перенос carry2! Не забудьте учесть предыдущий carry1 при сложении разряда 1.`;
        } else if (p2SlotsState.res1 !== p2Expected.res1) {
            isCorrect = false;
            errorMsg = `Неверный разряд C[1]! Убедитесь, что учтен перенос carry1 = 1.`;
        } else if (p2SlotsState.res2 !== p2Expected.res2) {
            isCorrect = false;
            errorMsg = `Неверный старший разряд C[2]! Перенос carry2 = 1 становится новым разрядом результата.`;
        }

        if (isCorrect) {
            // Переход на Фазу 3
            currentPhase = 3;
            document.getElementById('phase-badge').textContent = 'Шаг 3 из 3';
            document.getElementById('phase-title').textContent = 'Классификация сложности операций (Buckets)';
            document.getElementById('phase2').classList.add('d-none');
            document.getElementById('phase3').classList.remove('d-none');
            initPhase3();
        } else {
            triggerErrorReset(errorMsg, () => {
                initPhase2();
            });
        }
    });

    // =========================================================================
    // ФАЗА 3: Сортировка операций по сложности (Interactive Bin / Buckets)
    // =========================================================================
    const P3_BANK = [
        // Линейная сложность O(N)
        { id: 'c1', text: 'Поразрядное сложение A + B с переносом', bucket: 'linear' },
        { id: 'c2', text: 'Поразрядное вычитание A - B с заемом (borrow)', bucket: 'linear' },
        { id: 'c3', text: 'Умножение длинного числа на скаляр (A · k)', bucket: 'linear' },
        { id: 'c4', text: 'Деление длинного числа на скаляр (A / k)', bucket: 'linear' },
        // Полиномиальная / квадратичная O(N² / N^1.585)
        { id: 'c5', text: 'Школьное умножение A × B «в столбик» (O(N²))', bucket: 'poly' },
        { id: 'c6', text: 'Алгоритм Анатолия Карацубы (O(N¹·⁵⁸⁵))', bucket: 'poly' },
        { id: 'c7', text: 'Деление двух длинных чисел (Алгоритм Кнута Algorithm D)', bucket: 'poly' },
        { id: 'c8', text: 'Поразрядное деление двух длинных чисел уголком (O(N·M))', bucket: 'poly' },
        // Логарифмическая по шагам O(log K · T(N))
        { id: 'c9', text: 'Быстрое бинарное возведение A в степень K (O(log K))', bucket: 'log' },
        { id: 'c10', text: 'Модульное возведение в степень (A^K mod M) в RSA', bucket: 'log' },
        { id: 'c11', text: 'Матричное вычисление N-го числа Фибоначчи за O(log N)', bucket: 'log' },
        { id: 'c12', text: 'Бинарный поиск частного при длинном делении', bucket: 'log' }
    ];

    let p3ActiveCard = null;
    let p3Placed = {}; // { cardId: bucketKey }

    function initPhase3() {
        p3ActiveCard = null;
        p3Placed = {};

        // Выбираем по 2 карточки из каждой категории (всего 6 карточек)
        const linears = P3_BANK.filter(x => x.bucket === 'linear').sort(() => Math.random() - 0.5).slice(0, 2);
        const polys = P3_BANK.filter(x => x.bucket === 'poly').sort(() => Math.random() - 0.5).slice(0, 2);
        const logs = P3_BANK.filter(x => x.bucket === 'log').sort(() => Math.random() - 0.5).slice(0, 2);

        const currentCards = [...linears, ...polys, ...logs].sort(() => Math.random() - 0.5);

        // Очистка корзин
        document.querySelectorAll('.bucket-items').forEach(b => b.innerHTML = '');

        const pool = document.getElementById('p3-pool');
        pool.innerHTML = '';

        currentCards.forEach(c => {
            const card = document.createElement('button');
            card.type = 'button';
            card.className = 'btn btn-outline-light rounded-0 px-3 py-2 text-start p3-card';
            card.style.minHeight = '48px';
            card.style.fontSize = '0.85rem';
            card.dataset.cardId = c.id;
            card.dataset.expectedBucket = c.bucket;
            card.textContent = c.text;

            card.addEventListener('click', (e) => {
                e.stopPropagation();
                if (isLocked) return;
                document.querySelectorAll('.p3-card').forEach(cd => cd.classList.remove('border-warning', 'text-warning'));
                if (p3ActiveCard === card) {
                    p3ActiveCard = null;
                } else {
                    p3ActiveCard = card;
                    card.classList.add('border-warning', 'text-warning');
                }
            });

            pool.appendChild(card);
        });

        // Возврат карточки в пул
        pool.onclick = () => {
            if (isLocked) return;
            if (!p3ActiveCard) return;

            pool.appendChild(p3ActiveCard);
            delete p3Placed[p3ActiveCard.dataset.cardId];

            p3ActiveCard.classList.remove('border-warning', 'text-warning', 'btn-secondary');
            p3ActiveCard.classList.add('btn-outline-light');
            p3ActiveCard = null;
        };

        // Слушатели корзин
        document.querySelectorAll('.bucket-card').forEach(bucketEl => {
            bucketEl.onclick = () => {
                if (isLocked) return;
                if (!p3ActiveCard) return;

                const bucketKey = bucketEl.dataset.bucket;
                const itemsContainer = bucketEl.querySelector('.bucket-items');

                p3Placed[p3ActiveCard.dataset.cardId] = bucketKey;
                itemsContainer.appendChild(p3ActiveCard);

                p3ActiveCard.classList.remove('border-warning', 'text-warning', 'btn-outline-light');
                p3ActiveCard.classList.add('btn-secondary');
                p3ActiveCard = null;
            };
        });
    }

    // Проверка Фазы 3
    document.getElementById('p3-submit-btn').addEventListener('click', () => {
        if (isLocked) return;

        const poolCards = document.querySelectorAll('#p3-pool .p3-card');
        if (poolCards.length > 0) {
            triggerErrorReset('Распределите все операции из пула по корзинам!');
            return;
        }

        let allCorrect = true;
        let errorHint = 'Ошибка классификации алгоритмов по сложности!';

        const cards = document.querySelectorAll('.bucket-items .p3-card');
        cards.forEach(c => {
            const cardId = c.dataset.cardId;
            const expected = c.dataset.expectedBucket;
            const actual = p3Placed[cardId];

            if (actual !== expected) {
                allCorrect = false;
                if (expected === 'linear') {
                    errorHint = `Операция '${c.textContent}' выполняется за 1 проход по разрядам и имеет линейную сложность O(N)!`;
                } else if (expected === 'poly') {
                    errorHint = `Операция '${c.textContent}' требует квадратичного или субквадратичного времени O(N² / N¹·⁵⁸⁵)!`;
                } else if (expected === 'log') {
                    errorHint = `Алгоритм '${c.textContent}' сокращает число шагов логарифмически: O(log K · T(N))!`;
                }
            }
        });

        if (!allCorrect) {
            triggerErrorReset(errorHint, () => {
                initPhase3();
            });
            return;
        }

        // Успех всего Уровня 1
        completeLevel();
    });

    // Старт
    startTimer();
    initPhase1();
})();
</script>
