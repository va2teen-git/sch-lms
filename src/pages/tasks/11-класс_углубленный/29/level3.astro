---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={3}>
    <!-- Архетип 11: Регистровый конвейер АЛУ (ALU Register Conveyor) -->
    <div id="vue-app" class="container-fluid px-2 px-md-3 my-3 font-monospace" v-cloak>
        
        <!-- Стартовый экран: Брифинг миссии -->
        <div v-if="gameState === 'intro'" class="card bg-black border-danger rounded-0 p-4 p-md-5 text-center shadow">
            <div class="display-3 text-danger mb-3">⚠️ ХАРДКОР-РЕЖИМ: АЛУ ДЛИННОЙ АРИФМЕТИКИ ⚠️</div>
            <h2 class="text-light mb-3">BIGNUM PIPELINE: REAL-TIME REGISTER DISPATCHER</h2>
            <p class="fs-5 text-secondary mx-auto mb-4" style="max-width: 720px;">
                В высокопроизводительных криптографических движках (GMP, OpenSSL, CPython) центральный процессор непрерывно обрабатывает поток 
                многоразрядных операций над блоками машинных слов.
                <br><br>
                Вам предстоит выступить в роли аппаратного диспетчера конвейера АЛУ и безошибочно отразить 
                <span class="text-danger fw-bold">10 нарастающих волн транзакций</span> в условиях жесткого убывающего таймера!
            </p>

            <div class="card bg-dark border-secondary rounded-0 p-3 mx-auto mb-4 text-start small" style="max-width: 680px;">
                <div class="text-danger fw-bold fs-6 mb-2">[ПРОТОКОЛ АППАРАТНОЙ ОБРАБОТКИ РАЗРЯДОВ]:</div>
                <div class="text-light mb-1">• <span class="text-warning fw-bold">Динамический таймер:</span> От 12 до 5.5 секунд на волну с возрастанием скорости потока!</div>
                <div class="text-light mb-1">• <span class="text-danger fw-bold">ТОТАЛЬНЫЙ СБРОС (Zero-Tolerance):</span> Любая ошибка, неверный вентиль или тайм-аут сбрасывают весь прогресс на Волну 1!</div>
                <div class="text-light mb-1">• <span class="text-danger fw-bold">[1] CARRY:</span> Переполнение разряда (<code>Sum ≥ B</code> или <code>Prod ≥ B</code>). Вынос бита переноса в старший блок.</div>
                <div class="text-light mb-1">• <span class="text-warning fw-bold">[2] BORROW:</span> Нехватка разряда при вычитании (<code>Diff &lt; 0</code>). Заем единицы основания у старшего блока.</div>
                <div class="text-light mb-1">• <span class="text-success fw-bold">[3] NORMAL:</span> Прямой проход (<code>0 ≤ Val &lt; B</code>). Результат помещается в ячейку без переноса и заема.</div>
                <div class="text-secondary mt-2 border-top border-secondary pt-2">
                    💡 <em>Поддерживаются горячие клавиши управления вентилями: <strong>1</strong> (Carry), <strong>2</strong> (Borrow), <strong>3</strong> (Normal).</em>
                </div>
            </div>

            <div>
                <button id="start-btn" @click="startGame" class="btn btn-danger btn-lg rounded-0 fw-bold px-5 py-3 shadow" style="min-height: 54px;">
                    ЗАПУСТИТЬ КОНВЕЙЕР АЛУ [SPACE] →
                </button>
            </div>
        </div>

        <!-- Игровой экран: Активный конвейер АЛУ -->
        <div v-else-if="gameState === 'playing'" class="card bg-dark border-danger rounded-0 shadow">
            <div class="card-body p-3 p-md-4">

                <!-- Хедер волны и таймер -->
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="phase-counter" class="badge bg-danger text-light rounded-0 fs-6 me-2">
                            ВОЛНА <span v-text="currentWave"></span> ИЗ <span v-text="totalWaves"></span>
                        </span>
                        <span class="text-light fw-bold fs-6" v-text="currentWaveData.title"></span>
                    </div>
                    <div class="text-secondary small">
                        Ошибок: <span class="text-warning fw-bold" v-text="attempts"></span> | 
                        Таймер: <span class="text-danger fw-bold fs-5" v-text="phaseTimeLeft.toFixed(1) + 'с'"></span>
                    </div>
                </div>

                <!-- Прогресс-бар таймера -->
                <div class="progress rounded-0 bg-black border border-secondary mb-3" style="height: 8px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-danger" 
                         role="progressbar" 
                         :style="{ width: timerPercentage + '%' }">
                    </div>
                </div>

                <!-- Системная аварийная сирена (#alarm-box) -->
                <div id="alarm-box" v-if="alarmActive" class="alert alert-danger bg-black text-danger border border-2 border-danger rounded-0 p-3 mb-3" role="alert">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-bold fs-5 mb-1">🚨 КРИТИЧЕСКИЙ СБОЙ КОНВЕЙЕРА АЛУ! 🚨</div>
                            <div v-text="alarmMessage"></div>
                            <div class="small text-secondary mt-1">ТОТАЛЬНЫЙ СБРОС ПРОГРЕССА НА ВОЛНУ 1...</div>
                        </div>
                        <div class="spinner-border text-danger" role="status"></div>
                    </div>
                </div>

                <!-- Визуальный блок регистров и операции АЛУ (Direct Data Source) -->
                <div class="card bg-black border-secondary rounded-0 p-3 p-md-4 mb-4 text-center">
                    
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <span class="badge border border-info text-info bg-dark rounded-0 px-3 py-1">
                            ОСНОВАНИЕ СИСТЕМЫ: <strong v-text="currentWaveData.baseStr"></strong>
                        </span>
                        <span class="text-secondary small">
                            Индекс разряда: <span class="text-light fw-bold" v-text="currentWaveData.digitIndex"></span>
                        </span>
                    </div>

                    <!-- Схема регистрового блока -->
                    <div class="row g-2 justify-content-center align-items-center mb-3">
                        <!-- Регистр R1 (A[i]) -->
                        <div class="col-12 col-md-3">
                            <div class="card bg-dark border-info rounded-0 p-2">
                                <div class="text-info small fw-bold">РЕГИСТР R1 (A[i])</div>
                                <div class="fs-4 fw-bold text-light font-monospace" v-text="currentWaveData.r1"></div>
                            </div>
                        </div>

                        <!-- Знак операции -->
                        <div class="col-12 col-md-1">
                            <div class="display-6 fw-bold text-warning" v-text="currentWaveData.opSign"></div>
                        </div>

                        <!-- Регистр R2 (B[i] или скаляр k) -->
                        <div class="col-12 col-md-3">
                            <div class="card bg-dark border-info rounded-0 p-2">
                                <div class="text-info small fw-bold" v-text="currentWaveData.r2Label"></div>
                                <div class="fs-4 fw-bold text-light font-monospace" v-text="currentWaveData.r2"></div>
                            </div>
                        </div>

                        <!-- Входящий флаг переноса / заема -->
                        <div class="col-12 col-md-3">
                            <div class="card bg-dark border-secondary rounded-0 p-2">
                                <div class="text-secondary small fw-bold">ВХОДЯЩИЙ ФЛАГ (IN)</div>
                                <div class="fs-5 fw-bold" :class="currentWaveData.flagIn > 0 ? 'text-warning' : 'text-secondary'" v-text="currentWaveData.flagLabel"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Результат промежуточного выражения -->
                    <div class="p-2 bg-dark border border-secondary rounded-0 d-inline-block px-4">
                        <span class="text-secondary small">Сырое значение АЛУ: </span>
                        <strong class="text-light fs-5 font-monospace" v-text="currentWaveData.rawExpr"></strong>
                    </div>
                </div>

                <!-- Органы прямого управления: 3 аппаратных вентиля АЛУ -->
                <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                    <div class="text-secondary small mb-3 text-uppercase">
                        ВЫБЕРИТЕ РЕЖИМ СТРОБИРОВАНИЯ РАЗРЯДНОЙ СЕТКИ (ИЛИ НАЖМИТЕ КЛАВИШИ 1, 2, 3):
                    </div>

                    <div class="row g-3">
                        <!-- Вентиль 1: CARRY -->
                        <div class="col-12 col-md-4">
                            <button @click="handleAction('carry')" 
                                    :disabled="isActionBlocked" 
                                    class="btn btn-outline-danger w-100 rounded-0 p-3 text-start d-flex flex-column justify-content-between shadow"
                                    style="min-height: 54px;">
                                <div class="d-flex justify-content-between align-items-center w-100 mb-1">
                                    <span class="fw-bold fs-5">[1] CARRY_OUT</span>
                                    <span class="badge bg-danger text-light rounded-0">КЛАВИША 1</span>
                                </div>
                                <div class="small text-light opacity-75">
                                    Переполнение блока: перенос <code>carry = 1</code> в следующий разряд
                                </div>
                            </button>
                        </div>

                        <!-- Вентиль 2: BORROW -->
                        <div class="col-12 col-md-4">
                            <button @click="handleAction('borrow')" 
                                    :disabled="isActionBlocked" 
                                    class="btn btn-outline-warning w-100 rounded-0 p-3 text-start d-flex flex-column justify-content-between shadow"
                                    style="min-height: 54px;">
                                <div class="d-flex justify-content-between align-items-center w-100 mb-1">
                                    <span class="fw-bold fs-5">[2] BORROW_IN</span>
                                    <span class="badge bg-warning text-dark rounded-0">КЛАВИША 2</span>
                                </div>
                                <div class="small text-light opacity-75">
                                    Нехватка разряда (Diff &lt; 0): заем <code>borrow = 1</code> из старшего блока
                                </div>
                            </button>
                        </div>

                        <!-- Вентиль 3: NORMAL -->
                        <div class="col-12 col-md-4">
                            <button @click="handleAction('normal')" 
                                    :disabled="isActionBlocked" 
                                    class="btn btn-outline-success w-100 rounded-0 p-3 text-start d-flex flex-column justify-content-between shadow"
                                    style="min-height: 54px;">
                                <div class="d-flex justify-content-between align-items-center w-100 mb-1">
                                    <span class="fw-bold fs-5">[3] NORMAL_PASS</span>
                                    <span class="badge bg-success text-dark rounded-0">КЛАВИША 3</span>
                                </div>
                                <div class="small text-light opacity-75">
                                    Прямой проход: значение в пределах ячейки <code>0 ≤ Val &lt; B</code>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="text-secondary small text-center">
                    Контролируйте таймер! Любая задержка или ошибка активируют аварийный сброс всей системы на шаг 1.
                </div>

            </div>
        </div>

        <!-- Экран триумфа: Хардкор пройден -->
        <div v-else-if="gameState === 'victory'" class="card bg-black border-danger rounded-0 p-5 text-center shadow">
            <div class="display-1 text-danger mb-3">★</div>
            <h2 class="text-light mb-2">ХАРДКОР-РЕЖИМ УСПЕШНО ПРЕОДОЛЕН!</h2>
            <p class="fs-5 text-secondary mx-auto mb-4" style="max-width: 650px;">
                Вы безупречно отработали все 10 волн конвейера длинной арифметики в реальном времени, 
                доказав мгновенное понимание разрядных переносов, заемов и границ масштабирования оснований!
            </p>

            <div class="d-inline-flex border border-danger p-3 bg-dark gap-4 text-start rounded-0 mb-4">
                <div>
                    <div class="text-secondary small">Общее время забега:</div>
                    <div class="text-info fw-bold fs-5" v-text="formattedFinalTime"></div>
                </div>
                <div class="border-start border-secondary ps-4">
                    <div class="text-secondary small">Ошибок до триумфа:</div>
                    <div class="text-warning fw-bold fs-5" v-text="attempts"></div>
                </div>
            </div>

            <div>
                <button @click="restartGame" class="btn btn-outline-danger rounded-0 px-5 py-3 fw-bold" style="min-height: 48px;">
                    ПОВТОРИТЬ ХАРДКОР-ЗАБЕГ
                </button>
            </div>
        </div>

    </div>
</TaskLayout>

<!-- Локальное подключение Vue 3 -->
<script is:inline src="/static/vue.global.js"></script>

<script is:inline>
(() => {
    const { createApp } = Vue;
    const missionName = 'Урок 29 :: Многоразрядные целые числа, задачи длинной арифметики (Уровень 3)';

    // Синтезатор звука Web Audio API (Zero external assets)
    let audioCtx = null;
    function getAudioContext() {
        if (!audioCtx) {
            const AudioContextClass = window.AudioContext || window.webkitAudioContext;
            if (AudioContextClass) audioCtx = new AudioContextClass();
        }
        return audioCtx;
    }

    function playTone(freq, type, duration, vol = 0.15) {
        try {
            const ctx = getAudioContext();
            if (!ctx) return;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = type;
            osc.frequency.setValueAtTime(freq, ctx.currentTime);
            gain.gain.setValueAtTime(vol, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + duration);
        } catch (e) {}
    }

    function playSuccessSound() {
        playTone(660, 'sine', 0.12);
        setTimeout(() => playTone(990, 'sine', 0.18), 70);
    }

    function playErrorSound() {
        playTone(180, 'sawtooth', 0.3);
        setTimeout(() => playTone(120, 'sawtooth', 0.35), 100);
    }

    function playAlarmSiren() {
        playTone(440, 'triangle', 0.2);
        setTimeout(() => playTone(880, 'triangle', 0.2), 120);
        setTimeout(() => playTone(440, 'triangle', 0.2), 240);
        setTimeout(() => playTone(880, 'triangle', 0.2), 360);
    }

    // Процедурный генератор 10 волн
    function generateWaves() {
        return [
            // Волна 1: Сложение без входящего переноса (B = 1000) -> CARRY
            {
                id: 'W1',
                title: 'Сложение младших разрядов (B = 1000)',
                baseStr: 'B = 1000',
                baseVal: 1000,
                digitIndex: 'A[0] + B[0]',
                r1: '740',
                opSign: '+',
                r2Label: 'РЕГИСТР R2 (B[0])',
                r2: '480',
                flagLabel: 'CF_IN = 0',
                flagIn: 0,
                rawExpr: '740 + 480 = 1220 ≥ 1000',
                correctAction: 'carry',
                maxTime: 12.0
            },
            // Волна 2: Вычитание без заема (B = 1000) -> BORROW
            {
                id: 'W2',
                title: 'Вычитание разряда с нехваткой (B = 1000)',
                baseStr: 'B = 1000',
                baseVal: 1000,
                digitIndex: 'A[0] - B[0]',
                r1: '320',
                opSign: '−',
                r2Label: 'РЕГИСТР R2 (B[0])',
                r2: '670',
                flagLabel: 'BORROW_IN = 0',
                flagIn: 0,
                rawExpr: '320 − 670 = −350 < 0',
                correctAction: 'borrow',
                maxTime: 11.0
            },
            // Волна 3: Сложение в границах блока (B = 1000) -> NORMAL
            {
                id: 'W3',
                title: 'Сложение разрядов в норме (B = 1000)',
                baseStr: 'B = 1000',
                baseVal: 1000,
                digitIndex: 'A[1] + B[1]',
                r1: '240',
                opSign: '+',
                r2Label: 'РЕГИСТР R2 (B[1])',
                r2: '380',
                flagLabel: 'CF_IN = 0',
                flagIn: 0,
                rawExpr: '240 + 380 = 620 < 1000',
                correctAction: 'normal',
                maxTime: 10.0
            },
            // Волна 4: Граничное сложение с входящим переносом -> CARRY
            {
                id: 'W4',
                title: 'Граничный перенос суммы (B = 1000)',
                baseStr: 'B = 1000',
                baseVal: 1000,
                digitIndex: 'A[1] + B[1] + CF',
                r1: '699',
                opSign: '+',
                r2Label: 'РЕГИСТР R2 (B[1])',
                r2: '300',
                flagLabel: 'CF_IN = 1',
                flagIn: 1,
                rawExpr: '699 + 300 + 1 = 1000 ≥ 1000',
                correctAction: 'carry',
                maxTime: 9.5
            },
            // Волна 5: Граничное вычитание с входящим заемом -> BORROW
            {
                id: 'W5',
                title: 'Вычитание равных чисел с заемом (B = 1000)',
                baseStr: 'B = 1000',
                baseVal: 1000,
                digitIndex: 'A[1] - B[1] - Borrow',
                r1: '500',
                opSign: '−',
                r2Label: 'РЕГИСТР R2 (B[1])',
                r2: '500',
                flagLabel: 'BORROW_IN = 1',
                flagIn: 1,
                rawExpr: '500 − 500 − 1 = −1 < 0',
                correctAction: 'borrow',
                maxTime: 9.0
            },
            // Волна 6: Умножение на скаляр в норме (B = 1000) -> NORMAL
            {
                id: 'W6',
                title: 'Умножение на скаляр в норме (B = 1000)',
                baseStr: 'B = 1000',
                baseVal: 1000,
                digitIndex: 'A[0] × k',
                r1: '160',
                opSign: '×',
                r2Label: 'СКАЛЯР k',
                r2: '5',
                flagLabel: 'CF_IN = 0',
                flagIn: 0,
                rawExpr: '160 × 5 = 800 < 1000',
                correctAction: 'normal',
                maxTime: 8.5
            },
            // Волна 7: Умножение на скаляр с переносом (B = 10⁴) -> CARRY
            {
                id: 'W7',
                title: 'Скалярное умножение блока (B = 10⁴)',
                baseStr: 'B = 10 000',
                baseVal: 10000,
                digitIndex: 'A[1] × k + CF',
                r1: '3500',
                opSign: '×',
                r2Label: 'СКАЛЯР k',
                r2: '3',
                flagLabel: 'CF_IN = 2',
                flagIn: 2,
                rawExpr: '3500 × 3 + 2 = 10502 ≥ 10000',
                correctAction: 'carry',
                maxTime: 8.0
            },
            // Волна 8: Вычитание без заема в базе B = 10⁴ -> NORMAL
            {
                id: 'W8',
                title: 'Вычитание старшего блока (B = 10⁴)',
                baseStr: 'B = 10 000',
                baseVal: 10000,
                digitIndex: 'A[2] - B[2]',
                r1: '8400',
                opSign: '−',
                r2Label: 'РЕГИСТР R2 (B[2])',
                r2: '3200',
                flagLabel: 'BORROW_IN = 0',
                flagIn: 0,
                rawExpr: '8400 − 3200 = 5200 < 10000',
                correctAction: 'normal',
                maxTime: 7.5
            },
            // Волна 9: Высокоскоростное сложение в базе B = 10⁹ -> CARRY
            {
                id: 'W9',
                title: '32-битная база: Переполнение (B = 10⁹)',
                baseStr: 'B = 10⁹ (1 000 000 000)',
                baseVal: 1000000000,
                digitIndex: 'A[0] + B[0]',
                r1: '650 000 000',
                opSign: '+',
                r2Label: 'РЕГИСТР R2 (B[0])',
                r2: '450 000 000',
                flagLabel: 'CF_IN = 0',
                flagIn: 0,
                rawExpr: '650M + 450M = 1.100B ≥ 10⁹',
                correctAction: 'carry',
                maxTime: 6.5
            },
            // Волна 10: Финальная кульминация вычитания в базе B = 10⁹ -> BORROW
            {
                id: 'W10',
                title: 'Финал: Заем в 32-битном масштабе (B = 10⁹)',
                baseStr: 'B = 10⁹ (1 000 000 000)',
                baseVal: 1000000000,
                digitIndex: 'A[1] - B[1]',
                r1: '230 000 000',
                opSign: '−',
                r2Label: 'РЕГИСТР R2 (B[1])',
                r2: '890 000 000',
                flagLabel: 'BORROW_IN = 0',
                flagIn: 0,
                rawExpr: '230M − 890M = −660M < 0',
                correctAction: 'borrow',
                maxTime: 5.5
            }
        ];
    }

    createApp({
        data() {
            return {
                gameState: 'intro', // 'intro', 'playing', 'victory'
                currentWave: 1,
                totalWaves: 10,
                attempts: 0,
                startTime: Date.now(),
                phaseTimeLeft: 12.0,
                maxPhaseTime: 12.0,
                timerInterval: null,
                alarmActive: false,
                alarmMessage: '',
                isActionBlocked: false,
                activeWaves: [],
                currentWaveData: {}
            };
        },

        computed: {
            timerPercentage() {
                return Math.max(0, Math.min(100, (this.phaseTimeLeft / this.maxPhaseTime) * 100));
            },
            formattedFinalTime() {
                const totalSec = Math.max(1, Math.floor((Date.now() - this.startTime) / 1000));
                const m = String(Math.floor(totalSec / 60)).padStart(2, '0');
                const s = String(totalSec % 60).padStart(2, '0');
                return `${m}:${s}`;
            }
        },

        methods: {
            sendTelemetry(actionType, status, success) {
                const timeSpent = Math.max(1, Math.round((Date.now() - this.startTime) / 1000));
                window.parent.postMessage({
                    type: 'TELEMETRY_EVENT',
                    mission_name: missionName,
                    action_type: actionType,
                    status: status,
                    success: success,
                    attempts_count: this.attempts,
                    time_spent_sec: timeSpent
                }, '*');
            },

            startGame() {
                getAudioContext();
                this.gameState = 'playing';
                this.currentWave = 1;
                this.attempts = 0;
                this.startTime = Date.now();
                this.activeWaves = generateWaves();
                this.loadWave(1);
                this.sendTelemetry('in_progress', 'in_progress', false);
            },

            restartGame() {
                this.startGame();
            },

            loadWave(waveNum) {
                this.currentWave = waveNum;
                this.currentWaveData = this.activeWaves[waveNum - 1];
                this.maxPhaseTime = this.currentWaveData.maxTime;
                this.phaseTimeLeft = this.currentWaveData.maxTime;
                this.isActionBlocked = false;
                this.alarmActive = false;

                this.startWaveTimer();
            },

            startWaveTimer() {
                this.stopWaveTimer();
                const stepMs = 50;
                this.timerInterval = setInterval(() => {
                    this.phaseTimeLeft -= (stepMs / 1000);
                    if (this.phaseTimeLeft <= 0) {
                        this.phaseTimeLeft = 0;
                        this.stopWaveTimer();
                        this.triggerHardcoreReset('Время на обработку разряда истекло! Конвейер перегружен.');
                    }
                }, stepMs);
            },

            stopWaveTimer() {
                if (this.timerInterval) {
                    clearInterval(this.timerInterval);
                    this.timerInterval = null;
                }
            },

            handleAction(action) {
                if (this.isActionBlocked || this.gameState !== 'playing') return;
                this.isActionBlocked = true;
                this.stopWaveTimer();

                const expected = this.currentWaveData.correctAction;

                if (action === expected) {
                    // Успех волны
                    playSuccessSound();
                    if (this.currentWave < this.totalWaves) {
                        setTimeout(() => {
                            this.loadWave(this.currentWave + 1);
                        }, 250);
                    } else {
                        // Победа в хардкор-режиме
                        this.gameState = 'victory';
                        this.sendTelemetry('level_complete', 'completed', true);
                    }
                } else {
                    // Ошибка вентиля -> Тотальный хардкор-сброс
                    let reason = `Неверный выбор вентиля! Ожидался [${expected.toUpperCase()}], выбран [${action.toUpperCase()}].`;
                    this.triggerHardcoreReset(reason);
                }
            },

            triggerHardcoreReset(reason) {
                this.stopWaveTimer();
                this.isActionBlocked = true;
                this.alarmActive = true;
                this.alarmMessage = reason;
                this.attempts++;

                playAlarmSiren();
                playErrorSound();

                // Телеметрия сбоя
                this.sendTelemetry('hardcore_reset', 'failed', false);

                // Через 1.8 секунды тотальный сброс прогресса на Волну 1
                setTimeout(() => {
                    this.activeWaves = generateWaves();
                    this.loadWave(1);
                }, 1800);
            },

            handleKeydown(e) {
                if (this.gameState === 'intro' && (e.code === 'Space' || e.key === ' ')) {
                    e.preventDefault();
                    this.startGame();
                    return;
                }

                if (this.gameState !== 'playing' || this.isActionBlocked) return;

                if (e.key === '1' || e.code === 'Digit1') {
                    e.preventDefault();
                    this.handleAction('carry');
                } else if (e.key === '2' || e.code === 'Digit2') {
                    e.preventDefault();
                    this.handleAction('borrow');
                } else if (e.key === '3' || e.code === 'Digit3') {
                    e.preventDefault();
                    this.handleAction('normal');
                }
            }
        },

        mounted() {
            window.addEventListener('keydown', this.handleKeydown);

            // Экспорт глобального тестового хука
            window.__DEV_LEVEL3_STATE__ = {
                waves: () => this.activeWaves,
                currentWaveIndex: () => this.currentWave - 1,
                currentWave: () => this.currentWaveData,
                solveCurrentWave: () => {
                    if (this.currentWaveData && this.currentWaveData.correctAction) {
                        this.handleAction(this.currentWaveData.correctAction);
                    }
                },
                submitAction: (action) => {
                    this.handleAction(action);
                }
            };
        },

        beforeUnmount() {
            window.removeEventListener('keydown', this.handleKeydown);
            this.stopWaveTimer();
        }
    }).mount('#vue-app');
})();
</script>
