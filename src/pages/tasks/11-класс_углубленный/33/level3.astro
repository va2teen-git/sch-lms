---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={3}>
    <div id="arcade-app" class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Заголовок тренажера -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h1 class="h4 text-danger mb-0 fw-bold">Арена: RegEx WAF Interceptor & ReDoS Defense (Уровень 3)</h1>
                <div class="text-secondary small">Урок 33 // 11 класс (технологический профиль)</div>
            </div>
            <span class="badge border border-danger text-danger bg-dark rounded-0 px-3 py-2">
                Аркадный босс // Хардкор-сброс
            </span>
        </div>

        <div class="card bg-dark border-danger rounded-0 shadow">
            <div class="card-body p-3 p-md-4">

                <!-- ЭКРАН 1: ВВОДНЫЙ БРИФИНГ (Intro Screen) -->
                <div v-if="gameState === 'intro'" class="text-center py-4">
                    <div class="display-6 text-danger fw-bold mb-2">РЕЖИМ ОБОРОНЫ СЕРВЕРА (WAF DEFENSE)</div>
                    <p class="text-light fs-5 max-w-700 mx-auto mb-4">
                        Вы управляете межсетевым экраном веб-приложений (WAF) поискового портала. 
                        На сервер обрушивается шквал сетевых запросов. 
                        Ваша задача — за доли секунды классифицировать поток на легитимный трафик, спам-шум, сигнатурные эксплойты и катастрофический возврат (ReDoS).
                    </p>

                    <div class="alert alert-dark bg-black border border-danger text-light rounded-0 text-start mx-auto p-3 mb-4" style="max-width: 680px;">
                        <div class="text-danger fw-bold mb-2">⚡ ТАКТИЧЕСКИЕ ПРАВИЛА ХАРДКОР-РЕЖИМА:</div>
                        <ul class="mb-0 text-secondary small ps-3">
                            <li><strong class="text-light">10 эскалирующих волн:</strong> таймер непрерывно сжимается от 11 до 5 секунд на волну.</li>
                            <li><strong class="text-danger">ТОТАЛЬНЫЙ СБРОС:</strong> любая ошибка или истечение таймера вызывают тревогу и <em>ПОЛНОСТЬЮ ОБНУЛЯЮТ ПРОГРЕСС НА ВОЛНУ 1</em>.</li>
                            <li><strong class="text-info">Горячие клавиши:</strong> используйте клавиши <code>1</code>, <code>2</code>, <code>3</code>, <code>4</code> для мгновенного реагирования.</li>
                        </ul>
                    </div>

                    <button id="start-btn" @click="startGame" class="btn btn-danger btn-lg rounded-0 px-5 py-3 fw-bold text-white shadow" style="min-height: 48px;">
                        ▶ НАЧАТЬ ОТРАЖЕНИЕ АТАКИ [ПРОБЕЛ]
                    </button>
                </div>

                <!-- ЭКРАН 2: АКТИВНЫЙ БОЙ (Playing Screen) -->
                <div v-else-if="gameState === 'playing'">

                    <!-- Верхняя панель: статус волны, таймер, счетчик сбоев -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 border-bottom border-secondary pb-2">
                        <div>
                            <span id="phase-counter" class="badge bg-danger text-white rounded-0 fs-6 me-2">
                                ВОЛНА <span v-text="currentWave"></span> ИЗ 10
                            </span>
                            <span class="text-light fw-bold fs-6" v-text="currentWaveData.title"></span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="text-secondary small">
                                Сбои: <span class="text-warning fw-bold" v-text="failCount"></span>
                            </div>
                            <div class="text-secondary small">
                                Таймер: <span class="text-danger fw-bold fs-5" v-text="timeLeft.toFixed(1) + 's'"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Индикатор таймера волны -->
                    <div class="progress rounded-0 bg-black border border-secondary mb-3" style="height: 8px;">
                        <div class="progress-bar bg-danger transition-all" role="progressbar" 
                             :style="{ width: (timeLeft / currentWaveData.maxTime * 100) + '%' }"></div>
                    </div>

                    <!-- Аварийный баннер тревоги (Хардкор-вайп) -->
                    <div id="alarm-box" v-if="isAlarm" class="alert alert-danger bg-black border border-danger text-danger rounded-0 mb-3 py-2 px-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="fw-bold fs-6">🚨 КРИТИЧЕСКИЙ СБОЙ ФИЛЬТРАЦИИ! СЕРВЕР ПЕРЕЗАГРУЖАЕТСЯ:</span>
                                <div class="small mt-1 text-light" v-text="alarmMessage"></div>
                            </div>
                            <div class="spinner-border spinner-border-sm text-danger" role="status"></div>
                        </div>
                    </div>

                    <!-- Терминал данных запроса (Data Source) -->
                    <div class="card bg-black border border-secondary rounded-0 mb-3">
                        <div class="card-header bg-dark text-danger py-2 px-3 small fw-bold d-flex justify-content-between align-items-center">
                            <span>ПЕРЕХВАЧЕННЫЙ ВХОДНОЙ ПАКЕТ ДАННЫХ (Deep Packet Inspection):</span>
                            <span class="badge bg-secondary rounded-0 font-monospace">WAVE-<span v-text="currentWave"></span></span>
                        </div>
                        <div class="card-body p-3">
                            <div class="mb-2">
                                <span class="text-secondary small">Входящая полезная нагрузка (Payload):</span>
                                <div class="p-2 bg-dark border border-secondary text-info text-break font-monospace fs-6">
                                    <code v-text="currentWaveData.payload"></code>
                                </div>
                            </div>

                            <div class="row g-2">
                                <div class="col-12 col-md-7">
                                    <span class="text-secondary small">Активный RegEx-шаблон синтаксического фильтра:</span>
                                    <div class="p-2 bg-dark border border-secondary text-warning text-break font-monospace small">
                                        <code v-text="currentWaveData.regexPattern"></code>
                                    </div>
                                </div>
                                <div class="col-12 col-md-5">
                                    <span class="text-secondary small">Алгоритмический аудит сложности:</span>
                                    <div class="p-2 bg-dark border border-secondary text-light small" v-text="currentWaveData.complexityAudit">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Интерактивные шлюзы принятия решений (Direct Surface) -->
                    <div class="row g-2 mb-2">
                        <!-- Кнопка 1: PASS_VALID -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <button @click="handleAction('pass')" 
                                    :disabled="isActionBlocked"
                                    class="btn btn-outline-success w-100 rounded-0 p-2 p-sm-3 text-start font-monospace d-flex flex-column justify-content-between shadow-sm transition-colors"
                                    style="min-height: 64px;">
                                <div class="d-flex justify-content-between align-items-center w-100">
                                    <span class="fw-bold fs-6 text-success">[1] PASS_VALID</span>
                                    <span class="badge bg-success text-dark rounded-0">1</span>
                                </div>
                                <div class="small text-secondary" style="font-size: 0.75rem;">
                                    Легитимный запрос, линейный ДКА O(N)
                                </div>
                            </button>
                        </div>

                        <!-- Кнопка 2: SPAM_FILTER -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <button @click="handleAction('spam_filter')" 
                                    :disabled="isActionBlocked"
                                    class="btn btn-outline-warning w-100 rounded-0 p-2 p-sm-3 text-start font-monospace d-flex flex-column justify-content-between shadow-sm transition-colors"
                                    style="min-height: 64px;">
                                <div class="d-flex justify-content-between align-items-center w-100">
                                    <span class="fw-bold fs-6 text-warning">[2] SPAM_FILTER</span>
                                    <span class="badge bg-warning text-dark rounded-0">2</span>
                                </div>
                                <div class="small text-secondary" style="font-size: 0.75rem;">
                                    Спам-корпус, стоп-слова, шум
                                </div>
                            </button>
                        </div>

                        <!-- Кнопка 3: BLOCK_EXPLOIT -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <button @click="handleAction('block_exploit')" 
                                    :disabled="isActionBlocked"
                                    class="btn btn-outline-danger w-100 rounded-0 p-2 p-sm-3 text-start font-monospace d-flex flex-column justify-content-between shadow-sm transition-colors"
                                    style="min-height: 64px;">
                                <div class="d-flex justify-content-between align-items-center w-100">
                                    <span class="fw-bold fs-6 text-danger">[3] BLOCK_EXPLOIT</span>
                                    <span class="badge bg-danger text-white rounded-0">3</span>
                                </div>
                                <div class="small text-secondary" style="font-size: 0.75rem;">
                                    Сигнатурная атака (SQLi, Traversal)
                                </div>
                            </button>
                        </div>

                        <!-- Кнопка 4: REDOS_DEFENSE -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <button @click="handleAction('redos_defense')" 
                                    :disabled="isActionBlocked"
                                    class="btn btn-outline-info w-100 rounded-0 p-2 p-sm-3 text-start font-monospace d-flex flex-column justify-content-between shadow-sm transition-colors"
                                    style="min-height: 64px;">
                                <div class="d-flex justify-content-between align-items-center w-100">
                                    <span class="fw-bold fs-6 text-info">[4] REDOS_DEFENSE</span>
                                    <span class="badge bg-info text-dark rounded-0">4</span>
                                </div>
                                <div class="small text-secondary" style="font-size: 0.75rem;">
                                    Катастрофический возврат O(2^N)
                                </div>
                            </button>
                        </div>
                    </div>

                </div>

                <!-- ЭКРАН 3: ПОБЕДА НАД БОССОМ (Victory Screen) -->
                <div v-else-if="gameState === 'victory'" class="text-center py-4">
                    <h2 class="display-5 text-danger fw-bold mb-2">ХАРДКОР-РЕЖИМ УСПЕШНО ПРЕОДОЛЕН!</h2>
                    <p class="text-light fs-5 mb-4">
                        Вы безупречно отразили все 10 волн вредоносного трафика, защитили поисковый сервер от катастрофического возврата (ReDoS) и очистили частотный индекс.
                    </p>
                    <div class="d-inline-flex gap-4 p-3 bg-black border border-danger rounded-0 mb-4 text-start">
                        <div>
                            <span class="text-secondary small d-block">ЧИСЛО СБОЕВ (FAILURES):</span>
                            <span class="fs-4 fw-bold text-warning" v-text="failCount"></span>
                        </div>
                        <div>
                            <span class="text-secondary small d-block">ИТОГОВОЕ ВРЕМЯ МИССИИ:</span>
                            <span class="fs-4 fw-bold text-info" v-text="formatTime(totalSessionElapsed)"></span>
                        </div>
                    </div>
                    <div>
                        <button @click="restartGame" class="btn btn-outline-danger rounded-0 px-4 py-2 fw-bold" style="min-height: 48px;">
                            ↻ Пройти аркаду заново
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<!-- Локальный Vue 3 -->
<script is:inline src="/static/vue.global.js"></script>

<script is:inline>
(() => {
    'use strict';

    const { createApp } = Vue;
    const missionName = 'Урок 33 :: Анализ текста на естественном языке. Регулярные выражения (Уровень 3)';

    // Web Audio API синтезатор сигналов
    let audioCtx = null;
    function getAudioContext() {
        if (!audioCtx) {
            const AudioClass = window.AudioContext || window.webkitAudioContext;
            if (AudioClass) audioCtx = new AudioClass();
        }
        return audioCtx;
    }

    function playTone(freq, type, duration, vol = 0.15) {
        try {
            const ctx = getAudioContext();
            if (!ctx) return;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = type;
            osc.frequency.setValueAtTime(freq, ctx.currentTime);
            gain.gain.setValueAtTime(vol, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + duration);
        } catch (e) {}
    }

    function playSuccessSound() {
        playTone(660, 'sine', 0.1);
        setTimeout(() => playTone(990, 'sine', 0.15), 60);
    }

    function playAlarmSiren() {
        playTone(400, 'triangle', 0.18);
        setTimeout(() => playTone(800, 'triangle', 0.18), 100);
        setTimeout(() => playTone(400, 'triangle', 0.18), 200);
        setTimeout(() => playTone(800, 'triangle', 0.18), 300);
    }

    // Процедурный генератор 10 волн с нарастающей сложностью
    function generateWaves() {
        return [
            // Волна 1: Легитимный REST-запрос
            {
                waveNumber: 1,
                title: 'Волна 1: Базовая валидация REST-запроса',
                payload: 'GET /api/v1/telemetry?lesson=33 HTTP/1.1',
                regexPattern: '^GET\\s+/api/v1/telemetry\\?lesson=\\d+\\s+HTTP/1\\.1$',
                complexityAudit: 'Линейный ДКА (DFA), время сопоставления O(N). Без ветвлений.',
                correctAction: 'pass',
                maxTime: 11.0,
                errorExplanation: 'Запрос полностью валиден и строго соответствует спецификации API! Требовалось действие [1] PASS_VALID.'
            },
            // Волна 2: Маркетинговый спам-шум
            {
                waveNumber: 2,
                title: 'Волна 2: Фильтрация спам-корпуса и стоп-слов',
                payload: 'FEEDBACK: Выиграй бесплатный миллион в крипто-розыгрыше без смс!',
                regexPattern: '(?i)\\b(выиграй|миллион|розыгрыш|бесплатно)\\b',
                complexityAudit: 'Высокая плотность стоп-слов спама, превышен лимит частотного фильтра.',
                correctAction: 'spam_filter',
                maxTime: 10.5,
                errorExplanation: 'Текст перегружен стоп-словами маркетингового спама! Требовалось действие [2] SPAM_FILTER.'
            },
            // Волна 3: Сигнатурная SQL-инъекция
            {
                waveNumber: 3,
                title: 'Волна 3: Сигнатурный перехват SQL-инъекции',
                payload: "GET /catalog/search?term=admin'%20OR%20'1'='1 HTTP/1.1",
                regexPattern: "(?i)(?:'|\\%27)\\s*or\\s*(?:'1'='1|1=1)",
                complexityAudit: 'Обнаружен маркер логической инъекции для обхода аутентификации.',
                correctAction: 'block_exploit',
                maxTime: 10.0,
                errorExplanation: 'Обнаружен классический вектор SQL-инъекции! Требовалось действие [3] BLOCK_EXPLOIT.'
            },
            // Волна 4: ReDoS-атака со вложенными квантификаторами
            {
                waveNumber: 4,
                title: 'Волна 4: Катастрофический возврат ReDoS (Вложенный плюс)',
                payload: 'aaaaaaaaaaaaaaaaaaaaaaaaaaaa!',
                regexPattern: '^(a+)+$',
                complexityAudit: 'Вложенные квантификаторы (a+)+ на несовпадающей строке вызывают 2^N шагов отката!',
                correctAction: 'redos_defense',
                maxTime: 9.5,
                errorExplanation: 'Шаблон ^(a+)+$ вызвал катастрофический откат движка (ReDoS)! Требовалось действие [4] REDOS_DEFENSE.'
            },
            // Волна 5: Легитимный авторизационный токен
            {
                waveNumber: 5,
                title: 'Волна 5: Проверка сложного токена авторизации',
                payload: 'AUTH Token Bearer SEC-8A4F-2026-prod',
                regexPattern: '^AUTH\\s+Token\\s+Bearer\\s+SEC-[0-9A-F]{4}-\\d{4}-\\w+$',
                complexityAudit: 'Строгие границы слов \\b и классы символов. Уязвимости отсутствуют.',
                correctAction: 'pass',
                maxTime: 9.0,
                errorExplanation: 'Заголовок авторизации полностью легитимен и безопасен! Требовалось действие [1] PASS_VALID.'
            },
            // Волна 6: Эксплойт Path Traversal
            {
                waveNumber: 6,
                title: 'Волна 6: Попытка обхода каталога (Path Traversal)',
                payload: 'GET /files?path=../../../../etc/shadow HTTP/1.1',
                regexPattern: '(?:\\.\\./|\\.\\.\\\\){2,}',
                complexityAudit: 'Обнаружены относительные переходы вверх по дереву каталогов ОС.',
                correctAction: 'block_exploit',
                maxTime: 8.5,
                errorExplanation: 'Обнаружена атака выхода за пределы корневого каталога! Требовалось действие [3] BLOCK_EXPLOIT.'
            },
            // Волна 7: Скрытый ReDoS с перекрывающимися альтернативами
            {
                waveNumber: 7,
                title: 'Волна 7: Катастрофический откат (Перекрывающиеся альтернативы)',
                payload: 'xxxxxxxxxxxxxxxxxxxxxxxxxX',
                regexPattern: '^(x|xx)+$',
                complexityAudit: 'Альтернативы (x|xx) пересекаются, создавая 2^N комбинаторных путей возврата.',
                correctAction: 'redos_defense',
                maxTime: 8.0,
                errorExplanation: 'Шаблон ^(x|xx)+$ вызвал экспоненциальный взрыв вариантов сопоставления! Требовалось действие [4] REDOS_DEFENSE.'
            },
            // Волна 8: Фишинговый спам-домен
            {
                waveNumber: 8,
                title: 'Волна 8: Фильтрация вредоносного спам-домена',
                payload: 'MSG: Срочно перейдите по ссылке http://c-a-s-i-n-o-p-r-i-z-e.xyz/free',
                regexPattern: '(?i)https?://[a-z0-9\\-]+\\.(xyz|top|click)/(?:free|prize)',
                complexityAudit: 'Спам-сигнатура с высокой документной энтропией домена зоны .xyz.',
                correctAction: 'spam_filter',
                maxTime: 7.0,
                errorExplanation: 'Сообщение содержит запрещенный фишинговый спам-домен! Требовалось действие [2] SPAM_FILTER.'
            },
            // Волна 9: Легитимный JSON-RPC пакет
            {
                waveNumber: 9,
                title: 'Волна 9: Валидация структуры JSON-RPC вызова',
                payload: 'POST /rpc {"jsonrpc": "2.0", "method": "audit_logs", "id": 1048}',
                regexPattern: '^POST\\s+/rpc\\s+\\{"jsonrpc":\\s*"2\\.0",\\s*"method":\\s*"[a-z_]+",\\s*"id":\\s*\\d+\\}$',
                complexityAudit: 'Корректный синтаксис JSON, безопасные литералы методов.',
                correctAction: 'pass',
                maxTime: 6.0,
                errorExplanation: 'Пакет JSON-RPC синтаксически безупречен и безопасен! Требовалось действие [1] PASS_VALID.'
            },
            // Волна 10: Финальный босс — ReDoS над символьным классом
            {
                waveNumber: 10,
                title: 'Волна 10: Финальный босс — Экспоненциальный коллапс ReDoS',
                payload: 'AdminSessionIdentityToken1234567890_EXPIRED_SIGNATURE#!',
                regexPattern: '^([a-zA-Z0-9]+)*$',
                complexityAudit: 'Вложенный квантификатор ([a-zA-Z0-9]+)* на цепочке с недопустимым "#!" парализует CPU!',
                correctAction: 'redos_defense',
                maxTime: 5.5,
                errorExplanation: 'Кульминационный ReDoS-шаблон парализовал вычислительные ресурсы сервера! Требовалось действие [4] REDOS_DEFENSE.'
            }
        ];
    }

    createApp({
        data() {
            return {
                gameState: 'intro', // 'intro', 'playing', 'victory'
                currentWave: 1,
                activeWaves: generateWaves(),
                timeLeft: 11.0,
                timerInterval: null,
                isAlarm: false,
                alarmMessage: '',
                isActionBlocked: false,
                failCount: 0,
                sessionStartTime: 0,
                totalSessionElapsed: 0
            };
        },

        computed: {
            currentWaveData() {
                return this.activeWaves[this.currentWave - 1] || this.activeWaves[0];
            }
        },

        methods: {
            startGame() {
                this.gameState = 'playing';
                this.sessionStartTime = Date.now();
                this.failCount = 0;
                this.activeWaves = generateWaves();
                this.loadWave(1);
            },

            restartGame() {
                this.gameState = 'intro';
            },

            loadWave(waveNum) {
                this.stopWaveTimer();
                this.currentWave = waveNum;
                this.isAlarm = false;
                this.isActionBlocked = false;

                const waveData = this.currentWaveData;
                this.timeLeft = waveData.maxTime;

                // Запуск интервала таймера (100 мс дискретность)
                this.timerInterval = setInterval(() => {
                    this.timeLeft = Math.max(0, this.timeLeft - 0.1);
                    if (this.timeLeft <= 0) {
                        this.handleTimeout();
                    }
                }, 100);
            },

            stopWaveTimer() {
                if (this.timerInterval) {
                    clearInterval(this.timerInterval);
                    this.timerInterval = null;
                }
            },

            handleTimeout() {
                this.triggerHardcoreWipe('Время анализа сетевого пакета истекло! Шлюз переполнен вредоносным трафиком.');
            },

            handleAction(action) {
                if (this.isActionBlocked || this.gameState !== 'playing') return;

                const expected = this.currentWaveData.correctAction;

                if (action === expected) {
                    playSuccessSound();

                    if (this.currentWave >= 10) {
                        // Победа над боссом
                        this.stopWaveTimer();
                        this.totalSessionElapsed = Math.floor((Date.now() - this.sessionStartTime) / 1000);
                        this.gameState = 'victory';

                        window.parent.postMessage({
                            type: 'TELEMETRY_EVENT',
                            mission_name: missionName,
                            action_type: 'level_complete',
                            status: 'completed',
                            success: true,
                            attempts_count: this.failCount,
                            time_spent_sec: this.totalSessionElapsed
                        }, '*');
                    } else {
                        // Переход к следующей волне
                        this.loadWave(this.currentWave + 1);

                        window.parent.postMessage({
                            type: 'TELEMETRY_EVENT',
                            mission_name: missionName,
                            action_type: 'in_progress',
                            status: 'wave_complete',
                            wave: this.currentWave,
                            attempts_count: this.failCount
                        }, '*');
                    }
                } else {
                    // Ошибка действия -> Тотальный хардкор-сброс
                    const expReason = this.currentWaveData.errorExplanation || 'Неверное решение по сетевому пакету!';
                    this.triggerHardcoreWipe(expReason);
                }
            },

            triggerHardcoreWipe(reason) {
                this.stopWaveTimer();
                this.isActionBlocked = true;
                this.isAlarm = true;
                this.alarmMessage = reason;
                this.failCount++;

                playAlarmSiren();

                window.parent.postMessage({
                    type: 'TELEMETRY_EVENT',
                    mission_name: missionName,
                    action_type: 'hardcore_reset',
                    status: 'failed',
                    attempts_count: this.failCount
                }, '*');

                // Через 1.8 секунды тотальный сброс прогресса на Волну 1 с новой генерацией
                setTimeout(() => {
                    this.activeWaves = generateWaves();
                    this.loadWave(1);
                }, 1800);
            },

            formatTime(seconds) {
                const mins = String(Math.floor(seconds / 60)).padStart(2, '0');
                const secs = String(seconds % 60).padStart(2, '0');
                return `${mins}:${secs}`;
            },

            handleKeydown(e) {
                if (this.gameState === 'intro' && (e.code === 'Space' || e.key === ' ')) {
                    e.preventDefault();
                    this.startGame();
                    return;
                }

                if (this.gameState !== 'playing' || this.isActionBlocked) return;

                if (e.key === '1' || e.code === 'Digit1') {
                    e.preventDefault();
                    this.handleAction('pass');
                } else if (e.key === '2' || e.code === 'Digit2') {
                    e.preventDefault();
                    this.handleAction('spam_filter');
                } else if (e.key === '3' || e.code === 'Digit3') {
                    e.preventDefault();
                    this.handleAction('block_exploit');
                } else if (e.key === '4' || e.code === 'Digit4') {
                    e.preventDefault();
                    this.handleAction('redos_defense');
                }
            }
        },

        mounted() {
            window.addEventListener('keydown', this.handleKeydown);

            // Экспорт глобального тестового хука
            window.__DEV_LEVEL3_STATE__ = {
                waves: () => this.activeWaves,
                currentWaveIndex: () => this.currentWave - 1,
                currentWave: () => this.currentWaveData,
                solveCurrentWave: () => {
                    if (this.currentWaveData && this.currentWaveData.correctAction) {
                        this.handleAction(this.currentWaveData.correctAction);
                    }
                },
                submitAction: (action) => {
                    this.handleAction(action);
                }
            };
        },

        beforeUnmount() {
            this.stopWaveTimer();
            window.removeEventListener('keydown', this.handleKeydown);
        }
    }).mount('#arcade-app');
})();
</script>
