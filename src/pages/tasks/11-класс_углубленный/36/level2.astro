---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={2} title="Урок 36 :: Вычисление арифметического выражения, записанного в постфиксной форме (Уровень 2)">
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Заголовок тренажера -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h1 class="h4 text-warning mb-0 fw-bold">Тренажер: Аналитическая трассировка ОПЗ и парсер Дейкстры (Уровень 2)</h1>
                <div class="text-secondary small">Урок 36 // 11 класс (углубленный уровень, технологический профиль)</div>
            </div>
            <span class="badge border border-warning text-warning bg-dark rounded-0 px-3 py-2">
                Ручной ввод // Sawtooth 2-1-2 // Anti-Paste
            </span>
        </div>

        <div id="game-container" class="card bg-dark border-warning rounded-0 shadow">
            <div class="card-body p-3 p-md-4">

                <!-- Индикатор прогресса, счетчик ошибок и таймер -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="phase-badge" class="badge bg-warning text-dark rounded-0 fs-6 me-2">Шаг 1 из 5</span>
                        <span id="phase-title" class="text-light fw-bold fs-6">Прямой расчет: вычисление значения ОПЗ</span>
                    </div>
                    <div class="text-secondary small">
                        Ошибки: <span id="attempts-display" class="text-warning fw-bold">0</span> |
                        Время: <span id="timer-display" class="text-info fw-bold">00:00</span>
                    </div>
                </div>

                <!-- Баннер ошибки -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2 small" role="alert">
                    <span class="fw-bold">[ОШИБКА РАСЧЕТА]</span> <span id="feedback-text"></span>
                </div>

                <!-- Баннер успеха -->
                <div id="success-box" class="alert alert-success bg-black text-success border border-success rounded-0 d-none mb-3 py-2 small" role="alert">
                    <span class="fw-bold">[ВЕРИФИЦИРОВАНО]</span> <span id="success-text"></span>
                </div>

                <!-- ================================================================= -->
                <!-- ФАЗА 1: Прямой расчет — значение постфиксного выражения (CCS = 4) -->
                <!-- ================================================================= -->
                <div id="phase1" class="phase-view">
                    <div class="alert alert-dark bg-black border border-secondary rounded-0 small text-light mb-3">
                        <span class="text-warning fw-bold">ФАЗА 1 (Прямой расчет):</span>
                        Выполните пошаговую стековую трассировку постфиксного выражения. Не забывайте, что первый <code>pop()</code> извлекает <strong>правый</strong> операнд, а второй — <strong>левый</strong>.
                    </div>

                    <div class="card bg-black border border-secondary rounded-0 p-3 mb-3 text-center">
                        <div class="text-secondary small mb-2">ВЫРАЖЕНИЕ В ОБРАТНОЙ ПОЛЬСКОЙ ЗАПИСИ (ОПЗ):</div>
                        <div id="p1-expr" class="fs-3 fw-bold text-warning"></div>
                    </div>

                    <div class="mb-3" style="max-width: 580px;">
                        <label for="p1-input" class="form-label small text-secondary">
                            Введите итоговое вычисленное значение выражения:
                        </label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" id="p1-input" onpaste="return false;" class="form-control bg-black text-warning border-secondary rounded-0 font-monospace fs-5 py-2 px-3" placeholder="Введите число" autocomplete="off" />
                            <button id="p1-submit-btn" type="button" class="btn btn-warning rounded-0 px-4 fw-bold text-dark" style="min-height: 48px;">
                                Проверить ➔
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ================================================================= -->
                <!-- ФАЗА 2: Конвертация единиц и проценты — байт-код стековой ВМ      -->
                <!-- ================================================================= -->
                <div id="phase2" class="phase-view d-none">
                    <div class="alert alert-dark bg-black border border-secondary rounded-0 small text-light mb-3">
                        <span class="text-warning fw-bold">ФАЗА 2 (Конвертация и проценты):</span>
                        Компилятор перевел постфиксное выражение в байт-код стековой виртуальной машины. Подсчитайте число операндов и операторов, переведите размер выделенного буфера из бит в байты и определите степень заполнения.
                    </div>

                    <div class="card bg-black border border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-2">ПОСТФИКСНАЯ ПРОГРАММА И ПАРАМЕТРЫ СТЕКОВОЙ ВМ:</div>
                        <div id="p2-expr" class="fs-5 fw-bold text-info border border-secondary bg-dark p-2 text-center mb-3"></div>
                        <div class="row g-2 text-light small">
                            <div class="col-12 col-sm-6">
                                <div>Инструкция <code>LOAD_CONST</code> (операнд): <strong id="p2-op-bytes" class="text-warning">4</strong> байта</div>
                                <div>Инструкция <code>BINARY_OP</code> (оператор): <strong class="text-info">1</strong> байт</div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <div>Выделенный буфер кода: <strong id="p2-buf-bits" class="text-warning fs-6">512</strong> бит</div>
                                <div>Требуется: процент занятого буфера</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3" style="max-width: 580px;">
                        <label for="p2-input" class="form-label small text-secondary">
                            Сколько процентов (%) от выделенного буфера занимает байт-код этой программы (можно с запятой или точкой, напр. 37,5%)?
                        </label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" id="p2-input" onpaste="return false;" class="form-control bg-black text-warning border-secondary rounded-0 font-monospace fs-5 py-2 px-3" placeholder="Например: 37,5%" autocomplete="off" />
                            <button id="p2-submit-btn" type="button" class="btn btn-warning rounded-0 px-4 fw-bold text-dark" style="min-height: 48px;">
                                Проверить ➔
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ================================================================= -->
                <!-- ФАЗА 3: Пик 1 (Инверсия) — поиск неизвестного операнда X (CCS=7-8)-->
                <!-- ================================================================= -->
                <div id="phase3" class="phase-view d-none">
                    <div class="alert alert-dark bg-black border border-secondary rounded-0 small text-light mb-3">
                        <span class="text-warning fw-bold">ФАЗА 3 (Пик инверсии — обратная задача):</span>
                        Восстановите скрытый целый операнд <strong class="text-warning">X</strong>, при котором стековый вычислитель вернет заданный результат. Обращайте особое внимание на порядок вычитания и деления!
                    </div>

                    <div class="card bg-black border border-secondary rounded-0 p-3 mb-3 text-center">
                        <div class="text-secondary small mb-2">УРАВНЕНИЕ В ПОСТФИКСНОЙ ФОРМЕ:</div>
                        <div id="p3-expr" class="fs-4 fw-bold text-light mb-2"></div>
                        <div class="small text-secondary">
                            Результат на вершине стека после завершения:
                            <strong id="p3-target" class="text-warning fs-4 ms-1"></strong>
                        </div>
                    </div>

                    <div class="mb-3" style="max-width: 580px;">
                        <label for="p3-input" class="form-label small text-secondary">
                            Введите точное значение неизвестного операнда <code>X</code>:
                        </label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" id="p3-input" onpaste="return false;" class="form-control bg-black text-warning border-secondary rounded-0 font-monospace fs-5 py-2 px-3" placeholder="Значение X" autocomplete="off" />
                            <button id="p3-submit-btn" type="button" class="btn btn-warning rounded-0 px-4 fw-bold text-dark" style="min-height: 48px;">
                                Проверить ➔
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ================================================================= -->
                <!-- ФАЗА 4: Долина консолидации — пиковая глубина стека (CCS = 5-6)   -->
                <!-- ================================================================= -->
                <div id="phase4" class="phase-view d-none">
                    <div class="alert alert-dark bg-black border border-secondary rounded-0 small text-light mb-3">
                        <span class="text-warning fw-bold">ФАЗА 4 (Долина консолидации — концептуальный инвариант):</span>
                        Вычислять сами значения здесь <strong>не требуется</strong>! Определите лишь максимальный размер (пиковую глубину в элементах), которого достигал стек при обработке выражения слева направо.
                        <div class="text-secondary mt-1">Подсказка: число → <code>size + 1</code>, бинарный оператор → <code>size - 1</code>, унарный <code>u-</code> → <code>size</code> не меняется.</div>
                    </div>

                    <div class="card bg-black border border-secondary rounded-0 p-3 mb-3 text-center">
                        <div class="text-secondary small mb-2">ПОТОК ТОКЕНОВ ДЛЯ АНАЛИЗА ГЛУБИНЫ СТЕКА:</div>
                        <div id="p4-expr" class="fs-5 fw-bold text-info"></div>
                    </div>

                    <div class="mb-3" style="max-width: 580px;">
                        <label for="p4-input" class="form-label small text-secondary">
                            Какое максимальное количество элементов одновременно находилось в стеке за все время вычисления?
                        </label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" id="p4-input" onpaste="return false;" class="form-control bg-black text-warning border-secondary rounded-0 font-monospace fs-5 py-2 px-3" placeholder="Целое число элементов" autocomplete="off" />
                            <button id="p4-submit-btn" type="button" class="btn btn-warning rounded-0 px-4 fw-bold text-dark" style="min-height: 48px;">
                                Проверить ➔
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ================================================================= -->
                <!-- ФАЗА 5: Финальная кульминация — унарный минус, ^, деление (CCS=8-9)-->
                <!-- ================================================================= -->
                <div id="phase5" class="phase-view d-none">
                    <div class="alert alert-dark bg-black border border-secondary rounded-0 small text-light mb-3">
                        <span class="text-warning fw-bold">ФАЗА 5 (Кульминация — краевые правила сортировочной станции):</span>
                        Переведите инфиксное выражение в ОПЗ по правилам модифицированного алгоритма Дейкстры и вычислите итоговое числовое значение.
                        <ul class="mb-0 mt-1 ps-3 text-secondary">
                            <li>Возведение в степень <code>^</code> — <strong>правоассоциативно</strong> (приоритет 4).</li>
                            <li>Унарный минус <code>u-</code> имеет приоритет 3 (ниже <code>^</code>, но выше <code>×</code> и <code>/</code>).</li>
                            <li>Операция <code>/</code> — вещественное деление.</li>
                        </ul>
                    </div>

                    <div class="card bg-black border border-secondary rounded-0 p-3 mb-3 text-center">
                        <div class="text-secondary small mb-2">ИНФИКСНОЕ ВЫРАЖЕНИЕ С КРАЕВЫМИ СЛУЧАЯМИ:</div>
                        <div id="p5-expr" class="fs-3 fw-bold text-warning"></div>
                    </div>

                    <div class="mb-3" style="max-width: 580px;">
                        <label for="p5-input" class="form-label small text-secondary">
                            Введите точный числовой результат (при дробном ответе используйте запятую <code>,</code> или точку <code>.</code>):
                        </label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" id="p5-input" onpaste="return false;" class="form-control bg-black text-warning border-secondary rounded-0 font-monospace fs-5 py-2 px-3" placeholder="Например: -8,5" autocomplete="off" />
                            <button id="p5-submit-btn" type="button" class="btn btn-warning rounded-0 px-4 fw-bold text-dark" style="min-height: 48px;">
                                Завершить ➔
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ================================================================= -->
                <!-- ФИНАЛЬНЫЙ ЭКРАН УРОВНЯ 2                                          -->
                <!-- ================================================================= -->
                <div id="victory-screen" class="d-none text-center py-4">
                    <div class="display-6 text-warning fw-bold mb-2">УРОВЕНЬ 2 ПРОЙДЕН!</div>
                    <p class="text-light mb-3">
                        Все 5 аналитических фаз по кривой Sawtooth 2-1-2 успешно решены вручную без подсказок.
                    </p>
                    <div class="d-inline-flex flex-wrap justify-content-center gap-3 border border-warning bg-black px-4 py-3 mb-3">
                        <div>
                            <div class="text-secondary small">Ошибок допущено</div>
                            <div id="final-attempts" class="fs-4 text-warning fw-bold">0</div>
                        </div>
                        <div class="border-start border-secondary ps-3">
                            <div class="text-secondary small">Затраченное время</div>
                            <div id="final-time" class="fs-4 text-info fw-bold">00:00</div>
                        </div>
                    </div>
                    <div class="text-warning small">
                        Переходите к 3-му уровню сложности (аркада с клавиатурным управлением) во вкладках сверху.
                    </div>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(function() {
    'use strict';

    const missionName = 'Урок 36 :: Вычисление арифметического выражения, записанного в постфиксной форме (Уровень 2)';
    const telemetry = window.LMSTelemetry.create({
        missionName: missionName,
        level: 2,
        totalStages: 5
    });

    let currentPhase = 1;
    let isLocked = false;
    let timerInterval = null;

    function getRandomInt(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    function parseDecimalInput(raw) {
        if (typeof raw !== 'string') return NaN;
        const cleaned = raw.replace(/%/g, '').replace(/\s+/g, '').replace(',', '.').trim();
        if (!/^-?\d+(\.\d+)?$/.test(cleaned)) return NaN;
        const num = Number(cleaned);
        return Number.isFinite(num) ? num : NaN;
    }

    function updateAttemptsDisplay() {
        const el = document.getElementById('attempts-display');
        if (el) el.textContent = String(telemetry.getState().attemptsCount || 0);
    }

    function startTimer() {
        if (timerInterval) clearInterval(timerInterval);
        const timerDisplay = document.getElementById('timer-display');
        timerInterval = setInterval(function() {
            const elapsed = telemetry.getTimeSpentSec();
            const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
            const secs = String(elapsed % 60).padStart(2, '0');
            if (timerDisplay) timerDisplay.textContent = mins + ':' + secs;
        }, 1000);
    }

    function triggerErrorReset(msg, regenerateFn) {
        if (isLocked) return;
        isLocked = true;
        telemetry.markActivity();
        telemetry.fail({ stage: currentPhase });
        updateAttemptsDisplay();

        const fb = document.getElementById('feedback-box');
        const ft = document.getElementById('feedback-text');
        if (fb && ft) {
            ft.textContent = msg;
            fb.classList.remove('d-none');
        }

        setTimeout(function() {
            if (fb) fb.classList.add('d-none');
            isLocked = false;
            if (regenerateFn) regenerateFn();
        }, 1400);
    }

    function showSuccessFeedback(msg, nextFn) {
        if (isLocked) return;
        isLocked = true;
        const sb = document.getElementById('success-box');
        const st = document.getElementById('success-text');
        if (sb && st) {
            st.textContent = msg;
            sb.classList.remove('d-none');
        }
        setTimeout(function() {
            if (sb) sb.classList.add('d-none');
            isLocked = false;
            if (nextFn) nextFn();
        }, 950);
    }

    function showOnlyPhase(num) {
        for (let i = 1; i <= 5; i++) {
            const el = document.getElementById('phase' + i);
            if (el) el.classList.toggle('d-none', i !== num);
        }
    }

    function completeLevel() {
        if (timerInterval) clearInterval(timerInterval);
        const evt = telemetry.complete({ stage: 5 });
        const elapsed = evt ? evt.time_spent_sec : telemetry.getTimeSpentSec();
        const attempts = telemetry.getState().attemptsCount || 0;
        const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
        const secs = String(elapsed % 60).padStart(2, '0');

        showOnlyPhase(0);
        document.getElementById('victory-screen').classList.remove('d-none');
        document.getElementById('phase-badge').textContent = 'Пройдено';

        const fa = document.getElementById('final-attempts');
        const ft = document.getElementById('final-time');
        if (fa) fa.textContent = String(attempts);
        if (ft) ft.textContent = mins + ':' + secs;
    }

    // =========================================================================
    // ФАЗА 1: Прямой расчет ОПЗ (CCS = 4)
    // =========================================================================
    let p1Expected = 0;

    function initPhase1() {
        currentPhase = 1;
        showOnlyPhase(1);
        document.getElementById('phase-badge').textContent = 'Шаг 1 из 5';
        document.getElementById('phase-title').textContent = 'Прямой расчет: вычисление значения ОПЗ';

        const variant = getRandomInt(0, 2);
        let expr = '';

        if (variant === 0) {
            // (a - b) * c + d -> a b - c × d +
            const b = getRandomInt(3, 12);
            const diff = getRandomInt(2, 9);
            const a = b + diff;
            const c = getRandomInt(2, 7);
            const d = getRandomInt(4, 15);
            expr = a + ' ' + b + ' - ' + c + ' × ' + d + ' +';
            p1Expected = diff * c + d;
        } else if (variant === 1) {
            // (a * b - c) / d -> a b × c - d /
            const d = getRandomInt(2, 6);
            const quot = getRandomInt(3, 9);
            const c = getRandomInt(2, 10);
            const a = getRandomInt(4, 9);
            const b = getRandomInt(4, 9);
            const ab = a * b;
            const c2 = ab - quot * d;
            if (c2 > 0) {
                expr = a + ' ' + b + ' × ' + c2 + ' - ' + d + ' /';
                p1Expected = quot;
            } else {
                const k = getRandomInt(2, 5);
                const x1 = k * d;
                const x2 = getRandomInt(2, 8);
                expr = (x1 + x2) + ' ' + x2 + ' - ' + d + ' / ' + c + ' +';
                p1Expected = k + c;
            }
        } else {
            // a - b / c + d * e -> a b c / - d e × +
            const c = getRandomInt(2, 6);
            const q = getRandomInt(2, 8);
            const b = c * q;
            const a = getRandomInt(q + 3, 25);
            const d = getRandomInt(2, 6);
            const e = getRandomInt(2, 6);
            expr = a + ' ' + b + ' ' + c + ' / - ' + d + ' ' + e + ' × +';
            p1Expected = (a - q) + d * e;
        }

        document.getElementById('p1-expr').textContent = expr;
        const inp = document.getElementById('p1-input');
        if (inp) inp.value = '';
    }

    function verifyPhase1() {
        if (isLocked) return;
        telemetry.markActivity();
        const val = parseDecimalInput(document.getElementById('p1-input').value);
        if (Number.isNaN(val)) {
            triggerErrorReset('Введите корректное число!', initPhase1);
            return;
        }
        if (Math.abs(val - p1Expected) > 1e-4) {
            triggerErrorReset('Неверный результат! Проверьте порядок снятия операндов для некоммутативных операций (- и /). Генерируется новый пример...', initPhase1);
            return;
        }
        telemetry.advanceStage(2);
        showSuccessFeedback('Значение ОПЗ вычислено верно (' + p1Expected + ')!', initPhase2);
    }

    // =========================================================================
    // ФАЗА 2: Байт-код стековой ВМ и конвертация бит/байты/проценты (CCS = 6)
    // =========================================================================
    let p2Expected = 0;

    function initPhase2() {
        currentPhase = 2;
        showOnlyPhase(2);
        document.getElementById('phase-badge').textContent = 'Шаг 2 из 5';
        document.getElementById('phase-title').textContent = 'Конвертация единиц: процент заполнения буфера стековой ВМ';

        const templates = [
            // 4 числа, 3 оператора; при opBytes=2 -> 11 байт; при opBytes=4 -> 19 байт
            { expr: '12 5 + 8 3 - ×', operands: 4, operators: 3 },
            // 5 чисел, 4 оператора; при opBytes=2 -> 14 байт; при opBytes=4 -> 24 байта
            { expr: '10 4 - 7 2 + × 5 /', operands: 5, operators: 4 },
            // 6 чисел, 5 операторов; при opBytes=2 -> 17 байт; при opBytes=4 -> 29 байт
            { expr: '9 3 + 4 2 - × 8 4 / +', operands: 6, operators: 5 },
            // 7 чисел, 6 операторов; при opBytes=2 -> 20 байт; при opBytes=4 -> 34 байта
            { expr: '15 7 1 1 + - / 3 × 2 1 + -', operands: 7, operators: 6 }
        ];

        // Подбираем комбинацию, дающую красивую конечную десятичную дробь процентов
        const configs = [
            { tIdx: 1, opBytes: 4, bufBytes: 40 },  // (5*4+4)/40 = 24/40 = 60%
            { tIdx: 1, opBytes: 4, bufBytes: 64 },  // 24/64 = 37.5%
            { tIdx: 1, opBytes: 2, bufBytes: 40 },  // (5*2+4)/40 = 14/40 = 35%
            { tIdx: 1, opBytes: 2, bufBytes: 32 },  // 14/32 = 43.75%
            { tIdx: 0, opBytes: 4, bufBytes: 40 },  // 19/40 = 47.5%
            { tIdx: 0, opBytes: 2, bufBytes: 40 },  // 11/40 = 27.5%
            { tIdx: 2, opBytes: 2, bufBytes: 50 },  // 17/50 = 34%
            { tIdx: 3, opBytes: 2, bufBytes: 32 },  // 20/32 = 62.5%
            { tIdx: 3, opBytes: 4, bufBytes: 80 }   // 34/80 = 42.5%
        ];

        const cfg = configs[getRandomInt(0, configs.length - 1)];
        const tpl = templates[cfg.tIdx];
        const usedBytes = tpl.operands * cfg.opBytes + tpl.operators * 1;
        const bufBits = cfg.bufBytes * 8;
        p2Expected = (usedBytes / cfg.bufBytes) * 100;

        document.getElementById('p2-expr').textContent = tpl.expr;
        document.getElementById('p2-op-bytes').textContent = String(cfg.opBytes);
        document.getElementById('p2-buf-bits').textContent = String(bufBits);

        const inp = document.getElementById('p2-input');
        if (inp) inp.value = '';
    }

    function verifyPhase2() {
        if (isLocked) return;
        telemetry.markActivity();
        const val = parseDecimalInput(document.getElementById('p2-input').value);
        if (Number.isNaN(val)) {
            triggerErrorReset('Введите процент числом (допускается запятая «,», точка «.» и знак «%»)!', initPhase2);
            return;
        }
        if (Math.abs(val - p2Expected) > 1e-4) {
            triggerErrorReset('Неверный расчет! Сложите байты всех операндов и операторов, затем разделите на размер буфера в байтах (биты / 8). Генерируется новый вариант...', initPhase2);
            return;
        }
        telemetry.advanceStage(3);
        showSuccessFeedback('Процент заполнения буфера байт-кода рассчитан точно!', initPhase3);
    }

    // =========================================================================
    // ФАЗА 3: Пик 1 (Инверсия) — поиск неизвестного операнда X (CCS = 7-8)
    // =========================================================================
    let p3Expected = 0;

    function initPhase3() {
        currentPhase = 3;
        showOnlyPhase(3);
        document.getElementById('phase-badge').textContent = 'Шаг 3 из 5';
        document.getElementById('phase-title').textContent = 'Пик инверсии: восстановление пропущенного операнда X';

        const variant = getRandomInt(0, 2);
        let expr = '';
        let target = 0;

        if (variant === 0) {
            // A B × C X - / = TARGET  => (A*B)/(C - X) = TARGET
            const diff = getRandomInt(2, 6);
            const targetVal = getRandomInt(2, 8);
            const q1 = getRandomInt(2, 5);
            const a = diff * q1;
            const b = targetVal; // тогда (a * b) / diff = q1 * targetVal
            const x = getRandomInt(2, 9);
            const c = x + diff;
            target = q1 * b;
            expr = a + ' ' + b + ' × ' + c + ' X - /';
            p3Expected = x;
        } else if (variant === 1) {
            // A X - B × C + = TARGET  => (A - X) * B + C = TARGET
            const x = getRandomInt(2, 12);
            const diff = getRandomInt(2, 8);
            const a = x + diff;
            const b = getRandomInt(2, 6);
            const c = getRandomInt(3, 15);
            target = diff * b + c;
            expr = a + ' X - ' + b + ' × ' + c + ' +';
            p3Expected = x;
        } else {
            // A B + X C - × = TARGET => (A + B) * (X - C) = TARGET
            const a = getRandomInt(2, 8);
            const b = getRandomInt(2, 8);
            const c = getRandomInt(2, 9);
            const diff = getRandomInt(2, 7);
            const x = c + diff;
            target = (a + b) * diff;
            expr = a + ' ' + b + ' + X ' + c + ' - ×';
            p3Expected = x;
        }

        document.getElementById('p3-expr').textContent = expr;
        document.getElementById('p3-target').textContent = String(target);

        const inp = document.getElementById('p3-input');
        if (inp) inp.value = '';
    }

    function verifyPhase3() {
        if (isLocked) return;
        telemetry.markActivity();
        const val = parseDecimalInput(document.getElementById('p3-input').value);
        if (Number.isNaN(val)) {
            triggerErrorReset('Введите целое значение неизвестного операнда X!', initPhase3);
            return;
        }
        if (Math.abs(val - p3Expected) > 1e-4) {
            triggerErrorReset('Неверное значение X! Восстановите дерево ОПЗ и проверьте, где X является правым, а где левым операндом. Генерируется новая задача...', initPhase3);
            return;
        }
        telemetry.advanceStage(4);
        showSuccessFeedback('Инверсия выполнена безупречно! Переход к фазе консолидации...', initPhase4);
    }

    // =========================================================================
    // ФАЗА 4: Долина консолидации — пиковая глубина стека (CCS = 5-6)
    // =========================================================================
    let p4Expected = 0;

    function initPhase4() {
        currentPhase = 4;
        showOnlyPhase(4);
        document.getElementById('phase-badge').textContent = 'Шаг 4 из 5';
        document.getElementById('phase-title').textContent = 'Долина консолидации: пиковая глубина стека ОПЗ';

        // Процедурно строим корректное ОПЗ-выражение длиной 11..13 токенов (включая u-)
        const templates = [
            ['a', 'b', 'c', '×', '+', 'd', 'e', 'f', '-', '/', '-', 'g', '+'],
            ['a', 'b', 'u-', 'c', 'd', 'e', '+', '×', '-', '+'],
            ['a', 'b', 'c', 'd', '+', '×', 'e', 'f', '-', '/', '+'],
            ['a', 'b', '+', 'c', 'd', 'e', 'u-', '+', '×', '-', 'f', '+'],
            ['a', 'b', 'c', 'd', 'e', '+', '-', '×', '+', 'f', '-']
        ];
        const tpl = templates[getRandomInt(0, templates.length - 1)];

        const tokens = [];
        let curDepth = 0;
        let maxDepth = 0;

        tpl.forEach(function(item) {
            if (item >= 'a' && item <= 'z') {
                tokens.push(String(getRandomInt(1, 19)));
                curDepth += 1;
                if (curDepth > maxDepth) maxDepth = curDepth;
            } else if (item === 'u-') {
                tokens.push('u-');
                // Глубина не меняется (pop 1, push 1)
            } else {
                tokens.push(item);
                curDepth -= 1; // pop 2, push 1
            }
        });

        p4Expected = maxDepth;
        document.getElementById('p4-expr').textContent = tokens.join(' ');
        const inp = document.getElementById('p4-input');
        if (inp) inp.value = '';
    }

    function verifyPhase4() {
        if (isLocked) return;
        telemetry.markActivity();
        const val = parseDecimalInput(document.getElementById('p4-input').value);
        if (Number.isNaN(val)) {
            triggerErrorReset('Введите целое число элементов!', initPhase4);
            return;
        }
        if (Math.abs(val - p4Expected) > 1e-4) {
            triggerErrorReset('Неверная пиковая глубина! Проследите размер стека на каждом токене: число дает +1, бинарный оператор -1, u- дает 0. Генерируется новый поток...', initPhase4);
            return;
        }
        telemetry.advanceStage(5);
        showSuccessFeedback('Инвариант глубины стека определен верно (пик = ' + p4Expected + ')!', initPhase5);
    }

    // =========================================================================
    // ФАЗА 5: Кульминация — унарный минус перед ^, правая ассоциативность ^ и /
    // =========================================================================
    let p5Expected = 0;

    function initPhase5() {
        currentPhase = 5;
        showOnlyPhase(5);
        document.getElementById('phase-badge').textContent = 'Шаг 5 из 5';
        document.getElementById('phase-title').textContent = 'Кульминация: унарный минус, правоассоциативная степень и дробное деление';

        // Шаблон: -A ^ 2 + B ^ C ^ 0 - E / F
        // -A ^ 2 = -(A^2), так как u- имеет приоритет 3, а ^ имеет приоритет 4
        // B ^ C ^ 0 = B ^ (C ^ 0) = B ^ 1 = B (правая ассоциативность!)
        // E / F дает точное десятичное число (.5, .25, .75, .2, .4, .6, .8)
        const a = getRandomInt(2, 4);
        const b = getRandomInt(3, 7);
        const c = getRandomInt(2, 4);

        const fracPairs = [
            [3, 2], [5, 2], [7, 2], [9, 2],
            [5, 4], [7, 4], [9, 4], [11, 4],
            [6, 5], [7, 5], [8, 5], [9, 5]
        ];
        const pair = fracPairs[getRandomInt(0, fracPairs.length - 1)];
        const e = pair[0];
        const f = pair[1];

        const variant = getRandomInt(0, 1);
        let expr = '';
        if (variant === 0) {
            expr = '-' + a + ' ^ 2 + ' + b + ' ^ ' + c + ' ^ 0 - ' + e + ' / ' + f;
            p5Expected = -(a * a) + b - (e / f);
        } else {
            expr = '-' + a + ' ^ 2 + ' + b + ' ^ ' + c + ' ^ 0 + ' + e + ' / ' + f;
            p5Expected = -(a * a) + b + (e / f);
        }

        document.getElementById('p5-expr').textContent = expr;
        const inp = document.getElementById('p5-input');
        if (inp) inp.value = '';
    }

    function verifyPhase5() {
        if (isLocked) return;
        telemetry.markActivity();
        const val = parseDecimalInput(document.getElementById('p5-input').value);
        if (Number.isNaN(val)) {
            triggerErrorReset('Введите число (допускается десятичная запятая «,» или точка «.»)!', initPhase5);
            return;
        }
        if (Math.abs(val - p5Expected) > 1e-4) {
            triggerErrorReset('Ошибка в граничных правилах! Помните: -A ^ 2 = -(A²), а B ^ C ^ 0 = B ^ (C ^ 0) = B. Генерируется новое выражение...', initPhase5);
            return;
        }
        showSuccessFeedback('Кульминационная задача решена абсолютно точно!', completeLevel);
    }

    // =========================================================================
    // ОДНОКРАТНАЯ ПРИВЯЗКА СЛУШАТЕЛЕЙ СОБЫТИЙ
    // =========================================================================
    function bindAllEventsOnce() {
        const gameContainer = document.getElementById('game-container');

        gameContainer.addEventListener('paste', function(e) {
            if (e.target && e.target.tagName === 'INPUT') e.preventDefault();
        });
        gameContainer.addEventListener('drop', function(e) {
            if (e.target && e.target.tagName === 'INPUT') e.preventDefault();
        });

        gameContainer.addEventListener('keydown', function(e) {
            if (e.key !== 'Enter') return;
            const id = e.target && e.target.id;
            if (id === 'p1-input') verifyPhase1();
            else if (id === 'p2-input') verifyPhase2();
            else if (id === 'p3-input') verifyPhase3();
            else if (id === 'p4-input') verifyPhase4();
            else if (id === 'p5-input') verifyPhase5();
        });

        document.getElementById('p1-submit-btn').addEventListener('click', verifyPhase1);
        document.getElementById('p2-submit-btn').addEventListener('click', verifyPhase2);
        document.getElementById('p3-submit-btn').addEventListener('click', verifyPhase3);
        document.getElementById('p4-submit-btn').addEventListener('click', verifyPhase4);
        document.getElementById('p5-submit-btn').addEventListener('click', verifyPhase5);
    }

    bindAllEventsOnce();
    startTimer();
    initPhase1();
})();
</script>
