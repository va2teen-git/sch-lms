---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={2}>
    <div class="container my-4 font-monospace">
        <!-- Шапка тренажера -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h4 text-warning mb-0">Тренажер: Аналитические расчеты и трассировка (Уровень 2)</h2>
                <div class="text-secondary small">Урок 24 // Технологический профиль (углубленный курс)</div>
            </div>
            <span class="badge border border-warning text-warning bg-dark rounded-0 px-3 py-2">
                Ручной ввод // Zero Multiple Choice
            </span>
        </div>

        <div id="game-container" class="card bg-dark border-warning rounded-0 shadow">
            <div class="card-body p-4">

                <!-- Индикатор шагов и времени -->
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="level-badge" class="badge bg-warning text-dark rounded-0 fs-6 me-2">Шаг 1 из 5</span>
                        <span id="level-title" class="text-light fw-bold fs-6">Трассировка цикла и вариант цикла (Функция спуска)</span>
                    </div>
                    <div class="text-secondary small">
                        Ошибок: <span id="attempts-display" class="text-warning fw-bold">0</span> | 
                        Время: <span id="timer-display" class="text-info fw-bold">00:00</span>
                    </div>
                </div>

                <!-- Системный баннер ошибки / сброса -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between">
                        <span>
                            <strong>[ОШИБКА РАСЧЕТА]</strong> <span id="feedback-text">Неверное значение!</span> 
                            Регенерация параметров...
                        </span>
                        <div class="spinner-border spinner-border-sm text-danger" role="status"></div>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ФАЗА 1: Трассировка цикла и вариант цикла -->
                <!-- ========================================== -->
                <div id="phase1" class="phase-container">
                    <h5 class="text-warning mb-2">Шаг 1: Анализ завершаемости цикла через функцию спуска</h5>
                    <p class="text-light">
                        Для доказательства остановки алгоритма используется <strong>функция спуска (вариант цикла)</strong>: 
                        целочисленная величина, которая строго уменьшается на каждой итерации и ограничена снизу.
                        <br>
                        Изучите листинг микропрограммы целочисленного деления вычитанием:
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <pre class="text-light font-monospace mb-0"><span class="text-secondary"># Начальные регистры:</span>
a = <span id="p1-val-a" class="text-warning fw-bold"></span>
b = <span id="p1-val-b" class="text-info fw-bold"></span>
steps = 0

<span class="text-secondary"># Цикл с вариантом V = a:</span>
<span class="text-warning">while</span> a >= b:
    a = a - b
    steps = steps + 1</pre>
                    </div>

                    <p class="text-secondary small mb-2">
                        Выполните ручную трассировку. Сколько всего итераций (значение переменной <code class="text-warning">steps</code>) 
                        совершит программа до момента штатного останова? Введите целое число:
                    </p>

                    <div class="input-group mb-3" style="max-width: 420px;">
                        <input type="number" id="p1-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Количество шагов steps" autocomplete="off">
                        <button id="p1-btn" class="btn btn-outline-warning rounded-0 px-4 font-monospace fw-bold">ПРОВЕРИТЬ</button>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ФАЗА 2: Детектирование бесконечного цикла -->
                <!-- ========================================== -->
                <div id="phase2" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 2: Распознавание зацикливания через инвариант четности</h5>
                    <p class="text-light">
                        Проанализируйте представленный алгоритм на предмет зацикливания или остановки.
                        Если переменная смещается по четности или перескакивает терминальное значение, цикл никогда не завершится.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <pre class="text-light font-monospace mb-0"><span class="text-secondary"># Параметры потока управления:</span>
x = <span id="p2-val-start" class="text-warning fw-bold"></span>
step = <span id="p2-val-step" class="text-info fw-bold"></span>
target = <span id="p2-val-target" class="text-success fw-bold"></span>
iterations = 0

<span class="text-secondary"># Исполняемый цикл:</span>
<span class="text-warning">while</span> x != target:
    x = x + step
    iterations = iterations + 1</pre>
                    </div>

                    <p class="text-secondary small mb-2">
                        Сколько итераций совершит цикл до останова? 
                        <strong>Если цикл зациклится навсегда (Infinite Loop), введите число -1</strong>:
                    </p>

                    <div class="input-group mb-3" style="max-width: 420px;">
                        <input type="number" id="p2-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Число итераций или -1" autocomplete="off">
                        <button id="p2-btn" class="btn btn-outline-warning rounded-0 px-4 font-monospace fw-bold">ПРОВЕРИТЬ</button>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ФАЗА 3: Предикаты в парадоксе Тьюринга -->
                <!-- ========================================== -->
                <div id="phase3" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 3: Трассировка парадоксальной диагональной программы D</h5>
                    <p class="text-light">
                        В доказательстве Алана Тьюринга программа <strong>D</strong> опрашивает гипотетический анализатор <strong>H</strong> 
                        и совершает действие, противоположное его предсказанию.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <pre class="text-light font-monospace mb-0"><span class="text-warning">def</span> <span class="text-info">D</span>(P):
    <span class="text-secondary"># Опрос оракула останова:</span>
    <span class="text-warning">if</span> H(P, P) == <span class="text-success">True</span>:
        <span class="text-warning">while</span> <span class="text-success">True</span>:
            <span class="text-warning">pass</span>  <span class="text-danger"># Зацикливание [LOOP]</span>
    <span class="text-warning">else</span>:
        <span class="text-warning">return</span>        <span class="text-success"># Штатный останов [HALT]</span></pre>
                    </div>

                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">ТЕКУЩАЯ ГИПОТЕЗА АНАЛИЗАТОРА:</div>
                        <div class="fs-5 text-light">
                            Предположим, оракул вынес вердикт: <span id="p3-oracle-verdict" class="text-warning fw-bold"></span>
                        </div>
                    </div>

                    <p class="text-secondary small mb-2">
                        Какое фактическое действие совершит программа при вызове <code class="text-warning">D(D)</code>? 
                        Введите точный идентификатор поведения: <strong class="text-success">HALT</strong> (если остановится) 
                        или <strong class="text-danger">LOOP</strong> (если зациклится):
                    </p>

                    <div class="input-group mb-3" style="max-width: 420px;">
                        <input type="text" id="p3-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Введите HALT или LOOP" autocomplete="off">
                        <button id="p3-btn" class="btn btn-outline-warning rounded-0 px-4 font-monospace fw-bold">ПРОВЕРИТЬ</button>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ФАЗА 4: Конкатенация цепочки в ПСП Поста -->
                <!-- ========================================== -->
                <div id="phase4" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 4: Аналитическое решение частного случая ПСП Поста</h5>
                    <p class="text-light">
                        Дана упорядоченная система доминошек Поста над алфавитом символов. Для заданной последовательности индексов 
                        доминошек верхнее составное слово <code class="text-warning">U</code> в точности совпадает с нижним словом <code class="text-info">V</code>.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-2">НАБОР ДОМИНОШЕК:</div>
                        <div id="p4-tiles-display" class="d-flex gap-3 mb-3 font-monospace">
                            <!-- Генерируется JS -->
                        </div>
                        <div class="text-light border-top border-secondary pt-2">
                            Заданная последовательность номеров доминошек: 
                            <span id="p4-sequence-display" class="text-warning fw-bold fs-5"></span>
                        </div>
                    </div>

                    <p class="text-secondary small mb-2">
                        Выполните строковую конкатенацию. Введите результирующее итоговое слово (например, <code class="text-light">abab</code> или <code class="text-light">1010</code>):
                    </p>

                    <div class="input-group mb-3" style="max-width: 420px;">
                        <input type="text" id="p4-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Итоговое слово U === V" autocomplete="off">
                        <button id="p4-btn" class="btn btn-outline-warning rounded-0 px-4 font-monospace fw-bold">ПРОВЕРИТЬ</button>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ФАЗА 5: Метрики статического анализа -->
                <!-- ========================================== -->
                <div id="phase5" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 5: Практический компромисс теоремы Райса (Метрики SAST-анализатора)</h5>
                    <p class="text-light">
                        Так как идеальная автоматическая проверка кода невозможна по теореме Райса, статический анализатор кода 
                        вынужден идти на компромисс между ложными тревогами (<strong>False Positives</strong>) 
                        и пропущенными уязвимостями (<strong>False Negatives</strong>).
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-2">[СТАТИСТИКА СКАНИРОВАНИЯ КОДОВОЙ БАЗЫ]:</div>
                        <div class="row g-2 text-light font-monospace">
                            <div class="col-sm-6">
                                <div>Всего функций в проекте: <span id="p5-total-funcs" class="text-light fw-bold"></span></div>
                                <div>Реально содержат баги / уязвимости: <span id="p5-real-bugs" class="text-danger fw-bold"></span></div>
                            </div>
                            <div class="col-sm-6">
                                <div>Всего выдано предупреждений (Alerts): <span id="p5-total-alerts" class="text-warning fw-bold"></span></div>
                                <div>Из них подтвержденные баги (True Positives): <span id="p5-true-positives" class="text-success fw-bold"></span></div>
                            </div>
                        </div>
                    </div>

                    <p id="p5-task-question" class="text-light fw-bold mb-2">
                        <!-- Вопрос генерируется динамически -->
                    </p>

                    <div class="input-group mb-3" style="max-width: 420px;">
                        <input type="number" id="p5-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Введите целое число" autocomplete="off">
                        <button id="p5-btn" class="btn btn-outline-warning rounded-0 px-4 font-monospace fw-bold">ПРОВЕРИТЬ</button>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- ЭКРАН ПОБЕДЫ -->
                <!-- ========================================== -->
                <div id="victory-screen" class="d-none text-center py-5">
                    <div class="display-3 text-warning mb-3">✓</div>
                    <h3 class="h2 text-warning font-monospace mb-2">УРОВЕНЬ 2 УСПЕШНО ЗАВЕРШЕН!</h3>
                    <p class="text-light mb-4">
                        Вы успешно выполнили все аналитические расчеты, провели трассировку функции спуска, 
                        разрешили парадокс диагональной программы Тьюринга и рассчитали метрики статического анализа.
                    </p>

                    <div class="card bg-black border-warning rounded-0 d-inline-block p-4 mb-4 text-start font-monospace">
                        <div class="text-secondary small mb-2 border-bottom border-secondary pb-1">[ФИНАЛЬНЫЙ ПРОТОКОЛ ТЕЛЕМЕТРИИ]</div>
                        <div class="text-light mb-1">Статус миссии: <span class="text-warning fw-bold">COMPLETED</span></div>
                        <div class="text-light mb-1">Число ошибок / сбросов: <span id="final-attempts" class="text-warning">0</span></div>
                        <div class="text-light mb-1">Затраченное время: <span id="final-time" class="text-info">00:00</span></div>
                        <div class="text-light">Режим проверки: <span class="text-success">5 фаз ручного ввода OK</span></div>
                    </div>

                    <div>
                        <button id="btn-restart-level" class="btn btn-outline-warning rounded-0 px-4 py-2 font-monospace">
                            Пройти уровень заново
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(function() {
    let currentPhase = 1;
    let attemptsCount = 0;
    let startTime = Date.now();
    let timerInterval = null;
    let isLocked = false;

    // Таймер
    function startTimer() {
        if (timerInterval) clearInterval(timerInterval);
        timerInterval = setInterval(() => {
            const elapsed = Math.floor((Date.now() - startTime) / 1000);
            const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
            const secs = String(elapsed % 60).padStart(2, '0');
            const el = document.getElementById('timer-display');
            if (el) el.textContent = `${mins}:${secs}`;
        }, 1000);
    }
    startTimer();

    function updateAttemptsDisplay() {
        const el = document.getElementById('attempts-display');
        if (el) el.textContent = String(attemptsCount);
    }

    // Телеметрия: Ошибка / Сброс
    function triggerErrorReset(msg, callback) {
        attemptsCount++;
        updateAttemptsDisplay();
        isLocked = true;

        const fb = document.getElementById('feedback-box');
        const ft = document.getElementById('feedback-text');
        if (fb && ft) {
            ft.textContent = msg;
            fb.classList.remove('d-none');
        }

        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: 'Урок 24 :: Алгоритмически неразрешимые задачи. Задача останова (Уровень 2)',
            action_type: 'hardcore_reset'
        }, '*');

        setTimeout(() => {
            if (fb) fb.classList.add('d-none');
            isLocked = false;
            if (callback) callback();
        }, 1300);
    }

    // Телеметрия: Завершение уровня
    function completeLevel() {
        if (timerInterval) clearInterval(timerInterval);
        const elapsedSec = Math.floor((Date.now() - startTime) / 1000);
        const mins = String(Math.floor(elapsedSec / 60)).padStart(2, '0');
        const secs = String(elapsedSec % 60).padStart(2, '0');

        document.getElementById('phase5').classList.add('d-none');
        document.getElementById('victory-screen').classList.remove('d-none');
        document.getElementById('level-badge').textContent = 'Финиш';
        document.getElementById('level-title').textContent = 'Все 5 шагов успешно пройдены';

        document.getElementById('final-attempts').textContent = String(attemptsCount);
        document.getElementById('final-time').textContent = `${mins}:${secs}`;

        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: 'Урок 24 :: Алгоритмически неразрешимые задачи. Задача останова (Уровень 2)',
            action_type: 'level_complete',
            status: 'completed',
            start_time: new Date(startTime).toISOString(),
            time_spent_sec: elapsedSec,
            attempts_count: attemptsCount,
            success: true
        }, '*');
    }

    function randInt(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    // =========================================================================
    // ФАЗА 1: Трассировка цикла и вариант цикла (steps = a // b)
    // =========================================================================
    let p1Expected = 0;

    function initPhase1() {
        const valA = randInt(25, 85);
        const valB = randInt(4, 9);
        p1Expected = Math.floor(valA / valB);

        const aEl = document.getElementById('p1-val-a');
        const bEl = document.getElementById('p1-val-b');
        const inputEl = document.getElementById('p1-input');
        if (aEl) aEl.textContent = String(valA);
        if (bEl) bEl.textContent = String(valB);
        if (inputEl) {
            inputEl.value = '';
            inputEl.focus();
        }
    }

    function verifyPhase1() {
        if (isLocked) return;
        const inputEl = document.getElementById('p1-input');
        const userVal = parseInt(inputEl.value.trim(), 10);

        if (!isNaN(userVal) && userVal === p1Expected) {
            currentPhase = 2;
            document.getElementById('phase1').classList.add('d-none');
            document.getElementById('phase2').classList.remove('d-none');
            document.getElementById('level-badge').textContent = 'Шаг 2 из 5';
            document.getElementById('level-title').textContent = 'Распознавание зацикливания через инвариант';
            initPhase2();
        } else {
            triggerErrorReset('Неверное число итераций! Вариант цикла V = a уменьшается на b каждый шаг.', initPhase1);
        }
    }

    document.getElementById('p1-btn')?.addEventListener('click', verifyPhase1);
    document.getElementById('p1-input')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') verifyPhase1();
    });

    // =========================================================================
    // ФАЗА 2: Детектирование бесконечного цикла (инвариант четности)
    // =========================================================================
    let p2Expected = 0;

    function initPhase2() {
        const inputEl = document.getElementById('p2-input');
        if (inputEl) {
            inputEl.value = '';
            inputEl.focus();
        }

        const isInfinite = Math.random() < 0.5;

        if (isInfinite) {
            // Нечетный старт, шаг 2, четная цель -> бесконечный цикл!
            const startVal = randInt(1, 5) * 2 + 1; // 3, 5, 7, 9, 11
            const stepVal = 2;
            const targetVal = randInt(6, 15) * 2; // четное число больше старта
            p2Expected = -1;

            document.getElementById('p2-val-start').textContent = String(startVal);
            document.getElementById('p2-val-step').textContent = String(stepVal);
            document.getElementById('p2-val-target').textContent = String(targetVal);
        } else {
            // Завершающийся цикл
            const startVal = randInt(2, 6);
            const stepVal = randInt(2, 5);
            const steps = randInt(3, 8);
            const targetVal = startVal + stepVal * steps;
            p2Expected = steps;

            document.getElementById('p2-val-start').textContent = String(startVal);
            document.getElementById('p2-val-step').textContent = String(stepVal);
            document.getElementById('p2-val-target').textContent = String(targetVal);
        }
    }

    function verifyPhase2() {
        if (isLocked) return;
        const inputEl = document.getElementById('p2-input');
        const userVal = parseInt(inputEl.value.trim(), 10);

        if (!isNaN(userVal) && userVal === p2Expected) {
            currentPhase = 3;
            document.getElementById('phase2').classList.add('d-none');
            document.getElementById('phase3').classList.remove('d-none');
            document.getElementById('level-badge').textContent = 'Шаг 3 из 5';
            document.getElementById('level-title').textContent = 'Трассировка парадоксальной программы Тьюринга';
            initPhase3();
        } else {
            triggerErrorReset('Неверная оценка завершаемости! Обратите внимание на четность чисел или перескок цели.', initPhase2);
        }
    }

    document.getElementById('p2-btn')?.addEventListener('click', verifyPhase2);
    document.getElementById('p2-input')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') verifyPhase2();
    });

    // =========================================================================
    // ФАЗА 3: Предикаты в парадоксе Тьюринга (D(P) на H(P, P))
    // =========================================================================
    let p3Expected = '';

    function initPhase3() {
        const inputEl = document.getElementById('p3-input');
        if (inputEl) {
            inputEl.value = '';
            inputEl.focus();
        }

        const isTrue = Math.random() < 0.5;
        const oracleEl = document.getElementById('p3-oracle-verdict');

        if (isTrue) {
            // H(D, D) == True -> программа D уходит в while True: pass (LOOP)
            if (oracleEl) oracleEl.textContent = 'H(D, D) == True (Оракул утверждает: D(D) остановится)';
            p3Expected = 'LOOP';
        } else {
            // H(D, D) == False -> программа D выполняет return (HALT)
            if (oracleEl) oracleEl.textContent = 'H(D, D) == False (Оракул утверждает: D(D) зациклится)';
            p3Expected = 'HALT';
        }
    }

    function verifyPhase3() {
        if (isLocked) return;
        const inputEl = document.getElementById('p3-input');
        const userVal = inputEl.value.trim().toUpperCase();

        if (userVal === p3Expected || (p3Expected === 'LOOP' && userVal === 'ЦИКЛ') || (p3Expected === 'HALT' && userVal === 'ОСТАНОВ')) {
            currentPhase = 4;
            document.getElementById('phase3').classList.add('d-none');
            document.getElementById('phase4').classList.remove('d-none');
            document.getElementById('level-badge').textContent = 'Шаг 4 из 5';
            document.getElementById('level-title').textContent = 'Конкатенация цепочки в ПСП Поста';
            initPhase4();
        } else {
            triggerErrorReset('Ошибка в анализе парадокса! Программа D сконструирована так, чтобы действовать противоположно H.', initPhase3);
        }
    }

    document.getElementById('p3-btn')?.addEventListener('click', verifyPhase3);
    document.getElementById('p3-input')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') verifyPhase3();
    });

    // =========================================================================
    // ФАЗА 4: Конкатенация цепочки в ПСП Поста
    // =========================================================================
    const PCP_LEVEL2_SETS = [
        {
            tiles: [
                { num: 1, top: 'a', bottom: 'ab' },
                { num: 2, top: 'b', bottom: 'a' },
                { num: 3, top: 'ab', bottom: 'b' }
            ],
            sequence: [1, 2, 3],
            expectedWord: 'abab'
        },
        {
            tiles: [
                { num: 1, top: 'b', bottom: 'ba' },
                { num: 2, top: 'a', bottom: 'b' },
                { num: 3, top: 'ba', bottom: 'a' }
            ],
            sequence: [1, 2, 3],
            expectedWord: 'baba'
        },
        {
            tiles: [
                { num: 1, top: '1', bottom: '10' },
                { num: 2, top: '0', bottom: '1' },
                { num: 3, top: '10', bottom: '0' }
            ],
            sequence: [1, 2, 3],
            expectedWord: '1010'
        },
        {
            tiles: [
                { num: 1, top: 'a', bottom: 'ab' },
                { num: 2, top: 'ba', bottom: 'a' }
            ],
            sequence: [1, 2],
            expectedWord: 'aba'
        }
    ];

    let p4Expected = '';

    function initPhase4() {
        const inputEl = document.getElementById('p4-input');
        if (inputEl) {
            inputEl.value = '';
            inputEl.focus();
        }

        const chosen = PCP_LEVEL2_SETS[randInt(0, PCP_LEVEL2_SETS.length - 1)];
        p4Expected = chosen.expectedWord;

        const tilesDisplayEl = document.getElementById('p4-tiles-display');
        const seqDisplayEl = document.getElementById('p4-sequence-display');

        if (tilesDisplayEl) {
            tilesDisplayEl.innerHTML = '';
            chosen.tiles.forEach(t => {
                const card = document.createElement('div');
                card.className = 'card bg-black border border-secondary p-2 text-center';
                card.style.width = '100px';
                card.innerHTML = `
                    <div class="text-secondary small mb-1">№${t.num}</div>
                    <div class="text-warning fw-bold border-bottom border-secondary pb-1">${t.top}</div>
                    <div class="text-info fw-bold pt-1">${t.bottom}</div>
                `;
                tilesDisplayEl.appendChild(card);
            });
        }

        if (seqDisplayEl) {
            seqDisplayEl.textContent = `[ ${chosen.sequence.map(n => '№' + n).join(' ➔ ')} ]`;
        }
    }

    function verifyPhase4() {
        if (isLocked) return;
        const inputEl = document.getElementById('p4-input');
        const userVal = inputEl.value.trim().toLowerCase();

        if (userVal === p4Expected) {
            currentPhase = 5;
            document.getElementById('phase4').classList.add('d-none');
            document.getElementById('phase5').classList.remove('d-none');
            document.getElementById('level-badge').textContent = 'Шаг 5 из 5';
            document.getElementById('level-title').textContent = 'Расчет метрик статического анализа (False Positives/Negatives)';
            initPhase5();
        } else {
            triggerErrorReset('Слово не совпало! Проверьте конкатенацию верхних половинок: u1 + u2 + u3.', initPhase4);
        }
    }

    document.getElementById('p4-btn')?.addEventListener('click', verifyPhase4);
    document.getElementById('p4-input')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') verifyPhase4();
    });

    // =========================================================================
    // ФАЗА 5: Метрики статического анализа (FP и FN)
    // =========================================================================
    let p5Expected = 0;

    function initPhase5() {
        const inputEl = document.getElementById('p5-input');
        if (inputEl) {
            inputEl.value = '';
            inputEl.focus();
        }

        const totalFuncs = randInt(800, 2500);
        const realBugs = randInt(35, 75);
        const truePositives = randInt(20, realBugs - 5);
        const falsePositives = randInt(15, 45);
        const totalAlerts = truePositives + falsePositives;
        const falseNegatives = realBugs - truePositives;

        document.getElementById('p5-total-funcs').textContent = String(totalFuncs);
        document.getElementById('p5-real-bugs').textContent = String(realBugs);
        document.getElementById('p5-total-alerts').textContent = String(totalAlerts);
        document.getElementById('p5-true-positives').textContent = String(truePositives);

        const askForFP = Math.random() < 0.5;
        const qEl = document.getElementById('p5-task-question');

        if (askForFP) {
            p5Expected = falsePositives;
            if (qEl) {
                qEl.innerHTML = 'Задание: Вычислите количество <span class="text-warning">ЛОЖНЫХ ТРЕВОГ (False Positives)</span> — предупреждений анализатора, выданных на чистый безопасный код:';
            }
        } else {
            p5Expected = falseNegatives;
            if (qEl) {
                qEl.innerHTML = 'Задание: Вычислите количество <span class="text-danger">ПРОПУЩЕННЫХ БАГОВ (False Negatives)</span> — реальных уязвимостей, которые анализатор пропустил и не обнаружил:';
            }
        }
    }

    function verifyPhase5() {
        if (isLocked) return;
        const inputEl = document.getElementById('p5-input');
        const userVal = parseInt(inputEl.value.trim(), 10);

        if (!isNaN(userVal) && userVal === p5Expected) {
            completeLevel();
        } else {
            triggerErrorReset('Неверный расчет метрики! FP = Alerts - TP; FN = RealBugs - TP.', initPhase5);
        }
    }

    document.getElementById('p5-btn')?.addEventListener('click', verifyPhase5);
    document.getElementById('p5-input')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') verifyPhase5();
    });

    // Кнопка перезапуска уровня
    document.getElementById('btn-restart-level')?.addEventListener('click', () => {
        currentPhase = 1;
        attemptsCount = 0;
        startTime = Date.now();
        startTimer();
        updateAttemptsDisplay();

        document.getElementById('victory-screen').classList.add('d-none');
        document.getElementById('phase1').classList.remove('d-none');
        document.getElementById('phase2').classList.add('d-none');
        document.getElementById('phase3').classList.add('d-none');
        document.getElementById('phase4').classList.add('d-none');
        document.getElementById('phase5').classList.add('d-none');
        document.getElementById('level-badge').textContent = 'Шаг 1 из 5';
        document.getElementById('level-title').textContent = 'Трассировка цикла и вариант цикла (Функция спуска)';

        initPhase1();
    });

    // Запуск первой фазы
    initPhase1();
})();
</script>
