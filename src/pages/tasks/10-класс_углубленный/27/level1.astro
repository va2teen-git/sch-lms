---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={1}>
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Шапка тренажера -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 text-success mb-0">Тренажер: Непрерывные и дискретные величины и сигналы (Уровень 1)</h2>
            <span class="badge border border-success text-success bg-dark rounded-0 px-3 py-2">Манипуляция мышью // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-success rounded-0">
            <div class="card-body p-3 p-md-4">

                <!-- Заголовок и индикатор прогресса -->
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="phase-badge" class="badge bg-success text-dark rounded-0 fs-6 me-2">Шаг 1 из 3</span>
                        <span id="phase-title" class="text-light fw-bold fs-6">Классификация сущностей: непрерывные и дискретные величины и сигналы</span>
                    </div>
                    <div class="text-secondary small">
                        Попытки: <span id="attempts-display" class="text-warning">0</span> | Время: <span id="timer-display" class="text-info">00:00</span>
                    </div>
                </div>

                <!-- Системный баннер ошибки / сброса -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between">
                        <span>[СИСТЕМНЫЙ СБОЙ] <span id="feedback-text">Неверная конфигурация!</span> Перегенерация варианта...</span>
                        <span class="spinner-border spinner-border-sm text-danger" role="status"></span>
                    </div>
                </div>

                <!-- ==================== ФАЗА 1: КЛАССИФИКАЦИЯ СУЩНОСТЕЙ (DRAG-TO-BUCKET) ==================== -->
                <div id="phase1" class="phase-container">
                    <p class="text-light mb-3">
                        В измерительный шлюз поступил поток параметров и процессов.
                        Используя мышь, <strong>перетащите каждую карточку</strong> (или кликните по карточке, затем по контейнеру) в соответствующий класс согласно теории К. Ю. Полякова.
                    </p>

                    <!-- Пул карточек Фазы 1 -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary small">ВХОДНОЙ ПОТОК ОБЪЕКТОВ (ПЕРЕТАЩИТЕ В ЦЕЛЕВЫЕ КОНТЕЙНЕРЫ):</span>
                            <button id="p1-reset-btn" type="button" class="btn btn-sm btn-outline-secondary rounded-0 text-secondary">
                                Сбросить в пул
                            </button>
                        </div>
                        <div id="p1-cards-pool" class="d-flex flex-wrap gap-2 p-2 border border-dashed border-secondary bg-dark min-vh-10">
                            <!-- Карточки генерируются динамически через JS -->
                        </div>
                    </div>

                    <!-- 4 целевых контейнера Фазы 1 -->
                    <div class="row g-2 mb-3">
                        <!-- Бакет 1: Непрерывная величина -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-secondary rounded-0 h-100 target-bucket-p1" data-category="cont_val" id="bucket-cont-val">
                                <div class="card-header bg-dark border-bottom border-secondary text-light d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold small">1. НЕПРЕРЫВНАЯ ВЕЛИЧИНА</span>
                                    <span class="badge border border-secondary text-light bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Физическое свойство (мощность континуума ℝ). Принимает любые промежуточные дробные значения.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-secondary bg-dark d-flex flex-column gap-2" style="min-height: 140px;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Бакет 2: Дискретная величина -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-info rounded-0 h-100 target-bucket-p1" data-category="disc_val" id="bucket-disc-val">
                                <div class="card-header bg-dark border-bottom border-info text-info d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold small">2. ДИСКРЕТНАЯ ВЕЛИЧИНА</span>
                                    <span class="badge border border-info text-info bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Количественная характеристика со счетным множеством неделимых квантованных значений (ℕ, ℤ).</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-info bg-dark d-flex flex-column gap-2" style="min-height: 140px;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Бакет 3: Непрерывный сигнал -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-warning rounded-0 h-100 target-bucket-p1" data-category="cont_sig" id="bucket-cont-sig">
                                <div class="card-header bg-dark border-bottom border-warning text-warning d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold small">3. АНАЛОГОВЫЙ СИГНАЛ</span>
                                    <span class="badge border border-warning text-warning bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Физический волновой процесс s(t), непрерывно изменяющийся во времени и по амплитуде.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-warning bg-dark d-flex flex-column gap-2" style="min-height: 140px;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Бакет 4: Цифровой сигнал -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-success rounded-0 h-100 target-bucket-p1" data-category="disc_sig" id="bucket-disc-sig">
                                <div class="card-header bg-dark border-bottom border-success text-success d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold small">4. ЦИФРОВОЙ СИГНАЛ</span>
                                    <span class="badge border border-success text-success bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Последовательность дискретных отсчетов по времени и уровню, закодированных в двоичном виде.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-success bg-dark d-flex flex-column gap-2" style="min-height: 140px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p1-verify-btn" type="button" class="btn btn-success rounded-0 px-4 py-2 font-monospace fw-bold">
                            ВЕРИФИЦИРОВАТЬ КЛАССИФИКАЦИЮ →
                        </button>
                    </div>
                </div>

                <!-- ==================== ФАЗА 2: ТРАКТ ОЦИФРОВКИ И СИНТЕЗА АЦП/ЦАП (SLOT & SNAP) ==================== -->
                <div id="phase2" class="phase-container d-none">
                    <p class="text-light mb-3">
                        Соберите функциональную схему <strong>аппаратного тракта оцифровки (АЦП) и восстановления (ЦАП)</strong>.
                        Перетащите блоки из палитры (или кликните по блоку, затем по целевому слоту) в строгой последовательности преобразований от 1 до 6. Остерегайтесь ложных дистракторов!
                    </p>

                    <!-- Пул доступных блоков Фазы 2 -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary small">ДОСТУПНЫЕ ФУНКЦИОНАЛЬНЫЕ МОДУЛИ (ПЕРЕТАЩИТЕ В СЛОТЫ ТРАКТА):</span>
                            <button id="p2-reset-btn" type="button" class="btn btn-sm btn-outline-secondary rounded-0 text-secondary">
                                Сбросить в пул
                            </button>
                        </div>
                        <div id="p2-blocks-pool" class="d-flex flex-wrap gap-2 p-2 border border-dashed border-secondary bg-dark min-vh-10">
                            <!-- Блоки генерируются динамически через JS -->
                        </div>
                    </div>

                    <!-- Целевые слоты схемы Фазы 2 -->
                    <div class="card bg-black border-success rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-2">ТРАКТ АНАЛОГО-ЦИФРОВОГО И ЦИФРО-АНАЛОГОВОГО ПРЕОБРАЗОВАНИЯ (УЗЛЫ 1–6):</div>
                        <div class="row g-2">
                            <!-- Слот 1 -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark h-100" data-step="1">
                                    <div class="text-secondary small mb-1 fw-bold text-success">УЗЕЛ 1: ИСТОЧНИК СИГНАЛА</div>
                                    <div class="pipeline-slot p-2 border border-dashed border-success bg-black d-flex align-items-center" style="min-height: 64px;" data-slot="1">
                                        <span class="text-secondary small placeholder-text">Перетащите сюда модуль узла 1...</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Слот 2 -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark h-100" data-step="2">
                                    <div class="text-secondary small mb-1 fw-bold text-info">УЗЕЛ 2: АНТИАЛИАСИНГОВАЯ ФИЛЬТРАЦИЯ</div>
                                    <div class="pipeline-slot p-2 border border-dashed border-info bg-black d-flex align-items-center" style="min-height: 64px;" data-slot="2">
                                        <span class="text-secondary small placeholder-text">Перетащите сюда модуль узла 2...</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Слот 3 -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark h-100" data-step="3">
                                    <div class="text-secondary small mb-1 fw-bold text-warning">УЗЕЛ 3: СТРОБИРОВАНИЕ ВО ВРЕМЕНИ</div>
                                    <div class="pipeline-slot p-2 border border-dashed border-warning bg-black d-flex align-items-center" style="min-height: 64px;" data-slot="3">
                                        <span class="text-secondary small placeholder-text">Перетащите сюда модуль узла 3...</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Слот 4 -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark h-100" data-step="4">
                                    <div class="text-secondary small mb-1 fw-bold text-primary">УЗЕЛ 4: КВАНТОВАНИЕ И ДВОИЧНОЕ КОДИРОВАНИЕ</div>
                                    <div class="pipeline-slot p-2 border border-dashed border-primary bg-black d-flex align-items-center" style="min-height: 64px;" data-slot="4">
                                        <span class="text-secondary small placeholder-text">Перетащите сюда модуль узла 4...</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Слот 5 -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark h-100" data-step="5">
                                    <div class="text-secondary small mb-1 fw-bold text-danger">УЗЕЛ 5: ЦИФРОВАЯ ОБРАБОТКА И ПАМЯТЬ</div>
                                    <div class="pipeline-slot p-2 border border-dashed border-danger bg-black d-flex align-items-center" style="min-height: 64px;" data-slot="5">
                                        <span class="text-secondary small placeholder-text">Перетащите сюда модуль узла 5...</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Слот 6 -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark h-100" data-step="6">
                                    <div class="text-secondary small mb-1 fw-bold text-success">УЗЕЛ 6: ЦАП И СИНТЕЗ НЕПРЕРЫВНОГО СИГНАЛА</div>
                                    <div class="pipeline-slot p-2 border border-dashed border-success bg-black d-flex align-items-center" style="min-height: 64px;" data-slot="6">
                                        <span class="text-secondary small placeholder-text">Перетащите сюда модуль узла 6...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p2-verify-btn" type="button" class="btn btn-success rounded-0 px-4 py-2 font-monospace fw-bold">
                            ЗАПУСТИТЬ ТРАКТ АЦП/ЦАП →
                        </button>
                    </div>
                </div>

                <!-- ==================== ФАЗА 3: КОММУТАЦИЯ И КАЛИБРОВКА ПАРАМЕТРОВ (CALIBRATION) ==================== -->
                <div id="phase3" class="phase-container d-none">
                    <p class="text-light mb-3">
                        Инженерная калибровка тракта: на основе <strong>теоремы Котельникова (f<sub>d</sub> ≥ 2 × f<sub>max</sub>)</strong>, 
                        разрядности квантования (правило 6 дБ на бит) и специфики датчиков сопоставьте каждому измерительному сценарию оптимальный калиброванный цифровой модуль.
                    </p>

                    <!-- Пул доступных модулей Фазы 3 -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary small">КАЛИБРОВАННЫЕ ЦИФРОВЫЕ МОДУЛИ (ПЕРЕТАЩИТЕ В СООТВЕТСТВУЮЩИЕ СЦЕНАРИИ):</span>
                            <button id="p3-reset-btn" type="button" class="btn btn-sm btn-outline-secondary rounded-0 text-secondary">
                                Сбросить в пул
                            </button>
                        </div>
                        <div id="p3-modules-pool" class="d-flex flex-wrap gap-2 p-2 border border-dashed border-secondary bg-dark min-vh-10">
                            <!-- Модули генерируются динамически через JS -->
                        </div>
                    </div>

                    <!-- 4 сценария Фазы 3 -->
                    <div class="row g-2 mb-3">
                        <!-- Сценарий 1 -->
                        <div class="col-12 col-md-6">
                            <div class="scenario-card p-3 border border-secondary bg-dark h-100" data-scenario="telephony">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-secondary text-light rounded-0">СЦЕНАРИЙ А</span>
                                    <span class="text-info small fw-bold">ГОЛОСОВАЯ ТЕЛЕФОНИЯ (G.711)</span>
                                </div>
                                <p class="text-secondary small mb-2">
                                    Полоса частот человеческой речи 300–3400 Гц (f<sub>max</sub> = 3,4 кГц). Требуемый динамический диапазон SQNR ≈ 48 дБ.
                                </p>
                                <div class="scenario-slot p-2 border border-dashed border-secondary bg-black d-flex align-items-center" style="min-height: 56px;" data-target="telephony">
                                    <span class="text-secondary small placeholder-text">Установите калиброванный модуль для телефонии...</span>
                                </div>
                            </div>
                        </div>

                        <!-- Сценарий 2 -->
                        <div class="col-12 col-md-6">
                            <div class="scenario-card p-3 border border-secondary bg-dark h-100" data-scenario="audiocd">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-secondary text-light rounded-0">СЦЕНАРИЙ Б</span>
                                    <span class="text-warning small fw-bold">МУЗЫКАЛЬНЫЙ AUDIO CD (RED BOOK)</span>
                                </div>
                                <p class="text-secondary small mb-2">
                                    Полный звуковой спектр слуха человека до 20 кГц (f<sub>max</sub> = 20 кГц). Требуемый динамический диапазон SQNR ≈ 96 дБ.
                                </p>
                                <div class="scenario-slot p-2 border border-dashed border-secondary bg-black d-flex align-items-center" style="min-height: 56px;" data-target="audiocd">
                                    <span class="text-secondary small placeholder-text">Установите калиброванный модуль для Audio CD...</span>
                                </div>
                            </div>
                        </div>

                        <!-- Сценарий 3 -->
                        <div class="col-12 col-md-6">
                            <div class="scenario-card p-3 border border-secondary bg-dark h-100" data-scenario="seismic">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-secondary text-light rounded-0">СЦЕНАРИЙ В</span>
                                    <span class="text-success small fw-bold">ПРЕЦИЗИОННЫЙ СЕЙСМОГРАФ</span>
                                </div>
                                <p class="text-secondary small mb-2">
                                    Низкочастотные сейсмические колебания земной коры до 100 Гц (f<sub>max</sub> = 100 Гц). Сверхвысокий динамический диапазон SQNR ≈ 144 дБ.
                                </p>
                                <div class="scenario-slot p-2 border border-dashed border-secondary bg-black d-flex align-items-center" style="min-height: 56px;" data-target="seismic">
                                    <span class="text-secondary small placeholder-text">Установите калиброванный модуль для сейсмографа...</span>
                                </div>
                            </div>
                        </div>

                        <!-- Сценарий 4 -->
                        <div class="col-12 col-md-6">
                            <div class="scenario-card p-3 border border-secondary bg-dark h-100" data-scenario="encoder">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-secondary text-light rounded-0">СЦЕНАРИЙ Г</span>
                                    <span class="text-primary small fw-bold">ОПТИЧЕСКИЙ ЭНКОДЕР УГЛА ВАЛА</span>
                                </div>
                                <p class="text-secondary small mb-2">
                                    Прецизионный датчик углового положения вала робота. Защита от динамических ложных кодовых состояний на стыке соседних секторов.
                                </p>
                                <div class="scenario-slot p-2 border border-dashed border-secondary bg-black d-flex align-items-center" style="min-height: 56px;" data-target="encoder">
                                    <span class="text-secondary small placeholder-text">Установите калиброванный модуль для энкодера...</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p3-verify-btn" type="button" class="btn btn-success rounded-0 px-4 py-2 font-monospace fw-bold">
                            ВЕРИФИЦИРОВАТЬ КАЛИБРОВКУ ТРАКТА →
                        </button>
                    </div>
                </div>

                <!-- ==================== ЭКРАН ПОБЕДЫ ==================== -->
                <div id="victory-screen" class="d-none text-center py-5" data-testid="success-screen">
                    <div id="success-screen" class="card bg-black border-success rounded-0 p-4 mx-auto" style="max-width: 650px;">
                        <div class="display-5 text-success mb-2">МИССИЯ ВЫПОЛНЕНА!</div>
                        <p class="text-light fs-5 mb-4">
                            Аналого-цифровой тракт оцифровки и теорема Котельникова успешно освоены на базовом моторном уровне.
                        </p>
                        <div class="row g-2 mb-4 text-start font-monospace small">
                            <div class="col-6 p-2 bg-dark border border-secondary">
                                <span class="text-secondary">Чистое время:</span> <span id="res-time" class="text-info fw-bold">00:00</span>
                            </div>
                            <div class="col-6 p-2 bg-dark border border-secondary">
                                <span class="text-secondary">Ошибок/Сбоев:</span> <span id="res-attempts" class="text-warning fw-bold">0</span>
                            </div>
                            <div class="col-12 p-2 bg-dark border border-secondary">
                                <span class="text-secondary">Статус телеметрии:</span> <span class="text-success fw-bold">Уровень 1 сдан (Level Mastered)</span>
                            </div>
                        </div>
                        <div class="text-secondary small mb-0">
                            Данные телеметрии зафиксированы в аналитической базе. Переходите к Уровню 2 (Продвинутый аналитический расчет).
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(() => {
    // Состояние сессии
    let currentPhase = 1;
    let attemptsCount = 0;
    const startTime = Date.now();
    let timerInterval = null;
    let selectedItem = null; // Для click-to-move взаимодействия

    // Элементы интерфейса
    const attemptsDisplay = document.getElementById('attempts-display');
    const timerDisplay = document.getElementById('timer-display');
    const phaseBadge = document.getElementById('phase-badge');
    const phaseTitle = document.getElementById('phase-title');
    const feedbackBox = document.getElementById('feedback-box');
    const feedbackText = document.getElementById('feedback-text');

    // Таймер
    timerInterval = setInterval(() => {
        const sec = Math.floor((Date.now() - startTime) / 1000);
        const m = String(Math.floor(sec / 60)).padStart(2, '0');
        const s = String(sec % 60).padStart(2, '0');
        if (timerDisplay) timerDisplay.textContent = `${m}:${s}`;
    }, 1000);

    // Отправка телеметрии
    function sendTelemetry(actionType, successStatus, statusStr) {
        const payload = {
            type: 'TELEMETRY_EVENT',
            mission_name: 'Урок 27 :: Непрерывные и дискретные величины и сигналы (Уровень 1)',
            action_type: actionType,
