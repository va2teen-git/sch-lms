                    phaseBadge.textContent = 'Успех';
                }
                if (phaseTitle) phaseTitle.textContent = 'Уровень 1 полностью пройден!';

                const totalSec = Math.floor((Date.now() - startTime) / 1000);
                const m = String(Math.floor(totalSec / 60)).padStart(2, '0');
                const s = String(totalSec % 60).padStart(2, '0');
                const resTime = document.getElementById('res-time');
                const resAttempts = document.getElementById('res-attempts');
                if (resTime) resTime.textContent = `${m}:${s}`;
                if (resAttempts) resAttempts.textContent = attemptsCount;

                // Отправка победной телеметрии
                sendTelemetry('level_complete', true, 'completed');
            }
        });
    }

    // Инициализация при загрузке
    initPhase1();
})();
</script>
