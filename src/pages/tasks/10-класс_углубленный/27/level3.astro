                title: 'ФИНАЛЬНЫЙ БОСС: Аварийный суперсинтезатор АЦП',
                description: 'Симметричный широкополосный сигнал (-3.3...+3.3 В, f_max = 24 кГц) с мощной спектральной коллизией и паразитной наводкой 65 кГц. Требуется подавление алиасинга входным ФНЧ, глубина 24 бита и двухполярный код!',
                fmaxText: '24.0 кГц (Коллизия: 65 кГц!)',
                voltageSpan: '-3.3 В ... +3.3 В (Симметричный)',
                spectralStatus: 'КРИТИЧЕСКАЯ УГРОЗА: ВЧ коллизия 65 кГц!',
                hasNoise: true,
                sqnrText: 'SQNR ≥ 144 дБ (Hi-Res студия)',
                targetUnit1: 2, // Антиалиасинг + ФНЧ
                targetUnit2: 3, // 24 бита
                targetUnit3: 1, // Дополнительный код
                maxTime: 4.0,
                freqMultiplier: 4.2
