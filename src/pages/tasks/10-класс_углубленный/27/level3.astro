        ];

        createApp({
            data() {
                return {
                    gameState: 'intro',
                    currentPhase: 1,
                    currentTask: WAVE_DEFINITIONS[0],
                    maxPhaseTime: 8.5,
                    phaseTimeLeft: 8.5,
                    timerInterval: null,
                    clockAnimId: null,
                    oscAnimId: null,
                    
                    // Ритмический метроном
                    clockPhase: 0, // от 0.0 до 1.0
                    clockPeriodMs: 800, // 800 мс период такта
                    clockLastTime: performance.now(),
                    isApertureOpen: false,

                    // Выбранные параметры игрока
                    selectedUnit1: null,
                    selectedUnit2: null,
                    selectedUnit3: null,

                    // Метрики игры
                    combo: 0,
                    score: 0,
                    totalResets: 0,
                    failReason: '',
                    resetCountdown: 2,
                    resetInterval: null,
                    totalTimeText: '00:00',

                    // Опции селекторов
                    dividerOptions: [
                        { label: 'f_d = 2 × f_max (Критерий Котельникова)' },
                        { label: 'f_d = 4 × f_max (Оверсемплинг 4×)' },
                        { label: 'АКТИВАЦИЯ АНТИАЛИАСИНГА + ФНЧ' }
                    ],
                    quantizerOptions: [
                        { key: 'Q', label: '8 бит (SQNR ~ 48 дБ | 256 ур.)', bits: 8 },
                        { key: 'W', label: '12 бит (SQNR ~ 72 дБ | 4096 ур.)', bits: 12 },
                        { key: 'E', label: '16 бит (SQNR ~ 96 дБ | 65k ур.)', bits: 16 },
                        { key: 'R', label: '24 бита (SQNR ~ 144 дБ | 16.7M ур.)', bits: 24 }
                    ],
                    codecOptions: [
                        { key: 'A', label: 'Прямой двоичный (PCM | 0...+U)' },
                        { key: 'S', label: 'Дополнительный двухполярный (-U...+U)' },
                        { key: 'D', label: 'Код Грея (Датчики угла/положения)' }
                    ]
                };
            },

            computed: {
                formattedTime() {
                    return Math.max(0, this.phaseTimeLeft).toFixed(1);
                },
                selectedBits() {
                    if (this.selectedUnit2 === null) return 8;
                    return this.quantizerOptions[this.selectedUnit2].bits;
                }
            },

            mounted() {
                // Глобальный биндинг горячих клавиш
                window.addEventListener('keydown', this.handleKeyDown);
                // Запуск циклов анимации
                this.startClockLoop();
            },

            beforeUnmount() {
                window.removeEventListener('keydown', this.handleKeyDown);
                if (this.clockAnimId) cancelAnimationFrame(this.clockAnimId);
                if (this.oscAnimId) cancelAnimationFrame(this.oscAnimId);
                clearInterval(this.timerInterval);
                clearInterval(this.resetInterval);
            },

            methods: {
                handleKeyDown(e) {
                    if (this.gameState !== 'playing') {
                        if (this.gameState === 'intro' && (e.key === ' ' || e.key === 'Enter')) {
                            this.startGame();
                        } else if (this.gameState === 'failed' && (e.key === ' ' || e.key === 'Enter')) {
                            this.resetToWave1();
                        }
                        return;
                    }

                    const k = e.key.toLowerCase();
                    // Узел 1: 1, 2, 3
                    if (e.key === '1') this.selectUnit(1, 0);
                    else if (e.key === '2') this.selectUnit(1, 1);
                    else if (e.key === '3') this.selectUnit(1, 2);
                    
                    // Узел 2: Q, W, E, R (включая русскую раскладку)
                    else if (k === 'q' || k === 'й') this.selectUnit(2, 0);
                    else if (k === 'w' || k === 'ц') this.selectUnit(2, 1);
                    else if (k === 'e' || k === 'у') this.selectUnit(2, 2);
                    else if (k === 'r' || k === 'к') this.selectUnit(2, 3);
                    
                    // Узел 3: A, S, D (включая русскую раскладку)
                    else if (k === 'a' || k === 'ф') this.selectUnit(3, 0);
                    else if (k === 's' || k === 'ы') this.selectUnit(3, 1);
                    else if (k === 'd' || k === 'в') this.selectUnit(3, 2);
                    
                    // Строб: Пробел или Enter
                    else if (e.key === ' ' || e.key === 'Enter') {
                        e.preventDefault();
                        this.triggerStrobe();
                    }
                },

                selectUnit(unitNum, optIdx) {
                    playSound(440 + unitNum * 120 + optIdx * 60, 'sine', 0.05, 0.08);
                    if (unitNum === 1) this.selectedUnit1 = optIdx;
                    else if (unitNum === 2) this.selectedUnit2 = optIdx;
                    else if (unitNum === 3) this.selectedUnit3 = optIdx;
                },

                startClockLoop() {
                    const step = (timestamp) => {
                        const elapsed = timestamp - this.clockLastTime;
                        this.clockPhase = (elapsed % this.clockPeriodMs) / this.clockPeriodMs;
                        
                        // Апертурное окно: от 70% до 100% периода такта
                        const openNow = this.clockPhase >= 0.70 && this.clockPhase <= 1.00;
                        if (openNow && !this.isApertureOpen && this.gameState === 'playing') {
                            playSound(1200, 'triangle', 0.03, 0.03);
                        }
                        this.isApertureOpen = openNow;

                        this.clockAnimId = requestAnimationFrame(step);
                    };
                    this.clockAnimId = requestAnimationFrame(step);
                },

                startGame() {
                    this.gameState = 'playing';
                    this.currentPhase = 1;
                    this.combo = 0;
                    this.score = 0;
                    sessionStartTime = Date.now();
                    attemptsCount = 0;
                    this.loadWave(1);
                    this.$nextTick(() => {
                        this.startOscilloscopeLoop();
                    });
                },

                loadWave(phaseNum) {
                    this.currentPhase = phaseNum;
                    this.currentTask = WAVE_DEFINITIONS[phaseNum - 1];
                    this.maxPhaseTime = this.currentTask.maxTime;
                    this.phaseTimeLeft = this.maxPhaseTime;

                    // Сброс переключателей для проверки когнитивной реакции
                    this.selectedUnit1 = null;
                    this.selectedUnit2 = null;
                    this.selectedUnit3 = null;

                    clearInterval(this.timerInterval);
                    const dt = 0.1;
                    this.timerInterval = setInterval(() => {
                        this.phaseTimeLeft -= dt;
                        if (this.phaseTimeLeft <= 0) {
                            clearInterval(this.timerInterval);
                            this.handleFailure('Тайм-аут такта: сигнал рассеялся в аналоговом тракте до момента стробирования!');
                        }
                    }, dt * 1000);
                },

                triggerStrobe() {
                    if (this.gameState !== 'playing') return;

                    attemptsCount++;

                    // 1. Проверка фазового окна апертуры (Rhythm Window)
                    if (!this.isApertureOpen) {
                        this.handleFailure(`Фазовый джиттер! Строб произведен на фазе ${(this.clockPhase * 100).toFixed(0)}% вне апертурного окна (требуется 70%–100%)!`);
                        return;
                    }

                    // 2. Проверка Узла 1: Делитель частоты Котельникова
                    if (this.selectedUnit1 === null) {
                        this.handleFailure('Узел 1 не сконфигурирован! Не выставлен режим частоты дискретизации Котельникова.');
                        return;
                    }
                    if (this.selectedUnit1 !== this.currentTask.targetUnit1) {
                        if (this.currentTask.hasNoise && this.selectedUnit1 !== 2) {
                            this.handleFailure('Катастрофический алиасинг: высокочастотная помеха проникла в спектр из-за отключенного фильтра антиалиасинга!');
                        } else {
                            this.handleFailure('Нарушение теоремы Котельникова: неверно согласована частота оцифровки со спектром!');
                        }
                        return;
                    }

                    // 3. Проверка Узла 2: Квантователь и SQNR
                    if (this.selectedUnit2 === null) {
                        this.handleFailure('Узел 2 не сконфигурирован! Не выбрана разрядность квантователя.');
                        return;
                    }
                    if (this.selectedUnit2 !== this.currentTask.targetUnit2) {
                        this.handleFailure('Недопустимый шум квантования: динамический диапазон SQNR не соответствует требованиям тракта!');
                        return;
                    }

                    // 4. Проверка Узла 3: Кодер тракта
                    if (this.selectedUnit3 === null) {
                        this.handleFailure('Узел 3 не сконфигурирован! Не выбран схемотехнический кодер.');
                        return;
                    }
                    if (this.selectedUnit3 !== this.currentTask.targetUnit3) {
                        this.handleFailure('Коллизия кодирования: неверная полярность кода напряжения или отсутствие защиты от скачков бит!');
                        return;
                    }

                    // УСПЕШНОЕ СТРОБИРОВАНИЕ!
                    this.combo++;
                    const timeBonus = Math.round(this.phaseTimeLeft * 25);
                    const waveBonus = this.currentPhase * 100;
                    const comboBonus = this.combo * 50;
                    this.score += (waveBonus + timeBonus + comboBonus);

                    // Звуковой мажорный аккорд успеха
                    playSound(587.33, 'triangle', 0.1, 0.12);
                    setTimeout(() => playSound(880, 'sine', 0.18, 0.15), 60);

                    clearInterval(this.timerInterval);

                    if (this.currentPhase < 10) {
                        this.loadWave(this.currentPhase + 1);
                    } else {
                        // Победа на 10 волне!
                        this.gameState = 'success';
                        const totalSec = Math.floor((Date.now() - sessionStartTime) / 1000);
                        const m = String(Math.floor(totalSec / 60)).padStart(2, '0');
                        const s = String(totalSec % 60).padStart(2, '0');
                        this.totalTimeText = `${m}:${s}`;
                        sendTelemetry('level_complete', true, 'completed');
                        playSound(523.25, 'sine', 0.25, 0.2);
                        setTimeout(() => playSound(659.25, 'sine', 0.25, 0.2), 150);
                        setTimeout(() => playSound(783.99, 'sine', 0.25, 0.2), 300);
                        setTimeout(() => playSound(1046.50, 'sine', 0.4, 0.25), 450);
                    }
                },

                handleFailure(reason) {
                    clearInterval(this.timerInterval);
                    this.failReason = reason;
                    this.gameState = 'failed';
                    this.combo = 0;
                    this.totalResets++;

                    // Сирена аварии
                    playSound(160, 'sawtooth', 0.45, 0.25);
                    setTimeout(() => playSound(120, 'sawtooth', 0.5, 0.25), 200);

                    // Отправка hardcore_reset в телеметрию
                    sendTelemetry('hardcore_reset', false, 'in_progress');

                    // Автосброс через 2 секунды
                    this.resetCountdown = 2;
                    clearInterval(this.resetInterval);
                    this.resetInterval = setInterval(() => {
                        this.resetCountdown--;
                        if (this.resetCountdown <= 0) {
                            clearInterval(this.resetInterval);
                            this.resetToWave1();
                        }
                    }, 1000);
                },

                resetToWave1() {
                    clearInterval(this.resetInterval);
                    this.gameState = 'playing';
                    this.loadWave(1);
                    this.$nextTick(() => {
                        this.startOscilloscopeLoop();
                    });
                },

                startOscilloscopeLoop() {
                    const canvas = document.getElementById('osc-canvas');
                    if (!canvas) return;
                    const ctx = canvas.getContext('2d');
                    if (!ctx) return;

                    let t = 0;

                    const render = () => {
                        if (this.gameState !== 'playing') return;

                        const w = canvas.width;
                        const h = canvas.height;
                        ctx.fillStyle = '#05080c';
                        ctx.fillRect(0, 0, w, h);

                        // 1. Сетка осциллографа
                        ctx.strokeStyle = '#0e2634';
                        ctx.lineWidth = 1;
                        ctx.beginPath();
                        for (let x = 0; x < w; x += 40) {
                            ctx.moveTo(x, 0); ctx.lineTo(x, h);
                        }
                        for (let y = 0; y < h; y += 30) {
                            ctx.moveTo(0, y); ctx.lineTo(w, y);
                        }
                        ctx.stroke();

                        // 2. Линии уровней квантования
                        const levelsCount = Math.min(32, Math.pow(2, this.selectedBits));
                        const stepY = h / levelsCount;
                        ctx.strokeStyle = '#1b3244';
                        ctx.lineWidth = 0.5;
                        ctx.setLineDash([2, 4]);
                        ctx.beginPath();
                        for (let l = 1; l < levelsCount; l++) {
                            const y = l * stepY;
                            ctx.moveTo(0, y);
                            ctx.lineTo(w, y);
                        }
                        ctx.stroke();
                        ctx.setLineDash([]);

                        // 3. Центральная нулевая ось
                        ctx.strokeStyle = '#2a4a60';
                        ctx.lineWidth = 1.5;
                        ctx.beginPath();
                        ctx.moveTo(0, h / 2);
                        ctx.lineTo(w, h / 2);
                        ctx.stroke();

                        // 4. Отрисовка непрерывного аналогового сигнала
                        t += 0.035;
                        const freqMult = this.currentTask.freqMultiplier || 1.0;
                        const hasNoise = this.currentTask.hasNoise && this.selectedUnit1 !== 2;

                        ctx.strokeStyle = hasNoise ? '#ff3344' : '#00e5ff';
                        ctx.lineWidth = 2.5;
                        ctx.beginPath();

                        for (let x = 0; x < w; x++) {
                            const phase = (x / w) * Math.PI * 4 * freqMult + t;
                            let yNorm = Math.sin(phase) * 0.4;
                            // Вторая гармоника
                            yNorm += Math.sin(phase * 2.3) * 0.15;
                            // Высокочастотный шум алиасинга
                            if (hasNoise) {
                                yNorm += (Math.sin(phase * 18.0) * 0.2 + (Math.random() - 0.5) * 0.1);
                            }
                            const y = (h / 2) - yNorm * (h * 0.42);
                            if (x === 0) ctx.moveTo(x, y);
                            else ctx.lineTo(x, y);
                        }
                        ctx.stroke();

                        // 5. Дискретные точки стробирования (Strobe Samples)
                        const sampleInterval = 40;
                        ctx.fillStyle = '#ffcc00';
                        ctx.strokeStyle = '#ffcc00';
                        ctx.lineWidth = 1.5;

                        for (let x = 20; x < w; x += sampleInterval) {
                            const phase = (x / w) * Math.PI * 4 * freqMult + t;
                            let yNorm = Math.sin(phase) * 0.4 + Math.sin(phase * 2.3) * 0.15;
                            if (hasNoise) {
                                yNorm += Math.sin(phase * 18.0) * 0.2;
                            }
                            // Квантование по уровню
                            const rawY = (h / 2) - yNorm * (h * 0.42);
                            const qIdx = Math.round(rawY / stepY);
                            const quantY = qIdx * stepY;

                            // Ножка отсчета (Stem line)
                            ctx.beginPath();
                            ctx.moveTo(x, h / 2);
                            ctx.lineTo(x, quantY);
                            ctx.stroke();

                            // Точка квантованного отсчета
                            ctx.beginPath();
                            ctx.arc(x, quantY, 3.5, 0, Math.PI * 2);
                            ctx.fill();
                        }

                        // 6. Вертикальный сканирующий луч стробирования
                        const strobeX = this.clockPhase * w;
                        ctx.strokeStyle = this.isApertureOpen ? '#00ff66' : '#ff3344';
                        ctx.lineWidth = 2;
                        ctx.beginPath();
                        ctx.moveTo(strobeX, 0);
                        ctx.lineTo(strobeX, h);
                        ctx.stroke();

                        // 7. Спектрограмма в углу осциллографа
                        const specX = w - 160;
                        const specY = 10;
                        const specW = 150;
                        const specH = 60;
                        ctx.fillStyle = 'rgba(0, 0, 0, 0.75)';
                        ctx.strokeStyle = '#334155';
                        ctx.fillRect(specX, specY, specW, specH);
                        ctx.strokeRect(specX, specY, specW, specH);

                        ctx.fillStyle = '#64748b';
                        ctx.font = '9px monospace';
                        ctx.fillText('FFT СПЕКТР', specX + 6, specY + 12);

                        // Гармоники
                        ctx.fillStyle = '#00e5ff';
                        ctx.fillRect(specX + 20, specY + specH - 30, 8, 28);
                        ctx.fillRect(specX + 45, specY + specH - 20, 8, 18);

                        // Граница Найквиста f_N
                        const nyquistX = specX + 90;
                        ctx.strokeStyle = '#ff3344';
                        ctx.lineWidth = 1;
                        ctx.setLineDash([2, 2]);
                        ctx.beginPath();
                        ctx.moveTo(nyquistX, specY);
                        ctx.lineTo(nyquistX, specY + specH);
                        ctx.stroke();
                        ctx.setLineDash([]);
                        ctx.fillStyle = '#ff3344';
                        ctx.fillText('f_N', nyquistX - 8, specY + 12);

                        // Паразитный пик шума за f_N
                        if (hasNoise) {
                            ctx.fillStyle = '#ff3344';
                            ctx.fillRect(specX + 115, specY + specH - 38, 8, 36);
                            ctx.fillText('АЛИАС!', specX + 105, specY + specH - 42);
                        }

                        this.oscAnimId = requestAnimationFrame(render);
                    };

                    this.oscAnimId = requestAnimationFrame(render);
                }
            }
        }).mount('#app');
    </script>
