---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={2}>
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Шапка тренажера -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 text-warning mb-0">Тренажер: Аналитические расчеты оцифровки сигналов и теоремы Котельникова (Уровень 2)</h2>
            <span class="badge border border-warning text-warning bg-dark rounded-0 px-3 py-2">Ручной ввод // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-warning rounded-0">
            <div class="card-body p-3 p-md-4">

                <!-- Заголовок и индикатор прогресса -->
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="phase-badge" class="badge bg-warning text-dark rounded-0 fs-6 me-2">Шаг 1 из 5</span>
                        <span id="phase-title" class="text-light fw-bold fs-6">Теорема Котельникова: минимальная частота f_d и шаг дискретизации Δt</span>
                    </div>
                    <div class="text-secondary small">
                        Ошибок: <span id="attempts-display" class="text-warning">0</span> | Время: <span id="timer-display" class="text-info">00:00</span>
                    </div>
                </div>

                <!-- Системный баннер ошибки / сброса -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between">
                        <span>[ОШИБКА РАСЧЕТА] <span id="feedback-text">Неверно вычисленное значение!</span> Перегенерация параметров...</span>
                        <span class="spinner-border spinner-border-sm text-danger" role="status"></span>
                    </div>
                </div>

                <!-- ==================== ФАЗА 1: ТЕОРЕМА КОТЕЛЬНИКОВА ==================== -->
                <div id="phase1" class="phase-container">
                    <h5 class="text-warning mb-2">Шаг 1: Расчет по теореме Котельникова (Найквиста — Шеннона)</h5>
                    <p class="text-light">
                        Для точной цифровой регистрации аналогового сигнала без потери гармонического состава спектр сигнала был аппаратно ограничен верхней частотой <strong>f<sub>max</sub></strong>.
                        На основе теоремы Котельникова (<strong>f<sub>d</sub> ≥ 2 × f<sub>max</sub></strong>) вычислите минимальную частоту дискретизации <strong>f<sub>d min</sub></strong> и максимально допустимый интервал между соседними замерами (шаг дискретизации) <strong>Δt<sub>max</sub> = 1 / f<sub>d min</sub></strong>.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="row g-2 text-light">
                            <div class="col-sm-6">
                                <span class="text-secondary small d-block">ВЕРХНЯЯ ГРАНИЦА СПЕКТРА (f<sub>max</sub>):</span>
                                <span id="p1-fmax" class="fs-4 text-light fw-bold">--</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-secondary small d-block">КРИТЕРИЙ ТОЧНОГО ВОССТАНОВЛЕНИЯ:</span>
                                <span class="fs-5 text-warning fw-bold">f<sub>d</sub> ≥ 2 × f<sub>max</sub> &nbsp;|&nbsp; Δt ≤ 1 / (2 × f<sub>max</sub>)</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3" style="max-width: 680px;">
                        <div class="col-sm-6">
                            <label for="p1-input-fd" class="form-label text-secondary small">Мин. частота дискретизации f<sub>d min</sub> (в Гц):</label>
                            <input type="number" id="p1-input-fd" class="form-control bg-black text-warning border-warning rounded-0" placeholder="f_d (Гц)" autocomplete="off">
                        </div>
                        <div class="col-sm-6">
                            <label id="p1-label-dt" for="p1-input-dt" class="form-label text-secondary small">Макс. шаг во времени Δt<sub>max</sub> (в мс):</label>
                            <input type="text" id="p1-input-dt" class="form-control bg-black text-warning border-warning rounded-0" placeholder="Δt" autocomplete="off">
                        </div>
                        <div class="col-12 d-flex justify-content-end">
                            <button id="p1-btn" type="button" class="btn btn-outline-warning rounded-0 px-4 fw-bold">ПРОВЕРИТЬ ШАГ 1 →</button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ФАЗА 2: ЧИСЛО УРОВНЕЙ И ШАГ КВАНТОВАНИЯ ==================== -->
                <div id="phase2" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 2: Уровни и шаг квантования аналого-цифрового преобразователя (АЦП)</h5>
                    <p class="text-light">
                        Входной каскад АЦП имеет рабочий диапазон напряжений от <strong>U<sub>min</sub></strong> до <strong>U<sub>max</sub></strong>.
                        Для оцифровки непрерывной амплитуды используется равномерный квантователь с разрядностью <strong>b</strong> бит.
                        Вычислите общее количество разрешенных уровней квантования <strong>N = 2<sup>b</sup></strong> и шаг квантования по напряжению <strong>ΔU = (U<sub>max</sub> - U<sub>min</sub>) / N</strong> (в милливольтах, мВ).
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="row g-2 text-light">
                            <div class="col-sm-4">
                                <span class="text-secondary small d-block">РАЗМАХ НАПРЯЖЕНИЯ (U<sub>span</sub>):</span>
                                <span id="p2-uspan" class="fs-4 text-light fw-bold">--</span>
                            </div>
                            <div class="col-sm-4">
                                <span class="text-secondary small d-block">РАЗРЯДНОСТЬ АЦП (b):</span>
                                <span id="p2-bits" class="fs-4 text-info fw-bold">--</span>
                            </div>
                            <div class="col-sm-4">
                                <span class="text-secondary small d-block">ФОРМУЛА КВАНТОВАНИЯ:</span>
                                <span class="fs-5 text-warning fw-bold">N = 2<sup>b</sup> &nbsp;|&nbsp; ΔU = U<sub>span</sub> / N</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3" style="max-width: 680px;">
                        <div class="col-sm-6">
                            <label for="p2-input-n" class="form-label text-secondary small">Число уровней квантования N = 2<sup>b</sup>:</label>
                            <input type="number" id="p2-input-n" class="form-control bg-black text-warning border-warning rounded-0" placeholder="Число N" autocomplete="off">
                        </div>
                        <div class="col-sm-6">
                            <label for="p2-input-du" class="form-label text-secondary small">Шаг квантования ΔU (в милливольтах, мВ):</label>
                            <input type="text" id="p2-input-du" class="form-control bg-black text-warning border-warning rounded-0" placeholder="ΔU (мВ)" autocomplete="off">
                        </div>
                        <div class="col-12 d-flex justify-content-end">
                            <button id="p2-btn" type="button" class="btn btn-outline-warning rounded-0 px-4 fw-bold">ПРОВЕРИТЬ ШАГ 2 →</button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ФАЗА 3: ПОГРЕШНОСТЬ И SQNR ==================== -->
                <div id="phase3" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 3: Погрешность квантования и отношение сигнал/шум (SQNR)</h5>
                    <p class="text-light">
                        При округлении непрерывного значения до ближайшего дискретного уровня возникает систематический шум квантования.
                        Зная шаг квантования <strong>ΔU</strong> и разрядность квантователя <strong>b</strong> бит, определите максимальную абсолютную погрешность квантования <strong>|e<sub>max</sub>| = ΔU / 2</strong> и теоретический динамический диапазон (отношение сигнал/шум) по правилу 6 дБ на бит: <strong>SQNR ≈ 6 × b</strong> (в децибелах, дБ).
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="row g-2 text-light">
                            <div class="col-sm-6">
                                <span class="text-secondary small d-block">ШАГ КВАНТОВАНИЯ (ΔU):</span>
                                <span id="p3-du" class="fs-4 text-light fw-bold">--</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-secondary small d-block">РАЗРЯДНОСТЬ КВАНТОВАТЕЛЯ (b):</span>
                                <span id="p3-bits" class="fs-4 text-info fw-bold">--</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3" style="max-width: 680px;">
                        <div class="col-sm-6">
                            <label for="p3-input-err" class="form-label text-secondary small">Макс. погрешность |e<sub>max</sub>| = ΔU / 2 (в мВ):</label>
                            <input type="text" id="p3-input-err" class="form-control bg-black text-warning border-warning rounded-0" placeholder="|e_max| (мВ)" autocomplete="off">
                        </div>
                        <div class="col-sm-6">
                            <label for="p3-input-sqnr" class="form-label text-secondary small">Отношение сигнал/шум SQNR = 6 × b (в дБ):</label>
                            <input type="number" id="p3-input-sqnr" class="form-control bg-black text-warning border-warning rounded-0" placeholder="SQNR (дБ)" autocomplete="off">
                        </div>
                        <div class="col-12 d-flex justify-content-end">
                            <button id="p3-btn" type="button" class="btn btn-outline-warning rounded-0 px-4 fw-bold">ПРОВЕРИТЬ ШАГ 3 →</button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ФАЗА 4: БИТРЕЙТ И ОБЪЕМ АУДИОДАННЫХ ==================== -->
                <div id="phase4" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 4: Расчет информационного битрейта и объема звуковых данных</h5>
                    <p class="text-light">
                        Звуковая дорожка оцифрована с частотой дискретизации <strong>f<sub>d</sub></strong> и глубиной кодирования <strong>b</strong> бит.
                        Вычислите скорость цифрового потока (битрейт) <strong>R = (f<sub>d</sub> × b × k) / 1000</strong> в <strong>кбит/с</strong> и итоговый информационный объем несжатого аудиофайла длительностью <strong>t</strong> секунд в <strong>Кбайтах</strong> (<code>I = (f<sub>d</sub> × b × k × t) / (8 × 1024)</code>).
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="row g-2 text-light">
                            <div class="col-sm-3">
                                <span class="text-secondary small d-block">ЧАСТОТА (f<sub>d</sub>):</span>
                                <span id="p4-fd" class="fs-4 text-light fw-bold">--</span>
                            </div>
                            <div class="col-sm-3">
                                <span class="text-secondary small d-block">РАЗРЯДНОСТЬ (b):</span>
                                <span id="p4-bits" class="fs-4 text-info fw-bold">--</span>
                            </div>
                            <div class="col-sm-3">
                                <span class="text-secondary small d-block">РЕЖИМ (КАНАЛЫ k):</span>
                                <span id="p4-mode" class="fs-4 text-warning fw-bold">--</span>
                            </div>
                            <div class="col-sm-3">
                                <span class="text-secondary small d-block">ДЛИТЕЛЬНОСТЬ (t):</span>
                                <span id="p4-time" class="fs-4 text-light fw-bold">--</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3" style="max-width: 680px;">
                        <div class="col-sm-6">
                            <label for="p4-input-rate" class="form-label text-secondary small">Битрейт потока R (в кбит/с):</label>
                            <input type="text" id="p4-input-rate" class="form-control bg-black text-warning border-warning rounded-0" placeholder="R (кбит/с)" autocomplete="off">
                        </div>
                        <div class="col-sm-6">
                            <label for="p4-input-vol" class="form-label text-secondary small">Объем несжатых данных (в Кбайтах):</label>
                            <input type="text" id="p4-input-vol" class="form-control bg-black text-warning border-warning rounded-0" placeholder="Объем (Кбайт)" autocomplete="off">
                        </div>
                        <div class="col-12 d-flex justify-content-end">
                            <button id="p4-btn" type="button" class="btn btn-outline-warning rounded-0 px-4 fw-bold">ПРОВЕРИТЬ ШАГ 4 →</button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ФАЗА 5: АЛИАСИНГ (НАРУШЕНИЕ КОТЕЛЬНИКОВА) ==================== -->
                <div id="phase5" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 5: Анализ нарушения теоремы Котельникова и расчет паразитного алиасинга</h5>
                    <p class="text-light">
                        На вход АЦП без антиалиасингового фильтра подан гармонический сигнал высокой частоты <strong>f<sub>сигнал</sub></strong>.
                        Частота дискретизации системы была установлена равной <strong>f<sub>d</sub></strong>, при этом условие Котельникова оказалось грубо нарушено (<strong>f<sub>d</sub> &lt; 2 × f<sub>сигнал</sub></strong>).
                        Вычислите предельную частоту Найквиста <strong>f<sub>N</sub> = f<sub>d</sub> / 2</strong> и определите паразитную частоту ложных биений (алиаса) <strong>f<sub>alias</sub> = |f<sub>сигнал</sub> - f<sub>d</sub>|</strong> (в кГц).
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="row g-2 text-light">
                            <div class="col-sm-6">
                                <span class="text-secondary small d-block">ФАКТИЧЕСКИЙ СИГНАЛ (f<sub>сигнал</sub>):</span>
                                <span id="p5-fsig" class="fs-4 text-danger fw-bold">--</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-secondary small d-block">ЧАСТОТА ДИСКРЕТИЗАЦИИ (f<sub>d</sub>):</span>
                                <span id="p5-fd" class="fs-4 text-info fw-bold">--</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3" style="max-width: 680px;">
                        <div class="col-sm-6">
                            <label for="p5-input-fn" class="form-label text-secondary small">Частота Найквиста f<sub>N</sub> = f<sub>d</sub> / 2 (в кГц):</label>
                            <input type="text" id="p5-input-fn" class="form-control bg-black text-warning border-warning rounded-0" placeholder="f_N (кГц)" autocomplete="off">
                        </div>
                        <div class="col-sm-6">
                            <label for="p5-input-alias" class="form-label text-secondary small">Паразитный алиас f<sub>alias</sub> = |f<sub>сигнал</sub> - f<sub>d</sub>| (в кГц):</label>
                            <input type="text" id="p5-input-alias" class="form-control bg-black text-warning border-warning rounded-0" placeholder="f_alias (кГц)" autocomplete="off">
                        </div>
                        <div class="col-12 d-flex justify-content-end">
                            <button id="p5-btn" type="button" class="btn btn-outline-warning rounded-0 px-4 fw-bold">ПРОВЕРИТЬ ШАГ 5 →</button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ЭКРАН ПОБЕДЫ ==================== -->
                <div id="victory-screen" class="d-none text-center py-5" data-testid="success-screen">
                    <div id="success-screen" class="card bg-black border-warning rounded-0 p-4 mx-auto" style="max-width: 650px;">
                        <div class="display-5 text-warning mb-2">АТТЕСТАЦИЯ ПРОЙДЕНА!</div>
                        <p class="text-light fs-5 mb-4">
                            Все аналитические расчеты дискретизации, квантования, динамического диапазона и спектрального алиасинга выполнены абсолютно верно.
                        </p>
                        <div class="row g-2 mb-4 text-start font-monospace small">
                            <div class="col-6 p-2 bg-dark border border-secondary">
                                <span class="text-secondary">Чистое время:</span> <span id="res-time" class="text-info fw-bold">00:00</span>
                            </div>
                            <div class="col-6 p-2 bg-dark border border-secondary">
                                <span class="text-secondary">Ошибок/Сбоев:</span> <span id="res-attempts" class="text-warning fw-bold">0</span>
                            </div>
                            <div class="col-12 p-2 bg-dark border border-secondary">
                                <span class="text-secondary">Статус телеметрии:</span> <span class="text-warning fw-bold">Уровень 2 сдан (Level Mastered)</span>
                            </div>
                        </div>
                        <div class="text-secondary small mb-0">
                            Аналитический зачет сохранен. Приготовьтесь к финальному испытанию — скоростному аркадному симулятору Уровня 3!
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(() => {
    // Состояние сессии
    let currentPhase = 1;
    let attemptsCount = 0;
    const startTime = Date.now();
    let timerInterval = null;

    // Элементы индикации
    const attemptsDisplay = document.getElementById('attempts-display');
    const timerDisplay = document.getElementById('timer-display');
    const phaseBadge = document.getElementById('phase-badge');
    const phaseTitle = document.getElementById('phase-title');
    const feedbackBox = document.getElementById('feedback-box');
    const feedbackText = document.getElementById('feedback-text');

    // Таймер
    timerInterval = setInterval(() => {
        const sec = Math.floor((Date.now() - startTime) / 1000);
        const m = String(Math.floor(sec / 60)).padStart(2, '0');
        const s = String(sec % 60).padStart(2, '0');
        if (timerDisplay) timerDisplay.textContent = `${m}:${s}`;
    }, 1000);

    // Нормализация пользовательского числового ввода (запятая -> точка, trim)
    function parseUserNum(val) {
        if (!val) return NaN;
        const normalized = String(val).trim().replace(',', '.');
        return parseFloat(normalized);
    }

    // Отправка телеметрии
    function sendTelemetry(actionType, successStatus, statusStr) {
        const payload = {
            type: 'TELEMETRY_EVENT',
            mission_name: 'Урок 27 :: Непрерывные и дискретные сигналы (Уровень 2)',
            action_type: actionType,
            status: statusStr,
            start_time: new Date(startTime).toISOString(),
            time_spent_sec: Math.max(1, Math.round((Date.now() - startTime) / 1000)),
            attempts_count: attemptsCount,
            success: successStatus
        };
        try {
            window.parent.postMessage(payload, '*');
        } catch(e) {
            console.error('Telemetry postMessage error:', e);
        }
    }

    // Обработка ошибки и сброс текущей фазы
    function triggerFailure(message, resetCallback) {
        attemptsCount++;
        if (attemptsDisplay) attemptsDisplay.textContent = attemptsCount;
        if (feedbackText) feedbackText.textContent = message;
        if (feedbackBox) feedbackBox.classList.remove('d-none');

        // Отправка hardcore_reset в телеметрию
        sendTelemetry('hardcore_reset', false, 'in_progress');

        setTimeout(() => {
            if (feedbackBox) feedbackBox.classList.add('d-none');
            if (typeof resetCallback === 'function') resetCallback();
        }, 1200);
    }

    // =========================================================================
    // ФАЗА 1: Теорема Котельникова (Частота и шаг во времени)
    // =========================================================================
    let p1TargetFd = 0;
    let p1TargetDtMs = 0;

    const P1_VARIANTS = [
        { fmax: 250, unit: 'Гц', fd: 500, dt: 2 },
        { fmax: 500, unit: 'Гц', fd: 1000, dt: 1 },
        { fmax: 100, unit: 'Гц', fd: 200, dt: 5 },
        { fmax: 125, unit: 'Гц', fd: 250, dt: 4 },
        { fmax: 2000, unit: 'Гц', fd: 4000, dt: 0.25 },
        { fmax: 1000, unit: 'Гц', fd: 2000, dt: 0.5 }
    ];

    function initPhase1() {
        const v = P1_VARIANTS[Math.floor(Math.random() * P1_VARIANTS.length)];
        p1TargetFd = v.fd;
        p1TargetDtMs = v.dt;

        const fmaxEl = document.getElementById('p1-fmax');
        if (fmaxEl) fmaxEl.textContent = `${v.fmax} ${v.unit}`;

        const inputFd = document.getElementById('p1-input-fd');
        const inputDt = document.getElementById('p1-input-dt');
        if (inputFd) inputFd.value = '';
        if (inputDt) inputDt.value = '';
    }

    const p1Btn = document.getElementById('p1-btn');
    if (p1Btn) {
        p1Btn.addEventListener('click', () => {
            const fdVal = parseUserNum(document.getElementById('p1-input-fd')?.value);
            const dtVal = parseUserNum(document.getElementById('p1-input-dt')?.value);

            if (isNaN(fdVal) || isNaN(dtVal)) {
                triggerFailure('Заполните оба расчетных поля Шага 1!', initPhase1);
                return;
            }

            if (Math.abs(fdVal - p1TargetFd) < 0.01 && Math.abs(dtVal - p1TargetDtMs) < 0.01) {
                // Переход к Шагу 2
                currentPhase = 2;
                document.getElementById('phase1').classList.add('d-none');
                document.getElementById('phase2').classList.remove('d-none');
                if (phaseBadge) phaseBadge.textContent = 'Шаг 2 из 5';
                if (phaseTitle) phaseTitle.textContent = 'АЦП: количество уровней N = 2^b и шаг квантования ΔU';
                initPhase2();
            } else {
                triggerFailure('Неверно вычислена минимальная частота или интервал Котельникова!', initPhase1);
            }
        });
    }

    // =========================================================================
    // ФАЗА 2: Число уровней и шаг квантования по напряжению
    // =========================================================================
    let p2TargetN = 0;
    let p2TargetDuMv = 0;

    const P2_VARIANTS = [
        { spanVolt: 4.096, spanMv: 4096, b: 12, n: 4096, du: 1 },
        { spanVolt: 2.56,  spanMv: 2560, b: 8,  n: 256,  du: 10 },
        { spanVolt: 5.12,  spanMv: 5120, b: 10, n: 1024, du: 5 },
        { spanVolt: 2.048, spanMv: 2048, b: 10, n: 1024, du: 2 },
        { spanVolt: 1.024, spanMv: 1024, b: 10, n: 1024, du: 1 },
        { spanVolt: 8.192, spanMv: 8192, b: 12, n: 4096, du: 2 }
    ];

    function initPhase2() {
        const v = P2_VARIANTS[Math.floor(Math.random() * P2_VARIANTS.length)];
        p2TargetN = v.n;
        p2TargetDuMv = v.du;

        const uspanEl = document.getElementById('p2-uspan');
        const bitsEl = document.getElementById('p2-bits');
        if (uspanEl) uspanEl.textContent = `${v.spanVolt} В (${v.spanMv} мВ)`;
        if (bitsEl) bitsEl.textContent = `${v.b} бит`;

        const inputN = document.getElementById('p2-input-n');
        const inputDu = document.getElementById('p2-input-du');
        if (inputN) inputN.value = '';
        if (inputDu) inputDu.value = '';
    }

    const p2Btn = document.getElementById('p2-btn');
    if (p2Btn) {
        p2Btn.addEventListener('click', () => {
            const nVal = parseUserNum(document.getElementById('p2-input-n')?.value);
            const duVal = parseUserNum(document.getElementById('p2-input-du')?.value);

            if (isNaN(nVal) || isNaN(duVal)) {
                triggerFailure('Заполните оба расчетных поля Шага 2!', initPhase2);
                return;
            }

            if (Math.abs(nVal - p2TargetN) < 0.1 && Math.abs(duVal - p2TargetDuMv) < 0.01) {
                // Переход к Шагу 3
                currentPhase = 3;
                document.getElementById('phase2').classList.add('d-none');
                document.getElementById('phase3').classList.remove('d-none');
                if (phaseBadge) phaseBadge.textContent = 'Шаг 3 из 5';
                if (phaseTitle) phaseTitle.textContent = 'Погрешность квантования |e_max| = ΔU / 2 и SQNR';
                initPhase3();
            } else {
                triggerFailure('Ошибка в расчете числа уровней N = 2^b или шага квантования ΔU!', initPhase2);
            }
        });
    }

    // =========================================================================
    // ФАЗА 3: Погрешность квантования и SQNR
    // =========================================================================
    let p3TargetErrMv = 0;
    let p3TargetSqnr = 0;

    const P3_VARIANTS = [
        { du: 4, b: 10, err: 2, sqnr: 60 },
        { du: 6, b: 12, err: 3, sqnr: 72 },
        { du: 2, b: 16, err: 1, sqnr: 96 },
        { du: 8, b: 8,  err: 4, sqnr: 48 },
        { du: 10, b: 14, err: 5, sqnr: 84 },
        { du: 1, b: 24, err: 0.5, sqnr: 144 }
    ];

    function initPhase3() {
        const v = P3_VARIANTS[Math.floor(Math.random() * P3_VARIANTS.length)];
        p3TargetErrMv = v.err;
        p3TargetSqnr = v.sqnr;

        const duEl = document.getElementById('p3-du');
        const bitsEl = document.getElementById('p3-bits');
        if (duEl) duEl.textContent = `${v.du} мВ`;
        if (bitsEl) bitsEl.textContent = `${v.b} бит`;

        const inputErr = document.getElementById('p3-input-err');
        const inputSqnr = document.getElementById('p3-input-sqnr');
        if (inputErr) inputErr.value = '';
        if (inputSqnr) inputSqnr.value = '';
    }

    const p3Btn = document.getElementById('p3-btn');
    if (p3Btn) {
        p3Btn.addEventListener('click', () => {
            const errVal = parseUserNum(document.getElementById('p3-input-err')?.value);
            const sqnrVal = parseUserNum(document.getElementById('p3-input-sqnr')?.value);

            if (isNaN(errVal) || isNaN(sqnrVal)) {
                triggerFailure('Заполните оба расчетных поля Шага 3!', initPhase3);
                return;
            }

            if (Math.abs(errVal - p3TargetErrMv) < 0.01 && Math.abs(sqnrVal - p3TargetSqnr) < 0.1) {
                // Переход к Шагу 4
                currentPhase = 4;
                document.getElementById('phase3').classList.add('d-none');
                document.getElementById('phase4').classList.remove('d-none');
                if (phaseBadge) phaseBadge.textContent = 'Шаг 4 из 5';
                if (phaseTitle) phaseTitle.textContent = 'Информационный битрейт R и объем звуковых данных I';
                initPhase4();
            } else {
                triggerFailure('Неверно вычислена предельная погрешность или динамический диапазон SQNR!', initPhase3);
            }
        });
    }

    // =========================================================================
    // ФАЗА 4: Битрейт и объем аудиоданных
    // =========================================================================
    let p4TargetRateKbps = 0;
    let p4TargetVolKb = 0;

    const P4_VARIANTS = [
        { fd: 16000, b: 16, k: 1, mode: 'Моно (k=1)', t: 16, rate: 256, vol: 500 },
        { fd: 8000,  b: 8,  k: 1, mode: 'Моно (k=1)', t: 64, rate: 64,  vol: 500 },
        { fd: 32000, b: 16, k: 1, mode: 'Моно (k=1)', t: 8,  rate: 512, vol: 500 },
        { fd: 16000, b: 16, k: 2, mode: 'Стерео (k=2)', t: 8, rate: 512, vol: 500 },
        { fd: 44100, b: 16, k: 1, mode: 'Моно (k=1)', t: 10, rate: 705.6, vol: 861.3 },
        { fd: 48000, b: 16, k: 2, mode: 'Стерео (k=2)', t: 10, rate: 1536, vol: 1875 }
    ];

    function initPhase4() {
        const v = P4_VARIANTS[Math.floor(Math.random() * P4_VARIANTS.length)];
        p4TargetRateKbps = v.rate;
        p4TargetVolKb = v.vol;

        const fdEl = document.getElementById('p4-fd');
        const bitsEl = document.getElementById('p4-bits');
        const modeEl = document.getElementById('p4-mode');
        const timeEl = document.getElementById('p4-time');

        if (fdEl) fdEl.textContent = `${v.fd} Гц`;
        if (bitsEl) bitsEl.textContent = `${v.b} бит`;
        if (modeEl) modeEl.textContent = v.mode;
        if (timeEl) timeEl.textContent = `${v.t} с`;

        const inputRate = document.getElementById('p4-input-rate');
        const inputVol = document.getElementById('p4-input-vol');
        if (inputRate) inputRate.value = '';
        if (inputVol) inputVol.value = '';
    }

    const p4Btn = document.getElementById('p4-btn');
    if (p4Btn) {
        p4Btn.addEventListener('click', () => {
            const rateVal = parseUserNum(document.getElementById('p4-input-rate')?.value);
            const volVal = parseUserNum(document.getElementById('p4-input-vol')?.value);

            if (isNaN(rateVal) || isNaN(volVal)) {
                triggerFailure('Заполните оба расчетных поля Шага 4!', initPhase4);
                return;
            }

            // Допуск по объему с учетом округлений до 1 Кб
            const rateOk = Math.abs(rateVal - p4TargetRateKbps) < 0.5;
            const volOk = Math.abs(volVal - p4TargetVolKb) < 1.0;

            if (rateOk && volOk) {
                // Переход к Шагу 5
                currentPhase = 5;
                document.getElementById('phase4').classList.add('d-none');
                document.getElementById('phase5').classList.remove('d-none');
                if (phaseBadge) phaseBadge.textContent = 'Шаг 5 из 5';
                if (phaseTitle) phaseTitle.textContent = 'Спектральный алиасинг: расчет частоты паразитных биений';
                initPhase5();
            } else {
                triggerFailure('Неверно рассчитан битрейт потока R или итоговый объем несжатого файла I!', initPhase4);
            }
        });
    }

    // =========================================================================
    // ФАЗА 5: Алиасинг (Частота Найквиста и ложные биения)
    // =========================================================================
    let p5TargetFn = 0;
    let p5TargetAlias = 0;

    const P5_VARIANTS = [
        { fsig: 7, fd: 10, fn: 5, alias: 3 },
        { fsig: 9, fd: 12, fn: 6, alias: 3 },
        { fsig: 18, fd: 24, fn: 12, alias: 6 },
        { fsig: 15, fd: 20, fn: 10, alias: 5 },
        { fsig: 8, fd: 12, fn: 6, alias: 4 },
        { fsig: 14, fd: 16, fn: 8, alias: 2 }
    ];

    function initPhase5() {
        const v = P5_VARIANTS[Math.floor(Math.random() * P5_VARIANTS.length)];
        p5TargetFn = v.fn;
        p5TargetAlias = v.alias;

        const fsigEl = document.getElementById('p5-fsig');
        const fdEl = document.getElementById('p5-fd');
        if (fsigEl) fsigEl.textContent = `${v.fsig} кГц`;
        if (fdEl) fdEl.textContent = `${v.fd} кГц`;

        const inputFn = document.getElementById('p5-input-fn');
        const inputAlias = document.getElementById('p5-input-alias');
        if (inputFn) inputFn.value = '';
        if (inputAlias) inputAlias.value = '';
    }

    const p5Btn = document.getElementById('p5-btn');
    if (p5Btn) {
        p5Btn.addEventListener('click', () => {
            const fnVal = parseUserNum(document.getElementById('p5-input-fn')?.value);
            const aliasVal = parseUserNum(document.getElementById('p5-input-alias')?.value);

            if (isNaN(fnVal) || isNaN(aliasVal)) {
                triggerFailure('Заполните оба расчетных поля Шага 5!', initPhase5);
                return;
            }

            if (Math.abs(fnVal - p5TargetFn) < 0.01 && Math.abs(aliasVal - p5TargetAlias) < 0.01) {
                // Победа на Уровне 2!
                clearInterval(timerInterval);
                document.getElementById('phase5').classList.add('d-none');
                document.getElementById('victory-screen').classList.remove('d-none');
                if (phaseBadge) {
                    phaseBadge.className = 'badge bg-warning text-dark rounded-0 fs-6 me-2';
                    phaseBadge.textContent = 'Успех';
                }
                if (phaseTitle) phaseTitle.textContent = 'Уровень 2 полностью пройден!';

                const totalSec = Math.floor((Date.now() - startTime) / 1000);
                const m = String(Math.floor(totalSec / 60)).padStart(2, '0');
                const s = String(totalSec % 60).padStart(2, '0');
                const resTime = document.getElementById('res-time');
                const resAttempts = document.getElementById('res-attempts');
                if (resTime) resTime.textContent = `${m}:${s}`;
                if (resAttempts) resAttempts.textContent = attemptsCount;

                // Отправка победной телеметрии
                sendTelemetry('level_complete', true, 'completed');
            } else {
                triggerFailure('Неверно вычислена частота Найквиста f_N или паразитная гармоника алиаса f_alias!', initPhase5);
            }
        });
    }

    // Поддержка нажатия Enter в полях ввода
    document.querySelectorAll('input').forEach(inp => {
        inp.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                const container = inp.closest('.phase-container');
                if (!container) return;
                const btn = container.querySelector('button[id$="-btn"]');
                if (btn) btn.click();
            }
        });
    });

    // Инициализация первой фазы
    initPhase1();
})();
</script>
