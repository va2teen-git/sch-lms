---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={1}>
    <div class="container my-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 text-success font-monospace mb-0">Тренажер: Анализ вредоносного ПО (Уровень 1)</h2>
            <span class="badge border border-success text-success bg-dark rounded-0 px-3 py-2 font-monospace">Базовый режим</span>
        </div>

        <div id="game-container" class="card bg-dark border-success rounded-0">
            <div class="card-body p-4">
                
                <!-- Фаза 1 -->
                <div id="phase1" class="phase-container">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-success font-monospace mb-0">Шаг 1 из 3: Классификация и таксономия Malware</h4>
                        <span class="badge bg-success text-dark rounded-0">Фаза 1</span>
                    </div>
                    <p class="text-light">
                        Центр мониторинга безопасности (SOC) зафиксировал подозрительную активность в операционной системе.
                        Изучите телеметрию перехваченного инцидента и определите точный класс вредоносной программы по классификации К.Ю. Полякова.
                    </p>

                    <!-- Карточка инцидента -->
                    <div class="card bg-black border-success rounded-0 p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-2 mb-3">
                            <span class="text-secondary font-monospace small">ИНЦИДЕНТ БЕЗОПАСНОСТИ #<span id="p1-incident-id" class="text-warning"></span></span>
                            <span id="p1-alert-badge" class="badge bg-danger text-light rounded-0 font-monospace">ВЫСОКИЙ РИСК</span>
                        </div>
                        <div class="font-monospace text-light mb-2">
                            <span class="text-secondary d-block small">ВЕКТОР АКТИВНОСТИ:</span>
                            <span id="p1-vector-desc" class="fs-6 text-light"></span>
                        </div>
                        <div class="bg-dark border border-secondary p-2 mt-2 font-monospace small">
                            <span class="text-secondary">СИСТЕМНЫЙ ЛОГ: </span>
                            <span id="p1-system-log" class="text-warning"></span>
                        </div>
                    </div>

                    <p class="text-light mb-2">К какому типу вредоносного программного обеспечения относится данный образец?</p>
                    <div id="p1-options" class="d-grid gap-2 mb-3">
                        <!-- Кнопки генерируются через JS -->
                    </div>

                    <div id="p1-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [ОШИБКА КЛАССИФИКАЦИИ] Неверная таксономия угрозы! Анализ нового инцидента...
                    </div>
                </div>

                <!-- Фаза 2 -->
                <div id="phase2" class="phase-container d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-success font-monospace mb-0">Шаг 2 из 3: Выбор технологии обнаружения и защиты</h4>
                        <span class="badge bg-success text-dark rounded-0">Фаза 2</span>
                    </div>
                    <p class="text-light">
                        Для предотвращения повторного заражения и нейтрализации угрозы необходимо развернуть адекватную подсистему защиты.
                        Определите метод обнаружения или технологию защиты, наиболее эффективную для данной оперативной задачи.
                    </p>

                    <!-- Описание защитной задачи -->
                    <div class="card bg-black border-success rounded-0 p-3 mb-4">
                        <div class="text-secondary small font-monospace mb-1">ТЕХНИЧЕСКОЕ ЗАДАНИЕ ДЛЯ АНТИВИРУСНОГО ДВИЖКА:</div>
                        <div id="p2-task-desc" class="font-monospace text-light fs-6 mb-3"></div>
                        <div class="card bg-dark border-secondary rounded-0 p-2 font-monospace small">
                            <span class="text-secondary">СПЕЦИФИКАЦИЯ УСЛОВИЯ: </span>
                            <span id="p2-condition-note" class="text-info"></span>
                        </div>
                    </div>

                    <p class="text-light mb-2">Какой метод обнаружения или защитный механизм решит эту задачу?</p>
                    <div id="p2-options" class="d-grid gap-2 mb-3">
                        <!-- Кнопки генерируются через JS -->
                    </div>

                    <div id="p2-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [ОШИБКА АРХИТЕКТУРЫ ЗАЩИТЫ] Неверный выбор антивирусного механизма! Реконфигурация задачи...
                    </div>
                </div>

                <!-- Фаза 3 -->
                <div id="phase3" class="phase-container d-none">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <h4 class="h5 text-success font-monospace mb-0">Шаг 3 из 3: Верификация целостности и вынесение вердикта</h4>
                        <span class="badge bg-success text-dark rounded-0">Фаза 3</span>
                    </div>
                    <p class="text-light">
                        Антивирусный ревизор провел анализ системного файла. Сопоставьте эталонные контрольные суммы, вычисленный хеш SHA-256 и базу известных сигнатур Malware, чтобы вынести корректный вердикт безопасности.
                    </p>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="card bg-black border-success rounded-0 p-3 h-100 font-monospace">
                                <div class="text-secondary small mb-2">АТРИБУТЫ ПРОВЕРЯЕМОГО ОБЪЕКТА:</div>
                                <div class="mb-2">Файл: <span id="p3-file-name" class="text-light fw-bold"></span></div>
                                <div class="mb-2">Путь: <span id="p3-file-path" class="text-secondary"></span></div>
                                <div class="mb-2">
                                    Вычисленный SHA-256: <br>
                                    <span id="p3-file-hash" class="text-warning text-break"></span>
                                </div>
                                <div class="small text-secondary">
                                    Энтропия секции кода: <span id="p3-file-entropy" class="text-light fw-bold"></span> бит/байт
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-black border-secondary rounded-0 p-3 h-100 font-monospace">
                                <div class="text-secondary small mb-2">СПРАВОЧНАЯ БАЗА ЗНАНИЙ:</div>
                                <div class="mb-2">
                                    <span class="text-secondary small d-block">ЭТАЛОН СИСТЕМЫ (БЕЛЫЙ СПИСОК):</span>
                                    <span id="p3-clean-hash" class="text-success text-break small"></span>
                                </div>
                                <div class="mb-2">
                                    <span class="text-secondary small d-block">СИГНАТУРА В БАЗЕ MALWARE:</span>
                                    <span id="p3-malware-hash" class="text-danger text-break small"></span>
                                    <span id="p3-malware-name" class="badge bg-danger text-light rounded-0 mt-1"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <p class="text-light mb-2">Выберите правильный вердикт антивирусной экспертизы:</p>
                    <div id="p3-options" class="d-grid gap-2 mb-3">
                        <!-- Варианты выбора вердикта -->
                    </div>

                    <div id="p3-feedback" class="alert alert-danger rounded-0 border-danger d-none font-monospace py-2" role="alert">
                        [ОШИБКА ЭКСПЕРТИЗЫ] Неверный вердикт безопасности! Загрузка следующего объекта...
                    </div>
                </div>

                <!-- Экран завершения -->
                <div id="success-screen" class="phase-container d-none text-center py-5">
                    <div class="mb-3 text-success font-monospace display-4">✓ СЕССИЯ УСПЕШНО ЗАВЕРШЕНА</div>
                    <h3 class="text-light font-monospace mb-3">Базовые методы анализа и классификации Malware освоены</h3>
                    <p class="text-secondary max-w-md mx-auto mb-4">
                        Вы успешно классифицировали угрозы по таксономии Полякова, определили оптимальные механизмы противодействия и провели верификацию целостности объектов.
                    </p>
                    <div class="badge border border-success text-success bg-black p-3 font-monospace fs-6 rounded-0">
                        Уровень 1 пройден. Переходите на Уровень 2 в верхней панели!
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script is:inline>
        const missionName = 'Урок 20 :: Вредоносное ПО и методы борьбы с ним (Уровень 1)';
        const startTime = Date.now();
        let attempts = 0;

        function sendTelemetry(action_type, success = false) {
            const timeSpent = Math.floor((Date.now() - startTime) / 1000);
            window.parent.postMessage({
                type: 'TELEMETRY_EVENT',
                mission_name: missionName,
                action_type: action_type,
                status: action_type === 'level_complete' ? 'completed' : 'in_progress',
                start_time: new Date(startTime).toISOString(),
                time_spent_sec: timeSpent,
                attempts_count: attempts,
                success: success
            }, '*');
        }

        function rnd(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function shuffle(arr) {
            const a = [...arr];
            for (let i = a.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [a[i], a[j]] = [a[j], a[i]];
            }
            return a;
        }

        function generateHex(len) {
            const hex = '0123456789abcdef';
            let res = '';
            for (let i = 0; i < len; i++) {
                res += hex[rnd(0, hex.length - 1)];
            }
            return res;
        }

        // ==========================================
        // ФАЗА 1: Классификация и таксономия Malware
        // ==========================================
        let p1CorrectIndex = -1;

        const malwareClasses = [
            {
                name: 'Файловый вирус',
                vectors: [
                    'Обнаружено дописывание вредоносного байт-кода в конец легитимного PE-бинарника с перенаправлением точки входа (Entry Point).',
                    'Модификация заголовков исполняемого файла .exe с внедрением дополнительной исполняемой секции в каверну файла.',
                    'Заражение библиотек DLL с перехватом адресов процедур в таблице экспорта.'
                ],
                logGen: () => `PE_HOOK: Modified AddressOfEntryPoint in binary calc_${rnd(100,999)}.exe. Extra section size: ${rnd(1024,4096)} bytes.`
            },
            {
                name: 'Загрузочный вирус (Boot-вирус)',
                vectors: [
                    'Перезапись главной загрузочной записи (Master Boot Record — MBR) физического накопителя со смещением оригинального загрузчика в скрытый сектор.',
                    'Перехват системного прерывания BIOS INT 13h на этапе инициализации до запуска ядра операционной системы.',
                    'Инфицирование загрузочного сектора раздела VBR съемного USB-накопителя с выполнением 16-битного реального режима.'
                ],
                logGen: () => `DISK_ALERT: Direct sector write to LBA 0 (MBR). INT 13h vector hooked at segment 0000:${rnd(1000,9000)}h.`
            },
            {
                name: 'Макровирус',
                vectors: [
                    'Внедрение скрипта на языке VBA в глобальный шаблон офисных документов Normal.dotm с автоматическим исполнением при сохранении.',
                    'Документ текстового процессора содержит процедуру AutoOpen, инициирующую загрузку стороннего скрипта при открытии файла.',
                    'Инфицирование шаблонов электронных таблиц с перехватом события Workbook_Open.'
                ],
                logGen: () => `VBA_INTERCEPT: Macro AutoOpen detected in Word document invoice_${rnd(1000,9999)}.docm. Payload: Shell execution.`
            },
            {
                name: 'Сетевой червь (Worm)',
                vectors: [
                    'Программа непрерывно сканирует подсеть на порту 445 (SMB) и самостоятельно размножается, отправляя RCE-эксплойт без участия пользователей.',
                    'Автономное распространение через уязвимость переполнения буфера сетевой службы с генерацией тысяч запросов к случайным IP.',
                    'Самораспространяющийся модуль рассылает свои копии через списки контактов почтового клиента с вложением zip-архива.'
                ],
                logGen: () => `PORT_SCAN_ALARM: Host initiated 1000+ SYN connections to subnet 192.168.${rnd(1,10)}.0/24 on port ${rnd(1,2) === 1 ? '445' : '3389'}.`
            },
            {
                name: 'Клавиатурный шпион (Кейлоггер)',
                vectors: [
                    'Процесс установил глобальный перехват сообщений ввода с помощью вызова API SetWindowsHookEx(WH_KEYBOARD_LL) для скрытого логирования.',
                    'Перехват нажатий клавиш клавиатуры и отправка дампов введенных паролей на удаленный сервер злоумышленника.',
                    'Установка низкоуровневого фильтр-драйвера клавиатуры, перехватывающего скан-коды клавиш в фоновом режиме.'
                ],
                logGen: () => `KEY_HOOK: Process svchost_${rnd(10,99)}.exe registered global hook WH_KEYBOARD_LL without GUI window.`
            },
            {
                name: 'Программа-вымогатель (Шифровальщик / Ransomware)',
                vectors: [
                    'Массовое шифрование файлов пользователя стойким алгоритмом AES-256 с заменой расширений на .locked и созданием текстового файла с требованием выкупа.',
                    'Блокировка доступа к личным документам и базам данных с удалением теневых копий томов Volume Shadow Copies.',
                    'Принудительное шифрование сетевых дисков с генерацией требования перевести криптовалюту за закрытый ключ.'
                ],
                logGen: () => `MASS_ENCRYPT: 250 files renamed to *.crypted in 3 seconds. Command executed: vssadmin delete shadows /all /quiet.`
            },
            {
                name: 'Руткит (Rootkit)',
                vectors: [
                    'Драйвер ядра осуществил перехват таблицы системных сервисов (SSDT Hooking) и скрывает вредоносный процесс из диспетчера задач.',
                    'Прямая модификация структур объектов ядра (DKOM) — исключение процесса из двусвязного списка активных задач EPROCESS.',
                    'Перехват вызовов в ntdll.dll для фильтрации системных файлов и открытых TCP-портов от антивирусных утилит.'
                ],
                logGen: () => `KERNEL_MONITOR: SSDT entry for NtQuerySystemInformation hooked by unauthorized driver ring0_${rnd(10,99)}.sys.`
            },
            {
                name: 'Бесфайловая вредоносная программа (Fileless Malware)',
                vectors: [
                    'Выполнение шелл-кода непосредственно в оперативной памяти с помощью утилиты powershell.exe без создания исполняемого файла на диске.',
                    'Использование легитимной системной утилиты mshta.exe для загрузки вредоносного скрипта из реестра Windows.',
                    'Вредоносный код сохранен в зашифрованном виде в WMI-репозитории и детонирует по системному триггеру без записи .exe.'
                ],
                logGen: () => `LOLBIN_EXEC: powershell.exe spawned with args: -NoProfile -ExecutionPolicy Bypass -EncodedCommand ${generateHex(16)}...`
            }
        ];

        function initPhase1() {
            const target = malwareClasses[rnd(0, malwareClasses.length - 1)];
            const vectorDesc = target.vectors[rnd(0, target.vectors.length - 1)];
            const systemLog = target.logGen();

            document.getElementById('p1-incident-id').textContent = `INC-${rnd(1000, 9999)}`;
            document.getElementById('p1-vector-desc').textContent = vectorDesc;
            document.getElementById('p1-system-log').textContent = systemLog;

            // Формируем 4 варианта выбора
            const otherClasses = malwareClasses.filter(c => c.name !== target.name).map(c => c.name);
            const chosenDistractors = shuffle(otherClasses).slice(0, 3);
            const allOptions = shuffle([target.name, ...chosenDistractors]);
            p1CorrectIndex = allOptions.indexOf(target.name);

            const optionsContainer = document.getElementById('p1-options');
            optionsContainer.innerHTML = '';
            allOptions.forEach((className, idx) => {
                const btn = document.createElement('button');
                btn.className = 'btn btn-outline-success text-start font-monospace rounded-0 py-2 px-3';
                btn.textContent = `${idx + 1}. [ ${className} ]`;
                btn.addEventListener('click', () => handlePhase1Answer(idx));
                optionsContainer.appendChild(btn);
            });
        }

        function handlePhase1Answer(selectedIdx) {
            const feedback = document.getElementById('p1-feedback');
            const buttons = document.querySelectorAll('#p1-options button');
            buttons.forEach(b => b.disabled = true);

            if (selectedIdx === p1CorrectIndex) {
                document.getElementById('phase1').classList.add('d-none');
                document.getElementById('phase2').classList.remove('d-none');
                sendTelemetry('in_progress');
                initPhase2();
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                feedback.classList.remove('d-none');
                setTimeout(() => {
                    initPhase1();
                    feedback.classList.add('d-none');
                }, 1200);
            }
        }

        // ==========================================
        // ФАЗА 2: Выбор технологии защиты
        // ==========================================
        let p2CorrectIndex = -1;

        const defenseScenarios = [
            {
                task: 'Выявление неизвестного полиморфного вируса, у которого при каждом заражении генерируется уникальный дешифратор и отсутствует постоянная сигнатура.',
                condition: 'Классический поиск по байтовой маске бессилен, требуется эмулировать исполнение команд.',
                correct: 'Динамический эвристический анализ со встроенным эмулятором процессора',
                distractors: [
                    'Сигнатурный поиск по базе хешей MD5/SHA-256',
                    'Межсетевой экран с фильтрацией пакетов по IP-адресу',
                    'Настройка парольной защиты на BIOS'
                ]
            },
            {
                task: 'Блокировка неконтролируемого сетевого червя, эксплуатирующего удаленную уязвимость в службе общих файлов SMB (порт 445 TCP).',
                condition: 'Требуется предотвратить горизонтальное перемещение червя по сегментам локальной сети.',
                correct: 'Межсетевой экран (Брандмауэр / Firewall) и фильтрация сетевых портов',
                distractors: [
                    'Сканирование диска ревизором целостности CRC32',
                    'Эвристический анализ макрокоманд VBA в документах Word',
                    'Дефрагментация жесткого диска'
                ]
            },
            {
                task: 'Защита критически важных баз данных и файлов бухгалтерии от безвозвратной утери в случае атаки вируса-шифровальщика (Ransomware).',
                condition: 'Требуется исключить ситуацию выплаты выкупа преступникам и гарантировать восстановление.',
                correct: 'Стратегия резервного копирования «3-2-1» с изолированной офлайн-копией (Air-Gap)',
                distractors: [
                    'Повышение учетной записи пользователя до прав Администратора',
                    'Установка антивирусного сканера по требованию без монитора',
                    'Шифрование жесткого диска тем же паролем, что и учетная запись'
                ]
            },
            {
                task: 'Моментальная проверка сотен тысяч системных файлов на предмет наличия известных угроз с абсолютным отсутствием ложных срабатываний (False Positives).',
                condition: 'База данных содержит миллионы подтвержденных эталонных слепков известных вирусов.',
                correct: 'Сигнатурный анализ и сопоставление криптографических хеш-сумм (MD5/SHA-256)',
                distractors: [
                    'Поведенческий блокиратор HIPS в режиме обучения',
                    'Запуск каждого файла в ручной виртуальной машине',
                    'Статический анализ комментариев в коде'
                ]
            },
            {
                task: 'Предотвращение попыток скрытого внедрения кода (Process Injection) и несанкционированного изменения системных библиотек в реальном времени.',
                condition: 'Код выполняется бестелесно в оперативной памяти без записи на диск.',
                correct: 'Поведенческий анализ и проактивная защита (HIPS / EDR)',
                distractors: [
                    'Еженедельное сканирование жесткого диска по расписанию',
                    'Проверка целостности дискет через BIOS',
                    'Фильтрация входящего спама в почтовом клиенте'
                ]
            },
            {
                task: 'Обнаружение скрытых изменений и подмены системных исполняемых файлов ядра и драйверов после инцидента безопасности.',
                condition: 'Требуется сравнить текущую структуру и контрольные суммы файлов с первоначальным эталоном.',
                correct: 'Ревизор целостности файлов (контроль хеш-сумм и метаданных)',
                distractors: [
                    'Программный эмулятор BIOS',
                    'Почтовый антивирусный монитор POP3/IMAP',
                    'Переустановка видеодрайвера'
                ]
            },
            {
                task: 'Безопасное детальное исследование подозрительного файла, полученного из неизвестного источника, без риска заражения реальной системы.',
                condition: 'Необходимо запустить программу и пронаблюдать ее сетевые запросы и поведение.',
                correct: 'Изолированная аналитическая песочница (Sandbox)',
                distractors: [
                    'Запуск программы в режиме совместимости с Windows XP',
                    'Добавление программы в список исключений брандмауэра',
                    'Просмотр файла в текстовом блокноте'
                ]
            }
        ];

        function initPhase2() {
            const scenario = defenseScenarios[rnd(0, defenseScenarios.length - 1)];

            document.getElementById('p2-task-desc').textContent = scenario.task;
            document.getElementById('p2-condition-note').textContent = scenario.condition;

            const allOptions = shuffle([scenario.correct, ...scenario.distractors]);
            p2CorrectIndex = allOptions.indexOf(scenario.correct);

            const optionsContainer = document.getElementById('p2-options');
            optionsContainer.innerHTML = '';
            allOptions.forEach((optText, idx) => {
                const btn = document.createElement('button');
                btn.className = 'btn btn-outline-success text-start font-monospace rounded-0 py-2 px-3';
                btn.textContent = `${idx + 1}. [ ${optText} ]`;
                btn.addEventListener('click', () => handlePhase2Answer(idx));
                optionsContainer.appendChild(btn);
            });
        }

        function handlePhase2Answer(selectedIdx) {
            const feedback = document.getElementById('p2-feedback');
            const buttons = document.querySelectorAll('#p2-options button');
            buttons.forEach(b => b.disabled = true);

            if (selectedIdx === p2CorrectIndex) {
                document.getElementById('phase2').classList.add('d-none');
                document.getElementById('phase3').classList.remove('d-none');
                sendTelemetry('in_progress');
                initPhase3();
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                feedback.classList.remove('d-none');
                setTimeout(() => {
                    initPhase2();
                    feedback.classList.add('d-none');
                }, 1200);
            }
        }

        // ==========================================
        // ФАЗА 3: Верификация целостности и вердикт
        // ==========================================
        let p3CorrectIndex = -1;

        const filesCatalog = [
            { name: 'winlogon.exe', path: 'C:\\Windows\\System32\\winlogon.exe' },
            { name: 'svchost.exe', path: 'C:\\Windows\\System32\\svchost.exe' },
            { name: 'explorer.exe', path: 'C:\\Windows\\explorer.exe' },
            { name: 'kernel32.dll', path: 'C:\\Windows\\System32\\kernel32.dll' },
            { name: 'ntoskrnl.exe', path: 'C:\\Windows\\System32\\ntoskrnl.exe' },
            { name: 'lsass.exe', path: 'C:\\Windows\\System32\\lsass.exe' }
        ];

        const malwareSignatures = [
            'Trojan.Downloader.Generic',
            'Backdoor.CobaltStrike.Beacon',
            'Ransom.WannaCry.Payload',
            'Rootkit.Kernel.SSDTMod',
            'Worm.Win32.AutoRun'
        ];

        function initPhase3() {
            const file = filesCatalog[rnd(0, filesCatalog.length - 1)];
            const cleanHash = generateHex(32);
            const knownMalwareHash = generateHex(32);
            const malwareFamily = malwareSignatures[rnd(0, malwareSignatures.length - 1)];

            // Сценарий проверки:
            // 1: Чистый файл (хеш совпадает с cleanHash)
            // 2: Заражен известным malware (хеш совпадает с knownMalwareHash)
            // 3: Подозрительный модифицированный файл с высокой энтропией (хеш не равен чистой и не равен malware, высокая энтропия)
            const scenarioType = rnd(1, 3);
            let currentHash = '';
            let entropy = '';
            let correctVerdict = '';

            if (scenarioType === 1) {
                currentHash = cleanHash;
                entropy = (rnd(55, 64) / 10).toFixed(2);
                correctVerdict = 'CLEAN (Чистый файл — полное совпадение с белым списком)';
            } else if (scenarioType === 2) {
                currentHash = knownMalwareHash;
                entropy = (rnd(68, 76) / 10).toFixed(2);
                correctVerdict = `INFECTED (Точное совпадение с сигнатурой базы: ${malwareFamily})`;
            } else {
                currentHash = generateHex(32);
                entropy = (rnd(78, 79) / 10).toFixed(2);
                correctVerdict = 'SUSPICIOUS (Подозрительный объект — нарушена целостность, аномальная энтропия)';
            }

            document.getElementById('p3-file-name').textContent = file.name;
            document.getElementById('p3-file-path').textContent = file.path;
            document.getElementById('p3-file-hash').textContent = currentHash;
            document.getElementById('p3-file-entropy').textContent = entropy;

            document.getElementById('p3-clean-hash').textContent = cleanHash;
            document.getElementById('p3-malware-hash').textContent = knownMalwareHash;
            document.getElementById('p3-malware-name').textContent = malwareFamily;

            const allVerdicts = [
                'CLEAN (Чистый файл — полное совпадение с белым списком)',
                `INFECTED (Точное совпадение с сигнатурой базы: ${malwareFamily})`,
                'SUSPICIOUS (Подозрительный объект — нарушена целостность, аномальная энтропия)',
                'FALSE_ALARM (Файл легитимен, но ошибочно определен как архив)'
            ];

            const shuffledOptions = shuffle(allVerdicts);
            p3CorrectIndex = shuffledOptions.indexOf(correctVerdict);

            const optionsContainer = document.getElementById('p3-options');
            optionsContainer.innerHTML = '';
            shuffledOptions.forEach((verdictText, idx) => {
                const btn = document.createElement('button');
                btn.className = 'btn btn-outline-success text-start font-monospace rounded-0 py-2 px-3';
                btn.textContent = `${idx + 1}. ВЕРДИКТ: [ ${verdictText} ]`;
                btn.addEventListener('click', () => handlePhase3Answer(idx));
                optionsContainer.appendChild(btn);
            });
        }

        function handlePhase3Answer(selectedIdx) {
            const feedback = document.getElementById('p3-feedback');
            const buttons = document.querySelectorAll('#p3-options button');
            buttons.forEach(b => b.disabled = true);

            if (selectedIdx === p3CorrectIndex) {
                document.getElementById('phase3').classList.add('d-none');
                document.getElementById('success-screen').classList.remove('d-none');
                sendTelemetry('level_complete', true);
            } else {
                attempts++;
                sendTelemetry('hardcore_reset');
                feedback.classList.remove('d-none');
                setTimeout(() => {
                    initPhase3();
                    feedback.classList.add('d-none');
                }, 1200);
            }
        }

        // Старт
        sendTelemetry('in_progress');
        initPhase1();
    </script>
</TaskLayout>
