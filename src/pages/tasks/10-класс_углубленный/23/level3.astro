---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={3}>
    <div id="app" class="container my-4 font-monospace" v-cloak>
        
        <!-- Стартовый экран (Брифинг) -->
        <div v-if="gameState === 'intro'" class="card bg-black border-danger rounded-0 p-5 text-center">
            <div class="display-3 text-danger font-monospace mb-3">⚠️ CYBER MATRIX: PROTOCOL BREACH ⚠️</div>
            <h2 class="text-light font-monospace mb-3">КРИПТОГРАФИЧЕСКИЙ ВЗЛОМ В РЕАЛЬНОМ ВРЕМЕНИ</h2>
            <p class="fs-5 text-secondary mx-auto max-w-lg mb-4">
                Защищенный шлюз активировал криптографический протокол смены ключей.
                Ваша задача: взломать протокол и извлечь <span class="text-danger fw-bold">8 целевых криптопоследовательностей</span> 
                в интерактивной шестнадцатеричной матрице по правилам поочередного обхода строк и столбцов.
            </p>

            <div class="card bg-dark border-secondary rounded-0 p-3 mx-auto mb-4 text-start font-monospace small" style="max-width: 650px;">
                <div class="text-danger fw-bold mb-2">[ПРОТОКОЛ ВЗЛОМА КИБЕРМАТРИЦЫ]:</div>
                <div class="text-light mb-1">• <span class="text-warning">Чередование Строка ↔ Столбец:</span> Первый ход разрешен только в активной строке. Выбранная ячейка активирует свой столбец для следующего хода! Клик в столбце активирует новую строку.</div>
                <div class="text-light mb-1">• <span class="text-warning">Целевая цепочка:</span> Соберите целевые hex-байты в буфер памяти в точном порядке без лишних промежуточных разрывов.</div>
                <div class="text-light mb-1">• <span class="text-warning">Ограниченный буфер:</span> Вместимость буфера ограничена (4–5 ячеек). Переполнение буфера мусором вызывает срыв взлома!</div>
                <div class="text-light">• <span class="text-danger fw-bold">ТОТАЛЬНЫЙ СБРОС (Hardcore):</span> Любая ошибка или истечение таймера вызывают сброс на <span class="text-danger fw-bold">Волну 1</span>!</div>
            </div>

            <div>
                <button id="start-btn" @click="startGame" class="btn btn-danger btn-lg rounded-0 font-monospace fw-bold px-5 py-3 shadow">
                    НАЧАТЬ ПРОТОКОЛ ВЗЛОМА (ВОЛНА 1) →
                </button>
            </div>
        </div>

        <!-- Игровой процесс -->
        <div v-else-if="gameState === 'playing'" class="card bg-black border-danger rounded-0 p-4">
            
            <!-- Хедер со статусом и таймером -->
            <div class="d-flex justify-content-between align-items-center mb-2 font-monospace">
                <div>
                    <span class="text-secondary small d-block">РУБЕЖ ВЗЛОМА:</span>
                    <span id="phase-counter" class="text-danger fw-bold fs-4">ВОЛНА <span v-text="currentPhase"></span> ИЗ 8</span>
                </div>
                <div class="text-end">
                    <span class="text-secondary small d-block">ВРЕМЯ СЕССИИ:</span>
                    <span id="timer-display" class="fw-bold fs-4" :class="phaseTimeLeft <= 3.5 ? 'text-danger' : 'text-warning'">
                        <span v-text="formattedTime"></span> сек
                    </span>
                </div>
            </div>

            <!-- Полоса локального таймера -->
            <div class="progress mb-4 bg-dark border border-secondary rounded-0" style="height: 10px;">
                <div class="progress-bar transition-none"
                     :class="phaseTimeLeft <= 3.5 ? 'bg-danger' : 'bg-warning'"
                     role="progressbar"
                     :style="{ width: ((phaseTimeLeft / maxPhaseTime) * 100) + '%' }">
                </div>
            </div>

            <!-- Информационная панель текущей цели -->
            <div class="card bg-dark border-danger rounded-0 p-3 mb-4">
                <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-2 mb-2">
                    <span class="badge bg-danger text-black rounded-0 font-monospace fw-bold px-3 py-1" v-text="currentWaveInfo.badge"></span>
                    <span class="text-secondary small font-monospace">
                        Направление выбора: <span class="text-warning fw-bold" v-text="activeDirection === 'row' ? 'ПО ГОРИЗОНТАЛИ (СТРОКА)' : 'ПО ВЕРТИКАЛИ (СТОЛБЕЦ)'"></span>
                    </span>
                </div>
                <h5 class="text-light font-monospace mb-1" v-text="currentWaveInfo.title"></h5>
                <p class="text-secondary small mb-3" v-text="currentWaveInfo.desc"></p>

                <!-- Зона: Целевая цепочка и Буфер игрока -->
                <div class="row g-3">
                    <!-- Целевая цепочка -->
                    <div class="col-md-6">
                        <div class="card bg-black border-secondary rounded-0 p-2">
                            <span class="text-secondary small d-block mb-1">ТРЕБУЕМАЯ КРИПТО-ЦЕПОЧКА (TARGET):</span>
                            <div class="d-flex gap-2">
                                <div v-for="(byte, idx) in targetSequence" :key="'tgt-' + idx"
                                     class="p-2 border border-danger bg-dark text-danger fw-bold text-center"
                                     style="min-width: 50px;">
                                    <span v-text="byte"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Буфер игрока -->
                    <div class="col-md-6">
                        <div class="card bg-black border-secondary rounded-0 p-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-secondary small">БУФЕР ПАМЯТИ:</span>
                                <span class="text-secondary small"><span v-text="playerBuffer.length"></span> / <span v-text="maxBufferSize"></span></span>
                            </div>
                            <div class="d-flex gap-2">
                                <div v-for="bIdx in maxBufferSize" :key="'buf-' + bIdx"
                                     class="p-2 border text-center font-monospace"
                                     :class="playerBuffer[bIdx - 1] ? 'border-warning bg-dark text-warning fw-bold' : 'border-secondary bg-black text-secondary'"
                                     style="min-width: 50px;">
                                    <span v-text="playerBuffer[bIdx - 1] || '__'"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Игровая Киберматрица (Сетка) -->
            <div class="card bg-black border-secondary rounded-0 p-3 mb-3 d-flex align-items-center justify-content-center">
                <div class="text-secondary small mb-2 text-center w-100">
                    МАТРИЦА ШЕСТНАДЦАТЕРИЧНЫХ БАЙТОВ (CYBER MATRIX):
                </div>

                <div class="matrix-grid d-flex flex-column gap-2 user-select-none">
                    <div v-for="(row, r) in matrix" :key="'r-' + r"
                         class="d-flex gap-2 p-1"
                         :class="{ 'border border-danger bg-dark bg-opacity-25': activeDirection === 'row' && activeLineIndex === r }">
                        
                        <button v-for="(cell, c) in row" :key="'c-' + r + '-' + c"
                                @click="selectCell(r, c)"
                                :disabled="!isCellSelectable(r, c)"
                                class="btn rounded-0 font-monospace p-2 fw-bold text-center transition-all"
                                :class="getCellClass(r, c)"
                                style="width: 58px; height: 50px; font-size: 1.15rem;">
                            <span v-if="!cell.used" v-text="cell.val"></span>
                            <span v-else class="text-secondary">--</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="text-secondary small text-center">
                Подсказка: Строка или столбец с красной рамкой является активной зоной для следующего хода.
            </div>

        </div>

        <!-- Экран сбоя (Hardcore Reset) -->
        <div v-else-if="gameState === 'failed'" class="card bg-black border-danger rounded-0 p-5 text-center">
            <h1 id="fail-title" class="display-2 text-danger font-monospace fw-bold mb-3">⚠️ ВЗЛОМ СОРВАН // BREACH COLLAPSE ⚠️</h1>
            <h3 class="text-light font-monospace mb-3">Сработала защита криптографического контура</h3>
            <p class="text-secondary fs-5 mb-4" v-text="failMessage"></p>
            <div class="badge bg-danger text-black p-3 font-monospace fs-6 rounded-0 mb-4">
                ХАРДКОР-СБРОС: Каскадный откат к Волне 1. Все матрицы перегенерированы!
            </div>
            <div>
                <button @click="startGame" class="btn btn-danger btn-lg rounded-0 font-monospace px-5 py-3">
                    ПЕРЕЗАПУСТИТЬ ВЗЛОМ (ВОЛНА 1) →
                </button>
            </div>
        </div>

        <!-- Экран триумфальной победы -->
        <div v-else-if="gameState === 'success'" class="card bg-black border-success rounded-0 p-5 text-center">
            <div id="success-title" class="display-3 text-success font-monospace mb-3">★ ПРОТОКОЛ ПОЛНОСТЬЮ ВЗЛОМАН ★</div>
            <h2 class="text-light font-monospace mb-3">ШЛЮЗ КРИПТОСИСТЕМЫ ПОД ПОЛНЫМ КОНТРОЛЕМ</h2>
            <p class="fs-5 text-secondary mx-auto max-w-lg mb-4">
                Вы успешно преодолели все 8 нарастающих рубежей киберматрицы в экстремальных условиях дефицита времени и жесткого таймера. 
                Криптографические ключи, вектор инициализации, дайджесты SHA-256 и сертификаты X.509 извлечены без единой ошибки!
            </p>
            <div class="badge border border-success text-success bg-dark p-3 font-monospace fs-6 rounded-0">
                Урок 23 завершен на 100%! Получен максимальный рейтинг курса.
            </div>
        </div>

    </div>

    <script src="/static/vue.global.js" is:inline></script>
    <script is:inline>
        const { createApp } = Vue;
        const MISSION_NAME = 'Урок 23 :: Шифрование данных (Уровень 3)';
        const HEX_POOL = ['1C', '55', 'E9', '7A', 'BD', 'FF', '4D', 'A3', 'B2', '6F', 'C0', '9E'];

        const WAVE_CONFIGS = [
            {
                badge: 'ВОЛНА 1: СБОРКА ВЕКТОРА ИНИЦИАЛИЗАЦИИ',
                title: 'Реконструкция блока инициализации (CBC IV-Block)',
                desc: 'Шифр в режиме сцепления блоков CBC требует случайный вектор IV. Извлеките 2 байта инициализации в матрице 4x4.',
                targetLen: 2,
                size: 4,
                maxBuf: 4,
                time: 14
            },
            {
                badge: 'ВОЛНА 2: РАСШИФРОВКА КЛЮЧА AES',
                title: 'Извлечение симметричного мастер-ключа (AES Key Schedule)',
                desc: 'Криптопроцессор загружает раундовые подключи в SP-сеть. Извлеките 2 байта раундового ключа.',
                targetLen: 2,
                size: 4,
                maxBuf: 4,
                time: 13
            },
            {
                badge: 'ВОЛНА 3: СОГЛАСОВАНИЕ КЛЮЧЕЙ ДИФФИ-ХЕЛЛМАНА',
                title: 'Перехват ключевого обмена (Diffie-Hellman Shared Secret)',
                desc: 'Асимметричный протокол согласовывает общий секрет по открытому каналу. Извлеките цепочку из 3 байт в сетке 5x5.',
                targetLen: 3,
                size: 5,
                maxBuf: 5,
                time: 13
            },
            {
                badge: 'ВОЛНА 4: ДАЙДЖЕСТ ЦЕЛОСТНОСТИ SHA-256',
                title: 'Восстановление контрольного дайджеста (SHA-256 Hash)',
                desc: 'Хэш-функция обеспечивает контроль неизменности сообщения. Извлеките последовательность из 3 байт дайджеста.',
                targetLen: 3,
                size: 5,
                maxBuf: 5,
                time: 12
            },
            {
                badge: 'ВОЛНА 5: ОТКРЫТАЯ ЭКСПОНЕНТА RSA',
                title: 'Перехват параметров асимметричного ключа (RSA Public Exponent)',
                desc: 'Асимметричное шифрование использует одностороннюю функцию с лазейкой факторизации. Извлеките 3 байта экспоненты.',
                targetLen: 3,
                size: 5,
                maxBuf: 5,
                time: 12
            },
            {
                badge: 'ВОЛНА 6: НЕЙТРАЛИЗАЦИЯ КОЛЛИЗИИ TWO-TIME PAD',
                title: 'Анализ повторного использования одноразового ключа (OTP Deconfliction)',
                desc: 'Нарушение правила однократности блокнота Вернама привело к утечке C1 ⊕ C2. Извлеките 3 байта маски коллизии.',
                targetLen: 3,
                size: 5,
                maxBuf: 5,
                time: 11
            },
            {
                badge: 'ВОЛНА 7: ВАЛИДАЦИЯ СЕРТИФИКАТА X.509',
                title: 'Проверка цифрового отпечатка удостоверяющего центра (CA Fingerprint)',
                desc: 'Инфраструктура PKI проверяет подлинность открытого ключа. Извлеките цепочку из 4 байтов в матрице 6x6!',
                targetLen: 4,
                size: 6,
                maxBuf: 5,
                time: 11
            },
            {
                badge: 'ВОЛНА 8: ФИНАЛЬНЫЙ БОСС — TLS 1.3 INJECTION',
                title: 'Инъекция сеансового ключа в туннель TLS 1.3 (Master Secret)',
                desc: 'Финальный рубеж: соберите 4 байта мастер-секрета в матрице 6x6 за 10 секунд для полного контроля криптоканала!',
                targetLen: 4,
                size: 6,
                maxBuf: 5,
                time: 10
            }
        ];

        createApp({
            data() {
                return {
                    gameState: 'intro',
                    currentPhase: 1,
                    totalPhases: 8,
                    phaseTimeLeft: 14.0,
                    maxPhaseTime: 14,
                    timerInterval: null,
                    matrix: [],
                    gridSize: 4,
                    activeDirection: 'row',
                    activeLineIndex: 0,
                    targetSequence: [],
                    playerBuffer: [],
                    maxBufferSize: 4,
                    failMessage: '',
                    startTime: null,
                    attemptsCount: 0
                };
            },

            computed: {
                currentWaveInfo() {
                    return WAVE_CONFIGS[this.currentPhase - 1] || WAVE_CONFIGS[0];
                },
                formattedTime() {
                    return Math.max(0, this.phaseTimeLeft).toFixed(1);
                }
            },

            methods: {
                startGame() {
                    this.startTime = Date.now();
                    this.currentPhase = 1;
                    this.gameState = 'playing';

                    window.parent.postMessage({
                        type: 'TELEMETRY_EVENT',
                        mission_name: MISSION_NAME,
                        action_type: 'in_progress',
                        status: 'in_progress',
                        start_time: new Date(this.startTime).toISOString(),
                        time_spent_sec: 0,
                        attempts_count: this.attemptsCount,
                        success: false
                    }, '*');

                    this.loadWave(1);
                },

                loadWave(phase) {
                    if (this.timerInterval) clearInterval(this.timerInterval);

                    const cfg = WAVE_CONFIGS[phase - 1];
                    this.gridSize = cfg.size;
                    this.maxBufferSize = cfg.maxBuf;
                    this.maxPhaseTime = cfg.time;
                    this.phaseTimeLeft = cfg.time;
                    this.playerBuffer = [];
                    this.activeDirection = 'row';
                    this.activeLineIndex = 0; // Всегда начинаем с первой строки

                    // Процедурная генерация целевой последовательности
                    const target = [];
                    for (let i = 0; i < cfg.targetLen; i++) {
                        target.push(HEX_POOL[Math.floor(Math.random() * HEX_POOL.length)]);
                    }
                    this.targetSequence = target;

                    // Создаем пустую матрицу случайных байтов
                    const grid = [];
                    for (let r = 0; r < cfg.size; r++) {
                        const row = [];
                        for (let c = 0; c < cfg.size; c++) {
                            row.push({
                                r, c,
                                val: HEX_POOL[Math.floor(Math.random() * HEX_POOL.length)],
                                used: false
                            });
                        }
                        grid.push(row);
                    }

                    // Гарантируем проходимый путь решения из строки 0:
                    // Ход 0 (в строке 0): выбираем случайный столбец c0
                    let curR = 0;
                    let curC = Math.floor(Math.random() * cfg.size);
                    grid[curR][curC].val = target[0];

                    let nextDir = 'col';
                    for (let i = 1; i < target.length; i++) {
                        if (nextDir === 'col') {
                            let nextR = Math.floor(Math.random() * cfg.size);
                            while (nextR === curR) nextR = Math.floor(Math.random() * cfg.size);
                            curR = nextR;
                            grid[curR][curC].val = target[i];
                            nextDir = 'row';
                        } else {
                            let nextC = Math.floor(Math.random() * cfg.size);
                            while (nextC === curC) nextC = Math.floor(Math.random() * cfg.size);
                            curC = nextC;
                            grid[curR][curC].val = target[i];
                            nextDir = 'col';
                        }
                    }

                    this.matrix = grid;

                    // Запуск локального таймера волны (шаг 100 мс)
                    this.timerInterval = setInterval(() => {
                        this.phaseTimeLeft -= 0.1;
                        if (this.phaseTimeLeft <= 0) {
                            clearInterval(this.timerInterval);
                            this.triggerFail('Тайм-аут протокола! Сессионный криптографический ключ деактивирован сервером.');
                        }
                    }, 100);
                },

                isCellSelectable(r, c) {
                    if (this.matrix[r][c].used) return false;
                    if (this.activeDirection === 'row') {
                        return r === this.activeLineIndex;
                    } else {
                        return c === this.activeLineIndex;
                    }
                },

                getCellClass(r, c) {
                    const cell = this.matrix[r][c];
                    if (cell.used) {
                        return 'btn-outline-secondary opacity-25';
                    }
                    const selectable = this.isCellSelectable(r, c);
                    if (selectable) {
                        return 'btn-outline-danger border-danger text-light shadow-sm';
                    }
                    return 'btn-dark text-secondary border-secondary opacity-50';
                },

                selectCell(r, c) {
                    if (!this.isCellSelectable(r, c)) return;

                    const cell = this.matrix[r][c];
                    cell.used = true;
                    this.playerBuffer.push(cell.val);

                    // Проверка совпадения целевой подпоследовательности
                    if (this.checkTargetAchieved()) {
                        clearInterval(this.timerInterval);
                        if (this.currentPhase >= this.totalPhases) {
                            this.notifyComplete();
                        } else {
                            this.currentPhase++;
                            this.loadWave(this.currentPhase);
                        }
                        return;
                    }

                    // Проверка переполнения буфера
                    if (this.playerBuffer.length >= this.maxBufferSize) {
                        clearInterval(this.timerInterval);
                        this.triggerFail('Буфер памяти переполнен! Неверная цепочка вызвала тревогу криптопроцессора.');
                        return;
                    }

                    // Переключение направления Строка ↔ Столбец
                    if (this.activeDirection === 'row') {
                        this.activeDirection = 'col';
                        this.activeLineIndex = c;
                    } else {
                        this.activeDirection = 'row';
                        this.activeLineIndex = r;
                    }
                },

                checkTargetAchieved() {
                    const buf = this.playerBuffer;
                    const tgt = this.targetSequence;
                    if (buf.length < tgt.length) return false;

                    for (let i = 0; i <= buf.length - tgt.length; i++) {
                        let match = true;
                        for (let j = 0; j < tgt.length; j++) {
                            if (buf[i + j] !== tgt[j]) {
                                match = false;
                                break;
                            }
                        }
                        if (match) return true;
                    }
                    return false;
                },

                triggerFail(msg) {
                    this.attemptsCount++;
                    this.failMessage = msg;
                    this.gameState = 'failed';

                    window.parent.postMessage({
                        type: 'TELEMETRY_EVENT',
                        mission_name: MISSION_NAME,
                        action_type: 'hardcore_reset',
                        status: 'in_progress',
                        start_time: new Date(this.startTime).toISOString(),
                        time_spent_sec: Math.floor((Date.now() - this.startTime) / 1000),
                        attempts_count: this.attemptsCount,
                        success: false
                    }, '*');
                },

                notifyComplete() {
                    clearInterval(this.timerInterval);
                    const totalSec = Math.floor((Date.now() - this.startTime) / 1000);
                    this.gameState = 'success';

                    window.parent.postMessage({
                        type: 'TELEMETRY_EVENT',
                        mission_name: MISSION_NAME,
                        action_type: 'level_complete',
                        status: 'completed',
                        start_time: new Date(this.startTime).toISOString(),
                        time_spent_sec: totalSec,
                        attempts_count: this.attemptsCount,
                        success: true
                    }, '*');
                }
            }
        }).mount('#app');
    </script>
</TaskLayout>
