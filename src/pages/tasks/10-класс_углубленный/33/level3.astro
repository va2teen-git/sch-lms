            },
            {
                waveNumber: 9,
                title: `Инвариант степеней (в СС ${w9Q})`,
                directive: `Выражение переводится в систему счисления с основанием q = ${w9Q}. Не возводя огромные числа вручную, вычислите и передайте СУММУ ВСЕХ ЦИФР результата.`,
                frames: [
                    {
                        tag: 'АРИФМЕТИЧЕСКИЙ ИМПУЛЬС',
                        baseLabel: `ЦЕЛЕВАЯ СС: ${w9Q} (${w9P} = ${w9Q}^${w9S})`,
                        accentClass: 'border-danger',
                        formulaParts: [
                            { base: w9P, exp: w9M },
                            { op: '+' },
                            { base: w9Q, exp: w9K },
