        const w9S = pick([2, 3]);
        const w9M = w9S === 2 ? pick([2, 3]) : 2;
        const maxExp = w9S * w9M; // >= 4
        const w9K = maxExp === 4 ? 3 : randInt(3, Math.min(5, maxExp - 1));
        const w9R = randInt(1, Math.min(2, w9K - 1));
