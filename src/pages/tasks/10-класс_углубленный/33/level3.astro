        // Волна 7: Пик инверсии — калибровка неизвестного основания x
        const w7X = randInt(5, 14);
        const w7D2 = randInt(1, Math.min(3, w7X - 1));
        const w7D1 = randInt(1, Math.min(5, w7X - 1));
        const w7D0 = randInt(1, Math.min(6, w7X - 1));
