---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={1}>
    <div class="container my-4 font-monospace">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 text-success mb-0">Тренажер: RSA и цифровая стеганография (Уровень 1)</h2>
            <span class="badge border border-success text-success bg-dark rounded-0 px-3 py-2">Манипуляция мышью // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-success rounded-0">
            <div class="card-body p-4">

                <!-- Заголовок и индикатор прогресса -->
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="phase-badge" class="badge bg-success text-dark rounded-0 fs-6 me-2">Шаг 1 из 3</span>
                        <span id="phase-title" class="text-light fw-bold fs-6">Архитектурный конструктор криптосистемы RSA</span>
                    </div>
                    <div class="text-secondary small">
                        Попытки: <span id="attempts-display" class="text-warning">0</span> | Время: <span id="timer-display" class="text-info">00:00</span>
                    </div>
                </div>

                <!-- Системный баннер ошибки / сброса -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between">
                        <span>[КРИПТОГРАФИЧЕСКИЙ СБОЙ] <span id="feedback-text">Неверное действие!</span> Перегенерация варианта...</span>
                        <span class="spinner-border spinner-border-sm text-danger" role="status"></span>
                    </div>
                </div>

                <!-- ФАЗА 1: Архитектурный конструктор RSA (Slot & Snap) -->
                <div id="phase1" class="phase-container">
                    <p class="text-light mb-3">
                        Для генерации ключевой пары и функционирования криптосистемы RSA требуется выстроить строгую математическую последовательность этапов.
                        Используя мышь, <strong>перетащите блоки операций</strong> (или кликните по блоку, затем по целевому слоту) в правильные позиции сверху вниз (от шага 1 к шагу 6).
                        Остерегайтесь математических ошибок и дистракторов!
                    </p>

                    <!-- Пул доступных блоков -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary small">ДОСТУПНЫЕ МАТЕМАТИЧЕСКИЕ БЛОКИ (ПЕРЕТАЩИТЕ В СЛОТЫ НИЖЕ):</span>
                            <button id="p1-reset-btn" type="button" class="btn btn-sm btn-outline-secondary rounded-0 text-secondary">
                                Сбросить в пул
                            </button>
                        </div>
                        <div id="p1-blocks-pool" class="d-flex flex-wrap gap-2 p-2 border border-dashed border-secondary bg-dark min-vh-10">
                            <!-- Блоки генерируются динамически через JS -->
                        </div>
                    </div>

                    <!-- Целевые слоты архитектуры RSA -->
                    <div class="card bg-black border-success rounded-0 p-3 mb-4">
                        <div class="text-secondary small mb-3">ПРОТОКОЛ КРИПТОСИСТЕМЫ RSA (ПОСЛЕДОВАТЕЛЬНОСТЬ ЭТАПОВ):</div>
                        <div class="d-flex flex-column gap-3">
                            <!-- Слот 1 -->
                            <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark" data-step="1">
                                <div class="text-secondary small mb-1 fw-bold text-success">ЭТАП 1: ИНИЦИАЛИЗАЦИЯ ИСТОЧНИКА ПРОСТЫХ ЧИСЕЛ</div>
                                <div class="pipeline-slot p-2 border border-dashed border-success min-vh-5 bg-black d-flex align-items-center" data-slot="1">
                                    <span class="text-secondary small placeholder-text">Перетащите сюда блок этапа 1...</span>
                                </div>
                            </div>

                            <!-- Слот 2 -->
                            <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark" data-step="2">
                                <div class="text-secondary small mb-1 fw-bold text-info">ЭТАП 2: ВЫЧИСЛЕНИЕ ОТКРЫТОГО МОДУЛЯ СИСТЕМЫ</div>
                                <div class="pipeline-slot p-2 border border-dashed border-info min-vh-5 bg-black d-flex align-items-center" data-slot="2">
                                    <span class="text-secondary small placeholder-text">Перетащите сюда блок этапа 2...</span>
                                </div>
                            </div>

                            <!-- Слот 3 -->
                            <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark" data-step="3">
                                <div class="text-secondary small mb-1 fw-bold text-warning">ЭТАП 3: ВЫЧИСЛЕНИЕ ЗАКРЫТОЙ ФУНКЦИИ ЭЙЛЕРА</div>
                                <div class="pipeline-slot p-2 border border-dashed border-warning min-vh-5 bg-black d-flex align-items-center" data-slot="3">
                                    <span class="text-secondary small placeholder-text">Перетащите сюда блок этапа 3...</span>
                                </div>
                            </div>

                            <!-- Слот 4 -->
                            <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark" data-step="4">
                                <div class="text-secondary small mb-1 fw-bold text-primary">ЭТАП 4: ПОДБОР ОТКРЫТОЙ ЭКСПОНЕНТЫ ШИФРОВАНИЯ</div>
                                <div class="pipeline-slot p-2 border border-dashed border-primary min-vh-5 bg-black d-flex align-items-center" data-slot="4">
                                    <span class="text-secondary small placeholder-text">Перетащите сюда блок этапа 4...</span>
                                </div>
                            </div>

                            <!-- Слот 5 -->
                            <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark" data-step="5">
                                <div class="text-secondary small mb-1 fw-bold text-danger">ЭТАП 5: РАСЧЕТ СЕКРЕТНОЙ ЭКСПОНЕНТЫ РАСШИФРОВАНИЯ</div>
                                <div class="pipeline-slot p-2 border border-dashed border-danger min-vh-5 bg-black d-flex align-items-center" data-slot="5">
                                    <span class="text-secondary small placeholder-text">Перетащите сюда блок этапа 5...</span>
                                </div>
                            </div>

                            <!-- Слот 6 -->
                            <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark" data-step="6">
                                <div class="text-secondary small mb-1 fw-bold text-success">ЭТАП 6: ПРЕОБРАЗОВАНИЕ СООБЩЕНИЯ (ЗАШИФРОВАНИЕ И РАСШИФРОВАНИЕ)</div>
                                <div class="pipeline-slot p-2 border border-dashed border-success min-vh-5 bg-black d-flex align-items-center" data-slot="6">
                                    <span class="text-secondary small placeholder-text">Перетащите сюда блок этапа 6...</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p1-verify-btn" type="button" class="btn btn-success rounded-0 px-4 py-2 font-monospace fw-bold">
                            СИНТЕЗИРОВАТЬ КРИПТОСИСТЕМУ RSA →
                        </button>
                    </div>
                </div>

                <!-- ФАЗА 2: Интерактивная LSB-лента пикселей (Interactive Grid / Tape Manipulation) -->
                <div id="phase2" class="phase-container d-none">
                    <p class="text-light mb-3">
                        В стеганографическом модуле требуется скрыть секретный символ в 24-битное растровое RGB-изображение методом наименьшего значащего бита (**LSB**).
                        Кликая по кнопкам младших разрядов (LSB), <strong>настройте значения 8 бит</strong> так, чтобы результирующий байт совпал с двоичным кодом целевого символа.
                    </p>

                    <div class="row g-3 mb-4">
                        <!-- Карточка целевого символа -->
                        <div class="col-md-4">
                            <div class="card bg-black border-info rounded-0 p-3 h-100">
                                <span class="text-secondary small mb-1">ЦЕЛЕВОЙ СЕКРЕТНЫЙ СИМВОЛ:</span>
                                <div class="d-flex align-items-center gap-3 my-2">
                                    <span id="p2-target-char" class="display-4 text-info fw-bold bg-dark px-3 py-1 border border-info">?</span>
                                    <div>
                                        <div class="text-light small">ASCII Код: <span id="p2-target-ascii" class="text-warning fw-bold">--</span></div>
                                        <div class="text-secondary small">Размер: 1 байт (8 бит)</div>
                                    </div>
                                </div>

                                <span class="text-secondary small mb-1">ТРЕБУЕМЫЙ ДВОИЧНЫЙ КОД (LSB-ПОСЛЕДОВАТЕЛЬНОСТЬ):</span>
                                <div id="p2-target-bin" class="fs-4 text-warning fw-bold tracking-widest p-2 bg-dark border border-warning text-center">
                                    --------
                                </div>

                                <div class="mt-3 p-2 bg-dark border border-secondary text-secondary small">
                                    <div class="text-light mb-1">ПРАВИЛО LSB:</div>
                                    Младший бит (разряд 0) заменяется на бит полезной нагрузки без заметного изменения цвета пикселя (±0.39% яркости).
                                </div>
                            </div>
                        </div>

                        <!-- Интерактивная лента цветовых каналов -->
                        <div class="col-md-8">
                            <div class="card bg-black border-success rounded-0 p-3 h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-secondary small">ЦВЕТОВЫЕ КАНАЛЫ RGB-РАСТРА (КЛИКАЙТЕ LSB ДЛЯ ПЕРЕКЛЮЧЕНИЯ):</span>
                                        <span id="p2-match-indicator" class="badge bg-secondary text-dark rounded-0">Совпадение: 0 / 8 бит</span>
                                    </div>

                                    <!-- Сетка из 8 цветовых каналов -->
                                    <div id="p2-channels-grid" class="d-flex flex-column gap-2">
                                        <!-- Генерируется через JS -->
                                    </div>
                                </div>

                                <div class="mt-3 pt-3 border-top border-secondary d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="text-secondary small">ТЕКУЩАЯ LSB-СТРОКА: </span>
                                        <span id="p2-current-bin" class="text-info fw-bold fs-5">00000000</span>
                                        <span class="text-secondary small ms-2">СИМВОЛ: </span>
                                        <span id="p2-current-char" class="text-success fw-bold fs-5">[ ? ]</span>
                                    </div>
                                    <button id="p2-verify-btn" type="button" class="btn btn-success rounded-0 px-4 py-2 font-monospace fw-bold">
                                        ЗАФИКСИРОВАТЬ СТЕГАНОГРАММУ →
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ФАЗА 3: Сортировка по контейнерам (Drag-to-Bucket) -->
                <div id="phase3" class="phase-container d-none">
                    <p class="text-light mb-3">
                        Система безопасности зафиксировала комплексный поток криптографических и стеганографических механизмов.
                        Используя мышь, <strong>перетащите каждую карточку</strong> (или кликните по карточке, затем по контейнеру) в соответствующий класс защиты информации.
                    </p>

                    <!-- Пул карточек -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary small">ПРИМИТИВЫ И МЕХАНИЗМЫ ИБ (ПЕРЕТАЩИТЕ В ЦЕЛЕВЫЕ КОНТЕЙНЕРЫ):</span>
                            <button id="p3-reset-btn" type="button" class="btn btn-sm btn-outline-secondary rounded-0 text-secondary">
                                Сбросить в пул
                            </button>
                        </div>
                        <div id="p3-cards-pool" class="d-flex flex-wrap gap-2 p-2 border border-dashed border-secondary bg-dark min-vh-10">
                            <!-- Карточки генерируются динамически через JS -->
                        </div>
                    </div>

                    <!-- 3 целевых контейнера -->
                    <div class="row g-3 mb-4">
                        <!-- Бакет 1: RSA -->
                        <div class="col-md-4">
                            <div class="card bg-black border-success rounded-0 h-100 target-bucket" data-category="rsa" id="bucket-rsa">
                                <div class="card-header bg-dark border-bottom border-success text-success d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold">1. АСИММЕТРИЧНЫЙ RSA</span>
                                    <span class="badge border border-success text-success bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Ключевая пара (K<sub>pub</sub>, K<sub>priv</sub>), открытая/закрытая экспоненты, функция Эйлера φ(n), факторизация n=p·q, цифровая подпись ЭЦП.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-success bg-dark d-flex flex-column gap-2 min-vh-20">
                                        <!-- Карточки -->
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Бакет 2: Стеганография -->
                        <div class="col-md-4">
                            <div class="card bg-black border-info rounded-0 h-100 target-bucket" data-category="stego" id="bucket-stego">
                                <div class="card-header bg-dark border-bottom border-info text-info d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold">2. ЦИФРОВАЯ СТЕГАНОГРАФИЯ</span>
                                    <span class="badge border border-info text-info bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Сокрытие факта передачи, метод LSB, невидимые пробелы ZWSP, коэффициенты ДКП JPEG, внедрение за маркером EOF, стеганоанализ.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-info bg-dark d-flex flex-column gap-2 min-vh-20">
                                        <!-- Карточки -->
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Бакет 3: Симметричное шифрование -->
                        <div class="col-md-4">
                            <div class="card bg-black border-warning rounded-0 h-100 target-bucket" data-category="symmetric" id="bucket-symmetric">
                                <div class="card-header bg-dark border-bottom border-warning text-warning d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold">3. СИММЕТРИЧНЫЕ ШИФРЫ</span>
                                    <span class="badge border border-warning text-warning bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Единый секретный ключ K, высокая скорость, AES-256, ГОСТ «Кузнечик», потоковый ChaCha20, сцепление блоков CBC с IV.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-warning bg-dark d-flex flex-column gap-2 min-vh-20">
                                        <!-- Карточки -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p3-verify-btn" type="button" class="btn btn-success rounded-0 px-4 py-2 font-monospace fw-bold">
                            ПРОВЕРИТЬ КЛАССИФИКАЦИЮ →
                        </button>
                    </div>
                </div>

                <!-- Экран победы -->
                <div id="success-screen" class="phase-container d-none text-center py-5">
                    <div class="mb-3 text-success font-monospace display-4">✓ УРОВЕНЬ 1 УСПЕШНО ПРОЙДЕН</div>
                    <h3 class="text-light font-monospace mb-3">Архитектура RSA и цифровая стеганография освоены</h3>
                    <p class="text-secondary max-w-md mx-auto mb-4">
                        Вы успешно собрали архитектурный протокол алгоритма RSA, внедрили секретный символ в цветовую LSB-ленту растрового RGB-изображения и классифицировали ключевые технологии информационной безопасности.
                    </p>
                    <div class="badge border border-success text-success bg-black p-3 font-monospace fs-6 rounded-0">
                        Переходите к Уровню 2 (Аналитические расчеты и ручной ввод) на верхней панели!
                    </div>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(function() {
    // ----------------------------------------------------
    // СОСТОЯНИЕ И ТЕЛЕМЕТРИЯ
    // ----------------------------------------------------
    const MISSION_NAME = 'Урок 24 :: Алгоритм шифрования RSA. Стеганография (Уровень 1)';
    const startTime = Date.now();
    let attempts = 0;
    let currentPhase = 1;
    let isProcessingError = false;

    // Таймер
    setInterval(() => {
        const elapsedSec = Math.floor((Date.now() - startTime) / 1000);
        const mins = String(Math.floor(elapsedSec / 60)).padStart(2, '0');
        const secs = String(elapsedSec % 60).padStart(2, '0');
        const el = document.getElementById('timer-display');
        if (el) el.textContent = mins + ':' + secs;
    }, 1000);

    function updateAttempts() {
        const el = document.getElementById('attempts-display');
        if (el) el.textContent = String(attempts);
    }

    function sendTelemetry(actionType, status, success) {
        const elapsedSec = Math.round((Date.now() - startTime) / 1000);
        if (window.parent) {
            window.parent.postMessage({
                type: 'TELEMETRY_EVENT',
                mission_name: MISSION_NAME,
                action_type: actionType,
                status: status,
                start_time: new Date(startTime).toISOString(),
                time_spent_sec: elapsedSec,
                attempts_count: attempts,
                success: success
            }, '*');
        }
    }

    // Инициализация при загрузке
    sendTelemetry('in_progress', 'in_progress', false);

    function triggerError(msg, callback) {
        if (isProcessingError) return;
        isProcessingError = true;
        attempts++;
        updateAttempts();
        sendTelemetry('hardcore_reset', 'in_progress', false);

        const feedbackBox = document.getElementById('feedback-box');
        const feedbackText = document.getElementById('feedback-text');
        if (feedbackBox && feedbackText) {
            feedbackText.textContent = msg;
            feedbackBox.classList.remove('d-none');
        }

        setTimeout(() => {
            if (feedbackBox) feedbackBox.classList.add('d-none');
            isProcessingError = false;
            if (callback) callback();
        }, 1300);
    }

    function setPhase(phaseNum) {
        currentPhase = phaseNum;
        ['phase1', 'phase2', 'phase3', 'success-screen'].forEach((id, idx) => {
            const el = document.getElementById(id);
            if (!el) return;
            if (idx + 1 === phaseNum) {
                el.classList.remove('d-none');
            } else {
                el.classList.add('d-none');
            }
        });

        const badge = document.getElementById('phase-badge');
        const title = document.getElementById('phase-title');
        if (phaseNum === 1) {
            if (badge) badge.textContent = 'Шаг 1 из 3';
            if (title) title.textContent = 'Архитектурный конструктор криптосистемы RSA';
        } else if (phaseNum === 2) {
            if (badge) badge.textContent = 'Шаг 2 из 3';
            if (title) title.textContent = 'Интерактивная LSB-лента пикселей';
        } else if (phaseNum === 3) {
            if (badge) badge.textContent = 'Шаг 3 из 3';
            if (title) title.textContent = 'Классификация механизмов защиты по бакетам';
        } else if (phaseNum === 4) {
            if (badge) badge.textContent = 'Победа!';
            if (title) title.textContent = 'Уровень 1 завершен';
            const screen = document.getElementById('success-screen');
            if (screen) screen.classList.remove('d-none');
            sendTelemetry('level_complete', 'completed', true);
        }
    }

    // ----------------------------------------------------
    // ФАЗА 1: Архитектурный конструктор RSA (Slot & Snap)
    // ----------------------------------------------------
    const P1_CORRECT_BLOCKS = [
        { id: 'p1-b1', step: 1, title: 'Генерация простых p и q', formula: 'p, q ∈ Primes (p ≠ q)', desc: 'Случайный выбор двух больших независимых простых чисел' },
        { id: 'p1-b2', step: 2, title: 'Вычисление модуля n', formula: 'n = p · q', desc: 'Модуль открытого и закрытого ключей, битовая длина системы' },
        { id: 'p1-b3', step: 3, title: 'Функция Эйлера φ(n)', formula: 'φ(n) = (p - 1) · (q - 1)', desc: 'Количество чисел, взаимно простых с n (строгий секрет)' },
        { id: 'p1-b4', step: 4, title: 'Открытая экспонента e', formula: '1 < e < φ(n), НОД(e, φ(n)) = 1', desc: 'Экспонента шифрования (стандарт e = 65537)' },
        { id: 'p1-b5', step: 5, title: 'Секретная экспонента d', formula: '(e · d) mod φ(n) = 1', desc: 'Обратный элемент по модулю Эйлера (алгоритм Евклида)' },
        { id: 'p1-b6', step: 6, title: 'Шифрование и расшифрование', formula: 'C = M^e mod n | M = C^d mod n', desc: 'Прямое и обратное степенное преобразование по модулю n' }
    ];

    const P1_DISTRACTORS = [
        { id: 'p1-d1', step: null, title: 'Модуль сложением', formula: 'n = p + q', desc: 'ОШИБКА: модуль вычисляется умножением, а не сложением' },
        { id: 'p1-d2', step: null, title: 'Функция Эйлера с плюсом', formula: 'φ(n) = (p + 1) · (q + 1)', desc: 'ОШИБКА: формула требует вычитания единиц' },
        { id: 'p1-d3', step: null, title: 'Обратная экспонента по модулю n', formula: '(e · d) mod n = 1', desc: 'ОШИБКА: экспонента d вычисляется по mod φ(n), а не mod n' },
        { id: 'p1-d4', step: null, title: 'Зашифрование закрытым ключом', formula: 'C = M^d mod n', desc: 'ОШИБКА: зашифрование использует e (d используется для ЭЦП)' }
    ];

    let p1SelectedBlock = null;

    function initPhase1() {
        const pool = document.getElementById('p1-blocks-pool');
        if (!pool) return;
        pool.innerHTML = '';

        // Очистить слоты
        document.querySelectorAll('#phase1 .pipeline-slot').forEach(slot => {
            slot.innerHTML = '<span class="text-secondary small placeholder-text">Перетащите сюда блок этапа ' + slot.dataset.slot + '...</span>';
            slot.classList.remove('bg-dark');
            slot.classList.add('bg-black');
        });

        // Объединить и перемешать 6 правильных + 3 случайных дистрактора
        const shuffledDistractors = [...P1_DISTRACTORS].sort(() => Math.random() - 0.5).slice(0, 3);
        const allBlocks = [...P1_CORRECT_BLOCKS, ...shuffledDistractors].sort(() => Math.random() - 0.5);

        allBlocks.forEach(item => {
            const card = document.createElement('div');
            card.id = item.id;
            card.className = 'card bg-dark border-secondary rounded-0 p-2 text-light font-monospace cursor-pointer user-select-none p1-draggable-block';
            card.style.cursor = 'grab';
            card.style.minWidth = '220px';
            card.style.maxWidth = '300px';
            card.draggable = true;
            card.dataset.blockId = item.id;
            if (item.step) card.dataset.correctStep = String(item.step);

            card.innerHTML = `
                <div class="fw-bold text-success small mb-1">${item.title}</div>
                <div class="badge bg-black border border-secondary text-info rounded-0 p-1 mb-1 font-monospace text-wrap">${item.formula}</div>
                <div class="text-secondary small" style="font-size: 0.75rem;">${item.desc}</div>
            `;

            // Drag and drop события
            card.addEventListener('dragstart', (e) => {
                e.dataTransfer.setData('text/plain', item.id);
                card.classList.add('opacity-50');
            });

            card.addEventListener('dragend', () => {
                card.classList.remove('opacity-50');
            });

            // Клик для выбора
            card.addEventListener('click', (e) => {
                e.stopPropagation();
                if (p1SelectedBlock === card) {
                    card.classList.remove('border-warning', 'border-2');
                    p1SelectedBlock = null;
                } else {
                    if (p1SelectedBlock) {
                        p1SelectedBlock.classList.remove('border-warning', 'border-2');
                    }
                    p1SelectedBlock = card;
                    card.classList.add('border-warning', 'border-2');
                }
            });

            pool.appendChild(card);
        });

        // Настройка слотов как дропзон
        document.querySelectorAll('#phase1 .pipeline-slot').forEach(slot => {
            slot.addEventListener('dragover', (e) => {
                e.preventDefault();
                slot.classList.add('border-white');
            });

            slot.addEventListener('dragleave', () => {
                slot.classList.remove('border-white');
            });

            slot.addEventListener('drop', (e) => {
                e.preventDefault();
                slot.classList.remove('border-white');
                const blockId = e.dataTransfer.getData('text/plain');
                const blockEl = document.getElementById(blockId);
                if (blockEl) {
                    placeBlockInSlot(blockEl, slot);
                }
            });

            slot.addEventListener('click', () => {
                if (p1SelectedBlock) {
                    placeBlockInSlot(p1SelectedBlock, slot);
                    p1SelectedBlock.classList.remove('border-warning', 'border-2');
                    p1SelectedBlock = null;
                }
            });
        });

        // Дропзона пула для возврата
        pool.addEventListener('dragover', (e) => e.preventDefault());
        pool.addEventListener('drop', (e) => {
            e.preventDefault();
            const blockId = e.dataTransfer.getData('text/plain');
            const blockEl = document.getElementById(blockId);
            if (blockEl) {
                returnBlockToPool(blockEl);
            }
        });
        pool.addEventListener('click', () => {
            if (p1SelectedBlock && p1SelectedBlock.parentElement !== pool) {
                returnBlockToPool(p1SelectedBlock);
                p1SelectedBlock.classList.remove('border-warning', 'border-2');
                p1SelectedBlock = null;
            }
        });
    }

    function placeBlockInSlot(blockEl, slot) {
        // Если в слоте уже есть блок — вернуть старый в пул
        const existingBlock = slot.querySelector('.p1-draggable-block');
        if (existingBlock && existingBlock !== blockEl) {
            returnBlockToPool(existingBlock);
        }

        const placeholder = slot.querySelector('.placeholder-text');
        if (placeholder) placeholder.remove();

        slot.appendChild(blockEl);
        slot.classList.remove('bg-black');
        slot.classList.add('bg-dark');
    }

    function returnBlockToPool(blockEl) {
        const pool = document.getElementById('p1-blocks-pool');
        const parentSlot = blockEl.closest('.pipeline-slot');
        if (parentSlot) {
            parentSlot.classList.remove('bg-dark');
            parentSlot.classList.add('bg-black');
            if (!parentSlot.querySelector('.placeholder-text')) {
                parentSlot.innerHTML = '<span class="text-secondary small placeholder-text">Перетащите сюда блок этапа ' + parentSlot.dataset.slot + '...</span>';
            }
        }
        if (pool) pool.appendChild(blockEl);
    }

    document.getElementById('p1-reset-btn')?.addEventListener('click', () => {
        document.querySelectorAll('#phase1 .p1-draggable-block').forEach(b => returnBlockToPool(b));
    });

    document.getElementById('p1-verify-btn')?.addEventListener('click', () => {
        if (isProcessingError) return;

        let allFilled = true;
        let isCorrect = true;

        for (let step = 1; step <= 6; step++) {
            const slot = document.querySelector('#phase1 .pipeline-slot[data-slot="' + step + '"]');
            const block = slot ? slot.querySelector('.p1-draggable-block') : null;
            if (!block) {
                allFilled = false;
                break;
            }
            if (block.dataset.correctStep !== String(step)) {
                isCorrect = false;
            }
        }

        if (!allFilled) {
            triggerError('Заполните все 6 этапов криптографического протокола RSA!');
            return;
        }

        if (!isCorrect) {
            triggerError('Нарушена математическая логика RSA или использованы дистракторы!', () => {
                initPhase1();
            });
            return;
        }

        // Успех Фазы 1
        setPhase(2);
        initPhase2();
    });

    // ----------------------------------------------------
    // ФАЗА 2: Интерактивная LSB-лента пикселей
    // ----------------------------------------------------
    const P2_CHARS = ['R', 'S', 'A', 'K', 'E', 'Y', 'B', 'I', 'T', 'O', 'P', 'X'];
    let p2TargetChar = 'R';
    let p2TargetBin = '01010010';
    let p2Channels = [];

    function initPhase2() {
        // Случайный целевой символ
        p2TargetChar = P2_CHARS[Math.floor(Math.random() * P2_CHARS.length)];
        const ascii = p2TargetChar.charCodeAt(0);
        p2TargetBin = ascii.toString(2).padStart(8, '0');

        document.getElementById('p2-target-char').textContent = p2TargetChar;
        document.getElementById('p2-target-ascii').textContent = String(ascii);
        document.getElementById('p2-target-bin').textContent = p2TargetBin;

        // Генерация 8 цветовых каналов со случайными базовыми байтами
        // Канал: R1, G1, B1, R2, G2, B2, R3, G3
        const channelLabels = [
            'Пиксель 1 [Red]', 'Пиксель 1 [Green]', 'Пиксель 1 [Blue]',
            'Пиксель 2 [Red]', 'Пиксель 2 [Green]', 'Пиксель 2 [Blue]',
            'Пиксель 3 [Red]', 'Пиксель 3 [Green]'
        ];

        p2Channels = [];
        for (let i = 0; i < 8; i++) {
            // Случайное число от 64 до 240
            const baseDecimal = Math.floor(Math.random() * 170) + 64;
            // Обнуляем младший бит базы: baseDecimal & 254
            const baseEven = baseDecimal & 254;
            // Исходный случайный LSB (намеренно не всегда совпадающий)
            const initialLsb = Math.random() > 0.5 ? 1 : 0;
            p2Channels.push({
                label: channelLabels[i],
                highBits: (baseEven >> 1).toString(2).padStart(7, '0'),
                baseEven: baseEven,
                currentLsb: initialLsb
            });
        }

        renderPhase2Grid();
    }

    function renderPhase2Grid() {
        const grid = document.getElementById('p2-channels-grid');
        if (!grid) return;
        grid.innerHTML = '';

        let currentBits = '';

        p2Channels.forEach((ch, idx) => {
            currentBits += String(ch.currentLsb);
            const currentDecimal = ch.baseEven | ch.currentLsb;
            const targetBit = p2TargetBin[idx];
            const isMatch = String(ch.currentLsb) === targetBit;

            const row = document.createElement('div');
            row.className = 'd-flex align-items-center justify-content-between p-2 bg-dark border ' +
                            (isMatch ? 'border-secondary' : 'border-warning') + ' rounded-0 font-monospace';

            row.innerHTML = `
                <div class="d-flex align-items-center gap-2">
                    <span class="badge ${idx < 3 ? 'bg-danger text-light' : idx < 6 ? 'bg-success text-dark' : 'bg-primary text-light'} rounded-0" style="width: 130px; font-size: 0.75rem;">
                        ${ch.label}
                    </span>
                    <span class="text-secondary small">Старшие биты:</span>
                    <span class="text-light fw-bold">${ch.highBits}</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-1">
                        <span class="text-secondary small">LSB:</span>
                        <button type="button" class="btn btn-sm ${ch.currentLsb === 1 ? 'btn-success' : 'btn-outline-success'} fw-bold px-3 py-1 rounded-0 lsb-toggle-btn" data-idx="${idx}">
                            ${ch.currentLsb}
                        </button>
                    </div>
                    <div class="text-end" style="width: 140px;">
                        <span class="text-secondary small">Значение: </span>
                        <span class="text-info fw-bold">${currentDecimal}</span>
                        <span class="small ${isMatch ? 'text-success' : 'text-warning'}">${isMatch ? '✓' : '✗'}</span>
                    </div>
                </div>
            `;

            grid.appendChild(row);
        });

        // Навешивание кликов на LSB тумблеры
        grid.querySelectorAll('.lsb-toggle-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const idx = parseInt(btn.dataset.idx, 10);
                p2Channels[idx].currentLsb = p2Channels[idx].currentLsb === 1 ? 0 : 1;
                renderPhase2Grid();
            });
        });

        // Обновление индикаторов
        const currentBinEl = document.getElementById('p2-current-bin');
        if (currentBinEl) currentBinEl.textContent = currentBits;

        const charVal = parseInt(currentBits, 2);
        const charStr = charVal >= 32 && charVal <= 126 ? String.fromCharCode(charVal) : '?';
        const currentCharEl = document.getElementById('p2-current-char');
        if (currentCharEl) currentCharEl.textContent = `[ ${charStr} ] (Код: ${charVal})`;

        let matchCount = 0;
        for (let i = 0; i < 8; i++) {
            if (currentBits[i] === p2TargetBin[i]) matchCount++;
        }

        const indicator = document.getElementById('p2-match-indicator');
        if (indicator) {
            indicator.textContent = `Совпадение: ${matchCount} / 8 бит`;
            if (matchCount === 8) {
                indicator.className = 'badge bg-success text-dark rounded-0';
            } else {
                indicator.className = 'badge bg-warning text-dark rounded-0';
            }
        }
    }

    document.getElementById('p2-verify-btn')?.addEventListener('click', () => {
        if (isProcessingError) return;

        let assembledBin = '';
        p2Channels.forEach(ch => assembledBin += String(ch.currentLsb));

        if (assembledBin !== p2TargetBin) {
            triggerError('Битовая последовательность LSB не соответствует двоичному коду символа ' + p2TargetChar + '!', () => {
                initPhase2();
            });
            return;
        }

        // Успех Фазы 2
        setPhase(3);
        initPhase3();
    });

    // ----------------------------------------------------
    // ФАЗА 3: Сортировка по контейнерам (Drag-to-Bucket)
    // ----------------------------------------------------
    const P3_BANK = [
        // RSA
        { id: 'c-rsa-1', cat: 'rsa', title: 'Ключевая пара (K_pub, K_priv)', desc: 'Разделение ключей для зашифрования и расшифрования' },
        { id: 'c-rsa-2', cat: 'rsa', title: 'Открытая экспонента e = 65537', desc: 'Число Ферма 2^16 + 1, взаимно простое с φ(n)' },
        { id: 'c-rsa-3', cat: 'rsa', title: 'Секретная экспонента d', desc: 'Вычисляется через расширенный алгоритм Евклида' },
        { id: 'c-rsa-4', cat: 'rsa', title: 'Факторизация модуля n = p · q', desc: 'Математическая основа криптостойкости алгоритма' },
        { id: 'c-rsa-5', cat: 'rsa', title: 'Функция Эйлера φ(n)', desc: 'φ(n) = (p - 1) · (q - 1), количество взаимно простых чисел' },
        { id: 'c-rsa-6', cat: 'rsa', title: 'Электронная цифровая подпись (ЭЦП)', desc: 'Шифрование хэш-образа документа закрытым ключом: S = H^d mod n' },

        // Steganography
        { id: 'c-stego-1', cat: 'stego', title: 'Метод LSB (младший значащий бит)', desc: 'Замещение 0-го разряда цветовых каналов RGB-пикселей' },
        { id: 'c-stego-2', cat: 'stego', title: 'Невидимые символы Unicode (ZWSP)', desc: 'Кодирование бит нулевой шириной пробелов U+200B' },
        { id: 'c-stego-3', cat: 'stego', title: 'Коэффициенты ДКП в JPEG (JSteg)', desc: 'Внедрение бит в матрицу частотного сжатия DCT' },
        { id: 'c-stego-4', cat: 'stego', title: 'Внедрение за маркером EOF (FF D9)', desc: 'Дописывание зашифрованных данных за концом файла JPEG' },
        { id: 'c-stego-5', cat: 'stego', title: 'Стеганоанализ (тест Хи-квадрат)', desc: 'Статистическое выявление выравнивания пар значений PoV' },
        { id: 'c-stego-6', cat: 'stego', title: 'Анализ битовых плоскостей', desc: 'Выделение нулевой LSB-плоскости для поиска геометрических аномалий' },

        // Symmetric
        { id: 'c-sym-1', cat: 'symmetric', title: 'Единый секретный ключ K', desc: 'K_enc = K_dec, требует предварительного защищенного обмена' },
        { id: 'c-sym-2', cat: 'symmetric', title: 'Алгоритм AES-256 (Rijndael)', desc: 'Международный стандарт блочного шифрования (SP-сеть)' },
        { id: 'c-sym-3', cat: 'symmetric', title: 'ГОСТ Р 34.12-2015 «Кузнечик»', desc: 'Российский стандарт блочного шифрования (размер блока 128 бит)' },
        { id: 'c-sym-4', cat: 'symmetric', title: 'Потоковый шифр ChaCha20', desc: 'Сверхскоростное побитовое гаммирование для потокового трафика' },
        { id: 'c-sym-5', cat: 'symmetric', title: 'Режим сцепления блоков CBC с IV', desc: 'Использование вектора инициализации для исключения структурных повторов' },
        { id: 'c-sym-6', cat: 'symmetric', title: 'Проблема распределения ключей', desc: 'Квадратичный комбинаторный взрыв числа ключей K = N·(N-1)/2' }
    ];

    let p3SelectedCard = null;

    function initPhase3() {
        const pool = document.getElementById('p3-cards-pool');
        if (!pool) return;
        pool.innerHTML = '';

        // Очистить бакеты
        document.querySelectorAll('#phase3 .bucket-slot').forEach(slot => {
            slot.innerHTML = '';
        });
        updateBucketCounts();

        // Отобрать по 3 карточки каждого класса
        const rsaCards = P3_BANK.filter(c => c.cat === 'rsa').sort(() => Math.random() - 0.5).slice(0, 3);
        const stegoCards = P3_BANK.filter(c => c.cat === 'stego').sort(() => Math.random() - 0.5).slice(0, 3);
        const symCards = P3_BANK.filter(c => c.cat === 'symmetric').sort(() => Math.random() - 0.5).slice(0, 3);

        const currentCards = [...rsaCards, ...stegoCards, ...symCards].sort(() => Math.random() - 0.5);

        currentCards.forEach(item => {
            const card = document.createElement('div');
            card.id = item.id;
            card.className = 'card bg-dark border-secondary rounded-0 p-2 text-light font-monospace cursor-pointer user-select-none p3-draggable-card';
            card.style.cursor = 'grab';
            card.style.minWidth = '220px';
            card.style.maxWidth = '290px';
            card.draggable = true;
            card.dataset.category = item.cat;
            card.dataset.cardId = item.id;

            card.innerHTML = `
                <div class="fw-bold text-light small mb-1">${item.title}</div>
                <div class="text-secondary small" style="font-size: 0.75rem;">${item.desc}</div>
            `;

            // Drag and drop
            card.addEventListener('dragstart', (e) => {
                e.dataTransfer.setData('text/plain', item.id);
                card.classList.add('opacity-50');
            });
            card.addEventListener('dragend', () => {
                card.classList.remove('opacity-50');
            });

            // Клик для выбора
            card.addEventListener('click', (e) => {
                e.stopPropagation();
                if (p3SelectedCard === card) {
                    card.classList.remove('border-warning', 'border-2');
                    p3SelectedCard = null;
                } else {
                    if (p3SelectedCard) p3SelectedCard.classList.remove('border-warning', 'border-2');
                    p3SelectedCard = card;
                    card.classList.add('border-warning', 'border-2');
                }
            });

            pool.appendChild(card);
        });

        // Навешивание событий на бакеты
        document.querySelectorAll('#phase3 .target-bucket').forEach(bucket => {
            const slot = bucket.querySelector('.bucket-slot');

            bucket.addEventListener('dragover', (e) => {
                e.preventDefault();
                bucket.classList.add('border-white');
            });
            bucket.addEventListener('dragleave', () => {
                bucket.classList.remove('border-white');
            });
            bucket.addEventListener('drop', (e) => {
                e.preventDefault();
                bucket.classList.remove('border-white');
                const cardId = e.dataTransfer.getData('text/plain');
                const cardEl = document.getElementById(cardId);
                if (cardEl && slot) {
                    slot.appendChild(cardEl);
                    updateBucketCounts();
                }
            });

            bucket.addEventListener('click', () => {
                if (p3SelectedCard && slot) {
                    slot.appendChild(p3SelectedCard);
                    p3SelectedCard.classList.remove('border-warning', 'border-2');
                    p3SelectedCard = null;
                    updateBucketCounts();
                }
            });
        });

        // Дропзона пула для возврата
        pool.addEventListener('dragover', (e) => e.preventDefault());
        pool.addEventListener('drop', (e) => {
            e.preventDefault();
            const cardId = e.dataTransfer.getData('text/plain');
            const cardEl = document.getElementById(cardId);
            if (cardEl) {
                pool.appendChild(cardEl);
                updateBucketCounts();
            }
        });
        pool.addEventListener('click', () => {
            if (p3SelectedCard && p3SelectedCard.parentElement !== pool) {
                pool.appendChild(p3SelectedCard);
                p3SelectedCard.classList.remove('border-warning', 'border-2');
                p3SelectedCard = null;
                updateBucketCounts();
            }
        });
    }

    function updateBucketCounts() {
        document.querySelectorAll('#phase3 .target-bucket').forEach(bucket => {
            const count = bucket.querySelectorAll('.p3-draggable-card').length;
            const badge = bucket.querySelector('.count-badge');
            if (badge) badge.textContent = String(count);
        });
    }

    document.getElementById('p3-reset-btn')?.addEventListener('click', () => {
        const pool = document.getElementById('p3-cards-pool');
        document.querySelectorAll('#phase3 .p3-draggable-card').forEach(c => pool?.appendChild(c));
        updateBucketCounts();
    });

    document.getElementById('p3-verify-btn')?.addEventListener('click', () => {
        if (isProcessingError) return;

        const pool = document.getElementById('p3-cards-pool');
        const remainingInPool = pool?.querySelectorAll('.p3-draggable-card').length || 0;
        if (remainingInPool > 0) {
            triggerError('Распределите все карточки по трем контейнерам!');
            return;
        }

        let isCorrect = true;
        document.querySelectorAll('#phase3 .target-bucket').forEach(bucket => {
            const targetCat = bucket.dataset.category;
            bucket.querySelectorAll('.p3-draggable-card').forEach(card => {
                if (card.dataset.category !== targetCat) {
                    isCorrect = false;
                }
            });
        });

        if (!isCorrect) {
            triggerError('Обнаружены ошибки в классификации технологий информационной безопасности!', () => {
                initPhase3();
            });
            return;
        }

        // Завершение Уровня 1!
        setPhase(4);
    });

    // ----------------------------------------------------
    // СТАРТ
    // ----------------------------------------------------
    initPhase1();
})();
</script>
