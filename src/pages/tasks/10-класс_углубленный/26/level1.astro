---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={1}>
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 text-success mb-0">Тренажер: Информация, данные, знания и информационные процессы (Уровень 1)</h2>
            <span class="badge border border-success text-success bg-dark rounded-0 px-3 py-2">Манипуляция мышью // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-success rounded-0">
            <div class="card-body p-3 p-md-4">

                <!-- Заголовок и индикатор прогресса -->
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="phase-badge" class="badge bg-success text-dark rounded-0 fs-6 me-2">Шаг 1 из 3</span>
                        <span id="phase-title" class="text-light fw-bold fs-6">Иерархия DIKW: сырые данные, информация, декларативные и процедурные знания</span>
                    </div>
                    <div class="text-secondary small">
                        Попытки: <span id="attempts-display" class="text-warning">0</span> | Время: <span id="timer-display" class="text-info">00:00</span>
                    </div>
                </div>

                <!-- Системный баннер ошибки / сброса -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between">
                        <span>[СИСТЕМНЫЙ СБОЙ] <span id="feedback-text">Неверное действие!</span> Перегенерация варианта...</span>
                        <span class="spinner-border spinner-border-sm text-danger" role="status"></span>
                    </div>
                </div>

                <!-- ФАЗА 1: Сортировка по контейнерам DIKW (Drag-to-Bucket) -->
                <div id="phase1" class="phase-container">
                    <p class="text-light mb-3">
                        В информационно-аналитический узел поступил поток разнородных объектов.
                        Используя мышь, <strong>перетащите каждую карточку</strong> (или кликните по карточке, затем по целевому контейнеру) в один из четырех уровней иерархии DIKW и инженерии знаний.
                    </p>

                    <!-- Пул карточек Фазы 1 -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary small">ВХОДНОЙ ПОТОК ОБЪЕКТОВ (ПЕРЕТАЩИТЕ В ЦЕЛЕВЫЕ КОНТЕЙНЕРЫ):</span>
                            <button id="p1-reset-btn" type="button" class="btn btn-sm btn-outline-secondary rounded-0 text-secondary">
                                Сбросить в пул
                            </button>
                        </div>
                        <div id="p1-cards-pool" class="d-flex flex-wrap gap-2 p-2 border border-dashed border-secondary bg-dark min-vh-10">
                            <!-- Карточки генерируются динамически через JS -->
                        </div>
                    </div>

                    <!-- 4 целевых контейнера Фазы 1 -->
                    <div class="row g-2 mb-3">
                        <!-- Бакет 1: Сырые данные (Data) -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-secondary rounded-0 h-100 target-bucket-p1" data-category="data" id="bucket-data">
                                <div class="card-header bg-dark border-bottom border-secondary text-light d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold small">1. СЫРЫЕ ДАННЫЕ (DATA)</span>
                                    <span class="badge border border-secondary text-light bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Зарегистрированные сигналы, коды и числа без контекста и правил интерпретации.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-secondary bg-dark d-flex flex-column gap-2" style="min-height: 150px;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Бакет 2: Информация (Information) -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-info rounded-0 h-100 target-bucket-p1" data-category="info" id="bucket-info">
                                <div class="card-header bg-dark border-bottom border-info text-info d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold small">2. ИНФОРМАЦИЯ (INFORMATION)</span>
                                    <span class="badge border border-info text-info bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Осмысленные данные, помещенные в конкретный контекст и снабженные интерпретацией.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-info bg-dark d-flex flex-column gap-2" style="min-height: 150px;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Бакет 3: Декларативные знания -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-warning rounded-0 h-100 target-bucket-p1" data-category="declarative" id="bucket-declarative">
                                <div class="card-header bg-dark border-bottom border-warning text-warning d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold small">3. ДЕКЛАРАТИВНЫЕ («ЗНАЮ ЧТО»)</span>
                                    <span class="badge border border-warning text-warning bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Научные законы, аксиомы, определения и фундаментальные свойства объектов.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-warning bg-dark d-flex flex-column gap-2" style="min-height: 150px;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Бакет 4: Процедурные знания -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-success rounded-0 h-100 target-bucket-p1" data-category="procedural" id="bucket-procedural">
                                <div class="card-header bg-dark border-bottom border-success text-success d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold small">4. ПРОЦЕДУРНЫЕ («ЗНАЮ КАК»)</span>
                                    <span class="badge border border-success text-success bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Пошаговые алгоритмы, инструкции и методики преобразования объектов для достижения цели.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-success bg-dark d-flex flex-column gap-2" style="min-height: 150px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p1-verify-btn" type="button" class="btn btn-success rounded-0 px-4 py-2 font-monospace fw-bold">
                            ВЕРИФИЦИРОВАТЬ ИЕРАРХИЮ DIKW →
                        </button>
                    </div>
                </div>

                <!-- ФАЗА 2: Архитектурный конструктор Шеннона и Винера (Slot & Snap) -->
                <div id="phase2" class="phase-container d-none">
                    <p class="text-light mb-3">
                        Соберите единую структурную схему <strong>канала передачи информации К. Шеннона</strong> и <strong>кибернетического контура управления Н. Винера с обратной связью</strong>.
                        Перетащите функциональные узлы (или кликните по блоку, затем по целевому слоту) в строгой последовательности этапов от 1 до 6. Остерегайтесь ошибочных дистракторов!
                    </p>

                    <!-- Пул доступных блоков Фазы 2 -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary small">ДОСТУПНЫЕ ФУНКЦИОНАЛЬНЫЕ БЛОКИ (ПЕРЕТАЩИТЕ В СЛОТЫ СХЕМЫ НИЖЕ):</span>
                            <button id="p2-reset-btn" type="button" class="btn btn-sm btn-outline-secondary rounded-0 text-secondary">
                                Сбросить в пул
                            </button>
                        </div>
                        <div id="p2-blocks-pool" class="d-flex flex-wrap gap-2 p-2 border border-dashed border-secondary bg-dark min-vh-10">
                            <!-- Блоки генерируются динамически через JS -->
                        </div>
                    </div>

                    <!-- Целевые слоты Фазы 2 -->
                    <div class="card bg-black border-success rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-2">КАНАЛ СВЯЗИ ШЕННОНА И КОНТУР УПРАВЛЕНИЯ С ОБРАТНОЙ СВЯЗЬЮ (ЭТАПЫ 1–6):</div>
                        <div class="row g-2">
                            <!-- Слот 1 -->
                            <div class="col-12 col-md-6">
                                <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark h-100" data-step="1">
                                    <div class="text-secondary small mb-1 fw-bold text-success">УЗЕЛ 1: ГЕНЕРАЦИЯ ИСХОДНОГО СООБЩЕНИЯ</div>
                                    <div class="pipeline-slot p-2 border border-dashed border-success bg-black d-flex align-items-center" style="min-height: 64px;" data-slot="1">
                                        <span class="text-secondary small placeholder-text">Перетащите сюда блок узла 1...</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Слот 2 -->
                            <div class="col-12 col-md-6">
                                <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark h-100" data-step="2">
                                    <div class="text-secondary small mb-1 fw-bold text-info">УЗЕЛ 2: Прямое преобразование в сигнал</div>
                                    <div class="pipeline-slot p-2 border border-dashed border-info bg-black d-flex align-items-center" style="min-height: 64px;" data-slot="2">
                                        <span class="text-secondary small placeholder-text">Перетащите сюда блок узла 2...</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Слот 3 -->
                            <div class="col-12 col-md-6">
                                <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark h-100" data-step="3">
                                    <div class="text-secondary small mb-1 fw-bold text-warning">УЗЕЛ 3: ФИЗИЧЕСКАЯ СРЕДА ПЕРЕДАЧИ И ПОМЕХИ</div>
                                    <div class="pipeline-slot p-2 border border-dashed border-warning bg-black d-flex align-items-center" style="min-height: 64px;" data-slot="3">
                                        <span class="text-secondary small placeholder-text">Перетащите сюда блок узла 3...</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Слот 4 -->
                            <div class="col-12 col-md-6">
                                <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark h-100" data-step="4">
                                    <div class="text-secondary small mb-1 fw-bold text-primary">УЗЕЛ 4: ВОССТАНОВЛЕНИЕ СООБЩЕНИЯ ИЗ СИГНАЛА</div>
                                    <div class="pipeline-slot p-2 border border-dashed border-primary bg-black d-flex align-items-center" style="min-height: 64px;" data-slot="4">
                                        <span class="text-secondary small placeholder-text">Перетащите сюда блок узла 4...</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Слот 5 -->
                            <div class="col-12 col-md-6">
                                <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark h-100" data-step="5">
                                    <div class="text-secondary small mb-1 fw-bold text-danger">УЗЕЛ 5: ПРЯМАЯ СВЯЗЬ В КОНТУРЕ УПРАВЛЕНИЯ</div>
                                    <div class="pipeline-slot p-2 border border-dashed border-danger bg-black d-flex align-items-center" style="min-height: 64px;" data-slot="5">
                                        <span class="text-secondary small placeholder-text">Перетащите сюда блок узла 5...</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Слот 6 -->
                            <div class="col-12 col-md-6">
                                <div class="pipeline-slot-wrapper p-2 border border-secondary bg-dark h-100" data-step="6">
                                    <div class="text-secondary small mb-1 fw-bold text-success">УЗЕЛ 6: ЦЕПЬ ОБРАТНОЙ СВЯЗИ КОНТУРА ВИНЕРА</div>
                                    <div class="pipeline-slot p-2 border border-dashed border-success bg-black d-flex align-items-center" style="min-height: 64px;" data-slot="6">
                                        <span class="text-secondary small placeholder-text">Перетащите сюда блок узла 6...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p2-verify-btn" type="button" class="btn btn-success rounded-0 px-4 py-2 font-monospace fw-bold">
                            ЗАПУСТИТЬ КОНТУР ШЕННОНА — ВИНЕРА →
                        </button>
                    </div>
                </div>

                <!-- ФАЗА 3: Классификация 4 типов обработки информации (Drag-to-Bucket) -->
                <div id="phase3" class="phase-container d-none">
                    <p class="text-light mb-3">
                        Согласно курсу К. Ю. Полякова, все операции по обработке информации делятся на <strong>четыре фундаментальных типа</strong>.
                        Используя мышь, <strong>перетащите каждую операцию</strong> (или кликните по карточке, затем по контейнеру) в соответствующий класс информационного процесса.
                    </p>

                    <!-- Пул карточек Фазы 3 -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary small">ОПЕРАЦИИ ОБРАБОТКИ ИНФОРМАЦИИ (ПЕРЕТАЩИТЕ В ЦЕЛЕВЫЕ КОНТЕЙНЕРЫ):</span>
                            <button id="p3-reset-btn" type="button" class="btn btn-sm btn-outline-secondary rounded-0 text-secondary">
                                Сбросить в пул
                            </button>
                        </div>
                        <div id="p3-cards-pool" class="d-flex flex-wrap gap-2 p-2 border border-dashed border-secondary bg-dark min-vh-10">
                            <!-- Карточки генерируются динамически через JS -->
                        </div>
                    </div>

                    <!-- 4 целевых контейнера Фазы 3 -->
                    <div class="row g-2 mb-3">
                        <!-- Бакет 1: Получение новой информации -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-success rounded-0 h-100 target-bucket-p3" data-category="create" id="bucket-create">
                                <div class="card-header bg-dark border-bottom border-success text-success d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold small">1. ПОЛУЧЕНИЕ НОВОЙ ИНФОРМАЦИИ</span>
                                    <span class="badge border border-success text-success bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Вычисления по формулам, логический вывод и принятие решений с созданием новых сведений.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-success bg-dark d-flex flex-column gap-2" style="min-height: 150px;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Бакет 2: Изменение формы представления -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-info rounded-0 h-100 target-bucket-p3" data-category="encode" id="bucket-encode">
                                <div class="card-header bg-dark border-bottom border-info text-info d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold small">2. ИЗМЕНЕНИЕ ФОРМЫ (КОДИРОВАНИЕ)</span>
                                    <span class="badge border border-info text-info bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Смена знаковой системы, шифрование или сжатие при полном сохранении исходного смысла.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-info bg-dark d-flex flex-column gap-2" style="min-height: 150px;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Бакет 3: Структурирование (систематизация) -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-warning rounded-0 h-100 target-bucket-p3" data-category="structure" id="bucket-structure">
                                <div class="card-header bg-dark border-bottom border-warning text-warning d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold small">3. СТРУКТУРИРОВАНИЕ ДАННЫХ</span>
                                    <span class="badge border border-warning text-warning bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Сортировка, группировка, индексирование, построение таблиц, графов и каталогов.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-warning bg-dark d-flex flex-column gap-2" style="min-height: 150px;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Бакет 4: Поиск информации -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-primary rounded-0 h-100 target-bucket-p3" data-category="search" id="bucket-search">
                                <div class="card-header bg-dark border-bottom border-primary text-primary d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold small">4. ПОИСК ИНФОРМАЦИИ</span>
                                    <span class="badge border border-primary text-primary bg-black rounded-0 count-badge">0</span>
                                </div>
                                <div class="card-body p-2 d-flex flex-column">
                                    <p class="text-secondary small mb-2">Извлечение из хранилища подмножества записей, удовлетворяющих заданному критерию запроса.</p>
                                    <div class="bucket-slot flex-grow-1 p-2 border border-primary bg-dark d-flex flex-column gap-2" style="min-height: 150px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p3-verify-btn" type="button" class="btn btn-success rounded-0 px-4 py-2 font-monospace fw-bold">
                            ПРОВЕРИТЬ КЛАССИФИКАЦИЮ ПРОЦЕССОВ →
                        </button>
                    </div>
                </div>

                <!-- Экран победы -->
                <div id="success-screen" class="phase-container d-none text-center py-5">
                    <div class="mb-3 text-success font-monospace display-4">✓ УРОВЕНЬ 1 УСПЕШНО ПРОЙДЕН</div>
                    <h3 class="text-light font-monospace mb-3">Иерархия DIKW, схема Шеннона — Винера и информационные процессы освоены</h3>
                    <p class="text-secondary max-w-md mx-auto mb-4">
                        Вы безошибочно разграничили сырые данные, информацию, декларативные и процедурные знания, сконструировали помехоустойчивый канал связи и контур обратной связи, а также классифицировали четыре типа обработки информации.
                    </p>
                    <div class="badge border border-success text-success bg-black p-3 font-monospace fs-6 rounded-0">
                        Переходите к Уровню 2 (Аналитические расчеты по формулам Шеннона и Харкевича) на верхней панели!
                    </div>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(function() {
    // ----------------------------------------------------
    // СОСТОЯНИЕ И ТЕЛЕМЕТРИЯ
    // ----------------------------------------------------
    const MISSION_NAME = 'Урок 26 :: Информация, данные и знания. Информационные процессы в природе, технике и обществе (Уровень 1)';
    const startTime = Date.now();
    let attempts = 0;
    let currentPhase = 1;
    let isProcessingError = false;

    // Таймер
    setInterval(() => {
        const elapsedSec = Math.floor((Date.now() - startTime) / 1000);
        const mins = String(Math.floor(elapsedSec / 60)).padStart(2, '0');
        const secs = String(elapsedSec % 60).padStart(2, '0');
        const el = document.getElementById('timer-display');
        if (el) el.textContent = mins + ':' + secs;
    }, 1000);

    function updateAttempts() {
        const el = document.getElementById('attempts-display');
        if (el) el.textContent = String(attempts);
    }

    function sendTelemetry(actionType, status, success) {
        const elapsedSec = Math.round((Date.now() - startTime) / 1000);
        if (window.parent) {
            window.parent.postMessage({
                type: 'TELEMETRY_EVENT',
                mission_name: MISSION_NAME,
                action_type: actionType,
                status: status,
                start_time: new Date(startTime).toISOString(),
                time_spent_sec: elapsedSec,
                attempts_count: attempts,
                success: success
            }, '*');
        }
    }

    // Инициализация при загрузке
    sendTelemetry('in_progress', 'in_progress', false);

    function triggerError(msg, callback) {
        if (isProcessingError) return;
        isProcessingError = true;
        attempts++;
        updateAttempts();
        sendTelemetry('hardcore_reset', 'in_progress', false);

        const feedbackBox = document.getElementById('feedback-box');
        const feedbackText = document.getElementById('feedback-text');
        if (feedbackBox && feedbackText) {
            feedbackText.textContent = msg;
            feedbackBox.classList.remove('d-none');
        }

        setTimeout(() => {
            if (feedbackBox) feedbackBox.classList.add('d-none');
            isProcessingError = false;
            if (callback) callback();
        }, 1300);
    }

    function setPhase(phaseNum) {
        currentPhase = phaseNum;
        ['phase1', 'phase2', 'phase3', 'success-screen'].forEach((id, idx) => {
            const el = document.getElementById(id);
            if (!el) return;
            if (idx + 1 === phaseNum) {
                el.classList.remove('d-none');
            } else {
                el.classList.add('d-none');
            }
        });

        const badge = document.getElementById('phase-badge');
        const title = document.getElementById('phase-title');
        if (phaseNum === 1) {
            if (badge) badge.textContent = 'Шаг 1 из 3';
            if (title) title.textContent = 'Иерархия DIKW: сырые данные, информация, декларативные и процедурные знания';
        } else if (phaseNum === 2) {
            if (badge) badge.textContent = 'Шаг 2 из 3';
            if (title) title.textContent = 'Конструктор канала связи Шеннона и контура управления Винера';
        } else if (phaseNum === 3) {
            if (badge) badge.textContent = 'Шаг 3 из 3';
            if (title) title.textContent = 'Классификация четырех типов обработки информации';
        } else if (phaseNum === 4) {
            if (badge) badge.textContent = 'Победа!';
            if (title) title.textContent = 'Уровень 1 завершен';
            const screen = document.getElementById('success-screen');
            if (screen) screen.classList.remove('d-none');
            sendTelemetry('level_complete', 'completed', true);
        }
    }

