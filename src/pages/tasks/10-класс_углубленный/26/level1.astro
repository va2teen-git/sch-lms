    let p1SelectedCard = null;
    let p1ListenersBound = false;

    function initPhase1() {
        const pool = document.getElementById('p1-cards-pool');
        if (!pool) return;
        pool.innerHTML = '';
        p1SelectedCard = null;

        document.querySelectorAll('#phase1 .bucket-slot').forEach(slot => {
            slot.innerHTML = '';
        });
        updateP1BucketCounts();

        // Отобрать по 2 карточки каждого из 4 классов (всего 8 карточек)
        const dataCards = P1_BANK.filter(c => c.cat === 'data').sort(() => Math.random() - 0.5).slice(0, 2);
        const infoCards = P1_BANK.filter(c => c.cat === 'info').sort(() => Math.random() - 0.5).slice(0, 2);
        const declCards = P1_BANK.filter(c => c.cat === 'declarative').sort(() => Math.random() - 0.5).slice(0, 2);
        const procCards = P1_BANK.filter(c => c.cat === 'procedural').sort(() => Math.random() - 0.5).slice(0, 2);

        const currentCards = [...dataCards, ...infoCards, ...declCards, ...procCards].sort(() => Math.random() - 0.5);

        currentCards.forEach(item => {
            const card = document.createElement('div');
            card.id = item.id;
            card.className = 'card bg-dark border-secondary rounded-0 p-2 text-light font-monospace cursor-pointer user-select-none p1-draggable-card';
            card.style.cursor = 'grab';
            card.style.minWidth = '210px';
            card.style.maxWidth = '280px';
            card.draggable = true;
            card.dataset.category = item.cat;
            card.dataset.cardId = item.id;

            card.innerHTML = `
                <div class="fw-bold text-light small mb-1">${item.title}</div>
                <div class="text-secondary small" style="font-size: 0.75rem;">${item.desc}</div>
            `;

            card.addEventListener('dragstart', (e) => {
                e.dataTransfer.setData('text/plain', item.id);
                card.classList.add('opacity-50');
            });
            card.addEventListener('dragend', () => {
                card.classList.remove('opacity-50');
            });

            card.addEventListener('click', (e) => {
                e.stopPropagation();
                if (p1SelectedCard === card) {
                    card.classList.remove('border-warning', 'border-2');
                    p1SelectedCard = null;
                } else {
                    if (p1SelectedCard) p1SelectedCard.classList.remove('border-warning', 'border-2');
                    p1SelectedCard = card;
                    card.classList.add('border-warning', 'border-2');
                }
            });

            pool.appendChild(card);
        });

        if (!p1ListenersBound) {
            p1ListenersBound = true;
            document.querySelectorAll('#phase1 .target-bucket-p1').forEach(bucket => {
                const slot = bucket.querySelector('.bucket-slot');

                bucket.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    bucket.classList.add('border-white');
                });
                bucket.addEventListener('dragleave', () => {
                    bucket.classList.remove('border-white');
                });
                bucket.addEventListener('drop', (e) => {
                    e.preventDefault();
                    bucket.classList.remove('border-white');
                    const cardId = e.dataTransfer.getData('text/plain');
                    const cardEl = document.getElementById(cardId);
                    if (cardEl && cardEl.classList.contains('p1-draggable-card') && slot) {
                        slot.appendChild(cardEl);
                        updateP1BucketCounts();
                    }
                });

                bucket.addEventListener('click', () => {
                    if (p1SelectedCard && slot) {
                        slot.appendChild(p1SelectedCard);
                        p1SelectedCard.classList.remove('border-warning', 'border-2');
                        p1SelectedCard = null;
                        updateP1BucketCounts();
                    }
                });
            });

            pool.addEventListener('dragover', (e) => e.preventDefault());
            pool.addEventListener('drop', (e) => {
                e.preventDefault();
                const cardId = e.dataTransfer.getData('text/plain');
                const cardEl = document.getElementById(cardId);
                if (cardEl && cardEl.classList.contains('p1-draggable-card')) {
                    pool.appendChild(cardEl);
                    updateP1BucketCounts();
                }
            });
            pool.addEventListener('click', () => {
                if (p1SelectedCard && p1SelectedCard.parentElement !== pool) {
                    pool.appendChild(p1SelectedCard);
                    p1SelectedCard.classList.remove('border-warning', 'border-2');
                    p1SelectedCard = null;
                    updateP1BucketCounts();
                }
            });
        }
    }

    function updateP1BucketCounts() {
        document.querySelectorAll('#phase1 .target-bucket-p1').forEach(bucket => {
            const count = bucket.querySelectorAll('.p1-draggable-card').length;
            const badge = bucket.querySelector('.count-badge');
            if (badge) badge.textContent = String(count);
        });
    }

    document.getElementById('p1-reset-btn')?.addEventListener('click', () => {
        const pool = document.getElementById('p1-cards-pool');
        document.querySelectorAll('#phase1 .p1-draggable-card').forEach(c => pool?.appendChild(c));
        updateP1BucketCounts();
    });

    document.getElementById('p1-verify-btn')?.addEventListener('click', () => {
        if (isProcessingError) return;

        const pool = document.getElementById('p1-cards-pool');
        const remaining = pool?.querySelectorAll('.p1-draggable-card').length || 0;
        if (remaining > 0) {
            triggerError('Распределите все 8 карточек из входного пула по четырем контейнерам DIKW!');
            return;
        }

        let isCorrect = true;
        document.querySelectorAll('#phase1 .target-bucket-p1').forEach(bucket => {
            const targetCat = bucket.dataset.category;
            bucket.querySelectorAll('.p1-draggable-card').forEach(card => {
                if (card.dataset.category !== targetCat) {
                    isCorrect = false;
                }
            });
        });

        if (!isCorrect) {
            triggerError('Ошибка в классификации уровней пирамиды DIKW или видов знаний!', () => {
                initPhase1();
            });
            return;
        }

        setPhase(2);
        initPhase2();
    });

    // ----------------------------------------------------
    // ФАЗА 2: Архитектурный конструктор Шеннона и Винера (Slot & Snap)
    // ----------------------------------------------------
    const P2_CORRECT_BLOCKS = [
        { id: 'p2-b1', step: 1, title: 'Источник информации', formula: 'Генерация сообщения M (энтропия H)', desc: 'Формирует исходное сообщение из алфавита состояний для передачи' },
        { id: 'p2-b2', step: 2, title: 'Кодирующее устройство (Передатчик)', formula: 'Сообщение M → Сигнал S(t)', desc: 'Преобразует дискретное сообщение в физический сигнал (модуляция и помехоустойчивый код)' },
        { id: 'p2-b3', step: 3, title: 'Канал связи под воздействием Шума', formula: 'Сигнал S(t) + Помехи ξ(t) → S*(t)', desc: 'Физическая среда распространения, в которой на сигнал накладываются внешние помехи' },
