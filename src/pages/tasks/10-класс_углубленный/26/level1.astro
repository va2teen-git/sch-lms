    ];

    const P2_DISTRACTORS = [
        { id: 'p2-d1', step: null, title: 'Генератор шума внутри Контроллера', formula: 'Алгоритм + Шум ξ(t) → Сбой', desc: 'ОШИБКА: источник помех в схеме Шеннона воздействует на канал связи, а не на алгоритм' },
        { id: 'p2-d2', step: null, title: 'Инверсная прямая связь', formula: 'Объект управления → Команды → Контроллер', desc: 'ОШИБКА: объект управления не отдает команды управляющему устройству' },
        { id: 'p2-d3', step: null, title: 'Прямой прием без Декодера', formula: 'Физический сигнал S*(t) → Сразу в Тезаурус', desc: 'ОШИБКА: приемник не может интерпретировать модулированный сигнал без декодирования' }
    ];

    let p2SelectedBlock = null;
    let p2ListenersBound = false;

    function initPhase2() {
        const pool = document.getElementById('p2-blocks-pool');
        if (!pool) return;
        pool.innerHTML = '';
        p2SelectedBlock = null;

        document.querySelectorAll('#phase2 .pipeline-slot').forEach(slot => {
            slot.innerHTML = '<span class="text-secondary small placeholder-text">Перетащите сюда блок узла ' + slot.dataset.slot + '...</span>';
            slot.classList.remove('bg-dark');
            slot.classList.add('bg-black');
        });

        const shuffledDistractors = [...P2_DISTRACTORS].sort(() => Math.random() - 0.5).slice(0, 2);
        const allBlocks = [...P2_CORRECT_BLOCKS, ...shuffledDistractors].sort(() => Math.random() - 0.5);

        allBlocks.forEach(item => {
            const card = document.createElement('div');
            card.id = item.id;
            card.className = 'card bg-dark border-secondary rounded-0 p-2 text-light font-monospace cursor-pointer user-select-none p2-draggable-block';
            card.style.cursor = 'grab';
            card.style.minWidth = '220px';
            card.style.maxWidth = '310px';
            card.draggable = true;
            card.dataset.blockId = item.id;
            if (item.step) card.dataset.correctStep = String(item.step);

            card.innerHTML = `
                <div class="fw-bold text-success small mb-1">${item.title}</div>
                <div class="badge bg-black border border-secondary text-info rounded-0 p-1 mb-1 font-monospace text-wrap">${item.formula}</div>
                <div class="text-secondary small" style="font-size: 0.75rem;">${item.desc}</div>
            `;

            card.addEventListener('dragstart', (e) => {
                e.dataTransfer.setData('text/plain', item.id);
                card.classList.add('opacity-50');
            });

            card.addEventListener('dragend', () => {
                card.classList.remove('opacity-50');
            });

            card.addEventListener('click', (e) => {
                e.stopPropagation();
                if (p2SelectedBlock === card) {
                    card.classList.remove('border-warning', 'border-2');
                    p2SelectedBlock = null;
                } else {
                    if (p2SelectedBlock) {
                        p2SelectedBlock.classList.remove('border-warning', 'border-2');
                    }
                    p2SelectedBlock = card;
                    card.classList.add('border-warning', 'border-2');
                }
            });

            pool.appendChild(card);
        });

        if (!p2ListenersBound) {
            p2ListenersBound = true;
            document.querySelectorAll('#phase2 .pipeline-slot').forEach(slot => {
                slot.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    slot.classList.add('border-white');
                });

                slot.addEventListener('dragleave', () => {
                    slot.classList.remove('border-white');
                });

                slot.addEventListener('drop', (e) => {
                    e.preventDefault();
                    slot.classList.remove('border-white');
                    const blockId = e.dataTransfer.getData('text/plain');
                    const blockEl = document.getElementById(blockId);
                    if (blockEl && blockEl.classList.contains('p2-draggable-block')) {
                        placeP2BlockInSlot(blockEl, slot);
                    }
                });

                slot.addEventListener('click', () => {
                    if (p2SelectedBlock) {
                        placeP2BlockInSlot(p2SelectedBlock, slot);
                        p2SelectedBlock.classList.remove('border-warning', 'border-2');
                        p2SelectedBlock = null;
                    }
                });
            });

            pool.addEventListener('dragover', (e) => e.preventDefault());
            pool.addEventListener('drop', (e) => {
                e.preventDefault();
                const blockId = e.dataTransfer.getData('text/plain');
                const blockEl = document.getElementById(blockId);
                if (blockEl && blockEl.classList.contains('p2-draggable-block')) {
                    returnP2BlockToPool(blockEl);
                }
            });
            pool.addEventListener('click', () => {
                if (p2SelectedBlock && p2SelectedBlock.parentElement !== pool) {
                    returnP2BlockToPool(p2SelectedBlock);
                    p2SelectedBlock.classList.remove('border-warning', 'border-2');
                    p2SelectedBlock = null;
                }
            });
        }
    }

    function placeP2BlockInSlot(blockEl, slot) {
        const existingBlock = slot.querySelector('.p2-draggable-block');
        if (existingBlock && existingBlock !== blockEl) {
            returnP2BlockToPool(existingBlock);
        }

        const parentSlot = blockEl.closest('.pipeline-slot');
        if (parentSlot && parentSlot !== slot) {
            parentSlot.classList.remove('bg-dark');
            parentSlot.classList.add('bg-black');
            if (!parentSlot.querySelector('.placeholder-text')) {
                parentSlot.innerHTML = '<span class="text-secondary small placeholder-text">Перетащите сюда блок узла ' + parentSlot.dataset.slot + '...</span>';
            }
        }

        const placeholder = slot.querySelector('.placeholder-text');
        if (placeholder) placeholder.remove();

        slot.appendChild(blockEl);
        slot.classList.remove('bg-black');
        slot.classList.add('bg-dark');
    }

    function returnP2BlockToPool(blockEl) {
        const pool = document.getElementById('p2-blocks-pool');
        const parentSlot = blockEl.closest('.pipeline-slot');
        if (parentSlot) {
            parentSlot.classList.remove('bg-dark');
            parentSlot.classList.add('bg-black');
            if (!parentSlot.querySelector('.placeholder-text')) {
                parentSlot.innerHTML = '<span class="text-secondary small placeholder-text">Перетащите сюда блок узла ' + parentSlot.dataset.slot + '...</span>';
            }
        }
        if (pool) pool.appendChild(blockEl);
    }

    document.getElementById('p2-reset-btn')?.addEventListener('click', () => {
        document.querySelectorAll('#phase2 .p2-draggable-block').forEach(b => returnP2BlockToPool(b));
    });

    document.getElementById('p2-verify-btn')?.addEventListener('click', () => {
        if (isProcessingError) return;

        let allFilled = true;
        let isCorrect = true;

        for (let step = 1; step <= 6; step++) {
            const slot = document.querySelector('#phase2 .pipeline-slot[data-slot="' + step + '"]');
            const block = slot ? slot.querySelector('.p2-draggable-block') : null;
            if (!block) {
                allFilled = false;
                break;
            }
            if (block.dataset.correctStep !== String(step)) {
                isCorrect = false;
            }
        }

        if (!allFilled) {
            triggerError('Заполните все 6 узлов схемы канала связи Шеннона и контура управления Винера!');
            return;
        }

        if (!isCorrect) {
            triggerError('Нарушена топология канала связи Шеннона / контура Винера или использованы дистракторы!', () => {
                initPhase2();
            });
            return;
        }

        setPhase(3);
        initPhase3();
    });

    // ----------------------------------------------------
    // ФАЗА 3: Классификация 4 типов обработки информации (Drag-to-Bucket)
    // ----------------------------------------------------
    const P3_BANK = [
        // 1. Получение новой информации (create) - без примеров из theory.md
        { id: 'p3-cr-1', cat: 'create', title: 'Расчет тормозного пути поезда по массе и уклону', desc: 'Математическое вычисление нового параметра безопасности движения по физическим формулам' },
        { id: 'p3-cr-2', cat: 'create', title: 'Прогноз смещения циклона по барометрической модели', desc: 'Численное моделирование метеорологической обстановки с выработкой нового знания' },
        { id: 'p3-cr-3', cat: 'create', title: 'Постановка диагноза экспертной системой по симптомам', desc: 'Логический вывод нового заключения на базе правил продукционной базы знаний' },
        { id: 'p3-cr-4', cat: 'create', title: 'Вычисление КПД теплового двигателя по замерам работы', desc: 'Получение итоговой энергетической характеристики агрегата путем арифметического расчета' },
        { id: 'p3-cr-5', cat: 'create', title: 'Определение оптимального маршрута доставки алгоритмом Дейкстры', desc: 'Анализ взвешенного графа дорог с нахождением кратчайшего пути следования' },

        // 2. Изменение формы представления / кодирование (encode)
        { id: 'p3-en-1', cat: 'encode', title: 'Оцифровка виниловой пластинки в поток импульсно-кодовой модуляции PCM', desc: 'Дискретизация и квантование аналогового звука без изменения музыкального содержания' },
        { id: 'p3-en-2', cat: 'encode', title: 'Зашифрование базы чертежей блочным шифром «Кузнечик»', desc: 'Криптографическое преобразование открытого текста в шифротекст при сохранении смысла' },
        { id: 'p3-en-3', cat: 'encode', title: 'Сжатие лог-файлов сервера алгоритмом LZ77 без потерь', desc: 'Уменьшение битового объема данных путем замены повторяющихся цепочек ссылками' },
        { id: 'p3-en-4', cat: 'encode', title: 'Транслитерация русских фамилий латиницей для загранпаспорта', desc: 'Перевод записи из кириллического алфавита в латинский по таблице соответствия' },
        { id: 'p3-en-5', cat: 'encode', title: 'Генерация матричного QR-кода из текстовой ссылки на портал', desc: 'Графическое перекодирование символьной строки URL в двумерную черно-белую матрицу' },

        // 3. Структурирование / систематизация (structure)
        { id: 'p3-st-1', cat: 'structure', title: 'Упорядочивание журнала вызовов по убыванию длительности сессии', desc: 'Перестановка записей лога по числовому ключу без изменения самих данных' },
        { id: 'p3-st-2', cat: 'structure', title: 'Разбиение складского реестра запчастей по категориям агрегатов', desc: 'Классификация и группировка номенклатуры в иерархические разделы каталога' },
        { id: 'p3-st-3', cat: 'structure', title: 'Построение сбалансированного B-дерева индексов для таблицы СУБД', desc: 'Организация связей между ключами записей для ускорения последующего доступа' },
        { id: 'p3-st-4', cat: 'structure', title: 'Сведение разрозненных анкет абитуриентов в единую электронную таблицу', desc: 'Табличная систематизация однотипных записей по строкам и типизированным столбцам' },
        { id: 'p3-st-5', cat: 'structure', title: 'Хронологическая раскладка архивных снимков спутника по годам и месяцам', desc: 'Упорядочивание медиафайлов в древовидную структуру папок по временному признаку' },

        // 4. Поиск информации (search)
        { id: 'p3-sr-1', cat: 'search', title: 'Выборка из базы ГАИ всех автомобилей с регионом 77 и годом выпуска 2023', desc: 'Фильтрация записей хранилища по сложному логическому условию (И / ИЛИ)' },
        { id: 'p3-sr-2', cat: 'search', title: 'Определение IP-адреса узла по доменному имени в таблице маршрутизатора', desc: 'Извлечение существующей записи из справочной таблицы по уникальному ключу запроса' },
        { id: 'p3-sr-3', cat: 'search', title: 'Обнаружение всех вхождений подстроки «ERROR_CRC» в системном журнале', desc: 'Сканирование текстового массива для выделения строк, совпадающих с образцом' },
        { id: 'p3-sr-4', cat: 'search', title: 'Нахождение свободного места в схеме зрительного зала перед покупкой билета', desc: 'Запрос к информационной базе для выделения объектов с признаком «свободно»' },
        { id: 'p3-sr-5', cat: 'search', title: 'Отбор резюме инженеров со знанием Python и стажем от 3 лет в кадровой системе', desc: 'Извлечение подмножества анкет, удовлетворяющих заданным квалификационным рамкам' }
    ];

    let p3SelectedCard = null;
    let p3ListenersBound = false;

    function initPhase3() {
        const pool = document.getElementById('p3-cards-pool');
        if (!pool) return;
        pool.innerHTML = '';
        p3SelectedCard = null;

        document.querySelectorAll('#phase3 .bucket-slot').forEach(slot => {
            slot.innerHTML = '';
        });
        updateP3BucketCounts();

        const createCards = P3_BANK.filter(c => c.cat === 'create').sort(() => Math.random() - 0.5).slice(0, 2);
        const encodeCards = P3_BANK.filter(c => c.cat === 'encode').sort(() => Math.random() - 0.5).slice(0, 2);
        const structCards = P3_BANK.filter(c => c.cat === 'structure').sort(() => Math.random() - 0.5).slice(0, 2);
        const searchCards = P3_BANK.filter(c => c.cat === 'search').sort(() => Math.random() - 0.5).slice(0, 2);

        const currentCards = [...createCards, ...encodeCards, ...structCards, ...searchCards].sort(() => Math.random() - 0.5);

        currentCards.forEach(item => {
            const card = document.createElement('div');
            card.id = item.id;
            card.className = 'card bg-dark border-secondary rounded-0 p-2 text-light font-monospace cursor-pointer user-select-none p3-draggable-card';
            card.style.cursor = 'grab';
            card.style.minWidth = '210px';
            card.style.maxWidth = '280px';
            card.draggable = true;
            card.dataset.category = item.cat;
            card.dataset.cardId = item.id;

            card.innerHTML = `
                <div class="fw-bold text-light small mb-1">${item.title}</div>
                <div class="text-secondary small" style="font-size: 0.75rem;">${item.desc}</div>
            `;

            card.addEventListener('dragstart', (e) => {
                e.dataTransfer.setData('text/plain', item.id);
                card.classList.add('opacity-50');
            });
            card.addEventListener('dragend', () => {
                card.classList.remove('opacity-50');
            });

            card.addEventListener('click', (e) => {
                e.stopPropagation();
                if (p3SelectedCard === card) {
                    card.classList.remove('border-warning', 'border-2');
                    p3SelectedCard = null;
                } else {
                    if (p3SelectedCard) p3SelectedCard.classList.remove('border-warning', 'border-2');
                    p3SelectedCard = card;
                    card.classList.add('border-warning', 'border-2');
                }
            });

            pool.appendChild(card);
        });

        if (!p3ListenersBound) {
            p3ListenersBound = true;
            document.querySelectorAll('#phase3 .target-bucket-p3').forEach(bucket => {
                const slot = bucket.querySelector('.bucket-slot');

                bucket.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    bucket.classList.add('border-white');
                });
                bucket.addEventListener('dragleave', () => {
                    bucket.classList.remove('border-white');
                });
                bucket.addEventListener('drop', (e) => {
                    e.preventDefault();
                    bucket.classList.remove('border-white');
                    const cardId = e.dataTransfer.getData('text/plain');
                    const cardEl = document.getElementById(cardId);
                    if (cardEl && cardEl.classList.contains('p3-draggable-card') && slot) {
                        slot.appendChild(cardEl);
                        updateP3BucketCounts();
                    }
                });

                bucket.addEventListener('click', () => {
                    if (p3SelectedCard && slot) {
                        slot.appendChild(p3SelectedCard);
                        p3SelectedCard.classList.remove('border-warning', 'border-2');
                        p3SelectedCard = null;
                        updateP3BucketCounts();
                    }
                });
            });

            pool.addEventListener('dragover', (e) => e.preventDefault());
            pool.addEventListener('drop', (e) => {
                e.preventDefault();
                const cardId = e.dataTransfer.getData('text/plain');
                const cardEl = document.getElementById(cardId);
                if (cardEl && cardEl.classList.contains('p3-draggable-card')) {
                    pool.appendChild(cardEl);
                    updateP3BucketCounts();
                }
            });
            pool.addEventListener('click', () => {
                if (p3SelectedCard && p3SelectedCard.parentElement !== pool) {
                    pool.appendChild(p3SelectedCard);
                    p3SelectedCard.classList.remove('border-warning', 'border-2');
                    p3SelectedCard = null;
                    updateP3BucketCounts();
                }
            });
        }
    }

    function updateP3BucketCounts() {
        document.querySelectorAll('#phase3 .target-bucket-p3').forEach(bucket => {
            const count = bucket.querySelectorAll('.p3-draggable-card').length;
            const badge = bucket.querySelector('.count-badge');
            if (badge) badge.textContent = String(count);
        });
    }

    document.getElementById('p3-reset-btn')?.addEventListener('click', () => {
        const pool = document.getElementById('p3-cards-pool');
        document.querySelectorAll('#phase3 .p3-draggable-card').forEach(c => pool?.appendChild(c));
        updateP3BucketCounts();
    });

    document.getElementById('p3-verify-btn')?.addEventListener('click', () => {
        if (isProcessingError) return;

        const pool = document.getElementById('p3-cards-pool');
        const remainingInPool = pool?.querySelectorAll('.p3-draggable-card').length || 0;
        if (remainingInPool > 0) {
            triggerError('Распределите все 8 карточек операций по четырем контейнерам!');
            return;
        }

        let isCorrect = true;
        document.querySelectorAll('#phase3 .target-bucket-p3').forEach(bucket => {
            const targetCat = bucket.dataset.category;
            bucket.querySelectorAll('.p3-draggable-card').forEach(card => {
                if (card.dataset.category !== targetCat) {
                    isCorrect = false;
                }
            });
        });

        if (!isCorrect) {
            triggerError('Обнаружены ошибки в классификации четырех типов обработки информации!', () => {
                initPhase3();
            });
            return;
        }

        // Завершение Уровня 1!
        setPhase(4);
    });

    // ----------------------------------------------------
    // СТАРТ
    // ----------------------------------------------------
    initPhase1();
})();
</script>
