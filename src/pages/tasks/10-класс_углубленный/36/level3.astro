---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={3}>
    <div id="arcade-app" class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Шапка аркады -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h4 text-danger mb-0">Аркада: RADIX BUS CONVEYOR // Шина 2 / 8 / 16 (Уровень 3)</h2>
            <span class="badge border border-danger text-danger bg-black rounded-0 px-3 py-2">
                Keyboard-Only // 18 клавиш // Hardcore
            </span>
        </div>

        <div id="game-card" :class="['card bg-black border-danger rounded-0', screenShake ? 'border-warning' : '']">
            <div class="card-body p-3 p-md-4">

                <!-- ==================== ЭКРАН INTRO (ОБЯЗАТЕЛЬНЫЙ БРИФИНГ) ==================== -->
                <div v-if="gameState === 'intro'" id="intro-screen" class="py-2">
                    <div class="border border-danger bg-dark p-3 p-md-4 mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <span class="badge bg-danger text-black rounded-0 fs-6">ХАРДКОР-РЕЖИМ // 10 ВОЛН</span>
                            <span class="text-warning small">Волна 1: 34.0 с → Волна 10: 15.0 с</span>
                        </div>
                        <h3 class="h5 text-light mb-2">Протокол балансировки 8-битного регистра АЛУ (ACC)</h3>
                        <p class="text-light small mb-3">
                            На конвейер поступают закодированные 8-битные пакеты из шестнадцатеричной и восьмеричной систем счисления, а также битовые инструкции АЛУ.
                            Ваша задача — настроить 8 бит регистра <code>ACC</code>, переключить группировку выходной шины (<code>HEX</code> или <code>OCT</code>) и выдать пакет на шину до истечения таймера.
                            Любая ошибка или тайм-аут сбрасывает прогресс на Волну 1.
                        </p>

                        <div class="border border-secondary bg-black p-3 mb-3">
                            <div class="text-danger small text-uppercase fw-bold mb-2">Клавиатурное управление (мышь в игре отключена):</div>
                            <div class="row g-2 small text-light">
                                <div class="col-12 col-sm-6">
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">A</kbd> /
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">D</kbd> или
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">&larr;</kbd> /
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">&rarr;</kbd>
                                    — перемещение курсора по битам
                                </div>
                                <div class="col-12 col-sm-6">
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">W</kbd> /
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">&uarr;</kbd> — переключить бит,
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">S</kbd> /
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">&darr;</kbd> — обнулить бит
                                </div>
                                <div class="col-12 col-sm-6">
                                    <kbd class="bg-dark border border-secondary text-info rounded-0 px-2">0</kbd>–<kbd class="bg-dark border border-secondary text-info rounded-0 px-2">7</kbd>
                                    — мгновенное переключение бита b<sub>k</sub>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <kbd class="bg-dark border border-secondary text-danger rounded-0 px-2">Shift</kbd> — режим шины (HEX/OCT),
                                    <kbd class="bg-dark border border-secondary text-success rounded-0 px-2">Space</kbd> — выдать пакет
                                </div>
                            </div>
                        </div>

                        <div class="text-center">
                            <button id="start-btn" type="button" @click="startGame" class="btn btn-danger text-black fw-bold rounded-0 px-4 py-2 fs-5" style="min-width: 220px; min-height: 48px;">
                                Начать [Space]
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ИГРОВОЙ ЭКРАН (KEYBOARD-ONLY) ==================== -->
                <div v-else-if="gameState === 'playing'" id="playing-screen">
                    <!-- Верхний HUD -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 border-bottom border-danger pb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span id="wave-badge" class="badge bg-danger text-black rounded-0 fs-6" v-text="'Волна ' + currentWave + ' / 10'"></span>
                            <span class="text-light fw-bold small" v-text="currentWaveData.title"></span>
                        </div>
                        <div class="d-flex align-items-center gap-3 small">
                            <span class="text-secondary">Сбросы: <strong id="alarm-count" class="text-danger" v-text="alarmCount"></strong></span>
                            <span class="text-secondary">Общее время: <strong class="text-info" v-text="formatTime(totalElapsedSec)"></strong></span>
                            <span id="wave-timer" :class="['badge rounded-0 fs-6', waveTimeLeft <= 5 ? 'bg-danger text-black' : 'bg-dark border border-warning text-warning']" v-text="waveTimeLeft.toFixed(1) + ' с'"></span>
                        </div>
                    </div>

                    <!-- Прогресс-бар движения пакета по конвейерной шине -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small text-secondary mb-1">
                            <span>ПОТОК ШИНЫ → ЗАЩЁЛКА ШЛЮЗА</span>
                            <span v-text="conveyorPercent + '%'"></span>
                        </div>
                        <div class="progress rounded-0 bg-dark border border-secondary" style="height: 12px;">
                            <div
                                class="progress-bar rounded-0"
                                :class="waveTimeLeft <= 5 ? 'bg-danger' : 'bg-warning'"
                                role="progressbar"
                                :style="{ width: conveyorPercent + '%' }">
                            </div>
                        </div>
                    </div>

                    <!-- Аварийный баннер хардкор-сброса (#alarm-box) -->
                    <div id="alarm-box" v-show="alarmActive" class="alert alert-danger bg-black text-danger border border-danger rounded-0 mb-3 py-2" role="alert">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <span>
                                <strong v-text="'[HARDCORE RESET #' + alarmCount + ']'"></strong>
                                <span class="ms-1" v-text="alarmMessage + ' Возврат на Волну 1...'"></span>
                            </span>
                            <span class="spinner-border spinner-border-sm text-danger flex-shrink-0" role="status"></span>
                        </div>
                    </div>

                    <!-- Игровое поле: СТРОГО pointer-events: none (ЗАПРЕТ МЫШИ В ИГРЕ) -->
                    <div id="arcade-field" style="pointer-events: none; user-select: none;">
                        <!-- Data Source: Входящий пакет и целевой шлюз -->
                        <div class="row g-2 mb-3">
                            <div class="col-12 col-md-7">
                                <div class="card bg-dark border-secondary rounded-0 h-100 p-3">
                                    <div class="text-secondary small text-uppercase mb-1">Входящий пакет данных (Data Source):</div>
                                    <div id="wave-payload" class="fs-3 fw-bold text-warning lh-sm" v-html="currentWaveData.payloadHtml"></div>
                                    <div class="text-light small mt-1" v-text="currentWaveData.hint"></div>
                                </div>
                            </div>
                            <div class="col-12 col-md-5">
                                <div :class="['card bg-dark rounded-0 h-100 p-3', modeFlash ? 'border-warning' : 'border-danger']">
                                    <div class="text-secondary small text-uppercase mb-1">Выходной шлюз (Требуется / Активен):</div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small text-secondary">Цель волны:</span>
                                        <span
                                            id="wave-target-mode"
                                            :class="['badge rounded-0 fs-6', currentWaveData.targetMode === 'HEX' ? 'bg-info text-dark' : 'bg-warning text-dark']"
                                            v-text="currentWaveData.targetMode === 'HEX' ? 'HEX (4-бит тетрады)' : 'OCT (3-бит триады)'">
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="small text-secondary">Ваша шина [Shift]:</span>
                                        <span
                                            id="current-bus-mode"
                                            :class="['badge rounded-0 fs-6 border', busMode === currentWaveData.targetMode ? 'border-success text-success bg-black' : 'border-danger text-danger bg-black']"
                                            v-text="busMode === 'HEX' ? 'HEX (4+4 бита)' : 'OCT (2+3+3 бита)'">
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Direct Surface: 8-битный регистр АЛУ ACC -->
                        <div :class="['card bg-dark rounded-0 p-3 mb-3', busSuccessFlash ? 'border-success' : 'border-secondary']">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 border-bottom border-secondary pb-1">
                                <span
                                    class="text-secondary small text-uppercase"
                                    v-text="'8-битный регистр ACC (' + (busMode === 'HEX' ? 'группировка: 2 тетрады 8–4–2–1' : 'группировка: 3 триады 2–1 | 4–2–1 | 4–2–1') + '):'">
                                </span>
                                <span class="text-warning small">Курсор: бит b<sub v-text="cursorBit"></sub></span>
                            </div>

                            <!-- Группировка ячеек в зависимости от busMode -->
                            <div class="d-flex flex-wrap justify-content-center gap-3 my-2">
                                <div v-for="(group, gIdx) in groupedBitLayout" :key="gIdx" class="border border-secondary bg-black p-2 rounded-0">
                                    <div class="text-secondary small text-center mb-2" v-text="group.label"></div>
                                    <div class="d-flex gap-1 justify-content-center">
                                        <div
                                            v-for="cell in group.cells"
                                            :key="cell.bitIdx"
                                            :data-bit-index="cell.bitIdx"
                                            :data-bit-val="bits[cell.bitIdx]"
                                            :data-cursor="cursorBit === cell.bitIdx ? 'true' : 'false'"
                                            :class="[
                                                'd-flex flex-column align-items-center justify-content-center border rounded-0 p-1 font-monospace',
                                                cursorBit === cell.bitIdx
                                                    ? 'border-warning bg-warning text-dark fw-bold'
                                                    : (bits[cell.bitIdx] === 1
                                                        ? 'border-danger bg-danger text-black fw-bold'
                                                        : 'border-secondary bg-dark text-light'),
                                                lastToggledBit === cell.bitIdx ? 'opacity-75' : ''
                                            ]"
                                            :style="{
                                                minWidth: '48px',
                                                minHeight: '68px',
                                                outline: cursorBit === cell.bitIdx ? '2px solid #ffc107' : 'none',
                                                outlineOffset: '2px'
                                            }">
                                            <span class="small" style="font-size: 0.68rem;" v-text="'[' + cell.bitIdx + ']'"></span>
                                            <span class="fs-4 lh-1 my-1" v-text="bits[cell.bitIdx]"></span>
                                            <span class="small" style="font-size: 0.68rem;" v-text="'×' + cell.weight"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Компактный Keycap HUD -->
                        <div class="border border-secondary bg-dark p-2 text-center small text-light">
                            <kbd class="bg-black border border-secondary text-warning rounded-0 px-1">A/D</kbd>
                            <kbd class="bg-black border border-secondary text-warning rounded-0 px-1">&larr;/&rarr;</kbd> курсор &middot;
                            <kbd class="bg-black border border-secondary text-warning rounded-0 px-1">W/&uarr;</kbd> перекл. &middot;
                            <kbd class="bg-black border border-secondary text-warning rounded-0 px-1">S/&darr;</kbd> ноль &middot;
                            <kbd class="bg-black border border-secondary text-info rounded-0 px-1">0..7</kbd> быстрый бит &middot;
                            <kbd class="bg-black border border-secondary text-danger rounded-0 px-1">Shift</kbd> HEX/OCT &middot;
                            <kbd class="bg-black border border-secondary text-success rounded-0 px-1">Space</kbd> выдать шину
                        </div>
                    </div>
                </div>

                <!-- ==================== ЭКРАН ПОБЕДЫ ==================== -->
                <div v-else-if="gameState === 'victory'" id="victory-screen" class="text-center py-4">
                    <div class="border border-success bg-dark p-4 mb-3">
                        <h3 class="text-success mb-2">[ УРОВЕНЬ 3 ПРОЙДЕН // КОНВЕЙЕР СТАБИЛИЗИРОВАН ]</h3>
                        <p class="text-light mb-3">
                            Все 10 волн аркадной балансировки двоичной, восьмеричной и шестнадцатеричной шины пройдены с клавиатуры.
                        </p>
                        <div class="d-flex justify-content-center gap-4 text-secondary small mb-3">
                            <span>Хардкор-сбросов: <strong class="text-danger" v-text="alarmCount"></strong></span>
                            <span>Время: <strong class="text-info" v-text="formatTime(totalElapsedSec)"></strong></span>
                        </div>
                        <button id="restart-btn" type="button" @click="restartGame" class="btn btn-outline-success rounded-0 fw-bold px-4 py-2" style="min-height: 48px;">
                            Пройти снова [Space]
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script is:inline src="/static/vue.global.js"></script>
    <script is:inline>
    (function() {
        const HEX_DIGITS = '0123456789ABCDEF';
        const FORBIDDEN_BYTES = new Set([0x3A, 0x4A, 0x7F, 0x89, 0xB6, 0xF0, 0xFF]);

        /* --- Web Audio API (без внешних файлов) --- */
        let audioCtx = null;
        function getAudioContext() {
            if (!audioCtx && typeof window !== 'undefined') {
                const Ctx = window.AudioContext || window.webkitAudioContext;
                if (Ctx) {
                    try { audioCtx = new Ctx(); } catch (e) { audioCtx = null; }
                }
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                try { audioCtx.resume(); } catch (e) {}
            }
            return audioCtx;
        }

        function playTone(freq, type, duration, vol) {
            const ctx = getAudioContext();
            if (!ctx) return;
            try {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = type || 'square';
                osc.frequency.setValueAtTime(freq, ctx.currentTime);
                gain.gain.setValueAtTime(vol || 0.06, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + duration);
            } catch (e) {}
        }

        function playCursorSound() { playTone(320, 'triangle', 0.04, 0.04); }
        function playBitFlipSound(val) { playTone(val ? 620 : 260, 'square', 0.06, 0.05); }
        function playModeSwitchSound() { playTone(520, 'sawtooth', 0.08, 0.05); }
        function playWaveClearSound() {
            playTone(523, 'triangle', 0.1, 0.07);
            setTimeout(() => playTone(784, 'triangle', 0.14, 0.07), 70);
        }
        function playAlarmSiren() {
            playTone(190, 'sawtooth', 0.22, 0.09);
            setTimeout(() => playTone(135, 'sawtooth', 0.28, 0.09), 160);
        }
        function playVictoryFanfare() {
            [523, 659, 784, 1046].forEach((f, idx) => {
                setTimeout(() => playTone(f, 'triangle', 0.16, 0.08), idx * 90);
            });
        }

        function randInt(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function pickRandom(arr) {
            return arr[Math.floor(Math.random() * arr.length)];
        }

        function pickByte(minVal, maxVal, requireHexLetter) {
            for (let i = 0; i < 40; i++) {
                const v = randInt(minVal, maxVal);
                if (FORBIDDEN_BYTES.has(v)) continue;
                if (requireHexLetter && !(/[A-F]/.test(v.toString(16).toUpperCase()))) continue;
                return v;
            }
            return 0x5C;
        }

        function fmtHex(val) {
            return `${val.toString(16).toUpperCase().padStart(2, '0')}<sub>16</sub>`;
        }

        function fmtOct(val) {
            return `${val.toString(8).padStart(3, '0')}<sub>8</sub>`;
        }

        function makeInitialNoise(targetVal) {
            // Задаем начальный шум (2-3 случайных бита, отличный от targetVal)
            let noise = 0;
            const count = randInt(2, 3);
            for (let i = 0; i < count; i++) {
                noise |= (1 << randInt(0, 7));
            }
            if (noise === targetVal) noise ^= 1;
            return noise;
        }

        // Расписание 10 волн: Волна 1 >= 30с, каждая >= 15с, передышка на 8-й волне
        const WAVE_TIMERS = [34.0, 30.0, 26.0, 24.0, 22.0, 20.0, 18.0, 22.0, 17.0, 15.0];

        function generateWaves() {
            const waves = [];

            // Волна 1 (34.0 с): Прямой байт HEX -> HEX
            {
                const val = pickByte(0x25, 0xEE, true);
                waves.push({
                    wave: 1,
                    timeLimit: WAVE_TIMERS[0],
                    title: 'Калибровка тетрад (HEX → HEX)',
                    payloadHtml: fmtHex(val),
                    hint: 'Разложите каждую шестнадцатеричную цифру на 4-битную тетраду.',
                    targetValue: val,
                    targetMode: 'HEX',
                    initialValue: 0,
                    initialMode: 'HEX'
                });
            }

            // Волна 2 (30.0 с): Прямой байт OCT -> OCT
            {
                const val = pickByte(0o110, 0o367, false);
                waves.push({
                    wave: 2,
                    timeLimit: WAVE_TIMERS[1],
                    title: 'Калибровка триад (OCT → OCT)',
                    payloadHtml: fmtOct(val),
                    hint: 'Разложите три восьмеричные цифры по схеме 2–1 | 4–2–1 | 4–2–1.',
                    targetValue: val,
                    targetMode: 'OCT',
                    initialValue: 0,
                    initialMode: 'OCT'
                });
            }

            // Волна 3 (26.0 с): Кросс-мост HEX -> OCT
            {
                const val = pickByte(0x29, 0xEA, true);
                waves.push({
                    wave: 3,
                    timeLimit: WAVE_TIMERS[2],
                    title: 'Двоичный мост (HEX → OCT)',
                    payloadHtml: fmtHex(val),
                    hint: 'Загрузите тетрады в регистр и переключите шину в OCT [Shift].',
                    targetValue: val,
                    targetMode: 'OCT',
                    initialValue: 0,
                    initialMode: 'HEX'
                });
            }

            // Волна 4 (24.0 с): Кросс-мост OCT -> HEX
            {
                const val = pickByte(0o121, 0o356, true);
                waves.push({
                    wave: 4,
                    timeLimit: WAVE_TIMERS[3],
                    title: 'Двоичный мост (OCT → HEX)',
                    payloadHtml: fmtOct(val),
                    hint: 'Загрузите триады в регистр и переключите шину в HEX [Shift].',
                    targetValue: val,
                    targetMode: 'HEX',
                    initialValue: 0,
                    initialMode: 'OCT'
                });
            }

            // Волна 5 (22.0 с): Зашумленный регистр + кросс-мост
            {
                const fromHex = Math.random() < 0.5;
                const val = pickByte(0x31, 0xDF, true);
                waves.push({
                    wave: 5,
                    timeLimit: WAVE_TIMERS[4],
                    title: 'Очистка буфера и кросс-перевод',
                    payloadHtml: fromHex ? fmtHex(val) : fmtOct(val),
                    hint: 'В регистре ACC остаточный мусор! Сбросьте лишние биты и выберите режим шлюза.',
                    targetValue: val,
                    targetMode: fromHex ? 'OCT' : 'HEX',
                    initialValue: makeInitialNoise(val),
                    initialMode: fromHex ? 'HEX' : 'OCT'
                });
            }

            // Волна 6 (20.0 с): Битовая OR-маска (0x0F или 0xF0)
            {
                const a = pickByte(0x21, 0xD8, true);
                const useLowMask = Math.random() < 0.5;
                const maskHex = useLowMask ? '0F' : 'F0';
                const target = useLowMask ? (a | 0x0F) : (a | 0xF0);
                const targetMode = pickRandom(['HEX', 'OCT']);
                waves.push({
                    wave: 6,
                    timeLimit: WAVE_TIMERS[5],
                    title: 'АЛУ: Битовая маска OR',
                    payloadHtml: `${fmtHex(a)} <span class="text-danger">|</span> 0x${maskHex}`,
                    hint: 'Установите единицы во всех битах, где в маске стоит 1 (побитовое ИЛИ).',
                    targetValue: target,
                    targetMode,
                    initialValue: 0,
                    initialMode: targetMode === 'HEX' ? 'OCT' : 'HEX'
                });
            }

            // Волна 7 (18.0 с): Битовая AND-маска
            {
                const useHex = Math.random() < 0.5;
                const a = pickByte(0x45, 0xEB, true);
                let payloadHtml = '';
                let target = 0;
                if (useHex) {
                    const high = Math.random() < 0.5;
                    const mask = high ? 0xF0 : 0x0F;
                    target = a & mask;
                    payloadHtml = `${fmtHex(a)} <span class="text-danger">&amp;</span> 0x${high ? 'F0' : '0F'}`;
                } else {
                    target = a & 0o077;
                    payloadHtml = `${fmtOct(a)} <span class="text-danger">&amp;</span> 0o077`;
                }
                const targetMode = useHex ? 'OCT' : 'HEX';
                waves.push({
                    wave: 7,
                    timeLimit: WAVE_TIMERS[6],
                    title: 'АЛУ: Фильтрация маской AND',
                    payloadHtml,
                    hint: 'Сохраните только биты, разрешенные единицами маски (побитовое И).',
                    targetValue: target,
                    targetMode,
                    initialValue: makeInitialNoise(target),
                    initialMode: targetMode
                });
            }

            // Волна 8 (22.0 с): Тактическая передышка — Побитовая инверсия ~A
            {
                const fromHex = Math.random() < 0.5;
                const a = pickByte(0x24, 0xDA, true);
                const target = (~a) & 0xFF;
                const targetMode = fromHex ? 'HEX' : 'OCT';
                waves.push({
                    wave: 8,
                    timeLimit: WAVE_TIMERS[7],
                    title: 'Передышка: Инверсия байта (~A)',
                    payloadHtml: `<span class="text-danger">~</span>(${fromHex ? fmtHex(a) : fmtOct(a)})`,
                    hint: 'Инвертируйте каждый из 8 бит исходного байта (0 ↔ 1).',
                    targetValue: target,
                    targetMode,
                    initialValue: 0,
                    initialMode: fromHex ? 'OCT' : 'HEX'
                });
            }

            // Волна 9 (17.0 с): Побитовый сдвиг тетрады на 4 бита
            {
                const shiftRight = Math.random() < 0.5;
                const a = pickByte(0x3B, 0xED, true);
                const target = shiftRight ? (a >> 4) : ((a & 0x0F) << 4);
                const targetMode = pickRandom(['HEX', 'OCT']);
                waves.push({
                    wave: 9,
                    timeLimit: WAVE_TIMERS[8],
                    title: 'АЛУ: Сдвиг тетрады (>> 4 / << 4)',
                    payloadHtml: shiftRight
                        ? `(${fmtHex(a)} <span class="text-danger">&gt;&gt;</span> 4)`
                        : `((${fmtHex(a)} &amp; 0x0F) <span class="text-danger">&lt;&lt;</span> 4)`,
                    hint: shiftRight
                        ? 'Сдвиньте байт на 4 бита вправо (старшая тетрада переходит в младшую).'
                        : 'Выделите младшую тетраду и сдвиньте ее на 4 бита влево.',
                    targetValue: target,
                    targetMode,
                    initialValue: makeInitialNoise(target),
                    initialMode: targetMode === 'HEX' ? 'OCT' : 'HEX'
                });
            }

            // Волна 10 (15.0 с): Финальный штурм — SWAP тетрад или XOR с маской
            {
                const doSwap = Math.random() < 0.5;
                const a = pickByte(0x2B, 0xDE, true);
                let payloadHtml = '';
                let target = 0;
                let targetMode = 'OCT';
                let hint = '';
                if (doSwap) {
                    target = ((a & 0x0F) << 4) | ((a >> 4) & 0x0F);
                    payloadHtml = `SWAP_NIBBLES(${fmtHex(a)})`;
                    targetMode = 'OCT';
                    hint = 'Поменяйте старшую и младшую тетрады местами и выдайте в режиме OCT.';
                } else {
                    target = a ^ 0o007;
                    payloadHtml = `${fmtOct(a)} <span class="text-danger">^</span> 0o007`;
                    targetMode = 'HEX';
                    hint = 'Инвертируйте младшую триаду (XOR 0o007) и выдайте в режиме HEX.';
                }
                waves.push({
                    wave: 10,
                    timeLimit: WAVE_TIMERS[9],
                    title: 'Финальный штурм: Синтез шины',
                    payloadHtml,
                    hint,
                    targetValue: target,
                    targetMode,
                    initialValue: makeInitialNoise(target),
                    initialMode: targetMode === 'HEX' ? 'OCT' : 'HEX'
                });
            }

            return waves;
        }

        let appInstance = null;
        let resetTimeoutId = null;

        const telemetry = window.LMSTelemetry.create({
            missionName: 'Урок 36 :: Двоичная, восьмеричная и шестнадцатеричная системы счисления, связь между ними (Уровень 3)',
            level: 3,
            totalWaves: 10,
            showAfkOverlay: true,
            onAfkStop: () => {
                if (appInstance) {
                    appInstance.handleAfkPaused();
                }
            },
            onAfkRetry: () => {
                if (appInstance) {
                    appInstance.handleAfkResumed();
                }
            }
        });

        const { createApp } = Vue;
        const app = createApp({
            data() {
                return {
                    gameState: 'intro', // 'intro' | 'playing' | 'victory'
                    activeWaves: generateWaves(),
                    currentWave: 1,
                    bits: [0, 0, 0, 0, 0, 0, 0, 0], // индекс 0 = младший бит b0, индекс 7 = старший бит b7
                    cursorBit: 7,
                    busMode: 'HEX',
                    waveTimeLeft: 34.0,
                    totalElapsedSec: 0,
                    alarmActive: false,
                    alarmMessage: '',
                    alarmCount: 0,
                    isActionBlocked: false,
                    afkPaused: false,
                    screenShake: false,
                    lastToggledBit: -1,
                    modeFlash: false,
                    busSuccessFlash: false,
                    waveTimerHandle: null
                };
            },

            computed: {
                currentWaveData() {
                    return this.activeWaves[this.currentWave - 1] || this.activeWaves[0];
                },

                conveyorPercent() {
                    const lim = this.currentWaveData.timeLimit || 34;
                    const pct = Math.round(((lim - this.waveTimeLeft) / lim) * 100);
                    return Math.max(0, Math.min(100, pct));
                },

                groupedBitLayout() {
                    if (this.busMode === 'HEX') {
                        return [
                            {
                                label: 'Старшая тетрада (×16¹)',
                                cells: [
                                    { bitIdx: 7, weight: 8 },
                                    { bitIdx: 6, weight: 4 },
                                    { bitIdx: 5, weight: 2 },
                                    { bitIdx: 4, weight: 1 }
                                ]
                            },
                            {
                                label: 'Младшая тетрада (×16⁰)',
                                cells: [
                                    { bitIdx: 3, weight: 8 },
                                    { bitIdx: 2, weight: 4 },
                                    { bitIdx: 1, weight: 2 },
                                    { bitIdx: 0, weight: 1 }
                                ]
                            }
                        ];
                    }
                    return [
                        {
                            label: 'Триада 2 (×8²)',
                            cells: [
                                { bitIdx: 7, weight: 2 },
                                { bitIdx: 6, weight: 1 }
                            ]
                        },
                        {
                            label: 'Триада 1 (×8¹)',
                            cells: [
                                { bitIdx: 5, weight: 4 },
                                { bitIdx: 4, weight: 2 },
                                { bitIdx: 3, weight: 1 }
                            ]
                        },
                        {
                            label: 'Триада 0 (×8⁰)',
                            cells: [
                                { bitIdx: 2, weight: 4 },
                                { bitIdx: 1, weight: 2 },
                                { bitIdx: 0, weight: 1 }
                            ]
                        }
                    ];
                }
            },

            mounted() {
                window.addEventListener('keydown', this.handleKeyDown);
            },

            unmounted() {
                window.removeEventListener('keydown', this.handleKeyDown);
                this.stopTimers();
            },

            methods: {
                stopTimers() {
                    if (this.waveTimerHandle) {
                        clearInterval(this.waveTimerHandle);
                        this.waveTimerHandle = null;
                    }
                    if (resetTimeoutId) {
                        clearTimeout(resetTimeoutId);
                        resetTimeoutId = null;
                    }
                },

                applyRegisterValue(val) {
                    const next = [];
                    for (let i = 0; i < 8; i++) {
                        next.push((val >> i) & 1);
                    }
                    this.bits = next;
                },

                getRegisterValue() {
                    let v = 0;
                    for (let i = 0; i < 8; i++) {
                        if (this.bits[i]) v |= (1 << i);
                    }
                    return v;
                },

                loadWave(waveNum) {
                    this.currentWave = waveNum;
                    const w = this.currentWaveData;
                    this.applyRegisterValue(w.initialValue || 0);
                    this.busMode = w.initialMode || 'HEX';
                    this.cursorBit = 7;
                    this.waveTimeLeft = w.timeLimit;
                    this.alarmActive = false;
                    this.isActionBlocked = false;
                },

                startWaveInterval() {
                    if (this.waveTimerHandle) clearInterval(this.waveTimerHandle);
                    this.waveTimerHandle = setInterval(() => {
                        if (this.gameState !== 'playing' || this.alarmActive || this.isActionBlocked || this.afkPaused) {
                            return;
                        }
                        this.totalElapsedSec = telemetry.getTimeSpentSec();
                        this.waveTimeLeft = Math.max(0, Number((this.waveTimeLeft - 0.1).toFixed(1)));
                        if (this.waveTimeLeft <= 0) {
                            this.triggerHardcoreReset('Тайм-аут конвейера! Пакет не выдан на шину вовремя.', true);
                        }
                    }, 100);
                },

                startGame() {
                    getAudioContext();
                    this.stopTimers();
                    this.activeWaves = generateWaves();
                    this.alarmCount = 0;
                    this.afkPaused = false;
                    this.gameState = 'playing';
                    telemetry.start();
                    this.totalElapsedSec = telemetry.getTimeSpentSec();
                    this.loadWave(1);
                    this.startWaveInterval();
                },

                restartGame() {
                    this.stopTimers();
                    telemetry.reset({ allowRecomplete: true });
                    this.startGame();
                },

                handleAfkPaused() {
                    this.afkPaused = true;
                    this.stopTimers();
                },

                handleAfkResumed() {
                    this.afkPaused = false;
                    this.alarmActive = false;
                    this.isActionBlocked = false;
                    this.activeWaves = generateWaves();
                    this.loadWave(1);
                    this.startWaveInterval();
                },

                moveCursor(deltaVisual) {
                    // Визуально слева направо: 7, 6, 5, 4, 3, 2, 1, 0
                    const next = (this.cursorBit - deltaVisual + 8) % 8;
                    this.cursorBit = next;
                    playCursorSound();
                },

                toggleBitAt(bitIdx) {
                    const nextVal = this.bits[bitIdx] === 1 ? 0 : 1;
                    this.bits[bitIdx] = nextVal;
                    this.lastToggledBit = bitIdx;
                    playBitFlipSound(nextVal);
                    setTimeout(() => {
                        if (this.lastToggledBit === bitIdx) this.lastToggledBit = -1;
                    }, 180);
                },

                clearCursorBit() {
                    this.bits[this.cursorBit] = 0;
                    this.lastToggledBit = this.cursorBit;
                    playBitFlipSound(0);
                    setTimeout(() => {
                        if (this.lastToggledBit === this.cursorBit) this.lastToggledBit = -1;
                    }, 180);
                },

                toggleBusMode() {
                    this.busMode = this.busMode === 'HEX' ? 'OCT' : 'HEX';
                    this.modeFlash = true;
                    playModeSwitchSound();
                    setTimeout(() => { this.modeFlash = false; }, 180);
                },

                triggerHardcoreReset(message, isTimeout) {
                    if (this.alarmActive || this.isActionBlocked) return;
                    this.isActionBlocked = true;
                    this.stopTimers();
                    playAlarmSiren();

                    this.screenShake = true;
                    setTimeout(() => { this.screenShake = false; }, 260);

                    const res = telemetry.fail({ wave: this.currentWave, isTimeout: Boolean(isTimeout) });
                    this.alarmCount = telemetry.getState().attemptsCount;

                    if (res === false || telemetry.getState().isAfkPaused) {
                        this.afkPaused = true;
                        return;
                    }

                    this.alarmMessage = message;
                    this.alarmActive = true;

                    resetTimeoutId = setTimeout(() => {
                        resetTimeoutId = null;
                        if (this.afkPaused || this.gameState !== 'playing') return;
                        this.activeWaves = generateWaves();
                        this.loadWave(1);
                        this.startWaveInterval();
                    }, 1500);
                },

                commitBus() {
                    if (this.alarmActive || this.isActionBlocked || this.afkPaused) return;
                    const w = this.currentWaveData;
                    const regVal = this.getRegisterValue();

                    if (this.busMode !== w.targetMode) {
                        this.triggerHardcoreReset(`Неверный режим шины (${this.busMode} вместо ${w.targetMode})! Переключайте режим клавишей Shift.`, false);
                        return;
                    }
                    if (regVal !== w.targetValue) {
                        this.triggerHardcoreReset('Код в регистре ACC не соответствует требуемому значению!', false);
                        return;
                    }

                    this.isActionBlocked = true;
                    this.busSuccessFlash = true;
                    setTimeout(() => { this.busSuccessFlash = false; }, 220);

                    if (this.currentWave >= 10) {
                        this.stopTimers();
                        this.totalElapsedSec = telemetry.getTimeSpentSec();
                        playVictoryFanfare();
                        telemetry.complete({ wave: 10, total_waves: 10 });
                        this.gameState = 'victory';
                        this.isActionBlocked = false;
                        return;
                    }

                    playWaveClearSound();
                    const nextWave = this.currentWave + 1;
                    telemetry.advanceWave(nextWave);
                    this.loadWave(nextWave);
                },

                handleKeyDown(e) {
                    if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'ArrowDown' || e.code === 'ArrowLeft' || e.code === 'ArrowRight') {
                        e.preventDefault();
                    }

                    if (this.afkPaused || telemetry.getState().isAfkPaused) {
                        if (e.code === 'Space') {
                            telemetry.resumeFromAfk();
                        }
                        return;
                    }

                    if (this.gameState === 'intro') {
                        if (e.code === 'Space') {
                            this.startGame();
                        }
                        return;
                    }

                    if (this.gameState === 'victory') {
                        if (e.code === 'Space') {
                            this.restartGame();
                        }
                        return;
                    }

                    if (this.gameState !== 'playing' || this.alarmActive || this.isActionBlocked) {
                        return;
                    }

                    switch (e.code) {
                        case 'KeyA':
                        case 'ArrowLeft':
                            this.moveCursor(-1);
                            return;
                        case 'KeyD':
                        case 'ArrowRight':
                            this.moveCursor(1);
                            return;
                        case 'KeyW':
                        case 'ArrowUp':
                            this.toggleBitAt(this.cursorBit);
                            return;
                        case 'KeyS':
                        case 'ArrowDown':
                            this.clearCursorBit();
                            return;
                        case 'ShiftLeft':
                        case 'ShiftRight':
                            this.toggleBusMode();
                            return;
                        case 'Space':
                            this.commitBus();
                            return;
                        default:
                            break;
                    }

                    const digitMatch = e.code && (e.code.match(/^Digit([0-7])$/) || e.code.match(/^Numpad([0-7])$/));
                    if (digitMatch) {
                        const bitIdx = Number(digitMatch[1]);
                        this.cursorBit = bitIdx;
                        this.toggleBitAt(bitIdx);
                    }
                },

                formatTime(sec) {
                    const m = Math.floor(sec / 60);
                    const s = sec % 60;
                    return `${m}м ${String(s).padStart(2, '0')}с`;
                }
            }
        });

        appInstance = app.mount('#arcade-app');

        // Отладочный и регрессионный хук E2E (не используется в тестах персон Black-Box)
        window.__DEV_LEVEL3_STATE__ = {
            get waves() {
                return appInstance ? appInstance.activeWaves : [];
            },
            get currentWaveIndex() {
                return appInstance ? appInstance.currentWave - 1 : 0;
            },
            get currentWave() {
                return appInstance ? appInstance.currentWaveData : null;
            },
            solveCurrentWave() {
                if (!appInstance || appInstance.gameState !== 'playing' || appInstance.alarmActive || appInstance.isActionBlocked || appInstance.afkPaused) {
                    return false;
                }
                const w = appInstance.currentWaveData;
                appInstance.applyRegisterValue(w.targetValue);
                appInstance.busMode = w.targetMode;
                appInstance.commitBus();
                return true;
            },
            submitAction(action) {
                if (!appInstance) return false;
                if (action === 'solve') {
                    return this.solveCurrentWave();
                }
                if (action === 'wrong') {
                    if (appInstance.gameState !== 'playing' || appInstance.alarmActive || appInstance.isActionBlocked) return false;
                    const w = appInstance.currentWaveData;
                    appInstance.applyRegisterValue(w.targetValue ^ 1);
                    appInstance.busMode = w.targetMode;
                    appInstance.commitBus();
                    return true;
                }
                if (action === 'timeout') {
                    appInstance.triggerHardcoreReset('Тайм-аут конвейера (тест)', true);
                    return true;
                }
                return false;
            }
        };
    })();
    </script>
</TaskLayout>
