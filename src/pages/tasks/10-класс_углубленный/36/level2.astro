---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={2}>
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Шапка тренажера -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h4 text-warning mb-0">Тренажер: Системы счисления 2, 8, 16 и связь между ними (Уровень 2)</h2>
            <span class="badge border border-warning text-warning bg-dark rounded-0 px-3 py-2">Ручной ввод // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-warning rounded-0">
            <div class="card-body p-3 p-md-4">

                <!-- Заголовок фазы и телеметрия -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="phase-badge" class="badge bg-warning text-dark rounded-0 fs-6 me-2">Шаг 1 из 5</span>
                        <span id="phase-title" class="text-light fw-bold fs-6">Прямой перевод триадами и тетрадами</span>
                    </div>
                    <div class="text-secondary small">
                        Ошибки: <span id="attempts-display" class="text-warning">0</span> | Время: <span id="timer-display" class="text-info">00:00</span>
                    </div>
                </div>

                <!-- Системный баннер ошибки -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <span>[ОШИБКА РАСЧЕТА] <span id="feedback-text">Неверный ответ!</span> Генерируется новый вариант...</span>
                        <span class="spinner-border spinner-border-sm text-danger flex-shrink-0" role="status"></span>
                    </div>
                </div>

                <!-- ==================== ФАЗА 1: ПРЯМОЙ РАСЧЕТ (CCS = 4) ==================== -->
                <div id="phase1" class="phase-container">
                    <p class="text-light mb-2">
                        Выполните прямой перевод целого двоичного числа в указанную родственную систему счисления методом группировки разрядов справа налево.
                    </p>
                    <div id="p1-condition" class="card bg-black border-secondary rounded-0 p-3 mb-3 text-light">
                        <!-- Генерируется JS -->
                    </div>
                    <div class="mb-3 w-100" style="max-width: 580px;">
                        <label id="p1-label" for="p1-input" class="form-label text-warning small text-uppercase">
                            Введите результат (без индекса основания):
                        </label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" id="p1-input" class="form-control rounded-0 bg-black text-warning border-secondary font-monospace" placeholder="Например: 3B7" autocomplete="off" style="min-height: 48px;">
                            <button id="p1-submit-btn" type="button" class="btn btn-warning rounded-0 fw-bold px-4" style="min-height: 48px;">Проверить</button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ФАЗА 2: СМЕШАННЫЙ ПЕРЕВОД С ДРОБЬЮ (CCS = 6) ==================== -->
                <div id="phase2" class="phase-container d-none">
                    <p class="text-light mb-2">
                        Переведите смешанное двоичное число с дробной частью в родственную систему счисления, соблюдая выравнивание триад/тетрад от запятой.
                    </p>
                    <div id="p2-condition" class="card bg-black border-secondary rounded-0 p-3 mb-3 text-light">
                        <!-- Генерируется JS -->
                    </div>
                    <div class="mb-3 w-100" style="max-width: 580px;">
                        <label id="p2-label" for="p2-input" class="form-label text-warning small text-uppercase">
                            Введите результат (разделитель — запятая или точка, без незначащих нулей):
                        </label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" id="p2-input" class="form-control rounded-0 bg-black text-warning border-secondary font-monospace" placeholder="Например: A5,C" autocomplete="off" style="min-height: 48px;">
                            <button id="p2-submit-btn" type="button" class="btn btn-warning rounded-0 fw-bold px-4" style="min-height: 48px;">Проверить</button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ФАЗА 3: ПИК ИНВЕРСИИ / ОБРАТНАЯ ЗАДАЧА НА СДВИГ (CCS = 7-8) ==================== -->
                <div id="phase3" class="phase-container d-none">
                    <p class="text-light mb-2">
                        Обратная задача: восстановите исходный шестнадцатеричный код по результату битового сдвига и добавления младшей группы разрядов.
                    </p>
                    <div id="p3-condition" class="card bg-black border-secondary rounded-0 p-3 mb-3 text-light">
                        <!-- Генерируется JS -->
                    </div>
                    <div class="mb-3 w-100" style="max-width: 580px;">
                        <label for="p3-input" class="form-label text-warning small text-uppercase">
                            Введите исходное число X в шестнадцатеричной системе:
                        </label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" id="p3-input" class="form-control rounded-0 bg-black text-warning border-secondary font-monospace" placeholder="Например: 5C" autocomplete="off" style="min-height: 48px;">
                            <button id="p3-submit-btn" type="button" class="btn btn-warning rounded-0 fw-bold px-4" style="min-height: 48px;">Проверить</button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ФАЗА 4: ДОЛИНА КОНСОЛИДАЦИИ / ИНВАРИАНТ (CCS = 5-6) ==================== -->
                <div id="phase4" class="phase-container d-none">
                    <p class="text-light mb-2">
                        Долина консолидации: выполните быструю оценку диапазона или битовой длины префикса без громоздких вычислений.
                    </p>
                    <div id="p4-condition" class="card bg-black border-secondary rounded-0 p-3 mb-3 text-light">
                        <!-- Генерируется JS -->
                    </div>
                    <div class="mb-3 w-100" style="max-width: 580px;">
                        <label id="p4-label" for="p4-input" class="form-label text-warning small text-uppercase">
                            Введите целое число:
                        </label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" id="p4-input" class="form-control rounded-0 bg-black text-warning border-secondary font-monospace" placeholder="Например: 24" autocomplete="off" style="min-height: 48px;">
                            <button id="p4-submit-btn" type="button" class="btn btn-warning rounded-0 fw-bold px-4" style="min-height: 48px;">Проверить</button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ФАЗА 5: КУЛЬМИНАЦИЯ / СТЕПЕННЫЕ ВЫРАЖЕНИЯ ЕГЭ №14 (CCS = 8-9) ==================== -->
                <div id="phase5" class="phase-container d-none">
                    <p class="text-light mb-2">
                        Финальная кульминация: приведите все основания степенного выражения к единой системе счисления и определите точное количество указанных цифр.
                    </p>
                    <div id="p5-condition" class="card bg-black border-secondary rounded-0 p-3 mb-3 text-light">
                        <!-- Генерируется JS -->
                    </div>
                    <div class="mb-3 w-100" style="max-width: 580px;">
                        <label id="p5-label" for="p5-input" class="form-label text-warning small text-uppercase">
                            Введите количество цифр:
                        </label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" id="p5-input" class="form-control rounded-0 bg-black text-warning border-secondary font-monospace" placeholder="Например: 11" autocomplete="off" style="min-height: 48px;">
                            <button id="p5-submit-btn" type="button" class="btn btn-warning rounded-0 fw-bold px-4" style="min-height: 48px;">Проверить</button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ЭКРАН ПОБЕДЫ ==================== -->
                <div id="victory-screen" class="d-none text-center py-4">
                    <div class="border border-warning bg-black p-4 mb-3">
                        <h3 class="text-warning mb-2">[ УРОВЕНЬ 2 ПРОЙДЕН ]</h3>
                        <p class="text-light mb-3">Все 5 фаз аналитического перевода и битового синтеза систем 2, 8 и 16 выполнены вручную.</p>
                        <div class="d-flex justify-content-center gap-4 text-secondary small">
                            <span>Ошибок: <strong id="final-attempts" class="text-warning">0</strong></span>
                            <span>Время: <strong id="final-time" class="text-info">00:00</strong></span>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0">Переключайтесь на вкладку «Уровень 3» для аркадного испытания на скорость и точность.</p>
                </div>

            </div>
        </div>
    </div>

    <script is:inline>
    (function() {
        const HEX_DIGITS = '0123456789ABCDEF';
        const FORBIDDEN_VALS = new Set([0x3A, 0x4A, 0x7F, 0x89, 0xB6, 0xF0, 0xFF, 0x1A2B]);
        const FORBIDDEN_STRS = new Set(['1777', '0750', '1750', '3E8', '604', '723', '4652', '3745', '5BA', '2C0', '9AA', '7E5', '3A', '112']);

        let currentPhase = 1;
        let isProcessingError = false;
        let timerInterval = null;

        const telemetry = window.LMSTelemetry.create({
            missionName: 'Урок 36 :: Двоичная, восьмеричная и шестнадцатеричная системы счисления, связь между ними (Уровень 2)',
            level: 2,
            totalStages: 5
        });

        const attemptsDisplay = document.getElementById('attempts-display');
        const timerDisplay = document.getElementById('timer-display');
        const phaseBadge = document.getElementById('phase-badge');
        const phaseTitle = document.getElementById('phase-title');
        const feedbackBox = document.getElementById('feedback-box');
        const feedbackText = document.getElementById('feedback-text');

        function randInt(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function pickRandom(arr) {
            return arr[Math.floor(Math.random() * arr.length)];
        }

        function formatTime(sec) {
            const m = String(Math.floor(sec / 60)).padStart(2, '0');
            const s = String(sec % 60).padStart(2, '0');
            return `${m}:${s}`;
        }

        function updateTimerDisplay() {
            if (timerDisplay) {
                timerDisplay.textContent = formatTime(telemetry.getTimeSpentSec());
            }
        }

        function normalizeNumericText(raw) {
            return String(raw || '').replace(/%/g, '').replace(/,/g, '.').trim();
        }

        function normalizeBaseCode(raw, prefixRe) {
            let s = normalizeNumericText(raw).replace(/\s+/g, '').toUpperCase();
            if (prefixRe) s = s.replace(prefixRe, '');
            s = s.replace(/^0+(?=[0-9A-F])/, '');
            return s;
        }

        function normalizeMixedBase(raw, prefixRe) {
            let s = normalizeNumericText(raw).replace(/\s+/g, '').toUpperCase();
            if (prefixRe) s = s.replace(prefixRe, '');
            if (!s.includes('.')) {
                return s.replace(/^0+(?=[0-9A-F])/, '');
            }
            const parts = s.split('.');
            if (parts.length !== 2) return s;
            const intPart = parts[0].replace(/^0+(?=[0-9A-F])/, '') || '0';
            const fracPart = parts[1].replace(/0+$/, '');
            return fracPart ? `${intPart}.${fracPart}` : intPart;
        }

        function baseSpan(text, base) {
            return `<span>${text}<sub>${base}</sub></span>`;
        }

        function triggerFailure(message, resetCallback) {
            if (isProcessingError) return;
            isProcessingError = true;
            telemetry.fail({ stage: currentPhase, total_stages: 5 });
            if (attemptsDisplay) {
                attemptsDisplay.textContent = String(telemetry.getState().attemptsCount);
            }
            if (feedbackText) feedbackText.textContent = message;
            if (feedbackBox) feedbackBox.classList.remove('d-none');

            setTimeout(() => {
                if (feedbackBox) feedbackBox.classList.add('d-none');
                isProcessingError = false;
                resetCallback();
            }, 1250);
        }

        const PHASE_META = {
            1: { title: 'Прямой перевод триадами и тетрадами', gen: () => generatePhase1(), inputId: 'p1-input' },
            2: { title: 'Смешанный перевод с дробной частью', gen: () => generatePhase2(), inputId: 'p2-input' },
            3: { title: 'Пик инверсии: обратная задача на битовый сдвиг', gen: () => generatePhase3(), inputId: 'p3-input' },
            4: { title: 'Долина консолидации: диапазон и маска подсети', gen: () => generatePhase4(), inputId: 'p4-input' },
            5: { title: 'Кульминация: степенные выражения формата ЕГЭ', gen: () => generatePhase5(), inputId: 'p5-input' }
        };

        function switchToPhase(nextPhase) {
            document.getElementById(`phase${currentPhase}`).classList.add('d-none');
            currentPhase = nextPhase;
            if (nextPhase <= 5) {
                telemetry.advanceStage(nextPhase);
                document.getElementById(`phase${nextPhase}`).classList.remove('d-none');
                phaseBadge.textContent = `Шаг ${nextPhase} из 5`;
                phaseTitle.textContent = PHASE_META[nextPhase].title;
                PHASE_META[nextPhase].gen();
                const inp = document.getElementById(PHASE_META[nextPhase].inputId);
                if (inp) inp.focus();
            }
        }

        function showVictory() {
            document.getElementById('phase5').classList.add('d-none');
            if (timerInterval) clearInterval(timerInterval);
            telemetry.complete({ stage: 5, total_stages: 5 });
            document.getElementById('final-attempts').textContent = String(telemetry.getState().attemptsCount);
            document.getElementById('final-time').textContent = formatTime(telemetry.getTimeSpentSec());
            document.getElementById('victory-screen').classList.remove('d-none');
            phaseBadge.textContent = 'Завершено';
            phaseTitle.textContent = 'Все 5 фаз выполнены';
        }

        /* =========================================================================
           ФАЗА 1: ПРЯМОЙ РАСЧЕТ 2 -> 8 ИЛИ 16 (CCS = 4)
           ========================================================================= */
        const p1State = { dstBase: 16, expected: '', prevKey: '' };

        function generatePhase1() {
            let val = 0;
            let dstBase = 16;
            let expected = '';
            for (let guard = 0; guard < 35; guard++) {
                dstBase = Math.random() < 0.5 ? 16 : 8;
                val = randInt(160, 2040);
                expected = val.toString(dstBase).toUpperCase();
                const hasHexLetter = dstBase === 8 || /[A-F]/.test(expected);
                if (hasHexLetter && !FORBIDDEN_VALS.has(val) && !FORBIDDEN_STRS.has(expected) && `${dstBase}:${val}` !== p1State.prevKey) {
                    break;
                }
            }
            p1State.dstBase = dstBase;
            p1State.expected = expected;
            p1State.prevKey = `${dstBase}:${val}`;

            const binStr = val.toString(2);
            const condEl = document.getElementById('p1-condition');
            condEl.innerHTML = `
                <div class="fs-5 mb-2">Исходное число: <strong class="text-warning">${baseSpan(binStr, 2)}</strong></div>
                <div class="text-secondary small">Переведите данное целое число в <strong class="text-light">${dstBase === 16 ? 'шестнадцатеричную (q = 16)' : 'восьмеричную (q = 8)'}</strong> систему счисления.</div>
            `;
            document.getElementById('p1-label').textContent = `Введите результат в системе с основанием ${dstBase}:`;
            const inp = document.getElementById('p1-input');
            inp.value = '';
            inp.placeholder = dstBase === 16 ? 'Например: 3B7' : 'Например: 1543';
        }

        function checkPhase1() {
            const inp = document.getElementById('p1-input');
            const norm = normalizeBaseCode(inp.value, p1State.dstBase === 16 ? /^0X/ : /^0O/);
            if (!norm) {
                triggerFailure('Поле ответа пустое! Введите переведенное число.', generatePhase1);
                return;
            }
            if (norm === p1State.expected) {
                switchToPhase(2);
            } else {
                triggerFailure(`Неверный перевод в систему q = ${p1State.dstBase}! Группируйте биты справа налево по ${p1State.dstBase === 16 ? 4 : 3} разряда.`, generatePhase1);
            }
        }

        /* =========================================================================
           ФАЗА 2: СМЕШАННЫЙ ПЕРЕВОД С ДРОБЬЮ 2 -> 8 / 16 (CCS = 6)
           ========================================================================= */
        const p2State = { dstBase: 8, expected: '', prevKey: '' };

        function generatePhase2() {
            let intVal = 0;
            let f5 = 1;
            let dstBase = 8;
            let expected = '';
            let binDisplay = '';

            for (let guard = 0; guard < 40; guard++) {
                dstBase = Math.random() < 0.5 ? 8 : 16;
                intVal = randInt(65, 254);
                f5 = randInt(0, 15) * 2 + 1; // нечетное 5-битное: последний бит = 1
                if (FORBIDDEN_VALS.has(intVal)) continue;
                const intTarget = intVal.toString(dstBase).toUpperCase();
                if (FORBIDDEN_STRS.has(intTarget)) continue;
                if (dstBase === 16 && !/[A-F]/.test(intTarget)) continue;

                const fracBin = f5.toString(2).padStart(5, '0');
                binDisplay = `${intVal.toString(2)},${fracBin}`;
                let fracTarget = '';
                if (dstBase === 8) {
                    const f6 = f5 << 1; // дополняем 1 нулем справа до 6 бит
                    fracTarget = `${(f6 >> 3).toString(8)}${(f6 & 7).toString(8)}`;
                } else {
                    const f8 = f5 << 3; // дополняем 3 нулями справа до 8 бит
                    fracTarget = `${HEX_DIGITS[f8 >> 4]}8`;
                }
                expected = `${intTarget}.${fracTarget}`;
                if (`${dstBase}:${binDisplay}` !== p2State.prevKey) break;
            }

            p2State.dstBase = dstBase;
            p2State.expected = expected;
            p2State.prevKey = `${dstBase}:${binDisplay}`;

            document.getElementById('p2-condition').innerHTML = `
                <div class="fs-5 mb-2">Смешанное двоичное число: <strong class="text-warning">${baseSpan(binDisplay, 2)}</strong></div>
                <div class="text-secondary small">Переведите число в <strong class="text-light">${dstBase === 16 ? 'шестнадцатеричную (q = 16)' : 'восьмеричную (q = 8)'}</strong> систему счисления. Разделитель целой и дробной части — запятая или точка.</div>
            `;
            document.getElementById('p2-label').textContent = `Введите итоговое число в системе с основанием ${dstBase}:`;
            const inp = document.getElementById('p2-input');
            inp.value = '';
            inp.placeholder = dstBase === 8 ? 'Например: 245,36' : 'Например: B4,98';
        }

        function checkPhase2() {
            const inp = document.getElementById('p2-input');
            const norm = normalizeMixedBase(inp.value, p2State.dstBase === 16 ? /^0X/ : /^0O/);
            if (!norm) {
                triggerFailure('Введите смешанное число с дробной частью!', generatePhase2);
                return;
            }
            if (norm === p2State.expected) {
                switchToPhase(3);
            } else {
                triggerFailure('Ошибка группировки! Целую часть делите от запятой влево, а дробную — от запятой вправо с дописыванием нулей справа.', generatePhase2);
            }
        }

        /* =========================================================================
           ФАЗА 3: ПИК ИНВЕРСИИ / ОБРАТНАЯ ЗАДАЧА НА БИТОВЫЙ СДВИГ (CCS = 7-8)
           ========================================================================= */
        const p3State = { expectedHex: '', prevKey: '' };

        function generatePhase3() {
            const modeShift3 = Math.random() < 0.5;
            let xVal = 0;
            let extraDigit = 0;
            let rVal = 0;
            let condHtml = '';

            if (modeShift3) {
                for (let guard = 0; guard < 35; guard++) {
                    xVal = randInt(0x21, 0x7E);
                    const xHex = xVal.toString(16).toUpperCase();
                    if (!/[A-F]/.test(xHex) || FORBIDDEN_VALS.has(xVal) || FORBIDDEN_STRS.has(xHex)) continue;
                    extraDigit = randInt(1, 7);
                    rVal = (xVal << 3) | extraDigit;
                    if (`3:${rVal}` !== p3State.prevKey) break;
                }
                const rHex = rVal.toString(16).toUpperCase();
                p3State.prevKey = `3:${rVal}`;
                condHtml = `
                    <div class="mb-2">Задумано целое число <strong>X</strong>. Его двоичную запись сдвинули влево на <strong>3 бита</strong> (<code>X &lt;&lt; 3</code>) и дописали справа одну восьмеричную цифру <code>${extraDigit}</code>.</div>
                    <div class="fs-5 text-warning">Полученный 11–12-битный результат в шестнадцатеричной системе равен: <strong>${baseSpan(rHex, 16)}</strong></div>
                    <div class="text-secondary small mt-2">Определите исходное число X и запишите его в шестнадцатеричной системе.</div>
                `;
            } else {
                for (let guard = 0; guard < 35; guard++) {
                    xVal = randInt(0x1A, 0x3E);
                    const xHex = xVal.toString(16).toUpperCase();
                    if (!/[A-F]/.test(xHex) || FORBIDDEN_VALS.has(xVal) || FORBIDDEN_STRS.has(xHex)) continue;
                    extraDigit = randInt(9, 15);
                    rVal = (xVal << 4) | extraDigit;
                    if (`4:${rVal}` !== p3State.prevKey) break;
                }
                const rOct = rVal.toString(8);
                const hChar = HEX_DIGITS[extraDigit];
                p3State.prevKey = `4:${rVal}`;
                condHtml = `
                    <div class="mb-2">Задумано целое число <strong>X</strong>. Его двоичную запись сдвинули влево на <strong>4 бита</strong> (<code>X &lt;&lt; 4</code>) и дописали справа одну шестнадцатеричную цифру <code>${hChar}</code>.</div>
                    <div class="fs-5 text-warning">Итоговое число в восьмеричной системе равно: <strong>${baseSpan(rOct, 8)}</strong></div>
                    <div class="text-secondary small mt-2">Восстановите исходное число X и запишите его в шестнадцатеричной системе.</div>
                `;
            }

            p3State.expectedHex = xVal.toString(16).toUpperCase();
            document.getElementById('p3-condition').innerHTML = condHtml;
            const inp = document.getElementById('p3-input');
            inp.value = '';
        }

        function checkPhase3() {
            const inp = document.getElementById('p3-input');
            const norm = normalizeBaseCode(inp.value, /^0X/);
            if (!norm) {
                triggerFailure('Введите восстановленное значение X в шестнадцатеричной системе!', generatePhase3);
                return;
            }
            if (norm === p3State.expectedHex) {
                switchToPhase(4);
            } else {
                triggerFailure('Ошибка обратной реконструкции! Переведите результат в двоичную запись, отбросьте младшие добавленные биты и сгруппируйте оставшиеся в тетрады.', generatePhase3);
            }
        }

        /* =========================================================================
           ФАЗА 4: ДОЛИНА КОНСОЛИДАЦИИ / ИНВАРИАНТ (CCS = 5-6)
           ========================================================================= */
        const p4State = { expected: 0, mode: 'range', prevKey: '' };

        function generatePhase4() {
            const mode = Math.random() < 0.5 ? 'range' : 'cidr';
            p4State.mode = mode;

            if (mode === 'range') {
                let a = 0;
                let b = 0;
                for (let guard = 0; guard < 35; guard++) {
                    a = randInt(0x22, 0x6F);
                    b = a + randInt(9, 26);
                    if (FORBIDDEN_VALS.has(a) || FORBIDDEN_VALS.has(b) || b === 0o112) continue;
                    const aHex = a.toString(16).toUpperCase();
                    if (!/[A-F]/.test(aHex) || FORBIDDEN_STRS.has(aHex)) continue;
                    if (`range:${a}:${b}` !== p4State.prevKey) break;
                }
                p4State.prevKey = `range:${a}:${b}`;
                p4State.expected = b - a - 1;

                const aHex = a.toString(16).toUpperCase();
                const bOct = b.toString(8);
                document.getElementById('p4-condition').innerHTML = `
                    <div class="mb-2">Дано строгое двойное неравенство:</div>
                    <div class="fs-5 text-warning mb-2"><strong>${baseSpan(aHex, 16)} &lt; x &lt; ${baseSpan(bOct, 8)}</strong></div>
                    <div class="text-secondary small">Сколько натуральных чисел <code>x</code> удовлетворяют этому неравенству?</div>
                `;
                document.getElementById('p4-label').textContent = 'Введите количество натуральных чисел:';
                document.getElementById('p4-input').placeholder = 'Например: 14';
            } else {
                const prefixes = [17, 18, 19, 20, 21, 22, 23, 25, 26, 27, 29, 30]; // исключаем /28 (FF.FF.FF.F0) из theory.md
                let prefix = pickRandom(prefixes);
                while (`cidr:${prefix}` === p4State.prevKey) {
                    prefix = pickRandom(prefixes);
                }
                p4State.prevKey = `cidr:${prefix}`;
                p4State.expected = prefix;

                const mask32 = (0xFFFFFFFF << (32 - prefix)) >>> 0;
                const octetsHex = [
                    ((mask32 >>> 24) & 0xFF).toString(16).toUpperCase().padStart(2, '0'),
                    ((mask32 >>> 16) & 0xFF).toString(16).toUpperCase().padStart(2, '0'),
                    ((mask32 >>> 8) & 0xFF).toString(16).toUpperCase().padStart(2, '0'),
                    (mask32 & 0xFF).toString(16).toUpperCase().padStart(2, '0')
                ].join('.');

                document.getElementById('p4-condition').innerHTML = `
                    <div class="mb-2">32-битная маска подсети IPv4 записана побайтово в шестнадцатеричном виде:</div>
                    <div class="fs-5 text-warning mb-2"><strong>${octetsHex}</strong></div>
                    <div class="text-secondary small">Определите длину сетевого префикса (суммарное количество единичных бит в этой маске).</div>
                `;
                document.getElementById('p4-label').textContent = 'Введите количество единичных бит (длину префикса CIDR):';
                document.getElementById('p4-input').placeholder = 'Например: 26';
            }

            document.getElementById('p4-input').value = '';
        }

        function checkPhase4() {
            const inp = document.getElementById('p4-input');
            const norm = normalizeNumericText(inp.value).replace(/^\//, '').replace(/\s+/g, '');
            const val = Number(norm);
            if (!norm || !Number.isInteger(val)) {
                triggerFailure('Введите целое десятичное число!', generatePhase4);
                return;
            }
            if (val === p4State.expected) {
                switchToPhase(5);
            } else {
                const msg = p4State.mode === 'range'
                    ? 'Ошибка подсчета интервала! Для строгого неравенства a < x < b число целых решений равно b − a − 1.'
                    : 'Ошибка подсчета единиц маски! Переведите неполный октет в двоичную тетраду.';
                triggerFailure(msg, generatePhase4);
            }
        }

        /* =========================================================================
           ФАЗА 5: КУЛЬМИНАЦИЯ / СТЕПЕННЫЕ ВЫРАЖЕНИЯ ЕГЭ №14 (CCS = 8-9)
           ========================================================================= */
        const p5State = { expected: 0, base: 16, prevKey: '' };

        function generatePhase5() {
            const useHex = Math.random() < 0.5;
            let expA = 0, expB = 0, expC = 0, k = 1;
            let askTargetDigit = Math.random() < 0.5;
            let exprHtml = '';

            if (useHex) {
                p5State.base = 16;
                for (let guard = 0; guard < 30; guard++) {
                    k = pickRandom([1, 2]);
                    expC = 3 * k;
                    expB = expC + randInt(2, 6);
                    expA = expB + randInt(4, 9);
                    if (expA === 12 && expB === 5 && expC === 3) continue; // исключаем пример из theory.md
                    const key = `16:${expA}:${expB}:${expC}:${askTargetDigit}`;
                    if (key !== p5State.prevKey) {
                        p5State.prevKey = key;
                        break;
                    }
                }
                const pow4 = 2 * expB;
                const pow8 = 4 * k;
                exprHtml = `16<sup>${expA}</sup> + 4<sup>${pow4}</sup> − 8<sup>${pow8}</sup>`;
                p5State.expected = askTargetDigit ? (expB - expC) : ((expA - expB) + expC);
            } else {
                p5State.base = 8;
                for (let guard = 0; guard < 30; guard++) {
                    k = pickRandom([1, 2, 3]);
                    expC = 2 * k;
                    expB = expC + randInt(2, 6);
                    expA = expB + randInt(4, 9);
                    const key = `8:${expA}:${expB}:${expC}:${askTargetDigit}`;
                    if (key !== p5State.prevKey) {
                        p5State.prevKey = key;
                        break;
                    }
                }
                const pow2 = 3 * expB;
                const pow4 = 3 * k;
                exprHtml = `8<sup>${expA}</sup> + 2<sup>${pow2}</sup> − 4<sup>${pow4}</sup>`;
                p5State.expected = askTargetDigit ? (expB - expC) : ((expA - expB) + expC);
            }

            const targetSystemName = useHex ? 'шестнадцатеричной' : 'восьмеричной';
            const digitDesc = askTargetDigit
                ? `цифр <strong>${useHex ? 'F' : '7'}</strong>`
                : 'значащих цифр <strong>0</strong>';

            document.getElementById('p5-condition').innerHTML = `
                <div class="mb-2">Значение арифметического выражения:</div>
                <div class="fs-4 text-warning mb-2"><strong>${exprHtml}</strong></div>
                <div class="text-secondary small">записали в системе счисления с основанием <strong class="text-light">${p5State.base}</strong>. Сколько ${digitDesc} содержится в этой ${targetSystemName} записи?</div>
            `;
            document.getElementById('p5-label').textContent = `Введите количество ${askTargetDigit ? (useHex ? 'цифр F' : 'цифр 7') : 'нулей'} в записи:`;
            const inp = document.getElementById('p5-input');
            inp.value = '';
            inp.placeholder = 'Например: 9';
        }

        function checkPhase5() {
            const inp = document.getElementById('p5-input');
            const norm = normalizeNumericText(inp.value).replace(/\s+/g, '');
            const val = Number(norm);
            if (!norm || !Number.isInteger(val)) {
                triggerFailure('Введите целое количество цифр!', generatePhase5);
                return;
            }
            if (val === p5State.expected) {
                showVictory();
            } else {
                triggerFailure(`Неверный подсчет разрядов в системе q = ${p5State.base}! Приведите все степени к основанию ${p5State.base} и используйте правило qⁿ − qᵐ.`, generatePhase5);
            }
        }

        /* =========================================================================
           ОДНОКРАТНАЯ ПОДПИСКА СЛУШАТЕЛЕЙ СОБЫТИЙ
           ========================================================================= */
        function bindEventsOnce() {
            const checkers = {
                1: checkPhase1,
                2: checkPhase2,
                3: checkPhase3,
                4: checkPhase4,
                5: checkPhase5
            };

            for (let phase = 1; phase <= 5; phase++) {
                const btn = document.getElementById(`p${phase}-submit-btn`);
                const inp = document.getElementById(`p${phase}-input`);
                const handler = checkers[phase];

                btn.addEventListener('click', () => {
                    if (isProcessingError || currentPhase !== phase) return;
                    handler();
                });

                inp.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' && !isProcessingError && currentPhase === phase) {
                        e.preventDefault();
                        handler();
                    }
                });
            }
        }

        // Инициализация тренажера
        bindEventsOnce();
        timerInterval = setInterval(updateTimerDisplay, 1000);
        generatePhase1();
    })();
    </script>
</TaskLayout>
