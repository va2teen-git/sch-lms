        // --- Утилиты генерации и форматирования ---
        function randInt(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function pick(arr) {
            return arr[randInt(0, arr.length - 1)];
        }

        function formatIntValue(val, base, minBinBits = 8) {
            if (base === 2) return val.toString(2).padStart(minBinBits, '0');
            if (base === 8) return val.toString(8);
            return val.toString(16).toUpperCase();
        }

        function formatFracValue(num16, base) {
            if (base === 2) {
                const raw4 = num16.toString(2).padStart(4, '0');
                return '0,' + (num16 % 2 === 1 ? raw4 : raw4.replace(/0+$/, ''));
            }
            if (base === 8) {
                const bits6 = num16 << 2;
                const o1 = (bits6 >> 3) & 7;
                const o2 = bits6 & 7;
                return '0,' + (o2 === 0 ? o1.toString(8) : o1.toString(8) + o2.toString(8));
            }
            return '0,' + num16.toString(16).toUpperCase();
        }

        function groupBinaryString(str, mode, isFraction) {
            if (mode === 'raw') return str;
            const g = mode === 'triad' ? 3 : 4;
            if (isFraction && str.includes(',')) {
                const parts = str.split(',');
                const frac = parts[1];
                const padNeed = (g - (frac.length % g)) % g;
                const padded = frac + '0'.repeat(padNeed);
                const chunks = [];
                for (let i = 0; i < padded.length; i += g) {
                    chunks.push(padded.slice(i, i + g));
                }
                return parts[0] + ',' + chunks.join(' ');
            }
            const padNeed = (g - (str.length % g)) % g;
            const padded = '0'.repeat(padNeed) + str;
            const chunks = [];
            for (let i = 0; i < padded.length; i += g) {
                chunks.push(padded.slice(i, i + g));
            }
            return chunks.join(' ');
        }

        function makeIntStep(axis, railIndex, row, col, srcBase, targetBase, mode, minVal, maxVal) {
            if (mode === 'direct') {
                let val = randInt(minVal, maxVal);
                if (srcBase === 16 || targetBase === 16) {
                    let guard = 0;
                    while (guard < 12 && !/[A-F]/.test(val.toString(16).toUpperCase())) {
                        val = randInt(minVal, maxVal);
                        guard += 1;
                    }
                }
                return {
                    axis,
                    railIndex,
                    row,
                    col,
                    srcKind: 'direct',
                    isFraction: false,
                    srcBase,
                    targetBase,
                    srcDisplay: formatIntValue(val, srcBase, 8),
                    answerKey: 'int:' + val,
                    answerVal: val,
                    rawDisplay: formatIntValue(val, targetBase, 8)
                };
            }

            if (mode === 'shift') {
                const isLeft = Math.random() < 0.5;
                const operand = isLeft ? randInt(16, 120) : randInt(32, 240) & ~1;
                const res = isLeft ? (operand << 1) : (operand >> 1);
                return {
                    axis,
                    railIndex,
                    row,
                    col,
                    srcKind: 'shift',
                    isFraction: false,
                    srcBase,
                    targetBase,
                    srcDisplay: formatIntValue(operand, srcBase, 8),
                    opLabel: isLeft ? '<< 1' : '>> 1',
                    answerKey: 'int:' + res,
                    answerVal: res,
                    rawDisplay: formatIntValue(res, targetBase, 8)
                };
            }

            // Побитовая маска (AND / OR / XOR)
            const maskObj = pick(MASKS_POOL);
            const opKind = pick(['AND', 'OR', 'XOR']);
            let operand = randInt(32, 245);
            let res = operand;
            let opSymbol = '&';
            if (opKind === 'AND') {
                res = operand & maskObj.val;
                opSymbol = '&';
            } else if (opKind === 'OR') {
                res = operand | maskObj.val;
                opSymbol = '|';
            } else {
                res = operand ^ maskObj.val;
                opSymbol = '⊕';
            }
            // Избегаем тривиального нуля при маске
            if (res === 0) {
                operand = operand | 0x5A;
                res = opKind === 'AND' ? (operand & maskObj.val) : (opKind === 'OR' ? (operand | maskObj.val) : (operand ^ maskObj.val));
            }
            const maskBase = srcBase === 8 ? 16 : pick([16, 2]);
            const maskDisplay = maskBase === 16 ? maskObj.hex : formatIntValue(maskObj.val, 2, 8);
            return {
                axis,
                railIndex,
                row,
                col,
                srcKind: 'mask',
                isFraction: false,
                srcBase,
                targetBase,
                srcDisplay: formatIntValue(operand, srcBase, 8),
                opSymbol,
                maskBase,
                maskDisplay,
                answerKey: 'int:' + res,
                answerVal: res,
                rawDisplay: formatIntValue(res, targetBase, 8)
            };
        }

        function makeFracStep(axis, railIndex, row, col, srcBase, targetBase) {
            const oddNums = [1, 3, 5, 7, 9, 11, 13, 15];
            const num16 = pick(oddNums);
            return {
                axis,
                railIndex,
                row,
                col,
                srcKind: 'direct',
                isFraction: true,
                srcBase,
                targetBase,
                srcDisplay: formatFracValue(num16, srcBase),
                answerKey: 'frac:' + num16,
                answerVal: num16,
                rawDisplay: formatFracValue(num16, targetBase)
            };
        }

        function pickDistractorCell(stepPool, forbiddenPairs, usedInCellRow, usedInCellCol, wantWrongBaseFromStep) {
            if (wantWrongBaseFromStep) {
                const altBases = [2, 8, 16].filter((b) => b !== wantWrongBaseFromStep.targetBase);
                for (const altBase of altBases) {
                    const pairSig = wantWrongBaseFromStep.answerKey + '@' + altBase;
                    if (
                        !forbiddenPairs.has(pairSig) &&
                        !usedInCellRow.has(pairSig) &&
                        !usedInCellCol.has(pairSig)
                    ) {
                        return {
                            key: wantWrongBaseFromStep.answerKey,
                            base: altBase,
                            isFraction: wantWrongBaseFromStep.isFraction,
                            rawDisplay: wantWrongBaseFromStep.isFraction
                                ? formatFracValue(wantWrongBaseFromStep.answerVal, altBase)
                                : formatIntValue(wantWrongBaseFromStep.answerVal, altBase, 8)
                        };
                    }
                }
            }

            const sampleStep = pick(stepPool);
            for (let attempt = 0; attempt < 60; attempt += 1) {
                const isFrac = sampleStep.isFraction;
                const base = pick([2, 8, 16]);
                let val;
                let key;
                let rawDisplay;

                if (isFrac) {
                    val = attempt < 24
                        ? Math.max(1, Math.min(15, sampleStep.answerVal + pick([-4, -2, -1, 1, 2, 4])))
                        : randInt(1, 15);
                    key = 'frac:' + val;
                    rawDisplay = formatFracValue(val, base);
                } else {
                    if (attempt < 24) {
                        const bitFlip = 1 << randInt(0, 6);
                        const cand = sampleStep.answerVal ^ bitFlip;
                        val = cand >= 1 && cand <= 255 ? cand : randInt(16, 255);
                    } else {
                        val = randInt(16, 255);
                    }
                    key = 'int:' + val;
                    rawDisplay = formatIntValue(val, base, 8);
                }

                const pairSig = key + '@' + base;
                if (!forbiddenPairs.has(pairSig) && !usedInCellRow.has(pairSig) && !usedInCellCol.has(pairSig)) {
                    return { key, base, isFraction: isFrac, rawDisplay };
                }
            }

            // Аварийный детерминированный перебор, гарантирующий отсутствие коллизий
            const fallbackBase = 16;
            for (let v = 16; v <= 255; v += 1) {
                const k = 'int:' + v;
                const sig = k + '@' + fallbackBase;
                if (!forbiddenPairs.has(sig) && !usedInCellRow.has(sig) && !usedInCellCol.has(sig)) {
                    return { key: k, base: fallbackBase, isFraction: false, rawDisplay: formatIntValue(v, fallbackBase, 8) };
                }
            }
            return { key: 'int:1', base: 16, isFraction: false, rawDisplay: '1' };
        }

        function buildWave(spec) {
            const size = spec.size;
            const c0 = randInt(0, size - 1);
            const r1 = randInt(1, size - 1);
            const pathCoords = [
                { axis: 'row', railIndex: 0, row: 0, col: c0 },
                { axis: 'col', railIndex: c0, row: r1, col: c0 }
            ];
            if (spec.steps.length === 3) {
                const cChoices = [];
                for (let c = 0; c < size; c += 1) {
                    if (c !== c0) cChoices.push(c);
                }
                const c1 = pick(cChoices);
                pathCoords.push({ axis: 'row', railIndex: r1, row: r1, col: c1 });
            }

            // Строим шаги; гарантируем, что разные шаги на одной шине не конфликтуют
            const steps = [];
            const usedTargetSigs = new Set();
            for (let i = 0; i < spec.steps.length; i += 1) {
                const stCfg = spec.steps[i];
                const coord = pathCoords[i];
                let stepObj = null;
                for (let tries = 0; tries < 40; tries += 1) {
                    const candidate = stCfg.frac
                        ? makeFracStep(coord.axis, coord.railIndex, coord.row, coord.col, stCfg.srcBase, stCfg.targetBase)
                        : makeIntStep(
                            coord.axis,
                            coord.railIndex,
                            coord.row,
                            coord.col,
                            stCfg.srcBase,
                            stCfg.targetBase,
                            stCfg.kind,
                            stCfg.minVal || 40,
                            stCfg.maxVal || 255
                        );
                    const sig = candidate.answerKey + '@' + candidate.targetBase;
                    if (!usedTargetSigs.has(sig)) {
                        usedTargetSigs.add(sig);
                        stepObj = candidate;
                        break;
                    }
                }
                if (!stepObj) {
                    stepObj = makeIntStep(coord.axis, coord.railIndex, coord.row, coord.col, stCfg.srcBase, stCfg.targetBase, 'direct', 20, 250);
                }
                steps.push(stepObj);
            }

            const grid = Array.from({ length: size }, () => Array(size).fill(null));
            const rowSigs = Array.from({ length: size }, () => new Set());
            const colSigs = Array.from({ length: size }, () => new Set());

            for (let i = 0; i < steps.length; i += 1) {
                const st = steps[i];
                const sig = st.answerKey + '@' + st.targetBase;
                grid[st.row][st.col] = {
                    key: st.answerKey,
                    base: st.targetBase,
                    isFraction: st.isFraction,
                    rawDisplay: st.rawDisplay,
                    locked: false,
                    lockedStep: null
                };
                rowSigs[st.row].add(sig);
                colSigs[st.col].add(sig);
            }

            // Для каждой ячейки (r, c) запрещаем (answerKey, targetBase) всех шагов, чья шина проходит через (r, c)
            function getForbiddenPairsForCell(r, c) {
                const set = new Set();
                for (const st of steps) {
                    if ((st.axis === 'row' && st.railIndex === r) || (st.axis === 'col' && st.railIndex === c)) {
                        set.add(st.answerKey + '@' + st.targetBase);
                    }
                }
                return set;
            }

            // На волнах 4+ внедряем дистрактор «то же число, но неверная система счисления» на активной шине
            let placedWrongBaseTrap = false;
            if (spec.wrongBaseTrap) {
                for (const st of steps) {
                    if (placedWrongBaseTrap) break;
                    for (let k = 0; k < size; k += 1) {
                        const rr = st.axis === 'row' ? st.railIndex : k;
                        const cc = st.axis === 'col' ? st.railIndex : k;
                        if (grid[rr][cc]) continue;
                        const forbidden = getForbiddenPairsForCell(rr, cc);
                        const cellObj = pickDistractorCell(steps, forbidden, rowSigs[rr], colSigs[cc], st);
                        grid[rr][cc] = {
                            ...cellObj,
                            locked: false,
                            lockedStep: null
                        };
                        rowSigs[rr].add(cellObj.key + '@' + cellObj.base);
                        colSigs[cc].add(cellObj.key + '@' + cellObj.base);
                        placedWrongBaseTrap = true;
                        break;
                    }
                }
            }

            for (let r = 0; r < size; r += 1) {
                for (let c = 0; c < size; c += 1) {
                    if (grid[r][c]) continue;
                    const forbidden = getForbiddenPairsForCell(r, c);
                    const cellObj = pickDistractorCell(steps, forbidden, rowSigs[r], colSigs[c], null);
                    grid[r][c] = {
                        ...cellObj,
                        locked: false,
                        lockedStep: null
                    };
                    rowSigs[r].add(cellObj.key + '@' + cellObj.base);
                    colSigs[c].add(cellObj.key + '@' + cellObj.base);
                }
            }

            return {
                wave: spec.wave,
                title: spec.title,
                size,
                maxTime: spec.maxTime,
                isBreather: Boolean(spec.isBreather),
                steps,
                grid
            };
        }

