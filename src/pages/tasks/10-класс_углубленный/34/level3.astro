        let timerInterval = null;
        let resetTimeout = null;
        let pulseTimeout = null;
        let flashTimeout = null;
        let shakeTimeouts = [];

        function cloneMatrixGrid(grid) {
            return grid.map((row) => row.map((cell) => ({ ...cell, locked: false, lockedStep: null })));
        }

        const app = Vue.createApp({
            data() {
                return {
                    gameState: 'intro',
                    activeWaves: generateWaves(),
                    currentWave: 1,
                    currentStepIdx: 0,
                    activeAxis: 'row',
                    activeRailIndex: 0,
                    cursorRow: 0,
                    cursorCol: 0,
                    matrixGrid: [],
                    lockedCoords: [],
                    lockedDisplays: [],
                    bitGroupMode: 'raw',
                    timeLeft: 34.0,
                    failCount: 0,
                    alarmActive: false,
                    alarmMessage: '',
                    isSuccessPulse: false,
                    successMessage: '',
                    isActionBlocked: false,
                    isAfkPaused: false,
                    flashCellKey: '',
                    shakeOffsetPx: 0,
                    sessionStartTime: 0,
                    totalSessionElapsed: 0
                };
            },

            computed: {
                currentWaveData() {
                    return this.activeWaves[this.currentWave - 1] || this.activeWaves[0];
                },
                isCursorOnActiveRail() {
                    return this.isCellInActiveRail(this.cursorRow, this.cursorCol);
                },
                tracePoints() {
                    const n = this.currentWaveData.size || 4;
                    return this.lockedCoords.map((pt) => ({
                        x: ((pt.col + 0.5) / n) * 100,
                        y: ((pt.row + 0.5) / n) * 100
                    }));
                },
                traceSegments() {
                    const pts = this.tracePoints;
                    const segs = [];
                    for (let i = 1; i < pts.length; i += 1) {
                        segs.push({
                            x1: pts[i - 1].x,
                            y1: pts[i - 1].y,
                            x2: pts[i].x,
                            y2: pts[i].y
                        });
                    }
                    return segs;
                }
            },

            mounted() {
                this._boundKeydown = (e) => this.handleKeydown(e);
                window.addEventListener('keydown', this._boundKeydown);
            },

            unmounted() {
                if (this._boundKeydown) {
                    window.removeEventListener('keydown', this._boundKeydown);
                    this._boundKeydown = null;
                }
                this.clearAllTimers();
            },

            methods: {
                clearAllTimers() {
                    if (timerInterval) {
                        clearInterval(timerInterval);
                        timerInterval = null;
                    }
                    if (resetTimeout) {
                        clearTimeout(resetTimeout);
                        resetTimeout = null;
                    }
                    if (pulseTimeout) {
                        clearTimeout(pulseTimeout);
                        pulseTimeout = null;
                    }
                    if (flashTimeout) {
                        clearTimeout(flashTimeout);
                        flashTimeout = null;
                    }
                    shakeTimeouts.forEach((t) => clearTimeout(t));
                    shakeTimeouts = [];
                },

                baseLabel(base) {
                    return BASE_LABELS[base] || String(base);
                },

                isCellInActiveRail(rIdx, cIdx) {
                    return this.activeAxis === 'row'
                        ? rIdx === this.activeRailIndex
                        : cIdx === this.activeRailIndex;
                },

                isCursorAt(rIdx, cIdx) {
                    return this.cursorRow === rIdx && this.cursorCol === cIdx;
                },

                slotLabelForCell(rIdx, cIdx) {
                    if (this.activeAxis === 'row' && rIdx === this.activeRailIndex) {
                        return '[' + (cIdx + 1) + ']';
                    }
                    if (this.activeAxis === 'col' && cIdx === this.activeRailIndex) {
                        return '[' + (rIdx + 1) + ']';
                    }
                    return '·';
                },

                formatDisplaySource(step) {
                    if (step.srcBase === 2) {
                        return groupBinaryString(step.srcDisplay, this.bitGroupMode, step.isFraction);
                    }
                    return step.srcDisplay;
                },

                formatCellDisplay(cell) {
                    if (cell.base === 2) {
                        return groupBinaryString(cell.rawDisplay, this.bitGroupMode, cell.isFraction);
                    }
                    return cell.rawDisplay;
                },

                getCellStyle(rIdx, cIdx, cell) {
                    const inRail = this.isCellInActiveRail(rIdx, cIdx);
                    const isCursor = this.isCursorAt(rIdx, cIdx);
                    const isFlashing = this.flashCellKey === (rIdx + '-' + cIdx);
                    const railBg = this.activeAxis === 'row'
                        ? 'rgba(13, 202, 240, 0.10)'
                        : 'rgba(255, 193, 7, 0.10)';

                    let background = '#06080b';
                    let border = '1px solid #2b3035';
                    let boxShadow = 'none';

                    if (inRail) {
                        background = railBg;
                        border = this.activeAxis === 'row' ? '1px solid #0dcaf0' : '1px solid #ffc107';
                    }
                    if (cell.locked) {
                        background = 'rgba(25, 135, 84, 0.28)';
                        border = '2px solid #20c997';
                    }
                    if (isFlashing) {
                        background = 'rgba(32, 201, 151, 0.48)';
                        boxShadow = '0 0 18px rgba(32, 201, 151, 0.8)';
                    }
                    if (isCursor) {
                        border = inRail ? '2px solid #00f0ff' : '2px solid #ff3b3b';
                        boxShadow = inRail
                            ? '0 0 14px rgba(0, 240, 255, 0.78)'
                            : '0 0 14px rgba(255, 59, 59, 0.78)';
                    }

                    return {
                        minHeight: this.currentWaveData.size >= 6 ? '64px' : '74px',
                        pointerEvents: 'none',
                        background,
                        border,
                        boxShadow,
                        transition: 'background 150ms ease, border-color 150ms ease, box-shadow 150ms ease'
                    };
                },

                triggerScreenShake() {
                    shakeTimeouts.forEach((t) => clearTimeout(t));
                    shakeTimeouts = [];
                    const offsets = [-8, 8, -5, 4, 0];
                    offsets.forEach((px, idx) => {
                        shakeTimeouts.push(setTimeout(() => {
                            this.shakeOffsetPx = px;
                        }, idx * 55));
                    });
                },

                startGame() {
                    this.clearAllTimers();
                    this.gameState = 'playing';
                    this.sessionStartTime = Date.now();
                    this.totalSessionElapsed = 0;
                    this.failCount = 0;
                    this.alarmActive = false;
                    this.alarmMessage = '';
                    this.isSuccessPulse = false;
                    this.isActionBlocked = false;
                    this.isAfkPaused = false;
                    this.bitGroupMode = 'raw';
                    this.activeWaves = generateWaves();

                    telemetry.reset({ allowRecomplete: true });
                    telemetry.start();
                    telemetry.setWave(1, TOTAL_WAVES);
                    telemetry.progress({
                        wave: 1,
                        total_waves: TOTAL_WAVES,
                        stage: 1,
                        total_stages: TOTAL_WAVES
                    });
                    this.loadWave(1);
                },

                restartGame() {
                    this.clearAllTimers();
                    this.alarmActive = false;
                    this.isSuccessPulse = false;
                    this.isActionBlocked = false;
                    this.isAfkPaused = false;
                    this.shakeOffsetPx = 0;
                    telemetry.reset({ allowRecomplete: true });
                    this.gameState = 'intro';
                },

                loadWave(waveNum) {
                    if (timerInterval) {
                        clearInterval(timerInterval);
                        timerInterval = null;
                    }
                    this.currentWave = waveNum;
                    const waveData = this.currentWaveData;
                    this.matrixGrid = cloneMatrixGrid(waveData.grid);
                    this.currentStepIdx = 0;
                    this.activeAxis = 'row';
                    this.activeRailIndex = 0;
                    this.cursorRow = 0;
                    this.cursorCol = 0;
                    this.lockedCoords = [];
                    this.lockedDisplays = [];
                    this.alarmActive = false;
                    this.isActionBlocked = false;
                    this.flashCellKey = '';
                    this.timeLeft = waveData.maxTime;

                    telemetry.setWave(waveNum, TOTAL_WAVES);

                    timerInterval = setInterval(() => {
                        if (this.gameState !== 'playing' || this.isActionBlocked || this.isAfkPaused) return;
                        this.timeLeft = Math.max(0, +(this.timeLeft - 0.1).toFixed(1));
                        if (this.timeLeft <= 0) {
                            this.triggerHardcoreReset(`Время волны ${waveNum} истекло! Сбой синхронизации шины.`, true);
                        }
                    }, 100);
                },

                moveCursor(dRow, dCol) {
                    if (this.gameState !== 'playing' || this.isActionBlocked || this.isAfkPaused || this.alarmActive) return;
                    const n = this.currentWaveData.size;
                    this.cursorRow = (this.cursorRow + dRow + n) % n;
                    this.cursorCol = (this.cursorCol + dCol + n) % n;
                    telemetry.markActivity();
                    playStepSound();
                },

                jumpToRailSlot(slotIdx) {
                    if (this.gameState !== 'playing' || this.isActionBlocked || this.isAfkPaused || this.alarmActive) return;
                    const n = this.currentWaveData.size;
                    if (slotIdx < 0 || slotIdx >= n) return;
                    if (this.activeAxis === 'row') {
                        this.cursorRow = this.activeRailIndex;
                        this.cursorCol = slotIdx;
                    } else {
                        this.cursorRow = slotIdx;
                        this.cursorCol = this.activeRailIndex;
                    }
                    telemetry.markActivity();
                    playStepSound();
                },

                cycleBitGroupMode() {
                    if (this.gameState !== 'playing' || this.isActionBlocked || this.isAfkPaused || this.alarmActive) return;
                    const order = ['raw', 'triad', 'tetrad'];
                    const nextIdx = (order.indexOf(this.bitGroupMode) + 1) % order.length;
                    this.bitGroupMode = order[nextIdx];
                    telemetry.markActivity();
                    playShiftModeSound();
                },

                lockCurrentCell() {
                    if (this.gameState !== 'playing' || this.isActionBlocked || this.isAfkPaused || this.alarmActive) return;
                    telemetry.markActivity();

                    const r = this.cursorRow;
                    const c = this.cursorCol;
                    const cell = this.matrixGrid[r] && this.matrixGrid[r][c];
                    const step = this.currentWaveData.steps[this.currentStepIdx];
                    if (!cell || !step) return;

                    if (!this.isCellInActiveRail(r, c)) {
                        const expectedRail = this.activeAxis === 'row'
                            ? `строке R${this.activeRailIndex + 1}`
                            : `столбце C${this.activeRailIndex + 1}`;
                        this.triggerHardcoreReset(
                            `Ячейка R${r + 1}:C${c + 1} находится вне активной шины (требуется узел в ${expectedRail})!`,
                            false
                        );
                        return;
                    }

                    if (cell.locked) {
                        this.triggerHardcoreReset(`Ячейка R${r + 1}:C${c + 1} уже использована в текущем буфере!`, false);
                        return;
                    }

                    if (cell.key !== step.answerKey) {
                        this.triggerHardcoreReset(
                            `Неверное значение ${cell.rawDisplay} (${this.baseLabel(cell.base)}) вместо ${step.rawDisplay} (${this.baseLabel(step.targetBase)})!`,
                            false
                        );
                        return;
                    }

                    if (cell.base !== step.targetBase) {
                        this.triggerHardcoreReset(
                            `Значение совпадает, но выбрана неверная система счисления: ${this.baseLabel(cell.base)} вместо ${this.baseLabel(step.targetBase)}!`,
                            false
                        );
                        return;
                    }

                    // Успешный захват ячейки шага
                    cell.locked = true;
                    cell.lockedStep = this.currentStepIdx + 1;
                    this.lockedCoords.push({ row: r, col: c });
                    this.lockedDisplays.push(cell.rawDisplay);

                    this.flashCellKey = r + '-' + c;
                    if (flashTimeout) clearTimeout(flashTimeout);
                    flashTimeout = setTimeout(() => {
                        this.flashCellKey = '';
                    }, 220);

                    playLockSound(this.currentStepIdx);

                    if (this.currentStepIdx + 1 < this.currentWaveData.steps.length) {
                        this.currentStepIdx += 1;
                        if (this.activeAxis === 'row') {
                            this.activeAxis = 'col';
                            this.activeRailIndex = c;
                        } else {
                            this.activeAxis = 'row';
                            this.activeRailIndex = r;
                        }
                        return;
                    }

                    // Все шаги волны захвачены
                    if (timerInterval) {
                        clearInterval(timerInterval);
                        timerInterval = null;
                    }
                    this.isActionBlocked = true;

                    if (this.currentWave >= TOTAL_WAVES) {
                        playVictoryFanfare();
                        this.totalSessionElapsed = Math.max(1, Math.round((Date.now() - this.sessionStartTime) / 1000));
                        this.gameState = 'victory';
                        telemetry.complete({
                            wave: TOTAL_WAVES,
                            total_waves: TOTAL_WAVES,
                            stage: TOTAL_WAVES,
                            total_stages: TOTAL_WAVES,
                            time_spent_sec: this.totalSessionElapsed
                        });
                    } else {
                        playWaveClearSound();
                        const nextWave = this.currentWave + 1;
                        this.successMessage = `Волна ${this.currentWave} взломана! Переключение на волну ${nextWave}...`;
                        this.isSuccessPulse = true;
                        telemetry.advanceWave(nextWave);
                        pulseTimeout = setTimeout(() => {
                            this.isSuccessPulse = false;
                            if (this.gameState === 'playing' && !this.isAfkPaused) {
                                this.loadWave(nextWave);
                            }
                        }, 240);
                    }
                },

                triggerHardcoreReset(reason, isTimeout) {
                    if (timerInterval) {
                        clearInterval(timerInterval);
                        timerInterval = null;
                    }
                    this.isActionBlocked = true;
                    this.isSuccessPulse = false;
                    this.failCount += 1;

                    const shouldReset = telemetry.fail({
                        wave: this.currentWave,
                        total_waves: TOTAL_WAVES,
                        stage: this.currentWave,
                        total_stages: TOTAL_WAVES,
                        isTimeout: Boolean(isTimeout)
                    });

                    if (shouldReset === false) {
                        return;
                    }

                    playAlarmSiren();
                    this.triggerScreenShake();
                    this.alarmMessage = reason;
                    this.alarmActive = true;

                    if (resetTimeout) clearTimeout(resetTimeout);
                    resetTimeout = setTimeout(() => {
                        if (this.gameState !== 'playing' || this.isAfkPaused) return;
                        this.alarmActive = false;
                        this.activeWaves = generateWaves();
                        this.loadWave(1);
                    }, 1650);
                },

                handleAfkStop() {
                    if (timerInterval) {
                        clearInterval(timerInterval);
                        timerInterval = null;
                    }
                    this.isAfkPaused = true;
                    this.isActionBlocked = true;
                    this.alarmActive = false;
                },

                handleAfkRetry() {
                    this.isAfkPaused = false;
                    this.isActionBlocked = false;
                    this.alarmActive = false;
                    if (this.gameState === 'playing') {
                        this.activeWaves = generateWaves();
                        this.loadWave(1);
                    }
                },

                handleKeydown(e) {
                    if (e.repeat) return;

                    if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'ArrowDown' || e.code === 'ArrowLeft' || e.code === 'ArrowRight') {
                        e.preventDefault();
                    }

                    const telState = telemetry.getState();
                    if (this.isAfkPaused || telState.isAfkPaused) {
                        if (e.code === 'Space') {
                            telemetry.resumeFromAfk();
                        }
                        return;
                    }

                    if (this.gameState === 'intro') {
                        if (e.code === 'Space') {
                            this.startGame();
                        }
                        return;
                    }

                    if (this.gameState === 'victory') {
                        if (e.code === 'Space') {
                            this.restartGame();
                        }
                        return;
                    }

                    if (this.gameState !== 'playing' || this.alarmActive || this.isActionBlocked) {
                        return;
                    }

                    switch (e.code) {
                        case 'KeyW':
                        case 'ArrowUp':
                            this.moveCursor(-1, 0);
                            return;
                        case 'KeyS':
                        case 'ArrowDown':
                            this.moveCursor(1, 0);
                            return;
                        case 'KeyA':
                        case 'ArrowLeft':
                            this.moveCursor(0, -1);
                            return;
                        case 'KeyD':
                        case 'ArrowRight':
                            this.moveCursor(0, 1);
                            return;
                        case 'ShiftLeft':
                        case 'ShiftRight':
                            this.cycleBitGroupMode();
                            return;
                        case 'Space':
                            this.lockCurrentCell();
                            return;
                        default:
                            break;
                    }

                    const digitMatch = e.code && (e.code.match(/^Digit([1-6])$/) || e.code.match(/^Numpad([1-6])$/));
                    if (digitMatch) {
                        const slotIdx = Number(digitMatch[1]) - 1;
                        if (slotIdx < this.currentWaveData.size) {
                            this.jumpToRailSlot(slotIdx);
                        }
                    }
                },

                formatTime(sec) {
                    const m = Math.floor(sec / 60);
                    const s = sec % 60;
                    return `${m}м ${String(s).padStart(2, '0')}с`;
                }
            }
        });

        appInstance = app.mount('#arcade-app');

        // Отладочный и регрессионный хук E2E (персоны не используют, проходят через Black-Box DOM + клавиши)
        window.__DEV_LEVEL3_STATE__ = {
            get waves() {
                return appInstance ? appInstance.activeWaves : [];
            },
            get currentWaveIndex() {
                return appInstance ? appInstance.currentWave - 1 : 0;
            },
            get currentWave() {
                return appInstance ? appInstance.currentWaveData : null;
            },
            solveCurrentWave() {
                if (!appInstance || appInstance.gameState !== 'playing' || appInstance.isActionBlocked || appInstance.alarmActive) return false;
                const steps = appInstance.currentWaveData.steps;
                while (appInstance.gameState === 'playing' && !appInstance.isActionBlocked && appInstance.currentStepIdx < steps.length) {
                    const step = steps[appInstance.currentStepIdx];
                    appInstance.cursorRow = step.row;
                    appInstance.cursorCol = step.col;
                    appInstance.lockCurrentCell();
                }
                return true;
            },
            submitAction(action, payload) {
                if (!appInstance) return false;
                if (action === 'wrong') {
                    const r = appInstance.activeAxis === 'row' ? appInstance.activeRailIndex : 0;
                    const c = appInstance.activeAxis === 'col' ? appInstance.activeRailIndex : 0;
                    const step = appInstance.currentWaveData.steps[appInstance.currentStepIdx];
                    const n = appInstance.currentWaveData.size;
                    for (let k = 0; k < n; k += 1) {
                        const rr = appInstance.activeAxis === 'row' ? r : k;
                        const cc = appInstance.activeAxis === 'col' ? c : k;
                        if (rr !== step.row || cc !== step.col) {
                            appInstance.cursorRow = rr;
                            appInstance.cursorCol = cc;
                            appInstance.lockCurrentCell();
                            return true;
                        }
                    }
                    return false;
                }
                if (action === 'timeout') {
                    appInstance.triggerHardcoreReset('Тайм-аут волны (тест)', true);
                    return true;
                }
                if (action === 'lock' && payload && typeof payload.row === 'number' && typeof payload.col === 'number') {
                    appInstance.cursorRow = payload.row;
                    appInstance.cursorCol = payload.col;
                    appInstance.lockCurrentCell();
                    return true;
                }
                if (action === 'solve') {
                    return this.solveCurrentWave();
                }
                return false;
            }
        };
    });
    </script>
</TaskLayout>
