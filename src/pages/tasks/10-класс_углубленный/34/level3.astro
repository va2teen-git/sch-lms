---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout
    level={3}
    title="Урок 34 :: Двоичная, восьмеричная и шестнадцатеричная системы счисления, связь между ними (Уровень 3)"
    bodyClass="font-monospace m-0 p-0"
>
    <div id="arcade-app" v-cloak class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Заголовок арены -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h1 class="h4 text-danger mb-0 fw-bold">Арена: Кибер-матрица перекодировки (Protocol Breach 2 ↔ 8 ↔ 16)</h1>
                <div class="text-secondary small">Урок 34 // 10 класс (углубленный, технологический профиль)</div>
            </div>
            <span class="badge border border-danger text-danger bg-dark rounded-0 px-3 py-2">
                Аркада Keyboard-Only // Хардкор-сброс
            </span>
        </div>

        <div
            class="card bg-dark rounded-0 shadow"
            :class="alarmActive ? 'border-danger border-2' : (isSuccessPulse ? 'border-success border-2' : 'border-danger')"
            :style="{ transform: shakeOffsetPx ? 'translateX(' + shakeOffsetPx + 'px)' : 'none', transition: 'transform 60ms linear' }"
        >
            <div class="card-body p-3 p-md-4">

                <!-- ЭКРАН 1: ВВОДНЫЙ БРИФИНГ (Intro) -->
                <div v-if="gameState === 'intro'" class="text-center py-3">
                    <div class="display-6 text-danger fw-bold mb-2">КИБЕР-МАТРИЦА ПЕРЕКОДИРОВКИ</div>
                    <p class="text-light fs-6 mx-auto mb-4" style="max-width: 780px;">
                        Взломайте протокол шины данных <span class="text-info">2 ↔ 8 ↔ 16</span> за 10 волн.
                        На каждом шаге активна строго одна <span class="text-info">строка</span> или один <span class="text-warning">столбец</span>:
                        после захвата ячейки шина поворачивается на 90° через выбранную координату.
                        Совпасть должны <strong>и значение, и целевое основание</strong> (<code>BIN / OCT / HEX</code>)!
                    </p>

                    <div class="row g-3 justify-content-center text-start mx-auto mb-4" style="max-width: 860px;">
                        <div class="col-md-6">
                            <div class="alert alert-dark bg-black border border-danger text-light rounded-0 h-100 p-3 mb-0">
                                <div class="text-danger fw-bold mb-2">⚡ РЕГЛАМЕНТ ХАРДКОР-БОССА</div>
                                <ul class="mb-0 text-secondary small ps-3">
                                    <li><strong class="text-light">10 волн (34.0 с → 16.0 с):</strong> матрицы от <code>4×4</code> до <code>6×6</code>, на 8-й волне — тактическая передышка.</li>
                                    <li><strong class="text-info">Двоичный мост и дробные/маски:</strong> прямые переводы по триадам и тетрадам, <code>8 ↔ 16</code>, дроби с нулями и сдвиги/маски.</li>
                                    <li><strong class="text-danger">Тотальный сброс:</strong> захват неверного значения, неверного основания, ячейки вне активной шины или таймаут включает сирену <code>#alarm-box</code> и <em>сбрасывает прогресс на Волну 1</em>.</li>
                                    <li><strong class="text-warning">Строго без мыши:</strong> во время волны мышь отключена — управление только с клавиатуры.</li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="alert alert-dark bg-black border border-info text-light rounded-0 h-100 p-3 mb-0">
                                <div class="text-info fw-bold mb-2">⌨ КАРТА УПРАВЛЕНИЯ (16 КЛАВИШ, RU/EN)</div>
                                <div class="d-flex flex-column gap-2 small">
                                    <div>
                                        <kbd class="bg-dark border border-secondary text-info rounded-0 px-2 py-1">W</kbd>
                                        <kbd class="bg-dark border border-secondary text-info rounded-0 px-2 py-1">S</kbd>
                                        <kbd class="bg-dark border border-secondary text-info rounded-0 px-2 py-1">A</kbd>
                                        <kbd class="bg-dark border border-secondary text-info rounded-0 px-2 py-1">D</kbd>
                                        /
                                        <kbd class="bg-dark border border-secondary text-info rounded-0 px-2 py-1">↑</kbd>
                                        <kbd class="bg-dark border border-secondary text-info rounded-0 px-2 py-1">↓</kbd>
                                        <kbd class="bg-dark border border-secondary text-info rounded-0 px-2 py-1">←</kbd>
                                        <kbd class="bg-dark border border-secondary text-info rounded-0 px-2 py-1">→</kbd>
                                        <span class="text-secondary ms-1">— движение курсора</span>
                                    </div>
                                    <div>
                                        <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2 py-1">1</kbd>…<kbd class="bg-dark border border-secondary text-warning rounded-0 px-2 py-1">6</kbd>
                                        <span class="text-secondary ms-1">— прыжок курсора к слоту активной строки/столбца</span>
                                    </div>
                                    <div>
                                        <kbd class="bg-dark border border-secondary text-light rounded-0 px-2 py-1">Shift</kbd>
                                        <span class="text-secondary ms-1">— анализатор бит: RAW → 3-бит (триады) → 4-бит (тетрады)</span>
                                    </div>
                                    <div>
                                        <kbd class="bg-danger border border-light text-white rounded-0 px-2 py-1">Space</kbd>
                                        <span class="text-secondary ms-1">— захват ячейки под курсором / старт волны</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button
                        id="start-btn"
                        type="button"
                        @click="startGame"
                        class="btn btn-danger btn-lg rounded-0 px-5 py-3 fw-bold text-white shadow"
                        style="min-height: 54px;"
                    >
                        ▶ НАЧАТЬ ВЗЛОМ ПРОТОКОЛА [ПРОБЕЛ]
                    </button>
                </div>

                <!-- ЭКРАН 2: АКТИВНАЯ АРЕНА (Строгий Keyboard-Only, ноль обработчиков мыши) -->
                <div v-else-if="gameState === 'playing'" style="pointer-events: none; user-select: none;">

                    <!-- Верхняя панель статуса -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 border-bottom border-secondary pb-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span id="phase-counter" class="badge bg-danger text-white rounded-0 fs-6">
                                ВОЛНА <span v-text="currentWave"></span> ИЗ 10
                            </span>
                            <span class="text-light fw-bold fs-6" v-text="currentWaveData.title"></span>
                            <span v-if="currentWaveData.isBreather" class="badge bg-info text-dark rounded-0">ПЕРЕДЫШКА</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="text-secondary small">
                                Сбои: <span class="text-warning fw-bold" v-text="failCount"></span>
                            </div>
                            <div class="text-secondary small">
                                Таймер: <span class="fw-bold fs-5" :class="timeLeft <= 5.0 ? 'text-danger' : 'text-warning'" v-text="timeLeft.toFixed(1) + 's'"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Полоса таймера волны -->
                    <div class="progress rounded-0 bg-black border border-secondary mb-3" style="height: 10px;">
                        <div
                            class="progress-bar"
                            :class="timeLeft <= 5.0 ? 'bg-danger' : 'bg-warning'"
                            role="progressbar"
                            :style="{ width: Math.max(0, Math.min(100, (timeLeft / currentWaveData.maxTime) * 100)) + '%', transition: 'width 100ms linear' }"
                        ></div>
                    </div>

                    <!-- Аварийный баннер тревоги (#alarm-box + #alarm-count) -->
                    <div id="alarm-box" v-if="alarmActive" class="alert alert-danger bg-black border border-danger text-danger rounded-0 mb-3 py-2 px-3">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div>
                                <div class="fw-bold fs-6">
                                    🚨 ПРОТОКОЛ НАРУШЕН // СБОЙ #<span id="alarm-count" v-text="failCount"></span> — СБРОС НА ВОЛНУ 1
                                </div>
                                <div class="small mt-1 text-light" v-text="alarmMessage"></div>
                            </div>
                            <div class="spinner-border spinner-border-sm text-danger flex-shrink-0" role="status"></div>
                        </div>
                    </div>

                    <!-- Реактивный баннер подтверждения волны -->
                    <div v-if="isSuccessPulse" class="alert alert-success bg-black border border-success text-success rounded-0 mb-3 py-2 px-3 fw-bold">
                        ✓ <span v-text="successMessage"></span>
                    </div>

                    <!-- Панель целевого конвейера протокола (Data Source) + Индикатор группировки бит -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <div class="text-secondary small text-uppercase fw-bold">
                            БУФЕР ПЕРЕХВАТА ПРОТОКОЛА (ВЫПОЛНИТЬ ПОСЛЕДОВАТЕЛЬНО):
                        </div>
                        <div class="badge bg-black border border-info text-info rounded-0 px-2 py-1">
                            АНАЛИЗАТОР [SHIFT]:
                            <span v-if="bitGroupMode === 'raw'" class="text-light">RAW (СПЛОШНОЙ)</span>
                            <span v-else-if="bitGroupMode === 'triad'" class="text-warning">3-БИТ (ТРИАДЫ / OCT)</span>
                            <span v-else class="text-info">4-БИТ (ТЕТРАДЫ / HEX)</span>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div
                            v-for="(step, idx) in currentWaveData.steps"
                            :key="idx"
                            class="col-12"
                            :class="currentWaveData.steps.length === 2 ? 'col-md-6' : 'col-md-4'"
                        >
                            <div
                                class="p-2 px-3 border rounded-0 h-100 d-flex flex-column justify-content-between"
                                :data-target-step="idx"
                                :data-active-step="idx === currentStepIdx ? 'true' : 'false'"
                                :data-src-kind="step.srcKind"
                                :data-target-base="step.targetBase"
                                :class="idx < currentStepIdx ? 'bg-black border-success text-success' : (idx === currentStepIdx ? 'bg-black border-info text-light' : 'bg-black border-secondary text-secondary')"
                                :style="idx === currentStepIdx ? 'box-shadow: 0 0 12px rgba(13, 202, 240, 0.35);' : ''"
                            >
                                <div class="d-flex justify-content-between align-items-center gap-2 mb-1 small">
                                    <span class="fw-bold">
                                        ШАГ <span v-text="idx + 1"></span> //
                                        <span v-if="idx === currentStepIdx">
                                            <span v-if="activeAxis === 'row'" class="text-info" v-text="'СТРОКА R' + (activeRailIndex + 1)"></span>
                                            <span v-else class="text-warning" v-text="'СТОЛБЕЦ C' + (activeRailIndex + 1)"></span>
                                        </span>
                                        <span v-else-if="idx < currentStepIdx" class="text-success">ЗАХВАЧЕНО</span>
                                        <span v-else v-text="step.axis === 'row' ? 'СТРОКА (ПОСЛЕ ПОВОРОТА)' : 'СТОЛБЕЦ (ПОСЛЕ ПОВОРОТА)'"></span>
                                    </span>
                                    <span
                                        class="badge rounded-0"
                                        :class="step.targetBase === 16 ? 'bg-warning text-dark' : (step.targetBase === 8 ? 'bg-info text-dark' : 'bg-success text-white')"
                                        v-text="'→ [' + baseLabel(step.targetBase) + ' / ' + step.targetBase + ']'"
                                    ></span>
                                </div>

                                <div class="fs-5 fw-bold text-break">
                                    <span v-if="step.srcKind === 'direct'">
                                        <span v-text="formatDisplaySource(step)"></span><sub v-text="step.srcBase"></sub>
                                    </span>
                                    <span v-else-if="step.srcKind === 'shift'">
                                        (<span v-text="formatDisplaySource(step)"></span><sub v-text="step.srcBase"></sub>)
                                        <span class="text-warning ms-1" v-text="step.opLabel"></span>
                                    </span>
                                    <span v-else>
                                        <span v-text="formatDisplaySource(step)"></span><sub v-text="step.srcBase"></sub>
                                        <span class="text-warning mx-1" v-text="step.opSymbol"></span>
                                        <span v-text="step.maskDisplay"></span><sub v-text="step.maskBase"></sub>
                                    </span>
                                    <span class="text-secondary ms-1">→ ?<sub v-text="step.targetBase"></sub></span>
                                </div>

                                <div class="small mt-1">
                                    <span v-if="idx < currentStepIdx" class="text-success fw-bold">
                                        ✓ <span v-text="lockedDisplays[idx]"></span><sub v-text="step.targetBase"></sub>
                                    </span>
                                    <span v-else-if="idx === currentStepIdx" class="text-info">
                                        ▶ ВЫБЕРИТЕ ЯЧЕЙКУ НА ШИНЕ И НАЖМИТЕ [SPACE]
                                    </span>
                                    <span v-else class="text-secondary">ОЖИДАНИЕ ПРЕДЫДУЩЕГО УЗЛА</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Пространственная матрица (#matrix-board) + Реактивный SVG-трассер сигнала -->
                    <div id="matrix-board" class="bg-black border border-secondary p-2 p-md-3 mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <div style="width: 42px;" class="text-center small text-secondary fw-bold">BUS</div>
                            <div
                                class="flex-grow-1 gap-2"
                                :style="{ display: 'grid', gridTemplateColumns: 'repeat(' + currentWaveData.size + ', minmax(0, 1fr))' }"
                            >
                                <div
                                    v-for="cIdx in currentWaveData.size"
                                    :key="'ch-' + cIdx"
                                    class="text-center small fw-bold py-1 border"
                                    :class="(activeAxis === 'col' && activeRailIndex === (cIdx - 1)) ? 'border-warning text-warning bg-dark' : 'border-secondary text-secondary'"
                                    v-text="'C' + cIdx"
                                ></div>
                            </div>
                        </div>

                        <div class="d-flex align-items-stretch">
                            <!-- Метки строк R1..RN -->
                            <div
                                style="width: 42px;"
                                class="d-flex flex-column justify-content-between gap-2 pe-2"
                            >
                                <div
                                    v-for="rIdx in currentWaveData.size"
                                    :key="'rh-' + rIdx"
                                    class="flex-grow-1 d-flex align-items-center justify-content-center small fw-bold border"
                                    :class="(activeAxis === 'row' && activeRailIndex === (rIdx - 1)) ? 'border-info text-info bg-dark' : 'border-secondary text-secondary'"
                                    v-text="'R' + rIdx"
                                ></div>
                            </div>

                            <!-- Сетка ячеек + SVG-трассер захваченного пути -->
                            <div class="flex-grow-1 position-relative">
                                <svg
                                    class="position-absolute top-0 start-0 w-100 h-100"
                                    viewBox="0 0 100 100"
                                    preserveAspectRatio="none"
                                    style="pointer-events: none; z-index: 2;"
                                >
                                    <line
                                        v-for="(seg, sIdx) in traceSegments"
                                        :key="'seg-' + sIdx"
                                        :x1="seg.x1"
                                        :y1="seg.y1"
                                        :x2="seg.x2"
                                        :y2="seg.y2"
                                        stroke="#20c997"
                                        stroke-width="1.2"
                                        stroke-dasharray="2,1"
                                    ></line>
                                    <circle
                                        v-for="(pt, pIdx) in tracePoints"
                                        :key="'pt-' + pIdx"
                                        :cx="pt.x"
                                        :cy="pt.y"
                                        r="1.6"
                                        fill="#20c997"
                                    ></circle>
                                </svg>

                                <div
                                    class="gap-2 position-relative"
                                    style="z-index: 1;"
                                    :style="{ display: 'grid', gridTemplateColumns: 'repeat(' + currentWaveData.size + ', minmax(0, 1fr))' }"
                                >
                                    <template v-for="(rowArr, rIdx) in matrixGrid" :key="'row-' + rIdx">
                                        <div
                                            v-for="(cell, cIdx) in rowArr"
                                            :key="'cell-' + rIdx + '-' + cIdx"
                                            class="p-2 rounded-0 d-flex flex-column justify-content-between"
                                            :data-cell-row="rIdx"
                                            :data-cell-col="cIdx"
                                            :data-in-rail="isCellInActiveRail(rIdx, cIdx) ? 'true' : 'false'"
                                            :data-cursor="isCursorAt(rIdx, cIdx) ? 'true' : 'false'"
                                            :data-locked="cell.locked ? 'true' : 'false'"
                                            :data-cell-base="cell.base"
                                            :data-cell-text="cell.rawDisplay"
                                            :style="getCellStyle(rIdx, cIdx, cell)"
                                        >
                                            <div class="d-flex justify-content-between align-items-center gap-1" style="font-size: 0.7rem;">
                                                <span
                                                    v-if="cell.locked"
                                                    class="badge bg-success text-white rounded-0"
                                                    v-text="'#' + cell.lockedStep"
                                                ></span>
                                                <span
                                                    v-else-if="isCursorAt(rIdx, cIdx)"
                                                    class="fw-bold"
                                                    :class="isCellInActiveRail(rIdx, cIdx) ? 'text-info' : 'text-danger'"
                                                    v-text="'▶ ' + slotLabelForCell(rIdx, cIdx)"
                                                ></span>
                                                <span
                                                    v-else
                                                    class="text-secondary"
                                                    v-text="slotLabelForCell(rIdx, cIdx)"
                                                ></span>

                                                <span
                                                    class="badge rounded-0"
                                                    :class="cell.base === 16 ? 'border border-warning text-warning' : (cell.base === 8 ? 'border border-info text-info' : 'border border-success text-success')"
                                                    v-text="baseLabel(cell.base)"
                                                ></span>
                                            </div>

                                            <div class="text-center fw-bold my-1 text-break" :class="currentWaveData.size >= 6 ? 'small' : 'fs-6'">
                                                <span class="text-light" v-text="formatCellDisplay(cell)"></span><sub class="text-secondary" v-text="cell.base"></sub>
                                            </div>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Компактный Keycap HUD + Координаты курсора -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 bg-black border border-secondary px-3 py-2 small">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="badge bg-dark border border-info text-info rounded-0">
                                КУРСОР: <span v-text="'R' + (cursorRow + 1) + ' : C' + (cursorCol + 1)"></span>
                            </span>
                            <span
                                class="badge rounded-0"
                                :class="isCursorOnActiveRail ? 'bg-success text-white' : 'bg-danger text-white'"
                                v-text="isCursorOnActiveRail ? 'НА АКТИВНОЙ ШИНЕ' : 'ВНЕ ШИНЫ (ОПАСНОСТЬ СБРОСА)'"
                            ></span>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2 text-secondary">
                            <span><code>[W/S/A/D]</code> / <code>[↑/↓/←/→]</code> — курсор</span>
                            <span><code>[1..<span v-text="currentWaveData.size"></span>]</code> — слот шины</span>
                            <span><code>[Shift]</code> — 3/4 бита</span>
                            <span><code>[Space]</code> — захват</span>
                        </div>
                    </div>
                </div>

                <!-- ЭКРАН 3: ПОБЕДА (Victory Screen) -->
                <div v-else-if="gameState === 'victory'" class="text-center py-4">
                    <div class="display-5 text-success fw-bold mb-2">ПРОТОКОЛ 2 ↔ 8 ↔ 16 ВЗЛОМАН!</div>
                    <p class="text-light fs-6 mx-auto mb-4" style="max-width: 680px;">
                        Все 10 волн кибер-матрицы успешно пройдены в хардкор-режиме без единой незакрытой ошибки.
                    </p>

                    <div class="row g-3 justify-content-center mx-auto mb-4" style="max-width: 620px;">
                        <div class="col-4">
                            <div class="p-3 bg-black border border-success rounded-0">
                                <div class="text-secondary small">ВОЛНЫ</div>
                                <div class="fs-4 fw-bold text-success">10 / 10</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-black border border-info rounded-0">
                                <div class="text-secondary small">ВРЕМЯ</div>
                                <div class="fs-4 fw-bold text-info" v-text="formatTime(totalSessionElapsed)"></div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-black border border-warning rounded-0">
                                <div class="text-secondary small">СБОЕВ</div>
                                <div class="fs-4 fw-bold text-warning" v-text="failCount"></div>
                            </div>
                        </div>
                    </div>

                    <button
                        id="restart-btn"
                        type="button"
                        @click="restartGame"
                        class="btn btn-outline-success btn-lg rounded-0 px-5 py-3 fw-bold"
                        style="min-height: 54px;"
                    >
                        ↺ ПРОЙТИ ЗАНОВО [ПРОБЕЛ]
                    </button>
                </div>

            </div>
        </div>
    </div>

    <script is:inline src="/static/vue.global.js"></script>
    <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const TOTAL_WAVES = 10;
        const MISSION_NAME = 'Урок 34 :: Двоичная, восьмеричная и шестнадцатеричная системы счисления, связь между ними (Уровень 3)';
        const BASE_LABELS = { 2: 'BIN', 8: 'OCT', 16: 'HEX' };
        const MASKS_POOL = [
            { val: 0xF0, hex: 'F0' },
            { val: 0x0F, hex: '0F' },
            { val: 0x3C, hex: '3C' },
            { val: 0xC3, hex: 'C3' },
            { val: 0xAA, hex: 'AA' },
            { val: 0x55, hex: '55' }
        ];

        // --- Web Audio API (без внешних аудиофайлов) ---
        let audioCtx = null;
        function getAudioContext() {
            if (!audioCtx) {
                const AudioCls = window.AudioContext || window.webkitAudioContext;
                if (AudioCls) audioCtx = new AudioCls();
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume().catch(() => {});
            }
            return audioCtx;
        }

        function playTone(freq, type, duration, vol = 0.1) {
            try {
                const ctx = getAudioContext();
                if (!ctx) return;
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, ctx.currentTime);
                gain.gain.setValueAtTime(vol, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + duration);
            } catch (e) {}
        }

