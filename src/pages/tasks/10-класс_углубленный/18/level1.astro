---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
const missionName = 'Урок 18 :: Виды деятельности в сети Интернет :: Уровень 1';
---

<TaskLayout title="Уровень 1 — Классификация сервисов" level={1} bodyClass="font-monospace">
    <div class="container-fluid px-2 px-md-3 my-3">
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-success pb-2 flex-wrap gap-2">
            <h2 class="h5 m-0 text-success fw-bold text-uppercase" id="phaseTitle">Этап 1 из 3: Классификация сервисов</h2>
            <span class="badge bg-black border border-secondary text-light rounded-0 fs-6 px-3 py-2">
                Ошибки: <span id="errorsCount">0</span>
            </span>
        </div>

        <div class="progress rounded-0 bg-black border border-success mb-3" style="height: 12px;">
            <div class="progress-bar bg-success" id="progressBar" role="progressbar" style="width: 0%;"></div>
        </div>

        <div id="statusBanner" class="alert rounded-0 border-0 fw-bold d-none mb-3"></div>

        <div class="card bg-dark border-success rounded-0" id="mainCard">
            <div class="card-body p-3 p-md-4">
                <p id="phaseDesc" class="text-light mb-3">
                    Выберите карточку веб-сервиса ниже, затем кликните по подходящей категории (корзине). После заполнения нажмите «Проверить классификацию».
                </p>

                <div class="row g-2 mb-3" id="bucketsRow">
                    <div class="col-12 col-sm-4">
                        <div class="bucket border border-secondary bg-black p-2 p-sm-3 h-100" data-category="gov" style="min-height: 140px; cursor: pointer;">
                            <div class="text-success small fw-bold text-uppercase border-bottom border-secondary pb-1 mb-2" style="pointer-events: none;">
                                Госуслуги (E-Gov)
                            </div>
                            <div class="slot-content d-flex flex-column gap-2"></div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="bucket border border-secondary bg-black p-2 p-sm-3 h-100" data-category="com" style="min-height: 140px; cursor: pointer;">
                            <div class="text-success small fw-bold text-uppercase border-bottom border-secondary pb-1 mb-2" style="pointer-events: none;">
                                Коммерция (E-Com)
                            </div>
                            <div class="slot-content d-flex flex-column gap-2"></div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="bucket border border-secondary bg-black p-2 p-sm-3 h-100" data-category="edu" style="min-height: 140px; cursor: pointer;">
                            <div class="text-success small fw-bold text-uppercase border-bottom border-secondary pb-1 mb-2" style="pointer-events: none;">
                                Образование
                            </div>
                            <div class="slot-content d-flex flex-column gap-2"></div>
                        </div>
                    </div>
                </div>

                <div class="text-success small fw-bold text-uppercase border-bottom border-secondary pb-1 mb-2">
                    НЕРАСПРЕДЕЛЁННЫЕ СЕРВИСЫ (Выберите карточку)
                </div>
                <div id="itemsContainer" class="d-flex flex-wrap gap-2 bg-black border border-secondary p-3" style="min-height: 76px;"></div>

                <div class="mt-4">
                    <button type="button" id="checkBtn" class="btn btn-success text-dark rounded-0 fw-bold px-4 py-2 w-100 text-uppercase" style="min-height: 48px;" disabled>
                        Проверить классификацию
                    </button>
                </div>
            </div>
        </div>

        <div id="victoryBox" class="alert alert-success bg-success text-dark rounded-0 border-0 text-center py-5 mt-3 d-none">
            <h3 class="fw-bold text-uppercase mb-2">УРОВЕНЬ ПРОЙДЕН</h3>
            <p class="fs-5 mb-0 fw-semibold">Все интернет-сервисы и государственные ресурсы классифицированы верно.</p>
        </div>
    </div>

    <script is:inline define:vars={{ missionName }}>
        (function () {
            const TOTAL_PHASES = 3;
            const telemetry = window.LMSTelemetry.create({
                missionName: missionName,
                level: 1,
                totalStages: TOTAL_PHASES
            });

            const database = [
                { name: 'Оформление загранпаспорта', cat: 'gov' },
                { name: 'Запись к врачу по ОМС (ЕМИАС)', cat: 'gov' },
                { name: 'Оплата налогов (nalog.gov.ru)', cat: 'gov' },
                { name: 'Выписка из ЕГРН (Росреестр)', cat: 'gov' },
                { name: 'Справка СФР о маткапитале', cat: 'gov' },
                { name: 'Wildberries', cat: 'com' },
                { name: 'Ozon', cat: 'com' },
                { name: 'Авито', cat: 'com' },
                { name: 'Онлайн-перевод в Сбербанке', cat: 'com' },
                { name: 'Покупка ж/д билета (РЖД)', cat: 'com' },
                { name: 'Stepik', cat: 'edu' },
                { name: 'Яндекс.Учебник', cat: 'edu' },
                { name: 'Фоксфорд', cat: 'edu' },
                { name: 'Учи.ру', cat: 'edu' },
                { name: 'Электронный дневник', cat: 'edu' }
            ];

            function shuffle(array) {
                const copy = [...array];
                for (let i = copy.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [copy[i], copy[j]] = [copy[j], copy[i]];
                }
                return copy;
            }

            let currentPhase = 1;
            let errorsCount = 0;
            let selectedItemEl = null;
            let locked = false;
            const actionLog = [];

            const bucketsRowEl = document.getElementById('bucketsRow');
            const itemsContainerEl = document.getElementById('itemsContainer');
            const checkBtn = document.getElementById('checkBtn');
            const phaseTitleEl = document.getElementById('phaseTitle');
            const progressBarEl = document.getElementById('progressBar');
            const errorsCountEl = document.getElementById('errorsCount');
            const statusBannerEl = document.getElementById('statusBanner');
            const mainCardEl = document.getElementById('mainCard');
            const victoryBoxEl = document.getElementById('victoryBox');

            function showBanner(msg, isError) {
                statusBannerEl.textContent = msg;
                statusBannerEl.className = isError
                    ? 'alert alert-danger bg-danger text-white rounded-0 border-0 fw-bold mb-3'
                    : 'alert alert-success bg-success text-dark rounded-0 border-0 fw-bold mb-3';
                statusBannerEl.classList.remove('d-none');
            }

            function hideBanner() {
                statusBannerEl.classList.add('d-none');
                statusBannerEl.textContent = '';
            }

            function updateCheckBtn() {
                const remaining = itemsContainerEl.querySelectorAll('.item-card').length;
                const placed = bucketsRowEl.querySelectorAll('.item-card').length;
                checkBtn.disabled = locked || remaining > 0 || placed === 0;
            }

            function initPhase() {
                locked = false;
                selectedItemEl = null;
                hideBanner();

                phaseTitleEl.textContent = `Этап ${currentPhase} из ${TOTAL_PHASES}: Классификация сервисов`;
                progressBarEl.style.width = `${((currentPhase - 1) / TOTAL_PHASES) * 100}%`;

                itemsContainerEl.innerHTML = '';
                bucketsRowEl.querySelectorAll('.bucket').forEach(b => {
                    b.classList.remove('border-success', 'border-danger');
                    b.classList.add('border-secondary');
                    b.querySelector('.slot-content').innerHTML = '';
                });

                const count = 3 + currentPhase; // 4, 5, 6 items across phases 1..3
                const picked = shuffle(database).slice(0, count);

                picked.forEach((item, idx) => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'item-card btn btn-outline-success rounded-0 text-start px-3 py-2 text-light fw-bold';
                    btn.style.minHeight = '48px';
                    btn.id = `srv_${currentPhase}_${idx}`;
                    btn.dataset.cat = item.cat;
                    btn.textContent = item.name;
                    itemsContainerEl.appendChild(btn);
                });

                updateCheckBtn();
                actionLog.push({ time: new Date().toISOString(), action: `phase_${currentPhase}_started` });
            }

            function selectItem(itemEl) {
                if (itemEl.parentElement && itemEl.parentElement.classList.contains('slot-content')) {
                    const bucket = itemEl.closest('.bucket');
                    itemsContainerEl.appendChild(itemEl);
                    itemEl.classList.remove('active', 'bg-success', 'text-dark');
                    itemEl.classList.add('text-light');
                    if (bucket && bucket.querySelectorAll('.item-card').length === 0) {
                        bucket.classList.remove('border-success');
                        bucket.classList.add('border-secondary');
                    }
                    selectedItemEl = null;
                    updateCheckBtn();
                    return;
                }

                itemsContainerEl.querySelectorAll('.item-card').forEach(el => {
                    el.classList.remove('active', 'bg-success', 'text-dark');
                    el.classList.add('text-light');
                });
                itemEl.classList.remove('text-light');
                itemEl.classList.add('active', 'bg-success', 'text-dark');
                selectedItemEl = itemEl;
            }

            // Single-bound delegated click listeners
            itemsContainerEl.addEventListener('click', (e) => {
                if (locked) return;
                const itemEl = e.target.closest('.item-card');
                if (itemEl) selectItem(itemEl);
            });

            bucketsRowEl.addEventListener('click', (e) => {
                if (locked) return;
                const clickedItem = e.target.closest('.item-card');
                if (clickedItem && !selectedItemEl) {
                    selectItem(clickedItem);
                    return;
                }

                const bucket = e.target.closest('.bucket');
                if (!bucket || !selectedItemEl) return;

                selectedItemEl.classList.remove('active', 'bg-success', 'text-dark');
                selectedItemEl.classList.add('text-light');
                bucket.querySelector('.slot-content').appendChild(selectedItemEl);
                bucket.classList.remove('border-secondary', 'border-danger');
                bucket.classList.add('border-success');
                selectedItemEl = null;
                updateCheckBtn();
            });

            checkBtn.addEventListener('click', () => {
                if (locked) return;
                let allCorrect = true;
                const buckets = bucketsRowEl.querySelectorAll('.bucket');

                buckets.forEach(bucket => {
                    const targetCat = bucket.dataset.category;
                    bucket.querySelectorAll('.item-card').forEach(item => {
                        if (item.dataset.cat !== targetCat) {
                            allCorrect = false;
                            bucket.classList.remove('border-success');
                            bucket.classList.add('border-danger');
                            item.classList.remove('btn-outline-success', 'text-light');
                            item.classList.add('btn-danger', 'text-white');
                        }
                    });
                });

                if (allCorrect) {
                    actionLog.push({ time: new Date().toISOString(), action: `phase_${currentPhase}_passed` });
                    if (currentPhase < TOTAL_PHASES) {
                        currentPhase += 1;
                        telemetry.advanceStage(currentPhase, { action_log: actionLog });
                        showBanner('Верно! Загружаем следующий набор сервисов...', false);
                        locked = true;
                        setTimeout(() => initPhase(), 600);
                    } else {
                        locked = true;
                        progressBarEl.style.width = '100%';
                        phaseTitleEl.textContent = 'КЛАССИФИКАЦИЯ ЗАВЕРШЕНА';
                        mainCardEl.classList.add('d-none');
                        victoryBoxEl.classList.remove('d-none');
                        hideBanner();
                        telemetry.complete({ stage: TOTAL_PHASES, action_log: actionLog });
                    }
                } else {
                    locked = true;
                    errorsCount += 1;
                    errorsCountEl.textContent = String(errorsCount);
                    actionLog.push({ time: new Date().toISOString(), action: `phase_${currentPhase}_failed` });
                    telemetry.hardcoreReset({ stage: currentPhase, action_log: actionLog });
                    showBanner('Ошибка классификации! Формируем новый набор карточек...', true);
                    setTimeout(() => initPhase(), 1000);
                }
                updateCheckBtn();
            });

            initPhase();
        })();
    </script>
</TaskLayout>
