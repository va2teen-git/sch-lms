---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={1}>
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Шапка тренажера -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 text-success mb-0">Тренажер: Двоичные коды и условие Фано (Уровень 1)</h2>
            <span class="badge border border-success text-success bg-dark rounded-0 px-3 py-2">Манипуляция мышью // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-success rounded-0">
            <div class="card-body p-3 p-md-4">

                <!-- Заголовок и индикатор прогресса -->
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="phase-badge" class="badge bg-success text-dark rounded-0 fs-6 me-2">Шаг 1 из 3</span>
                        <span id="phase-title" class="text-light fw-bold fs-6">Классификация кодовых систем по условию Фано</span>
                    </div>
                    <div class="text-secondary small">
                        Попытки: <span id="attempts-display" class="text-warning">0</span> | Время: <span id="timer-display" class="text-info">00:00</span>
                    </div>
                </div>

                <!-- Системный баннер ошибки / сброса -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between">
                        <span>[СИСТЕМНЫЙ СБОЙ] <span id="feedback-text">Неверная конфигурация!</span> Перегенерация варианта...</span>
                        <span class="spinner-border spinner-border-sm text-danger" role="status"></span>
                    </div>
                </div>

                <!-- ==================== ФАЗА 1: КЛАССИФИКАЦИЯ КОДОВЫХ СИСТЕМ (DRAG-TO-BUCKET) ==================== -->
                <div id="phase1" class="phase-container">
                    <p class="text-light mb-3">
                        В коммутационный буфер поступил набор кодовых словарей.
                        Используя мышь, <strong>перетащите каждую карточку</strong> (или кликните по ней, затем по корзине) в соответствующий класс по свойствам длин и условий Фано.
                    </p>

                    <!-- Палитра карточек -->
                    <div class="card bg-black border-secondary rounded-0 mb-4 p-3">
                        <div class="text-secondary small text-uppercase mb-2">Кодовые словари для классификации (кликните или перетащите):</div>
                        <div id="p1-card-pool" class="d-flex flex-wrap gap-2 min-vh-10 align-items-center">
                            <!-- Карточки генерируются процедурно -->
                        </div>
                    </div>

                    <!-- Контейнеры-корзины -->
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-success rounded-0 h-100 p-2 p-md-3 bucket-zone" data-bucket="uniform">
                                <div class="d-flex justify-content-between align-items-center border-bottom border-success pb-1 mb-2 bucket-header cursor-pointer">
                                    <span class="text-success fw-bold small text-uppercase">1. Равномерный код</span>
                                    <span class="badge bg-success text-dark rounded-0 bucket-count">0</span>
                                </div>
                                <div class="text-secondary small mb-2" style="font-size: 0.75rem;">Все слова имеют фиксированную длину L (ASCII, байтовая сетка)</div>
                                <div class="bucket-content d-flex flex-column gap-2 flex-grow-1 min-h-[80px]"></div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-info rounded-0 h-100 p-2 p-md-3 bucket-zone" data-bucket="prefix">
                                <div class="d-flex justify-content-between align-items-center border-bottom border-info pb-1 mb-2 bucket-header cursor-pointer">
                                    <span class="text-info fw-bold small text-uppercase">2. Префиксный код</span>
                                    <span class="badge bg-info text-dark rounded-0 bucket-count">0</span>
                                </div>
                                <div class="text-secondary small mb-2" style="font-size: 0.75rem;">Прямое условие Фано: ни одно слово не начало другого (декодирование слева направо)</div>
                                <div class="bucket-content d-flex flex-column gap-2 flex-grow-1 min-h-[80px]"></div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-warning rounded-0 h-100 p-2 p-md-3 bucket-zone" data-bucket="postfix">
                                <div class="d-flex justify-content-between align-items-center border-bottom border-warning pb-1 mb-2 bucket-header cursor-pointer">
                                    <span class="text-warning fw-bold small text-uppercase">3. Постфиксный код</span>
                                    <span class="badge bg-warning text-dark rounded-0 bucket-count">0</span>
                                </div>
                                <div class="text-secondary small mb-2" style="font-size: 0.75rem;">Обратное условие Фано: ни одно слово не конец другого (декодирование справа налево)</div>
                                <div class="bucket-content d-flex flex-column gap-2 flex-grow-1 min-h-[80px]"></div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="card bg-black border-danger rounded-0 h-100 p-2 p-md-3 bucket-zone" data-bucket="ambiguous">
                                <div class="d-flex justify-content-between align-items-center border-bottom border-danger pb-1 mb-2 bucket-header cursor-pointer">
                                    <span class="text-danger fw-bold small text-uppercase">4. Недекодируемый / Коллизия</span>
                                    <span class="badge bg-danger text-dark rounded-0 bucket-count">0</span>
                                </div>
                                <div class="text-secondary small mb-2" style="font-size: 0.75rem;">Нарушено прямое и обратное условие (слова являются и префиксом, и суффиксом)</div>
                                <div class="bucket-content d-flex flex-column gap-2 flex-grow-1 min-h-[80px]"></div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="btn-check-p1" class="btn btn-success rounded-0 px-4 py-2 text-uppercase fw-bold" disabled>
                            Проверить классификацию
                        </button>
                    </div>
                </div>

                <!-- ==================== ФАЗА 2: КОНСТРУИРОВАНИЕ ДЕРЕВА ПРЕФИКСНОГО КОДА (SLOT & SNAP) ==================== -->
                <div id="phase2" class="phase-container d-none">
                    <p class="text-light mb-3">
                        Сформируйте префиксный код, удовлетворяющий прямому условию Фано.
                        <strong>Перетащите символы алфавита</strong> в целевые листья бинарного дерева.
                        <span class="text-warning">Внимание: размещение символа во внутреннем узле заблокирует его ветви и приведет к коллизии префиксов!</span>
                    </p>

                    <div class="row g-3 mb-4">
                        <!-- Палитра букв-токенов с дистракторами -->
                        <div class="col-12 col-lg-4">
                            <div class="card bg-black border-secondary rounded-0 p-3 h-100">
                                <div class="text-secondary small text-uppercase mb-2">Символы алфавита источника:</div>
                                <div id="p2-token-palette" class="d-flex flex-column gap-2 mb-3">
                                    <!-- Токены генерируются процедурно -->
                                </div>
                                <div class="text-secondary small mt-auto border-top border-secondary pt-2">
                                    💡 Подсказка: дерево читается от корня (0 — влево, 1 — вправо).
                                </div>
                            </div>
                        </div>

                        <!-- Интерактивное бинарное дерево -->
                        <div class="col-12 col-lg-8">
                            <div class="card bg-black border-success rounded-0 p-3">
                                <div class="text-success small text-uppercase mb-2">Бинарное кодовое дерево:</div>
                                <div id="p2-tree-canvas" class="d-flex flex-column align-items-center py-2" style="min-height: 280px; position: relative;">
                                    <!-- Сетка дерева формируется динамически -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <button id="btn-reset-p2" class="btn btn-outline-secondary rounded-0 px-3">Сбросить дерево</button>
                        <button id="btn-check-p2" class="btn btn-success rounded-0 px-4 py-2 text-uppercase fw-bold" disabled>
                            Синтезировать код
                        </button>
                    </div>
                </div>

                <!-- ==================== ФАЗА 3: ПРЯМАЯ НАРЕЗКА БИТОВОГО ПОТОКА (STREAM CARVER) ==================== -->
                <div id="phase3" class="phase-container d-none">
                    <p class="text-light mb-3">
                        По каналу связи без пауз передан сплошной битовый поток, закодированный неравномерным префиксным кодом.
                        <strong>Кликайте по маркерам-ножницам между битами</strong>, чтобы разрезать поток на кодовые слова и декодировать исходное слово.
                    </p>

                    <!-- Таблица префиксного кода -->
                    <div class="card bg-black border-info rounded-0 p-3 mb-3">
                        <div class="text-info small text-uppercase mb-2">Таблица префиксного кода (алфавит источника):</div>
                        <div id="p3-code-table" class="d-flex flex-wrap gap-3">
                            <!-- Таблица генерируется динамически -->
                        </div>
                    </div>

                    <!-- Интерактивная лента битов -->
                    <div class="card bg-black border-success rounded-0 p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary small text-uppercase">Битовый поток (кликайте по маркерам-разделителям):</span>
                            <span id="p3-decoded-preview" class="badge bg-dark border border-warning text-warning fs-6 px-3 py-1">
                                Результат: <span id="p3-decoded-word" class="font-monospace fw-bold">---</span>
                            </span>
                        </div>

                        <div id="p3-stream-container" class="d-flex flex-wrap align-items-center gap-1 py-3 px-2 border border-secondary bg-dark min-h-[90px] overflow-x-auto">
                            <!-- Битовая лента с кнопками нарезки -->
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <button id="btn-reset-p3" class="btn btn-outline-secondary rounded-0 px-3">Снять все разрезы</button>
                        <button id="btn-check-p3" class="btn btn-success rounded-0 px-4 py-2 text-uppercase fw-bold" disabled>
                            Завершить декодирование
                        </button>
                    </div>
                </div>

                <!-- ==================== ЭКРАН УСПЕХА ==================== -->
                <div id="completion-screen" class="d-none text-center py-4">
                    <div class="display-5 text-success mb-3">✔ УРОВЕНЬ 1 УСПЕШНО ПРОЙДЕН!</div>
                    <p class="text-light fs-5 mb-4">
                        Вы безупречно освоили классификацию систем кодирования, построение бинарного дерева условий Фано и поточное декодирование сообщений.
                    </p>
                    <div class="badge bg-black border border-success text-success p-3 fs-6 rounded-0">
                        Телеметрия зафиксирована. Переходите к аналитическому Уровню 2!
                    </div>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(function() {
    // Состояние тренажера
    let currentPhase = 1;
    let attemptsCount = 0;
    const startTime = Date.now();
    let timerInterval = null;

    // DOM-элементы
    const attemptsDisplay = document.getElementById('attempts-display');
    const timerDisplay = document.getElementById('timer-display');
    const phaseBadge = document.getElementById('phase-badge');
    const phaseTitle = document.getElementById('phase-title');
    const feedbackBox = document.getElementById('feedback-box');
    const feedbackText = document.getElementById('feedback-text');

    // Таймер
    timerInterval = setInterval(() => {
        const sec = Math.floor((Date.now() - startTime) / 1000);
        const m = String(Math.floor(sec / 60)).padStart(2, '0');
        const s = String(sec % 60).padStart(2, '0');
        if (timerDisplay) timerDisplay.textContent = `${m}:${s}`;
    }, 1000);

    // Телеметрия
    function sendTelemetry(actionType, successStatus, statusStr) {
        const payload = {
            type: 'TELEMETRY_EVENT',
            mission_name: 'Урок 28 :: Двоичное кодирование. Равномерные и неравномерные коды (Уровень 1)',
            action_type: actionType,
            status: statusStr,
            start_time: new Date(startTime).toISOString(),
            time_spent_sec: Math.max(1, Math.round((Date.now() - startTime) / 1000)),
            attempts_count: attemptsCount,
            success: successStatus
        };
        try {
            window.parent.postMessage(payload, '*');
        } catch(e) {
            console.error('Telemetry postMessage error:', e);
        }
    }

    // Обработка ошибки и сброс текущей фазы
    function triggerFailure(message, resetCallback) {
        attemptsCount++;
        if (attemptsDisplay) attemptsDisplay.textContent = attemptsCount;
        if (feedbackText) feedbackText.textContent = message;
        if (feedbackBox) feedbackBox.classList.remove('d-none');

        sendTelemetry('hardcore_reset', false, 'in_progress');

        setTimeout(() => {
            if (feedbackBox) feedbackBox.classList.add('d-none');
            if (typeof resetCallback === 'function') resetCallback();
        }, 1300);
    }

    // =========================================================================
    // ФАЗА 1: КЛАССИФИКАЦИЯ КОДОВЫХ СИСТЕМ (DRAG-TO-BUCKET / CLICK-TO-SELECT)
    // =========================================================================
    const P1_BANK = [
        // Равномерные (uniform)
        { id: 'u1', name: 'ASCII (L = 7 бит)', words: ['0100001', '0100010', '0100011'], cat: 'uniform' },
        { id: 'u2', name: '2-битный равномерный', words: ['00', '01', '10', '11'], cat: 'uniform' },
        { id: 'u3', name: '3-битный октальный', words: ['000', '001', '010', '111'], cat: 'uniform' },
        { id: 'u4', name: 'Тетрадный код (L = 4)', words: ['0001', '0010', '1100', '1111'], cat: 'uniform' },

        // Префиксные (prefix) - прямое Фано
        { id: 'p1', name: 'Префиксный алфавит А-Г', words: ['0', '10', '110', '111'], cat: 'prefix' },
        { id: 'p2', name: 'Двоичное дерево Хаффмана', words: ['00', '01', '100', '101', '11'], cat: 'prefix' },
        { id: 'p3', name: 'Префиксный код переменной длины', words: ['0', '100', '101', '11'], cat: 'prefix' },
        { id: 'p4', name: 'Словарь с коротким нулевым флагом', words: ['0', '10', '11'], cat: 'prefix' },

        // Постфиксные (postfix) - обратное Фано
        { id: 'pos1', name: 'Постфиксный код обратного чтения', words: ['0', '01', '011', '111'], cat: 'postfix' },
        { id: 'pos2', name: 'Суффиксный словарь', words: ['0', '10', '001', '101', '111'], cat: 'postfix' },
        { id: 'pos3', name: 'Обратный префикс-инвертор', words: ['00', '10', '001', '101'], cat: 'postfix' },

        // Недекодируемые / коллизии (ambiguous)
        { id: 'a1', name: 'Коллизия: {0, 1, 01, 10}', words: ['0', '1', '01', '10'], cat: 'ambiguous' },
        { id: 'a2', name: 'Коллизия префикса и суффикса: {0, 00, 01}', words: ['0', '00', '01'], cat: 'ambiguous' },
        { id: 'a3', name: 'Двойная коллизия: {1, 10, 01, 11}', words: ['1', '10', '01', '11'], cat: 'ambiguous' }
    ];

    let p1SelectedCard = null;
    let p1ActiveCards = [];

    function initPhase1() {
        const pool = document.getElementById('p1-card-pool');
        const buckets = document.querySelectorAll('#phase1 .bucket-content');
        buckets.forEach(b => b.innerHTML = '');

        // Выбираем процедурно 6 карточек: гарантированно по 1-2 из каждой категории
        const shuffled = [...P1_BANK].sort(() => 0.5 - Math.random());
        const selected = [];
        const cats = ['uniform', 'prefix', 'postfix', 'ambiguous'];
        cats.forEach(c => {
            const item = shuffled.find(x => x.cat === c && !selected.includes(x));
            if (item) selected.push(item);
        });
        // Добавляем еще 2 случайные
        shuffled.forEach(x => {
            if (selected.length < 6 && !selected.includes(x)) selected.push(x);
        });

        p1ActiveCards = selected.sort(() => 0.5 - Math.random());
        pool.innerHTML = '';

        p1ActiveCards.forEach(card => {
            const el = document.createElement('div');
            el.className = 'card bg-dark border-secondary rounded-0 p-2 text-light cursor-pointer select-none card-token min-h-[48px] d-flex flex-column justify-content-center';
            el.style.minWidth = '140px';
            el.style.maxWidth = '220px';
            el.style.cursor = 'grab';
            el.draggable = true;
            el.dataset.id = card.id;
            el.dataset.cat = card.cat;

            el.innerHTML = `
                <div class="fw-bold small text-warning mb-1">${card.name}</div>
                <div class="font-monospace text-secondary" style="font-size: 0.75rem;">{ ${card.words.join(', ')} }</div>
            `;

            // Drag-and-drop
            el.addEventListener('dragstart', (e) => {
                e.dataTransfer.setData('text/plain', card.id);
                el.classList.add('opacity-50');
            });
            el.addEventListener('dragend', () => {
                el.classList.remove('opacity-50');
            });

            // Click-to-move
            el.addEventListener('click', (e) => {
                if (p1SelectedCard && p1SelectedCard !== el && el.closest('.bucket-zone')) {
                    return; // Всплытие к bucket-zone для сброса выбранной карты
                }
                e.stopPropagation();
                if (p1SelectedCard === el) {
                    el.classList.remove('border-warning');
                    p1SelectedCard = null;
                } else {
                    if (p1SelectedCard) p1SelectedCard.classList.remove('border-warning');
                    p1SelectedCard = el;
                    el.classList.add('border-warning');
                }
            });

            pool.appendChild(el);
        });

        updateP1Counts();
    }

    // Обработка зон сброса Фазы 1
    const p1BucketZones = document.querySelectorAll('#phase1 .bucket-zone');
    p1BucketZones.forEach(zone => {
        zone.addEventListener('dragover', (e) => e.preventDefault());
        zone.addEventListener('drop', (e) => {
            e.preventDefault();
            const cardId = e.dataTransfer.getData('text/plain');
            const cardEl = document.querySelector(`.card-token[data-id="${cardId}"]`);
            if (cardEl) {
                zone.querySelector('.bucket-content').appendChild(cardEl);
                cardEl.classList.remove('border-warning');
                p1SelectedCard = null;
                updateP1Counts();
            }
        });

        zone.addEventListener('click', () => {
            if (p1SelectedCard) {
                zone.querySelector('.bucket-content').appendChild(p1SelectedCard);
                p1SelectedCard.classList.remove('border-warning');
                p1SelectedCard = null;
                updateP1Counts();
            }
        });
    });

    // Возврат в пул при клике по пулу
    const p1PoolEl = document.getElementById('p1-card-pool');
    p1PoolEl.addEventListener('click', () => {
        if (p1SelectedCard) {
            p1PoolEl.appendChild(p1SelectedCard);
            p1SelectedCard.classList.remove('border-warning');
            p1SelectedCard = null;
            updateP1Counts();
        }
    });

    function updateP1Counts() {
        let placedCount = 0;
        p1BucketZones.forEach(zone => {
            const countEl = zone.querySelector('.bucket-count');
            const items = zone.querySelectorAll('.card-token');
            countEl.textContent = items.length;
            placedCount += items.length;
        });

        const btnCheck = document.getElementById('btn-check-p1');
        btnCheck.disabled = placedCount < p1ActiveCards.length;
    }

    document.getElementById('btn-check-p1').addEventListener('click', () => {
        let hasError = false;
        p1BucketZones.forEach(zone => {
            const bucketType = zone.dataset.bucket;
            const cards = zone.querySelectorAll('.card-token');
            cards.forEach(c => {
                if (c.dataset.cat !== bucketType) {
                    hasError = true;
                }
            });
        });

        if (hasError) {
            triggerFailure('Ошибка классификации: один или несколько кодов помещены не в свой класс!', initPhase1);
        } else {
            // Переход к Фазе 2
            document.getElementById('phase1').classList.add('d-none');
            document.getElementById('phase2').classList.remove('d-none');
            currentPhase = 2;
            phaseBadge.textContent = 'Шаг 2 из 3';
            phaseBadge.className = 'badge bg-warning text-dark rounded-0 fs-6 me-2';
            phaseTitle.textContent = 'Конструирование префиксного дерева (Slot & Snap)';
            initPhase2();
        }
    });

    // =========================================================================
    // ФАЗА 2: КОНСТРУИРОВАНИЕ БИНАРНОГО ДЕРЕВА (SLOT & SNAP)
    // =========================================================================
    // Варианты конфигураций деревьев для Фазы 2
    const P2_CONFIGS = [
        {
            title: 'Алфавит из 4 букв (Хаффман-стандарт)',
            letters: [
                { symbol: 'А', code: '0', freq: 50 },
                { symbol: 'Б', code: '10', freq: 25 },
                { symbol: 'В', code: '110', freq: 15 },
                { symbol: 'Г', code: '111', freq: 10 }
            ],
            distractors: [
                { symbol: 'Д', code: '1', freq: 5, isTrap: true, reason: 'Код "1" является внутренним узлом дерева и префиксом для Б, В, Г!' },
                { symbol: 'Е', code: '11', freq: 8, isTrap: true, reason: 'Код "11" является внутренним узлом и префиксом для В, Г!' }
            ],
            slots: [
                { id: 'slot-0', code: '0', label: 'Ветвь 0 (Лист)' },
                { id: 'slot-10', code: '10', label: 'Ветвь 1 → 0 (Лист)' },
                { id: 'slot-110', code: '110', label: 'Ветвь 1 → 1 → 0 (Лист)' },
                { id: 'slot-111', code: '111', label: 'Ветвь 1 → 1 → 1 (Лист)' }
            ]
        },
        {
            title: 'Сбалансированное дерево из 4 букв',
            letters: [
                { symbol: 'С', code: '00', freq: 30 },
                { symbol: 'О', code: '01', freq: 30 },
                { symbol: 'К', code: '10', freq: 20 },
                { symbol: 'Л', code: '11', freq: 20 }
            ],
            distractors: [
                { symbol: 'М', code: '0', freq: 10, isTrap: true, reason: 'Код "0" является внутренним узлом для "00" и "01"!' },
                { symbol: 'Н', code: '1', freq: 10, isTrap: true, reason: 'Код "1" является внутренним узлом для "10" и "11"!' }
            ],
            slots: [
                { id: 'slot-00', code: '00', label: 'Ветвь 0 → 0 (Лист)' },
                { id: 'slot-01', code: '01', label: 'Ветвь 0 → 1 (Лист)' },
                { id: 'slot-10', code: '10', label: 'Ветвь 1 → 0 (Лист)' },
                { id: 'slot-11', code: '11', label: 'Ветвь 1 → 1 (Лист)' }
            ]
        }
    ];

    let p2SelectedToken = null;
    let p2ActiveConfig = null;

    function initPhase2() {
        p2ActiveConfig = P2_CONFIGS[Math.floor(Math.random() * P2_CONFIGS.length)];
        const palette = document.getElementById('p2-token-palette');
        const treeCanvas = document.getElementById('p2-tree-canvas');
        palette.innerHTML = '';
        treeCanvas.innerHTML = '';
        p2SelectedToken = null;

        // Собираем токены букв и дистракторы в случайном порядке
        const allTokens = [...p2ActiveConfig.letters, ...p2ActiveConfig.distractors].sort(() => 0.5 - Math.random());

        allTokens.forEach(t => {
            const el = document.createElement('div');
            el.className = 'btn btn-outline-warning rounded-0 p-2 text-start d-flex justify-content-between align-items-center token-item min-h-[48px] select-none';
            el.dataset.symbol = t.symbol;
            el.dataset.code = t.code;
            el.dataset.isTrap = t.isTrap ? 'true' : 'false';
            el.innerHTML = `
                <span class="fs-5 fw-bold text-light">${t.symbol}</span>
                <span class="badge bg-dark border border-warning text-warning font-monospace">код: ${t.code}</span>
            `;

            el.addEventListener('click', (e) => {
                e.stopPropagation();
                if (p2SelectedToken === el) {
                    el.classList.remove('btn-warning', 'text-dark');
                    el.classList.add('btn-outline-warning');
                    p2SelectedToken = null;
                } else {
                    if (p2SelectedToken) {
                        p2SelectedToken.classList.remove('btn-warning', 'text-dark');
                        p2SelectedToken.classList.add('btn-outline-warning');
                    }
                    p2SelectedToken = el;
                    el.classList.remove('btn-outline-warning');
                    el.classList.add('btn-warning', 'text-dark');
                }
            });

            palette.appendChild(el);
        });

        // Создаем слоты дерева
        const treeWrapper = document.createElement('div');
        treeWrapper.className = 'w-100 d-flex flex-column align-items-center gap-3';

        // Визуальная шапка корня дерева
        const rootNode = document.createElement('div');
        rootNode.className = 'badge bg-dark border border-secondary text-secondary p-2 rounded-0';
        rootNode.textContent = '● Корень дерева (пустое слово ε)';
        treeWrapper.appendChild(rootNode);

        // Контейнер слотов-листьев
        const slotsRow = document.createElement('div');
        slotsRow.className = 'row g-3 w-100 justify-content-center';

        p2ActiveConfig.slots.forEach(slot => {
            const col = document.createElement('div');
            col.className = 'col-12 col-sm-6';

            const slotCard = document.createElement('div');
            slotCard.className = 'card bg-dark border border-success rounded-0 p-3 tree-slot min-h-[80px] d-flex flex-column justify-content-between';
            slotCard.dataset.targetCode = slot.code;

            slotCard.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-success small fw-bold">${slot.label}</span>
                    <span class="badge bg-black border border-success text-success font-monospace">Цель: ${slot.code}</span>
                </div>
                <div class="slot-dropzone border border-dashed border-secondary p-2 text-center text-secondary small min-h-[44px] d-flex align-items-center justify-content-center">
                    [Кликните сюда, чтобы разместить символ]
                </div>
            `;

            slotCard.addEventListener('click', () => {
                const dropzone = slotCard.querySelector('.slot-dropzone');
                if (p2SelectedToken) {
                    // Если в слоте уже был символ, возвращаем его в палитру
                    const existingToken = dropzone.querySelector('.token-item');
                    if (existingToken) {
                        palette.appendChild(existingToken);
                    }
                    dropzone.innerHTML = '';
                    dropzone.appendChild(p2SelectedToken);
                    p2SelectedToken.classList.remove('btn-warning', 'text-dark');
                    p2SelectedToken.classList.add('btn-outline-warning');
                    p2SelectedToken = null;
                    checkP2Readiness();
                } else {
                    // Если кликнули по слоту без выбранного токена, возвращаем токен из слота
                    const existingToken = dropzone.querySelector('.token-item');
                    if (existingToken) {
                        palette.appendChild(existingToken);
                        dropzone.textContent = '[Кликните сюда, чтобы разместить символ]';
                        checkP2Readiness();
                    }
                }
            });

            col.appendChild(slotCard);
            slotsRow.appendChild(col);
        });

        treeWrapper.appendChild(slotsRow);
        treeCanvas.appendChild(treeWrapper);

        checkP2Readiness();
    }

    function checkP2Readiness() {
        const slots = document.querySelectorAll('#phase2 .tree-slot');
        let filledCount = 0;
        slots.forEach(s => {
            if (s.querySelector('.token-item')) filledCount++;
        });
        document.getElementById('btn-check-p2').disabled = filledCount < slots.length;
    }

    document.getElementById('btn-reset-p2').addEventListener('click', () => {
        initPhase2();
    });

    document.getElementById('btn-check-p2').addEventListener('click', () => {
        const slots = document.querySelectorAll('#phase2 .tree-slot');
        let hasError = false;
        let errorMsg = '';

        slots.forEach(slot => {
            const token = slot.querySelector('.token-item');
            if (!token) {
                hasError = true;
                errorMsg = 'Заполнены не все листья дерева!';
            } else {
                const targetCode = slot.dataset.targetCode;
                const tokenCode = token.dataset.code;
                const isTrap = token.dataset.isTrap === 'true';

                if (isTrap) {
                    hasError = true;
                    errorMsg = `Символ ${token.dataset.symbol} нарушает условие Фано: его код является внутренним узлом дерева!`;
                } else if (tokenCode !== targetCode) {
                    hasError = true;
                    errorMsg = `Символ ${token.dataset.symbol} с кодом "${tokenCode}" не соответствует ветви "${targetCode}"!`;
                }
            }
        });

        if (hasError) {
            triggerFailure(errorMsg || 'Ошибка конфигурации бинарного дерева!', initPhase2);
        } else {
            // Переход к Фазе 3
            document.getElementById('phase2').classList.add('d-none');
            document.getElementById('phase3').classList.remove('d-none');
            currentPhase = 3;
            phaseBadge.textContent = 'Шаг 3 из 3';
            phaseBadge.className = 'badge bg-danger text-light rounded-0 fs-6 me-2';
            phaseTitle.textContent = 'Прямая интерактивная нарезка битового потока (Stream Carver)';
            initPhase3();
        }
    });

    // =========================================================================
    // ФАЗА 3: ПРЯМАЯ ИНТЕРАКТИВНАЯ НАРЕЗКА БИТОВОГО ПОТОКА (STREAM CARVER)
    // =========================================================================
    const P3_DICTIONARY = [
        { char: 'К', code: '0' },
        { char: 'Л', code: '10' },
        { char: 'М', code: '110' },
        { char: 'Н', code: '111' }
    ];

    const P3_WORDS = ['КЛМН', 'МЛКН', 'НЛКМ', 'КМЛН', 'ЛКНМ'];

    let p3TargetWord = '';
    let p3BitStream = '';
    let p3Cuts = new Set(); // индексы позиций разреза (после бита i)

    function initPhase3() {
        p3TargetWord = P3_WORDS[Math.floor(Math.random() * P3_WORDS.length)];
        p3BitStream = p3TargetWord.split('').map(ch => {
            return P3_DICTIONARY.find(x => x.char === ch).code;
        }).join('');

        p3Cuts.clear();

        // Отображение кодовой таблицы
        const tableEl = document.getElementById('p3-code-table');
        tableEl.innerHTML = '';
        P3_DICTIONARY.forEach(item => {
            const badge = document.createElement('div');
            badge.className = 'badge bg-dark border border-info text-info p-2 fs-6 rounded-0 font-monospace';
            badge.innerHTML = `<span class="text-light fw-bold me-2">${item.char}</span> <code>${item.code}</code>`;
            tableEl.appendChild(badge);
        });

        renderStream();
    }

    function renderStream() {
        const streamContainer = document.getElementById('p3-stream-container');
        streamContainer.innerHTML = '';

        for (let i = 0; i < p3BitStream.length; i++) {
            // Сам бит
            const bitEl = document.createElement('span');
            bitEl.className = 'badge bg-black border border-light text-light font-monospace fs-5 px-3 py-2 rounded-0 select-none';
            bitEl.textContent = p3BitStream[i];
            streamContainer.appendChild(bitEl);

            // Разделитель между битами (если это не последний бит)
            if (i < p3BitStream.length - 1) {
                const cutBtn = document.createElement('button');
                const isCut = p3Cuts.has(i);
                cutBtn.type = 'button';
                cutBtn.className = isCut 
                    ? 'btn btn-danger btn-sm rounded-0 px-2 py-1 mx-1 fw-bold fs-6 border-light' 
                    : 'btn btn-outline-secondary btn-sm rounded-0 px-1 py-1 mx-1 text-secondary opacity-50';
                cutBtn.style.minWidth = '32px';
                cutBtn.textContent = isCut ? '✂' : '|';
                cutBtn.title = isCut ? 'Удалить разрез' : 'Сделать разрез';

                cutBtn.addEventListener('click', () => {
                    if (p3Cuts.has(i)) {
                        p3Cuts.delete(i);
                    } else {
                        p3Cuts.add(i);
                    }
                    renderStream();
                    updateP3Decoding();
                });

                streamContainer.appendChild(cutBtn);
            }
        }

        updateP3Decoding();
    }

    function updateP3Decoding() {
        // Разделяем битовую цепочку по позициям в p3Cuts
        const cutIndices = Array.from(p3Cuts).sort((a, b) => a - b);
        const segments = [];
        let prev = 0;
        cutIndices.forEach(idx => {
            segments.push(p3BitStream.slice(prev, idx + 1));
            prev = idx + 1;
        });
        segments.push(p3BitStream.slice(prev));

        let decodedWord = '';
        let allValid = true;

        segments.forEach(seg => {
            const match = P3_DICTIONARY.find(x => x.code === seg);
            if (match) {
                decodedWord += match.char;
            } else {
                decodedWord += '?';
                allValid = false;
            }
        });

        const wordDisplay = document.getElementById('p3-decoded-word');
        wordDisplay.textContent = decodedWord;

        const btnCheck = document.getElementById('btn-check-p3');
        btnCheck.disabled = !allValid || decodedWord.includes('?');
    }

    document.getElementById('btn-reset-p3').addEventListener('click', () => {
        p3Cuts.clear();
        renderStream();
    });

    document.getElementById('btn-check-p3').addEventListener('click', () => {
        const wordDisplay = document.getElementById('p3-decoded-word').textContent;
        if (wordDisplay === p3TargetWord) {
            // Успешное завершение Уровня 1!
            document.getElementById('phase3').classList.add('d-none');
            document.getElementById('completion-screen').classList.remove('d-none');
            phaseBadge.textContent = 'Завершено';
            phaseBadge.className = 'badge bg-success text-dark rounded-0 fs-6 me-2';
            phaseTitle.textContent = 'Уровень 1 успешно сдан!';

            clearInterval(timerInterval);
            sendTelemetry('level_complete', true, 'completed');
        } else {
            triggerFailure(`Декодированное слово "${wordDisplay}" не совпадает с переданным сообщением!`, initPhase3);
        }
    });

    // Запуск первой фазы
    initPhase1();
    sendTelemetry('in_progress', false, 'in_progress');
})();
</script>
