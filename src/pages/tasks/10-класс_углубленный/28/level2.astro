---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={2}>
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Шапка тренажера -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 text-warning mb-0">Тренажер: Аналитическое кодирование и декодирование (Уровень 2)</h2>
            <span class="badge border border-warning text-warning bg-dark rounded-0 px-3 py-2">Ручной ввод // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-warning rounded-0">
            <div class="card-body p-3 p-md-4">

                <!-- Индикатор прогресса -->
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="phase-badge" class="badge bg-warning text-dark rounded-0 fs-6 me-2">Шаг 1 из 5</span>
                        <span id="phase-title" class="text-light fw-bold fs-6">Формула Хартли и равномерное кодирование</span>
                    </div>
                    <div class="text-secondary small">
                        Попытки: <span id="attempts-display" class="text-warning">0</span> | Время: <span id="timer-display" class="text-info">00:00</span>
                    </div>
                </div>

                <!-- Системный баннер ошибки -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between">
                        <span>[ОШИБКА ВЫЧИСЛЕНИЯ] <span id="feedback-text">Неверный результат!</span> Генерируется новый вариант...</span>
                        <span class="spinner-border spinner-border-sm text-danger" role="status"></span>
                    </div>
                </div>

                <!-- ==================== ШАГ 1: ФОРМУЛА ХАРТЛИ ==================== -->
                <div id="phase1" class="phase-container">
                    <div class="alert alert-dark bg-black border-secondary rounded-0 text-light mb-3">
                        <div class="fw-bold text-warning mb-1">Спецификация задачи:</div>
                        В бортовой системе аэрокосмического аппарата передаются управляющие команды. Алфавит команд содержит 
                        <span id="p1-m" class="badge bg-dark border border-warning text-warning fs-6">60</span> уникальных инструкций.
                        Все команды кодируются <strong>равномерным двоичным кодом минимальной разрядности</strong>.
                    </div>

                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="mb-3">
                            <label class="form-label text-light small text-uppercase">1. Минимальная разрядность одного кодового слова L (бит):</label>
                            <input type="text" inputmode="numeric" id="p1-input-l" class="form-control bg-dark border-secondary text-warning rounded-0 w-100" style="max-width: 480px;" placeholder="Введите целое число бит" autocomplete="off" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label text-light small text-uppercase">
                                2. Информационный объем сообщения из <span id="p1-k" class="text-info fw-bold">24</span> команд в <strong>байтах</strong>:
                            </label>
                            <input type="text" inputmode="numeric" id="p1-input-bytes" class="form-control bg-dark border-secondary text-warning rounded-0 w-100" style="max-width: 480px;" placeholder="Введите объем в байтах" autocomplete="off" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="btn-submit-p1" class="btn btn-warning rounded-0 px-4 py-2 text-uppercase fw-bold text-dark">
                            Подтвердить расчет
                        </button>
                    </div>
                </div>

                <!-- ==================== ШАГ 2: СРЕДНЯЯ ДЛИНА И КОД ХАФФМАНА ==================== -->
                <div id="phase2" class="phase-container d-none">
                    <div class="alert alert-dark bg-black border-secondary rounded-0 text-light mb-3">
                        <div class="fw-bold text-warning mb-1">Спецификация задачи:</div>
                        Для сжатия телеметрического потока применен оптимальный префиксный код Хаффмана.
                        Алфавит состоит из 4 символов со следующими вероятностями и кодовыми словами:
                    </div>

                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="table-responsive mb-3">
                            <table class="table table-dark table-bordered border-secondary mb-0 text-center font-monospace align-middle">
                                <thead class="text-secondary small">
                                    <tr>
                                        <th>Символ</th>
                                        <th>Вероятность p<sub>i</sub></th>
                                        <th>Кодовое слово</th>
                                        <th>Длина l<sub>i</sub> (бит)</th>
                                    </tr>
                                </thead>
                                <tbody id="p2-table-body">
                                    <!-- Строки генерируются процедурно -->
                                </tbody>
                            </table>
                        </div>

                        <div>
                            <label class="form-label text-light small text-uppercase">Рассчитайте среднюю длину кодового слова L<sub>ср</sub> (бит/символ):</label>
                            <input type="text" inputmode="decimal" id="p2-input-lavg" class="form-control bg-dark border-secondary text-warning rounded-0 w-100" style="max-width: 480px;" placeholder="Например: 1.75" autocomplete="off" />
                            <div class="form-text text-secondary">Формула: L<sub>ср</sub> = ∑ (p<sub>i</sub> × l<sub>i</sub>). Поддерживается точка и запятая.</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="btn-submit-p2" class="btn btn-warning rounded-0 px-4 py-2 text-uppercase fw-bold text-dark">
                            Проверить расчет
                        </button>
                    </div>
                </div>

                <!-- ==================== ШАГ 3: ОБРАТНАЯ ЗАДАЧА НА УСЛОВИЕ ФАНО ==================== -->
                <div id="phase3" class="phase-container d-none">
                    <div class="alert alert-dark bg-black border-secondary rounded-0 text-light mb-3">
                        <div class="fw-bold text-warning mb-1">Спецификация задачи (ЕГЭ №4 профильный срез):</div>
                        Для передачи сообщений, содержащих 5 букв <span class="badge bg-dark border border-warning text-warning">А, Б, В, Г, Д</span>, 
                        используется неравномерный двоичный код, удовлетворяющий <strong>прямому условию Фано</strong>.
                        Для 4 букв кодовые слова уже известны:
                        <div id="p3-known-codes" class="mt-2 font-monospace fs-6 text-info">
                            <!-- Известные коды -->
                        </div>
                    </div>

                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <p class="text-light small mb-3">
                            Какое <strong>кратчайшее</strong> двоичное кодовое слово можно назначить для оставшейся буквы 
                            <strong class="text-warning">Д</strong>, чтобы код оставался однозначно декодируемым?
                            Если таких слов несколько, укажите кодовое слово с <strong>наименьшим числовым значением</strong>.
                        </p>
                        <div>
                            <label class="form-label text-light small text-uppercase">Двоичный код для буквы Д (последовательность 0 и 1):</label>
                            <input type="text" inputmode="numeric" id="p3-input-code" class="form-control bg-dark border-secondary text-warning rounded-0 w-100 font-monospace" style="max-width: 480px;" placeholder="Например: 11" autocomplete="off" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="btn-submit-p3" class="btn btn-warning rounded-0 px-4 py-2 text-uppercase fw-bold text-dark">
                            Подтвердить код
                        </button>
                    </div>
                </div>

                <!-- ==================== ШАГ 4: ДОЛИНА КОНСОЛИДАЦИИ (НЕРАВЕНСТВО КРАФТА) ==================== -->
                <div id="phase4" class="phase-container d-none">
                    <div class="alert alert-dark bg-black border-secondary rounded-0 text-light mb-3">
                        <div class="fw-bold text-warning mb-1">Концептуальный инвариант (Неравенство Крафта — Макмиллана):</div>
                        Для существования префиксного двоичного кода с длинами слов l<sub>1</sub>, l<sub>2</sub>, ..., l<sub>M</sub> необходимо и достаточно, чтобы:
                        <div class="fs-6 font-monospace text-warning my-1">∑ 2<sup>-l<sub>i</sub></sup> ≤ 1</div>
                        Код является <strong>полным (насыщенным)</strong>, если сумма в точности равна 1.
                    </div>

                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="mb-3">
                            <span class="text-light small">Задан префиксный код со следующими длинами кодовых слов:</span>
                            <div id="p4-lengths-display" class="badge bg-dark border border-info text-info fs-6 my-2 p-2 font-monospace">
                                <!-- Длины -->
                            </div>
                        </div>

                        <div>
                            <label class="form-label text-light small text-uppercase">Вычислите точное значение суммы Крафта K = ∑ 2<sup>-l<sub>i</sub></sup>:</label>
                            <input type="text" inputmode="decimal" id="p4-input-kraft" class="form-control bg-dark border-secondary text-warning rounded-0 w-100" style="max-width: 480px;" placeholder="Например: 1 или 0.75" autocomplete="off" />
                            <div class="form-text text-secondary">Укажите десятичную дробь (1, 0.75, 0.875). Поддерживается точка и запятая.</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="btn-submit-p4" class="btn btn-warning rounded-0 px-4 py-2 text-uppercase fw-bold text-dark">
                            Проверить сумму
                        </button>
                    </div>
                </div>

                <!-- ==================== ШАГ 5: КУЛЬМИНАЦИОННОЕ ДЕКОДИРОВАНИЕ ==================== -->
                <div id="phase5" class="phase-container d-none">
                    <div class="alert alert-dark bg-black border-secondary rounded-0 text-light mb-3">
                        <div class="fw-bold text-warning mb-1">Кульминационная аналитическая задача:</div>
                        По каналу связи без пауз передана зашифрованная последовательность битов.
                        Словарь префиксного кода:
                        <div id="p5-dict-display" class="d-flex flex-wrap gap-2 my-2 font-monospace">
                            <!-- Таблица -->
                        </div>
                        Битовый поток сообщения:
                        <div id="p5-stream-display" class="badge bg-black border border-warning text-warning p-2 fs-6 w-100 text-start text-break font-monospace my-1">
                            <!-- Поток -->
                        </div>
                    </div>

                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="mb-3">
                            <label class="form-label text-light small text-uppercase">1. Декодированное исходное слово (заглавными буквами):</label>
                            <input type="text" id="p5-input-text" class="form-control bg-dark border-secondary text-warning rounded-0 w-100 font-monospace text-uppercase" style="max-width: 480px;" placeholder="Например: АЛГОРИТМ" autocomplete="off" />
                        </div>
                        <div>
                            <label class="form-label text-light small text-uppercase">2. Общее число символов в сообщении:</label>
                            <input type="text" inputmode="numeric" id="p5-input-count" class="form-control bg-dark border-secondary text-warning rounded-0 w-100" style="max-width: 480px;" placeholder="Число символов" autocomplete="off" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="btn-submit-p5" class="btn btn-warning rounded-0 px-4 py-2 text-uppercase fw-bold text-dark">
                            Сдать аналитическое решение
                        </button>
                    </div>
                </div>

                <!-- ==================== ЭКРАН УСПЕХА ==================== -->
                <div id="completion-screen" class="d-none text-center py-4">
                    <div class="display-5 text-warning mb-3">★ УРОВЕНЬ 2 УСПЕШНО ПРОЙДЕН!</div>
                    <p class="text-light fs-5 mb-4">
                        Вы продемонстрировали превосходное владение формулой Хартли, вычислением средней длины Хаффмана, 
                        разрешением условий Фано и неравенством Крафта.
                    </p>
                    <div class="badge bg-black border border-warning text-warning p-3 fs-6 rounded-0">
                        Телеметрия сохранена. Готовьтесь к испытанию Уровня 3 (Аркада / Босс)!
                    </div>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(() => {
    // Состояние сессии
    let currentPhase = 1;
    let attemptsCount = 0;
    const startTime = Date.now();
    let timerInterval = null;

    // Элементы индикации
    const attemptsDisplay = document.getElementById('attempts-display');
    const timerDisplay = document.getElementById('timer-display');
    const phaseBadge = document.getElementById('phase-badge');
    const phaseTitle = document.getElementById('phase-title');
    const feedbackBox = document.getElementById('feedback-box');
    const feedbackText = document.getElementById('feedback-text');

    // Таймер
    timerInterval = setInterval(() => {
        const sec = Math.floor((Date.now() - startTime) / 1000);
        const m = String(Math.floor(sec / 60)).padStart(2, '0');
        const s = String(sec % 60).padStart(2, '0');
        if (timerDisplay) timerDisplay.textContent = `${m}:${s}`;
    }, 1000);

    // Нормализация пользовательского числового ввода (запятая -> точка, trim)
    function parseUserNum(val) {
        if (!val) return NaN;
        const normalized = String(val).trim().replace(',', '.');
        return parseFloat(normalized);
    }

    // Отправка телеметрии
    function sendTelemetry(actionType, successStatus, statusStr) {
        const payload = {
            type: 'TELEMETRY_EVENT',
            mission_name: 'Урок 28 :: Двоичное кодирование. Равномерные и неравномерные коды (Уровень 2)',
            action_type: actionType,
            status: statusStr,
            start_time: new Date(startTime).toISOString(),
            time_spent_sec: Math.max(1, Math.round((Date.now() - startTime) / 1000)),
            attempts_count: attemptsCount,
            success: successStatus
        };
        try {
            window.parent.postMessage(payload, '*');
        } catch(e) {
            console.error('Telemetry postMessage error:', e);
        }
    }

    // Обработка ошибки и сброс текущей фазы
    function triggerFailure(message, resetCallback) {
        attemptsCount++;
        if (attemptsDisplay) attemptsDisplay.textContent = attemptsCount;
        if (feedbackText) feedbackText.textContent = message;
        if (feedbackBox) feedbackBox.classList.remove('d-none');

        sendTelemetry('hardcore_reset', false, 'in_progress');

        setTimeout(() => {
            if (feedbackBox) feedbackBox.classList.add('d-none');
            if (typeof resetCallback === 'function') resetCallback();
        }, 1200);
    }

    // =========================================================================
    // ШАГ 1: ФОРМУЛА ХАРТЛИ И РАВНОМЕРНЫЙ КОД
    // =========================================================================
    let p1TargetL = 0;
    let p1TargetBytes = 0;

    const P1_VARIANTS = [
        { m: 45, k: 32, l: 6, bytes: 24 }, // 6 * 32 = 192 бит = 24 байта
        { m: 60, k: 24, l: 6, bytes: 18 }, // 6 * 24 = 144 бит = 18 байт
        { m: 75, k: 32, l: 7, bytes: 28 }, // 7 * 32 = 224 бит = 28 байт
        { m: 120, k: 16, l: 7, bytes: 14 }, // 7 * 16 = 112 бит = 14 байт
        { m: 200, k: 16, l: 8, bytes: 16 }, // 8 * 16 = 128 бит = 16 байт
        { m: 300, k: 24, l: 9, bytes: 27 }  // 9 * 24 = 216 бит = 27 байт
    ];

    function initPhase1() {
        const v = P1_VARIANTS[Math.floor(Math.random() * P1_VARIANTS.length)];
        p1TargetL = v.l;
        p1TargetBytes = v.bytes;

        document.getElementById('p1-m').textContent = v.m;
        document.getElementById('p1-k').textContent = v.k;
        document.getElementById('p1-input-l').value = '';
        document.getElementById('p1-input-bytes').value = '';
    }

    document.getElementById('btn-submit-p1').addEventListener('click', checkPhase1);
    document.getElementById('p1-input-bytes').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') checkPhase1();
    });

    function checkPhase1() {
        const userL = parseUserNum(document.getElementById('p1-input-l').value);
        const userBytes = parseUserNum(document.getElementById('p1-input-bytes').value);

        if (isNaN(userL) || isNaN(userBytes)) {
            triggerFailure('Заполните оба числовых поля ответа!', initPhase1);
            return;
        }

        if (userL === p1TargetL && userBytes === p1TargetBytes) {
            document.getElementById('phase1').classList.add('d-none');
            document.getElementById('phase2').classList.remove('d-none');
            currentPhase = 2;
            phaseBadge.textContent = 'Шаг 2 из 5';
            phaseTitle.textContent = 'Расчет средней длины кода Хаффмана';
            initPhase2();
        } else {
            triggerFailure(`Неверно! L = ${userL}, Байт = ${userBytes}. Проверьте формулу Хартли и деление на 8.`, initPhase1);
        }
    }

    // =========================================================================
    // ШАГ 2: СРЕДНЯЯ ДЛИНА И КОД ХАФФМАНА
    // =========================================================================
    let p2TargetLavg = 0;

    const P2_VARIANTS = [
        {
            table: [
                { char: 'A', prob: 0.50, code: '0', len: 1 },
                { char: 'B', prob: 0.25, code: '10', len: 2 },
                { char: 'C', prob: 0.15, code: '110', len: 3 },
                { char: 'D', prob: 0.10, code: '111', len: 3 }
            ],
            lavg: 1.75
        },
        {
            table: [
                { char: 'A', prob: 0.60, code: '0', len: 1 },
                { char: 'B', prob: 0.20, code: '10', len: 2 },
                { char: 'C', prob: 0.10, code: '110', len: 3 },
                { char: 'D', prob: 0.10, code: '111', len: 3 }
            ],
            lavg: 1.60
        },
        {
            table: [
                { char: 'A', prob: 0.40, code: '0', len: 1 },
                { char: 'B', prob: 0.30, code: '10', len: 2 },
                { char: 'C', prob: 0.20, code: '110', len: 3 },
                { char: 'D', prob: 0.10, code: '111', len: 3 }
            ],
            lavg: 1.90
        }
    ];

    function initPhase2() {
        const v = P2_VARIANTS[Math.floor(Math.random() * P2_VARIANTS.length)];
        p2TargetLavg = v.lavg;

        const tbody = document.getElementById('p2-table-body');
        tbody.innerHTML = '';
        v.table.forEach(row => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="fw-bold text-warning">${row.char}</td>
                <td>${(row.prob * 100).toFixed(0)}% (${row.prob.toFixed(2)})</td>
                <td class="text-info">${row.code}</td>
                <td>${row.len}</td>
            `;
            tbody.appendChild(tr);
        });

        document.getElementById('p2-input-lavg').value = '';
    }

    document.getElementById('btn-submit-p2').addEventListener('click', checkPhase2);
    document.getElementById('p2-input-lavg').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') checkPhase2();
    });

    function checkPhase2() {
        const userLavg = parseUserNum(document.getElementById('p2-input-lavg').value);
        if (isNaN(userLavg)) {
            triggerFailure('Введите числовое значение средней длины!', initPhase2);
            return;
        }

        if (Math.abs(userLavg - p2TargetLavg) < 0.01) {
            document.getElementById('phase2').classList.add('d-none');
            document.getElementById('phase3').classList.remove('d-none');
            currentPhase = 3;
            phaseBadge.textContent = 'Шаг 3 из 5';
            phaseTitle.textContent = 'Пик 1: Обратная задача на прямое условие Фано';
            initPhase3();
        } else {
            triggerFailure(`Неверно! Получено ${userLavg}, ожидалось ${p2TargetLavg}. L_ср = ∑ p_i * l_i.`, initPhase2);
        }
    }

    // =========================================================================
    // ШАГ 3: ОБРАТНАЯ ЗАДАЧА НА УСЛОВИЕ ФАНО (ПИК 1)
    // =========================================================================
    let p3TargetCode = '';

    const P3_VARIANTS = [
        {
            codes: 'А: 00, Б: 01, В: 100, Г: 101',
            targetCode: '11' // ветви под 00, 01, 100, 101 закрыты. Свободна 11 (длина 2, мин значение)
        },
        {
            codes: 'А: 0, Б: 100, В: 101, Г: 110',
            targetCode: '111' // под 0 закрыто, 100, 101, 110 закрыты. Свободна 111 (длина 3)
        },
        {
            codes: 'А: 00, Б: 01, В: 10, Г: 110',
            targetCode: '111' // свободны 111
        },
        {
            codes: 'А: 000, Б: 01, В: 100, Г: 110',
            targetCode: '001' // свободны на мин. длине 3: 001, 101, 111. Мин. числовое значение -> 001
        }
    ];

    function initPhase3() {
        const v = P3_VARIANTS[Math.floor(Math.random() * P3_VARIANTS.length)];
        p3TargetCode = v.targetCode;

        document.getElementById('p3-known-codes').textContent = v.codes;
        document.getElementById('p3-input-code').value = '';
    }

    document.getElementById('btn-submit-p3').addEventListener('click', checkPhase3);
    document.getElementById('p3-input-code').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') checkPhase3();
    });

    function checkPhase3() {
        const userCode = document.getElementById('p3-input-code').value.trim();
        if (!userCode || !/^[01]+$/.test(userCode)) {
            triggerFailure('Введите двоичную строку из нулей и единиц!', initPhase3);
            return;
        }

        if (userCode === p3TargetCode) {
            document.getElementById('phase3').classList.add('d-none');
            document.getElementById('phase4').classList.remove('d-none');
            currentPhase = 4;
            phaseBadge.textContent = 'Шаг 4 из 5';
            phaseTitle.textContent = 'Долина консолидации: Неравенство Крафта — Макмиллана';
            initPhase4();
        } else {
            triggerFailure(`Код "${userCode}" неверен! Он либо нарушает условие Фано, либо не является кратчайшим.`, initPhase3);
        }
    }

    // =========================================================================
    // ШАГ 4: ДОЛИНА КОНСОЛИДАЦИИ (НЕРАВЕНСТВО КРАФТА)
    // =========================================================================
    let p4TargetKraft = 0;

    const P4_VARIANTS = [
        {
            text: '{ l₁ = 1, l₂ = 2, l₃ = 3, l₄ = 3 }',
            kraft: 1.0 // 1/2 + 1/4 + 1/8 + 1/8 = 1.0
        },
        {
            text: '{ l₁ = 2, l₂ = 2, l₃ = 2, l₄ = 3, l₅ = 3 }',
            kraft: 1.0 // 1/4 + 1/4 + 1/4 + 1/8 + 1/8 = 1.0
        },
        {
            text: '{ l₁ = 2, l₂ = 2, l₃ = 3, l₄ = 3 }',
            kraft: 0.75 // 1/4 + 1/4 + 1/8 + 1/8 = 0.75
        },
        {
            text: '{ l₁ = 1, l₂ = 3, l₃ = 3, l₄ = 3, l₅ = 3 }',
            kraft: 1.0 // 1/2 + 4 * 1/8 = 1.0
        }
    ];

    function initPhase4() {
        const v = P4_VARIANTS[Math.floor(Math.random() * P4_VARIANTS.length)];
        p4TargetKraft = v.kraft;

        document.getElementById('p4-lengths-display').textContent = v.text;
        document.getElementById('p4-input-kraft').value = '';
    }

    document.getElementById('btn-submit-p4').addEventListener('click', checkPhase4);
    document.getElementById('p4-input-kraft').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') checkPhase4();
    });

    function checkPhase4() {
        const userKraft = parseUserNum(document.getElementById('p4-input-kraft').value);
        if (isNaN(userKraft)) {
            triggerFailure('Введите числовое значение суммы Крафта!', initPhase4);
            return;
        }

        if (Math.abs(userKraft - p4TargetKraft) < 0.01) {
            document.getElementById('phase4').classList.add('d-none');
            document.getElementById('phase5').classList.remove('d-none');
            currentPhase = 5;
            phaseBadge.textContent = 'Шаг 5 из 5';
            phaseTitle.textContent = 'Кульминация: Сквозное декодирование битового потока';
            initPhase5();
        } else {
            triggerFailure(`Неверно! Получено ${userKraft}, ожидалось ${p4TargetKraft}. Проверьте степени двойки 2^(-l_i).`, initPhase4);
        }
    }

    // =========================================================================
    // ШАГ 5: КУЛЬМИНАЦИОННОЕ ДЕКОДИРОВАНИЕ СТРОКИ
    // =========================================================================
    let p5TargetWord = '';
    let p5TargetCount = 0;

    const P5_DICT = [
        { char: 'А', code: '0' },
        { char: 'Б', code: '10' },
        { char: 'В', code: '110' },
        { char: 'Г', code: '111' }
    ];

    const P5_VARIANTS = [
        { word: 'ГАВБ', stream: '111011010' },           // Г(111) А(0) В(110) Б(10) -> длина 4
        { word: 'БАВАГ', stream: '1001100111' },         // Б(10) А(0) В(110) А(0) Г(111) -> длина 5
        { word: 'АБАВГА', stream: '01001101110' },       // А(0) Б(10) А(0) В(110) Г(111) А(0) -> длина 6
        { word: 'ВБАГАБА', stream: '1101001110100' }     // В(110) Б(10) А(0) Г(111) А(0) Б(10) А(0) -> длина 7
    ];

    function initPhase5() {
        const v = P5_VARIANTS[Math.floor(Math.random() * P5_VARIANTS.length)];
        p5TargetWord = v.word;
        p5TargetCount = v.word.length;

        const dictEl = document.getElementById('p5-dict-display');
        dictEl.innerHTML = '';
        P5_DICT.forEach(d => {
            const b = document.createElement('span');
            b.className = 'badge bg-dark border border-secondary text-light p-2';
            b.innerHTML = `<span class="text-warning fw-bold">${d.char}:</span> ${d.code}`;
            dictEl.appendChild(b);
        });

        document.getElementById('p5-stream-display').textContent = v.stream;
        document.getElementById('p5-input-text').value = '';
        document.getElementById('p5-input-count').value = '';
    }

    document.getElementById('btn-submit-p5').addEventListener('click', checkPhase5);
    document.getElementById('p5-input-count').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') checkPhase5();
    });

    function checkPhase5() {
        const userText = document.getElementById('p5-input-text').value.trim().toUpperCase();
        const userCount = parseUserNum(document.getElementById('p5-input-count').value);

        if (!userText || isNaN(userCount)) {
            triggerFailure('Заполните оба поля ответа!', initPhase5);
            return;
        }

        if (userText === p5TargetWord && userCount === p5TargetCount) {
            document.getElementById('phase5').classList.add('d-none');
            document.getElementById('completion-screen').classList.remove('d-none');
            phaseBadge.textContent = 'Завершено';
            phaseBadge.className = 'badge bg-warning text-dark rounded-0 fs-6 me-2';
            phaseTitle.textContent = 'Уровень 2 успешно сдан!';

            clearInterval(timerInterval);
            sendTelemetry('level_complete', true, 'completed');
        } else {
            triggerFailure(`Ошибка декодирования! Слово "${userText}", длина ${userCount}. Проверьте префиксы слева направо.`, initPhase5);
        }
    }

    // Запуск первого шага
    initPhase1();
    sendTelemetry('in_progress', false, 'in_progress');
})();
</script>
