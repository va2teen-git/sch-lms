---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={1}>
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Шапка тренажера -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h4 text-success mb-0">Тренажер: Единицы измерения и алфавитный подход (Уровень 1)</h2>
            <span class="badge border border-success text-success bg-dark rounded-0 px-3 py-2">Манипуляция мышью // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-success rounded-0">
            <div class="card-body p-3 p-md-4">

                <!-- Заголовок фазы и телеметрия -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="phase-badge" class="badge bg-success text-dark rounded-0 fs-6 me-2">Шаг 1 из 3</span>
                        <span id="phase-title" class="text-light fw-bold fs-6">Квантование алфавита по Хартли (Slot & Snap)</span>
                    </div>
                    <div class="text-secondary small">
                        Ошибки: <span id="attempts-display" class="text-warning">0</span> | Время: <span id="timer-display" class="text-info">00:00</span>
                    </div>
                </div>

                <!-- Системный баннер ошибки -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <span>[СИСТЕМНЫЙ СБОЙ] <span id="feedback-text">Неверная конфигурация!</span> Перегенерация варианта...</span>
                        <span class="spinner-border spinner-border-sm text-danger flex-shrink-0" role="status"></span>
                    </div>
                </div>

                <!-- ==================== ФАЗА 1: КВАНТОВАНИЕ АЛФАВИТА (SLOT & SNAP) ==================== -->
                <div id="phase1" class="phase-container">
                    <p class="text-light mb-2">
                        Для каждой знаковой системы задана мощность алфавита <strong>N</strong>.
                        <strong>Перетащите токен минимального целого информационного веса символа i (в битах)</strong> в соответствующий слот (либо кликните по токену, затем по слоту).
                    </p>
                    <div class="text-warning small mb-3">
                        Критерий посимвольного равномерного кодирования: 2<sup>i − 1</sup> &lt; N &le; 2<sup>i</sup>. В палитре присутствуют лишние токены-дистракторы.
                    </div>

                    <!-- Палитра битовых токенов -->
                    <div class="card bg-black border-secondary rounded-0 mb-3 p-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <span class="text-secondary small text-uppercase">Палитра битовых весов i (перетащите или выберите кликом):</span>
                            <button id="p1-reset-btn" type="button" class="btn btn-outline-secondary btn-sm rounded-0" style="min-height: 48px;">Сбросить слоты</button>
                        </div>
                        <div id="p1-token-pool" class="d-flex flex-wrap gap-2 align-items-center" style="min-height: 54px;">
                            <!-- Генерируется JS -->
                        </div>
                    </div>

                    <!-- Целевые слоты алфавитов -->
                    <div class="card bg-black border-success rounded-0 p-3 mb-3">
                        <div class="text-secondary small text-uppercase mb-3 border-bottom border-secondary pb-1">
                            Каналы и алфавиты системы:
                        </div>
                        <div id="p1-slots-container" class="d-flex flex-column gap-3">
                            <!-- Генерируется JS -->
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p1-submit-btn" type="button" class="btn btn-success rounded-0 fw-bold px-4 py-2" style="min-height: 48px;" disabled>
                            Зафиксировать битовые веса &rarr;
                        </button>
                    </div>
                </div>

                <!-- ==================== ФАЗА 2: КОММУТАЦИЯ ИНФОРМАЦИОННЫХ ПОТОКОВ (WIRE PATCHING) ==================== -->
                <div id="phase2" class="phase-container d-none">
                    <p class="text-light mb-2">
                        Скоммутируйте информационные потоки и накопители слева с их точными объемами справа.
                        <strong>Кликните на выходной порт слева, затем на соответствующий входной порт справа</strong> (либо перетащите провод с порта на порт).
                    </p>
                    <div class="text-warning small mb-3">
                        Учитывайте разницу между двоичными (1 Кбайт = 1024 Б, 1 МиБ = 2<sup>20</sup> Б) и десятичными (1 Мбит = 10<sup>6</sup> бит, 1 МБ = 10<sup>6</sup> Б) единицами. Два правых порта — ложные дистракторы.
                    </div>

                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 border-bottom border-secondary pb-2">
                            <span class="text-secondary small text-uppercase">Кросс-панель коммутации объемов (3 линии):</span>
                            <button id="p2-reset-btn" type="button" class="btn btn-outline-secondary btn-sm rounded-0" style="min-height: 48px;">Сбросить провода</button>
                        </div>

                        <div id="p2-wiring-board" class="position-relative">
                            <svg id="p2-svg-wires" class="position-absolute top-0 start-0 w-100 h-100 pe-none" style="z-index: 2;"></svg>
                            <div class="row g-2 align-items-center position-relative" style="z-index: 3;">
                                <div class="col-5">
                                    <div id="p2-left-ports" class="d-flex flex-column gap-3">
                                        <!-- Левые порты JS -->
                                    </div>
                                </div>
                                <div class="col-2"></div>
                                <div class="col-5">
                                    <div id="p2-right-ports" class="d-flex flex-column gap-2">
                                        <!-- Правые порты JS -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span id="p2-link-counter" class="text-secondary small">Скоммутировано линий: 0 / 3</span>
                        <button id="p2-submit-btn" type="button" class="btn btn-success rounded-0 fw-bold px-4 py-2" style="min-height: 48px;" disabled>
                            Проверить коммутацию &rarr;
                        </button>
                    </div>
                </div>

                <!-- ==================== ФАЗА 3: ПРОЕКТИРОВЩИК БАЙТОВОГО ХРАНИЛИЩА (DIRECT GRID + CALIBRATOR) ==================== -->
                <div id="phase3" class="phase-container d-none">
                    <p class="text-light mb-2">
                        Спроектируйте структуру памяти базы данных для хранения сведений об объектах с <strong>побайтным выравниванием каждой записи</strong>.
                    </p>
                    <div id="p3-task-spec" class="card bg-black border-info rounded-0 p-3 mb-3 text-light">
                        <!-- Генерируется JS -->
                    </div>

                    <!-- Орган прямого управления 1: 8-битная линейка веса символа -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <span class="text-secondary small text-uppercase">1. Выделите информационный вес 1 символа i на битовой шине (клик по ячейке):</span>
                            <span id="p3-bits-badge" class="badge bg-dark border border-success text-success rounded-0 px-2 py-1">Выбрано: 0 бит</span>
                        </div>
                        <div id="p3-bit-bar" class="d-flex flex-wrap gap-2">
                            <!-- 8 ячеек JS -->
                        </div>
                    </div>

                    <!-- Орган прямого управления 2: матрица байтов 1 записи -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <span class="text-secondary small text-uppercase">2. Выделите полный размер 1 записи в байтах (код с округлением вверх + заголовок):</span>
                            <span id="p3-bytes-badge" class="badge bg-dark border border-success text-success rounded-0 px-2 py-1">Выбрано: 0 байт</span>
                        </div>
                        <div id="p3-byte-grid" class="d-flex flex-wrap gap-2">
                            <!-- 14 байт-ячеек JS -->
                        </div>
                    </div>

                    <!-- Орган прямого управления 3: калибратор итогового объема -->
                    <div class="card bg-black border-success rounded-0 p-3 mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <span class="text-secondary small text-uppercase">3. Настройте общий объем памяти для всех записей (байт):</span>
                            <span id="p3-total-badge" class="badge bg-success text-dark rounded-0 fs-6 px-3 py-1">0 байт</span>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <button id="p3-dec10-btn" type="button" class="btn btn-outline-secondary rounded-0 fw-bold" style="min-width: 52px; min-height: 48px;">-10</button>
                            <button id="p3-dec1-btn" type="button" class="btn btn-outline-secondary rounded-0 fw-bold" style="min-width: 48px; min-height: 48px;">-1</button>
                            <input id="p3-total-slider" type="range" class="form-range flex-fill mx-2" min="0" max="600" step="1" value="0" aria-label="Объем памяти в байтах" style="min-width: 160px; height: 48px;">
                            <button id="p3-inc1-btn" type="button" class="btn btn-outline-secondary rounded-0 fw-bold" style="min-width: 48px; min-height: 48px;">+1</button>
                            <button id="p3-inc10-btn" type="button" class="btn btn-outline-secondary rounded-0 fw-bold" style="min-width: 52px; min-height: 48px;">+10</button>
                        </div>
                        <div class="d-flex justify-content-between text-secondary small">
                            <span>0 Б</span>
                            <span id="p3-slider-mid">300 Б</span>
                            <span id="p3-slider-max">600 Б</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <button id="p3-reset-btn" type="button" class="btn btn-outline-secondary rounded-0" style="min-height: 48px;">Сбросить настройки</button>
                        <button id="p3-submit-btn" type="button" class="btn btn-success rounded-0 fw-bold px-4 py-2" style="min-height: 48px;" disabled>
                            Подтвердить проект хранилища
                        </button>
                    </div>
                </div>

                <!-- ==================== ЭКРАН ПОБЕДЫ ==================== -->
                <div id="victory-screen" class="text-center py-4 d-none">
                    <div class="display-5 text-success mb-3">✔ МИССИЯ ВЫПОЛНЕНА</div>
                    <p class="lead text-light mb-3">
                        Вы успешно откалибровали битовые веса алфавитов по Хартли, скоммутировали потоки в двоичных и десятичных единицах и спроектировали выровненное байтовое хранилище!
                    </p>
                    <div class="card bg-black border-success rounded-0 p-3 mx-auto mb-4" style="max-width: 520px;">
                        <div class="d-flex justify-content-around text-center">
                            <div>
                                <div class="text-secondary small">ПРОЙДЕНО ФАЗ</div>
                                <div class="fs-4 fw-bold text-success">3 / 3</div>
                            </div>
                            <div>
                                <div class="text-secondary small">ОШИБОК И СБОЕВ</div>
                                <div id="final-attempts" class="fs-4 fw-bold text-warning">0</div>
                            </div>
                            <div>
                                <div class="text-secondary small">ИТОГОВОЕ ВРЕМЯ</div>
                                <div id="final-time" class="fs-4 fw-bold text-info">00:00</div>
                            </div>
                        </div>
                    </div>
                    <span class="badge bg-success text-dark rounded-0 px-4 py-2 fs-6">
                        Уровень 1 завершен. Данные телеметрии зафиксированы.
                    </span>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(function() {
    let currentPhase = 1;
    let isProcessingError = false;
    let timerInterval = null;

    const telemetry = window.LMSTelemetry.create({
        missionName: 'Урок 31 :: Единицы измерения количества информации. Алфавитный подход к оценке количества информации (Уровень 1)',
        level: 1,
        totalStages: 3
    });

    const attemptsDisplay = document.getElementById('attempts-display');
    const timerDisplay = document.getElementById('timer-display');
    const phaseBadge = document.getElementById('phase-badge');
    const phaseTitle = document.getElementById('phase-title');
    const feedbackBox = document.getElementById('feedback-box');
    const feedbackText = document.getElementById('feedback-text');

    function randInt(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    function pickRandom(arr) {
        return arr[Math.floor(Math.random() * arr.length)];
    }

    function shuffle(arr) {
        const copy = arr.slice();
        for (let i = copy.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            const tmp = copy[i];
            copy[i] = copy[j];
            copy[j] = tmp;
        }
        return copy;
    }

    function formatTime(sec) {
        const m = String(Math.floor(sec / 60)).padStart(2, '0');
        const s = String(sec % 60).padStart(2, '0');
        return `${m}:${s}`;
    }

    timerInterval = setInterval(() => {
        if (timerDisplay) timerDisplay.textContent = formatTime(telemetry.getTimeSpentSec());
    }, 1000);

    function triggerFailure(message, resetCallback) {
        if (isProcessingError) return;
        isProcessingError = true;
        telemetry.fail({ stage: currentPhase, total_stages: 3 });
        if (attemptsDisplay) attemptsDisplay.textContent = String(telemetry.getState().attemptsCount);
        if (feedbackText) feedbackText.textContent = message;
        if (feedbackBox) feedbackBox.classList.remove('d-none');

        setTimeout(() => {
            if (feedbackBox) feedbackBox.classList.add('d-none');
            isProcessingError = false;
            resetCallback();
        }, 1250);
    }

    function switchToPhase(nextPhase) {
        document.getElementById(`phase${currentPhase}`).classList.add('d-none');
        currentPhase = nextPhase;
        if (nextPhase <= 3) {
            telemetry.advanceStage(nextPhase);
            document.getElementById(`phase${nextPhase}`).classList.remove('d-none');
            phaseBadge.textContent = `Шаг ${nextPhase} из 3`;
            if (nextPhase === 2) {
                phaseTitle.textContent = 'Коммутация информационных потоков (Wire Patching)';
                generatePhase2();
            } else if (nextPhase === 3) {
                phaseTitle.textContent = 'Проектировщик байтового хранилища (Grid & Calibrator)';
                generatePhase3();
            }
        }
    }

    function showVictory() {
        document.getElementById('phase3').classList.add('d-none');
        if (timerInterval) clearInterval(timerInterval);
        telemetry.complete({ stage: 3, total_stages: 3 });
        const finalTime = formatTime(telemetry.getTimeSpentSec());
        document.getElementById('final-attempts').textContent = String(telemetry.getState().attemptsCount);
        document.getElementById('final-time').textContent = finalTime;
        document.getElementById('victory-screen').classList.remove('d-none');
        phaseBadge.textContent = 'Завершено';
        phaseTitle.textContent = 'Все 3 фазы выполнены';
    }

    // =========================================================================
    // ФАЗА 1: СЛОТ-ПАЗЛ (SLOT & SNAP) — КВАНТОВАНИЕ АЛФАВИТА ПО ХАРТЛИ
    // =========================================================================
    const p1TokenPool = document.getElementById('p1-token-pool');
    const p1SlotsContainer = document.getElementById('p1-slots-container');
    const p1ResetBtn = document.getElementById('p1-reset-btn');
    const p1SubmitBtn = document.getElementById('p1-submit-btn');

    const p1State = {
        tasks: [],      // { id, label, N, expectedBits }
        poolBits: [],   // [3, 4, 5, 7, 8]
        assignments: {}, // slotId -> bits | null
        selectedBit: null,
        draggedBit: null
    };

    const SYSTEM_LABELS = [
        'Телеметрия метеозонда',
        'Шина бортового контроллера',
        'Секторный код доступа',
        'Таблица знаков маршрутизатора',
        'Алфавит промышленного сканера',
        'Протокол радиомаяка'
    ];

    function pickAlphabetPower(bits) {
        const lo = (1 << (bits - 1)) + 1;
        const hi = 1 << bits;
        // Повышаем шанс граничных значений (lo, lo+1, hi) для проверки точных границ
        const candidates = [lo, hi, randInt(lo, hi)];
        return pickRandom(candidates);
    }

    function generatePhase1() {
        const labels = shuffle(SYSTEM_LABELS).slice(0, 3);
        const groups = [
            pickRandom([2, 3, 4]),
            pickRandom([5, 6]),
            pickRandom([7, 8])
        ];
        const orderedBits = shuffle(groups);

        p1State.tasks = orderedBits.map((bits, idx) => ({
            id: `slot-${idx + 1}`,
            label: labels[idx],
            N: pickAlphabetPower(bits),
            expectedBits: bits
        }));

        const allPossible = [2, 3, 4, 5, 6, 7, 8];
        const remaining = shuffle(allPossible.filter(b => !orderedBits.includes(b)));
        const distractors = remaining.slice(0, 2);
        p1State.poolBits = shuffle([...orderedBits, ...distractors]);
        p1State.assignments = {};
        p1State.tasks.forEach(t => { p1State.assignments[t.id] = null; });
        p1State.selectedBit = null;
        p1State.draggedBit = null;

        renderPhase1();
    }

    function renderPhase1() {
        const usedBits = new Set(Object.values(p1State.assignments).filter(v => v !== null));

        // Рендер палитры
        p1TokenPool.innerHTML = '';
        p1State.poolBits.forEach(bits => {
            const isUsed = usedBits.has(bits);
            const isSelected = p1State.selectedBit === bits;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.dataset.bits = String(bits);
            btn.draggable = !isUsed;
            btn.disabled = isUsed;
            btn.className = `btn rounded-0 fw-bold px-3 py-2 ${
                isUsed
                    ? 'btn-outline-secondary opacity-50'
                    : isSelected
                        ? 'btn-warning text-dark border-warning'
                        : 'btn-outline-success'
            }`;
            btn.style.minWidth = '88px';
            btn.style.minHeight = '48px';
            btn.textContent = `${bits} бит`;
            p1TokenPool.appendChild(btn);
        });

        // Рендер целевых слотов
        p1SlotsContainer.innerHTML = '';
        p1State.tasks.forEach(task => {
            const assigned = p1State.assignments[task.id];
            const row = document.createElement('div');
            row.className = 'd-flex flex-wrap justify-content-between align-items-center gap-3 p-3 bg-dark border border-secondary';

            const info = document.createElement('div');
            info.className = 'text-light';
            info.innerHTML = `
                <div class="fw-bold text-success">${task.label}</div>
                <div class="small text-secondary">Мощность алфавита: <span class="text-warning fw-bold fs-6">N = ${task.N}</span> символов</div>
            `;

            const slot = document.createElement('button');
            slot.type = 'button';
            slot.dataset.slotId = task.id;
            slot.className = `btn rounded-0 fw-bold px-3 py-2 ${
                assigned !== null
                    ? 'btn-success text-dark'
                    : p1State.selectedBit !== null
                        ? 'btn-outline-warning'
                        : 'btn-outline-secondary text-light'
            }`;
            slot.style.minWidth = '170px';
            slot.style.minHeight = '52px';
            slot.textContent = assigned !== null ? `${assigned} бит (убрать)` : '[ Поместить вес i ]';

            row.appendChild(info);
            row.appendChild(slot);
            p1SlotsContainer.appendChild(row);
        });

        const allFilled = p1State.tasks.every(t => p1State.assignments[t.id] !== null);
        p1SubmitBtn.disabled = !allFilled;
    }

    function assignBitToSlot(bits, slotId) {
        if (isProcessingError || !bits || !slotId) return;
        // Убираем этот токен из любого другого слота, если вдруг там был
        Object.keys(p1State.assignments).forEach(k => {
            if (p1State.assignments[k] === bits) p1State.assignments[k] = null;
        });
        p1State.assignments[slotId] = bits;
        p1State.selectedBit = null;
        p1State.draggedBit = null;
        renderPhase1();
    }

    // Однократные обработчики Фазы 1 (делегирование)
    p1TokenPool.addEventListener('click', (e) => {
        if (isProcessingError) return;
        const btn = e.target.closest('button[data-bits]');
        if (!btn || btn.disabled) return;
        const bits = Number(btn.dataset.bits);
        p1State.selectedBit = (p1State.selectedBit === bits) ? null : bits;
        renderPhase1();
    });

    p1TokenPool.addEventListener('dragstart', (e) => {
        const btn = e.target.closest('button[data-bits]');
        if (!btn || btn.disabled) return;
        p1State.draggedBit = Number(btn.dataset.bits);
        if (e.dataTransfer) {
            e.dataTransfer.setData('text/plain', btn.dataset.bits);
            e.dataTransfer.effectAllowed = 'move';
        }
    });

    p1SlotsContainer.addEventListener('dragover', (e) => {
        const slot = e.target.closest('button[data-slot-id]');
        if (!slot) return;
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
    });

    p1SlotsContainer.addEventListener('drop', (e) => {
        const slot = e.target.closest('button[data-slot-id]');
        if (!slot || isProcessingError) return;
        e.preventDefault();
        const raw = p1State.draggedBit || Number(e.dataTransfer ? e.dataTransfer.getData('text/plain') : 0);
        if (raw) assignBitToSlot(raw, slot.dataset.slotId);
    });

    p1SlotsContainer.addEventListener('click', (e) => {
        if (isProcessingError) return;
        const slot = e.target.closest('button[data-slot-id]');
        if (!slot) return;
        const slotId = slot.dataset.slotId;
        if (p1State.selectedBit !== null) {
            assignBitToSlot(p1State.selectedBit, slotId);
        } else if (p1State.assignments[slotId] !== null) {
            p1State.assignments[slotId] = null;
            renderPhase1();
        }
    });

    p1ResetBtn.addEventListener('click', () => {
        if (isProcessingError) return;
        Object.keys(p1State.assignments).forEach(k => { p1State.assignments[k] = null; });
        p1State.selectedBit = null;
        renderPhase1();
    });

    p1SubmitBtn.addEventListener('click', () => {
        if (isProcessingError) return;
        const wrong = p1State.tasks.find(t => p1State.assignments[t.id] !== t.expectedBits);
        if (wrong) {
            const chosen = p1State.assignments[wrong.id];
            triggerFailure(
                `Для алфавита N = ${wrong.N} выбран неверный вес ${chosen} бит (проверьте 2^(i-1) < N <= 2^i).`,
                generatePhase1
            );
            return;
        }
        switchToPhase(2);
    });

    // =========================================================================
    // ФАЗА 2: КОММУТАЦИЯ ИНФОРМАЦИОННЫХ ПОТОКОВ (WIRE PATCHING)
    // =========================================================================
    const p2Board = document.getElementById('p2-wiring-board');
    const p2Svg = document.getElementById('p2-svg-wires');
    const p2LeftPortsEl = document.getElementById('p2-left-ports');
    const p2RightPortsEl = document.getElementById('p2-right-ports');
    const p2ResetBtn = document.getElementById('p2-reset-btn');
    const p2SubmitBtn = document.getElementById('p2-submit-btn');
    const p2LinkCounter = document.getElementById('p2-link-counter');

    const p2State = {
        leftNodes: [],   // { id, title, detail, targetId, targetLabel }
        rightNodes: [],  // { id, label }
        links: {},       // leftId -> rightId
        activeLeftId: null
    };

    function buildPhase2Templates() {
        // Линия 1: Сообщение алфавита N и длиной K -> Кбайт или байт
        const l1Variants = [
            { N: 16, i: 4, K: 2048, outText: '1 Кбайт', distText: '4 Кбайт' },
            { N: 32, i: 5, K: 1024, outText: '640 байт', distText: '5 Кбайт' },
            { N: 64, i: 6, K: 4096, outText: '3 Кбайт', distText: '6 Кбайт' },
            { N: 128, i: 7, K: 2048, outText: '1792 байта', distText: '14 Кбайт' },
            { N: 8, i: 3, K: 8192, outText: '3 Кбайт', distText: '24 Кбайт' }
        ];
        const v1 = pickRandom(l1Variants);

        // Линия 2: Степени двойки и двоичные приставки (IEC)
        const l2Variants = [
            { expr: '2<sup>16</sup> бит', outText: '8 Кбайт', distText: '16 Кбайт' },
            { expr: '2<sup>22</sup> байт', outText: '4 МиБ', distText: '2 МиБ' },
            { expr: '0,5 МиБ', outText: '512 КиБ', distText: '500 Кбайт' },
            { expr: '2<sup>15</sup> бит', outText: '4 Кбайт', distText: '32 Кбайт' },
            { expr: '16 384 бит', outText: '2 Кбайт', distText: '2048 байт' } // distinct
        ].slice(0, 4); // уберем последний, чтобы не пересекаться с Кбайт
        const v2 = pickRandom(l2Variants);

        // Линия 3: Канал связи (десятичные СИ) или накопитель ТБ/ГБ
        const l3Variants = [
            { expr: '100 Мбит/с (10<sup>6</sup>) за 8 с', outText: '100 МБ (10<sup>6</sup> Б)', distText: '800 МБ' },
            { expr: '80 Мбит/с (10<sup>6</sup>) за 5 с', outText: '50 МБ (10<sup>6</sup> Б)', distText: '400 МБ' },
            { expr: '40 Мбит/с (10<sup>6</sup>) за 10 с', outText: '50 МБ (10<sup>6</sup> Б)', distText: '320 МБ' },
            { expr: '200 Мбит/с (10<sup>6</sup>) за 4 с', outText: '100 МБ (10<sup>6</sup> Б)', distText: '25 МБ' },
            { expr: '1 Гбит/с (10<sup>9</sup>) за 8 с', outText: '1 ГБ (10<sup>9</sup> Б)', distText: '125 МБ' }
        ];
        const v3 = pickRandom(l3Variants);

        // Гарантируем отсутствие совпадения текста между всеми 5 правыми портами
        const labels = [v1.outText, v2.outText, v3.outText, v1.distText, v3.distText];
        if (new Set(labels).size < 5) {
            return buildPhase2Templates();
        }

        const left = [
            {
                id: 'L1',
                title: 'Текст (алфавитный объем)',
                detail: `K = ${v1.K} симв., N = ${v1.N}`,
                targetId: 'R1'
            },
            {
                id: 'L2',
                title: 'Двоичная емкость (1024)',
                detail: v2.expr,
                targetId: 'R2'
            },
            {
                id: 'L3',
                title: 'Сетевой канал (СИ)',
                detail: v3.expr,
                targetId: 'R3'
            }
        ];

        const right = [
            { id: 'R1', label: v1.outText },
            { id: 'R2', label: v2.outText },
            { id: 'R3', label: v3.outText },
            { id: 'D1', label: v1.distText },
            { id: 'D2', label: v3.distText }
        ];

        return { left: shuffle(left), right: shuffle(right) };
    }

    function generatePhase2() {
        const tpl = buildPhase2Templates();
        p2State.leftNodes = tpl.left;
        p2State.rightNodes = tpl.right;
        p2State.links = {};
        p2State.activeLeftId = null;
        renderPhase2();
    }

    function drawWires() {
        if (!p2Board || !p2Svg) return;
        const boardRect = p2Board.getBoundingClientRect();
        if (boardRect.width === 0 || boardRect.height === 0) return;

        p2Svg.setAttribute('viewBox', `0 0 ${boardRect.width} ${boardRect.height}`);
        p2Svg.innerHTML = '';

        const colors = ['#198754', '#0dcaf0', '#ffc107'];
        Object.entries(p2State.links).forEach(([leftId, rightId], idx) => {
            const lEl = p2LeftPortsEl.querySelector(`[data-left-id="${leftId}"]`);
            const rEl = p2RightPortsEl.querySelector(`[data-right-id="${rightId}"]`);
            if (!lEl || !rEl) return;

            const lRect = lEl.getBoundingClientRect();
            const rRect = rEl.getBoundingClientRect();

            const x1 = lRect.right - boardRect.left;
            const y1 = lRect.top + lRect.height / 2 - boardRect.top;
            const x2 = rRect.left - boardRect.left;
            const y2 = rRect.top + rRect.height / 2 - boardRect.top;
            const dx = Math.max(40, Math.abs(x2 - x1) * 0.5);

            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            path.setAttribute('d', `M ${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`);
            path.setAttribute('fill', 'none');
            path.setAttribute('stroke', colors[idx % colors.length]);
            path.setAttribute('stroke-width', '3');
            p2Svg.appendChild(path);

            const dot1 = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            dot1.setAttribute('cx', String(x1));
            dot1.setAttribute('cy', String(y1));
            dot1.setAttribute('r', '5');
            dot1.setAttribute('fill', colors[idx % colors.length]);
            p2Svg.appendChild(dot1);

            const dot2 = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            dot2.setAttribute('cx', String(x2));
            dot2.setAttribute('cy', String(y2));
            dot2.setAttribute('r', '5');
            dot2.setAttribute('fill', colors[idx % colors.length]);
            p2Svg.appendChild(dot2);
        });
    }

    function renderPhase2() {
        p2LeftPortsEl.innerHTML = '';
        p2State.leftNodes.forEach(node => {
            const isActive = p2State.activeLeftId === node.id;
            const isLinked = Boolean(p2State.links[node.id]);
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.dataset.leftId = node.id;
            btn.draggable = true;
            btn.className = `btn rounded-0 text-start p-2 p-sm-3 w-100 ${
                isActive
                    ? 'btn-warning text-dark border-warning'
                    : isLinked
                        ? 'btn-outline-success text-light border-success'
                        : 'btn-dark border-secondary text-light'
            }`;
            btn.style.minHeight = '64px';
            btn.innerHTML = `
                <div class="small ${isActive ? 'text-dark' : 'text-secondary'} text-uppercase">${node.title}</div>
                <div class="fw-bold ${isActive ? 'text-dark' : 'text-success'}">${node.detail}</div>
            `;
            p2LeftPortsEl.appendChild(btn);
        });

        const linkedRightIds = new Set(Object.values(p2State.links));
        p2RightPortsEl.innerHTML = '';
        p2State.rightNodes.forEach(node => {
            const isLinked = linkedRightIds.has(node.id);
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.dataset.rightId = node.id;
            btn.className = `btn rounded-0 text-end p-2 p-sm-3 w-100 fw-bold ${
                isLinked
                    ? 'btn-success text-dark'
                    : p2State.activeLeftId
                        ? 'btn-outline-warning text-light'
                        : 'btn-dark border-secondary text-light'
            }`;
            btn.style.minHeight = '52px';
            btn.innerHTML = node.label;
            p2RightPortsEl.appendChild(btn);
        });

        const count = Object.keys(p2State.links).length;
        p2LinkCounter.textContent = `Скоммутировано линий: ${count} / 3`;
        p2SubmitBtn.disabled = count !== 3;
        requestAnimationFrame(drawWires);
    }

    function connectPorts(leftId, rightId) {
        if (!leftId || !rightId || isProcessingError) return;
        // Один правый порт — максимум одна линия
        Object.keys(p2State.links).forEach(k => {
            if (p2State.links[k] === rightId) delete p2State.links[k];
        });
        p2State.links[leftId] = rightId;
        p2State.activeLeftId = null;
        renderPhase2();
    }

    p2LeftPortsEl.addEventListener('click', (e) => {
        if (isProcessingError) return;
        const btn = e.target.closest('button[data-left-id]');
        if (!btn) return;
        const leftId = btn.dataset.leftId;
        if (p2State.activeLeftId === leftId) {
            p2State.activeLeftId = null;
        } else {
            p2State.activeLeftId = leftId;
        }
        renderPhase2();
    });

    p2LeftPortsEl.addEventListener('dragstart', (e) => {
        const btn = e.target.closest('button[data-left-id]');
        if (!btn) return;
        p2State.activeLeftId = btn.dataset.leftId;
        if (e.dataTransfer) {
            e.dataTransfer.setData('text/plain', btn.dataset.leftId);
            e.dataTransfer.effectAllowed = 'link';
        }
    });

    p2RightPortsEl.addEventListener('dragover', (e) => {
        if (e.target.closest('button[data-right-id]')) {
            e.preventDefault();
        }
    });

    p2RightPortsEl.addEventListener('drop', (e) => {
        const btn = e.target.closest('button[data-right-id]');
        if (!btn || isProcessingError) return;
        e.preventDefault();
        const leftId = p2State.activeLeftId || (e.dataTransfer ? e.dataTransfer.getData('text/plain') : null);
        if (leftId) connectPorts(leftId, btn.dataset.rightId);
    });

    p2RightPortsEl.addEventListener('click', (e) => {
        if (isProcessingError) return;
        const btn = e.target.closest('button[data-right-id]');
        if (!btn) return;
        const rightId = btn.dataset.rightId;
        if (p2State.activeLeftId) {
            connectPorts(p2State.activeLeftId, rightId);
        } else {
            // Клик по занятому правому порту отключает провод
            Object.keys(p2State.links).forEach(k => {
                if (p2State.links[k] === rightId) delete p2State.links[k];
            });
            renderPhase2();
        }
    });

    p2ResetBtn.addEventListener('click', () => {
        if (isProcessingError) return;
        p2State.links = {};
        p2State.activeLeftId = null;
        renderPhase2();
    });

    p2SubmitBtn.addEventListener('click', () => {
        if (isProcessingError) return;
        const mismatch = p2State.leftNodes.find(n => p2State.links[n.id] !== n.targetId);
        if (mismatch) {
            triggerFailure(
                `Ошибка коммутации для «${mismatch.detail}». Проверьте перевод бит ↔ байт и приставки 1024 vs 1000.`,
                generatePhase2
            );
            return;
        }
        switchToPhase(3);
    });

    window.addEventListener('resize', () => {
        if (currentPhase === 2) drawWires();
    });

    // =========================================================================
    // ФАЗА 3: ПРОЕКТИРОВЩИК БАЙТОВОГО ХРАНИЛИЩА (DIRECT GRID + CALIBRATOR)
    // =========================================================================
    const p3TaskSpec = document.getElementById('p3-task-spec');
    const p3BitBar = document.getElementById('p3-bit-bar');
    const p3ByteGrid = document.getElementById('p3-byte-grid');
    const p3BitsBadge = document.getElementById('p3-bits-badge');
    const p3BytesBadge = document.getElementById('p3-bytes-badge');
    const p3TotalBadge = document.getElementById('p3-total-badge');
    const p3TotalSlider = document.getElementById('p3-total-slider');
    const p3SliderMid = document.getElementById('p3-slider-mid');
    const p3SliderMax = document.getElementById('p3-slider-max');
    const p3Dec10Btn = document.getElementById('p3-dec10-btn');
    const p3Dec1Btn = document.getElementById('p3-dec1-btn');
    const p3Inc1Btn = document.getElementById('p3-inc1-btn');
    const p3Inc10Btn = document.getElementById('p3-inc10-btn');
    const p3ResetBtn = document.getElementById('p3-reset-btn');
    const p3SubmitBtn = document.getElementById('p3-submit-btn');

    const p3State = {
        letters: 0,
        digits: 10,
        specials: 0,
        N: 0,
        K: 0,
        extraBytes: 0,
        M: 0,
        expectedBits: 0,
        expectedRecordBytes: 0,
        expectedTotalBytes: 0,
        sliderMax: 600,
        chosenBits: 0,
        chosenRecordBytes: 0,
        chosenTotalBytes: 0
    };

    function generatePhase3() {
        let letters, digits, specials, N, K, bits, codeBytes, extraBytes, recordBytes, M, totalBytes;
        while (true) {
            letters = pickRandom([12, 16, 20, 22, 23, 26]);
            digits = 10;
            specials = pickRandom([0, 3, 5, 7, 10, 15, 29]);
            N = letters + digits + specials;
            bits = Math.ceil(Math.log2(N));
            if (bits < 5 || bits > 7) continue;

            K = randInt(5, 11);
            // Твист: количество бит на код не кратно 8 — обязательное округление вверх до целого байта!
            if ((K * bits) % 8 === 0) continue;

            codeBytes = Math.ceil((K * bits) / 8);
            extraBytes = randInt(2, 4);
            recordBytes = codeBytes + extraBytes;
            if (recordBytes > 14) continue;

            M = pickRandom([10, 12, 16, 20, 24, 25, 32, 40]);
            totalBytes = M * recordBytes;
            if (totalBytes >= 80 && totalBytes <= 520) break;
        }

        const sliderMax = Math.ceil((totalBytes + 80) / 100) * 100;
        p3State.letters = letters;
        p3State.digits = digits;
        p3State.specials = specials;
        p3State.N = N;
        p3State.K = K;
        p3State.extraBytes = extraBytes;
        p3State.M = M;
        p3State.expectedBits = bits;
        p3State.expectedRecordBytes = recordBytes;
        p3State.expectedTotalBytes = totalBytes;
        p3State.sliderMax = sliderMax;

        p3State.chosenBits = 0;
        p3State.chosenRecordBytes = 0;
        p3State.chosenTotalBytes = 0;

        p3TotalSlider.max = String(sliderMax);
        p3TotalSlider.value = '0';
        p3SliderMid.textContent = `${Math.floor(sliderMax / 2)} Б`;
        p3SliderMax.textContent = `${sliderMax} Б`;

        const specParts = [`<strong>${letters}</strong> латинских букв`, `<strong>${digits}</strong> цифр`];
        if (specials > 0) specParts.push(`<strong>${specials}</strong> спецсимволов`);

        p3TaskSpec.innerHTML = `
            <div class="small text-info text-uppercase mb-1">Техническое задание базы данных:</div>
            <div>
                Каждому из <strong>M = ${M}</strong> пользователей выдается код длиной <strong>K = ${K} символов</strong>.
                Допустимы: ${specParts.join(', ')}.
                Код каждого пользователя хранится в минимальном целом числе байт (посимвольное равномерное кодирование).
                Дополнительно к коду на каждого пользователя отводится <strong>${extraBytes} байта</strong> заголовка.
            </div>
        `;

        renderPhase3();
    }

    function renderPhase3() {
        // 1. Битовая шина (8 ячеек)
        p3BitBar.innerHTML = '';
        for (let b = 1; b <= 8; b++) {
            const active = b <= p3State.chosenBits;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.dataset.bitIndex = String(b);
            btn.className = `btn rounded-0 fw-bold ${
                active ? 'btn-success text-dark' : 'btn-outline-secondary text-light'
            }`;
            btn.style.minWidth = '48px';
            btn.style.minHeight = '48px';
            btn.textContent = `b${b}`;
            p3BitBar.appendChild(btn);
        }
        p3BitsBadge.textContent = `Выбрано: ${p3State.chosenBits} бит`;

        // 2. Сетка байт 1 записи (14 ячеек)
        p3ByteGrid.innerHTML = '';
        for (let byteIdx = 1; byteIdx <= 14; byteIdx++) {
            const active = byteIdx <= p3State.chosenRecordBytes;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.dataset.byteIndex = String(byteIdx);
            btn.className = `btn rounded-0 fw-bold ${
                active ? 'btn-warning text-dark border-warning' : 'btn-outline-secondary text-light'
            }`;
            btn.style.minWidth = '48px';
            btn.style.minHeight = '48px';
            btn.textContent = `${byteIdx}Б`;
            p3ByteGrid.appendChild(btn);
        }
        p3BytesBadge.textContent = `Выбрано: ${p3State.chosenRecordBytes} байт`;

        // 3. Калибратор
        p3TotalSlider.value = String(p3State.chosenTotalBytes);
        p3TotalBadge.textContent = `${p3State.chosenTotalBytes} байт`;

        p3SubmitBtn.disabled = (
            p3State.chosenBits === 0 ||
            p3State.chosenRecordBytes === 0 ||
            p3State.chosenTotalBytes === 0
        );
    }

    function adjustTotalBytes(delta) {
        if (isProcessingError) return;
        const next = Math.max(0, Math.min(p3State.sliderMax, p3State.chosenTotalBytes + delta));
        p3State.chosenTotalBytes = next;
        renderPhase3();
    }

    p3BitBar.addEventListener('click', (e) => {
        if (isProcessingError) return;
        const btn = e.target.closest('button[data-bit-index]');
        if (!btn) return;
        p3State.chosenBits = Number(btn.dataset.bitIndex);
        renderPhase3();
    });

    p3ByteGrid.addEventListener('click', (e) => {
        if (isProcessingError) return;
        const btn = e.target.closest('button[data-byte-index]');
        if (!btn) return;
        p3State.chosenRecordBytes = Number(btn.dataset.byteIndex);
        renderPhase3();
    });

    p3TotalSlider.addEventListener('input', () => {
        if (isProcessingError) return;
        p3State.chosenTotalBytes = Number(p3TotalSlider.value);
        p3TotalBadge.textContent = `${p3State.chosenTotalBytes} байт`;
        p3SubmitBtn.disabled = (
            p3State.chosenBits === 0 ||
            p3State.chosenRecordBytes === 0 ||
            p3State.chosenTotalBytes === 0
        );
    });

    p3Dec10Btn.addEventListener('click', () => adjustTotalBytes(-10));
    p3Dec1Btn.addEventListener('click', () => adjustTotalBytes(-1));
    p3Inc1Btn.addEventListener('click', () => adjustTotalBytes(1));
    p3Inc10Btn.addEventListener('click', () => adjustTotalBytes(10));

    p3ResetBtn.addEventListener('click', () => {
        if (isProcessingError) return;
        p3State.chosenBits = 0;
        p3State.chosenRecordBytes = 0;
        p3State.chosenTotalBytes = 0;
        renderPhase3();
    });

    p3SubmitBtn.addEventListener('click', () => {
        if (isProcessingError) return;
        if (p3State.chosenBits !== p3State.expectedBits) {
            triggerFailure(
                `Ошибка в разрядности символа: для алфавита N = ${p3State.N} выбрано ${p3State.chosenBits} бит.`,
                generatePhase3
            );
            return;
        }
        if (p3State.chosenRecordBytes !== p3State.expectedRecordBytes) {
            triggerFailure(
                `Ошибка в размере 1 записи: ${p3State.K} × ${p3State.expectedBits} бит округляются вверх до целого числа байт + ${p3State.extraBytes} Б заголовка.`,
                generatePhase3
            );
            return;
        }
        if (p3State.chosenTotalBytes !== p3State.expectedTotalBytes) {
            triggerFailure(
                `Ошибка в итоговом объеме: для ${p3State.M} записей по ${p3State.expectedRecordBytes} байт задано ${p3State.chosenTotalBytes} байт.`,
                generatePhase3
            );
            return;
        }
        showVictory();
    });

    // Запуск Фазы 1
    generatePhase1();
})();
</script>
