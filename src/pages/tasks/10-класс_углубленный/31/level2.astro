---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={2}>
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Шапка тренажера -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h4 text-warning mb-0">Тренажер: Аналитические расчеты и мера Хартли (Уровень 2)</h2>
            <span class="badge border border-warning text-warning bg-dark rounded-0 px-3 py-2">Ручной ввод // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-warning rounded-0">
            <div class="card-body p-3 p-md-4">

                <!-- Заголовок фазы и телеметрия -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="phase-badge" class="badge bg-warning text-dark rounded-0 fs-6 me-2">Шаг 1 из 5</span>
                        <span id="phase-title" class="text-light fw-bold fs-6">Прямой расчет объема сообщения</span>
                    </div>
                    <div class="text-secondary small">
                        Ошибки: <span id="attempts-display" class="text-warning">0</span> | Время: <span id="timer-display" class="text-info">00:00</span>
                    </div>
                </div>

                <!-- Системный баннер ошибки -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <span>[ОШИБКА РАСЧЕТА] <span id="feedback-text">Неверный ответ!</span> Генерируется новый вариант...</span>
                        <span class="spinner-border spinner-border-sm text-danger flex-shrink-0" role="status"></span>
                    </div>
                </div>

                <!-- ==================== ФАЗА 1: ПРЯМОЙ РАСЧЕТ (CCS = 4) ==================== -->
                <div id="phase1" class="phase-container">
                    <p class="text-light mb-2">
                        Определите информационный объем текстового документа при равномерном посимвольном двоичном кодировании.
                    </p>
                    <div id="p1-condition" class="card bg-black border-secondary rounded-0 p-3 mb-3 text-light">
                        <!-- Генерируется JS -->
                    </div>
                    <div class="mb-3 w-100" style="max-width: 580px;">
                        <label for="p1-input" class="form-label text-warning small text-uppercase">
                            Введите информационный объем документа в БАЙТАХ:
                        </label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" id="p1-input" class="form-control rounded-0 bg-black text-warning border-secondary font-monospace" placeholder="Например: 640" autocomplete="off" style="min-height: 48px;">
                            <button id="p1-submit-btn" type="button" class="btn btn-warning rounded-0 fw-bold px-4" style="min-height: 48px;">Проверить</button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ФАЗА 2: КОНВЕРТАЦИЯ ЕДИНИЦ И СКОРОСТИ (CCS = 6) ==================== -->
                <div id="phase2" class="phase-container d-none">
                    <p class="text-light mb-2">
                        Расчет времени передачи файла по цифровому каналу связи с переводом единиц информации и времени.
                    </p>
                    <div id="p2-condition" class="card bg-black border-secondary rounded-0 p-3 mb-3 text-light">
                        <!-- Генерируется JS -->
                    </div>
                    <div class="mb-3 w-100" style="max-width: 580px;">
                        <label for="p2-input" class="form-label text-warning small text-uppercase">
                            Введите время передачи файла в МИНУТАХ (допускается десятичная запятая):
                        </label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" id="p2-input" class="form-control rounded-0 bg-black text-warning border-secondary font-monospace" placeholder="Например: 1,5" autocomplete="off" style="min-height: 48px;">
                            <button id="p2-submit-btn" type="button" class="btn btn-warning rounded-0 fw-bold px-4" style="min-height: 48px;">Проверить</button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ФАЗА 3: ПИК ИНВЕРСИИ / ОБРАТНАЯ ЗАДАЧА ХАРТЛИ (CCS = 7-8) ==================== -->
                <div id="phase3" class="phase-container d-none">
                    <p class="text-light mb-2">
                        Обратная задача алфавитного подхода: восстановление предельной мощности алфавита по ограничению памяти.
                    </p>
                    <div id="p3-condition" class="card bg-black border-secondary rounded-0 p-3 mb-3 text-light">
                        <!-- Генерируется JS -->
                    </div>
                    <div class="mb-3 w-100" style="max-width: 580px;">
                        <label for="p3-input" class="form-label text-warning small text-uppercase">
                            Введите максимально возможную мощность алфавита N<sub>max</sub> (целое число символов):
                        </label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" id="p3-input" class="form-control rounded-0 bg-black text-warning border-secondary font-monospace" placeholder="Например: 32" autocomplete="off" style="min-height: 48px;">
                            <button id="p3-submit-btn" type="button" class="btn btn-warning rounded-0 fw-bold px-4" style="min-height: 48px;">Проверить</button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ФАЗА 4: ДОЛИНА КОНСОЛИДАЦИИ / БЛОЧНОЕ КОДИРОВАНИЕ ХАРТЛИ (CCS = 5-6) ==================== -->
                <div id="phase4" class="phase-container d-none">
                    <p class="text-light mb-2">
                        Исследование логарифмической меры Хартли: оптимизация передачи данных за счет группировки (блочного кодирования) символов.
                    </p>
                    <div id="p4-condition" class="card bg-black border-secondary rounded-0 p-3 mb-3 text-light">
                        <!-- Генерируется JS -->
                    </div>
                    <div class="mb-3 w-100" style="max-width: 580px;">
                        <label for="p4-input" class="form-label text-warning small text-uppercase">
                            Введите минимальное целое число БИТ для кодирования одного такого блока:
                        </label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" id="p4-input" class="form-control rounded-0 bg-black text-warning border-secondary font-monospace" placeholder="Целое число бит" autocomplete="off" style="min-height: 48px;">
                            <button id="p4-submit-btn" type="button" class="btn btn-warning rounded-0 fw-bold px-4" style="min-height: 48px;">Проверить</button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ФАЗА 5: КУЛЬМИНАЦИЯ / БАЗА ДАННЫХ И ПОБАЙТНОЕ ВЫРАВНИВАНИЕ (CCS = 8-9) ==================== -->
                <div id="phase5" class="phase-container d-none">
                    <p class="text-light mb-2">
                        Проектирование хранилища учетных записей (профиль ЕГЭ): составной алфавит, побайтное выравнивание каждой записи и перевод в Килобайты (1 Кбайт = 1024 байта).
                    </p>
                    <div id="p5-condition" class="card bg-black border-secondary rounded-0 p-3 mb-3 text-light">
                        <!-- Генерируется JS -->
                    </div>
                    <div class="mb-3 w-100" style="max-width: 580px;">
                        <label for="p5-input" class="form-label text-warning small text-uppercase">
                            Введите необходимый объем памяти в КБАЙТАХ (допускается десятичная запятая):
                        </label>
                        <div class="input-group">
                            <input type="text" inputmode="decimal" id="p5-input" class="form-control rounded-0 bg-black text-warning border-secondary font-monospace" placeholder="Например: 2,75" autocomplete="off" style="min-height: 48px;">
                            <button id="p5-submit-btn" type="button" class="btn btn-warning rounded-0 fw-bold px-4" style="min-height: 48px;">Завершить</button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ЭКРАН ПОБЕДЫ ==================== -->
                <div id="victory-screen" class="text-center py-4 d-none">
                    <div class="display-5 text-warning mb-3">✔ УРОВЕНЬ 2 ВЫПОЛНЕН</div>
                    <p class="lead text-light mb-3">
                        Все 5 фаз аналитической кривой Sawtooth пройдены: от прямого алфавитного расчета и конвертации скоростей до обратной задачи Хартли, блочного кодирования и побайтного выравнивания БД!
                    </p>
                    <div class="card bg-black border-warning rounded-0 p-3 mx-auto mb-4" style="max-width: 520px;">
                        <div class="d-flex justify-content-around text-center">
                            <div>
                                <div class="text-secondary small">ПРОЙДЕНО ФАЗ</div>
                                <div class="fs-4 fw-bold text-warning">5 / 5</div>
                            </div>
                            <div>
                                <div class="text-secondary small">ОШИБОК И СБОЕВ</div>
                                <div id="final-attempts" class="fs-4 fw-bold text-danger">0</div>
                            </div>
                            <div>
                                <div class="text-secondary small">ИТОГОВОЕ ВРЕМЯ</div>
                                <div id="final-time" class="fs-4 fw-bold text-info">00:00</div>
                            </div>
                        </div>
                    </div>
                    <span class="badge bg-warning text-dark rounded-0 px-4 py-2 fs-6">
                        Уровень 2 успешно зафиксирован в системе телеметрии.
                    </span>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(function() {
    let currentPhase = 1;
    let isProcessingError = false;
    let timerInterval = null;

    const telemetry = window.LMSTelemetry.create({
        missionName: 'Урок 31 :: Единицы измерения количества информации. Алфавитный подход к оценке количества информации (Уровень 2)',
        level: 2,
        totalStages: 5
    });

    const attemptsDisplay = document.getElementById('attempts-display');
    const timerDisplay = document.getElementById('timer-display');
    const phaseBadge = document.getElementById('phase-badge');
    const phaseTitle = document.getElementById('phase-title');
    const feedbackBox = document.getElementById('feedback-box');
    const feedbackText = document.getElementById('feedback-text');

    function randInt(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    function pickRandom(arr) {
        return arr[Math.floor(Math.random() * arr.length)];
    }

    function formatTime(sec) {
        const m = String(Math.floor(sec / 60)).padStart(2, '0');
        const s = String(sec % 60).padStart(2, '0');
        return `${m}:${s}`;
    }

    // Нормализация ввода: убираем %, пробелы, заменяем русскую запятую на точку
    function parseUserNum(val) {
        if (val === null || val === undefined) return NaN;
        const normalized = String(val).replace(/%/g, '').replace(/\s+/g, '').replace(',', '.');
        if (!normalized || !/^[+-]?\d+(?:\.\d+)?$/.test(normalized)) return NaN;
        const num = Number(normalized);
        return Number.isFinite(num) ? num : NaN;
    }

    timerInterval = setInterval(() => {
        if (timerDisplay) timerDisplay.textContent = formatTime(telemetry.getTimeSpentSec());
    }, 1000);

    function triggerFailure(message, resetCallback) {
        if (isProcessingError) return;
        isProcessingError = true;
        telemetry.fail({ stage: currentPhase, total_stages: 5 });
        if (attemptsDisplay) attemptsDisplay.textContent = String(telemetry.getState().attemptsCount);
        if (feedbackText) feedbackText.textContent = message;
        if (feedbackBox) feedbackBox.classList.remove('d-none');

        setTimeout(() => {
            if (feedbackBox) feedbackBox.classList.add('d-none');
            isProcessingError = false;
            resetCallback();
        }, 1300);
    }

    const PHASE_TITLES = {
        1: 'Прямой расчет объема сообщения',
        2: 'Конвертация единиц и пропускная способность',
        3: 'Пик 1: Обратная задача Хартли',
        4: 'Долина консолидации: Блочное кодирование',
        5: 'Кульминация: Побайтное выравнивание БД'
    };

    function switchToPhase(nextPhase) {
        document.getElementById(`phase${currentPhase}`).classList.add('d-none');
        currentPhase = nextPhase;
        telemetry.advanceStage(nextPhase);
        document.getElementById(`phase${nextPhase}`).classList.remove('d-none');
        phaseBadge.textContent = `Шаг ${nextPhase} из 5`;
        phaseTitle.textContent = PHASE_TITLES[nextPhase];

        if (nextPhase === 2) generatePhase2();
        else if (nextPhase === 3) generatePhase3();
        else if (nextPhase === 4) generatePhase4();
        else if (nextPhase === 5) generatePhase5();
    }

    function showVictory() {
        document.getElementById('phase5').classList.add('d-none');
        if (timerInterval) clearInterval(timerInterval);
        telemetry.complete({ stage: 5, total_stages: 5 });
        document.getElementById('final-attempts').textContent = String(telemetry.getState().attemptsCount);
        document.getElementById('final-time').textContent = formatTime(telemetry.getTimeSpentSec());
        document.getElementById('victory-screen').classList.remove('d-none');
        phaseBadge.textContent = 'Завершено';
        phaseTitle.textContent = 'Все 5 фаз выполнены';
    }

    // =========================================================================
    // ФАЗА 1: ПРЯМОЙ РАСЧЕТ ОБЪЕМА (CCS = 4)
    // =========================================================================
    const p1Condition = document.getElementById('p1-condition');
    const p1Input = document.getElementById('p1-input');
    const p1SubmitBtn = document.getElementById('p1-submit-btn');
    let p1ExpectedBytes = 0;

    function generatePhase1() {
        const i = pickRandom([4, 5, 6, 7]);
        const lo = (1 << (i - 1)) + 1;
        const hi = 1 << i;
        const N = pickRandom([lo, hi, randInt(lo, hi)]);

        const pages = randInt(2, 5);
        const lines = pickRandom([16, 20, 24, 32, 40]);
        const chars = pickRandom([25, 32, 40, 50, 64]);
        const totalChars = pages * lines * chars;
        // Поскольку lines или chars содержат множитель 8 или 16, totalChars всегда кратно 8
        const bytes = (totalChars * i) / 8;

        p1ExpectedBytes = bytes;
        p1Condition.innerHTML = `
            <div class="small text-secondary text-uppercase mb-1">Параметры документа:</div>
            <ul class="mb-0 ps-3">
                <li>Мощность алфавита: <strong class="text-warning">N = ${N}</strong> символов</li>
                <li>Количество страниц: <strong class="text-warning">${pages}</strong></li>
                <li>Строк на каждой странице: <strong class="text-warning">${lines}</strong></li>
                <li>Символов в каждой строке: <strong class="text-warning">${chars}</strong></li>
            </ul>
        `;
        p1Input.value = '';
        p1Input.focus();
    }

    function checkPhase1() {
        if (isProcessingError) return;
        const val = parseUserNum(p1Input.value);
        if (!Number.isFinite(val)) {
            triggerFailure('Введите корректное целое число байт.', generatePhase1);
            return;
        }
        if (Math.abs(val - p1ExpectedBytes) > 1e-6) {
            triggerFailure(`Неверный объем (${val} Б). Проверьте вес символа i (2^i >= N) и перевод бит в байты (÷ 8).`, generatePhase1);
            return;
        }
        switchToPhase(2);
    }

    p1SubmitBtn.addEventListener('click', checkPhase1);
    p1Input.addEventListener('keydown', (e) => { if (e.key === 'Enter') checkPhase1(); });

    // =========================================================================
    // ФАЗА 2: КОНВЕРТАЦИЯ ЕДИНИЦ И СКОРОСТИ (CCS = 6)
    // =========================================================================
    const p2Condition = document.getElementById('p2-condition');
    const p2Input = document.getElementById('p2-input');
    const p2SubmitBtn = document.getElementById('p2-submit-btn');
    let p2ExpectedMin = 0;

    function generatePhase2() {
        // Гарантируем точный конечный результат в минутах (шаг 0.1, 0.2, 0.25, 0.5)
        const pool = [
            { mb: 9, kbps: 512 },   // 9 * 1024 * 8 / 512 = 144 с = 2.4 мин
            { mb: 12, kbps: 1024 }, // 96 с = 1.6 мин
            { mb: 15, kbps: 1024 }, // 120 с = 2 мин
            { mb: 15, kbps: 512 },  // 240 с = 4 мин
            { mb: 6, kbps: 512 },   // 96 с = 1.6 мин
            { mb: 18, kbps: 1024 }, // 144 с = 2.4 мин
            { mb: 21, kbps: 1024 }, // 168 с = 2.8 мин
            { mb: 27, kbps: 2048 }, // 108 с = 1.8 мин
            { mb: 45, kbps: 2048 }, // 180 с = 3 мин
            { mb: 30, kbps: 2048 }, // 120 с = 2 мин
            { mb: 15, kbps: 2048 }, // 60 с = 1 мин
            { mb: 3, kbps: 256 },   // 96 с = 1.6 мин
            { mb: 6, kbps: 256 }    // 192 с = 3.2 мин
        ];
        const chosen = pickRandom(pool);
        const sec = (chosen.mb * 1024 * 8) / chosen.kbps;
        p2ExpectedMin = sec / 60;

        p2Condition.innerHTML = `
            <div class="small text-secondary text-uppercase mb-1">Параметры передачи по каналу:</div>
            <ul class="mb-0 ps-3">
                <li>Размер архива: <strong class="text-warning">${chosen.mb} Мбайт</strong> <span class="text-secondary">(1 Мбайт = 1024 Кбайт = 2<sup>20</sup> байт)</span></li>
                <li>Скорость передачи: <strong class="text-warning">${chosen.kbps} Кбит/с</strong> <span class="text-secondary">(1 Кбит/с = 1024 бит/с)</span></li>
            </ul>
        `;
        p2Input.value = '';
        p2Input.focus();
    }

    function checkPhase2() {
        if (isProcessingError) return;
        const val = parseUserNum(p2Input.value);
        if (!Number.isFinite(val)) {
            triggerFailure('Введите корректное число минут (например, 2,4).', generatePhase2);
            return;
        }
        if (Math.abs(val - p2ExpectedMin) > 1e-4) {
            triggerFailure(`Неверное время (${val} мин). Переведите Мбайт в Кбиты (× 1024 × 8), разделите на скорость и переведите секунды в минуты (÷ 60).`, generatePhase2);
            return;
        }
        switchToPhase(3);
    }

    p2SubmitBtn.addEventListener('click', checkPhase2);
    p2Input.addEventListener('keydown', (e) => { if (e.key === 'Enter') checkPhase2(); });

    // =========================================================================
    // ФАЗА 3: ПИК 1 — ОБРАТНАЯ ЗАДАЧА ХАРТЛИ (CCS = 7-8)
    // =========================================================================
    const p3Condition = document.getElementById('p3-condition');
    const p3Input = document.getElementById('p3-input');
    const p3SubmitBtn = document.getElementById('p3-submit-btn');
    let p3ExpectedN = 0;

    function generatePhase3() {
        const i = pickRandom([4, 5, 6, 7]);
        const pages = pickRandom([2, 4, 5, 8]);
        const lines = pickRandom([20, 25, 32, 40]);
        const chars = pickRandom([32, 40, 50, 64]);
        const K = pages * lines * chars;

        // Запас байт < K / 8, чтобы floor(I_bits / K) оставался строго равен i
        const baseBytes = (K * i) / 8;
        const maxExtraBytes = Math.floor((K - 1) / 8);
        const extraBytes = randInt(0, Math.min(maxExtraBytes, 60));
        const totalBytes = baseBytes + extraBytes;

        p3ExpectedN = 1 << i;

        p3Condition.innerHTML = `
            <div class="small text-secondary text-uppercase mb-1">Ограничение системы хранения:</div>
            <ul class="mb-0 ps-3">
                <li>Текст состоит из <strong class="text-warning">${pages}</strong> стр. × <strong class="text-warning">${lines}</strong> строк × <strong class="text-warning">${chars}</strong> символов</li>
                <li>Информационный объем текста не превышает <strong class="text-warning">${totalBytes} байт</strong></li>
                <li>Используется посимвольное равномерное двоичное кодирование</li>
            </ul>
        `;
        p3Input.value = '';
        p3Input.focus();
    }

    function checkPhase3() {
        if (isProcessingError) return;
        const val = parseUserNum(p3Input.value);
        if (!Number.isFinite(val)) {
            triggerFailure('Введите корректное целое число символов.', generatePhase3);
            return;
        }
        if (Math.abs(val - p3ExpectedN) > 1e-6) {
            triggerFailure(`Неверная мощность алфавита (${val}). Найдите i = floor(I_бит / K) и вычислите N_max = 2^i.`, generatePhase3);
            return;
        }
        switchToPhase(4);
    }

    p3SubmitBtn.addEventListener('click', checkPhase3);
    p3Input.addEventListener('keydown', (e) => { if (e.key === 'Enter') checkPhase3(); });

    // =========================================================================
    // ФАЗА 4: ДОЛИНА КОНСОЛИДАЦИИ — БЛОЧНОЕ КОДИРОВАНИЕ ХАРТЛИ (CCS = 5-6)
    // =========================================================================
    const p4Condition = document.getElementById('p4-condition');
    const p4Input = document.getElementById('p4-input');
    const p4SubmitBtn = document.getElementById('p4-submit-btn');
    let p4ExpectedBits = 0;

    function generatePhase4() {
        // Компактная арифметика, высокий концептуальный смысл (экономия по сравнению с B * ceil(log2(N)))
        const cases = [
            { N: 3, B: 3 },  // 27 <= 32 (5 бит вместо 6)
            { N: 3, B: 4 },  // 81 <= 128 (7 бит вместо 8)
            { N: 5, B: 2 },  // 25 <= 32 (5 бит вместо 6)
            { N: 5, B: 3 },  // 125 <= 128 (7 бит вместо 9)
            { N: 6, B: 2 },  // 36 <= 64 (6 бит)
            { N: 6, B: 3 },  // 216 <= 256 (8 бит вместо 9)
            { N: 7, B: 2 },  // 49 <= 64 (6 бит)
            { N: 9, B: 2 },  // 81 <= 128 (7 бит вместо 8)
            { N: 10, B: 2 }, // 100 <= 128 (7 бит вместо 8)
            { N: 10, B: 3 }, // 1000 <= 1024 (10 бит вместо 12)
            { N: 11, B: 2 }, // 121 <= 128 (7 бит вместо 8)
            { N: 12, B: 2 }  // 144 <= 256 (8 бит)
        ];
        const chosen = pickRandom(cases);
        const totalCombos = Math.pow(chosen.N, chosen.B);
        p4ExpectedBits = Math.ceil(Math.log2(totalCombos));

        p4Condition.innerHTML = `
            <div class="small text-secondary text-uppercase mb-1">Спецификация блочного кодера:</div>
            <ul class="mb-0 ps-3">
                <li>Мощность алфавита источника: <strong class="text-warning">N = ${chosen.N}</strong> равновероятных знаков</li>
                <li>Размер кодируемого блока (группы): <strong class="text-warning">${chosen.B}</strong> символа подряд</li>
                <li>Каждый блок кодируется отдельным равномерным двоичным словом минимальной длины</li>
            </ul>
        `;
        p4Input.value = '';
        p4Input.focus();
    }

    function checkPhase4() {
        if (isProcessingError) return;
        const val = parseUserNum(p4Input.value);
        if (!Number.isFinite(val)) {
            triggerFailure('Введите корректное целое число бит.', generatePhase4);
            return;
        }
        if (Math.abs(val - p4ExpectedBits) > 1e-6) {
            triggerFailure(`Неверно (${val} бит). Определите общее число различных блоков N^B и найдите минимальное k: 2^k >= N^B.`, generatePhase4);
            return;
        }
        switchToPhase(5);
    }

    p4SubmitBtn.addEventListener('click', checkPhase4);
    p4Input.addEventListener('keydown', (e) => { if (e.key === 'Enter') checkPhase4(); });

    // =========================================================================
    // ФАЗА 5: КУЛЬМИНАЦИЯ — БАЗА ДАННЫХ И ПОБАЙТНОЕ ВЫРАВНИВАНИЕ (CCS = 8-9)
    // =========================================================================
    const p5Condition = document.getElementById('p5-condition');
    const p5Input = document.getElementById('p5-input');
    const p5SubmitBtn = document.getElementById('p5-submit-btn');
    let p5ExpectedKB = 0;

    function generatePhase5() {
        let letters, digits, specials, N, i, K, codeBytes, extraBytes, recordBytes, M;
        while (true) {
            letters = pickRandom([12, 16, 20, 22, 23, 26]);
            digits = 10;
            specials = pickRandom([0, 3, 5, 7, 10, 15, 29]);
            N = letters + digits + specials;
            i = Math.ceil(Math.log2(N));
            if (i < 5 || i > 7) continue;

            K = randInt(7, 15);
            // Гарантируем необходимость округления до целого байта вверх
            if ((K * i) % 8 === 0) continue;

            codeBytes = Math.ceil((K * i) / 8);
            extraBytes = randInt(4, 15);
            recordBytes = codeBytes + extraBytes;

            // M = 256 или 512 или 1280, чтобы деление на 1024 давало ровную конечную дробь (.25, .5, .75)
            M = pickRandom([256, 512, 1280]);
            if ((M * recordBytes) % 256 === 0) break;
        }

        p5ExpectedKB = (M * recordBytes) / 1024;

        const alphaParts = [`<strong>${letters}</strong> заглавных латинских букв`, `<strong>${digits}</strong> цифр`];
        if (specials > 0) alphaParts.push(`<strong>${specials}</strong> специальных символов`);

        p5Condition.innerHTML = `
            <div class="small text-secondary text-uppercase mb-1">Техническое задание базы данных:</div>
            <ul class="mb-0 ps-3">
                <li>Количество зарегистрированных пользователей: <strong class="text-warning">${M}</strong></li>
                <li>Длина идентификатора: <strong class="text-warning">${K} символов</strong> (допустимы: ${alphaParts.join(', ')})</li>
                <li>В базе данных каждый символ идентификатора кодируется минимальным одинаковым числом бит, а сам идентификатор занимает <strong class="text-warning">минимальное возможное целое число байт</strong></li>
                <li>Дополнительные сведения о каждом пользователе занимают <strong class="text-warning">${extraBytes} байт</strong></li>
            </ul>
        `;
        p5Input.value = '';
        p5Input.focus();
    }

    function checkPhase5() {
        if (isProcessingError) return;
        const val = parseUserNum(p5Input.value);
        if (!Number.isFinite(val)) {
            triggerFailure('Введите корректное число Кбайт (допускается десятичная запятая).', generatePhase5);
            return;
        }
        if (Math.abs(val - p5ExpectedKB) > 1e-4) {
            triggerFailure(`Неверный объем (${val} Кбайт). Проверьте: i бит (2^i >= N) -> байты на код (округление вверх) + доп. байты -> × M / 1024.`, generatePhase5);
            return;
        }
        showVictory();
    }

    p5SubmitBtn.addEventListener('click', checkPhase5);
    p5Input.addEventListener('keydown', (e) => { if (e.key === 'Enter') checkPhase5(); });

    // Запуск Фазы 1
    generatePhase1();
})();
</script>
