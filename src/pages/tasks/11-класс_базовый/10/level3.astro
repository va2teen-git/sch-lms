        setTimeout(() => playTone(783.99, 'triangle', 0.12, 0.16), 110);
        setTimeout(() => playTone(1046.5, 'triangle', 0.28, 0.18), 220);
    }

    function playAlarmSound() {
        playTone(520, 'sawtooth', 0.18, 0.2);
