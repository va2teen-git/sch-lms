        },
        {
            waveNum: 5, mode: 'shortest', nodeCount: 6, directed: false, showMatrix: false,
            useHoneypot: true, useRequired: false, timeLimit: 24.0,
            domain: 'Социология // Модель «Шесть рукопожатий»',
            title: 'Передача сигнала в обход скомпрометированного узла',
