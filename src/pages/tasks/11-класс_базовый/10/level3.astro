---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={3}>
    <div id="vue-app" class="container-fluid px-2 px-md-3 my-3 font-monospace" v-cloak>

        <!-- Верхняя строка заголовка -->
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h2 class="h5 text-danger mb-0 fw-bold">Тренажёр: Оперативный навигатор графов // ICE Node Race</h2>
                <span class="text-secondary small">Параллель 11 (Базовый / Гуманитарный) // Урок 10 // Уровень 3 (Аркада)</span>
            </div>
            <span class="badge border border-danger text-danger bg-black rounded-0 px-3 py-2">
                Архетип 7: ICE Node Race &amp; DAG // Хардкор-сброс
            </span>
        </div>

        <!-- Главный контейнер тренажёра -->
        <div class="card bg-black border border-danger rounded-0 shadow-lg">
            <div class="card-body p-3 p-md-4">

                <!-- ========================================== -->
                <!-- 1. СТАРТОВЫЙ ЭКРАН (INTRO / БРИФИНГ)       -->
                <!-- ========================================== -->
                <div v-if="gameState === 'intro'" class="text-center py-4">
                    <div class="mb-3">
                        <span class="badge bg-danger text-black rounded-0 fs-5 px-4 py-2 fw-bold">
                            ШЛЮЗ ГРАФОВОЙ МАРШРУТИЗАЦИИ [ОЖИДАНИЕ ЗАПУСКА]
                        </span>
                    </div>

                    <h3 class="text-light fw-bold mb-3">Аркадное испытание: Прорыв через сеть под давлением ICE</h3>
                    <p class="text-secondary mb-4 mx-auto" style="max-width: 740px;">
                        Вы управляете диспетчерским импульсом в <strong>10 процедурных волнах</strong> прикладных графов:
                        городская логистика, матричные транспортные узлы, сети цитирований (Digital Humanities),
                        стемматика рукописей и гиперссылочные орграфы.
                    </p>

                    <div class="card bg-dark border border-secondary rounded-0 p-3 mx-auto mb-4 text-start small" style="max-width: 760px;">
                        <div class="text-danger fw-bold fs-6 mb-2">[ПРОТОКОЛ УПРАВЛЕНИЯ И ТАЙМИНГА // 10 ВОЛН]:</div>
                        <ul class="mb-2 ps-3 text-secondary">
                            <li class="mb-2">
                                <strong class="text-info">[1] Кратчайший путь (Волны 1, 2, 4, 5, 7, 8, 10):</strong>
                                Кликайте по смежным вершинам графа (диаметр ≥ 52 px или клавиши <code>1</code>..<code>6</code>) от <strong class="text-info">А</strong> к целевому узлу.
                                В матричных волнах веса рёбер на схеме скрыты (<code>?</code>) — считывайте их напрямую из <strong>Весовой матрицы</strong> справа!
                            </li>
                            <li class="mb-2">
                                <strong class="text-warning">[2] Каскад путей DAG (Волны 3, 6, 9):</strong>
                                Рассчитайте точное число маршрутов от <strong class="text-info">А</strong> до цели, настройте импульс на целевом узле
                                кнопками <code>-5</code>/<code>-1</code>/<code>+1</code>/<code>+5</code> (или <code>←</code>/<code>→</code>) и кликните по целевому узлу для запуска (<code>ПРОБЕЛ</code> / <code>Enter</code>).
                            </li>
                            <li class="mb-2">
                                <strong class="text-light">[3] Ограничители сети:</strong>
                                Избегайте красных узлов <strong class="text-danger">ЛОВУШКА / БЛОК</strong> и обязательно проходите через зелёный узел <strong class="text-success">РЕЛЕ</strong>, если он активен.
                            </li>
                            <li class="mb-1">
                                <strong class="text-secondary">[4] Быстрые клавиши:</strong>
                                <code>1</code>..<code>7</code> — переход в узел, <code>Backspace</code> — шаг назад, <code>←</code>/<code>→</code> — счётчик DAG, <code>ПРОБЕЛ</code>/<code>Enter</code> — форсаж-пуск.
                            </li>
                        </ul>
                        <div class="alert alert-danger bg-black text-danger border border-danger rounded-0 mb-0 py-2 px-3 small">
                            <strong>ХАРДКОР-СБРОС:</strong> Неоптимальный маршрут, шаг в ловушку, неверный счётчик DAG или перехват антивирусом ICE (тайм-аут) запускают сирену (<code>#alarm-box</code>) и <strong>СБРАСЫВАЮТ ПРОГРЕСС НА ВОЛНУ 1</strong> с перегенерацией графов!
                        </div>
                    </div>

                    <div>
                        <button id="start-btn" type="button" @click="startGame" class="btn btn-danger rounded-0 px-5 py-3 fw-bold fs-5 text-black shadow" style="min-height: 48px;">
                            НАЧАТЬ ОПЕРАЦИЮ (ВОЛНА 1) →
                        </button>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- 2. ИГРОВОЙ ЭКРАН (PLAYING)                -->
                <!-- ========================================== -->
                <div v-else-if="gameState === 'playing'">

                    <!-- Шапка волны и таймера -->
                    <div class="d-flex justify-content-between align-items-center mb-2 border-bottom border-secondary pb-2 flex-wrap gap-2">
                        <div>
                            <span id="phase-counter" class="badge bg-danger text-black rounded-0 fs-6 me-2">
                                ВОЛНА <span v-text="currentWave"></span> / <span v-text="totalWaves"></span>
                            </span>
                            <span class="text-light fw-bold small" v-text="currentWaveData.title"></span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge border rounded-0 px-2 py-1"
                                  :class="currentWaveData.mode === 'dag' ? 'border-warning text-warning bg-dark' : 'border-info text-info bg-dark'"
                                  v-text="currentWaveData.mode === 'dag' ? 'РЕЖИМ: ПОДСЧЁТ ПУТЕЙ DAG' : 'РЕЖИМ: КРАТЧАЙШИЙ МАРШРУТ'">
                            </span>
                            <span class="text-secondary small">
                                Сбросы: <span class="text-warning fw-bold" v-text="attempts"></span>
                            </span>
                            <span id="timer-display" class="badge border border-danger bg-black rounded-0 fs-6"
                                  :class="phaseTimeLeft <= 5.0 ? 'text-danger' : 'text-warning'">
                                <span v-text="phaseTimeLeft.toFixed(1)"></span> с
                            </span>
                        </div>
                    </div>

                    <!-- Полоса таймера -->
                    <div class="progress bg-dark border border-secondary rounded-0 mb-2" style="height: 8px;">
                        <div class="progress-bar"
                             :class="phaseTimeLeft <= 5.0 ? 'bg-danger' : 'bg-info'"
                             role="progressbar"
                             :style="progressBarStyle">
                        </div>
                    </div>

                    <!-- Фронт антивируса ICE (реактивно отражает остаток времени волны) -->
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-3 px-2 py-1 bg-dark border border-secondary rounded-0 small">
                        <span class="text-danger fw-bold">ФРОНТ ПЕРЕХВАТА ICE:</span>
                        <div class="d-flex gap-1 flex-grow-1">
                            <div v-for="seg in 6" :key="seg"
                                 class="flex-fill rounded-0 border"
                                 style="height: 10px;"
                                 :class="seg <= iceLevel ? 'bg-danger border-danger' : 'bg-black border-secondary opacity-50'">
                            </div>
                        </div>
                        <span class="text-secondary" v-text="iceStatusText"></span>
                    </div>

                    <!-- Аварийная сирена (#alarm-box) -->
                    <div v-if="alarmActive" id="alarm-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 py-3 text-center shadow mb-3">
                        <div class="fs-5 fw-bold mb-1">🚨 ТРЕВОГА ICE // ХАРДКОР-СБРОС МАРШРУТИЗАЦИИ 🚨</div>
                        <div class="small text-light mb-2" v-text="alarmReason"></div>
                        <div class="badge bg-danger text-black rounded-0 fs-6 px-3 py-1 fw-bold">
                            ВОЗВРАТ НА ВОЛНУ 1 И ПЕРЕГЕНЕРАЦИЯ ГРАФОВ (Сбой #<span id="alarm-count" v-text="attempts"></span>)
                        </div>
                    </div>

                    <!-- Карточка директивы волны и ограничителей -->
                    <div class="card bg-dark border-secondary rounded-0 p-2 p-md-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <div class="text-warning fw-bold small" v-text="currentWaveData.domain"></div>
                                <div class="text-light small" v-text="currentWaveData.directive"></div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <span v-if="currentWaveData.directed" class="badge bg-black border border-info text-info rounded-0 px-2 py-1">
                                    ОРГРАФ (→)
                                </span>
                                <span v-if="currentWaveData.showMatrix" class="badge bg-black border border-warning text-warning rounded-0 px-2 py-1">
                                    ВЕСА В МАТРИЦЕ
                                </span>
                                <span v-if="currentWaveData.honeypotNode !== null" class="badge bg-black border border-danger text-danger rounded-0 px-2 py-1">
                                    ЛОВУШКА: <span v-text="getNodeName(currentWaveData.honeypotNode)"></span>
                                </span>
                                <span v-if="currentWaveData.forbiddenNode !== null" class="badge bg-black border border-danger text-danger rounded-0 px-2 py-1">
                                    БЛОК: <span v-text="getNodeName(currentWaveData.forbiddenNode)"></span>
                                </span>
                                <span v-if="currentWaveData.requiredNode !== null" class="badge bg-black border border-success text-success rounded-0 px-2 py-1">
                                    РЕЛЕ: <span v-text="getNodeName(currentWaveData.requiredNode)"></span>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Основная рабочая зона: SVG-граф + (опциональная Весовая матрица) -->
                    <div class="row g-2 g-md-3 align-items-stretch mb-3">
                        <div :class="currentWaveData.showMatrix ? 'col-12 col-lg-7' : 'col-12'">
                            <div class="card bg-dark border-secondary rounded-0 p-2 h-100">
                                <div class="d-flex justify-content-between align-items-center small mb-1 px-1 flex-wrap gap-1">
                                    <span class="text-secondary">
                                        <span v-if="currentWaveData.mode === 'dag'">
                                            СХЕМА DAG: клик по цели <strong class="text-warning" v-text="getNodeName(currentWaveData.targetId)"></strong> запускает импульс
                                        </span>
                                        <span v-else>
                                            СХЕМА СЕТИ: кликайте по смежным узлам от <strong class="text-info">А</strong> к <strong class="text-warning" v-text="getNodeName(currentWaveData.targetId)"></strong>
                                        </span>
                                    </span>
                                    <span v-if="currentWaveData.mode === 'shortest'" class="text-info fw-bold">
                                        Текущий узел: <span v-text="getNodeName(currentNode)"></span> | Накопленный вес: <span v-text="currentCost"></span>
                                    </span>
                                    <span v-else class="text-warning fw-bold">
                                        Импульсов настроено: <span v-text="dagGuess"></span>
                                    </span>
                                </div>

                                <!-- Интерактивный SVG-граф -->
                                <div class="bg-black border border-secondary rounded-0 p-1">
                                    <svg viewBox="0 0 640 340" class="w-100 d-block" style="max-height: 360px; user-select: none;">
                                        <defs>
                                            <marker id="arrow-dim" markerWidth="10" markerHeight="10" refX="26" refY="3.5" orient="auto">
                                                <polygon points="0 0, 9 3.5, 0 7" fill="#6c757d"></polygon>
                                            </marker>
                                            <marker id="arrow-active" markerWidth="10" markerHeight="10" refX="26" refY="3.5" orient="auto">
                                                <polygon points="0 0, 9 3.5, 0 7" fill="#0dcaf0"></polygon>
                                            </marker>
                                            <marker id="arrow-avail" markerWidth="10" markerHeight="10" refX="26" refY="3.5" orient="auto">
                                                <polygon points="0 0, 9 3.5, 0 7" fill="#ffc107"></polygon>
                                            </marker>
                                            <marker id="arrow-dag" markerWidth="10" markerHeight="10" refX="26" refY="3.5" orient="auto">
                                                <polygon points="0 0, 9 3.5, 0 7" fill="#0dcaf0"></polygon>
                                            </marker>
                                        </defs>

                                        <!-- Рёбра и дуги графа -->
                                        <g v-for="(edge, idx) in renderedEdges" :key="'e-' + idx">
                                            <path :d="edge.pathD"
                                                  fill="none"
                                                  :stroke="edge.stroke"
                                                  :stroke-width="edge.strokeWidth"
                                                  :stroke-dasharray="edge.dashed ? '6 4' : null"
                                                  :marker-end="currentWaveData.directed || currentWaveData.mode === 'dag' ? edge.markerEnd : null"
                                                  style="transition: stroke 200ms ease, stroke-width 200ms ease;"></path>

                                            <!-- Подпись веса ребра (только в shortest-волнах; ? если веса скрыты в матрице) -->
                                            <g v-if="currentWaveData.mode === 'shortest'" :transform="`translate(${edge.labelX}, ${edge.labelY})`">
                                                <rect x="-15" y="-11" width="30" height="22"
                                                      :fill="edge.isOnPath ? '#082c36' : '#0b0c10'"
                                                      :stroke="edge.isOnPath ? '#0dcaf0' : '#495057'"
                                                      stroke-width="1.2"></rect>
                                                <text x="0" y="4" text-anchor="middle" font-size="12" font-weight="bold"
                                                      :fill="edge.isOnPath ? '#0dcaf0' : (currentWaveData.showMatrix ? '#adb5bd' : '#ffc107')">
                                                    {{ currentWaveData.showMatrix ? '?' : edge.w }}
                                                </text>
                                            </g>
                                        </g>

                                        <!-- Вершины графа (хитбоксы r=28 => диаметр 56px >= 48px) -->
                                        <g v-for="node in currentWaveData.nodes" :key="'n-' + node.id"
                                           @click="handleNodeClick(node.id)"
                                           :style="{ cursor: isNodeInteractive(node.id) ? 'pointer' : 'default' }">
                                            <!-- Невидимый расширенный хитбокс >= 56x56 px -->
                                            <circle :cx="node.x" :cy="node.y" r="29" fill="transparent"></circle>

                                            <!-- Внешнее кольцо состояния / подсветки -->
                                            <circle v-if="getNodeState(node.id).ringStroke"
                                                    :cx="node.x" :cy="node.y" r="30"
                                                    fill="none"
                                                    :stroke="getNodeState(node.id).ringStroke"
                                                    stroke-width="2"
                                                    stroke-dasharray="4 3"></circle>

                                            <!-- Основной круг вершины (52px) -->
                                            <circle :cx="node.x" :cy="node.y" r="26"
                                                    :fill="getNodeState(node.id).fill"
                                                    :stroke="getNodeState(node.id).stroke"
                                                    stroke-width="2.8"
                                                    style="transition: fill 180ms ease, stroke 180ms ease;"></circle>

                                            <!-- Буква вершины -->
                                            <text :x="node.x" :y="node.y + 2" text-anchor="middle" dominant-baseline="middle"
                                                  font-size="18" font-weight="bold"
                                                  :fill="getNodeState(node.id).textColor">
                                                {{ node.label }}
                                            </text>

                                            <!-- Номер горячей клавиши -->
                                            <text :x="node.x - 20" :y="node.y - 21" text-anchor="middle" font-size="10" fill="#6c757d">
                                                [{{ node.id + 1 }}]
                                            </text>

                                            <!-- Бейдж роли узла (СТАРТ / ЦЕЛЬ / РЕЛЕ / БЛОК / ЛОВУШКА / число DAG) -->
                                            <g v-if="getNodeBadge(node.id)" :transform="`translate(${node.x}, ${node.y + 34})`">
                                                <rect x="-28" y="-9" width="56" height="16"
                                                      fill="#000000" :stroke="getNodeBadge(node.id).color" stroke-width="1"></rect>
                                                <text x="0" y="3" text-anchor="middle" font-size="9.5" font-weight="bold"
                                                      :fill="getNodeBadge(node.id).color">
                                                    {{ getNodeBadge(node.id).text }}
                                                </text>
                                            </g>
                                        </g>
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <!-- Весовая матрица (единственный Data Source, когда веса скрыты на SVG) -->
                        <div v-if="currentWaveData.showMatrix" class="col-12 col-lg-5">
                            <div class="card bg-dark border-warning rounded-0 p-2 h-100">
                                <div class="text-warning fw-bold small mb-2">
                                    ВЕСОВАЯ МАТРИЦА ПЕРЕХОДОВ
                                    <span class="text-secondary fw-normal">(строка → столбец)</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-dark table-bordered border-secondary table-sm text-center align-middle mb-2 small">
                                        <thead>
                                            <tr>
                                                <th class="bg-black text-secondary">из \ в</th>
                                                <th v-for="col in currentWaveData.nodes" :key="'mh-' + col.id"
                                                    class="bg-black"
                                                    :class="col.id === currentWaveData.targetId ? 'text-warning' : 'text-info'"
                                                    v-text="col.label">
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr v-for="(rowArr, rIdx) in currentWaveData.matrix" :key="'mr-' + rIdx">
                                                <th class="bg-black"
                                                    :class="rIdx === currentNode ? 'text-info border-info' : 'text-secondary'"
                                                    v-text="getNodeName(rIdx)">
                                                </th>
                                                <td v-for="(cellVal, cIdx) in rowArr" :key="'mc-' + rIdx + '-' + cIdx"
                                                    :class="getMatrixCellClass(rIdx, cIdx, cellVal)">
                                                    <span v-text="cellVal !== null ? cellVal : '—'"></span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="text-secondary small">
                                    Текущая строка подсвечена голубым; пройденные переходы отмечены по маршруту.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Нижняя панель управления под режим волны (все кнопки >= 48x48 px) -->
                    <div class="card bg-dark border-secondary rounded-0 p-2 p-md-3">
                        <div v-if="currentWaveData.mode === 'shortest'" class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="small text-light">
                                Маршрут:
                                <span v-for="(nid, idx) in playerPath" :key="'p-' + idx">
                                    <span v-if="idx > 0" class="text-secondary mx-1">→</span>
                                    <span class="badge bg-black border border-info text-info rounded-0" v-text="getNodeName(nid)"></span>
                                </span>
                            </div>
                            <div class="d-flex gap-2 flex-wrap">
                                <button id="step-back-btn" type="button" @click="stepBack"
                                        :disabled="playerPath.length <= 1 || isInputLocked"
                                        class="btn btn-outline-secondary rounded-0 fw-bold px-3"
                                        style="min-width: 120px; min-height: 48px;">
                                    ← ШАГ НАЗАД
                                </button>
                                <button id="fast-forward-btn" type="button" @click="fastForwardTarget"
                                        :disabled="!canFastForward || isInputLocked"
                                        class="btn btn-warning text-black rounded-0 fw-bold px-4"
                                        style="min-width: 180px; min-height: 48px;">
                                    ⚡ ЗАВЕРШИТЬ В {{ getNodeName(currentWaveData.targetId) }} [ПРОБЕЛ]
                                </button>
                            </div>
                        </div>

                        <div v-else class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="text-light small fw-bold me-1">ПУТЕЙ В {{ getNodeName(currentWaveData.targetId) }}:</span>
                                <button id="dag-minus5-btn" type="button" @click="adjustDag(-5)" :disabled="isInputLocked"
                                        class="btn btn-outline-danger rounded-0 fw-bold" style="min-width: 52px; min-height: 48px;">-5</button>
                                <button id="dag-minus1-btn" type="button" @click="adjustDag(-1)" :disabled="isInputLocked"
                                        class="btn btn-outline-warning rounded-0 fw-bold" style="min-width: 52px; min-height: 48px;">-1</button>
                                <span id="dag-guess-badge" class="badge bg-black border border-warning text-warning rounded-0 fs-4 px-4 py-2"
                                      style="min-width: 72px; min-height: 48px; line-height: 30px;" v-text="dagGuess"></span>
                                <button id="dag-plus1-btn" type="button" @click="adjustDag(1)" :disabled="isInputLocked"
                                        class="btn btn-outline-info rounded-0 fw-bold" style="min-width: 52px; min-height: 48px;">+1</button>
                                <button id="dag-plus5-btn" type="button" @click="adjustDag(5)" :disabled="isInputLocked"
                                        class="btn btn-outline-success rounded-0 fw-bold" style="min-width: 52px; min-height: 48px;">+5</button>
                            </div>
                            <button id="dag-submit-btn" type="button" @click="submitDagPulse" :disabled="isInputLocked"
                                    class="btn btn-warning text-black rounded-0 fw-bold px-4"
                                    style="min-width: 210px; min-height: 48px;">
                                ⚡ ПУСК ИМПУЛЬСА [ПРОБЕЛ]
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- 3. ЭКРАН ПОБЕДЫ (VICTORY)                  -->
                <!-- ========================================== -->
                <div v-else-if="gameState === 'victory'" class="text-center py-4">
                    <div class="mb-3">
                        <span class="badge bg-success text-black rounded-0 fs-5 px-4 py-2 fw-bold">
                            ПРОРЫВ СЕТИ ЗАВЕРШЁН // 10 ИЗ 10 ВОЛН ПРОЙДЕНО
                        </span>
                    </div>
                    <h3 class="text-light fw-bold mb-2">Антивирус ICE нейтрализован!</h3>
                    <p class="text-secondary mb-4 mx-auto" style="max-width: 640px;">
                        Вы безупречно решили все графовые задачи в условиях жёсткого таймера:
                        нашли оптимальные маршруты по схеме и весовой матрице и точно рассчитали каскады путей в DAG.
                    </p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap mb-4">
                        <div class="card bg-dark border border-success rounded-0 px-4 py-2">
                            <div class="text-secondary small">ВРЕМЯ ОПЕРАЦИИ</div>
                            <div class="text-success fs-4 fw-bold"><span v-text="finalTimeSec"></span> с</div>
                        </div>
                        <div class="card bg-dark border border-warning rounded-0 px-4 py-2">
                            <div class="text-secondary small">СБРОСЫ ICE</div>
                            <div class="text-warning fs-4 fw-bold" v-text="attempts"></div>
                        </div>
                    </div>
                    <button id="replay-btn" type="button" @click="startGame"
                            class="btn btn-outline-success rounded-0 fw-bold px-4 py-2" style="min-height: 48px;">
                        ПЕРЕЗАПУСТИТЬ АРКАДУ →
                    </button>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline src="/static/vue.global.js"></script>

<script is:inline>
(function () {
    const { createApp } = Vue;
    const NODE_LABELS = ['А', 'Б', 'В', 'Г', 'Д', 'Е', 'Ж'];

    // --- Звуковой синтез Web Audio API (без внешних аудиофайлов) ---
    let audioCtx = null;
    function getAudioCtx() {
        if (!audioCtx) {
            const Ctx = window.AudioContext || window.webkitAudioContext;
            if (Ctx) audioCtx = new Ctx();
        }
        return audioCtx;
    }

    function playTone(freq, type, duration, vol = 0.14) {
        try {
            const ctx = getAudioCtx();
            if (!ctx) return;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = type;
            osc.frequency.setValueAtTime(freq, ctx.currentTime);
            gain.gain.setValueAtTime(vol, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + duration);
        } catch (e) {}
    }

    function playStepSound() {
        playTone(620, 'sine', 0.08, 0.11);
    }

    function playSuccessSound() {
        playTone(784, 'sine', 0.11, 0.15);
