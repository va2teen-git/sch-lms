        },
        {
            waveNum: 6, mode: 'dag', nodeCount: 6, directed: true, showMatrix: false,
            useBanned: true, useRequired: false, timeLimit: 22.0,
            domain: 'Филология // Стемматика рукописей',
            title: 'Реконструкция путей переписывания с утраченной ветвью',
            directive: 'Подсчитайте количество путей от А к Е, исключая заблокированный узел (БЛОК).'
        },
        {
            waveNum: 7, mode: 'shortest', nodeCount: 6, directed: false, showMatrix: true,
            useHoneypot: false, useRequired: true, timeLimit: 24.0,
            domain: 'Архивное дело // Межбиблиотечный абонемент',
            title: 'Тактический транзит через обязательный фонд (Передышка)',
            directive: 'По Весовой матрице найдите кратчайший путь от А к Е, обязательно посетив узел РЕЛЕ.'
        },
        {
            waveNum: 8, mode: 'shortest', nodeCount: 6, directed: true, showMatrix: false,
            useHoneypot: false, useRequired: false, timeLimit: 20.0,
            domain: 'Веб-аналитика // Гиперссылочный граф сайтов',
            title: 'Односторонняя навигация по направленным дугам (→)',
            directive: 'Двигайтесь строго по стрелкам орграфа (→) и найдите кратчайший путь от А к Е.'
        },
        {
            waveNum: 9, mode: 'dag', nodeCount: 7, directed: true, showMatrix: false,
            useBanned: true, useRequired: true, timeLimit: 18.0,
            domain: 'Семантические сети // Фильтрация смыслов',
            title: 'Подсчёт траекторий с обязательным реле и блокировкой',
            directive: 'Найдите число путей от А к Ж, проходящих через РЕЛЕ и избегающих БЛОК.'
        },
        {
            waveNum: 10, mode: 'shortest', nodeCount: 6, directed: true, showMatrix: true,
            useHoneypot: true, useRequired: true, timeLimit: 17.0,
            domain: 'Финальный босс // Магистральный шлюз знаний',
            title: 'Критический прорыв по матрице орграфа под давлением ICE',
            directive: 'По матрице орграфа проложите кратчайший путь от А к Е через РЕЛЕ в обход ЛОВУШКИ!'
        }
    ];

    function buildShortestWave(spec) {
        const is5 = spec.nodeCount === 5;
        const nodes = (is5 ? LAYOUT_5 : LAYOUT_6).map(n => ({ ...n }));
        const basePairs = is5 ? EDGES_5 : EDGES_6;
        const targetId = spec.nodeCount - 1;

        for (let attempt = 0; attempt < 60; attempt++) {
            const matrix = Array.from({ length: spec.nodeCount }, () => Array(spec.nodeCount).fill(null));
            const edges = [];

            for (const [u, v] of basePairs) {
                const keep = attempt > 30 || Math.random() < 0.85 || u === 0 || v === targetId;
                if (!keep) continue;

                if (spec.directed) {
                    const wFwd = randInt(2, 11);
                    matrix[u][v] = wFwd;
                    edges.push({ u, v, w: wFwd, isReverse: false });
                    // Небольшой шанс обратной дуги на внутренних узлах с отдельным изогнутым маршрутом
                    if (u > 0 && v < targetId && Math.random() < 0.35) {
                        const wRev = randInt(4, 14);
                        matrix[v][u] = wRev;
                        edges.push({ u: v, v: u, w: wRev, isReverse: true });
                    }
                } else {
                    const w = randInt(2, 11);
                    matrix[u][v] = w;
                    matrix[v][u] = w;
                    edges.push({ u, v, w, isReverse: false });
                }
            }

            const midPool = is5 ? [1, 2, 3] : [1, 2, 3, 4];
            const honeypotNode = spec.useHoneypot ? midPool[randInt(0, midPool.length - 1)] : null;
            let requiredNode = null;
            if (spec.useRequired) {
                const reqPool = midPool.filter(id => id !== honeypotNode);
                requiredNode = reqPool[randInt(0, reqPool.length - 1)];
            }

            const { bestCost, bestPath } = findShortestSimplePath(
                spec.nodeCount, matrix, targetId, honeypotNode, requiredNode
            );

            if (bestPath && bestCost < Infinity && bestPath.length >= 3) {
                return {
                    ...spec,
                    nodes,
                    edges,
                    matrix,
                    targetId,
                    honeypotNode,
                    forbiddenNode: null,
                    requiredNode,
                    optimalCost: bestCost,
                    solutionPath: bestPath,
                    exactDagCount: null
                };
            }
        }

        // Гарантированный детерминированный запасной вариант
        const fbMatrix = Array.from({ length: spec.nodeCount }, () => Array(spec.nodeCount).fill(null));
        const fbEdges = [];
        for (const [u, v] of basePairs) {
            const w = ((u + v) % 6) + 3;
            fbMatrix[u][v] = w;
            if (!spec.directed) fbMatrix[v][u] = w;
            fbEdges.push({ u, v, w, isReverse: false });
        }
        const hp = spec.useHoneypot ? 2 : null;
        const rq = spec.useRequired ? 1 : null;
        const res = findShortestSimplePath(spec.nodeCount, fbMatrix, targetId, hp, rq);
        return {
            ...spec,
            nodes,
            edges: fbEdges,
            matrix: fbMatrix,
            targetId,
            honeypotNode: hp,
            forbiddenNode: null,
            requiredNode: rq,
            optimalCost: res.bestCost,
            solutionPath: res.bestPath,
            exactDagCount: null
        };
    }

    function buildDagWave(spec) {
        const is6 = spec.nodeCount === 6;
        const nodes = (is6 ? LAYOUT_6 : LAYOUT_7_DAG).map(n => ({ ...n }));
        const candidateEdges = is6 ? EDGES_6 : EDGES_7_DAG;
        const targetId = spec.nodeCount - 1;
        const midPool = is6 ? [1, 2, 3, 4] : [1, 2, 3, 4, 5];

        for (let attempt = 0; attempt < 90; attempt++) {
            const edges = [];
            const adj = Array.from({ length: spec.nodeCount }, () => []);
            for (const [u, v] of candidateEdges) {
                const mustKeep = (u === 0) || (v === targetId);
                if (mustKeep || Math.random() < 0.78) {
                    edges.push({ u, v, w: 1, isReverse: false });
                    adj[u].push(v);
                }
            }

            const forbiddenNode = spec.useBanned ? midPool[randInt(0, midPool.length - 1)] : null;
            let requiredNode = null;
            if (spec.useRequired) {
                const reqPool = midPool.filter(id => id !== forbiddenNode);
                requiredNode = reqPool[randInt(0, reqPool.length - 1)];
            }

            let count = 0;
            if (requiredNode !== null) {
                const p1 = countDagPathsBetween(spec.nodeCount, adj, 0, requiredNode, forbiddenNode);
                const p2 = countDagPathsBetween(spec.nodeCount, adj, requiredNode, targetId, forbiddenNode);
                count = p1 * p2;
            } else {
                count = countDagPathsBetween(spec.nodeCount, adj, 0, targetId, forbiddenNode);
            }

            if (count >= 2 && count <= 30) {
                return {
                    ...spec,
                    nodes,
                    edges,
                    matrix: null,
                    targetId,
                    honeypotNode: null,
                    forbiddenNode,
                    requiredNode,
                    optimalCost: null,
                    solutionPath: null,
                    exactDagCount: count
                };
            }
        }

        // Гарантированный запасной вариант DAG
        const fbAdj = Array.from({ length: spec.nodeCount }, () => []);
        const fbEdges = candidateEdges.map(([u, v]) => {
            fbAdj[u].push(v);
            return { u, v, w: 1, isReverse: false };
        });
        const fbForb = spec.useBanned ? 3 : null;
        const fbReq = spec.useRequired ? 2 : null;
        const fbCount = fbReq !== null
            ? countDagPathsBetween(spec.nodeCount, fbAdj, 0, fbReq, fbForb) *
              countDagPathsBetween(spec.nodeCount, fbAdj, fbReq, targetId, fbForb)
            : countDagPathsBetween(spec.nodeCount, fbAdj, 0, targetId, fbForb);

        return {
            ...spec,
            nodes,
            edges: fbEdges,
            matrix: null,
            targetId,
            honeypotNode: null,
            forbiddenNode: fbForb,
            requiredNode: fbReq,
            optimalCost: null,
            solutionPath: null,
            exactDagCount: fbCount
        };
    }

    createApp({
        data() {
            return {
                missionName: 'Урок 10 :: Графы. Решение алгоритмических задач, связанных с анализом графов (Уровень 3)',
                gameState: 'intro', // 'intro' | 'playing' | 'victory'
                waves: [],
                currentWave: 1,
                totalWaves: 10,
                attempts: 0,
                finalTimeSec: 0,

                phaseTimeLeft: 34.0,
                maxPhaseTime: 34.0,
                timerHandle: null,
                waveTimeout: null,
                resetTimeout: null,

                alarmActive: false,
                alarmReason: '',
                isInputLocked: false,

                playerPath: [0],
                currentCost: 0,
                dagGuess: 1,

                telemetry: null
            };
        },

        computed: {
            currentWaveData() {
                if (!this.waves.length) {
                    return {
                        mode: 'shortest', title: '', directive: '', domain: '',
                        nodes: [], edges: [], matrix: null, targetId: 0,
                        honeypotNode: null, forbiddenNode: null, requiredNode: null,
                        directed: false, showMatrix: false, timeLimit: 34.0
                    };
                }
                return this.waves[this.currentWave - 1] || this.waves[0];
            },

            currentNode() {
                return this.playerPath.length ? this.playerPath[this.playerPath.length - 1] : 0;
            },

            progressBarStyle() {
                const pct = this.maxPhaseTime > 0
                    ? Math.max(0, Math.min(100, (this.phaseTimeLeft / this.maxPhaseTime) * 100))
                    : 0;
                return { width: pct.toFixed(1) + '%' };
            },

            iceLevel() {
                if (this.maxPhaseTime <= 0) return 0;
                const elapsedRatio = 1 - (this.phaseTimeLeft / this.maxPhaseTime);
                return Math.min(6, Math.max(0, Math.ceil(elapsedRatio * 6)));
            },

            iceStatusText() {
                if (this.iceLevel >= 5) return 'КРИТИЧЕСКАЯ БЛИЗОСТЬ!';
                if (this.iceLevel >= 3) return 'СКАНИРОВАНИЕ ПОДСЕТИ';
                return 'ДИСТАНЦИЯ БЕЗОПАСНА';
            },

            canFastForward() {
                if (this.currentWaveData.mode !== 'shortest' || !this.currentWaveData.matrix) return false;
                const u = this.currentNode;
                const t = this.currentWaveData.targetId;
                return u !== t && this.currentWaveData.matrix[u][t] !== null;
            },

            renderedEdges() {
                const wave = this.currentWaveData;
                if (!wave || !wave.nodes.length) return [];

                return wave.edges.map((edge) => {
                    const n1 = wave.nodes[edge.u];
                    const n2 = wave.nodes[edge.v];
                    const dx = n2.x - n1.x;
                    const dy = n2.y - n1.y;
                    const len = Math.hypot(dx, dy) || 1;
                    const nx = -dy / len;
                    const ny = dx / len;

                    let pathD = '';
                    let labelX = (n1.x + n2.x) / 2;
                    let labelY = (n1.y + n2.y) / 2;

                    if (edge.isReverse) {
                        const curveOffset = 34;
                        const cx = (n1.x + n2.x) / 2 + nx * curveOffset;
                        const cy = (n1.y + n2.y) / 2 + ny * curveOffset;
                        pathD = `M ${n1.x} ${n1.y} Q ${cx.toFixed(1)} ${cy.toFixed(1)} ${n2.x} ${n2.y}`;
                        labelX = Math.round(0.25 * n1.x + 0.5 * cx + 0.25 * n2.x);
                        labelY = Math.round(0.25 * n1.y + 0.5 * cy + 0.25 * n2.y);
                    } else {
                        pathD = `M ${n1.x} ${n1.y} L ${n2.x} ${n2.y}`;
                        // Смещаем метку чуть к 42% (или сдвигаем для пересекающихся диагоналей 1-4 / 2-3), чтобы веса никогда не накладывались
                        const t = (edge.u === 1 && edge.v === 4) ? 0.36 : ((edge.u === 2 && edge.v === 3) ? 0.64 : 0.48);
                        labelX = Math.round(n1.x + dx * t);
                        labelY = Math.round(n1.y + dy * t);
                    }

                    // Проверяем, пройдено ли ребро в текущем маршруте игрока
                    let isOnPath = false;
                    for (let i = 0; i < this.playerPath.length - 1; i++) {
                        const a = this.playerPath[i];
                        const b = this.playerPath[i + 1];
                        if (wave.directed) {
                            if (a === edge.u && b === edge.v) isOnPath = true;
                        } else if ((a === edge.u && b === edge.v) || (a === edge.v && b === edge.u)) {
                            isOnPath = true;
                        }
                    }

                    // Доступен ли переход по этому ребру с текущей вершины
                    const cur = this.currentNode;
                    const isAvail = wave.mode === 'shortest' && (
                        wave.directed
                            ? (edge.u === cur && !this.playerPath.includes(edge.v))
                            : ((edge.u === cur && !this.playerPath.includes(edge.v)) || (edge.v === cur && !this.playerPath.includes(edge.u)))
                    );

                    const involvesBlocked = (wave.forbiddenNode === edge.u || wave.forbiddenNode === edge.v);

                    let stroke = '#495057';
                    let strokeWidth = 2.5;
                    let markerEnd = 'url(#arrow-dim)';

                    if (wave.mode === 'dag') {
                        stroke = involvesBlocked ? '#5a1e24' : '#0dcaf0';
                        strokeWidth = involvesBlocked ? 2 : 2.6;
                        markerEnd = 'url(#arrow-dag)';
                    } else if (isOnPath) {
                        stroke = '#0dcaf0';
                        strokeWidth = 4.2;
                        markerEnd = 'url(#arrow-active)';
                    } else if (isAvail) {
                        stroke = '#ffc107';
                        strokeWidth = 3.0;
                        markerEnd = 'url(#arrow-avail)';
                    }

                    return {
                        ...edge,
                        pathD,
                        labelX,
                        labelY,
                        isOnPath,
                        dashed: edge.isReverse || involvesBlocked,
                        stroke,
                        strokeWidth,
                        markerEnd
                    };
                });
            }
        },

        mounted() {
            window.addEventListener('keydown', this.handleKeydown);

            if (window.LMSTelemetry) {
                this.telemetry = window.LMSTelemetry.create({
                    missionName: this.missionName,
                    level: 3,
                    totalWaves: this.totalWaves,
                    showAfkOverlay: true,
                    onAfkStop: () => {
                        this.stopTimer();
                        this.clearTimeouts();
                        this.alarmActive = false;
                        this.isInputLocked = true;
                    },
                    onAfkRetry: () => {
                        this.alarmActive = false;
                        this.alarmReason = '';
                        if (this.gameState === 'playing') {
                            this.telemetry.setWave(1, this.totalWaves);
                            this.generateAllWaves();
                            this.loadWave(1);
                        }
                    }
                });
            }

            const self = this;
            window.__DEV_LEVEL3_STATE__ = {
                get waves() { return self.waves; },
                get currentWaveIndex() { return self.currentWave - 1; },
                get currentWave() { return self.currentWave; },
                solveCurrentWave: () => self.devSolveCurrentWave(),
                submitAction: (action, payload) => self.devSubmitAction(action, payload)
            };
        },

        beforeUnmount() {
            window.removeEventListener('keydown', this.handleKeydown);
            this.stopTimer();
            this.clearTimeouts();
            if (this.telemetry) {
                this.telemetry.destroy();
            }
        },

        methods: {
            getNodeName(id) {
                return NODE_LABELS[id] || String(id);
            },

            generateAllWaves() {
                this.waves = WAVE_SPECS.map((spec) => {
                    return spec.mode === 'dag' ? buildDagWave(spec) : buildShortestWave(spec);
                });
            },

            clearTimeouts() {
                clearTimeout(this.waveTimeout);
                clearTimeout(this.resetTimeout);
            },

            stopTimer() {
                if (this.timerHandle) {
                    clearInterval(this.timerHandle);
                    this.timerHandle = null;
                }
            },

            startTimer() {
                this.stopTimer();
                this.timerHandle = setInterval(() => {
                    if (this.gameState !== 'playing' || this.isInputLocked || this.alarmActive) return;
                    this.phaseTimeLeft = Math.max(0, Number((this.phaseTimeLeft - 0.1).toFixed(1)));
                    if (this.phaseTimeLeft <= 0) {
                        this.triggerHardcoreReset(
                            `Время истекло! Антивирус ICE перехватил узел на волне ${this.currentWave}.`,
                            true
                        );
                    }
                }, 100);
            },

            startGame() {
                this.clearTimeouts();
                this.stopTimer();
                this.attempts = 0;
                this.finalTimeSec = 0;
                this.alarmActive = false;
                this.alarmReason = '';
                this.generateAllWaves();
                this.gameState = 'playing';

                if (this.telemetry) {
                    this.telemetry.reset({ allowRecomplete: true });
                    this.telemetry.start();
                    this.telemetry.markActivity();
                    this.telemetry.setWave(1, this.totalWaves);
                    this.telemetry.progress({
                        status: 'started',
                        wave: 1,
                        total_waves: this.totalWaves
                    });
                }

                this.loadWave(1);
            },

            loadWave(waveNum) {
                this.currentWave = waveNum;
                const w = this.currentWaveData;
                this.playerPath = [0];
                this.currentCost = 0;
                this.dagGuess = 1;
                this.phaseTimeLeft = w.timeLimit;
                this.maxPhaseTime = w.timeLimit;
                this.isInputLocked = false;
                this.alarmActive = false;
                this.alarmReason = '';
                this.startTimer();
            },

            isNodeInteractive(nodeId) {
                if (this.gameState !== 'playing' || this.isInputLocked || this.alarmActive) return false;
                const w = this.currentWaveData;
                if (w.mode === 'dag') {
                    return nodeId === w.targetId;
                }
                if (nodeId === this.currentNode) return false;
                if (this.playerPath.length >= 2 && nodeId === this.playerPath[this.playerPath.length - 2]) {
                    return true; // шаг назад по клику на предыдущую вершину
                }
                if (this.playerPath.includes(nodeId)) return false;
                return w.matrix && w.matrix[this.currentNode][nodeId] !== null;
            },

            getNodeState(nodeId) {
                const w = this.currentWaveData;
                const isStart = nodeId === 0;
                const isTarget = nodeId === w.targetId;
                const isVisited = w.mode === 'shortest' && this.playerPath.includes(nodeId);
                const isCurrent = w.mode === 'shortest' && nodeId === this.currentNode;
                const isHoneypot = nodeId === w.honeypotNode;
                const isBlocked = nodeId === w.forbiddenNode;
                const isRequired = nodeId === w.requiredNode;
                const isAvail = w.mode === 'shortest' &&
                    !this.playerPath.includes(nodeId) &&
                    w.matrix && w.matrix[this.currentNode][nodeId] !== null;

                if (isHoneypot || isBlocked) {
                    return { fill: '#2a080d', stroke: '#dc3545', textColor: '#ff6b7a', ringStroke: null };
                }
                if (isCurrent) {
                    return { fill: '#0dcaf0', stroke: '#ffffff', textColor: '#000000', ringStroke: '#0dcaf0' };
                }
                if (isVisited) {
                    return { fill: '#0b3c49', stroke: '#0dcaf0', textColor: '#0dcaf0', ringStroke: null };
                }
                if (isTarget) {
                    return { fill: '#332701', stroke: '#ffc107', textColor: '#ffc107', ringStroke: isAvail || w.mode === 'dag' ? '#ffc107' : null };
                }
                if (isRequired) {
                    return { fill: '#0b2e13', stroke: '#198754', textColor: '#75b798', ringStroke: isAvail ? '#ffc107' : '#198754' };
                }
                if (isStart) {
                    return { fill: '#082c36', stroke: '#0dcaf0', textColor: '#0dcaf0', ringStroke: null };
                }
                if (isAvail) {
                    return { fill: '#1a1d20', stroke: '#ffc107', textColor: '#ffc107', ringStroke: null };
                }
                return { fill: '#141619', stroke: '#6c757d', textColor: '#e9ecef', ringStroke: null };
            },

            getNodeBadge(nodeId) {
                const w = this.currentWaveData;
                if (nodeId === w.honeypotNode) return { text: 'ЛОВУШКА', color: '#dc3545' };
                if (nodeId === w.forbiddenNode) return { text: 'БЛОК', color: '#dc3545' };
                if (nodeId === w.requiredNode) return { text: 'РЕЛЕ', color: '#20c997' };
                if (nodeId === 0) return { text: 'СТАРТ', color: '#0dcaf0' };
                if (nodeId === w.targetId) {
                    return w.mode === 'dag'
                        ? { text: `ПУСК:${this.dagGuess}`, color: '#ffc107' }
                        : { text: 'ЦЕЛЬ', color: '#ffc107' };
                }
                return null;
            },

            getMatrixCellClass(rIdx, cIdx, val) {
                if (rIdx === cIdx) return 'bg-black text-secondary opacity-50';
                for (let i = 0; i < this.playerPath.length - 1; i++) {
                    const a = this.playerPath[i];
                    const b = this.playerPath[i + 1];
                    if ((a === rIdx && b === cIdx) || (!this.currentWaveData.directed && a === cIdx && b === rIdx)) {
                        return 'bg-info text-black fw-bold';
                    }
                }
                if (rIdx === this.currentNode && val !== null) {
                    return 'bg-dark text-warning fw-bold border-warning';
                }
                return val !== null ? 'text-light fw-bold' : 'text-secondary';
            },

            handleNodeClick(nodeId) {
                if (this.gameState !== 'playing' || this.isInputLocked || this.alarmActive) return;
                if (this.telemetry) this.telemetry.markActivity();

                const w = this.currentWaveData;
                if (w.mode === 'dag') {
                    if (nodeId === w.targetId) {
                        this.submitDagPulse();
                    }
                    return;
                }

                // Шаг назад при клике на предпоследний узел маршрута
                if (this.playerPath.length >= 2 && nodeId === this.playerPath[this.playerPath.length - 2]) {
                    this.stepBack();
                    return;
                }

                if (this.playerPath.includes(nodeId)) return;

                const weight = w.matrix && w.matrix[this.currentNode][nodeId];
                if (weight === null || weight === undefined) return;

                // Попадание в узел-ловушку (Honeypot)
                if (w.honeypotNode !== null && nodeId === w.honeypotNode) {
                    this.triggerHardcoreReset(
                        `Активирована ловушка ICE в узле ${this.getNodeName(nodeId)}!`
                    );
                    return;
                }

                playStepSound();
                this.playerPath.push(nodeId);
                this.currentCost += weight;

                if (nodeId === w.targetId) {
                    this.evaluateShortestArrival();
                }
            },

            stepBack() {
                if (this.playerPath.length <= 1 || this.isInputLocked || this.alarmActive) return;
                if (this.telemetry) this.telemetry.markActivity();
                const last = this.playerPath.pop();
                const prev = this.playerPath[this.playerPath.length - 1];
                const w = this.currentWaveData.matrix[prev][last];
                if (w) this.currentCost = Math.max(0, this.currentCost - w);
                playStepSound();
            },

            fastForwardTarget() {
                if (this.canFastForward && !this.isInputLocked && !this.alarmActive) {
                    this.handleNodeClick(this.currentWaveData.targetId);
                }
            },

            evaluateShortestArrival() {
                const w = this.currentWaveData;
                if (w.requiredNode !== null && !this.playerPath.includes(w.requiredNode)) {
                    this.triggerHardcoreReset(
                        `Пропущен обязательный узел РЕЛЕ (${this.getNodeName(w.requiredNode)})!`
                    );
                    return;
                }
                if (this.currentCost > w.optimalCost) {
                    this.triggerHardcoreReset(
                        `Неоптимальный маршрут! Ваш вес: ${this.currentCost}, кратчайший путь: ${w.optimalCost}.`
                    );
                    return;
                }
                this.completeWave();
            },

            adjustDag(delta) {
                if (this.gameState !== 'playing' || this.isInputLocked || this.alarmActive) return;
                if (this.telemetry) this.telemetry.markActivity();
                this.dagGuess = Math.max(0, Math.min(99, this.dagGuess + delta));
                playStepSound();
            },

            submitDagPulse() {
                if (this.gameState !== 'playing' || this.isInputLocked || this.alarmActive) return;
                if (this.telemetry) this.telemetry.markActivity();
                const expected = this.currentWaveData.exactDagCount;
                if (this.dagGuess === expected) {
                    this.completeWave();
                } else {
                    this.triggerHardcoreReset(
                        `Ошибка калибровки DAG! Передано путей: ${this.dagGuess}, верное значение: ${expected}.`
                    );
                }
            },

            completeWave() {
                this.stopTimer();
                this.clearTimeouts();
                this.isInputLocked = true;
                playSuccessSound();

                if (this.currentWave >= this.totalWaves) {
                    this.finishGame();
                } else {
                    const nextWave = this.currentWave + 1;
                    if (this.telemetry) {
                        this.telemetry.advanceWave(nextWave);
                    }
                    this.waveTimeout = setTimeout(() => {
                        if (this.gameState !== 'playing' || (this.telemetry && this.telemetry.getState().isAfkPaused)) {
                            return;
                        }
                        this.loadWave(nextWave);
                    }, 350);
                }
            },

            triggerHardcoreReset(reason, isTimeout = false) {
                this.stopTimer();
                this.clearTimeouts();
                this.isInputLocked = true;

                if (this.telemetry) {
                    const sent = this.telemetry.fail({
                        wave: this.currentWave,
                        isTimeout: Boolean(isTimeout)
                    });
                    this.attempts = this.telemetry.getState().attemptsCount;
                    if (sent === false) {
                        this.alarmActive = false;
                        this.alarmReason = '';
                        return;
                    }
                } else {
                    this.attempts++;
                }

                playAlarmSound();
                this.alarmReason = reason;
                this.alarmActive = true;
                this.generateAllWaves();

                this.resetTimeout = setTimeout(() => {
                    if (this.gameState !== 'playing' || (this.telemetry && this.telemetry.getState().isAfkPaused)) {
                        return;
                    }
                    this.alarmActive = false;
                    this.alarmReason = '';
                    if (this.telemetry) {
                        this.telemetry.setWave(1, this.totalWaves);
                    }
                    this.loadWave(1);
                }, 1500);
            },

            finishGame() {
                this.stopTimer();
                this.clearTimeouts();
                this.gameState = 'victory';
                playVictorySound();
                if (this.telemetry) {
                    const payload = this.telemetry.complete({ wave: this.totalWaves });
                    this.finalTimeSec = payload ? payload.time_spent_sec : this.telemetry.getTimeSpentSec();
                }
            },

            handleKeydown(e) {
                if (this.gameState !== 'playing' || this.isInputLocked || this.alarmActive) return;
                if (this.telemetry && this.telemetry.getState().isAfkPaused) return;
                if (this.telemetry) this.telemetry.markActivity();

                const w = this.currentWaveData;
                if (w.mode === 'shortest') {
                    const num = parseInt(e.key, 10);
                    if (num >= 1 && num <= w.nodes.length) {
                        this.handleNodeClick(num - 1);
                        return;
                    }
                    if (e.key === 'Backspace') {
                        e.preventDefault();
                        this.stepBack();
                        return;
                    }
                    if (e.code === 'Space' || e.key === 'Enter') {
                        if (this.canFastForward) {
                            e.preventDefault();
                            this.fastForwardTarget();
                        }
                    }
                } else {
                    if (e.key === 'ArrowLeft' || e.key === '-') {
                        e.preventDefault();
                        this.adjustDag(e.shiftKey ? -5 : -1);
                    } else if (e.key === 'ArrowRight' || e.key === '+' || e.key === '=') {
                        e.preventDefault();
                        this.adjustDag(e.shiftKey ? 5 : 1);
                    } else if (e.code === 'Space' || e.key === 'Enter') {
                        e.preventDefault();
                        this.submitDagPulse();
                    }
                }
            },

            // --- Методы тестового хука __DEV_LEVEL3_STATE__ ---
            devSolveCurrentWave() {
                if (this.gameState !== 'playing' || this.alarmActive || this.isInputLocked) return;
                const w = this.currentWaveData;
                if (w.mode === 'dag') {
                    this.dagGuess = w.exactDagCount;
                    this.submitDagPulse();
                    return;
                }
                const path = w.solutionPath;
                if (Array.isArray(path) && path.length > 1) {
                    this.playerPath = [0];
                    this.currentCost = 0;
                    for (let i = 1; i < path.length; i++) {
                        if (this.alarmActive || this.gameState !== 'playing') break;
                        this.handleNodeClick(path[i]);
                    }
                }
            },

            devSubmitAction(action, payload) {
                if (action === 'click_node' && payload !== undefined) {
                    this.handleNodeClick(typeof payload === 'object' ? payload.nodeId : Number(payload));
                } else if (action === 'set_dag' && payload !== undefined) {
                    this.dagGuess = Number(payload);
                    this.submitDagPulse();
                } else if (action === 'solve') {
                    this.devSolveCurrentWave();
                } else if (action === 'fail') {
                    this.triggerHardcoreReset(payload || 'Тестовый принудительный сбой', false);
                } else if (action === 'timeout') {
                    this.triggerHardcoreReset('Тестовый таймаут волны', true);
                }
            }
        }
    }).mount('#vue-app');
})();
</script>
