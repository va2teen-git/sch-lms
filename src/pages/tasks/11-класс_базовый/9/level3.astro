                get waves() { return self.activeWaves; },
                get currentWaveIndex() { return self.currentWave - 1; },
                get currentWave() { return self.currentWave; },
                getCurrentWaveData: () => self.currentWaveData,
                getAttempts: () => self.attempts,
                solveCurrentWave: () => {
                    if (!self.currentWaveData) return;
                    if (self.currentWaveData.isSanityAnomaly) {
                        self.rejectSanity();
                    } else {
                        self.currentK = self.currentWaveData.targetK;
                        self.selectedFormat = self.currentWaveData.targetFormat;
                        self.commitModel();
                    }
                },
                submitAction: (action, payload) => {
                    if (action === 'commit') self.commitModel();
                    else if (action === 'reject') self.rejectSanity();
                    else if (action === 'set_format') self.selectFormat(payload);
                    else if (action === 'set_k') self.currentK = Number(payload);
                }
            };
        },

        beforeUnmount() {
            window.removeEventListener('keydown', this.handleKeydown);
            this.stopTimer();
        },

        methods: {
            sendTelemetry(actionType, status, success) {
                const timeSpent = Math.max(1, Math.round((Date.now() - this.startTime) / 1000));
                window.parent.postMessage({
                    type: 'TELEMETRY_EVENT',
                    mission_name: 'Урок 9 :: Модели и моделирование (Уровень 3 / Аркада)',
                    action_type: actionType,
                    status: status,
                    start_time: new Date(this.startTime).toISOString(),
                    time_spent_sec: timeSpent,
                    attempts_count: this.attempts,
                    success: success
                }, '*');
            },

            // Процедурная генерация параметров 10 волн
            generateWaves() {
                this.activeWaves = this.wavesConfig.map((cfg) => {
                    const wave = JSON.parse(JSON.stringify(cfg));
                    
                    if (!wave.isSanityAnomaly) {
                        // Процедурно варьируем целевое k около 50 (например 42..58)
                        const deltaK = Math.floor(Math.random() * 9) - 4; // -4 .. +4
                        wave.targetK = Math.max(30, Math.min(70, wave.targetK + deltaK));

                        // Генерируем 7 эталонных точек эталона на кривой при k = targetK
                        wave.benchmarkPoints = [];
                        const steps = 6;
                        for (let i = 0; i <= steps; i++) {
                            const normX = i / steps;
                            const svgX = 40 + normX * 480;
                            let normY = 0;

                            if (wave.curveType === 'zipf') {
                                normY = 0.85 / Math.pow(1 + normX * 3.5, 1.2);
                            } else if (wave.curveType === 'diffusion') {
                                normY = 0.88 * Math.exp(-0.5 * Math.pow((normX - 0.45) / 0.22, 2));
                            } else if (wave.curveType === 'saturation') {
                                normY = 0.9 * (normX / (normX + 0.22));
                            } else if (wave.curveType === 'damped_oscillation') {
                                normY = 0.45 + 0.42 * Math.exp(-normX * 2.2) * Math.cos(normX * 14);
                            } else if (wave.curveType === 'logistic') {
                                normY = 0.88 / (1 + Math.exp(-8 * (normX - 0.48)));
                            } else if (wave.curveType === 'harmonic') {
                                normY = 0.48 + 0.25 * Math.sin(normX * 12) + 0.15 * Math.cos(normX * 20);
                            } else if (wave.curveType === 'power_law') {
                                normY = 0.9 * Math.pow(normX + 0.15, -0.75) * 0.35;
                            } else if (wave.curveType === 'ecosystem') {
                                normY = 0.5 + 0.28 * Math.sin(normX * 10) * Math.cos(normX * 6);
                            }

                            const svgY = 210 - normY * 180;
                            wave.benchmarkPoints.push({ x: svgX, y: svgY });
                        }
                    } else {
                        wave.benchmarkPoints = [];
                    }

                    return wave;
                });
            },

            startGame() {
                this.startTime = Date.now();
                this.currentWave = 1;
                this.generateWaves();
                this.loadWave(1);
                this.gameState = 'playing';
                this.sendTelemetry('in_progress', 'started', true);
            },

            loadWave(waveNum) {
                this.currentWave = waveNum;
                this.currentWaveData = this.activeWaves[waveNum - 1];
                this.selectedFormat = null;

                // Случайное стартовое k со смещением от targetK, чтобы требовалась калибровка
                if (!this.currentWaveData.isSanityAnomaly) {
                    const offset = (Math.random() > 0.5 ? 1 : -1) * (14 + Math.floor(Math.random() * 8));
                    this.currentK = Math.max(15, Math.min(85, this.currentWaveData.targetK + offset));
                } else {
                    this.currentK = 50;
                }

                // Таймер раунда
                this.maxPhaseTime = this.currentWaveData.timeLimit;
                this.phaseTimeLeft = this.maxPhaseTime;
                this.isActionBlocked = false;

                this.startTimer();
            },

            startTimer() {
                this.stopTimer();
                const tickInterval = 100;
                this.timerInterval = setInterval(() => {
                    this.phaseTimeLeft -= tickInterval / 1000;
                    if (this.phaseTimeLeft <= 0) {
                        this.phaseTimeLeft = 0;
                        this.stopTimer();
                        this.triggerHardcoreReset('Время ожидания модели истекло! Срыв синхронизации вычислителя.');
                    }
                }, tickInterval);
            },

            stopTimer() {
                if (this.timerInterval) {
                    clearInterval(this.timerInterval);
                    this.timerInterval = null;
                }
            },

            adjustK(delta) {
                if (this.isActionBlocked || this.currentWaveData.isSanityAnomaly) return;
                this.currentK = Math.max(10, Math.min(90, this.currentK + delta));
                playTickSound();
            },

            onSliderInput() {
                playTickSound();
            },

            selectFormat(format) {
                if (this.isActionBlocked) return;
                this.selectedFormat = format;
                playTickSound();
            },

            // Утверждение модели в эксплуатацию
            commitModel() {
                if (this.gameState !== 'playing' || this.isActionBlocked) return;

                // Проверка 1: Если модель была с аномалией Sanity Check, ее утверждение — грубейшая ошибка!
                if (this.currentWaveData.isSanityAnomaly) {
                    this.triggerHardcoreReset('Грубая ошибка: утверждена физически абсурдная модель, нарушающая границы предметной области!');
                    return;
                }

                // Проверка 2: Выбран ли формат визуализации?
                if (!this.selectedFormat) {
                    this.triggerHardcoreReset('Шлюз не скоммутирован: не выбран проектор представления данных!');
                    return;
                }

                // Проверка 3: Соответствует ли формат структуре данных?
                if (this.selectedFormat !== this.currentWaveData.targetFormat) {
                    this.triggerHardcoreReset('Неверная коммутация: выбранный проектор не соответствует типу и структуре данных модели!');
                    return;
                }

                // Проверка 4: Достигнут ли резонанс сходимости (относительная погрешность delta <= 5.0%)?
                if (this.currentDiscrepancy > 5.0) {
                    this.triggerHardcoreReset(`Модель не откалибрована! Относительная погрешность δ = ${this.currentDiscrepancy.toFixed(1)}% превышает норматив 5.0%.`);
                    return;
                }

                // Все проверки пройдены — успех текущей волны!
                this.handleWaveSuccess();
            },

            // Отклонение аномальной модели (Sanity Reject)
            rejectSanity() {
                if (this.gameState !== 'playing' || this.isActionBlocked) return;

                if (this.currentWaveData.isSanityAnomaly) {
                    // Верное выявление и отбраковка абсурдной модели
                    this.handleWaveSuccess();
                } else {
                    // Ложная отбраковка корректной модели
                    this.triggerHardcoreReset('Ложная отбраковка: отклонена корректная физическая модель!');
                }
            },

            handleWaveSuccess() {
                playSuccessSound();
                this.stopTimer();
                this.isActionBlocked = true;

                if (this.currentWave >= this.totalWaves) {
                    // Финальная победа
                    this.gameState = 'victory';
                    this.sendTelemetry('level_complete', 'passed', true);
                } else {
                    this.sendTelemetry('in_progress', `wave_${this.currentWave}_complete`, true);
                    setTimeout(() => {
                        this.loadWave(this.currentWave + 1);
                    }, 300);
                }
            },

            triggerHardcoreReset(reason) {
                this.stopTimer();
                this.isActionBlocked = true;
                this.attempts++;
                playErrorSound();
                playAlarmSiren();

                this.sendTelemetry('hardcore_reset', 'failed', false);
                this.alarmMessage = reason;
                this.alarmActive = true;

                setTimeout(() => {
                    this.alarmActive = false;
                    this.generateWaves();
                    this.loadWave(1);
                }, 1700);
            },

            handleKeydown(e) {
                if (this.gameState !== 'playing' || this.isActionBlocked) return;

                if (e.key === '1' || e.code === 'Numpad1') {
                    this.selectFormat('timeseries');
                } else if (e.key === '2' || e.code === 'Numpad2') {
                    this.selectFormat('gis');
                } else if (e.key === '3' || e.code === 'Numpad3') {
                    this.selectFormat('graph');
                } else if (e.key === '4' || e.code === 'Numpad4') {
                    this.selectFormat('bi');
                } else if (e.key === 'ArrowLeft' || e.code === 'KeyA') {
                    const step = e.shiftKey ? 5 : 1;
                    this.adjustK(-step);
                } else if (e.key === 'ArrowRight' || e.code === 'KeyD') {
                    const step = e.shiftKey ? 5 : 1;
                    this.adjustK(step);
                } else if (e.code === 'Space' || e.key === 'Enter') {
                    e.preventDefault();
                    this.commitModel();
                } else if (e.code === 'KeyX' || e.key === 'Delete' || e.key === 'Backspace') {
                    e.preventDefault();
                    this.rejectSanity();
                }
            }
        }
    }).mount('#vue-app');
})();
</script>
