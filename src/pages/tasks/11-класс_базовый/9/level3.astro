        computed: {
            timerPercentage() {
                return Math.max(0, Math.min(100, (this.phaseTimeLeft / this.maxPhaseTime) * 100));
            },

            currentDiscrepancy() {
                if (!this.currentWaveData || this.currentWaveData.isSanityAnomaly) return 99.9;
                const targetK = this.currentWaveData.targetK || 50;
                const diff = Math.abs(this.currentK - targetK);
                return (diff / targetK) * 100;
            },

            formattedFinalTime() {
                const totalSec = Math.max(1, Math.floor((Date.now() - this.startTime) / 1000));
                const m = String(Math.floor(totalSec / 60)).padStart(2, '0');
                const s = String(totalSec % 60).padStart(2, '0');
                return `${m}:${s}`;
            },

            // Генератор SVG пути расчетной кривой на основе текущего k
            modelPathString() {
                if (!this.currentWaveData || !this.currentWaveData.curveType) return 'M 40 210 L 520 210';
                
                const type = this.currentWaveData.curveType;
                const kRatio = this.currentWaveData.isSanityAnomaly ? 1.0 : (this.currentK / this.currentWaveData.targetK);
                const points = [];
                const steps = 40;

                for (let i = 0; i <= steps; i++) {
                    const normX = i / steps; // 0 .. 1
                    const svgX = 40 + normX * 480;
                    let normY = 0; // 0 .. 1 (0 = дно, 1 = верх)

                    if (type === 'zipf') {
                        normY = 0.85 / Math.pow(1 + normX * 3.5, 1.2);
                    } else if (type === 'diffusion') {
                        normY = 0.88 * Math.exp(-0.5 * Math.pow((normX - 0.45) / 0.22, 2));
                    } else if (type === 'saturation') {
                        normY = 0.9 * (normX / (normX + 0.22));
                    } else if (type === 'damped_oscillation') {
                        normY = 0.45 + 0.42 * Math.exp(-normX * 2.2) * Math.cos(normX * 14);
                    } else if (type === 'logistic') {
                        normY = 0.88 / (1 + Math.exp(-8 * (normX - 0.48)));
                    } else if (type === 'harmonic') {
                        normY = 0.48 + 0.25 * Math.sin(normX * 12) + 0.15 * Math.cos(normX * 20);
                    } else if (type === 'power_law') {
                        normY = 0.9 * Math.pow(normX + 0.15, -0.75) * 0.35;
                    } else if (type === 'ecosystem') {
                        normY = 0.5 + 0.28 * Math.sin(normX * 10) * Math.cos(normX * 6);
                    } else if (type === 'anomaly_divergence') {
                        // Кривая улетает за пределы графика вверх
                        normY = 0.4 + Math.pow(normX * 1.8, 3.2);
                    } else if (type === 'anomaly_negative') {
                        // Кривая падает ниже оси X
                        normY = 0.6 - normX * 1.1;
                    }

                    // Моделируем деформацию кривой при расхождении k
                    if (!this.currentWaveData.isSanityAnomaly) {
                        normY = normY * (0.3 + 0.7 * kRatio);
                    }

                    const svgY = 210 - normY * 180;
                    points.push(`${svgX.toFixed(1)},${svgY.toFixed(1)}`);
                }

                return 'M ' + points.join(' L ');
            },

            // Коридор допустимой погрешности (±5%) вокруг эталонных точек
            corridorPointsString() {
                if (!this.currentWaveData || !this.currentWaveData.benchmarkPoints) return '';
                const pts = this.currentWaveData.benchmarkPoints;
                const topPts = pts.map(p => `${p.x.toFixed(1)},${(p.y - 12).toFixed(1)}`);
                const bottomPts = pts.slice().reverse().map(p => `${p.x.toFixed(1)},${(p.y + 12).toFixed(1)}`);
                return topPts.concat(bottomPts).join(' ');
            }
        },

        mounted() {
            window.addEventListener('keydown', this.handleKeydown);

            // Экспорт тестового API для Playwright и E2E проверки
            const self = this;
