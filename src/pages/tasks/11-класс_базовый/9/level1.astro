---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={1}>
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Верхняя панель заголовка -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h5 text-success mb-0 fw-bold">Тренажер: Модели и моделирование. Представление результатов (Уровень 1)</h2>
            <span class="badge border border-success text-success bg-dark rounded-0 px-3 py-2">Манипуляция мышью // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-success rounded-0">
            <div class="card-body p-3 p-md-4">
                
                <!-- Шапка и индикаторы текущей фазы -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2 gap-2">
                    <div>
                        <span id="phase-badge" class="badge bg-success text-dark rounded-0 fs-6 me-2">Шаг 1 из 3</span>
                        <span id="phase-title" class="text-light fw-bold fs-6">Классификационный шлюз: Формы и природа моделей</span>
                    </div>
                    <div class="text-secondary small">
                        Попытки: <span id="attempts-display" class="text-warning fw-bold">0</span>
                    </div>
                </div>

                <!-- Блок оповещений об ошибках / калибровке -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between">
                        <span>[ОШИБКА МОДЕЛИРОВАНИЯ] <span id="feedback-text">Неверное распределение параметров!</span> Перекалибровка...</span>
                        <span class="spinner-border spinner-border-sm text-danger ms-2" role="status"></span>
                    </div>
                </div>

                <!-- ================= ФАЗА 1: СОРТИРОВКА ПО БАКЕТАМ ================= -->
                <div id="phase-1-container">
                    <div class="alert alert-dark bg-black border-secondary rounded-0 text-secondary mb-3 small">
                        <strong class="text-success">[ИНСТРУКЦИЯ К ФАЗЕ 1]:</strong> Распределите поступившие прикладные и научные модели по 3 классификационным секторам. 
                        Перетаскивайте карточки зажатой мышью или кликните по карточке, а затем по целевому сектору.
                    </div>

                    <!-- Пул нераспределенных карточек -->
                    <div class="card bg-black border-secondary rounded-0 mb-3">
                        <div class="card-header border-secondary bg-dark text-success small py-2 d-flex justify-content-between">
                            <span>ВХОДЯЩИЙ ПУЛ МОДЕЛЕЙ ДЛЯ КЛАССИФИКАЦИИ</span>
                            <span id="p1-pool-counter" class="text-warning">Осталось: 6</span>
                        </div>
                        <div class="card-body p-2">
                            <div id="p1-cards-pool" class="d-flex flex-wrap gap-2" style="min-height: 80px;">
                                <!-- Процедурные карточки генерируются скриптом -->
                            </div>
                        </div>
                    </div>

                    <!-- 3 целевые корзины -->
                    <div class="row g-2 mb-3">
                        <div class="col-12 col-sm-4">
                            <div id="bucket-material" class="card bg-black border-success rounded-0 h-100" data-bucket-type="material">
                                <div class="card-header border-success bg-dark text-success fw-bold small py-2 d-flex justify-content-between">
                                    <span>НАТУРНЫЕ (МАТЕРИАЛЬНЫЕ)</span>
                                    <span class="bucket-counter badge bg-black text-success border border-success rounded-0">0</span>
                                </div>
                                <div class="card-body p-2 bucket-slots" style="min-height: 180px; cursor: pointer;">
                                    <!-- Сюда падают карточки -->
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-4">
                            <div id="bucket-static" class="card bg-black border-info rounded-0 h-100" data-bucket-type="static">
                                <div class="card-header border-info bg-dark text-info fw-bold small py-2 d-flex justify-content-between">
                                    <span>ИНФОРМАЦИОННЫЕ СТАТИЧЕСКИЕ</span>
                                    <span class="bucket-counter badge bg-black text-info border border-info rounded-0">0</span>
                                </div>
                                <div class="card-body p-2 bucket-slots" style="min-height: 180px; cursor: pointer;">
                                    <!-- Сюда падают карточки -->
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-4">
                            <div id="bucket-dynamic" class="card bg-black border-warning rounded-0 h-100" data-bucket-type="dynamic">
                                <div class="card-header border-warning bg-dark text-warning fw-bold small py-2 d-flex justify-content-between">
                                    <span>ИНФОРМАЦИОННЫЕ ДИНАМИЧЕСКИЕ</span>
                                    <span class="bucket-counter badge bg-black text-warning border border-warning rounded-0">0</span>
                                </div>
                                <div class="card-body p-2 bucket-slots" style="min-height: 180px; cursor: pointer;">
                                    <!-- Сюда падают карточки -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p1-verify-btn" class="btn btn-outline-success rounded-0 px-4 py-2 fw-bold font-monospace" style="min-height: 48px;" disabled>
                            ПОДТВЕРДИТЬ КЛАССИФИКАЦИЮ [ШАГ 1]
                        </button>
                    </div>
                </div>

                <!-- ================= ФАЗА 2: КОНВЕЙЕР МОДЕЛИРОВАНИЯ (SLOT & SNAP) ================= -->
                <div id="phase-2-container" class="d-none">
                    <div class="alert alert-dark bg-black border-secondary rounded-0 text-secondary mb-3 small">
                        <strong class="text-success">[ИНСТРУКЦИЯ К ФАЗЕ 2]:</strong> Соберите строгий технологический конвейер научного моделирования из 5 последовательных этапов для задачи:
                        <span id="p2-scenario-title" class="text-info fw-bold">«Динамика распространения информации в медиапространстве»</span>.
                        Остерегайтесь антинаучных действий и фальсификаций в палитре строительных блоков!
                    </div>

                    <!-- Целевой конвейер со слотами -->
                    <div class="card bg-black border-secondary rounded-0 mb-3">
                        <div class="card-header border-secondary bg-dark text-success small py-2">
                            ПОСЛЕДОВАТЕЛЬНЫЙ КОНВЕЙЕР ЭТАПОВ МОДЕЛИРОВАНИЯ
                        </div>
                        <div class="card-body p-2 d-flex flex-column gap-2">
                            <div class="slot-row d-flex flex-column flex-md-row align-items-md-center gap-2 border border-secondary p-2 bg-dark">
                                <div class="text-success fw-bold small" style="min-width: 170px;">1. Постановка задачи:</div>
                                <div class="slot-target flex-fill border border-secondary bg-black p-2 rounded-0 text-secondary small d-flex align-items-center justify-content-center" data-slot="step1" style="min-height: 52px; cursor: pointer;">
                                    <span class="placeholder-text text-muted">[Перетащите этап постановки задачи]</span>
                                </div>
                            </div>
                            <div class="slot-row d-flex flex-column flex-md-row align-items-md-center gap-2 border border-secondary p-2 bg-dark">
                                <div class="text-success fw-bold small" style="min-width: 170px;">2. Информационная модель:</div>
                                <div class="slot-target flex-fill border border-secondary bg-black p-2 rounded-0 text-secondary small d-flex align-items-center justify-content-center" data-slot="step2" style="min-height: 52px; cursor: pointer;">
                                    <span class="placeholder-text text-muted">[Перетащите этап абстрагирования]</span>
                                </div>
                            </div>
                            <div class="slot-row d-flex flex-column flex-md-row align-items-md-center gap-2 border border-secondary p-2 bg-dark">
                                <div class="text-success fw-bold small" style="min-width: 170px;">3. Формализация:</div>
                                <div class="slot-target flex-fill border border-secondary bg-black p-2 rounded-0 text-secondary small d-flex align-items-center justify-content-center" data-slot="step3" style="min-height: 52px; cursor: pointer;">
                                    <span class="placeholder-text text-muted">[Перетащите этап математических формул]</span>
                                </div>
                            </div>
                            <div class="slot-row d-flex flex-column flex-md-row align-items-md-center gap-2 border border-secondary p-2 bg-dark">
                                <div class="text-success fw-bold small" style="min-width: 170px;">4. Компьютерная модель:</div>
                                <div class="slot-target flex-fill border border-secondary bg-black p-2 rounded-0 text-secondary small d-flex align-items-center justify-content-center" data-slot="step4" style="min-height: 52px; cursor: pointer;">
                                    <span class="placeholder-text text-muted">[Перетащите этап алгоритмизации и кода]</span>
                                </div>
                            </div>
                            <div class="slot-row d-flex flex-column flex-md-row align-items-md-center gap-2 border border-secondary p-2 bg-dark">
                                <div class="text-success fw-bold small" style="min-width: 170px;">5. Анализ адекватности:</div>
                                <div class="slot-target flex-fill border border-secondary bg-black p-2 rounded-0 text-secondary small d-flex align-items-center justify-content-center" data-slot="step5" style="min-height: 52px; cursor: pointer;">
                                    <span class="placeholder-text text-muted">[Перетащите этап оценки погрешности]</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Палитра блоков -->
                    <div class="card bg-black border-secondary rounded-0 mb-3">
                        <div class="card-header border-secondary bg-dark text-secondary small py-2 d-flex justify-content-between">
                            <span>ПАЛИТРА СТРОИТЕЛЬНЫХ БЛОКОВ (ВКЛЮЧАЕТ ДИСТРАКТОРЫ)</span>
                            <span class="text-muted">Кликните токен, затем целевой слот</span>
                        </div>
                        <div class="card-body p-2">
                            <div id="p2-tokens-pool" class="d-flex flex-wrap gap-2" style="min-height: 70px;">
                                <!-- Процедурные токены генерируются скриптом -->
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p2-verify-btn" class="btn btn-outline-success rounded-0 px-4 py-2 fw-bold font-monospace" style="min-height: 48px;" disabled>
                            ПОДТВЕРДИТЬ КОНВЕЙЕР [ШАГ 2]
                        </button>
                    </div>
                </div>

                <!-- ================= ФАЗА 3: ПУЛЬТ АНАЛИТИЧЕСКОЙ КАЛИБРОВКИ ================= -->
                <div id="phase-3-container" class="d-none">
                    <div class="alert alert-dark bg-black border-secondary rounded-0 text-secondary mb-3 small">
                        <strong class="text-success">[ИНСТРУКЦИЯ К ФАЗЕ 3]:</strong> Сконфигурируйте аналитический пульт представления результатов для мониторинга динамики процесса во времени.
                        Устраните манипуляцию масштабом, выберите семантически корректный формат графика и настройте нормативный порог погрешности модели (δ ≤ 5%) и оптимальный шаг дискретизации.
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Левая колонка: Органы прямого управления -->
                        <div class="col-12 col-lg-6">
                            <div class="card bg-black border-secondary rounded-0 h-100">
                                <div class="card-header border-secondary bg-dark text-success fw-bold small py-2">
                                    ПАРАМЕТРЫ ПРЕДСТАВЛЕНИЯ И КАЛИБРОВКИ
                                </div>
                                <div class="card-body p-3 d-flex flex-column gap-3">
                                    
                                    <!-- 1. Тумблер формата визуализации -->
                                    <div>
                                        <label class="form-label text-light small fw-bold mb-1 d-block">
                                            1. Формат визуализации данных:
                                        </label>
                                        <button id="toggle-format-btn" type="button" class="btn btn-outline-danger rounded-0 w-100 text-start py-2 px-3 fw-bold" style="min-height: 48px;" data-state="pie">
                                            <span class="d-block text-secondary small">Текущий формат:</span>
                                            <span class="status-label">Круговая диаграмма (Срез долей целого)</span>
                                        </button>
                                        <div class="text-muted small mt-1">Кликайте для циклического выбора (Круговая / Линейный график / Лепестковая / Тепловая)</div>
                                    </div>

                                    <!-- 2. Тумблер масштабирования оси Y -->
                                    <div>
                                        <label class="form-label text-light small fw-bold mb-1 d-block">
                                            2. Базис вертикальной шкалы (Ось Y):
                                        </label>
                                        <button id="toggle-axis-btn" type="button" class="btn btn-outline-danger rounded-0 w-100 text-start py-2 px-3 fw-bold" style="min-height: 48px;" data-state="truncated">
                                            <span class="d-block text-secondary small">Текущий масштаб:</span>
                                            <span class="status-label">Усеченная шкала (Срез 95%..100% // Манипуляция)</span>
                                        </button>
                                        <div class="text-muted small mt-1">Кликайте для переключения между честной шкалой (Y=0) и усеченной</div>
                                    </div>

                                    <!-- 3. Слайдер допустимой погрешности -->
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label class="form-label text-light small fw-bold mb-0">
                                                3. Нормативный допуск погрешности (δ):
                                            </label>
                                            <span id="val-delta" class="badge bg-danger rounded-0 font-monospace fs-6">14%</span>
                                        </div>
                                        <input type="range" class="form-range" id="slider-delta" min="1" max="20" step="1" value="14" style="height: 38px;">
                                        <div class="d-flex justify-content-between text-secondary small">
                                            <span>Строгий: 1%</span>
                                            <span class="text-success">Норма ТЗ: ≤ 5%</span>
                                            <span>Грубый: 20%</span>
                                        </div>
                                    </div>

                                    <!-- 4. Слайдер шага дискретизации -->
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label class="form-label text-light small fw-bold mb-0">
                                                4. Временной шаг дискретизации (Δt):
                                            </label>
                                            <span id="val-step" class="badge bg-warning text-dark rounded-0 font-monospace fs-6">2.5 с</span>
                                        </div>
                                        <input type="range" class="form-range" id="slider-step" min="1" max="50" step="1" value="25" style="height: 38px;">
                                        <div class="d-flex justify-content-between text-secondary small">
                                            <span>Высокая нагрузка: 0.1 с</span>
                                            <span class="text-success">Оптимум: 0.2–0.5 с</span>
                                            <span>Потеря точности: 5.0 с</span>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- Правая колонка: Динамический монитор и статус адекватности -->
                        <div class="col-12 col-lg-6">
                            <div class="card bg-black border-secondary rounded-0 h-100">
                                <div class="card-header border-secondary bg-dark text-info fw-bold small py-2 d-flex justify-content-between align-items-center">
                                    <span>МОНИТОР ВИЗУАЛИЗАЦИИ РЕЗУЛЬТАТОВ</span>
                                    <span id="monitor-badge" class="badge bg-danger text-light rounded-0">ОШИБКА КАЛИБРОВКИ</span>
                                </div>
                                <div class="card-body p-3 d-flex flex-column justify-content-between">
                                    
                                    <!-- Графический холст SVG -->
                                    <div class="border border-secondary bg-black p-2 mb-2 d-flex align-items-center justify-content-center" style="min-height: 220px;">
                                        <svg id="preview-svg" viewBox="0 0 400 200" width="100%" height="200" class="d-block">
                                            <!-- Сетка -->
                                            <line x1="40" y1="20" x2="40" y2="170" stroke="#333" stroke-width="1" />
                                            <line x1="40" y1="170" x2="380" y2="170" stroke="#333" stroke-width="1" />
                                            <line x1="40" y1="95" x2="380" y2="95" stroke="#222" stroke-dasharray="4" />
                                            <!-- График / Фигуры обновляются через JS -->
                                            <g id="svg-content"></g>
                                        </svg>
                                    </div>

                                    <!-- Диагностическая сводка параметров -->
                                    <div class="bg-dark border border-secondary p-2 small font-monospace">
                                        <div class="d-flex justify-content-between border-bottom border-secondary pb-1 mb-1">
                                            <span class="text-secondary">Семантика формата:</span>
                                            <span id="diag-format" class="text-danger">НЕСООТВЕТСТВИЕ ДИНАМИКЕ</span>
                                        </div>
                                        <div class="d-flex justify-content-between border-bottom border-secondary pb-1 mb-1">
                                            <span class="text-secondary">Масштаб оси Y:</span>
                                            <span id="diag-axis" class="text-danger">ИСКАЖЕН (ГИПЕРБОЛИЗАЦИЯ)</span>
                                        </div>
                                        <div class="d-flex justify-content-between border-bottom border-secondary pb-1 mb-1">
                                            <span class="text-secondary">Погрешность δ:</span>
                                            <span id="diag-delta" class="text-danger">ПРЕВЫШЕНИЕ ДОПУСКА (&gt; 5%)</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span class="text-secondary">Дискретизация Δt:</span>
                                            <span id="diag-step" class="text-warning">СЛИШКОМ ГРУБЫЙ ШАГ</span>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="p3-verify-btn" class="btn btn-outline-success rounded-0 px-4 py-2 fw-bold font-monospace" style="min-height: 48px;" disabled>
                            ЗАФИКСИРОВАТЬ РЕЗУЛЬТАТЫ И ЗАВЕРШИТЬ МИССИЮ
                        </button>
                    </div>
                </div>

                <!-- ================= ФИНАЛЬНЫЙ ЭКРАН ПОБЕДЫ ================= -->
                <div id="final-screen" class="d-none text-center py-4">
                    <div class="badge bg-success text-dark fs-5 rounded-0 px-4 py-2 mb-3">
                        МИССИЯ УСПЕШНО ВЫПОЛНЕНА // УРОВЕНЬ 1 ПРОЙДЕН
                    </div>
                    <h3 class="h4 text-success mb-3 fw-bold">Аналитический комплекс верифицирован</h3>
                    <p class="text-secondary mb-4 mx-auto" style="max-width: 600px;">
                        Вы успешно классифицировали модели по фундаментальным категориям, сконструировали строгий научный конвейер моделирования и откалибровали дашборд представления результатов в соответствии со стандартами научной честности и адекватности.
                    </p>
                    <div class="d-inline-flex gap-4 border border-secondary bg-black p-3 rounded-0 font-monospace mb-4">
                        <div>
                            <div class="text-secondary small">Затраченное время:</div>
                            <div id="stat-time" class="text-success fs-5 fw-bold">0 с</div>
                        </div>
                        <div class="border-end border-secondary"></div>
                        <div>
                            <div class="text-secondary small">Число попыток:</div>
                            <div id="stat-attempts" class="text-warning fs-5 fw-bold">0</div>
                        </div>
                        <div class="border-end border-secondary"></div>
                        <div>
                            <div class="text-secondary small">Статус:</div>
                            <div class="text-info fs-5 fw-bold">100% ЗАЧЕТ</div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(function() {
    const startTime = Date.now();
    let currentPhase = 1;
    let attemptsCount = 0;
    let selectedCardElement = null;
    let selectedTokenElement = null;

    const missionName = 'Урок 9 :: Модели и моделирование (Уровень 1)';

    function sendTelemetry(actionType, status, success) {
        const timeSpent = Math.max(1, Math.round((Date.now() - startTime) / 1000));
        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: actionType,
            status: status,
            start_time: new Date(startTime).toISOString(),
            time_spent_sec: timeSpent,
            attempts_count: attemptsCount,
            success: success
        }, '*');
    }

    // Инициализирующий сигнал
    sendTelemetry('in_progress', 'in_progress', false);

    function showFeedback(message) {
        const box = document.getElementById('feedback-box');
        const text = document.getElementById('feedback-text');
        text.textContent = message;
        box.classList.remove('d-none');
        setTimeout(() => {
            box.classList.add('d-none');
        }, 2200);
    }

    function triggerFailure(message, phaseResetCallback) {
        attemptsCount++;
        document.getElementById('attempts-display').textContent = attemptsCount;
        showFeedback(message);
        sendTelemetry('hardcore_reset', 'in_progress', false);
        setTimeout(() => {
            phaseResetCallback();
        }, 1200);
    }

    // =========================================================================
    // ФАЗА 1: КЛАССИФИКАЦИОННЫЙ ШЛЮЗ (МАТЕРИАЛЬНЫЕ / СТАТИЧЕСКИЕ / ДИНАМИЧЕСКИЕ)
    // =========================================================================

    const phase1Bank = [
        // Натурные (материальные)
        { id: 'm_wing', type: 'material', name: 'Макет крыла самолета', desc: 'Уменьшенная модель для продувки в аэродинамической трубе' },
        { id: 'm_arch', type: 'material', name: 'Архитектурный макет', desc: 'Физический макет исторического квартала города в масштабе 1:500' },
        { id: 'm_eye', type: 'material', name: 'Анатомический муляж глаза', desc: 'Разборный натурный образец зрительного аппарата для студентов' },
        { id: 'm_tellur', type: 'material', name: 'Механический теллурий', desc: 'Действующая модель движения Земли и Луны вокруг Солнца' },
