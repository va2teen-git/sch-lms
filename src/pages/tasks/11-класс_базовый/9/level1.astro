                { slot: 'distractor', name: 'Подгонка данных', desc: 'Ручная фальсификация графиков под ожидания рекламного спонсора' }
            ]
        },
        {
            title: '«Компьютерный дизайн нового лекарственного препарата (In Silico)»',
            tokens: [
                { slot: 'step1', name: 'Постановка задачи', desc: 'Определение белка-мишени вируса и требований к блокирующей молекуле' },
                { slot: 'step2', name: 'Информационная модель', desc: 'Выделение активного кармана фермента и электростатических свойств' },
                { slot: 'step3', name: 'Математическая модель', desc: 'Формулы энергии связывания Ван-дер-Ваальса и потенциалов Кулона' },
                { slot: 'step4', name: 'Компьютерный докинг', desc: 'Виртуальный скрининг 1 000 000 химических структур на суперкомпьютере' },
                { slot: 'step5', name: 'Оценка адекватности', desc: 'Лабораторный синтез топ-10 молекул-кандидатов и сверка с расчетом' }
            ],
            distractors: [
                { slot: 'distractor', name: 'Случайный синтез', desc: 'Слепое смешивание химических реактивов без математической модели' },
                { slot: 'distractor', name: 'Игнорирование побочных эффектов', desc: 'Запуск в массовую продажу без этапа клинической верификации' }
            ]
        }
    ];

    let currentPhase2Scenario = null;

    function setupPhase2() {
        const pool = document.getElementById('p2-tokens-pool');
        pool.innerHTML = '';
        selectedTokenElement = null;

        // Очистить слоты
        document.querySelectorAll('.slot-target').forEach(slot => {
            slot.innerHTML = '<span class="placeholder-text text-muted small">[Перетащите токен]</span>';
            slot.removeAttribute('data-placed-slot');
        });

        document.getElementById('p2-verify-btn').disabled = true;

        // Выбираем сценарий
        currentPhase2Scenario = phase2Scenarios[Math.floor(Math.random() * phase2Scenarios.length)];
        document.getElementById('p2-scenario-title').textContent = currentPhase2Scenario.title;

        // Объединяем этапы и дистракторы и перемешиваем
        const allTokens = [...currentPhase2Scenario.tokens, ...currentPhase2Scenario.distractors].sort(() => 0.5 - Math.random());

        allTokens.forEach((tok, idx) => {
            const tokenEl = createPhase2Token(tok, idx);
            pool.appendChild(tokenEl);
        });

        setupDragAndDropPhase2();
    }

    function createPhase2Token(tok, idx) {
        const token = document.createElement('div');
        const isDistractor = tok.slot === 'distractor';
        token.className = `p2-token card bg-black border ${isDistractor ? 'border-secondary' : 'border-success'} rounded-0 p-2 text-start user-select-none mb-1`;
        token.style.cursor = 'grab';
        token.style.minHeight = '48px';
        token.draggable = true;
        token.dataset.tokenId = 'tok_' + idx;
        token.dataset.expectedSlot = tok.slot;

        token.innerHTML = `
            <div class="fw-bold ${isDistractor ? 'text-light' : 'text-success'} small">${tok.name}</div>
            <div class="text-secondary" style="font-size: 0.72rem;">${tok.desc}</div>
        `;

        token.addEventListener('dragstart', (e) => {
            e.dataTransfer.setData('text/plain', token.dataset.tokenId);
            token.classList.add('opacity-50');
        });

        token.addEventListener('dragend', () => {
            token.classList.remove('opacity-50');
        });

        token.addEventListener('click', (e) => {
            e.stopPropagation();
            if (token.parentElement.id === 'p2-tokens-pool') {
                if (selectedTokenElement === token) {
                    token.classList.remove('border-white', 'border-2');
                    selectedTokenElement = null;
                } else {
                    if (selectedTokenElement) {
                        selectedTokenElement.classList.remove('border-white', 'border-2');
                    }
                    selectedTokenElement = token;
                    token.classList.add('border-white', 'border-2');
                }
            } else {
                // Если кликнули на токен в слоте — вернуть в пул
                const slot = token.parentElement;
                slot.innerHTML = '<span class="placeholder-text text-muted small">[Перетащите токен]</span>';
                slot.removeAttribute('data-placed-slot');
                document.getElementById('p2-tokens-pool').appendChild(token);
                checkPhase2Completion();
            }
        });

        return token;
    }

    function setupDragAndDropPhase2() {
        const slots = document.querySelectorAll('.slot-target');
        const pool = document.getElementById('p2-tokens-pool');

        slots.forEach(slot => {
            slot.addEventListener('dragover', (e) => {
                e.preventDefault();
                slot.classList.add('border-success');
            });

            slot.addEventListener('dragleave', () => {
                slot.classList.remove('border-success');
            });

            slot.addEventListener('drop', (e) => {
                e.preventDefault();
                slot.classList.remove('border-success');
                const tokenId = e.dataTransfer.getData('text/plain');
                const token = document.querySelector(`.p2-token[data-token-id="${tokenId}"]`);
                if (token) {
                    placeTokenInSlot(token, slot);
                }
            });

            slot.addEventListener('click', () => {
                if (selectedTokenElement) {
                    placeTokenInSlot(selectedTokenElement, slot);
                    selectedTokenElement.classList.remove('border-white', 'border-2');
                    selectedTokenElement = null;
                }
            });
        });
    }

    function placeTokenInSlot(token, slot) {
        // Если в слоте уже был токен — вернуть его в пул
        const existingToken = slot.querySelector('.p2-token');
        if (existingToken) {
            document.getElementById('p2-tokens-pool').appendChild(existingToken);
        }

        slot.innerHTML = '';
        slot.appendChild(token);
        slot.dataset.placedSlot = token.dataset.expectedSlot;
        checkPhase2Completion();
    }

    function checkPhase2Completion() {
        const slots = document.querySelectorAll('.slot-target');
        let filledCount = 0;
        slots.forEach(s => {
            if (s.querySelector('.p2-token')) {
                filledCount++;
            }
        });

        document.getElementById('p2-verify-btn').disabled = (filledCount < 5);
    }

    document.getElementById('p2-verify-btn').addEventListener('click', () => {
        const step1 = document.querySelector('.slot-target[data-slot="step1"]').dataset.placedSlot;
        const step2 = document.querySelector('.slot-target[data-slot="step2"]').dataset.placedSlot;
        const step3 = document.querySelector('.slot-target[data-slot="step3"]').dataset.placedSlot;
        const step4 = document.querySelector('.slot-target[data-slot="step4"]').dataset.placedSlot;
        const step5 = document.querySelector('.slot-target[data-slot="step5"]').dataset.placedSlot;

        const isCorrect = (step1 === 'step1' && step2 === 'step2' && step3 === 'step3' && step4 === 'step4' && step5 === 'step5');

        if (isCorrect) {
            sendTelemetry('in_progress', 'in_progress', false);
            // Переход на Фазу 3
            document.getElementById('phase-2-container').classList.add('d-none');
            document.getElementById('phase-3-container').classList.remove('d-none');
            document.getElementById('phase-badge').textContent = 'Шаг 3 из 3';
            document.getElementById('phase-title').textContent = 'Пульт аналитической калибровки: Представление результатов';
            currentPhase = 3;
            setupPhase3();
        } else {
            triggerFailure('Нарушена логика конвейера или встроен псевдонаучный дистрактор!', setupPhase2);
        }
    });

    // =========================================================================
    // ФАЗА 3: ПУЛЬТ АНАЛИТИЧЕСКОЙ КАЛИБРОВКИ И ДАШБОРДА
    // =========================================================================

    const formatCycle = [
        { state: 'pie', label: 'Круговая диаграмма (Срез долей целого)', valid: false, err: 'НЕСООТВЕТСТВИЕ СЕМАНТИКЕ ВРЕМЕНИ' },
        { state: 'line', label: 'Линейный график (Временной ряд динамики)', valid: true, err: 'ОК: КОРРЕКТНЫЙ ФОРМАТ' },
        { state: 'radar', label: 'Лепестковая диаграмма (Многоосевой профиль)', valid: false, err: 'НЕПРИГОДНО ДЛЯ ВРЕМЕННОГО РЯДА' },
        { state: 'heatmap', label: 'Тепловая карта (Пространственная плотность ГИС)', valid: false, err: 'ОТСУТСТВУЕТ ГЕОПРИВЯЗКА' }
    ];
    let formatIndex = 0;

    const axisCycle = [
        { state: 'truncated', label: 'Усеченная шкала (Срез 95%..100% // Манипуляция)', valid: false, err: 'МАСШТАБ ИСКАЖЕН (ГИПЕРБОЛИЗАЦИЯ)' },
        { state: 'zero_based', label: 'Честная шкала (Базис Y = 0 // Объективный масштаб)', valid: true, err: 'ОК: ОБЪЕКТИВНЫЙ МАСШТАБ' }
    ];
    let axisIndex = 0;

    function setupPhase3() {
        formatIndex = 0; // pie
        axisIndex = 0; // truncated
        const sDelta = document.getElementById('slider-delta');
        const sStep = document.getElementById('slider-step');

        sDelta.value = 14;
        sStep.value = 25;

        updatePhase3UI();
    }

    document.getElementById('toggle-format-btn').addEventListener('click', () => {
        formatIndex = (formatIndex + 1) % formatCycle.length;
        updatePhase3UI();
    });

    document.getElementById('toggle-axis-btn').addEventListener('click', () => {
        axisIndex = (axisIndex + 1) % axisCycle.length;
        updatePhase3UI();
    });

    document.getElementById('slider-delta').addEventListener('input', updatePhase3UI);
    document.getElementById('slider-step').addEventListener('input', updatePhase3UI);

    function updatePhase3UI() {
        const curFormat = formatCycle[formatIndex];
        const curAxis = axisCycle[axisIndex];
        const deltaVal = parseInt(document.getElementById('slider-delta').value, 10);
        const stepVal = parseInt(document.getElementById('slider-step').value, 10);
        const stepSec = (stepVal / 10).toFixed(1);

        // Обновление кнопок
        const btnFormat = document.getElementById('toggle-format-btn');
        btnFormat.dataset.state = curFormat.state;
        btnFormat.className = `btn ${curFormat.valid ? 'btn-outline-success' : 'btn-outline-danger'} rounded-0 w-100 text-start py-2 px-3 fw-bold`;
        btnFormat.querySelector('.status-label').textContent = curFormat.label;

        const btnAxis = document.getElementById('toggle-axis-btn');
        btnAxis.dataset.state = curAxis.state;
        btnAxis.className = `btn ${curAxis.valid ? 'btn-outline-success' : 'btn-outline-danger'} rounded-0 w-100 text-start py-2 px-3 fw-bold`;
        btnAxis.querySelector('.status-label').textContent = curAxis.label;

        // Обновление текстовых значений слайдеров
        const elDeltaVal = document.getElementById('val-delta');
        elDeltaVal.textContent = `${deltaVal}%`;
        const isDeltaValid = deltaVal <= 5;
        elDeltaVal.className = `badge ${isDeltaValid ? 'bg-success' : 'bg-danger'} rounded-0 font-monospace fs-6`;

        const elStepVal = document.getElementById('val-step');
        elStepVal.textContent = `${stepSec} с`;
        const isStepValid = (stepVal >= 2 && stepVal <= 5); // 0.2c - 0.5c
        elStepVal.className = `badge ${isStepValid ? 'bg-success' : 'bg-warning text-dark'} rounded-0 font-monospace fs-6`;

        // Диагностика
        const diagFormat = document.getElementById('diag-format');
        diagFormat.textContent = curFormat.err;
        diagFormat.className = curFormat.valid ? 'text-success' : 'text-danger';

        const diagAxis = document.getElementById('diag-axis');
        diagAxis.textContent = curAxis.err;
        diagAxis.className = curAxis.valid ? 'text-success' : 'text-danger';

        const diagDelta = document.getElementById('diag-delta');
        diagDelta.textContent = isDeltaValid ? 'ОК: ПОГРЕШНОСТЬ В НОРМЕ (≤ 5%)' : `ПРЕВЫШЕНИЕ ДОПУСКА (${deltaVal}% > 5%)`;
        diagDelta.className = isDeltaValid ? 'text-success' : 'text-danger';

        const diagStep = document.getElementById('diag-step');
        diagStep.textContent = isStepValid ? 'ОК: ОПТИМАЛЬНАЯ ДИСКРЕТИЗАЦИЯ' : (stepVal < 2 ? 'ИЗБЫТОЧНАЯ ВЫЧИСЛИТЕЛЬНАЯ НАГРУЗКА' : 'СЛИШКОМ ГРУБЫЙ ШАГ (ПОТЕРЯ ФАКТОРОВ)');
        diagStep.className = isStepValid ? 'text-success' : 'text-warning';

        // Рендер графика в SVG
        renderPreviewGraph(curFormat.state, curAxis.state, isDeltaValid, isStepValid, deltaVal, stepVal);

        // Общий статус
        const isAllValid = curFormat.valid && curAxis.valid && isDeltaValid && isStepValid;
        const monBadge = document.getElementById('monitor-badge');
        if (isAllValid) {
            monBadge.textContent = 'МОДЕЛЬ АДЕКВАТНА // ВИЗУАЛИЗАЦИЯ ВАЛИДНА';
            monBadge.className = 'badge bg-success text-dark rounded-0';
            document.getElementById('p3-verify-btn').disabled = false;
        } else {
            monBadge.textContent = 'ПАРАМЕТРЫ ТРЕБУЮТ КАЛИБРОВКИ';
            monBadge.className = 'badge bg-danger text-light rounded-0';
            document.getElementById('p3-verify-btn').disabled = true;
        }
    }

    function renderPreviewGraph(format, axis, isDeltaOk, isStepOk, delta, step) {
        const g = document.getElementById('svg-content');
        g.innerHTML = '';

        if (format === 'pie') {
            // Рисуем круговую диаграмму (ошибочно для временного ряда)
            g.innerHTML = `
                <circle cx="210" cy="95" r="55" fill="#333" stroke="#e63946" stroke-width="2" />
                <path d="M 210,95 L 210,40 A 55,55 0 0,1 260,115 Z" fill="#e63946" />
                <path d="M 210,95 L 260,115 A 55,55 0 0,1 170,135 Z" fill="#457b9d" />
                <text x="210" y="180" fill="#e63946" font-size="11" text-anchor="middle" font-family="monospace">
                    [КРУГОВАЯ ДИАГРАММА НЕ ОТРАЖАЕТ ДИНАМИКУ ВО ВРЕМЕНИ]
                </text>
            `;
            return;
        }

        if (format === 'radar') {
            g.innerHTML = `
                <polygon points="210,45 255,80 240,140 180,140 165,80" fill="none" stroke="#e63946" stroke-width="2" />
                <polygon points="210,65 240,90 230,125 190,125 180,90" fill="#e63946" fill-opacity="0.3" stroke="#e63946" stroke-width="1" />
                <text x="210" y="180" fill="#e63946" font-size="11" text-anchor="middle" font-family="monospace">
                    [ЛЕПЕСТКОВЫЙ ПРОФИЛЬ НЕ ПРИГОДЕН ДЛЯ ВРЕМЕННОГО РЯДА]
                </text>
            `;
            return;
        }

        if (format === 'heatmap') {
            g.innerHTML = `
                <rect x="100" y="50" width="40" height="40" fill="#1d3557" />
                <rect x="145" y="50" width="40" height="40" fill="#457b9d" />
                <rect x="190" y="50" width="40" height="40" fill="#e63946" />
                <rect x="235" y="50" width="40" height="40" fill="#f1faee" />
                <rect x="280" y="50" width="40" height="40" fill="#457b9d" />
                <text x="210" y="180" fill="#e63946" font-size="11" text-anchor="middle" font-family="monospace">
                    [ТЕПЛОВАЯ КАРТА НЕ ИМЕЕТ ГЕОГРАФИЧЕСКИХ КООРДИНАТ]
                </text>
            `;
            return;
        }

        // Формат 'line' — строим график
        const isTruncated = (axis === 'truncated');
        const strokeColor = (isDeltaOk && isStepOk && !isTruncated) ? '#2ecc71' : '#e63946';

        // Генерация точек симуляции
        let pathD = '';
        const numPoints = isStepOk ? 18 : (step < 2 ? 35 : 6);
        const yBase = isTruncated ? 160 : 170;
        const amplitude = isTruncated ? 80 : 40; // Усеченная ось визуально взрывает колебания

        for (let i = 0; i <= numPoints; i++) {
            const x = 40 + (i / numPoints) * 330;
            // Кривая логистического роста с шумом от delta
            const progress = i / numPoints;
            const trend = 1 / (1 + Math.exp(-6 * (progress - 0.4)));
            const noise = (Math.sin(i * 2.3) * (delta / 25)) * (isTruncated ? 25 : 10);
            const y = yBase - (trend * amplitude) - noise;
            
            pathD += (i === 0 ? `M ${x.toFixed(1)},${y.toFixed(1)}` : ` L ${x.toFixed(1)},${y.toFixed(1)}`);
        }

        g.innerHTML = `
            <path d="${pathD}" fill="none" stroke="${strokeColor}" stroke-width="${isStepOk ? 2.5 : 1.5}" stroke-linejoin="round" />
            <text x="45" y="30" fill="${strokeColor}" font-size="10" font-family="monospace">
                ${isTruncated ? 'Ось Y: [95%..100%] (ИСКАЖЕНИЕ!)' : 'Ось Y: [0%..100%] (ОБЪЕКТИВНО)'}
            </text>
            <text x="375" y="165" fill="#888" font-size="9" text-anchor="end" font-family="monospace">Время t →</text>
        `;
    }

    document.getElementById('p3-verify-btn').addEventListener('click', () => {
        const curFormat = formatCycle[formatIndex];
        const curAxis = axisCycle[axisIndex];
        const deltaVal = parseInt(document.getElementById('slider-delta').value, 10);
        const stepVal = parseInt(document.getElementById('slider-step').value, 10);

        const isDeltaValid = deltaVal <= 5;
        const isStepValid = (stepVal >= 2 && stepVal <= 5);

        if (curFormat.valid && curAxis.valid && isDeltaValid && isStepValid) {
            // Финиш уровня
            document.getElementById('phase-3-container').classList.add('d-none');
            document.getElementById('final-screen').classList.remove('d-none');
            document.getElementById('phase-badge').textContent = 'Завершено';
            document.getElementById('phase-badge').className = 'badge bg-success text-dark rounded-0 fs-6 me-2';
            document.getElementById('phase-title').textContent = 'Уровень 1 успешно пройден';

            const timeSpent = Math.max(1, Math.round((Date.now() - startTime) / 1000));
            document.getElementById('stat-time').textContent = `${timeSpent} с`;
            document.getElementById('stat-attempts').textContent = attemptsCount;

            sendTelemetry('level_complete', 'completed', true);
        } else {
            triggerFailure('Параметры аналитического представления не удовлетворяют критериям адекватности!', setupPhase3);
        }
    });

    // Инициализация при загрузке
    setupPhase1();
    setupDragAndDropPhase1();

    // =========================================================================
    // DEV / E2E TEST HOOKS
    // =========================================================================
    window.__DEV_LEVEL1_STATE__ = {
        solvePhase1() {
            // Раскладывает все карточки по их правильным корзинам
            const cards = Array.from(document.querySelectorAll('#p1-cards-pool .phase1-card'));
            cards.forEach(card => {
                const targetBucket = document.getElementById(`bucket-${card.dataset.expectedType}`);
                if (targetBucket) {
                    targetBucket.querySelector('.bucket-slots').appendChild(card);
                }
            });
            updatePhase1Counters();
            document.getElementById('p1-verify-btn').click();
        },
        solvePhase2() {
            // Раскладывает все 5 этапов конвейера
            const steps = ['step1', 'step2', 'step3', 'step4', 'step5'];
            steps.forEach(stepName => {
                const token = document.querySelector(`.p2-token[data-expected-slot="${stepName}"]`);
                const slot = document.querySelector(`.slot-target[data-slot="${stepName}"]`);
                if (token && slot) {
                    placeTokenInSlot(token, slot);
                }
            });
            document.getElementById('p2-verify-btn').click();
        },
        solvePhase3() {
            // Устанавливает верные параметры Фазы 3
            formatIndex = 1; // line
            axisIndex = 1; // zero_based
            document.getElementById('slider-delta').value = 4;
            document.getElementById('slider-step').value = 3;
            updatePhase3UI();
            document.getElementById('p3-verify-btn').click();
        }
    };

})();
</script>
