                { slot: 'step2', name: 'Информационная модель', desc: 'Абстрагирование: отсечение дизайна профилей, выделение графа связей' },
                { slot: 'step3', name: 'Математическая модель', desc: 'Построение системы уравнений диффузии информации' },
                { slot: 'step4', name: 'Компьютерный алгоритм', desc: 'Разработка симулятора на Python и серия из 500 вычислительных прогонов' },
                { slot: 'step5', name: 'Оценка адекватности', desc: 'Сопоставление расчетных кривых с фактической статистикой просмотров' }
            ],
            distractors: [
