    let currentPhase1Cards = [];

    function setupPhase1() {
        const pool = document.getElementById('p1-cards-pool');
        pool.innerHTML = '';
        selectedCardElement = null;

        // Очистить корзины
        document.querySelectorAll('.bucket-slots').forEach(b => b.innerHTML = '');
        updatePhase1Counters();

        // Процедурно выбираем по 2 карточки каждого типа (всего 6)
        const materials = phase1Bank.filter(x => x.type === 'material').sort(() => 0.5 - Math.random()).slice(0, 2);
        const statics = phase1Bank.filter(x => x.type === 'static').sort(() => 0.5 - Math.random()).slice(0, 2);
        const dynamics = phase1Bank.filter(x => x.type === 'dynamic').sort(() => 0.5 - Math.random()).slice(0, 2);

        currentPhase1Cards = [...materials, ...statics, ...dynamics].sort(() => 0.5 - Math.random());

        currentPhase1Cards.forEach(item => {
            const card = createPhase1Card(item);
            pool.appendChild(card);
        });

        document.getElementById('p1-verify-btn').disabled = true;
    }

    function createPhase1Card(item) {
        const card = document.createElement('div');
        card.className = 'phase1-card card bg-black border border-secondary rounded-0 p-2 text-start user-select-none mb-2';
        card.style.cursor = 'grab';
        card.style.minHeight = '52px';
        card.style.width = 'calc(50% - 4px)';
        card.draggable = true;
        card.dataset.id = item.id;
        card.dataset.expectedType = item.type;

        card.innerHTML = `
            <div class="fw-bold text-light small">${item.name}</div>
            <div class="text-secondary" style="font-size: 0.75rem;">${item.desc}</div>
        `;

        card.addEventListener('dragstart', (e) => {
            e.dataTransfer.setData('text/plain', item.id);
            card.classList.add('opacity-50');
        });

        card.addEventListener('dragend', () => {
            card.classList.remove('opacity-50');
        });

        card.addEventListener('click', (e) => {
            e.stopPropagation();
            if (card.parentElement.id === 'p1-cards-pool') {
                if (selectedCardElement === card) {
                    card.classList.remove('border-white', 'border-2');
                    selectedCardElement = null;
                } else {
                    if (selectedCardElement) {
                        selectedCardElement.classList.remove('border-white', 'border-2');
                    }
                    selectedCardElement = card;
                    card.classList.add('border-white', 'border-2');
                }
            } else {
                // Если кликнули на карточку в корзине — вернуть в пул
                document.getElementById('p1-cards-pool').appendChild(card);
                updatePhase1Counters();
            }
        });

        return card;
    }

    function setupDragAndDropPhase1() {
        const buckets = [
            document.getElementById('bucket-material'),
            document.getElementById('bucket-static'),
            document.getElementById('bucket-dynamic')
        ];

        buckets.forEach(bucket => {
            const slot = bucket.querySelector('.bucket-slots');

            slot.addEventListener('dragover', (e) => {
                e.preventDefault();
                bucket.classList.add('border-white');
            });

            slot.addEventListener('dragleave', () => {
                bucket.classList.remove('border-white');
            });

            slot.addEventListener('drop', (e) => {
                e.preventDefault();
                bucket.classList.remove('border-white');
                const cardId = e.dataTransfer.getData('text/plain');
                const card = document.querySelector(`.phase1-card[data-id="${cardId}"]`);
                if (card) {
                    slot.appendChild(card);
                    if (selectedCardElement === card) {
                        card.classList.remove('border-white', 'border-2');
                        selectedCardElement = null;
                    }
                    updatePhase1Counters();
                }
            });

            slot.addEventListener('click', () => {
                if (selectedCardElement) {
                    slot.appendChild(selectedCardElement);
                    selectedCardElement.classList.remove('border-white', 'border-2');
                    selectedCardElement = null;
                    updatePhase1Counters();
                }
            });
        });
    }

    function updatePhase1Counters() {
        const poolCount = document.querySelectorAll('#p1-cards-pool .phase1-card').length;
        document.getElementById('p1-pool-counter').textContent = `Осталось: ${poolCount}`;

        document.querySelectorAll('[data-bucket-type]').forEach(bucket => {
            const count = bucket.querySelectorAll('.phase1-card').length;
            bucket.querySelector('.bucket-counter').textContent = count;
        });

        // Кнопка разблокируется, когда все 6 карточек разложены по корзинам
        document.getElementById('p1-verify-btn').disabled = (poolCount > 0);
    }

    document.getElementById('p1-verify-btn').addEventListener('click', () => {
        let isAllCorrect = true;

        document.querySelectorAll('[data-bucket-type]').forEach(bucket => {
            const bucketType = bucket.dataset.bucketType;
            const placedCards = bucket.querySelectorAll('.phase1-card');
            placedCards.forEach(card => {
                if (card.dataset.expectedType !== bucketType) {
                    isAllCorrect = false;
                }
            });
        });

        if (isAllCorrect) {
            sendTelemetry('in_progress', 'in_progress', false);
            // Переход на Фазу 2
            document.getElementById('phase-1-container').classList.add('d-none');
            document.getElementById('phase-2-container').classList.remove('d-none');
            document.getElementById('phase-badge').textContent = 'Шаг 2 из 3';
            document.getElementById('phase-title').textContent = 'Конструирование конвейера: Этапы компьютерного моделирования';
            currentPhase = 2;
            setupPhase2();
        } else {
            triggerFailure('Некоторые модели отнесены не в свои сектора!', setupPhase1);
        }
    });

    // =========================================================================
    // ФАЗА 2: КОНВЕЙЕР ЭТАПОВ МОДЕЛИРОВАНИЯ (SLOT & SNAP)
    // =========================================================================

    const phase2Scenarios = [
        {
            title: '«Динамика распространения информации в медиапространстве»',
