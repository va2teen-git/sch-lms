---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={2}>
    <div class="container my-4 font-monospace">
        <!-- Верхняя панель заголовка -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 text-warning mb-0">Тренажер: Аналитика и расчет архитектуры архива (Уровень 2)</h2>
            <span class="badge border border-warning text-warning bg-dark rounded-0 px-3 py-2">Ручной ввод // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-warning rounded-0">
            <div class="card-body p-4">
                
                <!-- Шапка и индикаторы текущей фазы -->
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="level-badge" class="badge bg-warning text-dark rounded-0 fs-6 me-2">Шаг 1 из 5</span>
                        <span id="level-title" class="text-light fw-bold fs-6">Коэффициент компрессии и степень сжатия архива</span>
                    </div>
                    <div class="text-secondary small">
                        Попытки: <span id="attempts-display" class="text-warning">0</span>
                    </div>
                </div>

                <!-- Блок оповещений об ошибках -->
                <div id="error-feedback" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    [ОШИБКА РАСЧЕТА] <span id="error-msg">Неверное числовое значение!</span> Перекалибровка данных...
                </div>

                <!-- ================= ФАЗА 1: КОМПРЕССИЯ И СЖАТИЕ ================= -->
                <div id="phase1">
                    <p class="text-light mb-2">
                        Аудит дискового пространства архива выявил параметры сжатия базы данных юридических документов:
                    </p>
                    <div class="card bg-black border border-secondary rounded-0 p-3 mb-3">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <span class="text-secondary small">Исходный несжатый объем (V<sub>исх</sub>):</span>
                                <div class="fs-4 text-info fw-bold"><span id="p1-orig-size">1600</span> МБ</div>
                            </div>
                            <div class="col-md-6">
                                <span class="text-secondary small">Объем сжатого архива 7z Lossless (V<sub>сжат</sub>):</span>
                                <div class="fs-4 text-success fw-bold"><span id="p1-comp-size">400</span> МБ</div>
                            </div>
                        </div>
                    </div>
                    <p class="text-secondary small mb-3">
                        Рассчитайте целочисленный коэффициент сжатия <code>K<sub>сжатия</sub> = V<sub>исх</sub> / V<sub>сжат</sub></code> и степень экономии дискового пространства в процентах <code>S<sub>сжатия</sub> = ((V<sub>исх</sub> - V<sub>сжат</sub>) / V<sub>исх</sub>) × 100%</code>.
                    </p>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-warning small">Коэффициент сжатия K<sub>сжатия</sub> (во сколько раз):</label>
                            <input type="number" id="p1-input-k" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Например: 4" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-warning small">Степень экономии диска S<sub>сжатия</sub> (в %):</label>
                            <input type="number" id="p1-input-percent" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Например: 75" autocomplete="off">
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button id="p1-btn" class="btn btn-warning rounded-0 px-4 py-2 fw-bold text-dark">
                            ПОДТВЕРДИТЬ РАСЧЕТ
                        </button>
                    </div>
                </div>

                <!-- ================= ФАЗА 2: СТРАТЕГИИ БЭКАПА ================= -->
                <div id="phase2" class="d-none">
                    <p class="text-light mb-2">
                        Организация планирует резервное копирование файлового архива на 5 рабочих дней (понедельник — пятница).
                    </p>
                    <div class="card bg-black border border-secondary rounded-0 p-3 mb-3">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <span class="text-secondary small">Базовый Full Backup (Понедельник):</span>
                                <div class="fs-4 text-info fw-bold"><span id="p2-full-size">80</span> ГБ</div>
                            </div>
                            <div class="col-md-6">
                                <span class="text-secondary small">Ежедневный объем изменений (Вт, Ср, Чт, Пт):</span>
                                <div class="fs-4 text-warning fw-bold">+<span id="p2-delta-size">5</span> ГБ в сутки</div>
                            </div>
                        </div>
                    </div>
                    <p class="text-secondary small mb-3">
                        Рассчитайте суммарный объем архивов (в ГБ), накопленный к вечеру пятницы при двух разных стратегиях:
                        <br>1) <strong>Full + Differential</strong> (Полный в Пн + каждый день разница относительно Пн: +5, +10, +15, +20 ГБ);
                        <br>2) <strong>Full + Incremental</strong> (Полный в Пн + каждый день дельта изменений за прошедшие сутки: +5, +5, +5, +5 ГБ).
                    </p>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-warning small">Объем для Full + Differential (в ГБ):</label>
                            <input type="number" id="p2-input-diff" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Сумма в ГБ" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-warning small">Объем для Full + Incremental (в ГБ):</label>
                            <input type="number" id="p2-input-incr" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Сумма в ГБ" autocomplete="off">
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button id="p2-btn" class="btn btn-warning rounded-0 px-4 py-2 fw-bold text-dark">
                            ПОДТВЕРДИТЬ ОБЪЕМЫ
                        </button>
                    </div>
                </div>

                <!-- ================= ФАЗА 3: ПИК ИНВЕРСИИ (RTO / СКОРОСТЬ КАНАЛА) ================= -->
                <div id="phase3" class="d-none">
                    <p class="text-light mb-2">
                        Аварийное восстановление системы (Disaster Recovery). Сервер базы данных потерпел сбой.
                    </p>
                    <div class="card bg-black border border-secondary rounded-0 p-3 mb-3">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <span class="text-secondary small">Объем архива в облаке (V):</span>
                                <div class="fs-4 text-info fw-bold"><span id="p3-archive-gb">180</span> ГБ</div>
                            </div>
                            <div class="col-md-4">
                                <span class="text-secondary small">Целевое время восстановления (RTO):</span>
                                <div class="fs-4 text-danger fw-bold"><span id="p3-rto-min">30</span> минут</div>
                            </div>
                            <div class="col-md-4">
                                <span class="text-secondary small">Регламентное время в секундах:</span>
                                <div class="fs-4 text-light fw-bold"><span id="p3-rto-sec">1800</span> сек</div>
                            </div>
                        </div>
                    </div>
                    <p class="text-secondary small mb-3">
                        Рассчитайте:
                        <br>1) Минимальную скорость загрузки данных из облака в <strong>МБ/с</strong> (приняв 1 ГБ = 1000 МБ для сетевых метрик);
                        <br>2) Необходимую пропускную способность сетевого интернет-канала в <strong>Мбит/с</strong> (учитывая, что 1 байт = 8 бит).
                    </p>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-warning small">Минимальная скорость загрузки (МБ/с):</label>
                            <input type="number" id="p3-input-mbs" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Например: 100" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-warning small">Пропускная способность интернет-канала (Мбит/с):</label>
                            <input type="number" id="p3-input-mbits" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Например: 800" autocomplete="off">
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button id="p3-btn" class="btn btn-warning rounded-0 px-4 py-2 fw-bold text-dark">
                            ПОДТВЕРДИТЬ СКОРОСТЬ КАНАЛА
                        </button>
                    </div>
                </div>

                <!-- ================= ФАЗА 4: КОНТРОЛЬ ЦЕЛОСТНОСТИ SHA-256 ================= -->
                <div id="phase4" class="d-none">
                    <p class="text-light mb-2">
                        Аудит целостности архива. Система контроля выявила деградацию бит (Bit Rot) в одном из томов:
                    </p>
                    <div class="table-responsive mb-3">
                        <table class="table table-dark table-bordered border-secondary small font-monospace mb-0">
                            <thead>
                                <tr class="text-info">
                                    <th>Том архива</th>
                                    <th>Эталонный хеш SHA-256 (64 hex-символа)</th>
                                    <th>Фактический хеш после проверки</th>
                                </tr>
                            </thead>
                            <tbody id="p4-table-body">
                                <!-- Строки таблицы томов -->
                            </tbody>
                        </table>
                    </div>
                    <p class="text-secondary small mb-3">
                        Укажите номер поврежденного тома архива, у которого нарушена контрольная сумма (1, 2 или 3), и разрядность алгоритма SHA-256 в битах.
                    </p>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-warning small">Номер поврежденного тома (1, 2 или 3):</label>
                            <input type="number" id="p4-input-volume" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="1, 2 или 3" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-warning small">Разрядность хеша SHA-256 (в битах):</label>
                            <input type="number" id="p4-input-bits" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Например: 256" autocomplete="off">
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button id="p4-btn" class="btn btn-warning rounded-0 px-4 py-2 fw-bold text-dark">
                            ПОДТВЕРДИТЬ АУДИТ
                        </button>
                    </div>
                </div>

                <!-- ================= ФАЗА 5: КУЛЬМИНАЦИЯ (ДИСКОВЫЙ БЮДЖЕТ 3-2-1) ================= -->
                <div id="phase5" class="d-none">
                    <p class="text-light mb-2">
                        Финальный расчет бюджета хранилищ для развертывания регламента <strong>«3-2-1»</strong> в издательском доме:
                    </p>
                    <div class="card bg-black border border-secondary rounded-0 p-3 mb-3">
                        <ul class="text-secondary small mb-0 ps-3">
                            <li class="mb-1">Исходный объем рабочего проектного архива: <strong class="text-info"><span id="p5-proj-size">500</span> ГБ</strong> на рабочей станции.</li>
                            <li class="mb-1">Локальный NAS: настроен в зеркальный массив <strong class="text-warning">RAID 1</strong> (2 физических накопителя, каждый хранит полную копию).</li>
                            <li class="mb-1">Облачный архив (Offsite): бэкап сжимается алгоритмом 7z с коэффициентом <strong class="text-success">K<sub>сжатия</sub> = <span id="p5-comp-k">2.5</span></strong>.</li>
                            <li>В облаке поддерживается глубина версионности из <strong class="text-light"><span id="p5-versions-count">4</span> полных недельных снимков</strong>.</li>
                        </ul>
                    </div>
                    <p class="text-secondary small mb-3">
                        Рассчитайте:
                        <br>1) Суммарную физическую емкость двух жестких дисков для локального NAS в режиме RAID 1 (в ГБ);
                        <br>2) Суммарный объем облачного диска для хранения всех 4 сжатых версий архива (в ГБ);
                        <br>3) Итоговую суммарную емкость всех хранилищ инфраструктуры (Рабочая станция + NAS + Облако) в ГБ.
                    </p>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label text-warning small">Емкость двух дисков NAS (ГБ):</label>
                            <input type="number" id="p5-input-nas" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="ГБ" autocomplete="off">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-warning small">Объем облака под версии (ГБ):</label>
                            <input type="number" id="p5-input-cloud" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="ГБ" autocomplete="off">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-warning small">ИТОГО емкость системы (ГБ):</label>
                            <input type="number" id="p5-input-total" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Сумма всех компонентов" autocomplete="off">
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button id="p5-btn" class="btn btn-warning rounded-0 px-4 py-2 fw-bold text-dark">
                            ЗАВЕРШИТЬ РАСЧЕТ ИНФРАСТРУКТУРЫ
                        </button>
                    </div>
                </div>

                <!-- ================= ФИНАЛЬНЫЙ ЭКРАН ================= -->
                <div id="final-screen" class="d-none text-center py-5">
                    <div class="mb-3">
                        <span class="badge bg-warning text-dark rounded-0 fs-5 px-4 py-2">✓ АНАЛИТИЧЕСКИЙ РАСЧЕТ ВЫПОЛНЕН</span>
                    </div>
                    <h3 class="text-light mb-3">Уровень 2 успешно пройден!</h3>
                    <p class="text-secondary mb-4">
                        Вы успешно рассчитали параметры сжатия, объемную модель стратегий резервирования, скоростной порог RTO, криптографические контрольные суммы и полный бюджет емкости «3-2-1».
                    </p>
                    <div class="border border-warning bg-black p-3 d-inline-block text-start mb-4">
                        <div class="text-warning small fw-bold">ОТЧЕТ ТЕЛЕМЕТРИИ О ВЫПОЛНЕНИИ:</div>
                        <div class="text-light small">Событие: <code>level_complete</code></div>
                        <div class="text-light small">Статус: <code>SUCCESS</code></div>
                        <div class="text-light small">Зафиксировано попыток: <span id="final-attempts" class="text-warning">0</span></div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(function() {
    const startTime = Date.now();
    let attemptsCount = 0;
    const missionName = 'Урок 8 :: Организация личного архива информации (Уровень 2)';

    function sendTelemetry(actionType, status, success) {
        const timeSpent = Math.max(1, Math.round((Date.now() - startTime) / 1000));
        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: actionType,
            status: status,
            start_time: new Date(startTime).toISOString(),
            time_spent_sec: timeSpent,
            attempts_count: attemptsCount,
            success: success
        }, '*');
    }

    function recordError(msg, retryFn) {
        attemptsCount++;
        document.getElementById('attempts-display').textContent = attemptsCount;
        sendTelemetry('hardcore_reset', 'failed', false);
        const fb = document.getElementById('error-feedback');
        if (msg) document.getElementById('error-msg').textContent = msg;
        fb.classList.remove('d-none');
        setTimeout(() => {
            fb.classList.add('d-none');
            retryFn();
        }, 1300);
    }

    function advancePhase(currNum, nextNum, nextSetupFn, nextTitle) {
        document.getElementById(`phase${currNum}`).classList.add('d-none');
        document.getElementById(`phase${nextNum}`).classList.remove('d-none');
        document.getElementById('level-badge').textContent = `Шаг ${nextNum} из 5`;
        document.getElementById('level-title').textContent = nextTitle;
        nextSetupFn();
    }

    // =========================================================================
    // ФАЗА 1: КОМПРЕССИЯ И СЖАТИЕ
    // =========================================================================
    let p1ExpectedK = 4;
    let p1ExpectedPercent = 75;

    function setupPhase1() {
        const variants = [
            { orig: 1200, comp: 300, k: 4, pct: 75 },
            { orig: 1600, comp: 400, k: 4, pct: 75 },
            { orig: 2000, comp: 400, k: 5, pct: 80 },
            { orig: 1500, comp: 500, k: 3, pct: 67 },
            { orig: 2400, comp: 600, k: 4, pct: 75 }
        ];
        const v = variants[Math.floor(Math.random() * variants.length)];
        document.getElementById('p1-orig-size').textContent = v.orig;
        document.getElementById('p1-comp-size').textContent = v.comp;
        p1ExpectedK = v.k;
        p1ExpectedPercent = v.pct;

        document.getElementById('p1-input-k').value = '';
        document.getElementById('p1-input-percent').value = '';
    }

    document.getElementById('p1-btn').addEventListener('click', checkPhase1);
    function checkPhase1() {
        const userK = parseInt(document.getElementById('p1-input-k').value.trim());
        const userPct = parseInt(document.getElementById('p1-input-percent').value.trim());

        if (userK === p1ExpectedK && (userPct === p1ExpectedPercent || Math.abs(userPct - p1ExpectedPercent) <= 1)) {
            sendTelemetry('in_progress', 'phase1_complete', true);
            advancePhase(1, 2, setupPhase2, 'Стратегии резервного копирования: Расчет объемов');
        } else {
            recordError('Неверный расчет коэффициента или процента экономии!', setupPhase1);
        }
    }

    // =========================================================================
    // ФАЗА 2: СТРАТЕГИИ БЭКАПА
    // =========================================================================
    let p2ExpectedDiff = 130;
    let p2ExpectedIncr = 100;

    function setupPhase2() {
        const fulls = [60, 80, 100, 120];
        const deltas = [4, 5, 6, 8];

        const f = fulls[Math.floor(Math.random() * fulls.length)];
        const d = deltas[Math.floor(Math.random() * deltas.length)];

        // Пн (Full) + Вт (+d) + Ср (+2d) + Чт (+3d) + Пт (+4d) = f + 10*d
        p2ExpectedDiff = f + (d * 10);
        // Пн (Full) + 4 дня * d = f + 4*d
        p2ExpectedIncr = f + (d * 4);

        document.getElementById('p2-full-size').textContent = f;
        document.getElementById('p2-delta-size').textContent = d;

        document.getElementById('p2-input-diff').value = '';
        document.getElementById('p2-input-incr').value = '';
    }

    document.getElementById('p2-btn').addEventListener('click', checkPhase2);
    function checkPhase2() {
        const userDiff = parseInt(document.getElementById('p2-input-diff').value.trim());
        const userIncr = parseInt(document.getElementById('p2-input-incr').value.trim());

        if (userDiff === p2ExpectedDiff && userIncr === p2ExpectedIncr) {
            sendTelemetry('in_progress', 'phase2_complete', true);
            advancePhase(2, 3, setupPhase3, 'Пик инверсии: Расчет аварийного RTO и канала');
        } else {
            recordError('Неверный расчет объемов Differential или Incremental архивов!', setupPhase2);
        }
    }

    // =========================================================================
    // ФАЗА 3: RTO / КАНАЛ СВЯЗИ
    // =========================================================================
    let p3ExpectedMbs = 100;
    let p3ExpectedMbits = 800;

    function setupPhase3() {
        const variants = [
            { gb: 180, min: 30, sec: 1800, mbs: 100, mbits: 800 },
            { gb: 90, min: 30, sec: 1800, mbs: 50, mbits: 400 },
            { gb: 120, min: 20, sec: 1200, mbs: 100, mbits: 800 },
            { gb: 240, min: 40, sec: 2400, mbs: 100, mbits: 800 },
            { gb: 72, min: 60, sec: 3600, mbs: 20, mbits: 160 }
        ];
        const v = variants[Math.floor(Math.random() * variants.length)];
        document.getElementById('p3-archive-gb').textContent = v.gb;
        document.getElementById('p3-rto-min').textContent = v.min;
        document.getElementById('p3-rto-sec').textContent = v.sec;

        p3ExpectedMbs = v.mbs;
        p3ExpectedMbits = v.mbits;

        document.getElementById('p3-input-mbs').value = '';
        document.getElementById('p3-input-mbits').value = '';
    }

    document.getElementById('p3-btn').addEventListener('click', checkPhase3);
    function checkPhase3() {
        const userMbs = parseInt(document.getElementById('p3-input-mbs').value.trim());
        const userMbits = parseInt(document.getElementById('p3-input-mbits').value.trim());

        if (userMbs === p3ExpectedMbs && userMbits === p3ExpectedMbits) {
            sendTelemetry('in_progress', 'phase3_complete', true);
            advancePhase(3, 4, setupPhase4, 'Контроль целостности: Аудит хеш-сумм SHA-256');
        } else {
            recordError('Неверная скорость передачи данных или пропускная способность канала!', setupPhase3);
        }
    }

    // =========================================================================
    // ФАЗА 4: КОНТРОЛЬ ЦЕЛОСТНОСТИ SHA-256
    // =========================================================================
    let p4DamagedVolume = 2;

    function genRandomHex(len) {
        const h = '0123456789abcdef';
        let s = '';
        for (let i = 0; i < len; i++) s += h[Math.floor(Math.random() * h.length)];
        return s;
    }

    function setupPhase4() {
        p4DamagedVolume = Math.floor(Math.random() * 3) + 1; // 1, 2 или 3
        const tbody = document.getElementById('p4-table-body');
        tbody.innerHTML = '';

        for (let i = 1; i <= 3; i++) {
            const baseHash = genRandomHex(64);
            let factHash = baseHash;
            if (i === p4DamagedVolume) {
                // Повредить 1 символ в середине
                const pos = 25;
                const origChar = baseHash[pos];
                const newChar = (origChar === 'a') ? 'b' : 'a';
                factHash = baseHash.substring(0, pos) + newChar + baseHash.substring(pos + 1);
            }

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="text-warning fw-bold">Том #${i}</td>
                <td class="text-secondary text-break">${baseHash}</td>
                <td class="${i === p4DamagedVolume ? 'text-danger fw-bold' : 'text-success'} text-break">${factHash}</td>
            `;
            tbody.appendChild(tr);
        }

        document.getElementById('p4-input-volume').value = '';
        document.getElementById('p4-input-bits').value = '';
    }

    document.getElementById('p4-btn').addEventListener('click', checkPhase4);
    function checkPhase4() {
        const userVol = parseInt(document.getElementById('p4-input-volume').value.trim());
        const userBits = parseInt(document.getElementById('p4-input-bits').value.trim());

        if (userVol === p4DamagedVolume && userBits === 256) {
            sendTelemetry('in_progress', 'phase4_complete', true);
            advancePhase(4, 5, setupPhase5, 'Кульминация: Полный бюджет хранилища «3-2-1»');
        } else {
            recordError('Неверный номер поврежденного тома или разрядность хеша!', setupPhase4);
        }
    }

    // =========================================================================
    // ФАЗА 5: КУЛЬМИНАЦИЯ (БЮДЖЕТ ХРАНИЛИЩА 3-2-1)
    // =========================================================================
    let p5ExpectedNas = 1000;
    let p5ExpectedCloud = 800;
    let p5ExpectedTotal = 2300;

    function setupPhase5() {
        const projSizes = [400, 500, 600];
        const proj = projSizes[Math.floor(Math.random() * projSizes.length)];
        const k = 2; // Коэффициент 2
        const versions = 4; // 4 версии

        // NAS RAID 1: 2 накопителя по proj ГБ = 2 * proj
        p5ExpectedNas = proj * 2;
        // Облако: proj / k * versions = (proj / 2) * 4 = proj * 2
        p5ExpectedCloud = Math.round((proj / k) * versions);
        // Итого = Рабочая станция (proj) + NAS (p5ExpectedNas) + Облако (p5ExpectedCloud)
        p5ExpectedTotal = proj + p5ExpectedNas + p5ExpectedCloud;

        document.getElementById('p5-proj-size').textContent = proj;
        document.getElementById('p5-comp-k').textContent = k.toString();
        document.getElementById('p5-versions-count').textContent = versions.toString();

        document.getElementById('p5-input-nas').value = '';
        document.getElementById('p5-input-cloud').value = '';
        document.getElementById('p5-input-total').value = '';
    }

    document.getElementById('p5-btn').addEventListener('click', checkPhase5);
    function checkPhase5() {
        const userNas = parseInt(document.getElementById('p5-input-nas').value.trim());
        const userCloud = parseInt(document.getElementById('p5-input-cloud').value.trim());
        const userTotal = parseInt(document.getElementById('p5-input-total').value.trim());

        if (userNas === p5ExpectedNas && userCloud === p5ExpectedCloud && userTotal === p5ExpectedTotal) {
            sendTelemetry('level_complete', 'passed', true);
            document.getElementById('phase5').classList.add('d-none');
            document.getElementById('final-screen').classList.remove('d-none');
            document.getElementById('final-attempts').textContent = attemptsCount;
        } else {
            recordError('Ошибка в расчете емкости дисков NAS, облака или суммарного объема!', setupPhase5);
        }
    }

    // Слушатели Enter во всех инпутах
    document.querySelectorAll('input').forEach(inp => {
        inp.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                const btn = inp.closest('div[id^="phase"]').querySelector('button');
                if (btn) btn.click();
            }
        });
    });

    // Экспорт объекта состояния для тестов и симуляторов персон
    window.__DEV_LEVEL2_STATE__ = {
        solvePhase1: () => {
            document.getElementById('p1-input-k').value = p1ExpectedK;
            document.getElementById('p1-input-percent').value = p1ExpectedPercent;
            checkPhase1();
        },
        solvePhase2: () => {
            document.getElementById('p2-input-diff').value = p2ExpectedDiff;
            document.getElementById('p2-input-incr').value = p2ExpectedIncr;
            checkPhase2();
        },
        solvePhase3: () => {
            document.getElementById('p3-input-mbs').value = p3ExpectedMbs;
            document.getElementById('p3-input-mbits').value = p3ExpectedMbits;
            checkPhase3();
        },
        solvePhase4: () => {
            document.getElementById('p4-input-volume').value = p4DamagedVolume;
            document.getElementById('p4-input-bits').value = 256;
            checkPhase4();
        },
        solvePhase5: () => {
            document.getElementById('p5-input-nas').value = p5ExpectedNas;
            document.getElementById('p5-input-cloud').value = p5ExpectedCloud;
            document.getElementById('p5-input-total').value = p5ExpectedTotal;
            checkPhase5();
        }
    };

    // Старт
    setupPhase1();
})();
</script>
