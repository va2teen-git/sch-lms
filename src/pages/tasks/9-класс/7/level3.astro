---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={3}>
    <div id="app" class="container-fluid px-2 px-md-3 my-3 font-monospace" v-cloak>
        
        <!-- ========================================== -->
        <!-- 1. СТАРТОВЫЙ ЭКРАН (БРИФИНГ ХАРДКОРА) -->
        <!-- ========================================== -->
        <div v-if="gameState === 'intro'" class="card bg-black border-danger rounded-0 p-3 p-md-4 text-center shadow-lg">
            <div class="fs-2 fs-md-1 text-danger fw-bold mb-2">⚡ CYBER MATRIX PROTOCOL ⚡</div>
            <h2 class="h4 text-light mb-2">СИНТЕЗ МОДЕЛЕЙ В НЕЙРОМАТРИЦЕ // АРХЕТИП 1</h2>
            <p class="text-secondary mb-3 small" style="max-width: 760px; margin: 0 auto;">
                Вы подключаетесь к ядру суперкомпьютера цифровых двойников. Для инициализации модели необходимо 
                синтезировать цепочку классификационных атрибутов через взлом буфера шестнадцатеричной матрицы в стиле <em>Cyberpunk 2077</em>.
            </p>

            <div class="card bg-dark border-secondary rounded-0 p-2 p-md-3 mx-auto mb-3 text-start small" style="max-width: 700px;">
                <div class="text-danger fw-bold mb-2">[ПРОТОКОЛ ХАРДКОР-ИСПЫТАНИЯ // 8 ВОЛН]:</div>
                <div class="text-light mb-1">• <span class="text-warning fw-bold">Попеременный обход матрицы:</span> Вы начинаете с первой строки. Клик в активной строке фиксирует токен в буфер и активирует соответствующий <strong>столбец</strong>. Следующий клик в столбце активирует новую <strong>строку</strong>.</div>
                <div class="text-light mb-1">• <span class="text-warning fw-bold">Целевая цепочка (Target Sequence):</span> Соберите требуемую последовательность атрибутов модели до переполнения буфера памяти.</div>
                <div class="text-light mb-1">• <span class="text-warning fw-bold">Таймер срыва синхронизации:</span> На каждую волну отводится жесткое окно времени (от 12 до 6 секунд). Таймер непрерывно убывает!</div>
                <div class="text-danger fw-bold">• ТОТАЛЬНЫЙ СБРОС (Full Wipeout): Любая ошибка, переполнение буфера мусором или истечение таймера вызывают немедленный сброс на ВОЛНУ 1!</div>
            </div>

            <div>
                <button id="start-btn" @click="startGame" class="btn btn-danger rounded-0 fw-bold px-4 py-2 shadow">
                    ПОДКЛЮЧИТЬСЯ К НЕЙРОМАТРИЦЕ (ВОЛНА 1) →
                </button>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- 2. ИГРОВОЙ ЭКРАН (АРКАДНЫЙ ПРОЦЕСС) -->
        <!-- ========================================== -->
        <div v-else-if="gameState === 'playing'" class="card bg-black border-danger rounded-0 p-2 p-md-3 shadow-lg">
            
            <!-- Информационная панель и таймер -->
            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                <div>
                    <span class="text-secondary small d-block">СЕКТОР НЕЙРОМАТРИЦЫ:</span>
                    <span id="phase-counter" class="text-danger fw-bold fs-5">ВОЛНА <span v-text="currentWave"></span> ИЗ 8</span>
                </div>
                <div class="text-center">
                    <span class="badge border border-danger text-danger bg-dark rounded-0 px-2 px-md-3 py-1">АРХЕТИП 1: CYBER MATRIX</span>
                    <div class="text-secondary small mt-1">Попытка #<span v-text="attempts + 1"></span></div>
                </div>
                <div class="text-end">
                    <span class="text-secondary small d-block">ВРЕМЯ ДО БЛОКИРОВКИ ШЛЮЗА:</span>
                    <span id="timer-display" class="fw-bold fs-5" :class="phaseTimeLeft <= 3.0 ? 'text-danger' : 'text-warning'">
                        <span v-text="phaseTimeLeft.toFixed(1)"></span> сек
                    </span>
                </div>
            </div>

            <!-- Прогресс-бар убывающего таймера -->
            <div class="progress mb-3 bg-dark border border-secondary rounded-0" style="height: 8px;">
                <div class="progress-bar transition-none"
                     :class="phaseTimeLeft <= 3.0 ? 'bg-danger' : 'bg-warning'"
                     role="progressbar"
                     :style="progressBarStyle">
                </div>
            </div>

            <!-- Верхняя панель: Синтезируемая модель и Целевой код -->
            <div class="card bg-dark border-secondary rounded-0 p-2 p-md-3 mb-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="text-secondary small d-block">СИНТЕЗИРУЕМЫЙ ОБЪЕКТ МОДЕЛИРОВАНИЯ:</span>
                        <div class="fs-6 text-light fw-bold mt-1" v-text="currentWaveData.modelName"></div>
                        <div class="text-secondary small" v-text="currentWaveData.modelDesc"></div>
                    </div>
                    <div>
                        <span class="text-secondary small d-block mb-1">ТРЕБУЕМАЯ ПОСЛЕДОВАТЕЛЬНОСТЬ АТРИБУТОВ:</span>
                        <div class="d-flex flex-wrap gap-1 gap-md-2">
                            <span v-for="(token, idx) in currentWaveData.targetSequence" 
                                  :key="idx"
                                  class="badge border rounded-0 px-2 py-1 text-wrap small"
                                  :class="isTargetTokenMatched(idx) ? 'bg-success text-dark border-success' : 'bg-black text-warning border-warning'">
                                <span v-text="token"></span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Панель буфера памяти игрока -->
            <div class="card bg-dark border-secondary rounded-0 p-2 p-md-3 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-1">
                    <span class="text-secondary small">БУФЕР ПАМЯТИ ВЗЛОМА (<span v-text="playerBuffer.length"></span> / <span v-text="bufferLimit"></span>):</span>
                    <span class="small" :class="mode === 'row' ? 'text-warning' : 'text-info'">
                        АКТИВНЫЙ РЕЖИМ: <strong><span v-text="mode === 'row' ? 'СТРОКА ' + (activeRow + 1) : 'СТОЛБЕЦ ' + (activeCol + 1)"></span></strong>
                    </span>
                </div>
                <div class="d-flex gap-1 gap-md-2 w-100 flex-nowrap overflow-hidden">
                    <div v-for="slotIdx in bufferLimit" 
                         :key="slotIdx"
                         class="border rounded-0 p-1 p-md-2 text-center flex-fill font-monospace fw-bold d-flex align-items-center justify-content-center"
                         style="min-width: 0; word-break: break-all; font-size: clamp(0.6rem, 1.6vw, 0.8rem); line-height: 1.1;"
                         :class="playerBuffer[slotIdx - 1] ? 'bg-black text-warning border-warning' : 'bg-dark text-secondary border-secondary opacity-50'">
                        <span v-if="playerBuffer[slotIdx - 1]" v-text="playerBuffer[slotIdx - 1]"></span>
                        <span v-else class="text-secondary">[_]</span>
                    </div>
                </div>
            </div>

            <!-- Сетка Кибер-Матрицы (Cyber Matrix 4x4) -->
            <div class="card bg-black border-danger rounded-0 p-2 p-md-3 mb-3 text-center">
                <div class="text-secondary small mb-2 text-start d-flex justify-content-between flex-wrap gap-1">
                    <span>НАЖИМАЙТЕ ТОЛЬКО НА ПОДСВЕЧЕННЫЕ ЯЧЕЙКИ В АКТИВНОЙ СТРОКЕ ИЛИ СТОЛБЦЕ:</span>
                    <span class="text-danger fw-bold">[ПЕРЕПОЛНЕНИЕ БУФЕРА = ВАЙП]</span>
                </div>

                <div id="matrix-grid" class="d-flex flex-column gap-1 gap-md-2 mx-auto w-100" style="max-width: 680px;">
                    <div v-for="(row, rIdx) in matrix" :key="rIdx" class="d-flex gap-1 gap-md-2 w-100">
                        <button v-for="(cell, cIdx) in row" 
                                :key="cIdx"
                                class="btn rounded-0 flex-fill p-1 p-sm-2 text-center font-monospace fw-bold transition-colors d-flex flex-column justify-content-center align-items-center"
                                style="min-width: 0; overflow: hidden; word-break: break-word; hyphens: auto;"
                                :class="getCellClass(rIdx, cIdx)"
                                :disabled="!isCellClickable(rIdx, cIdx)"
                                @click="handleCellClick(rIdx, cIdx)">
                            <div class="lh-1 text-wrap" style="font-size: clamp(0.65rem, 1.7vw, 0.85rem); word-break: break-word;" v-text="cell.token"></div>
                            <div class="text-secondary mt-1 lh-1" style="font-size: 0.6rem;" v-text="cell.hex"></div>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Аварийное предупреждение при ошибке -->
            <div v-if="crashMessage" class="alert alert-danger bg-black text-danger border border-danger rounded-0 py-2 py-md-3 text-center">
                <div class="fs-6 fw-bold mb-1">🚨 СРЫВ СИНХРОНИЗАЦИИ // ПОЛНЫЙ СБРОС СИСТЕМЫ 🚨</div>
                <div class="small" v-text="crashMessage"></div>
                <div class="small mt-1 text-warning">Возврат на ВОЛНУ 1 через 1.5 сек...</div>
            </div>

        </div>

        <!-- ========================================== -->
        <!-- 3. ЭКРАН ПОБЕДЫ (ХАРДКОР ЗАВЕРШЕН) -->
        <!-- ========================================== -->
        <div v-else-if="gameState === 'victory'" class="card bg-black border-success rounded-0 p-3 p-md-5 text-center shadow-lg">
            <div class="display-4 text-success mb-2">✓ PROTOCOL COMPLETED ✓</div>
            <h2 class="h4 text-light mb-2">НЕЙРОМАТРИЦА СИНТЕЗА ПОЛНОСТЬЮ ПОДЧИНЕНА</h2>
            <p class="text-secondary small mb-3" style="max-width: 720px; margin: 0 auto;">
                Все 8 протоколов классификации моделей безупречно синтезированы без единого срыва буфера. 
                Вы продемонстрировали автоматизм знаний о натурных, информационных, статических и динамических моделях.
            </p>

            <div class="card bg-dark border-success rounded-0 p-3 mx-auto mb-3 text-start font-monospace small" style="max-width: 500px;">
                <div class="text-success fw-bold mb-2">РЕЗУЛЬТАТЫ СЕАНСА ХАРДКОРА:</div>
                <div class="text-light">СТАТУС: <span class="text-success fw-bold">УРОВЕНЬ 3 (ХАРДКОР) СДАН</span></div>
                <div class="text-light">ВСЕГО ВОЛН: <span class="text-warning">8 из 8</span></div>
                <div class="text-light">ОШИБОК / СБРОСОВ: <span class="text-warning" v-text="attempts"></span></div>
                <div class="text-light">ЗАТРАЧЕНО ВРЕМЕНИ: <span class="text-warning" v-text="totalTimeSec"></span> СЕК</div>
            </div>

            <div>
                <button @click="startGame" class="btn btn-outline-success rounded-0 px-4 py-2">
                    ПРОЙТИ ПОВТОРНО (РЕКОРД СКОРОСТИ) ↺
                </button>
            </div>
        </div>

    </div>

    <!-- Подключение локального Vue 3 -->
    <script is:inline src="/static/vue.global.js"></script>

    <script is:inline>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    missionName: 'Урок 7 :: Модели и моделирование. Классификации моделей (Уровень 3)',
                    startTime: Date.now(),
                    gameState: 'intro', // 'intro', 'playing', 'victory'
                    currentWave: 1,
                    totalWaves: 8,
                    attempts: 0,
                    phaseTimeLeft: 10.0,
                    maxPhaseTime: 10.0,
                    timerInterval: null,
                    crashMessage: null,

                    // Матрица и буфер
                    matrix: [],
                    mode: 'row', // 'row' или 'col'
                    activeRow: 0,
                    activeCol: null,
                    playerBuffer: [],
                    bufferLimit: 4,
                    usedCells: {}, // "r,c" -> true

                    // Конфигурации 8 волн
                    wavesCatalog: [
                        {
                            modelName: "Школьный глобус Земли",
                            modelDesc: "Материальный объект из пластмассы, передающий форму и геометрию планеты.",
                            targetSequence: ["НАТУРНАЯ", "СТАТИЧЕСКАЯ"],
                            timeLimit: 12.0,
                            bufferLimit: 4
                        },
                        {
                            modelName: "Формула второго закона Ньютона: F = m × a",
                            modelDesc: "Описание закона механики на формальном математическом языке.",
                            targetSequence: ["ИНФОРМАЦИОННАЯ", "ЗНАКОВАЯ"],
                            timeLimit: 11.0,
                            bufferLimit: 4
                        },
                        {
                            modelName: "Поэтажный план помещений серверной",
                            modelDesc: "Схема расположения комнат с указанием числовых площадей и размеров.",
                            targetSequence: ["ИНФОРМАЦИОННАЯ", "СТАТИЧЕСКАЯ", "СМЕШАННАЯ"],
                            timeLimit: 10.0,
                            bufferLimit: 4
                        },
                        {
                            modelName: "Траектория полета снаряда в вакууме",
                            modelDesc: "Движение материальной точки во времени с однозначным строгим расчетом.",
                            targetSequence: ["ИНФОРМАЦИОННАЯ", "ДИНАМИЧЕСКАЯ", "ДЕТЕРМИНИРОВАННАЯ"],
                            timeLimit: 9.5,
                            bufferLimit: 5
                        },
                        {
                            modelName: "Симуляция очередей в кассу методом Монте-Карло",
                            modelDesc: "Поведение потока покупателей с учетом случайных распределений и вероятностей.",
                            targetSequence: ["ИНФОРМАЦИОННАЯ", "ДИНАМИЧЕСКАЯ", "СТОХАСТИЧЕСКАЯ"],
                            timeLimit: 9.0,
                            bufferLimit: 5
                        },
                        {
                            modelName: "Топографическая карта с изолиниями высот",
                            modelDesc: "Сочетание графического плана местности, масштаба и высотных отметок.",
                            targetSequence: ["ИНФОРМАЦИОННАЯ", "СТАТИЧЕСКАЯ", "СМЕШАННАЯ"],
                            timeLimit: 8.5,
                            bufferLimit: 5
                        },
                        {
                            modelName: "3D-компьютерная анимация краш-теста автомобиля",
                            modelDesc: "Цифровая покадровая визуализация динамической деформации кузова во времени.",
                            targetSequence: ["ИНФОРМАЦИОННАЯ", "ДИНАМИЧЕСКАЯ", "ОБРАЗНАЯ"],
                            timeLimit: 7.5,
                            bufferLimit: 5
                        },
                        {
                            modelName: "Цифровой двойник газовой турбины (Digital Twin)",
                            modelDesc: "Компьютерная непрерывная симуляция агрегата на основе потока телеметрии IoT.",
                            targetSequence: ["ИНФОРМАЦИОННАЯ", "ДИНАМИЧЕСКАЯ", "СТОХАСТИЧЕСКАЯ", "СМЕШАННАЯ"],
                            timeLimit: 6.5,
                            bufferLimit: 5
                        }
                    ],

                    currentWaveData: {
                        modelName: "",
                        modelDesc: "",
                        targetSequence: [],
                        timeLimit: 10.0,
                        bufferLimit: 4
                    },

                    tokensPool: [
                        "НАТУРНАЯ", "ИНФОРМАЦИОННАЯ", "СТАТИЧЕСКАЯ", "ДИНАМИЧЕСКАЯ",
                        "ОБРАЗНАЯ", "ЗНАКОВАЯ", "СМЕШАННАЯ", "ДЕТЕРМИНИРОВАННАЯ",
                        "СТОХАСТИЧЕСКАЯ", "ДИСКРЕТНАЯ", "НЕПРЕРЫВНАЯ", "ПРОТОТИП"
                    ]
                };
            },

            computed: {
                progressBarStyle() {
                    const pct = Math.max(0, Math.min(100, (this.phaseTimeLeft / this.maxPhaseTime) * 100));
                    return { width: pct + '%' };
                },
                totalTimeSec() {
                    return Math.max(1, Math.floor((Date.now() - this.startTime) / 1000));
                }
            },

            methods: {
                sendTelemetry(actionType, isSuccess = false) {
                    const timeSpent = Math.max(1, Math.floor((Date.now() - this.startTime) / 1000));
                    window.parent.postMessage({
                        type: 'TELEMETRY_EVENT',
                        mission_name: this.missionName,
                        action_type: actionType,
                        status: actionType === 'level_complete' ? 'completed' : 'in_progress',
                        start_time: new Date(this.startTime).toISOString(),
                        time_spent_sec: timeSpent,
                        attempts_count: this.attempts,
                        success: isSuccess,
                        action_log: [{ wave: this.currentWave, action: actionType, time: timeSpent }]
                    }, '*');
                },

                startGame() {
                    this.startTime = Date.now();
                    this.attempts = 0;
                    this.gameState = 'playing';
                    this.sendTelemetry('in_progress');
                    this.initWave(1);
                },

                initWave(waveNum) {
                    clearInterval(this.timerInterval);
                    this.currentWave = waveNum;
                    this.crashMessage = null;

                    const cfg = this.wavesCatalog[waveNum - 1];
                    this.currentWaveData = { ...cfg };
                    this.bufferLimit = cfg.bufferLimit;
                    this.playerBuffer = [];
                    this.usedCells = {};

                    this.phaseTimeLeft = cfg.timeLimit;
                    this.maxPhaseTime = cfg.timeLimit;

                    // Генерация гарантированно разрешимой матрицы 4x4
                    this.generateGuaranteedMatrix(cfg.targetSequence);

                    // Сброс режима обхода на первую строку
                    this.mode = 'row';
                    this.activeRow = 0;
                    this.activeCol = null;

                    // Запуск таймера убывания
                    this.timerInterval = setInterval(() => {
                        this.phaseTimeLeft -= 0.1;
                        if (this.phaseTimeLeft <= 0) {
                            this.phaseTimeLeft = 0;
                            this.handleFailure('Таймер исчерпан! Канал нейроматрицы заблокирован.');
                        }
                    }, 100);
                },

                // Генерация матрицы 4x4 с гарантированным валидным путем Cyberpunk 2077
                generateGuaranteedMatrix(targetSeq) {
                    const rows = 4;
                    const cols = 4;
                    const mat = Array(rows).fill(null).map(() => Array(cols).fill(null));

                    // Шаг 1: стартуем в строке 0
                    const c0 = Math.floor(Math.random() * cols);
                    mat[0][c0] = { token: targetSeq[0], hex: '0x' + Math.floor(Math.random() * 256).toString(16).toUpperCase().padStart(2, '0') };

                    const path = [{ r: 0, c: c0 }];
                    let curR = 0;
                    let curC = c0;
                    let curMode = 'col'; // следующий ход по столбцу curC

                    for (let i = 1; i < targetSeq.length; i++) {
                        if (curMode === 'col') {
                            // Выбираем строку в текущем столбце curC, которая еще не посещена
                            const availableRows = [0, 1, 2, 3].filter(r => r !== curR && !path.some(p => p.r === r && p.c === curC));
                            const nextR = availableRows[Math.floor(Math.random() * availableRows.length)];
                            mat[nextR][curC] = { token: targetSeq[i], hex: '0x' + Math.floor(Math.random() * 256).toString(16).toUpperCase().padStart(2, '0') };
                            path.push({ r: nextR, c: curC });
                            curR = nextR;
                            curMode = 'row';
                        } else {
                            // Выбираем столбец в текущей строке curR, который еще не посещен
                            const availableCols = [0, 1, 2, 3].filter(c => c !== curC && !path.some(p => p.r === curR && p.c === c));
                            const nextC = availableCols[Math.floor(Math.random() * availableCols.length)];
                            mat[curR][nextC] = { token: targetSeq[i], hex: '0x' + Math.floor(Math.random() * 256).toString(16).toUpperCase().padStart(2, '0') };
                            path.push({ r: curR, c: nextC });
                            curC = nextC;
                            curMode = 'col';
                        }
                    }

                    // Заполняем оставшиеся ячейки случайными дистракторами.
                    // Дистракторы не должны создавать ложных дубликатов на активных линиях пути, ведущих в тупик!
                    for (let r = 0; r < rows; r++) {
                        for (let c = 0; c < cols; c++) {
                            if (!mat[r][c]) {
                                const forbidden = new Set();
                                // В строке 0 запрещен первый целевой токен кроме истинной клетки path[0]
                                if (r === 0) forbidden.add(targetSeq[0]);
                                // В столбце path[0].c запрещен второй целевой токен кроме path[1]
                                if (c === path[0].c && targetSeq[1]) forbidden.add(targetSeq[1]);
                                // В строке path[1].r запрещен третий целевой токен кроме path[2]
                                if (path[1] && r === path[1].r && targetSeq[2]) forbidden.add(targetSeq[2]);
                                // В столбце path[2].c запрещен четвертый целевой токен кроме path[3]
                                if (path[2] && c === path[2].c && targetSeq[3]) forbidden.add(targetSeq[3]);

                                const validDistractors = this.tokensPool.filter(t => !forbidden.has(t));
                                const distractor = validDistractors[Math.floor(Math.random() * validDistractors.length)];
                                mat[r][c] = {
                                    token: distractor,
                                    hex: '0x' + Math.floor(Math.random() * 256).toString(16).toUpperCase().padStart(2, '0')
                                };
                            }
                        }
                    }

                    this.matrix = mat;
                },

                isCellClickable(r, c) {
                    if (this.usedCells[`${r},${c}`]) return false;
                    if (this.mode === 'row') {
                        return r === this.activeRow;
                    } else {
                        return c === this.activeCol;
                    }
                },

                getCellClass(r, c) {
                    if (this.usedCells[`${r},${c}`]) {
                        return 'btn-secondary opacity-25 border-0';
                    }
                    if (this.isCellClickable(r, c)) {
                        return this.mode === 'row' 
                            ? 'btn-outline-warning border-2 shadow-sm text-warning' 
                            : 'btn-outline-info border-2 shadow-sm text-info';
                    }
                    return 'btn-dark text-secondary border-secondary opacity-40';
                },

                handleCellClick(r, c) {
                    if (!this.isCellClickable(r, c)) return;

                    const cell = this.matrix[r][c];
                    this.usedCells[`${r},${c}`] = true;
                    this.playerBuffer.push(cell.token);

                    // Проверяем совпадение целевой последовательности
                    if (this.checkTargetMatched()) {
                        // Успех текущей волны!
                        clearInterval(this.timerInterval);
                        if (this.currentWave >= this.totalWaves) {
                            // Финал хардкора!
                            this.gameState = 'victory';
                            this.sendTelemetry('level_complete', true);
                        } else {
                            this.initWave(this.currentWave + 1);
                        }
                        return;
                    }

                    // Проверяем переполнение буфера
                    if (this.playerBuffer.length >= this.bufferLimit) {
                        this.handleFailure('Буфер памяти переполнен мусорными токенами! Аварийный сброс.');
                        return;
                    }

                    // Переключение режима обхода строка <-> столбец
                    if (this.mode === 'row') {
                        this.mode = 'col';
                        this.activeCol = c;
                        this.activeRow = null;
                    } else {
                        this.mode = 'row';
                        this.activeRow = r;
                        this.activeCol = null;
                    }
                },

                // Проверка, собрана ли целевая последовательность как непрерывный подмассив
                checkTargetMatched() {
                    const target = this.currentWaveData.targetSequence;
                    const buf = this.playerBuffer;
                    if (buf.length < target.length) return false;

                    for (let start = 0; start <= buf.length - target.length; start++) {
                        let match = true;
                        for (let i = 0; i < target.length; i++) {
                            if (buf[start + i] !== target[i]) {
                                match = false;
                                break;
                            }
                        }
                        if (match) return true;
                    }
                    return false;
                },

                isTargetTokenMatched(tokenIdx) {
                    const target = this.currentWaveData.targetSequence;
                    const buf = this.playerBuffer;
                    // Проверяем частичное совпадение с конца буфера
                    const matchedCount = this.getContiguousMatchedCount();
                    return tokenIdx < matchedCount;
                },

                getContiguousMatchedCount() {
                    const target = this.currentWaveData.targetSequence;
                    const buf = this.playerBuffer;
                    // Ищем максимальный суффикс buf, являющийся префиксом target
                    for (let len = Math.min(buf.length, target.length); len > 0; len--) {
                        let match = true;
                        const bufStart = buf.length - len;
                        for (let i = 0; i < len; i++) {
                            if (buf[bufStart + i] !== target[i]) {
                                match = false;
                                break;
                            }
                        }
                        if (match) return len;
                    }
                    return 0;
                },

                handleFailure(reason) {
                    clearInterval(this.timerInterval);
                    this.attempts++;
                    this.crashMessage = reason;
                    this.sendTelemetry('hardcore_reset', false);

                    // Задержка 1.5 сек и жесткий сброс на волну 1!
                    setTimeout(() => {
                        this.crashMessage = null;
                        this.initWave(1);
                    }, 1500);
                }
            }
        }).mount('#app');
    </script>
</TaskLayout>
