                    osc.frequency.linearRampToValueAtTime(250, now + 0.34);
                    gain.gain.setValueAtTime(0.18, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.45);
                    osc.start(now);
                    osc.stop(now + 0.46);
                } else if (type === 'victory') {
                    osc.type = 'triangle';
                    [523.25, 659.25, 783.99, 1046.5].forEach((freq, idx) => {
                        osc.frequency.setValueAtTime(freq, now + idx * 0.1);
                    });
                    gain.gain.setValueAtTime(0.16, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.52);
                    osc.start(now);
                    osc.stop(now + 0.54);
                }
            } catch (e) {}
        }

        // --- БАЗОВЫЕ ТОПОЛОГИИ SVG (БЕЗ ПЕРЕКРЫТИЯ УЗЛОВ, ДИАМЕТР >= 58 ед.) ---
        const LABELS_SHORTEST = ['А', 'Б', 'В', 'Г', 'Д', 'Е'];
        const LABELS_DAG = ['А', 'Б', 'В', 'Г', 'Д', 'Е', 'Ж'];

        const LAYOUT_5 = [
            { id: 0, label: 'А', x: 58,  y: 155 },
            { id: 1, label: 'Б', x: 205, y: 58 },
            { id: 2, label: 'В', x: 205, y: 252 },
            { id: 3, label: 'Г', x: 375, y: 155 },
            { id: 4, label: 'Д', x: 522, y: 155 }
        ];
        const EDGES_5 = [
            [0, 1], [0, 2], [0, 3], [1, 2], [1, 3], [1, 4], [2, 3], [2, 4], [3, 4]
        ];

        const LAYOUT_6 = [
            { id: 0, label: 'А', x: 55,  y: 155 },
            { id: 1, label: 'Б', x: 195, y: 58 },
            { id: 2, label: 'В', x: 195, y: 252 },
            { id: 3, label: 'Г', x: 375, y: 58 },
            { id: 4, label: 'Д', x: 375, y: 252 },
            { id: 5, label: 'Е', x: 525, y: 155 }
        ];
        const EDGES_6 = [
            [0, 1], [0, 2], [1, 2], [1, 3], [1, 4], [2, 3], [2, 4], [3, 4], [3, 5], [4, 5]
        ];

        const LAYOUT_7_DAG = [
            { id: 0, label: 'А', x: 52,  y: 155 },
            { id: 1, label: 'Б', x: 175, y: 62 },
            { id: 2, label: 'В', x: 175, y: 248 },
