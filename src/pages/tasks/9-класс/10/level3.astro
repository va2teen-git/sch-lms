            { id: 4, label: 'Д', x: 435, y: 62 },
            { id: 5, label: 'Е', x: 435, y: 248 },
            { id: 6, label: 'Ж', x: 532, y: 155 }
        ];

        // Конфигурация 10 волн (Таймер: Волна 1 >= 30с, минимум >= 15с, передышка на Волне 8)
        const WAVE_SPECS = [
            { wave: 1, mode: 'shortest', nodeCount: 5, directed: false, showWeightsOnSvg: true,  showMatrix: false, useHoneypot: false, useForbidden: false, useRequired: false, timeLimit: 32.0, title: 'ВОЛНА 1 :: КАЛИБРОВКА ТРАССЫ', directive: 'Найдите кратчайший путь от А до Д по весам на рёбрах графа.' },
            { wave: 2, mode: 'shortest', nodeCount: 5, directed: false, showWeightsOnSvg: false, showMatrix: true,  useHoneypot: false, useForbidden: false, useRequired: false, timeLimit: 30.0, title: 'ВОЛНА 2 :: МАТРИЧНАЯ СИНХРОНИЗАЦИЯ', directive: 'Веса скрыты на схеме — считайте их из Весовой матрицы и проложите кратчайший путь А → Д.' },
            { wave: 3, mode: 'shortest', nodeCount: 6, directed: false, showWeightsOnSvg: true,  showMatrix: false, useHoneypot: true,  useForbidden: false, useRequired: false, timeLimit: 26.0, title: 'ВОЛНА 3 :: ЛОВУШКА HONEYPOT', directive: 'Дойдите от А до Е с минимальной длиной пути, избегая красной ловушки ICE!' },
            { wave: 4, mode: 'dag',      nodeCount: 6, directed: true,  showWeightsOnSvg: false, showMatrix: false, useHoneypot: false, useForbidden: false, useRequired: false, timeLimit: 24.0, title: 'ВОЛНА 4 :: КАСКАД DAG #1', directive: 'Вычислите точное количество различных путей в ациклическом графе от А до Е.' },
            { wave: 5, mode: 'shortest', nodeCount: 6, directed: true,  showWeightsOnSvg: false, showMatrix: true,  useHoneypot: false, useForbidden: false, useRequired: false, timeLimit: 22.0, title: 'ВОЛНА 5 :: ОРИЕНТИРОВАННАЯ МАТРИЦА', directive: 'Асимметричная матрица (строка → столбец)! Проложите кратчайший направленный путь А → Е.' },
