            { wave: 7, mode: 'dag',      nodeCount: 7, directed: true,  showWeightsOnSvg: false, showMatrix: false, useHoneypot: false, useForbidden: true,  useRequired: false, timeLimit: 18.5, title: 'ВОЛНА 7 :: ОБХОД БЛОКИРОВКИ DAG', directive: 'Подсчитайте число путей из А в Ж, НЕ проходящих через заблокированный узел!' },
            { wave: 8, mode: 'shortest', nodeCount: 6, directed: false, showWeightsOnSvg: true,  showMatrix: false, useHoneypot: false, useForbidden: false, useRequired: true,  timeLimit: 21.5, title: 'ВОЛНА 8 :: ПЕРЕДЫШКА // ОБЯЗАТЕЛЬНОЕ РЕЛЕ', directive: 'Смена правил (+3 сек): кратчайший путь А → Е ОБЯЗАН пройти через зелёный узел-реле!' },
            { wave: 9, mode: 'shortest', nodeCount: 6, directed: true,  showWeightsOnSvg: false, showMatrix: true,  useHoneypot: false, useForbidden: false, useRequired: true,  timeLimit: 16.5, title: 'ВОЛНА 9 :: МАТРИЧНЫЙ ТРАНЗИТ', directive: 'По асимметричной матрице найдите кратчайший путь А → Е с обязательным заездом в зелёное реле!' },
            { wave: 10, mode: 'dag',     nodeCount: 7, directed: true,  showWeightsOnSvg: false, showMatrix: false, useHoneypot: false, useForbidden: true,  useRequired: true,  timeLimit: 15.5, title: 'ВОЛНА 10 :: ФИНАЛЬНЫЙ БОСС DAG', directive: 'Вычислите число путей А → Ж, проходящих ЧЕРЕЗ зелёный узел и ИЗБЕГАЮЩИХ красного блока!' }
        ];

        function randInt(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function findExactShortestSimplePath(nodeCount, matrix, targetId, bannedNode, requiredNode) {
            let bestCost = Infinity;
            let bestPath = null;
            const visited = new Array(nodeCount).fill(false);

            function dfs(u, cost, path, hasReq) {
                if (cost >= bestCost) return;
                if (u === targetId) {
                    if (requiredNode === null || hasReq) {
                        bestCost = cost;
                        bestPath = path.slice();
                    }
                    return;
                }
                for (let v = 0; v < nodeCount; v++) {
                    if (visited[v] || v === bannedNode) continue;
                    const w = matrix[u][v];
                    if (w === null || w === undefined) continue;
                    visited[v] = true;
                    path.push(v);
                    dfs(v, cost + w, path, hasReq || v === requiredNode);
                    path.pop();
                    visited[v] = false;
                }
            }

            visited[0] = true;
            dfs(0, 0, [0], requiredNode === 0);
            return { bestCost, bestPath };
        }

        function countDagPaths(nodeCount, adj, startNode, endNode, bannedNode) {
            if (startNode === bannedNode || endNode === bannedNode) return 0;
            const dp = new Array(nodeCount).fill(0);
            dp[startNode] = 1;
            for (let u = 0; u < nodeCount; u++) {
                if (u === bannedNode || dp[u] === 0) continue;
                for (const v of adj[u]) {
                    if (v !== bannedNode) {
                        dp[v] += dp[u];
                    }
                }
            }
            return dp[endNode];
        }

        function generateShortestWave(spec) {
            const is5 = spec.nodeCount === 5;
            const nodes = (is5 ? LAYOUT_5 : LAYOUT_6).map(n => ({ ...n }));
            const basePairs = is5 ? EDGES_5 : EDGES_6;
            const targetId = spec.nodeCount - 1;

            for (let attempt = 0; attempt < 40; attempt++) {
                const matrix = Array.from({ length: spec.nodeCount }, () => Array(spec.nodeCount).fill(null));
                const edges = [];

                for (const [u, v] of basePairs) {
                    // В 5-узловом варианте оставляем ~75-85% рёбер; в 6-узловом ~85%
                    const keepEdge = attempt > 20 || Math.random() < 0.85 || (u === 0) || (v === targetId);
                    if (!keepEdge) continue;

                    if (spec.directed) {
                        // Направленная дуга u -> v плюс возможная обратная дуга другого веса
                        const wFwd = randInt(2, 13);
                        matrix[u][v] = wFwd;
                        edges.push({ u, v, w: wFwd });
                        if (u > 0 && v < targetId && Math.random() < 0.45) {
                            let wRev = randInt(3, 15);
                            if (wRev === wFwd) wRev += 1;
                            matrix[v][u] = wRev;
                            // Для компактности матрицы в ориентированном режиме рисуем дугу u->v, а обратную показываем при необходимости:
                            // Чтобы визуал 100% совпадал с матрицей (когда showWeightsOnSvg=false или в матричном режиме), добавим только в edges если отличается
                        }
                    } else {
                        const w = randInt(2, 12);
                        matrix[u][v] = w;
                        matrix[v][u] = w;
                        edges.push({ u, v, w });
                    }
                }

                // В ориентированном режиме синхронизируем обратные дуги в матрице строго с edges, чтобы матрица и SVG не расходились
                if (spec.directed) {
                    for (let r = 0; r < spec.nodeCount; r++) {
                        for (let c = 0; c < spec.nodeCount; c++) {
                            if (matrix[r][c] !== null && !edges.some(e => e.u === r && e.v === c)) {
                                edges.push({ u: r, v: c, w: matrix[r][c], isReverse: true });
                            }
                        }
                    }
                }

                const midPool = is5 ? [1, 2, 3] : [1, 2, 3, 4];
                const honeypotNode = spec.useHoneypot ? midPool[randInt(0, midPool.length - 1)] : null;
                let requiredNode = null;
                if (spec.useRequired) {
                    const reqPool = midPool.filter(n => n !== honeypotNode);
                    requiredNode = reqPool[randInt(0, reqPool.length - 1)];
                }

                const { bestCost, bestPath } = findExactShortestSimplePath(
                    spec.nodeCount, matrix, targetId, honeypotNode, requiredNode
                );

                // Проверим, что путь содержательный (>= 2 рёбер) и для requiredNode действительно меняет выбор или достижим
                if (bestPath && bestCost < Infinity && bestPath.length >= 3) {
                    return {
                        ...spec,
                        nodes,
                        edges,
                        matrix,
                        targetId,
                        honeypotNode,
                        forbiddenNode: null,
                        requiredNode,
                        optimalCost: bestCost,
                        solutionPath: bestPath,
                        exactDagCount: null
                    };
                }
            }

            // Детерминированный надёжный запасной вариант
            const fallbackMatrix = Array.from({ length: spec.nodeCount }, () => Array(spec.nodeCount).fill(null));
            const fallbackEdges = [];
            for (const [u, v] of basePairs) {
                const w = (u + v) % 7 + 3;
                fallbackMatrix[u][v] = w;
                if (!spec.directed) fallbackMatrix[v][u] = w;
                fallbackEdges.push({ u, v, w });
            }
            const hp = spec.useHoneypot ? 2 : null;
            const rq = spec.useRequired ? 1 : null;
            const res = findExactShortestSimplePath(spec.nodeCount, fallbackMatrix, targetId, hp, rq);
            return {
                ...spec,
                nodes,
                edges: fallbackEdges,
                matrix: fallbackMatrix,
                targetId,
                honeypotNode: hp,
                forbiddenNode: null,
                requiredNode: rq,
                optimalCost: res.bestCost,
                solutionPath: res.bestPath,
                exactDagCount: null
            };
        }

        function generateDagWave(spec) {
            const is6 = spec.nodeCount === 6;
            const nodes = (is6 ? LAYOUT_6 : LAYOUT_7_DAG).map(n => ({ ...n }));
            const targetId = spec.nodeCount - 1;

            const candidateEdges = is6
                ? [[0, 1], [0, 2], [1, 2], [1, 3], [1, 4], [2, 3], [2, 4], [3, 4], [3, 5], [4, 5]]
                : [[0, 1], [0, 2], [0, 3], [1, 3], [1, 4], [2, 3], [2, 5], [3, 4], [3, 5], [3, 6], [4, 6], [5, 6]];

            for (let attempt = 0; attempt < 80; attempt++) {
                const edges = [];
                const adj = Array.from({ length: spec.nodeCount }, () => []);
                for (const [u, v] of candidateEdges) {
                    const mustKeep = (u === 0 && (v === 1 || v === 2)) || (v === targetId && (u === targetId - 1 || u === targetId - 2));
                    if (mustKeep || Math.random() < 0.78) {
                        edges.push({ u, v, w: 1 });
                        adj[u].push(v);
                    }
                }

                const midPool = is6 ? [1, 2, 3, 4] : [1, 2, 3, 4, 5];
                const forbiddenNode = spec.useForbidden ? midPool[randInt(0, midPool.length - 1)] : null;
                let requiredNode = null;
                if (spec.useRequired) {
                    const reqPool = midPool.filter(n => n !== forbiddenNode);
                    requiredNode = reqPool[randInt(0, reqPool.length - 1)];
                }

                let exactCount = 0;
                if (requiredNode !== null) {
                    const firstHalf = countDagPaths(spec.nodeCount, adj, 0, requiredNode, forbiddenNode);
                    const secondHalf = countDagPaths(spec.nodeCount, adj, requiredNode, targetId, forbiddenNode);
                    exactCount = firstHalf * secondHalf;
                } else {
                    exactCount = countDagPaths(spec.nodeCount, adj, 0, targetId, forbiddenNode);
                }

                const totalRaw = countDagPaths(spec.nodeCount, adj, 0, targetId, null);
                const constraintMeaningful = (!forbiddenNode || totalRaw > exactCount) && (!requiredNode || countDagPaths(spec.nodeCount, adj, 0, targetId, forbiddenNode) > exactCount || attempt > 40);

                if (exactCount >= 3 && exactCount <= 22 && constraintMeaningful) {
                    return {
                        ...spec,
                        nodes,
                        edges,
                        matrix: null,
                        targetId,
                        honeypotNode: null,
                        forbiddenNode,
                        requiredNode,
                        optimalCost: null,
                        solutionPath: null,
                        exactDagCount: exactCount
                    };
                }
            }

            // Детерминированный запасной DAG
            const adjFb = Array.from({ length: spec.nodeCount }, () => []);
            const edgesFb = [];
            for (const [u, v] of candidateEdges) {
                edgesFb.push({ u, v, w: 1 });
                adjFb[u].push(v);
            }
            const fbForb = spec.useForbidden ? 2 : null;
            const fbReq = spec.useRequired ? 3 : null;
            const countFb = fbReq !== null
                ? countDagPaths(spec.nodeCount, adjFb, 0, fbReq, fbForb) * countDagPaths(spec.nodeCount, adjFb, fbReq, targetId, fbForb)
                : countDagPaths(spec.nodeCount, adjFb, 0, targetId, fbForb);

            return {
                ...spec,
                nodes,
                edges: edgesFb,
                matrix: null,
                targetId,
                honeypotNode: null,
                forbiddenNode: fbForb,
                requiredNode: fbReq,
                optimalCost: null,
                solutionPath: null,
                exactDagCount: countFb
            };
        }

        const { createApp } = Vue;

        const app = createApp({
            data() {
                return {
                    gameState: 'intro', // 'intro' | 'playing' | 'victory'
                    currentWave: 1,
                    totalWaves: 10,
                    attempts: 0,
                    startTime: 0,
                    totalTimeSec: 0,

                    // Таймеры
                    phaseTimeLeft: 32.0,
                    phaseTimeTotal: 32.0,
                    timerInterval: null,
                    resetTimeout: null,
                    waveTimeout: null,
                    fxTimeout: null,
                    telemetry: null,

                    // Сгенерированные волны
                    wavesList: [],
                    currentWaveData: {
                        wave: 1,
                        mode: 'shortest',
                        nodeCount: 5,
                        directed: false,
                        showWeightsOnSvg: true,
                        showMatrix: false,
                        title: '',
                        directive: '',
                        nodes: [],
                        edges: [],
                        matrix: null,
                        targetId: 4,
                        honeypotNode: null,
                        forbiddenNode: null,
                        requiredNode: null,
                        optimalCost: 0,
                        solutionPath: [],
                        exactDagCount: null,
                        timeLimit: 32.0
                    },

                    // Состояние активной волны
                    playerPath: [0],
                    currentPathWeight: 0,
                    dagGuess: 1,
                    fxEdgeKey: '',

                    // Аварийная сирена
                    alarmActive: false,
                    alarmReason: ''
                };
            },

            computed: {
                progressBarStyle() {
                    const pct = Math.max(0, Math.min(100, (this.phaseTimeLeft / this.phaseTimeTotal) * 100));
                    return { width: pct + '%' };
                },

                currentNodeId() {
                    if (!this.playerPath || this.playerPath.length === 0) return 0;
                    return this.playerPath[this.playerPath.length - 1];
                },

                formattedPlayerPath() {
                    return this.playerPath.map(id => this.getNodeLabel(id)).join(' → ');
                },

                canFastForwardTarget() {
                    if (this.currentWaveData.mode !== 'shortest') return false;
                    const u = this.currentNodeId;
                    const target = this.currentWaveData.targetId;
                    if (u === target) return false;
                    return this.getEdgeWeight(u, target) !== null;
                },

                iceProgressLevel() {
                    if (this.phaseTimeTotal <= 0) return 0;
                    const elapsedRatio = 1 - (this.phaseTimeLeft / this.phaseTimeTotal);
                    return Math.min(5, Math.max(0, Math.floor(elapsedRatio * 5) + (elapsedRatio > 0.05 ? 1 : 0)));
                },

                iceStatusLabel() {
                    const lvl = this.iceProgressLevel;
                    if (lvl <= 1) return 'ПЕРИМЕТР ЧИСТ';
                    if (lvl <= 3) return 'СКАНИРОВАНИЕ ПОРТОВ';
                    if (lvl === 4) return 'БЛИЗКИЙ ПЕРЕХВАТ!';
                    return 'КРИТИЧЕСКОЕ СБЛИЖЕНИЕ!';
                },

                renderedEdges() {
                    const nodes = this.currentWaveData.nodes || [];
                    const edges = this.currentWaveData.edges || [];
                    const result = [];

                    for (const edge of edges) {
                        const n1 = nodes[edge.u];
                        const n2 = nodes[edge.v];
                        if (!n1 || !n2) continue;

                        const dx = n2.x - n1.x;
                        const dy = n2.y - n1.y;
                        const dist = Math.hypot(dx, dy) || 1;
                        const ux = dx / dist;
                        const uy = dy / dist;

                        // Для ориентированных дуг укорачиваем конец до кромки окружности r=29 (+4px под наконечник стрелки)
                        const startPad = 29;
                        const endPad = this.currentWaveData.directed ? 33 : 29;

                        // Если это обратная направленная дуга, слегка сдвигаем нормаль, чтобы две встречные стрелки не сливались
                        let nx = 0;
                        let ny = 0;
                        if (edge.isReverse) {
                            nx = -uy * 12;
                            ny = ux * 12;
                        }

                        const x1 = n1.x + ux * startPad + nx;
                        const y1 = n1.y + uy * startPad + ny;
                        const x2 = n2.x - ux * endPad + nx;
                        const y2 = n2.y - uy * endPad + ny;

                        // Смещение метки веса на пересекающихся диагоналях и встречных дугах
                        let t = 0.5;
                        if ((edge.u === 1 && edge.v === 4) || (edge.u === 4 && edge.v === 1)) t = 0.34;
                        if ((edge.u === 2 && edge.v === 3) || (edge.u === 3 && edge.v === 2)) t = 0.34;
                        if (edge.isReverse) t = 0.35;

                        const lx = n1.x + dx * t + nx * 1.4;
                        const ly = n1.y + dy * t + ny * 1.4;

                        const isTraversed = this.isEdgeInPlayerPath(edge.u, edge.v);
                        const edgeKey = edge.u + '-' + edge.v;
                        const isFx = this.fxEdgeKey === edgeKey || (!this.currentWaveData.directed && this.fxEdgeKey === (edge.v + '-' + edge.u));
                        const touchesBlocked = this.currentWaveData.forbiddenNode !== null &&
                            (edge.u === this.currentWaveData.forbiddenNode || edge.v === this.currentWaveData.forbiddenNode);

                        let stroke = '#6c757d';
                        let strokeWidth = 2.5;
                        let dash = this.currentWaveData.showMatrix ? '5 4' : '';
                        let markerEnd = '';
                        let labelStroke = '#495057';
                        let labelFill = this.currentWaveData.showWeightsOnSvg ? '#ffc107' : '#6c757d';

                        if (touchesBlocked) {
                            stroke = '#5c1a20';
                            dash = '4 4';
                            if (this.currentWaveData.directed) markerEnd = 'url(#arrow-blocked)';
                        } else if (isFx) {
                            stroke = '#0dcaf0';
                            strokeWidth = 5;
                            dash = '';
                            labelStroke = '#0dcaf0';
                            if (this.currentWaveData.directed) markerEnd = 'url(#arrow-active)';
                        } else if (isTraversed) {
                            stroke = '#0dcaf0';
                            strokeWidth = 4;
                            dash = '';
                            labelStroke = '#0dcaf0';
                            labelFill = '#0dcaf0';
                            if (this.currentWaveData.directed) markerEnd = 'url(#arrow-active)';
                        } else if (this.currentWaveData.directed) {
                            markerEnd = 'url(#arrow-base)';
                        }

                        result.push({
                            u: edge.u,
                            v: edge.v,
                            w: edge.w,
                            x1, y1, x2, y2, lx, ly,
                            stroke, strokeWidth, dash, markerEnd,
                            labelStroke, labelFill
                        });
                    }

                    return result;
                }
            },

            mounted() {
                window.addEventListener('keydown', this.handleKeydown);

                this.telemetry = window.LMSTelemetry.create({
                    missionName: 'Урок 10 :: Граф. Весовая матрица графа. Длина пути между вершинами графа. Вычисление количества путей в направленном ациклическом графе (Уровень 3)',
                    level: 3,
                    totalWaves: this.totalWaves,
                    showAfkOverlay: true,
                    onAfkStop: () => {
                        this.stopTimer();
                        this.clearPendingTimeouts();
                        this.alarmActive = false;
                        this.alarmReason = '';
                    },
                    onAfkRetry: () => {
                        this.alarmActive = false;
                        this.alarmReason = '';
                        if (this.gameState === 'playing') {
                            this.generateAllWaves();
                            this.telemetry.setWave(1, this.totalWaves);
                            this.initWave(1);
                        }
                    }
                });

                // Экспорт тестового хука для E2E Playwright
                const self = this;
                window.__DEV_LEVEL3_STATE__ = {
                    get waves() { return self.wavesList; },
                    get currentWaveIndex() { return self.currentWave - 1; },
                    get currentWave() { return self.currentWaveData; },
                    getCurrentWaveNumber: () => self.currentWave,
                    getAttempts: () => self.attempts,
                    solveCurrentWave: () => self.devSolveCurrentWave(),
                    submitAction: (action, payload) => self.devSubmitAction(action, payload)
                };
            },

            beforeUnmount() {
                window.removeEventListener('keydown', this.handleKeydown);
                this.stopTimer();
                this.clearPendingTimeouts();
                if (this.telemetry) {
                    this.telemetry.destroy();
                }
            },

            methods: {
                clearPendingTimeouts() {
                    if (this.resetTimeout) {
                        clearTimeout(this.resetTimeout);
                        this.resetTimeout = null;
                    }
                    if (this.waveTimeout) {
                        clearTimeout(this.waveTimeout);
                        this.waveTimeout = null;
                    }
                    if (this.fxTimeout) {
                        clearTimeout(this.fxTimeout);
                        this.fxTimeout = null;
                    }
                },

                getNodeLabel(id) {
                    if (id === null || id === undefined) return '';
                    const n = this.currentWaveData.nodes && this.currentWaveData.nodes[id];
                    return n ? n.label : (LABELS_DAG[id] || String(id));
                },

                startGame() {
                    this.stopTimer();
                    this.clearPendingTimeouts();
                    this.startTime = Date.now();
                    this.attempts = 0;
                    this.alarmActive = false;
                    this.alarmReason = '';
                    this.generateAllWaves();
                    this.gameState = 'playing';

                    if (this.telemetry) {
                        this.telemetry.reset({ allowRecomplete: true });
                        this.telemetry.start();
                        this.telemetry.markActivity();
                        this.telemetry.setWave(1, this.totalWaves);
                        this.telemetry.progress({
                            wave: 1,
                            total_waves: this.totalWaves,
                            stage: 1,
                            total_stages: this.totalWaves
                        });
                    }
                    this.initWave(1);
                },

                generateAllWaves() {
                    this.wavesList = WAVE_SPECS.map(spec => {
                        return spec.mode === 'dag' ? generateDagWave(spec) : generateShortestWave(spec);
                    });
                },

                initWave(waveNum) {
                    this.currentWave = waveNum;
                    const waveObj = this.wavesList[waveNum - 1];
                    this.currentWaveData = waveObj;
                    this.phaseTimeTotal = waveObj.timeLimit;
                    this.phaseTimeLeft = waveObj.timeLimit;

                    this.playerPath = [0];
                    this.currentPathWeight = 0;
                    this.dagGuess = 1;
                    this.fxEdgeKey = '';
                    this.startTimer();
                },

                startTimer() {
                    this.stopTimer();
                    const intervalMs = 100;
                    this.timerInterval = setInterval(() => {
                        if (this.gameState !== 'playing' || this.alarmActive || (this.telemetry && this.telemetry.getState().isAfkPaused)) {
                            return;
                        }
                        this.phaseTimeLeft -= (intervalMs / 1000);
                        if (this.phaseTimeLeft <= 0) {
                            this.phaseTimeLeft = 0;
                            this.triggerHardcoreReset('Время волны истекло! Фронт ICE перехватил канал связи.', true);
                        }
                    }, intervalMs);
                },

                stopTimer() {
                    if (this.timerInterval) {
                        clearInterval(this.timerInterval);
                        this.timerInterval = null;
                    }
                },

                getEdgeWeight(u, v) {
                    const m = this.currentWaveData.matrix;
                    if (!m || !m[u]) return null;
                    return m[u][v] !== undefined ? m[u][v] : null;
                },

                isAdjacentToCurrent(nodeId) {
                    if (this.currentWaveData.mode !== 'shortest') return false;
                    const u = this.currentNodeId;
                    if (u === nodeId) return false;
                    return this.getEdgeWeight(u, nodeId) !== null;
                },

                isEdgeInPlayerPath(u, v) {
                    if (this.currentWaveData.mode !== 'shortest') return false;
                    for (let i = 0; i < this.playerPath.length - 1; i++) {
                        const a = this.playerPath[i];
                        const b = this.playerPath[i + 1];
                        if (a === u && b === v) return true;
                        if (!this.currentWaveData.directed && a === v && b === u) return true;
                    }
                    return false;
                },

                getMatrixCellClass(r, c, val) {
                    if (r === c) return 'bg-black text-secondary opacity-50';
                    if (val === null) return 'bg-black text-secondary opacity-25';
                    if (r === this.currentNodeId) {
                        return 'bg-black text-warning border-warning fw-bold';
                    }
                    return 'bg-dark text-light';
                },

                getNodeCursorStyle(id) {
                    if (this.alarmActive) return { cursor: 'not-allowed' };
                    if (this.currentWaveData.mode === 'dag') {
                        return id === this.currentWaveData.targetId ? { cursor: 'pointer' } : { cursor: 'default' };
                    }
                    return (this.isAdjacentToCurrent(id) || (this.playerPath.length > 1 && id === this.playerPath[this.playerPath.length - 2]))
                        ? { cursor: 'pointer' }
                        : { cursor: 'default' };
                },

                getNodeFill(id) {
                    if (id === this.currentWaveData.honeypotNode || id === this.currentWaveData.forbiddenNode) return '#3b0a0f';
                    if (this.currentWaveData.mode === 'shortest' && id === this.currentNodeId) return '#083344';
                    if (this.currentWaveData.mode === 'shortest' && this.playerPath.includes(id)) return '#052c65';
                    if (id === this.currentWaveData.requiredNode) return '#0a3622';
                    if (id === this.currentWaveData.targetId) return '#2c2200';
                    return '#111418';
                },

                getNodeStroke(id) {
                    if (id === this.currentWaveData.honeypotNode || id === this.currentWaveData.forbiddenNode) return '#dc3545';
                    if (this.currentWaveData.mode === 'shortest' && id === this.currentNodeId) return '#0dcaf0';
                    if (id === this.currentWaveData.requiredNode) return '#198754';
                    if (id === this.currentWaveData.targetId) return '#ffc107';
                    if (this.currentWaveData.mode === 'shortest' && this.isAdjacentToCurrent(id)) return '#0dcaf0';
                    return '#6c757d';
                },

                getNodeStrokeWidth(id) {
                    if (this.currentWaveData.mode === 'shortest' && (id === this.currentNodeId || this.isAdjacentToCurrent(id))) return 3.5;
                    if (id === this.currentWaveData.targetId || id === this.currentWaveData.honeypotNode || id === this.currentWaveData.forbiddenNode || id === this.currentWaveData.requiredNode) return 3;
                    return 2;
                },

                getNodeTextFill(id) {
                    if (id === this.currentWaveData.honeypotNode || id === this.currentWaveData.forbiddenNode) return '#ff6b6b';
                    if (id === this.currentWaveData.requiredNode) return '#75b798';
                    if (id === this.currentWaveData.targetId) return '#ffc107';
                    if (this.currentWaveData.mode === 'shortest' && (id === this.currentNodeId || this.isAdjacentToCurrent(id))) return '#0dcaf0';
                    return '#f8f9fa';
                },

                getNodeSubFill(id) {
                    if (id === this.currentWaveData.honeypotNode || id === this.currentWaveData.forbiddenNode) return '#ff8787';
                    if (id === this.currentWaveData.requiredNode) return '#75b798';
                    if (id === this.currentWaveData.targetId) return '#ffda6a';
                    return '#adb5bd';
                },

                getNodeSubLabel(id) {
                    if (id === this.currentWaveData.honeypotNode) return 'ЛОВУШКА';
                    if (id === this.currentWaveData.forbiddenNode) return 'БЛОК';
                    if (id === this.currentWaveData.requiredNode) return this.currentWaveData.mode === 'dag' ? 'РЕЛЕ' : 'РЕЛЕ [' + (id + 1) + ']';
                    if (id === this.currentWaveData.targetId) return this.currentWaveData.mode === 'dag' ? 'ПУСК' : 'ЦЕЛЬ [' + (id + 1) + ']';
                    if (id === 0) return 'СТАРТ';
                    return this.currentWaveData.mode === 'dag' ? 'УЗЕЛ' : '[' + (id + 1) + ']';
                },

                triggerEdgeFx(u, v) {
                    this.fxEdgeKey = u + '-' + v;
                    if (this.fxTimeout) clearTimeout(this.fxTimeout);
                    this.fxTimeout = setTimeout(() => {
                        this.fxEdgeKey = '';
                    }, 240);
                },

                stepBack() {
                    if (this.gameState !== 'playing' || this.alarmActive || this.currentWaveData.mode !== 'shortest') return;
                    if (this.playerPath.length <= 1) return;
                    if (this.telemetry) this.telemetry.markActivity();

                    const last = this.playerPath.pop();
                    const prev = this.playerPath[this.playerPath.length - 1];
                    const w = this.getEdgeWeight(prev, last);
                    if (w !== null) {
                        this.currentPathWeight -= w;
                    }
                    playSound('undo');
                },

                handleNodeClick(nodeId) {
                    if (this.gameState !== 'playing' || this.alarmActive || (this.telemetry && this.telemetry.getState().isAfkPaused)) {
                        return;
                    }

                    if (this.currentWaveData.mode === 'dag') {
                        if (nodeId === this.currentWaveData.targetId) {
                            this.submitDagPulse();
                        }
                        return;
                    }

                    const cur = this.currentNodeId;
                    // Повторный клик по предыдущему узлу делает удобный шаг назад
                    if (this.playerPath.length > 1 && nodeId === this.playerPath[this.playerPath.length - 2]) {
                        this.stepBack();
                        return;
                    }

                    const edgeWeight = this.getEdgeWeight(cur, nodeId);
                    if (edgeWeight === null) {
                        return;
                    }
                    // Запрещаем повторный заезд в уже посещённую вершину (кроме отката выше)
                    if (this.playerPath.includes(nodeId)) {
                        return;
                    }

                    if (this.telemetry) this.telemetry.markActivity();

                    // Мгновенный провал при наезде на Honeypot
                    if (nodeId === this.currentWaveData.honeypotNode) {
                        this.triggerHardcoreReset(
                            `Перехват на ловушке HONEYPOT (${this.getNodeLabel(nodeId)})! Антивирус ICE заблокировал узел.`
                        );
                        return;
                    }

                    this.triggerEdgeFx(cur, nodeId);
                    this.playerPath.push(nodeId);
                    this.currentPathWeight += edgeWeight;
                    playSound('step');

                    // Проверка при достижении целевого сервера
                    if (nodeId === this.currentWaveData.targetId) {
                        if (this.currentWaveData.requiredNode !== null && !this.playerPath.includes(this.currentWaveData.requiredNode)) {
                            this.triggerHardcoreReset(
                                `Нарушен транзитный протокол: маршрут не прошёл через обязательное зелёное реле ${this.getNodeLabel(this.currentWaveData.requiredNode)}!`
                            );
                            return;
                        }
                        if (this.currentPathWeight !== this.currentWaveData.optimalCost) {
                            this.triggerHardcoreReset(
                                `Неоптимальный маршрут! Ваша длина: ${this.currentPathWeight}, кратчайшая возможная: ${this.currentWaveData.optimalCost}.`
                            );
                            return;
                        }
                        this.completeWave();
                    }
                },

                adjustDag(delta) {
                    if (this.gameState !== 'playing' || this.alarmActive || this.currentWaveData.mode !== 'dag') return;
                    if (this.telemetry) this.telemetry.markActivity();
                    const next = Math.max(1, Math.min(30, Number(this.dagGuess || 1) + delta));
                    this.dagGuess = next;
                    playSound('dial');
                },

                onSliderInput() {
                    if (this.telemetry) this.telemetry.markActivity();
                    playSound('dial');
                },

                submitDagPulse() {
                    if (this.gameState !== 'playing' || this.alarmActive || (this.telemetry && this.telemetry.getState().isAfkPaused)) return;
                    if (this.currentWaveData.mode !== 'dag') return;
                    if (this.telemetry) this.telemetry.markActivity();

                    const guess = Number(this.dagGuess);
                    const expected = Number(this.currentWaveData.exactDagCount);

                    if (guess === expected) {
                        this.completeWave();
                    } else {
                        this.triggerHardcoreReset(
                            `Ошибка калибровки DAG! Передано путей: ${guess}, истинное количество путей до ${this.getNodeLabel(this.currentWaveData.targetId)}: ${expected}.`
                        );
                    }
                },

                completeWave() {
                    this.stopTimer();
                    this.clearPendingTimeouts();
                    playSound('wave_complete');

                    if (this.currentWave >= this.totalWaves) {
                        this.finishLevel();
                    } else {
                        const nextWave = this.currentWave + 1;
                        this.waveTimeout = setTimeout(() => {
                            if (this.gameState !== 'playing' || (this.telemetry && this.telemetry.getState().isAfkPaused)) {
                                return;
                            }
                            this.initWave(nextWave);
                            if (this.telemetry) {
                                this.telemetry.advanceWave(nextWave);
                            }
                        }, 400);
                    }
                },

                triggerHardcoreReset(reason, isTimeout = false) {
                    this.stopTimer();
                    this.clearPendingTimeouts();

                    if (this.telemetry) {
                        const sent = this.telemetry.fail({
                            wave: this.currentWave,
                            isTimeout: Boolean(isTimeout)
                        });
                        this.attempts = this.telemetry.getState().attemptsCount;
                        if (sent === false) {
                            this.alarmActive = false;
                            this.alarmReason = '';
                            return;
                        }
                    } else {
                        this.attempts++;
                    }

                    playSound('alarm');
                    this.alarmActive = true;
                    this.alarmReason = reason;
                    this.generateAllWaves();

                    this.resetTimeout = setTimeout(() => {
                        if (this.gameState !== 'playing' || (this.telemetry && this.telemetry.getState().isAfkPaused)) {
                            return;
                        }
                        this.alarmActive = false;
                        this.alarmReason = '';
                        if (this.telemetry) {
                            this.telemetry.setWave(1, this.totalWaves);
                        }
                        this.initWave(1);
                    }, 1400);
                },

                finishLevel() {
                    this.stopTimer();
                    this.clearPendingTimeouts();
                    this.gameState = 'victory';
                    this.totalTimeSec = Math.max(1, Math.round((Date.now() - this.startTime) / 1000));
                    playSound('victory');
                    if (this.telemetry) {
                        this.telemetry.complete({ wave: this.totalWaves });
                    }
                },

                handleKeydown(e) {
                    if (this.gameState !== 'playing' || this.alarmActive || (this.telemetry && this.telemetry.getState().isAfkPaused)) {
                        return;
                    }

                    if (this.currentWaveData.mode === 'shortest') {
                        const keyNum = parseInt(e.key, 10);
                        if (keyNum >= 1 && keyNum <= this.currentWaveData.nodes.length) {
                            this.handleNodeClick(keyNum - 1);
                            return;
                        }
                        if (e.key === 'Backspace') {
                            e.preventDefault();
                            this.stepBack();
                            return;
                        }
                        if (e.key === ' ' || e.key === 'Enter') {
                            if (this.canFastForwardTarget) {
                                e.preventDefault();
                                this.handleNodeClick(this.currentWaveData.targetId);
                            }
                        }
                    } else {
                        if (e.key === 'ArrowLeft' || e.key === '-') {
                            e.preventDefault();
                            this.adjustDag(e.shiftKey ? -5 : -1);
                        } else if (e.key === 'ArrowRight' || e.key === '+' || e.key === '=') {
                            e.preventDefault();
                            this.adjustDag(e.shiftKey ? 5 : 1);
                        } else if (e.key === ' ' || e.key === 'Enter') {
                            e.preventDefault();
                            this.submitDagPulse();
                        }
                    }
                },

                // --- ТЕСТОВЫЕ МЕТОДЫ ДЛЯ E2E PLAYWRIGHT ---
                devSolveCurrentWave() {
                    if (this.gameState !== 'playing' || this.alarmActive) return;
                    if (this.currentWaveData.mode === 'dag') {
                        this.dagGuess = this.currentWaveData.exactDagCount;
                        this.submitDagPulse();
                        return;
                    }
                    const path = this.currentWaveData.solutionPath;
                    if (Array.isArray(path) && path.length > 1) {
                        this.playerPath = [0];
                        this.currentPathWeight = 0;
                        for (let i = 1; i < path.length; i++) {
                            if (this.alarmActive || this.gameState !== 'playing') break;
                            this.handleNodeClick(path[i]);
                        }
                    }
                },

                devSubmitAction(action, payload) {
                    if (action === 'click_node' && payload !== undefined) {
                        this.handleNodeClick(typeof payload === 'object' ? payload.nodeId : payload);
                    } else if (action === 'set_dag' && payload !== undefined) {
                        this.dagGuess = Number(payload);
                        this.submitDagPulse();
                    } else if (action === 'solve') {
                        this.devSolveCurrentWave();
                    } else if (action === 'fail') {
                        this.triggerHardcoreReset(payload || 'Тестовый принудительный сбой', false);
                    } else if (action === 'timeout') {
                        this.triggerHardcoreReset('Тестовый таймаут волны', true);
                    }
                }
            }
        });

        app.mount('#app');
    </script>
</TaskLayout>
