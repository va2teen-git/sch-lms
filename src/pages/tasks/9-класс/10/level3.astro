---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={3}>
    <div id="app" class="container-fluid px-2 px-md-3 my-3 font-monospace" v-cloak>

        <!-- ========================================== -->
        <!-- 1. СТАРТОВЫЙ ЭКРАН (БРИФИНГ ХАРДКОРА)      -->
        <!-- ========================================== -->
        <div v-if="gameState === 'intro'" class="card bg-black border-danger rounded-0 p-3 p-md-4 text-center shadow-lg">
            <div class="fs-2 fs-md-1 text-danger fw-bold mb-2">⚡ ICE NODE RACE // SUBNET INFILTRATION ⚡</div>
            <h2 class="h4 text-light mb-2">ГОНКА С АНТИВИРУСОМ В ГРАФЕ И КАСКАД DAG // АРХЕТИП 7</h2>
            <p class="text-secondary mb-3 small mx-auto" style="max-width: 780px;">
                Вы проводите кибер-инфильтрацию магистрального графа сети под давлением красного фронта антивируса ICE.
                Пройдите 10 процедурных волн, переключаясь между анализом весовой матрицы, поиском кратчайшего пути и точным расчётом количества маршрутов в DAG.
            </p>

            <div class="card bg-dark border-secondary rounded-0 p-3 mx-auto mb-3 text-start small" style="max-width: 760px;">
                <div class="text-danger fw-bold mb-2">[ИНСТРУКЦИЯ БОЕВОГО ОПЕРАТОРА // 10 ВОЛН]:</div>
                <div class="text-light mb-1">• <span class="text-warning fw-bold">Трассировка маршрута (Волны 1–3, 5–6, 8–9):</span> Кликайте прямо по смежным вершинам графа от <strong class="text-info">А</strong> к целевому узлу (≥ 50×50 px или клавишами <code>1</code>..<code>6</code>), чтобы проложить <strong>кратчайший путь</strong>.</div>
                <div class="text-light mb-1">• <span class="text-info fw-bold">Матричные волны:</span> Если веса на рёбрах графа скрыты (<code>?</code>), считывайте стоимость переходов напрямую из <strong>Весовой матрицы</strong> справа!</div>
                <div class="text-light mb-1">• <span class="text-success fw-bold">Каскад DAG (Волны 4, 7, 10):</span> Вычислите точное количество путей от <strong class="text-info">А</strong> к цели с учётом красных заблокированных (<code>БЛОК</code>) и зелёных обязательных (<code>РЕЛЕ</code>) узлов, откалибруйте импульс и кликните по целевому узлу (или <code>ПРОБЕЛ</code>).</div>
                <div class="text-light mb-1">• <span class="text-warning fw-bold">Хоткеи управления:</span> <code>1</code>..<code>7</code> — шаг в вершину, <code>Backspace</code> — откат на шаг назад, <code>←</code>/<code>→</code> — настройка импульсов DAG, <code>ПРОБЕЛ</code> / <code>Enter</code> — форсаж-пуск.</div>
                <div class="text-danger fw-bold mt-2">• ХАРДКОР-СБРОС (Full Wipeout): Ложный узел HONEYPOT, неоптимальный маршрут, промах по сумме путей DAG или тайм-аут включают сирену (#alarm-box) и СБРАСЫВАЮТ ВСЁ НА ВОЛНУ 1!</div>
            </div>

            <div>
                <button id="start-btn" type="button" @click="startGame" class="btn btn-danger rounded-0 fw-bold px-4 py-3 shadow" style="min-height: 48px;">
                    ИНИЦИИРОВАТЬ ПРОНИКНОВЕНИЕ (ВОЛНА 1) →
                </button>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- 2. ИГРОВОЙ ЭКРАН (АРКАДНЫЙ ПРОЦЕСС)        -->
        <!-- ========================================== -->
        <div v-else-if="gameState === 'playing'" class="card bg-black border-danger rounded-0 p-2 p-md-3 shadow-lg">

            <!-- Верхняя панель статуса и таймера -->
            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                <div>
                    <span class="text-secondary small d-block">СЕКТОР МАРШРУТИЗАЦИИ:</span>
                    <span id="phase-counter" class="text-danger fw-bold fs-5">ВОЛНА <span v-text="currentWave"></span> ИЗ <span v-text="totalWaves"></span></span>
                </div>
                <div class="text-center">
                    <span class="badge border rounded-0 px-2 px-md-3 py-1"
                          :class="currentWaveData.mode === 'dag' ? 'border-info text-info bg-dark' : 'border-danger text-danger bg-dark'"
                          v-text="currentWaveData.mode === 'dag' ? 'АРХЕТИП 7 :: КАСКАД DAG' : 'АРХЕТИП 7 :: ICE NODE RACE'">
                    </span>
                    <div class="text-secondary small mt-1">Попытка #<span v-text="attempts + 1"></span></div>
                </div>
                <div class="text-end">
                    <span class="text-secondary small d-block">ДО ПЕРЕХВАТА ICE:</span>
                    <span id="timer-display" class="fw-bold fs-5" :class="phaseTimeLeft <= 5.0 ? 'text-danger' : 'text-warning'">
                        <span v-text="phaseTimeLeft.toFixed(1)"></span> сек
                    </span>
                </div>
            </div>

            <!-- Прогресс-бар таймера -->
            <div class="progress mb-2 bg-dark border border-secondary rounded-0" style="height: 8px;">
                <div class="progress-bar"
                     :class="phaseTimeLeft <= 5.0 ? 'bg-danger' : 'bg-warning'"
                     role="progressbar"
                     :style="progressBarStyle">
                </div>
            </div>

            <!-- Индикатор приближения фронта антивируса ICE (синхронизирован с волной) -->
            <div class="d-flex align-items-center justify-content-between gap-2 mb-3 px-2 py-1 bg-dark border border-secondary rounded-0 small">
                <span class="text-danger fw-bold">ФРОНТ ICE:</span>
                <div class="d-flex gap-1 flex-grow-1">
                    <div v-for="seg in 5" :key="seg"
                         class="flex-fill rounded-0 border"
                         style="height: 10px;"
                         :class="seg <= iceProgressLevel ? 'bg-danger border-danger' : 'bg-black border-secondary opacity-50'">
                    </div>
                </div>
                <span class="text-secondary" v-text="iceStatusLabel"></span>
            </div>

            <!-- Аварийная сирена хардкор-сброса (#alarm-box) -->
            <div v-if="alarmActive" id="alarm-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 py-3 text-center shadow-lg mb-3">
                <div class="fs-5 fw-bold mb-1">🚨 ТРЕВОГА ICE // КРИТИЧЕСКИЙ СБОЙ МАРШРУТИЗАЦИИ 🚨</div>
                <div class="small text-light mb-2" v-text="alarmReason"></div>
                <div class="badge bg-danger text-black rounded-0 fs-6 px-3 py-1 fw-bold">
                    СБРОС НА ВОЛНУ 1 И ПЕРЕГЕНЕРАЦИЯ ГРАФОВ (Сбой #<span id="alarm-count" v-text="attempts"></span>)
                </div>
            </div>

            <!-- Задание волны + текущие модификаторы -->
            <div class="card bg-dark border-secondary rounded-0 p-2 p-md-3 mb-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <div class="fs-6 text-warning fw-bold" v-text="currentWaveData.title"></div>
                        <div class="text-light small" v-text="currentWaveData.directive"></div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <span v-if="currentWaveData.directed" class="badge bg-black border border-info text-info rounded-0 px-2 py-1">ОРИЕНТИРОВАННЫЙ (→)</span>
                        <span v-if="currentWaveData.honeypotNode !== null" class="badge bg-black border border-danger text-danger rounded-0 px-2 py-1">
                            ЛОВУШКА: <span v-text="getNodeLabel(currentWaveData.honeypotNode)"></span>
                        </span>
                        <span v-if="currentWaveData.forbiddenNode !== null" class="badge bg-black border border-danger text-danger rounded-0 px-2 py-1">
                            ЗАПРЕТ: <span v-text="getNodeLabel(currentWaveData.forbiddenNode)"></span>
                        </span>
                        <span v-if="currentWaveData.requiredNode !== null" class="badge bg-black border border-success text-success rounded-0 px-2 py-1">
                            ЧЕРЕЗ УЗЕЛ: <span v-text="getNodeLabel(currentWaveData.requiredNode)"></span>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Основная рабочая область: Интерактивный SVG-граф + Весовая матрица (когда веса скрыты) -->
            <div class="row g-2 g-md-3 align-items-stretch mb-3">
                <div :class="currentWaveData.showMatrix ? 'col-12 col-lg-7' : 'col-12'">
                    <div class="card bg-dark border-secondary rounded-0 p-2 h-100 text-center">
                        <div class="d-flex justify-content-between align-items-center small mb-1 px-1 flex-wrap gap-1">
                            <span class="text-secondary">
                                <span v-if="currentWaveData.mode === 'dag'">СХЕМА DAG (клик по цели <strong class="text-warning" v-text="getNodeLabel(currentWaveData.targetId)"></strong> запускает импульс)</span>
                                <span v-else>ИНТЕРАКТИВНЫЙ ГРАФ (клик по смежным вершинам или <code>1</code>..<span v-text="currentWaveData.nodes.length"></span>)</span>
                            </span>
                            <span v-if="currentWaveData.mode === 'shortest'" class="text-info fw-bold">
                                ТРАССА: <span v-text="formattedPlayerPath"></span> | ВЕС: <span class="text-warning" v-text="currentPathWeight"></span>
                            </span>
                        </div>

                        <div class="bg-black border border-secondary rounded-0 p-1 d-flex justify-content-center align-items-center">
                            <svg id="graph-svg" viewBox="0 0 580 310" class="w-100" style="max-width: 680px; height: auto; user-select: none;">
                                <defs>
                                    <marker id="arrow-base" markerWidth="10" markerHeight="8" refX="8" refY="4" orient="auto">
                                        <path d="M 0 0 L 10 4 L 0 8 z" fill="#6c757d"></path>
                                    </marker>
                                    <marker id="arrow-active" markerWidth="10" markerHeight="8" refX="8" refY="4" orient="auto">
                                        <path d="M 0 0 L 10 4 L 0 8 z" fill="#0dcaf0"></path>
                                    </marker>
                                    <marker id="arrow-blocked" markerWidth="10" markerHeight="8" refX="8" refY="4" orient="auto">
                                        <path d="M 0 0 L 10 4 L 0 8 z" fill="#dc3545"></path>
                                    </marker>
                                </defs>

                                <!-- Рёбра / дуги графа -->
                                <g v-for="(edge, eIdx) in renderedEdges" :key="'e-' + eIdx">
                                    <line
                                        :x1="edge.x1" :y1="edge.y1"
                                        :x2="edge.x2" :y2="edge.y2"
                                        :stroke="edge.stroke"
                                        :stroke-width="edge.strokeWidth"
                                        :stroke-dasharray="edge.dash"
                                        :marker-end="edge.markerEnd" />
                                    <g v-if="currentWaveData.mode === 'shortest'">
                                        <rect :x="edge.lx - 15" :y="edge.ly - 11" width="30" height="22" fill="#000000" :stroke="edge.labelStroke" stroke-width="1"></rect>
                                        <text :x="edge.lx" :y="edge.ly + 5" text-anchor="middle" font-size="13" font-weight="bold"
                                              :fill="edge.labelFill" v-text="currentWaveData.showWeightsOnSvg ? edge.w : '?'"></text>
                                    </g>
                                </g>

                                <!-- Вершины графа (Direct Manipulation Organs >= 50x50) -->
                                <g v-for="node in currentWaveData.nodes" :key="'n-' + node.id"
                                   :data-node-id="node.id"
                                   :style="getNodeCursorStyle(node.id)"
                                   @click="handleNodeClick(node.id)">
                                    <circle
                                        :cx="node.x" :cy="node.y" r="29"
                                        :fill="getNodeFill(node.id)"
                                        :stroke="getNodeStroke(node.id)"
                                        :stroke-width="getNodeStrokeWidth(node.id)" />
                                    <!-- Метка вершины (А, Б, В...) -->
                                    <text :x="node.x" :y="node.y + 4" text-anchor="middle" font-size="18" font-weight="bold"
                                          :fill="getNodeTextFill(node.id)" v-text="node.label"></text>
                                    <!-- Номер горячей клавиши (1..7) или роль узла -->
                                    <text :x="node.x" :y="node.y + 21" text-anchor="middle" font-size="10" font-weight="bold"
                                          :fill="getNodeSubFill(node.id)" v-text="getNodeSubLabel(node.id)"></text>
                                    <!-- Счетчик источника А=1 в режиме DAG -->
                                    <g v-if="currentWaveData.mode === 'dag' && node.id === 0">
                                        <rect :x="node.x - 16" :y="node.y - 40" width="32" height="16" fill="#0d6efd" stroke="#ffffff" stroke-width="1"></rect>
                                        <text :x="node.x" :y="node.y - 28" text-anchor="middle" font-size="11" font-weight="bold" fill="#ffffff">N=1</text>
                                    </g>
                                </g>
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- Весовая матрица графа (Data Source для матричных волн) -->
                <div v-if="currentWaveData.showMatrix" class="col-12 col-lg-5">
                    <div class="card bg-dark border-info rounded-0 p-2 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-info fw-bold small">ВЕСОВАЯ МАТРИЦА (ИСТОЧНИК ВЕСОВ):</span>
                                <span class="badge bg-black border border-secondary text-secondary rounded-0 small"
                                      v-text="currentWaveData.directed ? 'СТРОКА → СТОЛБЕЦ' : 'СИММЕТРИЧНАЯ'"></span>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-dark table-bordered border-secondary text-center align-middle mb-0 small font-monospace">
                                    <thead>
                                        <tr>
                                            <th class="bg-black text-secondary p-1">→</th>
                                            <th v-for="colNode in currentWaveData.nodes" :key="'mh-' + colNode.id"
                                                class="p-1"
                                                :class="isAdjacentToCurrent(colNode.id) ? 'bg-black text-warning' : 'bg-black text-info'"
                                                v-text="colNode.label">
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr v-for="(rowArr, rIdx) in currentWaveData.matrix" :key="'mr-' + rIdx">
                                            <th class="p-1"
                                                :class="currentNodeId === rIdx ? 'bg-info text-dark fw-bold' : 'bg-black text-info'"
                                                v-text="getNodeLabel(rIdx)">
                                            </th>
                                            <td v-for="(val, cIdx) in rowArr" :key="'mc-' + rIdx + '-' + cIdx"
                                                class="p-1"
                                                :class="getMatrixCellClass(rIdx, cIdx, val)"
                                                v-text="rIdx === cIdx ? '—' : (val === null ? '·' : val)">
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="text-secondary small mt-2 border-top border-secondary pt-2">
                            Подсвеченная строка показывает исходящие рёбра из текущего узла <strong class="text-info" v-text="getNodeLabel(currentNodeId)"></strong>.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Нижняя панель прямого управления (Откат/Форсаж в Shortest или Калибратор импульсов в DAG) -->
            <div v-if="currentWaveData.mode === 'shortest'" class="card bg-dark border-secondary rounded-0 p-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="small text-secondary">
                        Активный узел: <strong class="text-info" v-text="getNodeLabel(currentNodeId)"></strong>.
                        Кликните по смежной вершине или <strong class="text-warning" v-text="getNodeLabel(currentWaveData.targetId)"></strong> для захвата.
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-outline-secondary rounded-0 fw-bold px-3"
                                style="min-height: 48px; min-width: 110px;"
                                :disabled="playerPath.length <= 1 || alarmActive"
                                @click="stepBack">
                            ← ОТКАТ (Bksp)
                        </button>
                        <button id="commit-pulse-btn"
                                type="button"
                                class="btn btn-outline-info rounded-0 fw-bold px-3"
                                style="min-height: 48px;"
                                :disabled="!canFastForwardTarget || alarmActive"
                                @click="handleNodeClick(currentWaveData.targetId)">
                            ⚡ ФОРСАЖ В <span v-text="getNodeLabel(currentWaveData.targetId)"></span> (Space)
                        </button>
                    </div>
                </div>
            </div>

            <div v-else class="card bg-dark border-info rounded-0 p-2 p-md-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <div>
                        <span class="text-info fw-bold small d-block">КАЛИБРАТОР КОЛИЧЕСТВА ПУТЕЙ DAG (N(<span v-text="getNodeLabel(currentWaveData.targetId)"></span>)):</span>
                        <span class="text-secondary small">Выставьте точное число маршрутов и кликните по узлу <strong class="text-warning" v-text="getNodeLabel(currentWaveData.targetId)"></strong> (или <code>Space</code>)</span>
                    </div>
                    <div class="bg-black border border-info px-3 py-1 text-center" style="min-width: 120px;">
                        <span class="text-secondary small d-block">ПУЛЬСОВ:</span>
                        <span id="dag-counter-val" class="fs-4 fw-bold text-warning" v-text="dagGuess"></span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-outline-secondary rounded-0 fw-bold" style="min-width: 52px; min-height: 48px;" :disabled="alarmActive" @click="adjustDag(-5)">-5</button>
                    <button type="button" class="btn btn-outline-secondary rounded-0 fw-bold" style="min-width: 52px; min-height: 48px;" :disabled="alarmActive" @click="adjustDag(-1)">-1</button>
                    <input id="dag-slider" type="range" class="form-range flex-grow-1 mx-1" style="min-width: 140px; min-height: 48px;" min="1" max="30" step="1" v-model.number="dagGuess" @input="onSliderInput" :disabled="alarmActive" />
                    <button type="button" class="btn btn-outline-secondary rounded-0 fw-bold" style="min-width: 52px; min-height: 48px;" :disabled="alarmActive" @click="adjustDag(1)">+1</button>
                    <button type="button" class="btn btn-outline-secondary rounded-0 fw-bold" style="min-width: 52px; min-height: 48px;" :disabled="alarmActive" @click="adjustDag(5)">+5</button>
                    <button id="dag-fire-btn" type="button" class="btn btn-info text-dark rounded-0 fw-bold px-3" style="min-height: 48px;" :disabled="alarmActive" @click="submitDagPulse">
                        ПУСК В <span v-text="getNodeLabel(currentWaveData.targetId)"></span> (Space) →
                    </button>
                </div>
            </div>

        </div>

        <!-- ========================================== -->
        <!-- 3. ЭКРАН ПОБЕДЫ (ХАРДКОР ЗАВЕРШЕН)         -->
        <!-- ========================================== -->
        <div v-else-if="gameState === 'victory'" id="victory-screen" class="card bg-black border-success rounded-0 p-3 p-md-5 text-center shadow-lg">
            <div class="display-5 text-success mb-2 fw-bold">ИНФИЛЬТРАЦИЯ УСПЕШНА!</div>
            <div class="h5 text-success mb-2">✓ SUBNET &amp; DAG BREACH COMPLETED ✓</div>
            <h2 class="h4 text-light mb-2">ГРАФЫ, ВЕСОВЫЕ МАТРИЦЫ И ПУТИ DAG ПОД ПОЛНЫМ КОНТРОЛЕМ</h2>
            <p class="text-secondary small mb-3 mx-auto" style="max-width: 720px;">
                Все 10 волн гонки с антивирусом ICE пройдены без единого перехвата. Вы уверенно считываете весовые матрицы,
                мгновенно находите кратчайшие пути и безошибочно подсчитываете маршруты в направленных ациклических графах с ограничениями.
            </p>

            <div class="card bg-dark border-success rounded-0 p-3 mx-auto mb-3 text-start font-monospace small" style="max-width: 520px;">
                <div class="text-success fw-bold mb-2">ОТЧЁТ ОПЕРАЦИИ:</div>
                <div class="text-light">СТАТУС: <span class="text-success fw-bold">УРОВЕНЬ 3 (АРКАДА) ПРОЙДЕН</span></div>
                <div class="text-light">ПРОЙДЕНО ВОЛН: <span class="text-warning"><span v-text="totalWaves"></span> из <span v-text="totalWaves"></span></span></div>
                <div class="text-light">ПЕРЕХВАТОВ ICE (СБРОСОВ): <span class="text-warning" v-text="attempts"></span></div>
                <div class="text-light">ОБЩЕЕ ВРЕМЯ: <span class="text-warning" v-text="totalTimeSec"></span> СЕК</div>
            </div>

            <div>
                <button type="button" @click="startGame" class="btn btn-outline-success rounded-0 px-4 py-2" style="min-height: 48px;">
                    ПОВТОРИТЬ ЗАБЕГ НА РЕКОРД ↺
                </button>
            </div>
        </div>

    </div>

    <!-- Подключение локального Vue 3 -->
    <script is:inline src="/static/vue.global.js"></script>

    <script is:inline>
        // --- WEB AUDIO API ЗВУКОВОЙ ДВИЖОК ---
        let audioCtx = null;
        function getAudioContext() {
            try {
                if (!audioCtx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) audioCtx = new AudioCtx();
                }
                if (audioCtx && audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
            } catch (e) {}
            return audioCtx;
        }

        function playSound(type) {
            try {
                const ctx = getAudioContext();
                if (!ctx) return;
                const now = ctx.currentTime;
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);

                if (type === 'step') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(620, now);
                    osc.frequency.exponentialRampToValueAtTime(920, now + 0.08);
                    gain.gain.setValueAtTime(0.11, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.09);
                    osc.start(now);
                    osc.stop(now + 0.1);
                } else if (type === 'undo') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(420, now);
                    osc.frequency.exponentialRampToValueAtTime(260, now + 0.08);
                    gain.gain.setValueAtTime(0.09, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.09);
