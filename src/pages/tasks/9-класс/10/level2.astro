---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={2}>
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h2 class="h4 text-warning mb-0">Тренажер: Аналитический расчёт путей в графах (Уровень 2)</h2>
            <span class="badge border border-warning text-warning bg-dark rounded-0 px-3 py-2">Ручной ввод // Sawtooth 2-1-2</span>
        </div>

        <div id="game-container" class="card bg-dark border-warning rounded-0">
            <div class="card-body p-3 p-md-4">

                <!-- Заголовок и счетчик ошибок -->
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2 flex-wrap gap-2">
                    <div>
                        <span id="phase-badge" class="badge bg-warning text-dark rounded-0 fs-6 me-2">Шаг 1 из 5</span>
                        <span id="level-title" class="text-light fw-bold fs-6">Прямой расчёт кратчайшего пути (ОГЭ Задание 4)</span>
                    </div>
                    <div class="text-light small">
                        Ошибок: <span id="attempts-display" class="text-warning fw-bold">0</span>
                    </div>
                </div>

                <!-- Сообщение о статусе -->
                <div id="status-alert" class="alert d-none rounded-0 py-2 px-3 mb-3 fw-bold small border-0"></div>

                <!-- ======================================================== -->
                <!-- ФАЗА 1: Прямой расчет (CCS = 4)                           -->
                <!-- ======================================================== -->
                <div id="phase1" class="phase-container">
                    <h5 class="text-warning mb-2">Шаг 1: Длина кратчайшего пути по весовой матрице</h5>
                    <p class="text-light small mb-3">
                        Дана весовая матрица двусторонних автодорог между пунктами <code>A, B, C, D, E</code> (длины указаны в километрах).
                        Пустая ячейка означает отсутствие прямой дороги.
                    </p>

                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="table-responsive d-flex justify-content-center mb-2">
                            <table class="table table-bordered border-secondary table-dark text-center align-middle mb-0" style="max-width: 360px;">
                                <thead>
                                    <tr class="text-info">
                                        <th class="bg-dark text-light p-2" style="width: 52px;">км</th>
                                        <th class="bg-dark text-info p-2" style="width: 52px;">A</th>
                                        <th class="bg-dark text-info p-2" style="width: 52px;">B</th>
                                        <th class="bg-dark text-info p-2" style="width: 52px;">C</th>
                                        <th class="bg-dark text-info p-2" style="width: 52px;">D</th>
                                        <th class="bg-dark text-info p-2" style="width: 52px;">E</th>
                                    </tr>
                                </thead>
                                <tbody id="p1-matrix-tbody"></tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-2">
                        <label for="p1-input" class="form-label text-warning fw-bold small mb-2">
                            Определите длину кратчайшего пути между пунктами <code>A</code> и <code>E</code> (в км):
                        </label>
                        <div class="d-flex flex-column flex-sm-row gap-2 w-100" style="max-width: 580px;">
                            <input type="text" inputmode="decimal" id="p1-input" class="form-control rounded-0 font-monospace bg-dark text-warning border-secondary" placeholder="Введите число (например: 14)" style="min-height: 48px;" autocomplete="off" />
                            <button id="p1-btn" type="button" class="btn btn-warning rounded-0 fw-bold px-4" style="min-height: 48px; min-width: 150px;">ПРОВЕРИТЬ</button>
                        </div>
                    </div>
                </div>

                <!-- ======================================================== -->
                <!-- ФАЗА 2: Конвертация единиц (CCS = 6)                     -->
                <!-- ======================================================== -->
                <div id="phase2" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 2: Конвертация масштаба и расчёт длины пути</h5>
                    <p class="text-light small mb-3">
                        В таблице расстояний для кабельной сети длины прямых участков между узлами <code>A, B, C, D, E</code> указаны в <strong>метрах</strong>.
                        Переведите итоговое расстояние в <strong>километры</strong> (для дробной части используйте запятую или точку).
                    </p>

                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="table-responsive d-flex justify-content-center mb-2">
                            <table class="table table-bordered border-secondary table-dark text-center align-middle mb-0" style="max-width: 390px;">
                                <thead>
                                    <tr class="text-info">
                                        <th class="bg-dark text-light p-2" style="width: 56px;">м</th>
                                        <th class="bg-dark text-info p-2" style="width: 60px;">A</th>
                                        <th class="bg-dark text-info p-2" style="width: 60px;">B</th>
                                        <th class="bg-dark text-info p-2" style="width: 60px;">C</th>
                                        <th class="bg-dark text-info p-2" style="width: 60px;">D</th>
                                        <th class="bg-dark text-info p-2" style="width: 60px;">E</th>
                                    </tr>
                                </thead>
                                <tbody id="p2-matrix-tbody"></tbody>
                            </table>
                        </div>
                        <div class="text-light opacity-75 small text-center" style="font-size: 0.78rem;">
                            Напоминание: 1 км = 1000 м. Пример формата ответа: <code>4,5</code> или <code>5,25</code>.
                        </div>
                    </div>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-2">
                        <label for="p2-input" class="form-label text-warning fw-bold small mb-2">
                            Найдите длину кратчайшего маршрута между <code>A</code> и <code>E</code> в километрах:
                        </label>
                        <div class="d-flex flex-column flex-sm-row gap-2 w-100" style="max-width: 580px;">
                            <input type="text" inputmode="decimal" id="p2-input" class="form-control rounded-0 font-monospace bg-dark text-warning border-secondary" placeholder="Например: 4,5" style="min-height: 48px;" autocomplete="off" />
                            <button id="p2-btn" type="button" class="btn btn-warning rounded-0 fw-bold px-4" style="min-height: 48px; min-width: 150px;">ПРОВЕРИТЬ</button>
                        </div>
                    </div>
                </div>

                <!-- ======================================================== -->
                <!-- ФАЗА 3: Пик инверсии — обратная задача (CCS = 7-8)       -->
                <!-- ======================================================== -->
                <div id="phase3" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 3: Восстановление неизвестного веса дуги X (Инверсия)</h5>
                    <p id="p3-desc" class="text-light small mb-3"></p>

                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3 text-center">
                        <div class="text-info fw-bold small mb-2">ОРИЕНТИРОВАННЫЙ ГРАФ С НЕИЗВЕСТНЫМ УЧАСТКОМ X</div>
                        <div class="d-flex justify-content-center align-items-center" style="min-height: 220px;">
                            <svg id="p3-graph-svg" viewBox="0 0 380 220" class="w-100" style="max-height: 240px;"></svg>
                        </div>
                    </div>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-2">
                        <label for="p3-input" class="form-label text-warning fw-bold small mb-2">
                            Вычислите целочисленное значение неизвестного веса <code>X</code> (дуга <code>C → D</code>):
                        </label>
                        <div class="d-flex flex-column flex-sm-row gap-2 w-100" style="max-width: 580px;">
                            <input type="text" inputmode="decimal" id="p3-input" class="form-control rounded-0 font-monospace bg-dark text-warning border-secondary" placeholder="Введите значение X..." style="min-height: 48px;" autocomplete="off" />
                            <button id="p3-btn" type="button" class="btn btn-warning rounded-0 fw-bold px-4" style="min-height: 48px; min-width: 150px;">ПРОВЕРИТЬ</button>
                        </div>
                    </div>
                </div>

                <!-- ======================================================== -->
                <!-- ФАЗА 4: Долина консолидации (CCS = 5-6)                  -->
                <!-- ======================================================== -->
                <div id="phase4" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 4: Количество путей в DAG с запрещённой вершиной</h5>
                    <p id="p4-desc" class="text-light small mb-3"></p>

                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3 text-center">
                        <div class="text-info fw-bold small mb-2">СХЕМА ОДНОСТОРОННИХ ДОРОГ (DAG)</div>
                        <div class="d-flex justify-content-center align-items-center" style="min-height: 230px;">
                            <svg id="p4-dag-svg" viewBox="0 0 420 230" class="w-100" style="max-height: 245px;"></svg>
                        </div>
                    </div>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-2">
                        <label for="p4-input" class="form-label text-warning fw-bold small mb-2">
                            Укажите точное количество допустимых путей из <code>А</code> в <code>Е</code>:
                        </label>
                        <div class="d-flex flex-column flex-sm-row gap-2 w-100" style="max-width: 580px;">
                            <input type="text" inputmode="decimal" id="p4-input" class="form-control rounded-0 font-monospace bg-dark text-warning border-secondary" placeholder="Введите целое число..." style="min-height: 48px;" autocomplete="off" />
                            <button id="p4-btn" type="button" class="btn btn-warning rounded-0 fw-bold px-4" style="min-height: 48px; min-width: 150px;">ПРОВЕРИТЬ</button>
                        </div>
                    </div>
                </div>

                <!-- ======================================================== -->
                <!-- ФАЗА 5: Кульминация (CCS = 8-9)                          -->
                <!-- ======================================================== -->
                <div id="phase5" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 5: Комбинированный маршрут в DAG (Обязательный и запрещённый узлы)</h5>
                    <p id="p5-desc" class="text-light small mb-3"></p>

                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3 text-center">
                        <div class="text-info fw-bold small mb-2">НАПРАВЛЕННЫЙ АЦИКЛИЧЕСКИЙ ГРАФ ИЗ 7 ВЕРШИН</div>
                        <div class="d-flex justify-content-center align-items-center" style="min-height: 240px;">
                            <svg id="p5-dag-svg" viewBox="0 0 460 240" class="w-100" style="max-height: 255px;"></svg>
                        </div>
                    </div>

                    <div class="card bg-black border-warning rounded-0 p-3 mb-2">
                        <label for="p5-input" class="form-label text-warning fw-bold small mb-2">
                            Вычислите количество путей из <code>А</code> в <code>Ж</code> с учётом обоих условий:
                        </label>
                        <div class="d-flex flex-column flex-sm-row gap-2 w-100" style="max-width: 580px;">
                            <input type="text" inputmode="decimal" id="p5-input" class="form-control rounded-0 font-monospace bg-dark text-warning border-secondary" placeholder="Введите количество путей..." style="min-height: 48px;" autocomplete="off" />
                            <button id="p5-btn" type="button" class="btn btn-warning rounded-0 fw-bold px-4" style="min-height: 48px; min-width: 150px;">ПРОВЕРИТЬ</button>
                        </div>
                    </div>
                </div>

                <!-- Экран завершения уровня -->
                <div id="victory-screen" class="d-none text-center py-5">
                    <div class="display-5 text-warning mb-3 fw-bold">АНАЛИТИКА ЗАВЕРШЕНА!</div>
                    <p class="text-light fs-5 mb-4">
                        Все 5 фаз пройдены: от прямого анализа весовых матриц и конвертации единиц до обратной задачи поиска веса дуги и комбинированных маршрутов в направленных ациклических графах.
                    </p>
                    <div class="badge bg-dark border border-warning text-warning p-3 fs-6 rounded-0 mb-4">
                        Телеметрия зафиксирована: action_type = 'level_complete'
                    </div>
                    <div>
                        <button id="continue-btn" type="button" class="btn btn-outline-warning btn-lg rounded-0 px-5 py-3 fw-bold" style="min-height: 48px;">
                            ПЕРЕЙТИ К УРОВНЮ 3 (АРКАДА) →
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(function() {
    const telemetry = window.LMSTelemetry.create({
        missionName: 'Урок 10 :: Граф. Весовая матрица графа. Длина пути между вершинами графа. Вычисление количества путей в направленном ациклическом графе (Уровень 2)',
        level: 2,
        totalStages: 5
    });

    let currentPhase = 1;
    let isTransitioning = false;
    let isLevelCompleted = false;
    let appInitialized = false;

    let p1Answer = 0;
    let p2Answer = 0;
    let p3Answer = 0;
    let p4Answer = 0;
    let p5Answer = 0;

    const SVG_NS = 'http://www.w3.org/2000/svg';
    const PHASE_TITLES = {
        1: 'Прямой расчёт кратчайшего пути (ОГЭ Задание 4)',
        2: 'Конвертация единиц измерения в матрице расстояний',
        3: 'Обратная задача: поиск неизвестного веса X',
        4: 'Долина консолидации: подсчёт путей в DAG без запрещённой вершины',
        5: 'Кульминация: комбинированные ограничения в 7-вершинном DAG'
    };

    function randInt(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    function shuffle(arr) {
        const a = arr.slice();
        for (let i = a.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            const tmp = a[i];
            a[i] = a[j];
            a[j] = tmp;
        }
        return a;
    }

    function svgEl(tag, attrs = {}) {
        const el = document.createElementNS(SVG_NS, tag);
        for (const [k, v] of Object.entries(attrs)) {
            el.setAttribute(k, String(v));
        }
        return el;
    }

    function parseNumericInput(raw) {
        const cleaned = String(raw || '').replace(/%/g, '').replace(/,/g, '.').trim();
        if (!cleaned) return NaN;
        return Number(cleaned);
    }

    function showStatus(text, isError = false) {
        const el = document.getElementById('status-alert');
        if (!el) return;
        el.className = isError
            ? 'alert alert-danger bg-danger text-white rounded-0 py-2 px-3 mb-3 fw-bold small border-0'
            : 'alert alert-success bg-success text-dark rounded-0 py-2 px-3 mb-3 fw-bold small border-0';
        el.textContent = text;
        el.classList.remove('d-none');
    }

    function hideStatus() {
        const el = document.getElementById('status-alert');
        if (el) el.classList.add('d-none');
    }

    function triggerFailure(phaseNum, initFunc, message) {
        if (isTransitioning || isLevelCompleted) return;
        isTransitioning = true;
        telemetry.fail({ stage: phaseNum });
        const attemptsEl = document.getElementById('attempts-display');
        if (attemptsEl) attemptsEl.textContent = telemetry.getState().attemptsCount;
        showStatus('ОШИБКА РАСЧЁТА: ' + message + ' Генерация нового варианта...', true);

        const btn = document.getElementById(`p${phaseNum}-btn`);
        const input = document.getElementById(`p${phaseNum}-input`);
        if (btn) btn.disabled = true;
        if (input) input.disabled = true;

        setTimeout(() => {
            hideStatus();
            isTransitioning = false;
            if (btn) btn.disabled = false;
            if (input) {
                input.disabled = false;
                input.value = '';
                input.focus();
            }
            initFunc();
        }, 1200);
    }

    function advanceToPhase(currentNum, nextNum, message) {
        isTransitioning = true;
        const btn = document.getElementById(`p${currentNum}-btn`);
        const input = document.getElementById(`p${currentNum}-input`);
        if (btn) btn.disabled = true;
        if (input) input.disabled = true;
        showStatus(message, false);
        setTimeout(() => {
            hideStatus();
            if (btn) btn.disabled = false;
            if (input) input.disabled = false;
            isTransitioning = false;
            telemetry.advanceStage(nextNum);
            showPhase(nextNum);
        }, 900);
    }

    function showPhase(phaseNum) {
        currentPhase = phaseNum;
        document.querySelectorAll('.phase-container').forEach(el => el.classList.add('d-none'));
        const target = document.getElementById(`phase${phaseNum}`);
        if (target) target.classList.remove('d-none');

        document.getElementById('phase-badge').textContent = `Шаг ${phaseNum} из 5`;
        document.getElementById('level-title').textContent = PHASE_TITLES[phaseNum] || '';

        const input = document.getElementById(`p${phaseNum}-input`);
        if (input) {
            input.value = '';
            input.focus();
        }
    }

    // Вспомогательная функция поиска кратчайшего пути в неориентированном графе A..E
    function shortestPathAE(adj, curr = 'A', visited = new Set(['A']), dist = 0) {
        if (curr === 'E') return dist;
        let best = Infinity;
        for (const [next, w] of Object.entries(adj[curr])) {
            if (!visited.has(next)) {
                visited.add(next);
                const d = shortestPathAE(adj, next, visited, dist + w);
                if (d < best) best = d;
                visited.delete(next);
            }
        }
        return best;
    }

    function generateUndirectedMatrix(unitStep, minFactor, maxFactor, requireNonIntegerKm) {
        const nodes = ['A', 'B', 'C', 'D', 'E'];
        const edgePairs = [
            ['A', 'B'], ['A', 'C'],
            ['B', 'C'], ['B', 'D'],
            ['C', 'D'], ['C', 'E'],
            ['D', 'E']
        ];

        for (let attempt = 0; attempt < 250; attempt++) {
            const adj = { A: {}, B: {}, C: {}, D: {}, E: {} };
            edgePairs.forEach(([u, v]) => {
                // Делаем C-E дороже, чтобы не все пути сводились к 2 рёбрам
                const f = (u === 'C' && v === 'E') ? randInt(maxFactor - 2, maxFactor + 4) : randInt(minFactor, maxFactor);
                const w = f * unitStep;
                adj[u][v] = w;
                adj[v][u] = w;
            });

            // Случайно убираем одну из некритических связей (B-D или C-D, но не обе)
            if (Math.random() > 0.5) {
                delete adj.B.D;
                delete adj.D.B;
            }

            const best = shortestPathAE(adj);
            if (!Number.isFinite(best)) continue;
            if (requireNonIntegerKm && best % 1000 === 0) continue;
            return { nodes, adj, best };
        }

        // Детерминированный резерв
        const fallbackAdj = {
            A: { B: 3 * unitStep, C: 7 * unitStep },
            B: { A: 3 * unitStep, C: 2 * unitStep },
            C: { A: 7 * unitStep, B: 2 * unitStep, D: 3 * unitStep, E: 11 * unitStep },
            D: { C: 3 * unitStep, E: 3 * unitStep },
            E: { C: 11 * unitStep, D: 3 * unitStep }
        };
        return { nodes, adj: fallbackAdj, best: 11 * unitStep };
    }

    function renderWeightMatrix(tbodyId, nodes, adj) {
        const tbody = document.getElementById(tbodyId);
        tbody.innerHTML = '';
        for (const r of nodes) {
            const tr = document.createElement('tr');
            const th = document.createElement('th');
            th.className = 'bg-dark text-info p-2';
            th.textContent = r;
            tr.appendChild(th);

            for (const c of nodes) {
                const td = document.createElement('td');
                if (r === c) {
                    td.className = 'bg-black text-secondary p-2';
                    td.textContent = '';
                } else if (adj[r][c] !== undefined) {
                    td.className = 'bg-dark text-warning fw-bold p-2';
                    td.textContent = String(adj[r][c]);
                } else {
                    td.className = 'bg-dark text-secondary p-2';
                    td.textContent = '';
                }
                tr.appendChild(td);
            }
            tbody.appendChild(tr);
        }
    }

    // =====================================================
    // ФАЗА 1: ПРЯМОЙ РАСЧЁТ (CCS = 4)
    // =====================================================
    function initPhase1() {
        const { nodes, adj, best } = generateUndirectedMatrix(1, 2, 9, false);
        p1Answer = best;
        renderWeightMatrix('p1-matrix-tbody', nodes, adj);
    }

    function checkPhase1() {
        const val = parseNumericInput(document.getElementById('p1-input').value);
        if (!Number.isFinite(val)) {
            showStatus('Введите целое число — длину пути в километрах.', true);
            return;
        }
        if (Math.abs(val - p1Answer) < 1e-6) {
            advanceToPhase(1, 2, 'Верно! Переход к Шагу 2 (конвертация единиц)...');
        } else {
            triggerFailure(1, initPhase1, 'Вычислена неверная длина кратчайшего пути. Постройте дерево маршрутов на черновике.');
        }
    }

    // =====================================================
    // ФАЗА 2: КОНВЕРТАЦИЯ ЕДИНИЦ (м -> км, дробь с запятой)
    // =====================================================
    function initPhase2() {
        const { nodes, adj, best } = generateUndirectedMatrix(250, 2, 9, true);
        p2Answer = best / 1000; // Точная конечная десятичная дробь (.25, .5 или .75)
        renderWeightMatrix('p2-matrix-tbody', nodes, adj);
    }

    function checkPhase2() {
        const val = parseNumericInput(document.getElementById('p2-input').value);
        if (!Number.isFinite(val)) {
            showStatus('Введите число в километрах (например: 4,5).', true);
            return;
        }
        if (Math.abs(val - p2Answer) < 1e-6) {
            advanceToPhase(2, 3, 'Отлично! Перевод метров в километры выполнен точно. Переход к Шагу 3...');
        } else {
            triggerFailure(2, initPhase2, 'Проверьте выбор кратчайшего маршрута и деление на 1000.');
        }
    }

    // =====================================================
    // ФАЗА 3: ПИК 1 — ИНВЕРСИЯ (ПОИСК НЕИЗВЕСТНОГО X)
    // =====================================================
    const P3_COORDS = {
        A: { x: 45, y: 110 },
        B: { x: 145, y: 42 },
        C: { x: 145, y: 178 },
        D: { x: 255, y: 110 },
        E: { x: 340, y: 110 }
    };

    function allDirectedPathsAE(edges) {
        const adj = { A: [], B: [], C: [], D: [], E: [] };
        edges.forEach(e => adj[e.u].push(e));
        const res = [];
        function dfs(node, dist, usedCD) {
            if (node === 'E') {
                res.push({ dist, usedCD });
                return;
            }
            for (const e of adj[node]) {
                dfs(e.v, dist + e.w, usedCD || (e.u === 'C' && e.v === 'D'));
            }
        }
        dfs('A', 0, false);
        return res;
    }

    function initPhase3() {
        let chosenEdges = null;
        let trueX = 4;
        let targetT = 12;

        for (let attempt = 0; attempt < 250; attempt++) {
            trueX = randInt(2, 9);
            const edges = [
                { u: 'A', v: 'B', w: randInt(2, 8) },
                { u: 'A', v: 'C', w: randInt(2, 8) },
                { u: 'B', v: 'C', w: randInt(1, 6) },
                { u: 'B', v: 'D', w: randInt(4, 11) },
                { u: 'C', v: 'D', w: trueX, isX: true },
                { u: 'B', v: 'E', w: randInt(10, 18) },
                { u: 'C', v: 'E', w: randInt(10, 18) },
                { u: 'D', v: 'E', w: randInt(2, 7) }
            ];

            const paths = allDirectedPathsAE(edges);
            const withX = paths.filter(p => p.usedCD).map(p => p.dist);
            const withoutX = paths.filter(p => !p.usedCD).map(p => p.dist);
            const minWithX = Math.min(...withX);
            const minWithoutX = Math.min(...withoutX);

            if (minWithX + 2 <= minWithoutX) {
                chosenEdges = edges;
                targetT = minWithX;
                break;
            }
        }

        if (!chosenEdges) {
            trueX = 3;
            targetT = 9;
            chosenEdges = [
                { u: 'A', v: 'B', w: 2 },
                { u: 'A', v: 'C', w: 5 },
                { u: 'B', v: 'C', w: 2 },
                { u: 'B', v: 'D', w: 9 },
                { u: 'C', v: 'D', w: 3, isX: true },
                { u: 'B', v: 'E', w: 14 },
                { u: 'C', v: 'E', w: 13 },
                { u: 'D', v: 'E', w: 2 }
            ];
        }

        p3Answer = trueX;
        document.getElementById('p3-desc').innerHTML =
            `Движение на схеме возможно только по стрелкам. Известно, что длина кратчайшего пути из <code>A</code> в <code>E</code> равна ровно <strong class="text-warning">${targetT} км</strong>, ` +
            `и обходные маршруты без дуги <code>C → D</code> длиннее ${targetT} км. Найдите вес <code>X</code> дуги <code>C → D</code>.`;

        renderPhase3Graph(chosenEdges);
    }

    function renderPhase3Graph(edges) {
        const svg = document.getElementById('p3-graph-svg');
        svg.innerHTML = '';

        const defs = svgEl('defs');
        const mk = svgEl('marker', {
            id: 'p3-arr',
            viewBox: '0 0 10 10',
            refX: '9',
            refY: '5',
            markerWidth: '6',
            markerHeight: '6',
            orient: 'auto-start-reverse'
        });
        mk.appendChild(svgEl('path', { d: 'M 0 1 L 10 5 L 0 9 z', fill: '#38bdf8' }));
        defs.appendChild(mk);

        const mkX = svgEl('marker', {
            id: 'p3-arr-x',
            viewBox: '0 0 10 10',
            refX: '9',
            refY: '5',
            markerWidth: '6',
            markerHeight: '6',
            orient: 'auto-start-reverse'
        });
        mkX.appendChild(svgEl('path', { d: 'M 0 1 L 10 5 L 0 9 z', fill: '#facc15' }));
        defs.appendChild(mkX);
        svg.appendChild(defs);

        edges.forEach(e => {
            const p1 = P3_COORDS[e.u];
            const p2 = P3_COORDS[e.v];
            let lx, ly;

            if ((e.u === 'B' && e.v === 'E') || (e.u === 'C' && e.v === 'E')) {
                const ctrlX = 275;
                const ctrlY = e.u === 'B' ? 14 : 206;
                const sx = p1.x + 18;
                const sy = p1.y + (e.u === 'B' ? -6 : 6);
                const ex = p2.x - 10;
                const ey = p2.y + (e.u === 'B' ? -18 : 18);
                svg.appendChild(svgEl('path', {
                    d: `M ${sx} ${sy} Q ${ctrlX} ${ctrlY} ${ex} ${ey}`,
                    fill: 'none',
                    stroke: '#64748b',
                    'stroke-width': '2',
                    'marker-end': 'url(#p3-arr)'
                }));
                lx = 0.25 * sx + 0.5 * ctrlX + 0.25 * ex;
                ly = 0.25 * sy + 0.5 * ctrlY + 0.25 * ey;
            } else {
                const dx = p2.x - p1.x;
                const dy = p2.y - p1.y;
                const dist = Math.hypot(dx, dy);
                const ux = dx / dist;
                const uy = dy / dist;
                svg.appendChild(svgEl('line', {
                    x1: p1.x + ux * 21,
                    y1: p1.y + uy * 21,
                    x2: p2.x - ux * 22,
                    y2: p2.y - uy * 22,
                    stroke: e.isX ? '#facc15' : '#38bdf8',
                    'stroke-width': e.isX ? '3' : '2.2',
                    'marker-end': e.isX ? 'url(#p3-arr-x)' : 'url(#p3-arr)'
                }));
                lx = (p1.x + p2.x) / 2;
                ly = (p1.y + p2.y) / 2;
            }

            svg.appendChild(svgEl('rect', {
                x: lx - 13,
                y: ly - 10,
                width: 26,
                height: 20,
                fill: e.isX ? '#422006' : '#000000',
                stroke: e.isX ? '#facc15' : '#475569',
                'stroke-width': '1.5'
            }));
            const lbl = svgEl('text', {
                x: lx,
                y: ly + 4,
                'text-anchor': 'middle',
                fill: e.isX ? '#facc15' : '#e2e8f0',
                'font-size': '13',
                'font-weight': 'bold'
            });
            lbl.textContent = e.isX ? 'X' : String(e.w);
            svg.appendChild(lbl);
        });

        for (const [node, pos] of Object.entries(P3_COORDS)) {
            svg.appendChild(svgEl('circle', {
                cx: pos.x, cy: pos.y, r: 19,
                fill: '#0f172a',
                stroke: node === 'A' || node === 'E' ? '#22c55e' : '#38bdf8',
                'stroke-width': '2.5'
            }));
            const txt = svgEl('text', {
                x: pos.x, y: pos.y + 5,
                'text-anchor': 'middle',
                fill: '#f8fafc',
                'font-size': '14',
                'font-weight': 'bold'
            });
            txt.textContent = node;
            svg.appendChild(txt);
        }
    }

    function checkPhase3() {
        const val = parseNumericInput(document.getElementById('p3-input').value);
        if (!Number.isFinite(val)) {
            showStatus('Введите целое значение веса X.', true);
            return;
        }
        if (Math.abs(val - p3Answer) < 1e-6) {
            advanceToPhase(3, 4, 'Инверсия решена! Переход к Шагу 4 (долина консолидации)...');
        } else {
            triggerFailure(3, initPhase3, 'Неверный вес X. Найдите минимальный путь до C, добавьте участок D → E и вычтите из общей длины.');
        }
    }

    // =====================================================
    // ФАЗА 4: ДОЛИНА КОНСОЛИДАЦИИ — БАЗОВЫЙ DAG (ЗАПРЕТ)
    // =====================================================
    const P4_ORDER = ['А', 'Б', 'Г', 'В', 'Д', 'Е'];
    const P4_COORDS = {
        А: { x: 42, y: 115 },
        Б: { x: 138, y: 45 },
        Г: { x: 138, y: 185 },
        В: { x: 222, y: 115 },
        Д: { x: 306, y: 115 },
        Е: { x: 382, y: 115 }
    };

    function countDagPaths(order, edges, reqNode, forbNode) {
        const incoming = {};
        for (const v of order) incoming[v] = [];
        edges.forEach(([u, v]) => incoming[v].push(u));

        function runFrom(startNode, endNode) {
            if (startNode === forbNode || endNode === forbNode) return 0;
            const dp = {};
            for (const v of order) dp[v] = 0;
            dp[startNode] = 1;
            const startIdx = order.indexOf(startNode);
            for (let i = startIdx + 1; i < order.length; i++) {
                const v = order[i];
                if (v === forbNode) {
                    dp[v] = 0;
                } else {
                    dp[v] = incoming[v].reduce((s, u) => s + dp[u], 0);
                }
            }
            return dp[endNode];
        }

        const start = order[0];
        const end = order[order.length - 1];
        if (!reqNode) return runFrom(start, end);
        return runFrom(start, reqNode) * runFrom(reqNode, end);
    }

    function initPhase4() {
        const edges = [
            ['А', 'Б'],
            ['А', 'Г'],
            ['Б', 'Д'],
            ['Г', 'Д'],
            ['В', 'Д'],
            ['Д', 'Е']
        ];
        shuffle([['А', 'В'], ['Б', 'В'], ['Г', 'В']]).slice(0, randInt(2, 3)).forEach(e => edges.push(e));
        shuffle([['Б', 'Е'], ['Г', 'Е']]).slice(0, randInt(1, 2)).forEach(e => edges.push(e));

        const forbidden = shuffle(['Б', 'В', 'Г'])[0];
        p4Answer = countDagPaths(P4_ORDER, edges, null, forbidden);

        document.getElementById('p4-desc').innerHTML =
            `Вычислите количество различных путей из города <code>А</code> в город <code>Е</code>, <strong class="text-danger">НЕ проходящих</strong> через закрытый пункт <code>${forbidden}</code>.`;

        renderDagSvg('p4-dag-svg', P4_ORDER, P4_COORDS, edges, null, forbidden, [['Б', 'Е'], ['Г', 'Е']]);
    }

    function checkPhase4() {
        const val = parseNumericInput(document.getElementById('p4-input').value);
        if (!Number.isFinite(val)) {
            showStatus('Введите целое число путей.', true);
            return;
        }
        if (Math.abs(val - p4Answer) < 1e-6) {
            advanceToPhase(4, 5, 'Отлично! Переходим к финальной кульминации (Шаг 5)...');
        } else {
            triggerFailure(4, initPhase4, 'Неверное количество путей. Обнулите запрещённую вершину и просуммируйте входящие стрелки.');
        }
    }

    // =====================================================
    // ФАЗА 5: КУЛЬМИНАЦИЯ — 7-ВЕРШИННЫЙ DAG (ОБЯЗАТ. + ЗАПРЕТ)
    // =====================================================
    const P5_ORDER = ['А', 'Б', 'В', 'Г', 'Д', 'Е', 'Ж'];
    const P5_COORDS = {
        А: { x: 40, y: 120 },
        Б: { x: 130, y: 46 },
        В: { x: 130, y: 194 },
        Г: { x: 230, y: 120 },
        Д: { x: 330, y: 46 },
        Е: { x: 330, y: 194 },
        Ж: { x: 420, y: 120 }
    };

    function initPhase5() {
        let edges = null;
        let reqNode = 'Г';
        let forbNode = 'Д';
        let ans = 0;

        for (let attempt = 0; attempt < 150; attempt++) {
            const candidate = [
                ['А', 'Б'], ['А', 'В'], ['А', 'Г'],
                ['Б', 'Г'], ['В', 'Г'],
                ['Б', 'Д'], ['В', 'Е'],
                ['Г', 'Д'], ['Г', 'Е'], ['Г', 'Ж'],
                ['Д', 'Ж'], ['Е', 'Ж']
            ];
            if (Math.random() > 0.4) candidate.push(['Б', 'В']);
            if (Math.random() > 0.4) candidate.push(['Д', 'Е']);

            const req = 'Г';
            const forb = shuffle(['Б', 'В', 'Д', 'Е'])[0];

            const cAll = countDagPaths(P5_ORDER, candidate, null, null);
            const cReq = countDagPaths(P5_ORDER, candidate, req, null);
            const cForb = countDagPaths(P5_ORDER, candidate, null, forb);
            const cBoth = countDagPaths(P5_ORDER, candidate, req, forb);

            if (cBoth >= 3 && cBoth < cReq && cBoth < cForb && cReq < cAll) {
                edges = candidate;
                reqNode = req;
                forbNode = forb;
                ans = cBoth;
                break;
            }
        }

        if (!edges) {
            edges = [
                ['А', 'Б'], ['А', 'В'], ['А', 'Г'],
                ['Б', 'Г'], ['В', 'Г'], ['Б', 'Д'], ['В', 'Е'],
                ['Г', 'Д'], ['Г', 'Е'], ['Г', 'Ж'], ['Д', 'Ж'], ['Е', 'Ж']
            ];
            reqNode = 'Г';
            forbNode = 'Д';
            ans = countDagPaths(P5_ORDER, edges, reqNode, forbNode);
        }

        p5Answer = ans;
        document.getElementById('p5-desc').innerHTML =
            `Сколько существует различных путей из <code>А</code> в <code>Ж</code>, которые ` +
            `<strong class="text-success">ОБЯЗАТЕЛЬНО проходят</strong> через вершину <code>${reqNode}</code>, но ` +
            `<strong class="text-danger">НЕ проходят</strong> через вершину <code>${forbNode}</code>?`;

        renderDagSvg('p5-dag-svg', P5_ORDER, P5_COORDS, edges, reqNode, forbNode, []);
    }

    function renderDagSvg(svgId, order, coords, edges, reqNode, forbNode, curvedPairs) {
        const svg = document.getElementById(svgId);
        svg.innerHTML = '';

        const defs = svgEl('defs');
        const mk = svgEl('marker', {
            id: svgId + '-arr',
            viewBox: '0 0 10 10',
            refX: '9',
            refY: '5',
            markerWidth: '6',
            markerHeight: '6',
            orient: 'auto-start-reverse'
        });
        mk.appendChild(svgEl('path', { d: 'M 0 1 L 10 5 L 0 9 z', fill: '#facc15' }));
        defs.appendChild(mk);

        const mkMuted = svgEl('marker', {
            id: svgId + '-arr-m',
            viewBox: '0 0 10 10',
            refX: '9',
            refY: '5',
            markerWidth: '6',
            markerHeight: '6',
            orient: 'auto-start-reverse'
        });
        mkMuted.appendChild(svgEl('path', { d: 'M 0 1 L 10 5 L 0 9 z', fill: '#475569' }));
        defs.appendChild(mkMuted);
        svg.appendChild(defs);

        const curvedSet = new Set(curvedPairs.map(p => p[0] + '->' + p[1]));

        edges.forEach(([u, v]) => {
            const p1 = coords[u];
            const p2 = coords[v];
            const isMuted = u === forbNode || v === forbNode;

            if (curvedSet.has(u + '->' + v)) {
                const isTop = p1.y < 120;
                const ctrlY = isTop ? 12 : 218;
                const sx = p1.x + 18;
                const sy = p1.y + (isTop ? -6 : 6);
                const ex = p2.x - 10;
                const ey = p2.y + (isTop ? -18 : 18);
                svg.appendChild(svgEl('path', {
                    d: `M ${sx} ${sy} Q ${(p1.x + p2.x) / 2} ${ctrlY} ${ex} ${ey}`,
                    fill: 'none',
                    stroke: isMuted ? '#475569' : '#facc15',
                    'stroke-width': isMuted ? '1.6' : '2.2',
                    'stroke-dasharray': isMuted ? '4 4' : 'none',
                    'marker-end': isMuted ? `url(#${svgId}-arr-m)` : `url(#${svgId}-arr)`
                }));
                return;
            }

            const dx = p2.x - p1.x;
            const dy = p2.y - p1.y;
            const dist = Math.hypot(dx, dy);
            const ux = dx / dist;
            const uy = dy / dist;

            svg.appendChild(svgEl('line', {
                x1: p1.x + ux * 20,
                y1: p1.y + uy * 20,
                x2: p2.x - ux * 21,
                y2: p2.y - uy * 21,
                stroke: isMuted ? '#475569' : '#facc15',
                'stroke-width': isMuted ? '1.6' : '2.2',
                'stroke-dasharray': isMuted ? '4 4' : 'none',
                'marker-end': isMuted ? `url(#${svgId}-arr-m)` : `url(#${svgId}-arr)`
            }));
        });

        order.forEach(node => {
            const { x, y } = coords[node];
            const isForb = node === forbNode;
            const isReq = node === reqNode;
            const isEnd = node === order[0] || node === order[order.length - 1];

            let stroke = '#38bdf8';
            let fill = '#0f172a';
            if (isForb) {
                stroke = '#ef4444';
                fill = '#450a0a';
            } else if (isReq) {
                stroke = '#22c55e';
                fill = '#052e16';
            } else if (isEnd) {
                stroke = '#facc15';
                fill = '#1e293b';
            }

            svg.appendChild(svgEl('circle', {
                cx: x, cy: y, r: 19,
                fill, stroke, 'stroke-width': '2.5'
            }));

            const txt = svgEl('text', {
                x, y: y + 5,
                'text-anchor': 'middle',
                fill: isForb ? '#fca5a5' : '#f8fafc',
                'font-size': '14',
                'font-weight': 'bold'
            });
            txt.textContent = node;
            svg.appendChild(txt);

            if (isForb || isReq) {
                const tagY = y >= 150 ? y + 32 : y - 24;
                const tag = svgEl('text', {
                    x, y: tagY,
                    'text-anchor': 'middle',
                    fill: isForb ? '#f87171' : '#4ade80',
                    'font-size': '11',
                    'font-weight': 'bold'
                });
                tag.textContent = isForb ? 'ЗАПРЕТ (0)' : 'ОБЯЗАТ.';
                svg.appendChild(tag);
            }
        });
    }

    function checkPhase5() {
        const val = parseNumericInput(document.getElementById('p5-input').value);
        if (!Number.isFinite(val)) {
            showStatus('Введите целое число путей.', true);
            return;
        }
        if (Math.abs(val - p5Answer) < 1e-6) {
            finishLevel();
        } else {
            triggerFailure(5, initPhase5, 'Неверный подсчёт. Исключите запрещённую вершину и разбейте путь на два этапа через обязательную вершину.');
        }
    }

    function finishLevel() {
        if (isLevelCompleted) return;
        isLevelCompleted = true;

        document.querySelectorAll('.phase-container').forEach(el => el.classList.add('d-none'));
        document.getElementById('phase-badge').textContent = 'Успешно';
        document.getElementById('phase-badge').className = 'badge bg-success text-dark rounded-0 fs-6 me-2';
        document.getElementById('level-title').textContent = 'Уровень 2 завершён';
        document.getElementById('victory-screen').classList.remove('d-none');

        telemetry.complete({ stage: 5 });
    }

    function bindGlobalListenersOnce() {
        const phases = [
            { num: 1, check: checkPhase1 },
            { num: 2, check: checkPhase2 },
            { num: 3, check: checkPhase3 },
            { num: 4, check: checkPhase4 },
            { num: 5, check: checkPhase5 }
        ];

        phases.forEach(({ num, check }) => {
            const btn = document.getElementById(`p${num}-btn`);
            const input = document.getElementById(`p${num}-input`);
            if (btn) {
                btn.addEventListener('click', () => {
                    if (isTransitioning || isLevelCompleted) return;
                    telemetry.markActivity();
                    check();
                });
            }
            if (input) {
                input.addEventListener('keydown', (e) => {
                    telemetry.markActivity();
                    if (e.key === 'Enter' && !isTransitioning && !isLevelCompleted) {
                        e.preventDefault();
                        check();
                    }
                });
            }
        });

        const continueBtn = document.getElementById('continue-btn');
        if (continueBtn) {
            continueBtn.addEventListener('click', () => {
                window.location.href = '/tasks/9-класс/10/level3';
            });
        }
    }

    function initApp() {
        if (appInitialized) return;
        appInitialized = true;
        bindGlobalListenersOnce();

        initPhase1();
        initPhase2();
        initPhase3();
        initPhase4();
        initPhase5();
        showPhase(1);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initApp, { once: true });
    } else {
        initApp();
    }
})();
</script>
