            const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            text.setAttribute('x', pt.x);
            text.setAttribute('y', pt.y + 6);
            text.setAttribute('text-anchor', 'middle');
            text.setAttribute('fill', '#ffffff');
            text.setAttribute('font-family', 'monospace');
            text.setAttribute('font-weight', 'bold');
            text.setAttribute('font-size', '16');
            text.textContent = pt.label;
            svg.appendChild(text);
        });
    }

    function renderPhase2Matrix() {
        const tbody = document.getElementById('matrix-tbody');
        tbody.innerHTML = '';
        const labels = ['A', 'B', 'C', 'D'];

        for (let r = 0; r < 4; r++) {
            const tr = document.createElement('tr');
            
            // Заголовок строки
            const th = document.createElement('th');
            th.className = 'bg-dark text-info p-2';
            th.textContent = labels[r];
            tr.appendChild(th);

            for (let c = 0; c < 4; c++) {
                const td = document.createElement('td');
                td.className = 'p-1';

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn rounded-0 fw-bold w-100 p-0 d-flex justify-content-center align-items-center matrix-cell';
                btn.style.minWidth = '48px';
                btn.style.minHeight = '48px';
                btn.style.fontSize = '1.15rem';
                btn.dataset.row = r;
                btn.dataset.col = c;

                if (r === c) {
                    // Главная диагональ: петли отсутствуют, кнопка заблокирована
                    btn.textContent = '0';
                    btn.className += ' btn-dark text-secondary border border-secondary disabled';
                    btn.style.opacity = '0.5';
                    btn.disabled = true;
                    btn.title = 'Главная диагональ (петель нет)';
                } else {
                    const val = phase2Data.userMatrix[r][c];
                    btn.textContent = val;
                    if (val === 1) {
                        btn.className += ' btn-success text-dark border-success';
                    } else {
                        btn.className += ' btn-dark text-secondary border-secondary';
                    }

                    // Переключение 0 ↔ 1 по клику
                    btn.addEventListener('click', () => {
                        const newVal = phase2Data.userMatrix[r][c] === 1 ? 0 : 1;
                        phase2Data.userMatrix[r][c] = newVal;
                        btn.textContent = newVal;
                        if (newVal === 1) {
                            btn.classList.remove('btn-dark', 'text-secondary', 'border-secondary');
                            btn.classList.add('btn-success', 'text-dark', 'border-success');
                        } else {
                            btn.classList.remove('btn-success', 'text-dark', 'border-success');
                            btn.classList.add('btn-dark', 'text-secondary', 'border-secondary');
                        }
                    });
                }

                td.appendChild(btn);
                tr.appendChild(td);
            }
            tbody.appendChild(tr);
        }
    }

    function verifyPhase2() {
        let hasError = false;
        let isAsymmetric = false;

        for (let r = 0; r < 4; r++) {
            for (let c = 0; c < 4; c++) {
                if (phase2Data.userMatrix[r][c] !== phase2Data.targetMatrix[r][c]) {
                    hasError = true;
                }
                if (phase2Data.userMatrix[r][c] !== phase2Data.userMatrix[c][r]) {
                    isAsymmetric = true;
                }
            }
        }

        if (isAsymmetric) {
            triggerFailure('Нарушена зеркальная симметрия матрицы! Для неориентированного графа ячейка (i, j) обязана равняться ячейке (j, i).');
            return;
        }

        if (hasError) {
            triggerFailure('Значения в матрице смежности не совпадают с ребрами графа. Проверьте соответствие ребер единицам.');
            return;
        }

        showStatus('ШАГ 2 ВЫПОЛНЕН! Двоичная матрица смежности настроена безошибочно.', false);
        setTimeout(() => {
            hideStatus();
            currentPhase = 3;
            sendTelemetry('in_progress');
            initPhase(3);
        }, 1000);
    }

    // ==========================================
    // ФАЗА 3: СЛОТ-ПАЗЛ ВЕСОВОЙ МАТРИЦЫ ДОРОГ
    // ==========================================
    function setupPhase3() {
        document.getElementById('phase-badge').textContent = 'Шаг 3 из 3';
        document.getElementById('phase-title').textContent = 'Слот-пазл: Восстановление весовой матрицы расстояний';
        document.getElementById('phase-instruction').innerHTML = 
            '<strong>Задание:</strong> В весовой матрице повреждены 4 симметричные ячейки. ' +
            'Изучите схему сети автодорог с длинами в километрах. Перетащите числовые токены с весами дорог ' +
            'в соответствующие пустые слоты матрицы, помня о законе зеркальной симметрии!';

        // 4 вершины: A (0), B (1), C (2), D (3)
        // Создаем взвешенный граф дорог
        const edgesWithWeights = [
            { u: 0, v: 1, w: 2 + Math.floor(Math.random() * 4) }, // A-B: 2..5
            { u: 0, v: 2, w: 4 + Math.floor(Math.random() * 5) }, // A-C: 4..8
            { u: 1, v: 2, w: 1 + Math.floor(Math.random() * 3) }, // B-C: 1..3
            { u: 1, v: 3, w: 3 + Math.floor(Math.random() * 5) }, // B-D: 3..7
            { u: 2, v: 3, w: 2 + Math.floor(Math.random() * 4) }  // C-D: 2..5
        ];

        // Полная целевая матрица весов (null если нет дороги)
        const fullWeightMatrix = [
            [null, null, null, null],
            [null, null, null, null],
            [null, null, null, null],
            [null, null, null, null]
        ];

        edgesWithWeights.forEach(e => {
            fullWeightMatrix[e.u][e.v] = e.w;
            fullWeightMatrix[e.v][e.u] = e.w;
        });

        // Выбираем 2 ребра для маскирования под слоты: например A-B и C-D
        // Это даст ровно 4 слота: (0,1), (1,0) и (2,3), (3,2)
        const slotEdges = [edgesWithWeights[0], edgesWithWeights[4]];
        const slotKeys = new Set();
        slotEdges.forEach(e => {
            slotKeys.add(`${e.u}-${e.v}`);
            slotKeys.add(`${e.v}-${e.u}`);
        });

        // Токены в палитре: нужные веса + 3 дистрактора
        const requiredWeights = [slotEdges[0].w, slotEdges[0].w, slotEdges[1].w, slotEdges[1].w];
        const distractorWeights = [];
        while (distractorWeights.length < 3) {
            const d = 1 + Math.floor(Math.random() * 9);
            if (!requiredWeights.includes(d) && !distractorWeights.includes(d)) {
                distractorWeights.push(d);
            }
        }
        const allTokens = shuffle([...requiredWeights, ...distractorWeights]).map((w, idx) => ({
            id: 'tok-' + idx,
            val: w
        }));

        phase3Data = {
            edges: edgesWithWeights,
            fullMatrix: fullWeightMatrix,
            slotKeys: slotKeys,
            slotsState: {}, // key: 'r-c' -> tokenVal
            tokens: allTokens
        };

        renderPhase3Graph(edgesWithWeights);
        renderPhase3Matrix();
        renderPhase3Tokens();
    }

    function renderPhase3Graph(edges) {
        const svg = document.getElementById('weighted-graph-svg');
        svg.innerHTML = '';

        const coords = [
            { x: 50,  y: 45,  label: 'A' },
            { x: 270, y: 45,  label: 'B' },
            { x: 50,  y: 175, label: 'C' },
            { x: 270, y: 175, label: 'D' }
        ];

        // Отрисовка ребер с бейджами весов
        edges.forEach(e => {
            const uPt = coords[e.u];
            const vPt = coords[e.v];

            const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            line.setAttribute('x1', uPt.x);
            line.setAttribute('y1', uPt.y);
            line.setAttribute('x2', vPt.x);
            line.setAttribute('y2', vPt.y);
            line.setAttribute('stroke', '#ffc107');
            line.setAttribute('stroke-width', '2.5');
            svg.appendChild(line);

            // Бейдж веса в центре ребра
            const midX = (uPt.x + vPt.x) / 2;
            const midY = (uPt.y + vPt.y) / 2;

            // Смещение для диагонального ребра B-C
            const offsetX = (e.u === 1 && e.v === 2) ? 14 : 0;
            const offsetY = (e.u === 1 && e.v === 2) ? -10 : 0;

            const bgRect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
            bgRect.setAttribute('x', midX - 12 + offsetX);
            bgRect.setAttribute('y', midY - 10 + offsetY);
            bgRect.setAttribute('width', '24');
            bgRect.setAttribute('height', '20');
            bgRect.setAttribute('fill', '#000000');
            bgRect.setAttribute('stroke', '#ffc107');
            bgRect.setAttribute('stroke-width', '1.5');
            svg.appendChild(bgRect);

            const weightText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            weightText.setAttribute('x', midX + offsetX);
            weightText.setAttribute('y', midY + 4 + offsetY);
            weightText.setAttribute('text-anchor', 'middle');
            weightText.setAttribute('fill', '#ffc107');
            weightText.setAttribute('font-family', 'monospace');
            weightText.setAttribute('font-weight', 'bold');
            weightText.setAttribute('font-size', '13');
            weightText.textContent = e.w;
            svg.appendChild(weightText);
        });

        // Вершины
        coords.forEach(pt => {
            const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            circle.setAttribute('cx', pt.x);
            circle.setAttribute('cy', pt.y);
            circle.setAttribute('r', '18');
            circle.setAttribute('fill', '#000000');
            circle.setAttribute('stroke', '#198754');
            circle.setAttribute('stroke-width', '2.5');
            svg.appendChild(circle);

            const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            text.setAttribute('x', pt.x);
            text.setAttribute('y', pt.y + 5);
            text.setAttribute('text-anchor', 'middle');
            text.setAttribute('fill', '#ffffff');
            text.setAttribute('font-family', 'monospace');
            text.setAttribute('font-weight', 'bold');
            text.setAttribute('font-size', '15');
            text.textContent = pt.label;
            svg.appendChild(text);
        });
    }

    function renderPhase3Matrix() {
        const tbody = document.getElementById('weight-matrix-tbody');
        tbody.innerHTML = '';
        const labels = ['A', 'B', 'C', 'D'];

        for (let r = 0; r < 4; r++) {
            const tr = document.createElement('tr');
            
            const th = document.createElement('th');
            th.className = 'bg-dark text-warning p-2';
            th.textContent = labels[r];
            tr.appendChild(th);

            for (let c = 0; c < 4; c++) {
                const td = document.createElement('td');
                td.className = 'p-1';

                const key = `${r}-${c}`;
                const val = phase3Data.fullMatrix[r][c];

                if (r === c) {
                    // Главная диагональ пустая
                    td.className += ' bg-dark text-secondary';
                    td.innerHTML = '<span class="text-secondary small">—</span>';
                } else if (phase3Data.slotKeys.has(key)) {
                    // Слот для подстановки токена
                    const slotDiv = document.createElement('div');
                    slotDiv.id = 'slot-' + key;
                    slotDiv.className = 'matrix-slot border-2 border-dashed border-warning bg-black text-warning fw-bold d-flex justify-content-center align-items-center rounded-0';
                    slotDiv.style.minWidth = '48px';
                    slotDiv.style.minHeight = '48px';
                    slotDiv.style.cursor = 'pointer';
                    slotDiv.dataset.slotKey = key;

                    const curVal = phase3Data.slotsState[key];
                    if (curVal !== undefined && curVal !== null) {
                        slotDiv.textContent = curVal;
                        slotDiv.classList.remove('border-dashed');
                        slotDiv.classList.add('bg-warning', 'text-dark', 'border-solid');
                    } else {
                        slotDiv.innerHTML = '<span class="text-warning small" style="font-size: 0.7rem;">СЛОТ</span>';
                    }

                    // D&D
                    slotDiv.addEventListener('dragover', (e) => e.preventDefault());
                    slotDiv.addEventListener('drop', (e) => {
                        e.preventDefault();
                        const tokenVal = parseInt(e.dataTransfer.getData('text/plain'), 10);
                        const tokenId = e.dataTransfer.getData('token-id');
                        placeTokenInSlot(key, tokenVal, tokenId);
                    });

                    // Клик
                    slotDiv.addEventListener('click', () => {
                        if (selectedElement && selectedElement.dataset.tokenVal) {
                            const val = parseInt(selectedElement.dataset.tokenVal, 10);
                            const id = selectedElement.dataset.tokenId;
                            placeTokenInSlot(key, val, id);
                            selectedElement.classList.remove('border-white');
                            selectedElement = null;
                        } else if (phase3Data.slotsState[key] !== undefined) {
                            // Очистить слот кликом по нему
                            removeTokenFromSlot(key);
                        }
                    });

                    td.appendChild(slotDiv);
                } else if (val !== null) {
                    // Заранее известное числовое значение
                    td.className += ' bg-black text-light fw-bold';
                    td.textContent = val;
                } else {
                    // Дороги нет (пусто)
                    td.className += ' bg-black text-muted';
                    td.innerHTML = '<span class="text-secondary small">·</span>';
                }

                tr.appendChild(td);
            }
            tbody.appendChild(tr);
        }
    }

    function renderPhase3Tokens() {
        const palette = document.getElementById('weight-tokens-palette');
        palette.innerHTML = '';

        phase3Data.tokens.forEach(tok => {
            const btn = document.createElement('div');
            btn.id = tok.id;
            btn.className = 'token-chip btn btn-warning text-dark fw-bold rounded-0 d-flex justify-content-center align-items-center';
            btn.style.minWidth = '48px';
            btn.style.minHeight = '48px';
            btn.style.fontSize = '1.1rem';
            btn.style.cursor = 'grab';
            btn.draggable = true;
            btn.textContent = tok.val;
            btn.dataset.tokenVal = tok.val;
            btn.dataset.tokenId = tok.id;

            btn.addEventListener('dragstart', (e) => {
                e.dataTransfer.setData('text/plain', tok.val);
                e.dataTransfer.setData('token-id', tok.id);
            });

            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (selectedElement === btn) {
                    btn.classList.remove('border-white', 'border-2');
                    selectedElement = null;
                } else {
                    if (selectedElement) {
                        selectedElement.classList.remove('border-white', 'border-2');
                    }
                    selectedElement = btn;
                    btn.classList.add('border-white', 'border-2');
                }
            });

            palette.appendChild(btn);
        });

        // Кнопка сброса всех слотов
        const resetBtn = document.getElementById('reset-slots-btn');
        if (resetBtn) {
            resetBtn.onclick = () => {
                phase3Data.slotsState = {};
                renderPhase3Matrix();
            };
        }
    }

    function placeTokenInSlot(slotKey, tokenVal, tokenId) {
        phase3Data.slotsState[slotKey] = tokenVal;
        renderPhase3Matrix();
    }

    function removeTokenFromSlot(slotKey) {
        delete phase3Data.slotsState[slotKey];
        renderPhase3Matrix();
    }

    function verifyPhase3() {
        const expectedSlotCount = phase3Data.slotKeys.size;
        const filledKeys = Object.keys(phase3Data.slotsState);

        if (filledKeys.length < expectedSlotCount) {
            triggerFailure('Заполнены не все поврежденные слоты весовой матрицы.');
            return;
        }

        let hasError = false;
        let isAsymmetric = false;

        for (const key of phase3Data.slotKeys) {
            const [r, c] = key.split('-').map(Number);
            const userVal = phase3Data.slotsState[key];
            const targetVal = phase3Data.fullMatrix[r][c];

            if (userVal !== targetVal) {
                hasError = true;
            }

            // Проверка симметрии слота с зеркальным
            const mirrorKey = `${c}-${r}`;
            if (phase3Data.slotsState[mirrorKey] !== userVal) {
                isAsymmetric = true;
            }
        }

        if (isAsymmetric) {
            triggerFailure('Нарушена симметрия весовой матрицы! Расстояние от A до B обязано равняться расстоянию от B до A.');
            return;
        }

        if (hasError) {
            triggerFailure('Один или несколько весов дорог расставлены неверно относительно схемы графа.');
            return;
        }

        // Финал уровня!
        finishLevel();
    }

    // ==========================================
    // ФИНАЛ УРОВНЯ
    // ==========================================
    function finishLevel() {
        document.getElementById('phase-1-workspace').classList.add('d-none');
        document.getElementById('phase-2-workspace').classList.add('d-none');
        document.getElementById('phase-3-workspace').classList.add('d-none');
        document.getElementById('verify-btn').classList.add('d-none');
        document.getElementById('phase-instruction').classList.add('d-none');

        document.getElementById('phase-badge').textContent = 'Успешно';
        document.getElementById('phase-badge').className = 'badge bg-success text-dark rounded-0 fs-6 me-2';
        document.getElementById('phase-title').textContent = 'Курс манипуляции табличными структурами завершен';

        document.getElementById('victory-screen').classList.remove('d-none');

        sendTelemetry('level_complete', true);

        const continueBtn = document.getElementById('continue-btn');
        if (continueBtn) {
            continueBtn.addEventListener('click', () => {
                window.location.href = '/tasks/9-класс/8/level2';
            });
        }
    }

    // ==========================================
    // ДИСПЕТЧЕР ФАЗ
    // ==========================================
    function initPhase(phase) {
        document.getElementById('phase-1-workspace').classList.add('d-none');
        document.getElementById('phase-2-workspace').classList.add('d-none');
        document.getElementById('phase-3-workspace').classList.add('d-none');

        selectedElement = null;

        if (phase === 1) {
            document.getElementById('phase-1-workspace').classList.remove('d-none');
            setupPhase1();
        } else if (phase === 2) {
            document.getElementById('phase-2-workspace').classList.remove('d-none');
            setupPhase2();
        } else if (phase === 3) {
            document.getElementById('phase-3-workspace').classList.remove('d-none');
            setupPhase3();
        }
    }

    // Главная кнопка проверки
    document.getElementById('verify-btn').addEventListener('click', () => {
        if (currentPhase === 1) {
            verifyPhase1();
        } else if (currentPhase === 2) {
            verifyPhase2();
        } else if (currentPhase === 3) {
            verifyPhase3();
        }
    });

    // Инициализация при загрузке страницы
    document.addEventListener('DOMContentLoaded', () => {
        sendTelemetry('in_progress');
        initPhase(1);
    });

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        sendTelemetry('in_progress');
        initPhase(1);
    }
})();
</script>
