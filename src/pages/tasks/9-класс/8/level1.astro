            line.setAttribute('x1', coords[u].x);
            line.setAttribute('y1', coords[u].y);
            line.setAttribute('x2', coords[v].x);
            line.setAttribute('y2', coords[v].y);
            line.setAttribute('stroke', '#0dcaf0');
            line.setAttribute('stroke-width', '3');
