---
import Layout from '../../../../layouts/Layout.astro';
import WriterEmulator from '../../../../components/WriterEmulator.astro';

const missionName = "9 класс :: Урок 5 :: Уровень 1";
---

<Layout title="Практика: Онлайн-офис">
    <div class="container-fluid h-100 d-flex flex-column p-0 bg-black overflow-auto">
        <!-- Инструкция -->
        <div class="bg-dark text-white p-3 border-bottom border-success flex-shrink-0">
            <h4 class="text-success fw-bold">Миссия: Навыки форматирования документов</h4>
            <div id="instruction-panel" class="fs-5 mt-3">
                Загрузка задания...
            </div>
            <div class="mt-3">
                <span class="badge bg-secondary fs-6">Фаза <span id="phase-counter">1</span> / 3</span>
            </div>
        </div>

        <!-- Рабочая область -->
        <div class="flex-grow-1 position-relative p-3" style="min-height: 500px;">
            <WriterEmulator 
                missionName={missionName} 
                initialHTML="" 
                checkOgeFormat={false}
                hardcoreReset={false}
            />
        </div>
    </div>
</Layout>

<script>
    // Процедурная генерация фраз для заданий (ГЛАВНЫЙ ПРИНЦИП из ТЗ)
    const subjects = ['Процессор', 'Монитор', 'Сервер', 'Маршрутизатор', 'Алгоритм', 'Облако', 'Шифратор'];
    const actions = ['обрабатывает', 'передает', 'сохраняет', 'вычисляет', 'защищает', 'кодирует'];
    const objects = ['информацию', 'пакеты', 'файлы', 'сигналы', 'команды', 'запросы'];

    let currentPhase = 1;
    let targetWord = '';
    let targetFormat = null;
    let currentSentence = '';

    const instructionEl = document.getElementById('instruction-panel');
    const phaseEl = document.getElementById('phase-counter');

    function getRandom(arr) {
        return arr[Math.floor(Math.random() * arr.length)];
    }

    function generatePhase() {
        const subject = getRandom(subjects);
        const action = getRandom(actions);
        const object = getRandom(objects);
        currentSentence = `${subject} ${action} ${object}.`;

        const words = [subject, action, object];
        targetWord = getRandom(words);
        
        const formats = [
            { id: 'bold', label: 'ЖИРНЫМ', tag: 'strong', tag2: 'b' },
            { id: 'italic', label: 'КУРСИВОМ', tag: 'em', tag2: 'i' },
            { id: 'underline', label: 'ПОДЧЕРКНУТЫМ', tag: 'u', tag2: 'u' }
        ];
        
        targetFormat = getRandom(formats);

        instructionEl.innerHTML = `
            Наберите следующее предложение в редакторе (без кавычек):<br>
            <span class="text-info font-monospace d-inline-block mt-2 mb-2 p-2 border border-info">"${currentSentence}"</span><br>
            Затем сделайте слово <span class="text-warning fw-bold">«${targetWord}»</span> <span class="text-danger fw-bold">${targetFormat.label}</span> шрифтом и нажмите кнопку отправки.
        `;
        phaseEl.innerText = currentPhase;
    }

    // Ждем загрузки DOM перед генерацией
    document.addEventListener('DOMContentLoaded', () => {
        generatePhase();
    });

    document.addEventListener('writer-check', (e) => {
        // @ts-ignore
        const wysiwyg = e.detail.wysiwyg || document.querySelector('.jodit-wysiwyg');
        // @ts-ignore
        const rawText = e.detail.text || (wysiwyg ? (wysiwyg.innerText || wysiwyg.textContent || '') : '');
        // @ts-ignore
        const V = window.WriterValidator;

        // 1. Проверка полного текста предложения через модуль валидации
        const hasFullSentence = V ? V.hasText(rawText, currentSentence) : rawText.includes(currentSentence);

        if (!hasFullSentence) {
            // @ts-ignore
            e.detail.resolve(false, 'Предложение набрано не полностью или содержит опечатки!');
            // При ошибке генерируем новую задачу (правило 1-2 уровней)
            setTimeout(generatePhase, 1500);
            return;
        }

        // 2. Проверка форматирования целевого слова через DOM-методы WriterValidator
        let success = false;
        if (V) {
            if (targetFormat.id === 'bold') {
                success = V.hasBoldWord(wysiwyg, targetWord);
            } else if (targetFormat.id === 'italic') {
                success = V.hasItalicWord(wysiwyg, targetWord);
            } else if (targetFormat.id === 'underline') {
                success = V.hasUnderlineWord(wysiwyg, targetWord);
            }
        }

        if (success) {
            if (currentPhase < 3) {
                // @ts-ignore
                e.detail.resolve(true, `Фаза ${currentPhase} пройдена!`);
                currentPhase++;
                if (phaseEl) phaseEl.innerText = currentPhase;
                setTimeout(generatePhase, 1500);
            } else {
                // @ts-ignore
                e.detail.resolve(true, 'МИССИЯ ВЫПОЛНЕНА УСПЕШНО!');
                instructionEl.innerHTML = '<span class="text-success fw-bold fs-4">ЗАДАНИЕ УСПЕШНО ВЫПОЛНЕНО!</span><br>Вы научились базовому форматированию документов.';
                const checkBtn = document.getElementById('check-btn');
                if (checkBtn) checkBtn.style.display = 'none'; // Прячем кнопку
            }
        } else {
            // @ts-ignore
            e.detail.resolve(false, `Слово "${targetWord}" не отформатировано правильно (${targetFormat.label})!`);
            setTimeout(generatePhase, 1500);
        }
    });
</script>
