---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
import WriterEmulator from '../../../../components/WriterEmulator.astro';
---

<TaskLayout title="7 Класс - Урок 22 - Уровень 3: Скоростная вёрстка в LibreOffice Writer" level={3} bodyClass="d-flex flex-column min-vh-100">
    <script is:inline src="/static/vue.global.js" slot="head"></script>

    <!-- Верхняя аркадная панель управления волнами (Vue 3) -->
    <div id="app"></div>

    <!-- Основной модуль текстового процессора LibreOffice Writer -->
    <div class="flex-grow-1 d-flex flex-column">
        <WriterEmulator
            missionName="Урок 22 :: Скоростная печать и форматирование (10 волн)"
            checkOgeFormat={false}
            hardcoreReset={false}
        />
    </div>

    <script is:inline>
        const { createApp, ref, computed, onMounted, onUnmounted } = Vue;

        function pickRandom(arr) {
            if (typeof window.__FORCE_VARIANT_INDEX === 'number') {
                return arr[window.__FORCE_VARIANT_INDEX % arr.length];
            }
            return arr[Math.floor(Math.random() * arr.length)];
        }

        function normalizeSpaces(str) {
            if (window.WriterValidator && window.WriterValidator.normalizeSpaces) {
                return window.WriterValidator.normalizeSpaces(str);
            }
            return (str || '')
                .replace(/[\uFEFF\u200B\u200C\u200D]/g, '')
                .replace(/\u00A0/g, ' ')
                .replace(/\s+/g, ' ')
                .trim();
        }

        function normalizeIndexDigits(str) {
            if (window.WriterValidator && window.WriterValidator.normalizeIndexDigits) {
                return window.WriterValidator.normalizeIndexDigits(str);
            }
            return (str || '')
                .replace(/⁰/g, '0')
                .replace(/¹/g, '1')
                .replace(/²/g, '2')
                .replace(/³/g, '3')
                .replace(/₀/g, '0')
                .replace(/₁/g, '1')
                .replace(/₂/g, '2')
                .replace(/₃/g, '3');
        }

        // Нормализация текста для сравнения (учёт ё/е, кириллических/латинских букв-двойников C/С, x/х, A/А, H/Н, O/О и пробела перед °)
        function normalizeComparable(str, options) {
            if (window.WriterValidator && window.WriterValidator.normalizeComparable) {
                return window.WriterValidator.normalizeComparable(str, options);
            }
            const homoglyphMap = {
                'A': 'А', 'B': 'В', 'C': 'С', 'E': 'Е', 'H': 'Н', 'K': 'К', 'M': 'М', 'O': 'О', 'P': 'Р', 'T': 'Т', 'X': 'Х',
                'a': 'а', 'c': 'с', 'e': 'е', 'o': 'о', 'p': 'р', 'x': 'х', 'y': 'у'
            };
            return normalizeSpaces(normalizeIndexDigits(str))
                .replace(/ё/g, 'е')
                .replace(/Ё/g, 'Е')
                .replace(/[ABCEHKMOPTXaceopxy]/g, ch => homoglyphMap[ch] || ch)
                .replace(/\s*°\s*/g, '°')
                .replace(/\s+/g, ' ')
                .trim();
        }

        // Генератор 10 процедурных волн по возрастанию сложности
        function generateAllWaves() {
            // Волна 1: Скоростной набор + полужирное начертание ключевого слова
            const w1Variant = pickRandom([
                {
                    text: 'Форматирование изменяет внешний вид текста без изменения его содержания.',
                    boldWord: 'Форматирование'
                },
                {
                    text: 'Редактирование документа предполагает исправление ошибок и замену символов.',
                    boldWord: 'Редактирование'
                },
                {
                    text: 'Гарнитура определяет единый графический стиль всех глифов шрифта.',
                    boldWord: 'Гарнитура'
                }
            ]);

            // Волна 2: Комбинированное начертание (Курсив + Подчёркнутый)
            const w2Variant = pickRandom([
                {
                    text: 'Кегль шрифта измеряется в типографских пунктах на странице документа.',
                    italicWord: 'Кегль',
                    underlineWord: 'пунктах'
                },
                {
                    text: 'Абзац создаётся нажатием клавиши ввода и хранит собственные отступы.',
                    italicWord: 'Абзац',
                    underlineWord: 'отступы'
                },
                {
                    text: 'Буфер обмена временно сохраняет скопированный фрагмент в оперативной памяти.',
                    italicWord: 'Буфер',
                    underlineWord: 'памяти'
                }
            ]);

            // Волна 3: Верхний и нижний индексы (степени и формулы)
            const w3Variant = pickRandom([
                {
                    displayPrompt: 'Площадь поверхности составляет 25 м², а формула воды — H₂O.',
                    htmlPrompt: 'Площадь поверхности составляет 25 м<sup>2</sup>, а формула воды — H<sub>2</sub>O.',
                    plainCheck: 'Площадь поверхности составляет 25 м2, а формула воды',
                    supText: '2',
                    subText: '2'
                },
                {
                    displayPrompt: 'Объём куба равен x³, а основание двоичной системы — 101₂.',
                    htmlPrompt: 'Объём куба равен x<sup>3</sup>, а основание двоичной системы — 101<sub>2</sub>.',
                    plainCheck: 'Объём куба равен x3, а основание двоичной системы',
                    supText: '3',
                    subText: '2'
                },
                {
                    displayPrompt: 'Ускорение равно 10 м/с², а индекс элемента массива — A₁.',
                    htmlPrompt: 'Ускорение равно 10 м/с<sup>2</sup>, а индекс элемента массива — A<sub>1</sub>.',
                    plainCheck: 'Ускорение равно 10 м/с2, а индекс элемента массива',
                    supText: '2',
                    subText: '1'
                }
            ]);

            // Волна 4: Заголовок (Гарнитура без засечек + Кегль 16 пт + Центрирование)
            const w4Variant = pickRandom([
                {
                    heading: 'Архитектура современных текстовых процессоров',
                    font: 'Arial',
                    sizePt: 16
                },
                {
                    heading: 'Стандарты типографского оформления документов',
                    font: 'Liberation Sans',
                    sizePt: 16
                },
                {
                    heading: 'Структурные элементы электронного документа',
                    font: 'Arial',
                    sizePt: 18
                }
            ]);

            // Волна 5: Основной текст (Шрифт с засечками Liberation Serif + 14 пт + По ширине)
            const w5Variant = pickRandom([
                {
                    text: 'Текстовый процессор обеспечивает автоматический перенос слов на новую строку при достижении правого поля страницы.',
                    font: 'Liberation Serif',
                    sizePt: 14
                },
                {
                    text: 'Выравнивание по ширине равномерно распределяет пробелы между словами от левого до правого края рабочей области.',
                    font: 'Liberation Serif',
                    sizePt: 14
                }
            ]);

            // Волна 6: Геометрия абзаца (Красная строка 1.0 см + Межстрочный интервал 1.15 + По ширине)
            const w6Variant = pickRandom([
                {
                    text: 'Отступ первой строки абзаца настраивается маркером горизонтальной линейки или в диалоговом окне параметров абзаца.',
                    indentCm: 1.0,
                    lineHeight: '1.15'
                },
                {
                    text: 'Использование пробелов для имитации красной строки является грубой ошибкой вёрстки электронного документа.',
                    indentCm: 1.0,
                    lineHeight: '1.15'
                }
            ]);

            // Волна 7: Типографика и спецсимволы ОГЭ (Кавычки «», длинное тире —, символ ° или ±)
            const w7Variant = pickRandom([
                {
                    text: 'Модуль «Термостат» — поддерживает температуру 20 °C с точностью ±1 °C.',
                    quoted: '«Термостат»',
                    sym1: '°',
                    sym2: '±'
                },
                {
                    text: 'Прибор «Калибратор» — работает при температуре 25 °C с допуском ±2 °C.',
                    quoted: '«Калибратор»',
                    sym1: '°',
                    sym2: '±'
                }
            ]);

            // Волна 8: Нумерованный список с полужирными терминами
            const w8Variant = pickRandom([
                {
                    items: [
                        { bold: 'Символ', rest: 'минимальная графическая единица текста.' },
                        { bold: 'Слово', rest: 'последовательность символов между пробелами.' },
                        { bold: 'Абзац', rest: 'фрагмент текста, завершающийся маркером конца абзаца.' }
                    ]
                },
                {
                    items: [
                        { bold: 'Кегль', rest: 'высота шрифта в типографских пунктах.' },
                        { bold: 'Трекинг', rest: 'равномерное изменение межбуквенного расстояния.' },
                        { bold: 'Интерлиньяж', rest: 'межстрочный интервал внутри абзаца.' }
                    ]
                }
            ]);

            // Волна 9: Вставка и форматирование таблицы 2×2
            const w9Variant = pickRandom([
                {
                    h1: 'Формат',
                    h2: 'Назначение',
                    c1: 'ODT',
                    c2: 'Текстовый документ'
                },
                {
                    h1: 'Параметр',
                    h2: 'Значение',
                    c1: 'Кегль',
                    c2: '14 пунктов'
                }
            ]);

            // Волна 10: Финальный босс — Полный регламент ОГЭ 13.2 (Поля 2.0 см + Абзац + Таблица)
            const w10Variant = pickRandom([
                {
                    para: 'Процессор «Эльбрус» — высокопроизводительный микропроцессор для вычислительных комплексов, работающий при температуре до 85 °C.',
                    boldWord: 'Процессор',
                    h1: 'Модель',
                    h2: 'Частота',
                    c1: 'Эльбрус-8С',
                    c2: '1300 МГц'
                },
                {
                    para: 'Накопитель «Кристалл» — твердотельное устройство хранения данных, функционирующее при температуре до 70 °C.',
                    boldWord: 'Накопитель',
                    h1: 'Модель',
                    h2: 'Объём',
                    c1: 'Кристалл-512',
                    c2: '512 ГБ'
                }
            ]);

            return [
                // ВОЛНА 1
                {
                    id: 1,
                    title: 'Волна 1: Скоростной набор и полужирное начертание',
                    timeLimit: 190,
                    ogeFullCheck: false,
                    data: w1Variant,
                    instructionsHtml: `
                        <div class="mb-2"><span class="badge bg-danger">ВОЛНА 1 ИЗ 10</span> <strong>Базовое выделение</strong></div>
                        <p class="small mb-2">Наберите точно по образцу следующее предложение и выделите слово <b>${w1Variant.boldWord}</b> <b>полужирным</b> начертанием (<code>Ctrl+B</code> или кнопка <b>Ж</b>):</p>
                        <div class="p-2 bg-white text-dark border border-dark mb-2" style="font-family: 'Liberation Serif', serif; font-size: 13pt;">
                            <b>${w1Variant.boldWord}</b>${w1Variant.text.slice(w1Variant.boldWord.length)}
                        </div>
                        <ul class="small ps-3 mb-0">
                            <li>Текст должен совпадать с образцом (включая точку в конце).</li>
                            <li>Слово «${w1Variant.boldWord}» должно быть оформлено тегом полужирного шрифта.</li>
                        </ul>
                    `,
                    evaluate(state) {
                        const V = window.WriterValidator;
                        const hasText = V ? V.hasText(state.wysiwyg || state.text, w1Variant.text) : normalizeComparable(state.text).includes(normalizeComparable(w1Variant.text));
                        const hasBold = V ? V.hasBoldWord(state.wysiwyg, w1Variant.boldWord) : false;
                        return [
                            { id: 'w1_text', label: 'Точный текст фразы', passed: hasText },
                            { id: 'w1_bold', label: `Полужирный: «${w1Variant.boldWord}»`, passed: hasBold }
                        ];
                    }
                },

                // ВОЛНА 2
                {
                    id: 2,
                    title: 'Волна 2: Курсив и подчёркивание терминов',
                    timeLimit: 200,
                    ogeFullCheck: false,
                    data: w2Variant,
                    instructionsHtml: `
                        <div class="mb-2"><span class="badge bg-danger">ВОЛНА 2 ИЗ 10</span> <strong>Комбинированное начертание</strong></div>
                        <p class="small mb-2">Наберите предложение. Выделите слово <i>${w2Variant.italicWord}</i> <i>курсивом</i> (<code>Ctrl+I</code>), а слово <u>${w2Variant.underlineWord}</u> — <u>подчёркнутым</u> (<code>Ctrl+U</code>):</p>
                        <div class="p-2 bg-white text-dark border border-dark mb-2" style="font-family: 'Liberation Serif', serif; font-size: 13pt;">
                            ${w2Variant.text.replace(w2Variant.italicWord, `<i>${w2Variant.italicWord}</i>`).replace(w2Variant.underlineWord, `<u>${w2Variant.underlineWord}</u>`)}
                        </div>
                        <ul class="small ps-3 mb-0">
                            <li>Слово «${w2Variant.italicWord}» — курсивное начертание.</li>
                            <li>Слово «${w2Variant.underlineWord}» — подчёркнутое начертание.</li>
                        </ul>
                    `,
                    evaluate(state) {
                        const V = window.WriterValidator;
                        const hasText = V ? V.hasText(state.wysiwyg || state.text, w2Variant.text) : normalizeComparable(state.text).includes(normalizeComparable(w2Variant.text));
                        const hasItalic = V ? V.hasItalicWord(state.wysiwyg, w2Variant.italicWord) : false;
                        const hasUnderline = V ? V.hasUnderlineWord(state.wysiwyg, w2Variant.underlineWord) : false;
                        return [
                            { id: 'w2_text', label: 'Точный текст фразы', passed: hasText },
                            { id: 'w2_italic', label: `Курсив: «${w2Variant.italicWord}»`, passed: hasItalic },
                            { id: 'w2_underline', label: `Подчёркнутый: «${w2Variant.underlineWord}»`, passed: hasUnderline }
                        ];
                    }
                },

                // ВОЛНА 3
                {
                    id: 3,
                    title: 'Волна 3: Верхний и нижний индексы (надстрочный / подстрочный)',
                    timeLimit: 210,
                    ogeFullCheck: false,
                    data: w3Variant,
                    instructionsHtml: `
                        <div class="mb-2"><span class="badge bg-danger">ВОЛНА 3 ИЗ 10</span> <strong>Математические и химические индексы</strong></div>
                        <p class="small mb-2">Наберите выражение, используя кнопки <b>X²</b> (верхний индекс, <code>#btn-sup</code>) и <b>X₂</b> (нижний индекс, <code>#btn-sub</code>) на панели форматирования:</p>
                        <div class="p-2 bg-white text-dark border border-dark mb-2" style="font-family: 'Liberation Serif', serif; font-size: 13pt;">
                            ${w3Variant.htmlPrompt || w3Variant.displayPrompt}
                        </div>
                        <ul class="small ps-3 mb-0">
                            <li>Буквенные обозначения в формулах и переменных (например, <b>H</b>, <b>O</b>, <b>x</b>, <b>A</b>) набираются на <b>латинице (английская раскладка)</b>.</li>
                            <li>Верхний индекс (<code>&lt;sup&gt;</code>) должен содержать цифру <b>${w3Variant.supText}</b>.</li>
                            <li>Нижний индекс (<code>&lt;sub&gt;</code>) должен содержать цифру <b>${w3Variant.subText}</b>.</li>
                        </ul>
                    `,
                    evaluate(state) {
                        const V = window.WriterValidator;
                        const rawText = state.text || '';
                        const expectedPrefix = normalizeComparable(w3Variant.plainCheck.split(',')[0]);
                        const hasBase = V ? V.hasText(state.wysiwyg || rawText, expectedPrefix) : normalizeComparable(rawText).includes(expectedPrefix);
                        const hasSup = V ? V.hasSuperscript(state.wysiwyg, w3Variant.supText) : false;
                        const hasSub = V ? V.hasSubscript(state.wysiwyg, w3Variant.subText) : false;
                        return [
                            { id: 'w3_base', label: 'Основа фразы набрана', passed: hasBase },
                            { id: 'w3_sup', label: `Верхний индекс <sup>${w3Variant.supText}</sup>`, passed: hasSup },
                            { id: 'w3_sub', label: `Нижний индекс <sub>${w3Variant.subText}</sub>`, passed: hasSub }
                        ];
                    }
                },

                // ВОЛНА 4
                {
                    id: 4,
                    title: 'Волна 4: Оформление заголовка (Гарнитура, Кегль, Центрирование)',
                    timeLimit: 210,
                    ogeFullCheck: false,
                    data: w4Variant,
                    instructionsHtml: `
                        <div class="mb-2"><span class="badge bg-danger">ВОЛНА 4 ИЗ 10</span> <strong>Заголовок раздела</strong></div>
                        <p class="small mb-2">Наберите текст заголовка и примените к нему параметры:</p>
                        <div class="p-2 bg-white text-dark border border-dark mb-2 text-center" style="font-family: '${w4Variant.font}', sans-serif; font-size: ${w4Variant.sizePt}pt;">
                            ${w4Variant.heading}
                        </div>
                        <ul class="small ps-3 mb-0">
                            <li>Гарнитура шрифта: <b>${w4Variant.font}</b> (выберите в списке <code>#select-font</code>).</li>
                            <li>Кегль (размер): <b>${w4Variant.sizePt} пт</b> (список <code>#select-fontsize</code>).</li>
                            <li>Выравнивание абзаца: <b>По центру</b> (<code>Ctrl+E</code> или <code>#btn-align-center</code>).</li>
                        </ul>
                    `,
                    evaluate(state) {
                        const textNorm = normalizeComparable(state.text);
                        const hasText = textNorm.includes(normalizeComparable(w4Variant.heading));
                        const wysiwyg = state.wysiwyg;
                        let hasFont = false;
                        let hasSize = false;
                        let hasCenter = false;
                        if (wysiwyg) {
                            const p = wysiwyg.querySelector('p, h1, h2, h3, div') || wysiwyg;
                            const html = wysiwyg.innerHTML;
                            const comp = window.getComputedStyle(p);
                            if (
                                (p.style && p.style.fontFamily && p.style.fontFamily.includes(w4Variant.font)) ||
                                comp.fontFamily.includes(w4Variant.font) ||
                                html.includes(w4Variant.font)
                            ) {
                                hasFont = true;
                            }
                            const pt = Math.round(parseFloat(comp.fontSize) * 0.75);
                            if (
                                (p.style && p.style.fontSize === `${w4Variant.sizePt}pt`) ||
                                pt === w4Variant.sizePt ||
                                html.includes(`${w4Variant.sizePt}pt`)
                            ) {
                                hasSize = true;
                            }
                            if (
                                (p.style && p.style.textAlign === 'center') ||
                                comp.textAlign === 'center' ||
                                html.includes('text-align: center')
                            ) {
                                hasCenter = true;
                            }
                        }
                        return [
                            { id: 'w4_text', label: 'Текст заголовка', passed: hasText },
                            { id: 'w4_font', label: `Шрифт ${w4Variant.font}`, passed: hasFont },
                            { id: 'w4_size', label: `Кегль ${w4Variant.sizePt} пт`, passed: hasSize },
                            { id: 'w4_align', label: 'Выравнивание по центру', passed: hasCenter }
                        ];
                    }
                },

                // ВОЛНА 5
                {
                    id: 5,
                    title: 'Волна 5: Основной абзац (Liberation Serif, 14 пт, По ширине)',
                    timeLimit: 220,
                    ogeFullCheck: false,
                    data: w5Variant,
                    instructionsHtml: `
                        <div class="mb-2"><span class="badge bg-danger">ВОЛНА 5 ИЗ 10</span> <strong>Стандарт основного текста</strong></div>
                        <p class="small mb-2">Наберите абзац и оформите его по базовому стандарту текстового документа:</p>
                        <div class="p-2 bg-white text-dark border border-dark mb-2" style="font-family: 'Liberation Serif', serif; font-size: 14pt; text-align: justify;">
                            ${w5Variant.text}
                        </div>
                        <ul class="small ps-3 mb-0">
                            <li>Гарнитура: <b>Liberation Serif</b> (или <b>Times New Roman</b>).</li>
                            <li>Кегль: <b>14 пт</b>.</li>
                            <li>Выравнивание: <b>По ширине</b> (<code>Ctrl+J</code> или <code>#btn-align-justify</code>).</li>
                        </ul>
                    `,
                    evaluate(state) {
                        const textNorm = normalizeComparable(state.text);
                        const hasText = textNorm.includes(normalizeComparable(w5Variant.text));
                        const wysiwyg = state.wysiwyg;
                        let hasFont = false;
                        let hasSize = false;
                        let hasJustify = false;
                        if (wysiwyg) {
                            const p = wysiwyg.querySelector('p, div') || wysiwyg;
                            const html = wysiwyg.innerHTML;
                            const comp = window.getComputedStyle(p);
                            if (
                                (p.style && /Liberation Serif|Times New Roman/i.test(p.style.fontFamily)) ||
                                /Liberation Serif|Times New Roman/i.test(comp.fontFamily) ||
                                /Liberation Serif|Times New Roman/i.test(html)
                            ) {
                                hasFont = true;
                            }
                            const pt = Math.round(parseFloat(comp.fontSize) * 0.75);
                            if ((p.style && p.style.fontSize === '14pt') || pt === 14 || html.includes('14pt')) {
                                hasSize = true;
                            }
                            if ((p.style && p.style.textAlign === 'justify') || comp.textAlign === 'justify' || html.includes('text-align: justify')) {
                                hasJustify = true;
                            }
                        }
                        return [
                            { id: 'w5_text', label: 'Текст абзаца', passed: hasText },
                            { id: 'w5_font', label: 'Шрифт Liberation Serif', passed: hasFont },
                            { id: 'w5_size', label: 'Кегль 14 пт', passed: hasSize },
                            { id: 'w5_justify', label: 'Выравнивание по ширине', passed: hasJustify }
                        ];
                    }
                },

                // ВОЛНА 6
                {
                    id: 6,
