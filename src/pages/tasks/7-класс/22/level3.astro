                    timeLimit: 230,
                    ogeFullCheck: false,
                    data: w6Variant,
                    instructionsHtml: `
                        <div class="mb-2"><span class="badge bg-danger">ВОЛНА 6 ИЗ 10</span> <strong>Отступ первой строки и интервал</strong></div>
                        <p class="small mb-2">Наберите абзац и настройте его геометрию через диалог <b>Формат → Абзац...</b> (или линейку и панель):</p>
                        <div class="p-2 bg-white text-dark border border-dark mb-2" style="font-family: 'Liberation Serif', serif; font-size: 14pt; text-indent: 1cm; line-height: 1.15; text-align: justify;">
                            ${w6Variant.text}
                        </div>
                        <ul class="small ps-3 mb-0">
                            <li>Отступ первой строки (красная строка): <b>1.0 см</b> (клик по маркеру <code>#ruler-first-line</code> или диалог «Абзац...»).</li>
                            <li>Межстрочный интервал: <b>1.15</b> (или <b>1.5</b>).</li>
                            <li>Выравнивание: <b>По ширине</b>.</li>
                        </ul>
                    `,
                    evaluate(state) {
                        const textNorm = normalizeComparable(state.text);
                        const hasText = textNorm.includes(normalizeComparable(w6Variant.text));
                        const wysiwyg = state.wysiwyg;
                        let hasIndent = false;
                        let hasLh = false;
                        let hasJustify = false;
                        if (wysiwyg) {
                            const p = wysiwyg.querySelector('p, div') || wysiwyg;
                            const comp = window.getComputedStyle(p);
                            const indentPx = parseFloat(comp.textIndent) || 0;
                            if (
                                (p.style && /^1(\.0)?cm$/.test(p.style.textIndent)) ||
                                (indentPx >= 32 && indentPx <= 48)
                            ) {
                                hasIndent = true;
                            }
                            if (
                                (p.style && (p.style.lineHeight === '1.15' || p.style.lineHeight === '1.5')) ||
                                wysiwyg.innerHTML.includes('line-height: 1.15') ||
                                wysiwyg.innerHTML.includes('line-height: 1.5')
                            ) {
                                hasLh = true;
                            }
                            if ((p.style && p.style.textAlign === 'justify') || comp.textAlign === 'justify') {
                                hasJustify = true;
                            }
                        }
                        return [
                            { id: 'w6_text', label: 'Текст абзаца', passed: hasText },
                            { id: 'w6_indent', label: 'Красная строка 1.0 см', passed: hasIndent },
                            { id: 'w6_lh', label: 'Интервал 1.15 / 1.5', passed: hasLh },
                            { id: 'w6_justify', label: 'Выравнивание по ширине', passed: hasJustify }
                        ];
                    }
                },

                // ВОЛНА 7
                {
                    id: 7,
                    title: 'Волна 7: Типографика и спецсимволы ОГЭ (Ω)',
                    timeLimit: 230,
                    ogeFullCheck: false,
                    data: w7Variant,
                    instructionsHtml: `
                        <div class="mb-2"><span class="badge bg-danger">ВОЛНА 7 ИЗ 10</span> <strong>Специальные символы без костылей</strong></div>
                        <p class="small mb-2">Наберите предложение, вставляя кавычки-ёлочки (<b>« »</b>), длинное тире (<b>—</b>), знак градуса (<b>°</b>) и плюс-минус (<b>±</b>) через кнопку <b>Ω</b> (<code>#btn-symbol</code>):</p>
                        <div class="p-2 bg-white text-dark border border-dark mb-2" style="font-family: 'Liberation Serif', serif; font-size: 14pt;">
                            ${w7Variant.text}
                        </div>
                        <ul class="small ps-3 mb-0">
                            <li>Обязательно наличие кавычек-ёлочек <b>${w7Variant.quoted}</b> и тире <b>—</b>.</li>
                            <li>Обязательно наличие спецсимволов <b>${w7Variant.sym1}</b> и <b>${w7Variant.sym2}</b>.</li>
                            <li>Запрещены прямые кавычки <code>"</code> и дефис между пробелами <code> - </code>.</li>
                        </ul>
                    `,
                    evaluate(state) {
                        const V = window.WriterValidator;
                        const typo = V ? V.checkTypography(state.wysiwyg || state.text, {
                            quotes: w7Variant.quoted,
                            dash: true,
                            symbols: [w7Variant.sym1, w7Variant.sym2]
                        }) : {
                            quotesOk: normalizeComparable(state.text).includes(normalizeComparable(w7Variant.quoted)),
                            dashOk: normalizeComparable(state.text).includes('—') || normalizeComparable(state.text).includes('–'),
                            symbolsOk: normalizeComparable(state.text).includes(w7Variant.sym1) && normalizeComparable(state.text).includes(w7Variant.sym2)
                        };
                        const hasFullText = V ? V.hasText(state.wysiwyg || state.text, w7Variant.text) : normalizeComparable(state.text).includes(normalizeComparable(w7Variant.text));
                        return [
                            { id: 'w7_quotes', label: `Кавычки ${w7Variant.quoted}`, passed: typo.quotesOk },
                            { id: 'w7_dash', label: 'Типографское тире (—)', passed: typo.dashOk },
                            { id: 'w7_syms', label: 'Спецсимволы ° и ±', passed: typo.symbolsOk },
                            { id: 'w7_full', label: 'Полное совпадение фразы', passed: hasFullText }
                        ];
                    }
                },

                // ВОЛНА 8
                {
                    id: 8,
                    title: 'Волна 8: Многоуровневая структура — Нумерованный список',
                    timeLimit: 250,
                    ogeFullCheck: false,
                    data: w8Variant,
                    instructionsHtml: `
                        <div class="mb-2"><span class="badge bg-danger">ВОЛНА 8 ИЗ 10</span> <strong>Нумерованный список терминов</strong></div>
                        <p class="small mb-2">Создайте <b>нумерованный список</b> (кнопка <code>#btn-ol</code>) ровно из 3 пунктов. Ключевой термин каждого пункта выделите <b>полужирным</b>:</p>
                        <div class="p-2 bg-white text-dark border border-dark mb-2" style="font-family: 'Liberation Serif', serif; font-size: 13pt;">
                            <ol class="mb-0 ps-3">
                                <li><b>${w8Variant.items[0].bold}</b> — ${w8Variant.items[0].rest}</li>
                                <li><b>${w8Variant.items[1].bold}</b> — ${w8Variant.items[1].rest}</li>
                                <li><b>${w8Variant.items[2].bold}</b> — ${w8Variant.items[2].rest}</li>
                            </ol>
                        </div>
                        <ul class="small ps-3 mb-0">
                            <li>Используйте настоящий контейнер списка <code>&lt;ol&gt;</code> и элементы <code>&lt;li&gt;</code> (не ручной ввод цифр!).</li>
                            <li>Все 3 термина (<b>${w8Variant.items.map(i => i.bold).join(', ')}</b>) должны быть выделены полужирным.</li>
                        </ul>
                    `,
                    evaluate(state) {
                        const V = window.WriterValidator;
                        const listRes = V ? V.checkListStructure(state.wysiwyg, {
                            type: 'ol',
                            minItems: 3,
                            boldTerms: w8Variant.items.map(i => i.bold),
                            texts: w8Variant.items.map(i => i.rest.replace(/\.$/, ''))
                        }) : { listOk: false, countOk: false, boldOk: false, textsOk: false };
                        return [
                            { id: 'w8_ol', label: 'Контейнер списка <ol>', passed: listRes.listOk },
                            { id: 'w8_count', label: 'Три пункта <li>', passed: listRes.countOk },
                            { id: 'w8_bold', label: 'Термины полужирным', passed: listRes.boldOk },
                            { id: 'w8_text', label: 'Текст всех пунктов', passed: listRes.textsOk }
                        ];
                    }
                },

                // ВОЛНА 9
                {
                    id: 9,
                    title: 'Волна 9: Табличная вёрстка (Таблица 2×2 и Свойства таблицы)',
                    timeLimit: 260,
                    ogeFullCheck: false,
                    data: w9Variant,
                    instructionsHtml: `
                        <div class="mb-2"><span class="badge bg-danger">ВОЛНА 9 ИЗ 10</span> <strong>Вставка и выравнивание таблицы</strong></div>
                        <p class="small mb-2">Вставьте таблицу <b>2 столбца × 2 строки</b> (кнопка <code>#btn-table</code>), заполните ячейки и настройте <b>Таблица → Свойства таблицы...</b>:</p>
                        <div class="p-2 bg-white text-dark border border-dark mb-2">
                            <table class="table table-bordered table-sm mb-0 mx-auto" style="width: 85%; font-family: 'Liberation Serif', serif; font-size: 13pt; border-color: #000;">
                                <thead>
                                    <tr>
                                        <th class="text-center fw-bold">${w9Variant.h1}</th>
                                        <th class="text-center fw-bold">${w9Variant.h2}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>${w9Variant.c1}</td>
                                        <td>${w9Variant.c2}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <ul class="small ps-3 mb-0">
                            <li>Таблица выровнена <b>по центру страницы</b> (<code>margin: auto</code> через «Свойства таблицы...»).</li>
                            <li>Заголовки столбцов (<b>${w9Variant.h1}</b>, <b>${w9Variant.h2}</b>) — по центру и полужирным.</li>
                            <li>Ячейки второй строки содержат <b>${w9Variant.c1}</b> и <b>${w9Variant.c2}</b>.</li>
                        </ul>
                    `,
                    evaluate(state) {
                        const V = window.WriterValidator;
                        const tblRes = V ? V.checkTableStructure(state.wysiwyg, {
                            centered: true,
                            headers: [w9Variant.h1, w9Variant.h2],
                            cells: [w9Variant.c1, w9Variant.c2],
                            alignHeadersCenter: true
                        }) : { tableOk: false, centerOk: false, headersOk: false, cellsOk: false };
                        return [
                            { id: 'w9_table', label: 'Таблица вставлена', passed: tblRes.tableOk },
                            { id: 'w9_center', label: 'Таблица по центру листа', passed: tblRes.centerOk },
                            { id: 'w9_headers', label: `Шапка: ${w9Variant.h1} | ${w9Variant.h2}`, passed: tblRes.headersOk },
                            { id: 'w9_cells', label: `Данные: ${w9Variant.c1} | ${w9Variant.c2}`, passed: tblRes.cellsOk }
                        ];
                    }
                },

                // ВОЛНА 10 (ФИНАЛЬНЫЙ БОСС)
                {
                    id: 10,
                    title: 'Волна 10 (ФИНАЛ): Комплексный экзамен по регламенту ОГЭ 13.2',
                    timeLimit: 340,
                    ogeFullCheck: true,
                    data: w10Variant,
                    instructionsHtml: `
                        <div class="mb-2"><span class="badge bg-warning text-dark">ВОЛНА 10 ИЗ 10 — ФИНАЛЬНЫЙ БОСС</span> <strong>Регламент ОГЭ 13.2 (2 / 2 баллов)</strong></div>
                        <p class="small mb-2">Выполните полную вёрстку документа из абзаца и таблицы по всем правилам ОГЭ 13.2:</p>
                        <div class="p-2 bg-white text-dark border border-dark mb-2" style="font-family: 'Liberation Serif', serif; font-size: 13pt;">
                            <p style="text-indent: 1cm; text-align: justify; line-height: 1.15; margin-bottom: 8px;">
                                <b>${w10Variant.boldWord}</b>${w10Variant.para.slice(w10Variant.boldWord.length)}
                            </p>
                            <table class="table table-bordered table-sm mb-0 mx-auto" style="width: 85%; border-color: #000;">
                                <thead>
                                    <tr>
                                        <th class="text-center fw-bold">${w10Variant.h1}</th>
                                        <th class="text-center fw-bold">${w10Variant.h2}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>${w10Variant.c1}</td>
                                        <td>${w10Variant.c2}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <ul class="small ps-3 mb-0">
                            <li><b>Формат → Страница...</b>: поля <b>2.0 см</b> со всех сторон.</li>
                            <li><b>Абзац</b>: шрифт <b>Liberation Serif 14 пт</b>, красная строка <b>1.0 см</b>, интервал <b>1.0–1.5</b>, выравнивание <b>по ширине</b>, слово <b>${w10Variant.boldWord}</b> — полужирным.</li>
                            <li><b>Таблица 2×2</b>: выровнена <b>по центру страницы</b>, заголовки по центру, шрифт 12–14 пт.</li>
                        </ul>
                    `,
                    evaluate(state) {
                        const wysiwyg = state.wysiwyg;
                        const marginsOk = state.pageMargins &&
                            Math.abs(state.pageMargins.leftCm - 2.0) < 0.05 &&
                            Math.abs(state.pageMargins.rightCm - 2.0) < 0.05 &&
                            Math.abs(state.pageMargins.topCm - 2.0) < 0.05 &&
                            Math.abs(state.pageMargins.bottomCm - 2.0) < 0.05;

                        const textNorm = normalizeComparable(state.text);
                        const hasParaText = textNorm.includes(normalizeComparable(w10Variant.para));
                        const hasTableText = textNorm.includes(normalizeComparable(w10Variant.h1)) &&
                            textNorm.includes(normalizeComparable(w10Variant.h2)) &&
                            textNorm.includes(normalizeComparable(w10Variant.c1)) &&
                            textNorm.includes(normalizeComparable(w10Variant.c2));

                        let ogeValid = false;
                        if (wysiwyg && window.inspectOgeDocument) {
                            const rep = window.inspectOgeDocument(wysiwyg, state.pageMargins);
                            ogeValid = rep.valid && rep.score === 2;
                        }

                        return [
                            { id: 'w10_margins', label: 'Поля страницы 2.0 см', passed: !!marginsOk },
                            { id: 'w10_para', label: 'Текст абзаца со спецсимволами', passed: hasParaText },
                            { id: 'w10_table', label: 'Таблица 2×2 с данными', passed: hasTableText },
                            { id: 'w10_oge', label: 'Стандарт ОГЭ 13.2 (2/2 баллов)', passed: ogeValid }
                        ];
                    }
                }
            ];
        }

        const app = createApp({
            template: `
                <div class="bg-black border-bottom border-danger p-2 px-3">
                    <div class="container-fluid px-0">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-danger text-uppercase px-2 py-1" id="wave-badge">
                                    ВОЛНА {{ currentWave }} / {{ maxWaves }}
                                </span>
                                <span class="fw-bold text-light font-monospace small" id="wave-title">
                                    {{ activeWave.title }}
                                </span>
                            </div>

                            <div class="d-flex flex-wrap align-items-center gap-1" id="live-checklist">
                                <span
                                    v-for="req in liveChecks"
                                    :key="req.id"
                                    class="badge font-monospace"
                                    :class="req.passed ? 'bg-success text-white' : 'bg-dark border border-secondary text-secondary'"
                                >
                                    {{ req.passed ? '✅' : '⏳' }} {{ req.label }}
                                </span>
                            </div>

                            <div class="d-flex align-items-center gap-3">
                                <div class="small font-monospace text-info" id="action-tracker-badge" title="Отслеживание действий ученика в текстовом процессоре">
                                    ДЕЙСТВИЙ: <span class="fw-bold">{{ actionCount }}</span>
                                    <span v-if="lastActionName" class="text-secondary ms-1">[{{ lastActionName }}]</span>
                                </div>
                                <div class="font-monospace fw-bold px-2 py-1 border" :class="timeLeft <= 15 ? 'border-danger text-danger bg-dark' : 'border-warning text-warning bg-dark'" id="arcade-timer">
                                    ⏱ {{ formatTime(timeLeft) }}
                                </div>
                            </div>
                        </div>

                        <div class="progress bg-dark border border-secondary" style="height: 6px;">
                            <div
                                class="progress-bar bg-danger"
                                role="progressbar"
                                :style="{ width: ((currentWave - 1) / maxWaves * 100) + '%' }"
                            ></div>
                        </div>

                        <div id="task-description" class="bg-dark border border-secondary p-2 mt-2 text-light" v-html="activeWave.instructionsHtml"></div>

                        <div v-if="resetAlert" id="hardcore-reset-banner" class="alert alert-danger rounded-0 py-2 px-3 mt-2 mb-0 d-flex justify-content-between align-items-center">
                            <div>
                                <strong>💥 ХАРДКОР-СБРОС НА ВОЛНУ 1!</strong> {{ resetAlert }}
                            </div>
                            <button class="btn btn-sm btn-outline-light rounded-0" @click="resetAlert = ''">Понятно</button>
                        </div>

                        <div v-if="isCompleted" id="victory-banner" class="alert alert-success rounded-0 py-3 px-4 mt-2 mb-0 border-2 border-success">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                <div>
                                    <h5 class="mb-1 fw-bold">🏆 МИССИЯ ВЫПОЛНЕНА! ВСЕ 10 ВОЛН СКОРОСТНОЙ ВЁРСТКИ ПРОЙДЕНЫ!</h5>
                                    <div class="small font-monospace">
                                        Вы подтвердили владение текстовым процессором LibreOffice Writer и стандартом ОГЭ 13.2 в боевом режиме. Зафиксировано действий редактора: {{ actionCount }}.
                                    </div>
                                </div>
                                <button class="btn btn-success fw-bold rounded-0 px-4" @click="restartArcade">Пройти заново</button>
                            </div>
                        </div>
                    </div>
                </div>
            `,
            setup() {
                const maxWaves = 10;
                const waves = ref(generateAllWaves());
                const currentWave = ref(1);
                const timeLeft = ref(190);
                const isCompleted = ref(false);
                const resetAlert = ref('');
                const actionCount = ref(0);
                const lastActionName = ref('');
                const liveState = ref({
                    html: '',
                    text: '',
                    wysiwyg: null,
                    pageMargins: { leftCm: 1.0, rightCm: 1.0, topCm: 1.0, bottomCm: 1.0 }
                });

                let timerInterval = null;

                const activeWave = computed(() => {
                    return waves.value[currentWave.value - 1] || waves.value[0];
                });

                const liveChecks = computed(() => {
                    if (!activeWave.value || !activeWave.value.evaluate) return [];
                    return activeWave.value.evaluate(liveState.value);
                });

                function formatTime(sec) {
                    const s = Math.max(0, Math.floor(sec));
                    const m = Math.floor(s / 60);
                    const rem = s % 60;
                    return `${String(m).padStart(2, '0')}:${String(rem).padStart(2, '0')}`;
                }

                function sendTelemetry(eventName, statusStr, isSuccess) {
                    if (window.parent) {
                        window.parent.postMessage({
                            type: 'TELEMETRY_EVENT',
                            lessonId: 'Урок 22',
                            level: 3,
                            event: eventName,
                            status: statusStr,
                            success: isSuccess,
                            wave: currentWave.value
                        }, '*');
                    }
                }

                function syncSidebarAndMode() {
                    const w = activeWave.value;
                    if (!w) return;
                    const descEl = document.getElementById('task-description');
                    if (descEl) {
                        descEl.innerHTML = w.instructionsHtml;
                    }
                    if (window.setWriterOgeCheck) {
                        window.setWriterOgeCheck(!!w.ogeFullCheck);
                    }
                }

                function refreshLiveState() {
                    const wysiwyg = document.querySelector('.jodit-wysiwyg');
                    const wState = window.getWriterState ? window.getWriterState() : null;
                    liveState.value = {
                        html: wState ? wState.html : (wysiwyg ? wysiwyg.innerHTML : ''),
                        text: wState ? wState.text : (wysiwyg ? wysiwyg.innerText : ''),
                        wysiwyg: wysiwyg,
                        pageMargins: wState ? wState.pageMargins : { leftCm: 1.0, rightCm: 1.0, topCm: 1.0, bottomCm: 1.0 }
                    };
                    if (wState && Array.isArray(wState.actionLog)) {
                        actionCount.value = wState.actionLog.length;
                        if (wState.actionLog.length > 0) {
                            lastActionName.value = wState.actionLog[wState.actionLog.length - 1].type;
                        }
                    }
                }

                function loadWave(waveNum, clearEditor = true) {
                    currentWave.value = waveNum;
                    const w = waves.value[waveNum - 1];
                    timeLeft.value = w ? w.timeLimit : 180;
                    if (clearEditor && window.resetWriterState) {
                        window.resetWriterState('<p><br></p>', false, waveNum === 1);
                    }
                    syncSidebarAndMode();
                    refreshLiveState();
                }

                function triggerHardcoreReset(reasonMsg) {
                    resetAlert.value = reasonMsg;
                    sendTelemetry('hardcore_reset', 'in_progress', false);
                    waves.value = generateAllWaves();
                    loadWave(1, true);
                }

                function startTimer() {
                    if (timerInterval) clearInterval(timerInterval);
                    timerInterval = setInterval(() => {
                        if (isCompleted.value) return;
                        if (timeLeft.value > 0) {
                            timeLeft.value--;
                        } else {
                            triggerHardcoreReset(`Время на Волне ${currentWave.value} истекло!`);
                        }
                    }, 1000);
                }

                function handleWriterChange() {
                    refreshLiveState();
                }

                function handleWriterAction(e) {
                    if (e && e.detail) {
                        actionCount.value = e.detail.totalActions || (actionCount.value + 1);
                        if (e.detail.entry && e.detail.entry.type) {
                            lastActionName.value = e.detail.entry.type;
                        }
                    }
                    refreshLiveState();
                }

                function handleWriterError(e) {
                    const score = e?.detail?.report?.score ?? 0;
                    waves.value = generateAllWaves();
                    loadWave(1, false);
                    resetAlert.value = `Детектор ОГЭ 13.2 заблокировал документ (${score}/2 баллов): обнаружены типографские костыли или нарушение стандарта! Прогресс сброшен на Волну 1.`;
                }

                function handleWriterCheck(e) {
                    refreshLiveState();
                    const checks = liveChecks.value;
                    const failed = checks.filter(c => !c.passed);

                    if (failed.length === 0) {
                        if (currentWave.value < maxWaves) {
                            const completedNum = currentWave.value;
                            e.detail.resolve(true, `✅ Волна ${completedNum} из ${maxWaves} пройдена! Загружена Волна ${completedNum + 1}.`, false);
                            resetAlert.value = '';
                            loadWave(completedNum + 1, true);
                        } else {
                            isCompleted.value = true;
                            resetAlert.value = '';
                            e.detail.resolve(true, '🏆 Все 10 волн скоростной вёрстки успешно пройдены!', true);
                            sendTelemetry('level_complete', 'completed', true);
                        }
                    } else {
                        const failedNames = failed.map(f => f.label).join(', ');
                        e.detail.resolve(false, `❌ Не выполнено условие Волны ${currentWave.value}: ${failedNames}`, false);
                        triggerHardcoreReset(`Ошибка на Волне ${currentWave.value}. Не выполнены требования: ${failedNames}.`);
                    }
                }

                function restartArcade() {
                    isCompleted.value = false;
                    resetAlert.value = '';
                    waves.value = generateAllWaves();
                    loadWave(1, true);
                }

                // Экспорт для E2E-тестирования и диагностики волн
                window.getLevel3ArcadeState = () => ({
                    currentWave: currentWave.value,
                    maxWaves,
                    timeLeft: timeLeft.value,
                    isCompleted: isCompleted.value,
                    activeWaveData: activeWave.value?.data,
                    liveChecks: liveChecks.value,
                    actionCount: actionCount.value,
                    lastActionName: lastActionName.value
                });
                window.jumpToLevel3Wave = (waveNum) => {
                    if (waveNum >= 1 && waveNum <= maxWaves) {
                        loadWave(waveNum, true);
                    }
                };
                window.forceLevel3Variant = (variantIdx) => {
                    window.__FORCE_VARIANT_INDEX = variantIdx;
                    waves.value = generateAllWaves();
                    loadWave(currentWave.value, true);
                };

                onMounted(() => {
                    // Дожидаемся инициализации WriterEmulator и синхронизируем Волну 1
                    setTimeout(() => {
                        syncSidebarAndMode();
                        refreshLiveState();
                    }, 50);
                    document.addEventListener('writer-change', handleWriterChange);
                    document.addEventListener('writer-action', handleWriterAction);
                    document.addEventListener('writer-check', handleWriterCheck);
                    document.addEventListener('writer-error', handleWriterError);
                    startTimer();
                });

                onUnmounted(() => {
                    if (timerInterval) clearInterval(timerInterval);
                    document.removeEventListener('writer-change', handleWriterChange);
                    document.removeEventListener('writer-action', handleWriterAction);
                    document.removeEventListener('writer-check', handleWriterCheck);
                    document.removeEventListener('writer-error', handleWriterError);
                });

                return {
                    maxWaves,
                    currentWave,
                    activeWave,
                    timeLeft,
                    isCompleted,
                    resetAlert,
                    actionCount,
                    lastActionName,
                    liveChecks,
                    formatTime,
                    restartArcade
                };
            }
        });

        app.mount('#app');
    </script>
</TaskLayout>
