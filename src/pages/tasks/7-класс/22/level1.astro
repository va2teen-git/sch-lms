---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
import WriterEmulator from '../../../../components/WriterEmulator.astro';
---

<TaskLayout title="7 Класс - Урок 22 - Уровень 1: Практикум в LibreOffice Writer" level={1} bodyClass="d-flex flex-column min-vh-100">
    <div class="container-fluid px-2 px-md-3 pt-2 pb-1 bg-dark border-bottom border-success flex-shrink-0 font-monospace">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div class="d-flex align-items-center gap-2">
                <span id="phase-badge" class="badge bg-success text-dark rounded-0 fs-6">Шаг 1 из 3</span>
                <h2 id="phase-title" class="h6 text-success fw-bold mb-0">Форматирование символов в LibreOffice Writer</h2>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge border border-success text-success bg-black rounded-0 px-2 py-1">Интерактивный практикум // Writer</span>
                <div class="text-secondary small">
                    Ошибки: <span id="attempts-display" class="text-warning fw-bold">0</span>
                </div>
            </div>
        </div>

        <!-- Живой чек-лист требований этапа -->
        <div id="live-checklist" class="d-flex flex-wrap gap-1 mb-2"></div>

        <!-- Инструкция и образец -->
        <div id="task-instruction" class="card bg-black border-success rounded-0 p-2 mb-2 text-light small">
            Загрузка задания...
        </div>

        <!-- Ошибка и перегенерация -->
        <div id="error-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none py-2 px-3 mb-2 small" role="alert">
            <strong>[ОШИБКА ОФОРМЛЕНИЯ]</strong> <span id="error-message">Проверьте требования этапа.</span>
        </div>

        <!-- Экран победы -->
        <div id="success-screen" class="alert alert-success bg-black text-success border-2 border-success rounded-0 d-none py-3 px-3 mb-2">
            <h5 class="fw-bold mb-1">✅ УРОВЕНЬ 1 УСПЕШНО ЗАВЕРШЕН!</h5>
            <p class="text-light small mb-0">Все 3 интерактивных этапа форматирования символов, абзацев, полей и таблиц в LibreOffice Writer выполнены.</p>
        </div>
    </div>

    <!-- Интерактивный текстовый редактор LibreOffice Writer -->
    <div class="flex-grow-1 d-flex flex-column" style="min-height: 540px;">
        <WriterEmulator
            missionName="Урок 22 :: Форматирование текстовых документов (Уровень 1)"
            initialHTML=""
            checkOgeFormat={false}
            hardcoreReset={false}
            disableAutoTelemetry={true}
        />
    </div>
</TaskLayout>

<script is:inline>
(function () {
    const MISSION_NAME = 'Урок 22 :: Форматирование текстовых документов (Уровень 1)';
    const telemetry = window.LMSTelemetry.create({
        missionName: MISSION_NAME,
        level: 1,
        totalStages: 3
    });

    let currentStage = 1;
    let currentVariantIdx = 0;
    let isCompleted = false;
    let stage1Variants = [];
    let stage2Variants = [];
    let stage3Variants = [];

    function pickVariant(arr) {
        if (typeof window.__FORCE_L1_VARIANT === 'number') {
            return arr[window.__FORCE_L1_VARIANT % arr.length];
        }
        return arr[Math.floor(Math.random() * arr.length)];
    }

    function initVariants() {
        stage1Variants = [
            {
                draftHtml: '<p>Плотность воды составляет 1000 кг/м3, а химическая формула записывается как H2O при стандартном давлении.</p>',
                font: 'Liberation Serif',
                sizePt: 14,
                boldWord: 'Плотность',
                italicWord: 'формула',
                underlineWord: 'давлении',
                supDigit: '3',
                subDigit: '2',
                sampleText: 'Плотность воды составляет 1000 кг/м³ (надстрочный «3»), а химическая формула записывается как H₂O (подстрочный «2») при стандартном давлении.'
            },
            {
                draftHtml: '<p>Площадь квадрата равна 25 м2, при этом углекислый газ имеет формулу CO2 в атмосфере Земли.</p>',
                font: 'Times New Roman',
                sizePt: 14,
                boldWord: 'Площадь',
                italicWord: 'углекислый',
                underlineWord: 'атмосфере',
                supDigit: '2',
                subDigit: '2',
                sampleText: 'Площадь квадрата равна 25 м² (надстрочный «2»), при этом углекислый газ имеет формулу CO₂ (подстрочный «2») в атмосфере Земли.'
            },
            {
                draftHtml: '<p>Энергия тела пропорциональна mv2, а молекула кислорода обозначается формулой O2 в таблице элементов.</p>',
                font: 'Liberation Serif',
                sizePt: 14,
                boldWord: 'Энергия',
                italicWord: 'молекула',
                underlineWord: 'таблице',
                supDigit: '2',
                subDigit: '2',
                sampleText: 'Энергия тела пропорциональна mv² (надстрочный «2»), а молекула кислорода обозначается формулой O₂ (подстрочный «2») в таблице элементов.'
            }
        ];

        stage2Variants = [
            {
                draftHtml: '<p>Компьютерная типографика предъявляет строгие требования к геометрии страницы и абзацев. Красная строка и выравнивание по ширине делают длинный учебный текст удобным для чтения с бумаги и экрана.</p>',
                lineHeight: '1.15',
                indentCm: 1.0,
                marginCm: 2.0
            },
            {
                draftHtml: '<p>Оформление деловых и учебных документов в LibreOffice Writer начинается с настройки полей листа. Правильные отступы первой строки и междустрочный интервал позволяют обойтись без лишних пробелов и пустых строк.</p>',
                lineHeight: '1.5',
                indentCm: 1.0,
                marginCm: 2.0
            }
        ];

        stage3Variants = [
            {
                draftHtml: '<p style="font-family: \'Liberation Serif\', serif; font-size: 14pt; text-align: justify; text-indent: 1.0cm;">Сравнительная таблица ключевых параметров системных блоков в компьютерном классе:</p>' +
                    '<table style="width: 100%; border-collapse: collapse;">' +
                    '<thead><tr><th style="border:1px solid #000; padding:6px; text-align:left; font-weight:normal;">Параметр</th><th style="border:1px solid #000; padding:6px; text-align:left; font-weight:normal;">Значение</th></tr></thead>' +
                    '<tbody><tr><td style="border:1px solid #000; padding:6px;">Оперативная память</td><td style="border:1px solid #000; padding:6px;">16 Гбайт</td></tr>' +
                    '<tr><td style="border:1px solid #000; padding:6px;">Накопитель SSD</td><td style="border:1px solid #000; padding:6px;">512 Гбайт</td></tr></tbody></table>',
                note: 'Отцентрируйте таблицу на листе, выровняйте шапку по центру с полужирным шрифтом и задайте вертикальное выравнивание ячеек «По середине».'
            },
            {
                draftHtml: '<p style="font-family: \'Liberation Serif\', serif; font-size: 14pt; text-align: justify; text-indent: 1.0cm;">Основные характеристики передаваемых текстовых файлов различных стандартов:</p>' +
                    '<table style="width: 100%; border-collapse: collapse;">' +
                    '<thead><tr><th style="border:1px solid #000; padding:6px; text-align:left; font-weight:normal;">Формат</th><th style="border:1px solid #000; padding:6px; text-align:left; font-weight:normal;">Назначение</th></tr></thead>' +
                    '<tbody><tr><td style="border:1px solid #000; padding:6px;">.odt</td><td style="border:1px solid #000; padding:6px;">Стандарт LibreOffice Writer</td></tr>' +
                    '<tr><td style="border:1px solid #000; padding:6px;">.pdf</td><td style="border:1px solid #000; padding:6px;">Фиксированная печать</td></tr></tbody></table>',
                note: 'Отцентрируйте таблицу на листе, выровняйте шапку по центру с полужирным шрифтом и задайте вертикальное выравнивание ячеек «По середине».'
            }
        ];
    }

    let activeData = null;

    function getStageDraftHtml() {
        return activeData ? activeData.draftHtml : '<p></p>';
    }

    function evaluateStageChecks(state) {
        const V = window.WriterValidator;
        const wysiwyg = state?.wysiwyg || document.querySelector('.jodit-wysiwyg');
        if (!wysiwyg || !activeData) return [];

        if (currentStage === 1) {
            const p = wysiwyg.querySelector('p') || wysiwyg;
            const geom = V ? V.checkParagraphGeometry(p, { font: activeData.font, sizePt: activeData.sizePt }) : { fontOk: false, sizeOk: false };
            const boldOk = V ? V.hasBoldWord(wysiwyg, activeData.boldWord) : false;
            const italicOk = V ? V.hasItalicWord(wysiwyg, activeData.italicWord) : false;
            const underOk = V ? V.hasUnderlineWord(wysiwyg, activeData.underlineWord) : false;
            const supOk = V ? V.hasSuperscript(wysiwyg, activeData.supDigit) : false;
            const subOk = V ? V.hasSubscript(wysiwyg, activeData.subDigit) : false;
            return [
                { id: 's1_font', label: `Шрифт ${activeData.font}`, passed: !!geom.fontOk },
                { id: 's1_size', label: `Кегль ${activeData.sizePt} пт`, passed: !!geom.sizeOk },
                { id: 's1_bold', label: `Полужирный «${activeData.boldWord}»`, passed: boldOk },
                { id: 's1_italic', label: `Курсив «${activeData.italicWord}»`, passed: italicOk },
                { id: 's1_under', label: `Подчёркнутый «${activeData.underlineWord}»`, passed: underOk },
                { id: 's1_sup', label: `Верхний индекс «${activeData.supDigit}»`, passed: supOk },
                { id: 's1_sub', label: `Нижний индекс «${activeData.subDigit}»`, passed: subOk }
            ];
        }

        if (currentStage === 2) {
            const m = state?.pageMargins || { leftCm: 1, rightCm: 1, topCm: 1, bottomCm: 1 };
            const marginsOk = Math.abs(m.leftCm - activeData.marginCm) < 0.1 &&
                Math.abs(m.rightCm - activeData.marginCm) < 0.1 &&
                Math.abs(m.topCm - activeData.marginCm) < 0.1 &&
                Math.abs(m.bottomCm - activeData.marginCm) < 0.1;
            const p = wysiwyg.querySelector('p');
            const geom = (V && p) ? V.checkParagraphGeometry(p, {
                textAlign: 'justify',
                indentCm: activeData.indentCm,
                lineHeight: activeData.lineHeight
            }) : { alignOk: false, indentOk: false, lineHeightOk: false };
            const noSpacesCrutch = p ? !/^(&nbsp;|\s){2,}/i.test(p.innerHTML || '') : false;
            return [
                { id: 's2_margins', label: `Поля ${activeData.marginCm.toFixed(1)} см`, passed: marginsOk },
                { id: 's2_align', label: 'Выравнивание: По ширине', passed: !!geom.alignOk },
                { id: 's2_indent', label: 'Красная строка 1.0 см (без пробелов)', passed: !!geom.indentOk && noSpacesCrutch },
                { id: 's2_lh', label: `Междустрочный интервал ${activeData.lineHeight}`, passed: !!geom.lineHeightOk }
            ];
        }

        // Этап 3: Таблица
        const tbl = wysiwyg.querySelector('table');
        const tblCentered = tbl ? ((tbl.style.marginLeft === 'auto' && tbl.style.marginRight === 'auto') || tbl.getAttribute('align') === 'center') : false;
        let headersCenterBold = false;
        let valignMiddleOk = false;
        if (tbl && tbl.rows && tbl.rows.length > 0) {
            const ths = Array.from(tbl.rows[0].cells);
            headersCenterBold = ths.length > 0 && ths.every(c => {
                const st = window.getComputedStyle(c);
                const al = c.style.textAlign || st.textAlign;
                const fw = c.style.fontWeight || st.fontWeight;
                const isB = fw === 'bold' || parseInt(fw, 10) >= 600;
                return al === 'center' && isB;
            });
            const allCells = Array.from(tbl.querySelectorAll('th, td'));
            valignMiddleOk = allCells.length > 0 && allCells.every(c => (c.style.verticalAlign || '').toLowerCase() === 'middle');
        }
        return [
            { id: 's3_center', label: 'Таблица по центру листа', passed: tblCentered },
            { id: 's3_header', label: 'Шапка: по центру и полужирный', passed: headersCenterBold },
            { id: 's3_valign', label: 'Ячейки: вертикально по середине', passed: valignMiddleOk }
        ];
    }

    function renderChecklist(state) {
        const listEl = document.getElementById('live-checklist');
        if (!listEl) return;
        const checks = evaluateStageChecks(state || (window.getWriterState ? window.getWriterState() : null));
        listEl.innerHTML = '';
        checks.forEach(c => {
            const span = document.createElement('span');
            span.className = `badge font-monospace ${c.passed ? 'bg-success text-white' : 'bg-dark border border-secondary text-secondary'}`;
            span.innerText = `${c.passed ? '✅' : '⏳'} ${c.label}`;
            listEl.appendChild(span);
        });
    }

    function loadStage(stageNum) {
        currentStage = stageNum;
        const badge = document.getElementById('phase-badge');
        const title = document.getElementById('phase-title');
        const instr = document.getElementById('task-instruction');
        if (badge) badge.innerText = `Шаг ${stageNum} из 3`;

        if (stageNum === 1) {
            activeData = pickVariant(stage1Variants);
            if (title) title.innerText = 'Форматирование символов (шрифт, кегль, начертания и индексы)';
            if (instr) {
                instr.innerHTML = `
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                        <div>
                            <div class="fw-bold text-warning mb-1">Задание этапа 1: отформатируйте предзагруженный текст в окне LibreOffice Writer ниже:</div>
                            <ul class="mb-1 ps-3">
                                <li>Установите гарнитуру <strong class="text-info">${activeData.font}</strong> и размер <strong class="text-info">${activeData.sizePt} пт</strong>;</li>
                                <li>Сделайте слово <strong class="text-warning">«${activeData.boldWord}»</strong> — полужирным (<b>Ж</b>), <strong class="text-warning">«${activeData.italicWord}»</strong> — курсивом (<i>К</i>), <strong class="text-warning">«${activeData.underlineWord}»</strong> — подчёркнутым (<u>Ч</u>);</li>
                                <li>Оформите цифру <strong class="text-info">${activeData.supDigit}</strong> в верхний индекс (<kbd>x²</kbd>) и цифру <strong class="text-info">${activeData.subDigit}</strong> в формуле в нижний индекс (<kbd>x₂</kbd>).</li>
                            </ul>
                            <div class="bg-white text-dark p-1 px-2 border small mt-1"><strong>Ориентир:</strong> ${activeData.sampleText}</div>
                        </div>
                        <button type="button" id="btn-restore-draft" class="btn btn-outline-secondary btn-sm rounded-0 flex-shrink-0">Сбросить текст этапа</button>
                    </div>
                `;
            }
        } else if (stageNum === 2) {
            activeData = pickVariant(stage2Variants);
            if (title) title.innerText = 'Параметры страницы, красная строка (1,0 см) и интервалы абзаца';
            if (instr) {
                instr.innerHTML = `
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                        <div>
                            <div class="fw-bold text-warning mb-1">Задание этапа 2: настройте геометрию страницы и абзаца:</div>
                            <ul class="mb-0 ps-3">
                                <li>Откройте меню <strong class="text-info">Формат → Стиль страницы…</strong> и установите поля <strong class="text-warning">2.0 см</strong> со всех сторон;</li>
                                <li>Выровняйте абзац <strong class="text-info">По ширине</strong> (<kbd>Ctrl+J</kbd>);</li>
                                <li>Установите отступ первой строки (красную строку) <strong class="text-warning">1.0 см</strong> (через линейку или <strong class="text-info">Формат → Абзац…</strong>) и междустрочный интервал <strong class="text-warning">${activeData.lineHeight}</strong>.</li>
                            </ul>
                        </div>
                        <button type="button" id="btn-restore-draft" class="btn btn-outline-secondary btn-sm rounded-0 flex-shrink-0">Сбросить текст этапа</button>
                    </div>
                `;
            }
        } else {
            activeData = pickVariant(stage3Variants);
            if (title) title.innerText = 'Форматирование таблицы: выравнивание на листе, шапка и ячейки';
            if (instr) {
                instr.innerHTML = `
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                        <div>
                            <div class="fw-bold text-warning mb-1">Задание этапа 3: оформите таблицу в документе по стандарту ОГЭ:</div>
                            <ul class="mb-0 ps-3">
                                <li>Поставьте курсор в таблицу и откройте <strong class="text-info">Таблица → Свойства…</strong> (или кнопку на контекстной панели «Таблица» снизу);</li>
                                <li>Выровняйте таблицу <strong class="text-warning">По центру</strong> страницы, шапку — <strong class="text-warning">По центру</strong> и <strong class="text-warning">полужирным</strong> шрифтом;</li>
                                <li>Установите вертикальное выравнивание ячеек <strong class="text-info">По середине</strong> (<kbd>middle</kbd>).</li>
                            </ul>
                        </div>
                        <button type="button" id="btn-restore-draft" class="btn btn-outline-secondary btn-sm rounded-0 flex-shrink-0">Сбросить текст этапа</button>
                    </div>
                `;
            }
        }

        document.getElementById('btn-restore-draft')?.addEventListener('click', () => {
            if (window.resetWriterState) {
                window.resetWriterState(getStageDraftHtml(), false, true);
                renderChecklist();
            }
        });

        if (window.resetWriterState) {
            window.resetWriterState(getStageDraftHtml(), false, true);
        }
        renderChecklist();
    }

    function initWhenWriterReady() {
        if (window.resetWriterState && document.querySelector('.jodit-wysiwyg')) {
            initVariants();
            loadStage(1);
        } else {
            setTimeout(initWhenWriterReady, 30);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWhenWriterReady);
    } else {
        initWhenWriterReady();
    }

    document.addEventListener('writer-change', (e) => {
        if (!isCompleted) renderChecklist(e.detail);
    });

    document.addEventListener('writer-check', (e) => {
        if (isCompleted) return;
        telemetry.markActivity();
        const checks = evaluateStageChecks(e.detail);
        const failed = checks.filter(c => !c.passed);

        if (failed.length > 0) {
            const errMsg = `Не выполнены требования: ${failed.map(f => f.label).join('; ')}`;
            telemetry.hardcoreReset({ stage: currentStage });
            const attEl = document.getElementById('attempts-display');
            if (attEl) attEl.innerText = String(telemetry.getState().attemptsCount);
            const errBox = document.getElementById('error-box');
            const errText = document.getElementById('error-message');
            if (errText) errText.innerText = errMsg;
            if (errBox) errBox.classList.remove('d-none');
            e.detail.resolve(false, `❌ ${errMsg}`, false);
            setTimeout(() => {
                if (errBox) errBox.classList.add('d-none');
            }, 2500);
            return;
        }

        if (currentStage < 3) {
            e.detail.resolve(true, `✅ Этап ${currentStage} из 3 выполнен!`, false);
            currentStage++;
            telemetry.advanceStage(currentStage);
            setTimeout(() => loadStage(currentStage), 350);
        } else {
            isCompleted = true;
            e.detail.resolve(true, '🏆 Уровень 1 успешно пройден!', true);
            telemetry.complete({ stage: 3 });
            document.getElementById('success-screen')?.classList.remove('d-none');
        }
    });

    window.getLevel1WriterState = () => ({
        currentStage,
        activeData,
        isCompleted,
        attempts: telemetry.getState().attemptsCount
    });
    window.jumpToLevel1Stage = (n) => {
        if (n >= 1 && n <= 3) loadStage(n);
    };
})();
</script>
