---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
import WriterEmulator from '../../../../components/WriterEmulator.astro';
---

<TaskLayout title="7 Класс - Урок 22 - Уровень 2: Реконструкция и вёрстка в LibreOffice Writer" level={2} bodyClass="d-flex flex-column min-vh-100">
    <div class="container-fluid px-2 px-md-3 pt-2 pb-1 bg-dark border-bottom border-warning flex-shrink-0 font-monospace">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div class="d-flex align-items-center gap-2">
                <span id="phase-badge" class="badge bg-warning text-dark rounded-0 fs-6">Шаг 1 из 5</span>
                <h2 id="phase-title" class="h6 text-warning fw-bold mb-0">Аудит непечатаемых символов и ликвидация «костылей»</h2>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge border border-warning text-warning bg-black rounded-0 px-2 py-1">Инженерная вёрстка // Writer</span>
                <div class="text-secondary small">
                    Ошибки: <span id="attempts-display" class="text-warning fw-bold">0</span>
                </div>
            </div>
        </div>

        <!-- Живой чек-лист требований -->
        <div id="live-checklist" class="d-flex flex-wrap gap-1 mb-2"></div>

        <!-- Описание задачи текущего этапа -->
        <div id="task-instruction" class="card bg-black border-warning rounded-0 p-2 mb-2 text-light small">
            Загрузка задания...
        </div>

        <!-- Блок ошибки при проверке -->
        <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none py-2 px-3 mb-2 small" role="alert">
            <strong>[АНАЛИТИЧЕСКИЙ СБОЙ]</strong> <span id="feedback-text">Проверьте требования этапа.</span>
        </div>

        <!-- Экран победы -->
        <div id="success-screen" class="alert alert-success bg-black text-warning border-2 border-warning rounded-0 d-none py-3 px-3 mb-2">
            <h5 class="fw-bold mb-1">✅ УРОВЕНЬ 2 УСПЕШНО ЗАВЕРШЕН!</h5>
            <p class="text-light small mb-0">Все 5 этапов инженерной реконструкции, автозамены, научного набора, конструирования таблиц и полной сдачи ОГЭ 13.2 пройдены.</p>
        </div>
    </div>

    <!-- Интерактивный текстовый редактор LibreOffice Writer -->
    <div class="flex-grow-1 d-flex flex-column" style="min-height: 540px;">
        <WriterEmulator
            missionName="Урок 22 :: Форматирование текстовых документов (Уровень 2)"
            initialHTML=""
            checkOgeFormat={false}
            hardcoreReset={false}
            disableAutoTelemetry={true}
        />
    </div>
</TaskLayout>

<script is:inline>
(function () {
    const MISSION_NAME = 'Урок 22 :: Форматирование текстовых документов (Уровень 2)';
    const telemetry = window.LMSTelemetry.create({
        missionName: MISSION_NAME,
        level: 2,
        totalStages: 5
    });

    let currentStage = 1;
    let isCompleted = false;
    let activeData = null;

    function pickVariant(arr) {
        if (typeof window.__FORCE_L2_VARIANT === 'number') {
            return arr[window.__FORCE_L2_VARIANT % arr.length];
        }
        return arr[Math.floor(Math.random() * arr.length)];
    }

    const STAGES = {
        1: [
            {
                draftHtml: '<p>     &quot;Байт&quot; - это основная единица измерения объема информации.</p><p><br></p><p>     Восемь бит образуют один байт в памяти ЭВМ.</p>',
                expectedPhrase: '«Байт» — это основная единица измерения объема информации.'
            },
            {
                draftHtml: '<p>     &quot;Абзац&quot; - это фрагмент текста, завершающийся маркером конца абзаца.</p><p><br></p><p>     В конце строки нажимать Enter внутри абзаца запрещено.</p>',
                expectedPhrase: '«Абзац» — это фрагмент текста, завершающийся маркером конца абзаца.'
            }
        ],
        2: [
            {
                badWord: 'компютер',
                goodWord: 'компьютер',
                draftHtml: '<p>Современный компютер обрабатывает текстовые документы за миллисекунды.</p><p>Каждый компютер в классе оснащен пакетом LibreOffice Writer.</p>'
            },
            {
                badWord: 'инфорамция',
                goodWord: 'информация',
                draftHtml: '<p>Текстовая инфорамция оформляется в соответствии с правилами типографики.</p><p>Вся важная инфорамция в таблицах выделяется полужирным заголовком.</p>'
            }
        ],
        3: [
            {
                text: 'Вода — вещество с формулой H₂O, закипает при 100 °C на площади 1 м².',
                boldWord: 'Вода',
                supDigit: '2',
                subDigit: '2',
                sampleHtml: '<b>Вода</b> — вещество с формулой H<sub>2</sub>O, закипает при 100 °C на площади 1 м<sup>2</sup>.'
            },
            {
                text: 'Углерод — основа соединения CO₂, плотность при 20 °C составляет 5 кг/м³.',
                boldWord: 'Углерод',
                supDigit: '3',
                subDigit: '2',
                sampleHtml: '<b>Углерод</b> — основа соединения CO<sub>2</sub>, плотность при 20 °C составляет 5 кг/м<sup>3</sup>.'
            }
        ],
        4: [
            {
                mergedHeader: 'Показатели',
                col3Header: 'Итого',
                c1: 'Скорость',
                c2: '100',
                c3: 'Норма'
            },
            {
                mergedHeader: 'Параметры',
                col3Header: 'Статус',
                c1: 'Память',
                c2: '16 ГБ',
                c3: 'ОК'
            }
        ],
        5: [
            {
                boldWord: 'Процессор',
                paraText: 'Процессор «Байкал» — современная микросхема, работающая при температуре 45 °C.',
                h1: 'Параметр',
                h2: 'Значение',
                c1: 'Частота',
                c2: '2.0 ГГц'
            },
            {
                boldWord: 'Байкал',
                paraText: 'Байкал — самое глубокое озеро, температура воды составляет 4 °C, чистота «эталонная».',
                h1: 'Показатель',
                h2: 'Величина',
                c1: 'Глубина',
                c2: '1642 м'
            }
        ]
    };

    function getPtFromCss(val) {
        if (!val) return 0;
        const v = String(val).trim().replace(',', '.').toLowerCase();
        if (v.endsWith('pt')) return parseFloat(v) || 0;
        if (v.endsWith('cm')) return (parseFloat(v) || 0) * 28.3464567;
        if (v.endsWith('px')) return (parseFloat(v) || 0) * 0.75;
        return parseFloat(v) || 0;
    }

    function evaluateStageChecks(state) {
        const V = window.WriterValidator;
        const wysiwyg = state?.wysiwyg || document.querySelector('.jodit-wysiwyg');
        if (!wysiwyg || !activeData) return [];

        if (currentStage === 1) {
            const rawText = (wysiwyg.textContent || '').replace(/[\uFEFF\u200B\u200C\u200D]/g, '');
            const paras = Array.from(wysiwyg.querySelectorAll('p'));
            const contentParas = paras.filter(p => (p.textContent || '').replace(/[\uFEFF\u200B\u200C\u200D]/g, '').trim().length > 0);

            const noLeadingSpaces = contentParas.length >= 2 && contentParas.every(p => !/^(&nbsp;|\s)+/i.test(p.innerHTML || ''));
            const noEmptyPara = paras.filter(p => {
                const t = (p.textContent || '').replace(/[\uFEFF\u200B\u200C\u200D]/g, '').trim();
                const ih = (p.innerHTML || '').replace(/[\uFEFF\u200B\u200C\u200D]/g, '').trim();
                return t === '' && (ih === '' || ih === '<br>' || ih === '&nbsp;');
            }).length === 0;
            const noHyphenOrQuotesCrutch = !/\s+-\s+/.test(rawText) && !/"/.test(rawText) && rawText.includes('—') && rawText.includes('«') && rawText.includes('»');
            const indentAndAlignOk = contentParas.length >= 2 && contentParas.every(p => {
                const g = V ? V.checkParagraphGeometry(p, { textAlign: 'justify', indentCm: 1.0 }) : { alignOk: false, indentOk: false };
                return g.alignOk && g.indentOk;
            });

            return [
                { id: 'l2_s1_spaces', label: 'Удалены пробелы в начале', passed: noLeadingSpaces },
                { id: 'l2_s1_empty', label: 'Удалена пустая строка (Enter)', passed: noEmptyPara },
                { id: 'l2_s1_typo', label: 'Тире (—) и кавычки (« »)', passed: noHyphenOrQuotesCrutch },
                { id: 'l2_s1_geom', label: 'Красная строка 1.0 см + По ширине', passed: indentAndAlignOk }
            ];
        }

        if (currentStage === 2) {
            const rawText = (wysiwyg.textContent || '').toLowerCase();
            const replacedOk = !rawText.includes(activeData.badWord.toLowerCase()) && rawText.includes(activeData.goodWord.toLowerCase());
            const paras = Array.from(wysiwyg.querySelectorAll('p')).filter(p => (p.textContent || '').trim().length > 0);
            const indentOk = paras.length > 0 && paras.every(p => V && V.checkParagraphGeometry(p, { indentCm: 1.0, textAlign: 'justify' }).allOk);
            const spacingOk = paras.length > 0 && paras.some(p => {
                const botPt = getPtFromCss(p.style.marginBottom || window.getComputedStyle(p).marginBottom);
                return botPt >= 11 && botPt <= 25;
            });
            return [
                { id: 'l2_s2_replace', label: `Заменено «${activeData.badWord}» → «${activeData.goodWord}»`, passed: replacedOk },
                { id: 'l2_s2_geom', label: 'Красная строка 1.0 см + По ширине', passed: indentOk },
                { id: 'l2_s2_space', label: 'Интервал после абзаца 12–24 пт (0.42–0.85 см)', passed: spacingOk }
            ];
        }

        if (currentStage === 3) {
            const p = wysiwyg.querySelector('p') || wysiwyg;
            const hasTextOk = V ? V.hasText(wysiwyg, activeData.text) : false;
            const hasBoldOk = V ? V.hasBoldWord(wysiwyg, activeData.boldWord) : false;
            const hasSupOk = V ? V.hasSuperscript(wysiwyg, activeData.supDigit) : false;
            const hasSubOk = V ? V.hasSubscript(wysiwyg, activeData.subDigit) : false;
            const fontSizeOk = V ? V.checkParagraphGeometry(p, { font: 'Liberation Serif', sizePt: 14 }).allOk : false;
            const hasSpecialChars = (wysiwyg.textContent || '').includes('—') && (wysiwyg.textContent || '').includes('°');
            return [
                { id: 'l2_s3_text', label: 'Точный текст и тире/градус (° —)', passed: hasTextOk && hasSpecialChars },
                { id: 'l2_s3_bold', label: `Полужирный «${activeData.boldWord}»`, passed: hasBoldOk },
                { id: 'l2_s3_idx', label: `Индексы: нижний «${activeData.subDigit}» и верхний «${activeData.supDigit}»`, passed: hasSupOk && hasSubOk },
                { id: 'l2_s3_font', label: 'Liberation Serif, 14 пт', passed: fontSizeOk }
            ];
        }

        if (currentStage === 4) {
            const tbl = wysiwyg.querySelector('table');
            const centered = tbl ? ((tbl.style.marginLeft === 'auto' && tbl.style.marginRight === 'auto') || tbl.getAttribute('align') === 'center') : false;
            const hasMerged = tbl ? Array.from(tbl.querySelectorAll('th, td')).some(c => parseInt(c.getAttribute('colspan') || '1', 10) >= 2) : false;
            const cells = tbl ? Array.from(tbl.querySelectorAll('th, td')) : [];
            const valignOk = cells.length > 0 && cells.every(c => (c.style.verticalAlign || '').toLowerCase() === 'middle');
            const normText = V ? V.normalizeComparable(tbl ? tbl.textContent : '') : '';
            const dataOk = normText.includes(V.normalizeComparable(activeData.mergedHeader)) &&
                normText.includes(V.normalizeComparable(activeData.c1)) &&
                normText.includes(V.normalizeComparable(activeData.c3));
            return [
                { id: 'l2_s4_tbl', label: 'Таблица с данными', passed: !!tbl && dataOk },
                { id: 'l2_s4_merge', label: 'Объединены ячейки шапки (colspan >= 2)', passed: hasMerged },
                { id: 'l2_s4_center', label: 'Таблица по центру листа', passed: centered },
                { id: 'l2_s4_valign', label: 'Ячейки выровнены по середине', passed: valignOk }
            ];
        }

        // Этап 5: Полная сдача ОГЭ 13.2
        const m = state?.pageMargins || { leftCm: 1, rightCm: 1, topCm: 1, bottomCm: 1 };
        const hasPara = V ? V.hasText(wysiwyg, activeData.paraText) : false;
        const hasBold = V ? V.hasBoldWord(wysiwyg, activeData.boldWord) : false;
        const tbl = wysiwyg.querySelector('table');
        const hasTableData = !!(tbl && V && V.normalizeComparable(tbl.textContent || '').includes(V.normalizeComparable(activeData.h1)) && V.normalizeComparable(tbl.textContent || '').includes(V.normalizeComparable(activeData.c2)));
        let ogeValid = false;
        if (window.inspectOgeDocument) {
            const rep = window.inspectOgeDocument(wysiwyg, m);
            ogeValid = rep.valid && rep.score === 2;
        }
        return [
            { id: 'l2_s5_para', label: 'Текст абзаца + полужирный', passed: hasPara && hasBold },
            { id: 'l2_s5_tbl', label: 'Таблица 2×2 с данными', passed: hasTableData },
            { id: 'l2_s5_oge', label: 'Стандарт ОГЭ 13.2 (2/2 баллов)', passed: ogeValid }
        ];
    }

    function renderChecklist(state) {
        const listEl = document.getElementById('live-checklist');
        if (!listEl) return;
        const checks = evaluateStageChecks(state || (window.getWriterState ? window.getWriterState() : null));
        listEl.innerHTML = '';
        checks.forEach(c => {
            const span = document.createElement('span');
            span.className = `badge font-monospace ${c.passed ? 'bg-success text-white' : 'bg-dark border border-secondary text-secondary'}`;
            span.innerText = `${c.passed ? '✅' : '⏳'} ${c.label}`;
            listEl.appendChild(span);
        });
    }

    function loadStage(stageNum) {
        currentStage = stageNum;
        activeData = pickVariant(STAGES[stageNum]);
        const badge = document.getElementById('phase-badge');
        const title = document.getElementById('phase-title');
        const instr = document.getElementById('task-instruction');
        if (badge) badge.innerText = `Шаг ${stageNum} из 5`;

        let draft = '<p><br></p>';
        if (stageNum === 1) {
            draft = activeData.draftHtml;
            if (title) title.innerText = 'Аудит непечатаемых символов и ликвидация «костылей»';
            if (instr) instr.innerHTML = `
                <div class="fw-bold text-warning mb-1">Этап 1: Включите «Непечатаемые символы» (¶ / Ctrl+F10) и исправьте дефекты вёрстки:</div>
                <ul class="mb-0 ps-3">
                    <li>Удалите пробелы в начале обоих абзацев и пустой абзац между ними;</li>
                    <li>Замените программистские кавычки <code>"..."</code> на кавычки-ёлочки <code>«...»</code>, а дефис <code> - </code> на длинное тире <code>—</code> (кнопка <b>Ω</b>);</li>
                    <li>Установите красную строку <strong>1.0 см</strong> и выравнивание <strong>По ширине</strong> (<code>Ctrl+J</code>).</li>
                </ul>`;
        } else if (stageNum === 2) {
            draft = activeData.draftHtml;
            if (title) title.innerText = 'Найти и заменить + межабзацный интервал (пт / см)';
            if (instr) instr.innerHTML = `
                <div class="fw-bold text-warning mb-1">Этап 2: Выполните массовую замену и настройте интервалы абзацев:</div>
                <ul class="mb-0 ps-3">
                    <li>Через <strong>Правка → Найти и заменить…</strong> (<code>Ctrl+H</code>) замените слово <code class="text-danger">${activeData.badWord}</code> на <code class="text-success">${activeData.goodWord}</code>;</li>
                    <li>В окне <strong>Формат → Абзац…</strong> задайте красную строку <strong>1.0 см</strong>, выравнивание <strong>По ширине</strong> и <strong>Интервал после абзаца</strong> от <strong>12 до 24 пт</strong> (или <strong>0.42–0.85 см</strong>).</li>
                </ul>`;
        } else if (stageNum === 3) {
            if (title) title.innerText = 'Клавиатурный набор научного текста со спецсимволами и индексами';
            if (instr) instr.innerHTML = `
                <div class="fw-bold text-warning mb-1">Этап 3: Наберите образец шрифтом <code>Liberation Serif</code> <code>14 пт</code> с индексами и спецсимволами:</div>
                <div class="bg-white text-dark p-2 border mt-1">${activeData.sampleHtml}</div>`;
        } else if (stageNum === 4) {
            draft = '<table style="width:100%; border-collapse:collapse;"><thead><tr><th style="border:1px solid #000; padding:6px;">Заголовок 1</th><th style="border:1px solid #000; padding:6px;">Заголовок 2</th><th style="border:1px solid #000; padding:6px;">Заголовок 3</th></tr></thead><tbody><tr><td style="border:1px solid #000; padding:6px;">Ячейка 1,1</td><td style="border:1px solid #000; padding:6px;">Ячейка 1,2</td><td style="border:1px solid #000; padding:6px;">Ячейка 1,3</td></tr></tbody></table>';
            if (title) title.innerText = 'Конструирование таблицы: объединение ячеек и вертикальное выравнивание';
            if (instr) instr.innerHTML = `
                <div class="fw-bold text-warning mb-1">Этап 4: Настройте сложную шапку таблицы (используйте контекстную панель «Таблица»):</div>
                <ul class="mb-0 ps-3">
                    <li>Выделите первую ячейку шапки и нажмите <strong>Объединить ячейки</strong> (чтобы первые 2 столбца слились в один с текстом <code>${activeData.mergedHeader}</code>), в третий столбец шапки впишите <code>${activeData.col3Header}</code>;</li>
                    <li>Заполните строку данных значениями: <code>${activeData.c1}</code> | <code>${activeData.c2}</code> | <code>${activeData.c3}</code>;</li>
                    <li>Отцентрируйте таблицу на странице и установите вертикальное выравнивание всех ячеек <strong>По середине</strong>.</li>
                </ul>`;
        } else {
            if (title) title.innerText = 'Финальная сдача документа по стандарту ОГЭ 13.2 (2/2 баллов)';
            if (instr) instr.innerHTML = `
                <div class="fw-bold text-warning mb-1">Этап 5: Создайте документ строго по стандарту ОГЭ 13.2:</div>
                <div class="bg-white text-dark p-2 border mb-1">
                    <div class="mb-1"><strong>Абзац (Liberation Serif, 14 пт, красная строка 1.0 см, По ширине, поля 2.0 см):</strong></div>
                    <div><b>${activeData.boldWord}</b>${activeData.paraText.slice(activeData.boldWord.length)}</div>
                </div>
                <div class="small text-info">Ниже добавьте таблицу 2×2 (<code>${activeData.h1}</code> / <code>${activeData.h2}</code> и <code>${activeData.c1}</code> / <code>${activeData.c2}</code>), отцентрированную на листе.</div>`;
        }

        if (window.resetWriterState) {
            window.resetWriterState(draft, false, true);
        }
        renderChecklist();
    }

    function initWhenWriterReady() {
        if (window.resetWriterState && document.querySelector('.jodit-wysiwyg')) {
            loadStage(1);
        } else {
            setTimeout(initWhenWriterReady, 30);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWhenWriterReady);
    } else {
        initWhenWriterReady();
    }

    document.addEventListener('writer-change', (e) => {
        if (!isCompleted) renderChecklist(e.detail);
    });

    document.addEventListener('writer-check', (e) => {
        if (isCompleted) return;
        telemetry.markActivity();
        const checks = evaluateStageChecks(e.detail);
        const failed = checks.filter(c => !c.passed);

        if (failed.length > 0) {
            const msg = `Не выполнены требования: ${failed.map(f => f.label).join('; ')}`;
            telemetry.hardcoreReset({ stage: currentStage });
            const attEl = document.getElementById('attempts-display');
            if (attEl) attEl.innerText = String(telemetry.getState().attemptsCount);
            const fbBox = document.getElementById('feedback-box');
            const fbText = document.getElementById('feedback-text');
            if (fbText) fbText.innerText = msg;
            if (fbBox) fbBox.classList.remove('d-none');
            e.detail.resolve(false, `❌ ${msg}`, false);
            setTimeout(() => {
                if (fbBox) fbBox.classList.add('d-none');
            }, 2500);
            return;
        }

        if (currentStage < 5) {
            e.detail.resolve(true, `✅ Этап ${currentStage} из 5 выполнен!`, false);
            currentStage++;
            telemetry.advanceStage(currentStage);
            setTimeout(() => loadStage(currentStage), 350);
        } else {
            isCompleted = true;
            e.detail.resolve(true, '🏆 Уровень 2 успешно пройден!', true);
            telemetry.complete({ stage: 5 });
            document.getElementById('success-screen')?.classList.remove('d-none');
        }
    });

    window.getLevel2WriterState = () => ({
        currentStage,
        activeData,
        isCompleted,
        attempts: telemetry.getState().attemptsCount
    });
    window.jumpToLevel2Stage = (n) => {
        if (n >= 1 && n <= 5) loadStage(n);
    };
})();
</script>
