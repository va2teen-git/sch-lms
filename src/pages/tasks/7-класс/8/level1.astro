    let p1SelectedCard = null;
    let p1ActiveItems = [];
    let p1Placements = {}; // cardId -> bucketName ('legit', 'spam', 'threat')

    function initPhase1() {
        const poolEl = document.getElementById('p1-cards-pool');
        const verifyBtn = document.getElementById('btn-phase1');
        const counterEl = document.getElementById('p1-pool-counter');
        if (!poolEl) return;

        p1SelectedCard = null;
        p1Placements = {};
        verifyBtn.disabled = true;

        // Очищаем дропзоны
        document.querySelectorAll('.p1-dropzone').forEach(dz => {
            const slots = dz.querySelector('.bucket-slots');
            const badge = dz.querySelector('.count-badge');
            if (slots) slots.innerHTML = '';
            if (badge) badge.textContent = '0';
        });

        // Формируем сбалансированный набор из 6 карточек: 2 legit, 2 spam, 2 threat
        const selLegit = shuffle(P1_CORRESPONDENCE_BANK.legit).slice(0, 2);
        const selSpam = shuffle(P1_CORRESPONDENCE_BANK.spam).slice(0, 2);
        const selThreat = shuffle(P1_CORRESPONDENCE_BANK.threat).slice(0, 2);
        p1ActiveItems = shuffle([...selLegit, ...selSpam, ...selThreat]);

        poolEl.innerHTML = '';
        p1ActiveItems.forEach(item => {
            const cardEl = createP1CardElement(item);
            poolEl.appendChild(cardEl);
        });

        if (counterEl) counterEl.textContent = `Осталось распределить: ${p1ActiveItems.length}`;
    }

    function createP1CardElement(item) {
        const div = document.createElement('div');
        div.className = 'card bg-black border border-secondary p-2 p1-card user-select-none';
        div.style.cursor = 'grab';
        div.style.maxWidth = '360px';
        div.style.minWidth = '240px';
        div.style.flex = '1 1 240px';
        div.draggable = true;
        div.dataset.id = item.id;
        div.dataset.type = item.type;

        div.innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="badge bg-secondary text-dark rounded-0 font-monospace" style="font-size: 0.65rem;">${item.tag}</span>
                <span class="text-secondary small font-monospace">ВХОДЯЩЕЕ</span>
            </div>
            <div class="small text-success font-monospace text-truncate fw-bold mb-1" title="${item.sender}">
                От: ${item.sender}
            </div>
            <div class="small text-light fw-bold mb-1 text-truncate" title="${item.subject}">
                ${item.subject}
            </div>
            <div class="text-secondary small" style="font-size: 0.75rem; line-height: 1.2;">
                ${item.preview}
            </div>
        `;

        // События Drag and Drop
        div.addEventListener('dragstart', (e) => {
            div.style.cursor = 'grabbing';
            e.dataTransfer.setData('text/plain', item.id);
        });

        div.addEventListener('dragend', () => {
            div.style.cursor = 'grab';
        });

        // Событие клика для мобильных устройств / мыши
        div.addEventListener('click', (e) => {
            e.stopPropagation();
            // Если уже выбрана ДРУГАЯ карточка из пула, а кликнули по карточке в корзине:
            const parentDropzone = div.closest('.p1-dropzone');
            if (p1SelectedCard && p1SelectedCard !== div && parentDropzone) {
                const targetBucket = parentDropzone.dataset.bucket;
                const targetSlots = parentDropzone.querySelector('.bucket-slots');
                if (targetSlots) {
                    moveCardToBucket(p1SelectedCard, targetBucket, targetSlots);
                    p1SelectedCard.classList.remove('border-primary', 'bg-dark');
                    p1SelectedCard = null;
                    return;
                }
            }

            document.querySelectorAll('.p1-card').forEach(c => c.classList.remove('border-primary', 'bg-dark'));
            if (p1SelectedCard === div) {
                p1SelectedCard = null;
            } else {
                p1SelectedCard = div;
                div.classList.add('border-primary', 'bg-dark');
            }
        });

        return div;
    }

    // Настройка дропзон для Фазы 1
    document.querySelectorAll('.p1-dropzone').forEach(dropzone => {
        const bucket = dropzone.dataset.bucket;
        const slots = dropzone.querySelector('.bucket-slots');

        dropzone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropzone.classList.add('bg-black');
        });

        dropzone.addEventListener('dragleave', () => {
            dropzone.classList.remove('bg-black');
        });

        dropzone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropzone.classList.remove('bg-black');
            const cardId = e.dataTransfer.getData('text/plain');
            const cardEl = document.querySelector(`.p1-card[data-id="${cardId}"]`);
            if (cardEl && slots) {
                moveCardToBucket(cardEl, bucket, slots);
            }
        });

        // Клик по дропзоне (если карточка была выбрана кликом)
        dropzone.addEventListener('click', () => {
            if (p1SelectedCard && slots) {
                moveCardToBucket(p1SelectedCard, bucket, slots);
                p1SelectedCard.classList.remove('border-primary', 'bg-dark');
                p1SelectedCard = null;
            }
        });
    });

    // Возможность вернуть карточку обратно в пул
    const p1PoolEl = document.getElementById('p1-cards-pool');
    if (p1PoolEl) {
        p1PoolEl.addEventListener('dragover', (e) => e.preventDefault());
        p1PoolEl.addEventListener('drop', (e) => {
            e.preventDefault();
            const cardId = e.dataTransfer.getData('text/plain');
            const cardEl = document.querySelector(`.p1-card[data-id="${cardId}"]`);
            if (cardEl) {
                delete p1Placements[cardId];
                p1PoolEl.appendChild(cardEl);
                updateP1Counts();
            }
        });
        p1PoolEl.addEventListener('click', () => {
            if (p1SelectedCard) {
                delete p1Placements[p1SelectedCard.dataset.id];
                p1PoolEl.appendChild(p1SelectedCard);
                p1SelectedCard.classList.remove('border-primary', 'bg-dark');
                p1SelectedCard = null;
                updateP1Counts();
            }
        });
    }

    function moveCardToBucket(cardEl, bucket, slotsContainer) {
        slotsContainer.appendChild(cardEl);
        p1Placements[cardEl.dataset.id] = bucket;
        cardEl.classList.remove('border-primary', 'bg-dark');
        updateP1Counts();
    }

    function updateP1Counts() {
        let placedCount = 0;
        document.querySelectorAll('.p1-dropzone').forEach(dz => {
            const bucket = dz.dataset.bucket;
            const badge = dz.querySelector('.count-badge');
            const inBucket = Object.values(p1Placements).filter(b => b === bucket).length;
            if (badge) badge.textContent = inBucket;
            placedCount += inBucket;
        });

        const poolRemain = p1ActiveItems.length - placedCount;
        const counterEl = document.getElementById('p1-pool-counter');
        if (counterEl) {
            counterEl.textContent = poolRemain > 0 ? `Осталось распределить: ${poolRemain}` : 'Все сообщения распределены!';
        }

        const verifyBtn = document.getElementById('btn-phase1');
        if (verifyBtn) {
            verifyBtn.disabled = (placedCount < p1ActiveItems.length);
        }
    }

    document.getElementById('btn-phase1').addEventListener('click', () => {
        let isCorrect = true;
        let incorrectReason = '';

        p1ActiveItems.forEach(item => {
            const placedBucket = p1Placements[item.id];
            if (placedBucket !== item.type) {
                isCorrect = false;
                if (item.type === 'threat') {
                    incorrectReason = 'ОПАСНОСТЬ: Вредоносное или фишинговое письмо не было направлено в шлюз киберугроз!';
                } else if (item.type === 'spam') {
                    incorrectReason = 'ОШИБКА: Спам или эмоциональный флуд пропущены мимо шлюза фильтрации спама!';
                } else if (item.type === 'legit') {
                    incorrectReason = 'ОШИБКА: Важное официальное или учебное письмо было ошибочно заблокировано!';
                }
            }
        });

        if (isCorrect) {
            document.getElementById('phase1').classList.add('d-none');
            document.getElementById('phase2').classList.remove('d-none');
            document.getElementById('phase-badge').textContent = 'Шаг 2 из 3';
            initPhase2();
        } else {
            triggerError(incorrectReason || 'ОШИБКА МАРШРУТИЗАЦИИ: Некоторые сообщения распределены неверно!', () => {
                initPhase1();
            });
        }
    });

    // =========================================================================
    // БАНК ДАННЫХ ДЛЯ ФАЗЫ 2: Конструирование безопасного письма (Slot & Snap)
    // =========================================================================
    const P2_SCENARIOS = [
        {
            title: 'Деловое обращение к учителю информатики по контрольной работе',
            prompt: 'Соберите корректное официальное электронное письмо учителю с вопросом по заданию контрольной работы. Прикрепите решение в безопасном формате pdf.',
            expected: {
                recipient: 'teacher.ivanov@school-center.edu.ru',
                subject: 'Тема: Вопрос по контрольной работе №2 — Смирнов Алексей, 7 «А»',
                greeting: 'Здравствуйте, уважаемый Алексей Викторович!',
                body: 'Направляю выполненное практическое задание во вложении solution.pdf. Подскажите, пожалуйста, все ли требования соблюдены?',
                signature: 'С уважением, Алексей Смирнов, ученик 7 «А» класса.'
            },
            distractors: [
                { id: 'p2d_1', text: 'alexeii_hacker_2012@dark-net.xyz', label: 'Неподобающий почтовый ящик' },
                { id: 'p2d_2', text: 'Тема: СРОЧНО ПРОВЕРЬТЕ МОЮ РАБОТУУУУУУ!!!!!', label: 'Капслок и спам-заголовок' },
                { id: 'p2d_3', text: 'Здарова, бро! Глянь чо я сделал', label: 'Фамильярный сленг' },
                { id: 'p2d_4', text: 'Всё решение упаковал в архив setup_run.exe.zip, запустите его!', label: 'Опасный исполняемый файл' },
                { id: 'p2d_5', text: 'Ладно, давай, пока!', label: 'Неделовое прощание' }
            ]
        },
        {
            title: 'Заявка в оргкомитет школьной олимпиады по информатике',
            prompt: 'Соберите официальное письмо для регистрации на олимпиаду. Укажите тему, вежливое приветствие, суть заявки с анкетой docx и корректную подпись.',
            expected: {
                recipient: 'olymp_committee@city-education.ru',
                subject: 'Тема: Заявка на олимпиаду по информатике — Васильева Дарья, 7 «Б»',
                greeting: 'Добрый день, уважаемый оргкомитет олимпиады!',
                body: 'Прошу зарегистрировать меня для участия в отборочном туре. Заполненная анкета участника прикреплена в файле form.docx.',
                signature: 'С уважением, Дарья Васильева, ученица 7 «Б» класса, школа №14.'
            },
            distractors: [
                { id: 'p2d_6', text: 'dasha_super_princess@spam-box.cc', label: 'Неофициальный почтовый адрес' },
                { id: 'p2d_7', text: 'Тема: (Без темы)', label: 'Нарушение этикета (пустая тема)' },
                { id: 'p2d_8', text: 'Эй, запишите меня быстро!', label: 'Грубое требование' },
                { id: 'p2d_9', text: 'Пришлите мне готовые ответы на олимпиаду за вознаграждение.', label: 'Нарушение правил конкурса' },
                { id: 'p2d_10', text: 'Чмоки, жду ответ через минуту!', label: 'Неформальное прощание' }
            ]
        },
        {
            title: 'Обращение в службу техподдержки образовательной платформы',
            prompt: 'Соберите корректное обращение в службу поддержки в связи с технической ошибкой авторизации. Соблюдайте деловой стиль и правила защиты паролей.',
            expected: {
                recipient: 'support@school-lms-help.ru',
                subject: 'Тема: Восстановление доступа к личному кабинету — Николаев Егор, 7 «В»',
                greeting: 'Здравствуйте, служба технической поддержки!',
                body: 'При авторизации в дневнике возникает ошибка таймаута. Скриншот экрана с системным сообщением прикреплен в файле error_screen.png.',
                signature: 'С уважением, Егор Николаев, логин в системе: nikolaev_e7.'
            },
            distractors: [
                { id: 'p2d_11', text: 'root_admin_unlimited@black-hat.su', label: 'Подозрительный домен' },
                { id: 'p2d_12', text: 'Тема: ВЕРНИТЕ МНЕ МОЙ САЙТ НЕ РАБОТАЕТ НИЧЕГООО', label: 'Эмоциональный крик капслоком' },
                { id: 'p2d_13', text: 'Хей, почините сайт сейчас же!', label: 'Невежливое обращение' },
                { id: 'p2d_14', text: 'Вот мой секретный пароль от Госуслуг: 12345678, зайдите и проверьте сами.', label: 'Разглашение пароля' },
                { id: 'p2d_15', text: 'До связи, ответьте прямо щас!', label: 'Разговорный сленг' }
            ]
        }
    ];

    const P2_SLOT_DEFS = [
        { key: 'recipient', label: 'ПОЛЕ 1 [Кому — официальный адрес]:', placeholder: 'Перетащите адрес получателя...' },
        { key: 'subject', label: 'ПОЛЕ 2 [Тема — четкий заголовок письма]:', placeholder: 'Перетащите тему письма...' },
        { key: 'greeting', label: 'ПОЛЕ 3 [Приветствие и вежливое обращение]:', placeholder: 'Перетащите обращение...' },
        { key: 'body', label: 'ПОЛЕ 4 [Тело письма — суть вопроса и безопасное вложение]:', placeholder: 'Перетащите тело письма...' },
        { key: 'signature', label: 'ПОЛЕ 5 [Подпись и контакты автора]:', placeholder: 'Перетащите подпись...' }
    ];

    let p2CurrentScenario = null;
    let p2SelectedToken = null;
    let p2SlotAssignments = {}; // slotKey -> tokenObj

    function initPhase2() {
        const promptEl = document.getElementById('p2-mission-prompt');
        const paletteEl = document.getElementById('p2-tokens-palette');
        const slotsCol = document.getElementById('p2-slots-col');
        const verifyBtn = document.getElementById('btn-phase2');
        if (!paletteEl || !slotsCol) return;

        p2SelectedToken = null;
        p2SlotAssignments = {};
        verifyBtn.disabled = true;

        // Выбираем случайный сценарий
        p2CurrentScenario = shuffle(P2_SCENARIOS)[0];
        if (promptEl) {
            promptEl.textContent = `${p2CurrentScenario.title}. ${p2CurrentScenario.prompt}`;
        }

        // Формируем токены: 5 правильных + 3 случайных дистрактора (всего 8 токенов)
        const correctTokens = Object.entries(p2CurrentScenario.expected).map(([key, text]) => ({
            id: `p2c_${key}`,
            key: key,
            text: text,
            isCorrect: true
        }));
        const selectedDistractors = shuffle(p2CurrentScenario.distractors).slice(0, 3).map(d => ({
            id: d.id,
            key: null,
            text: d.text,
            isCorrect: false
        }));

        const allTokens = shuffle([...correctTokens, ...selectedDistractors]);

        // Рендерим палитру токенов
        paletteEl.innerHTML = '';
        allTokens.forEach(t => {
            const tokenEl = createP2TokenElement(t);
            paletteEl.appendChild(tokenEl);
        });

        // Рендерим слоты
        slotsCol.innerHTML = '';
        P2_SLOT_DEFS.forEach(slotDef => {
            const slotCard = document.createElement('div');
            slotCard.className = 'card bg-dark border border-secondary rounded-0 p-2 p2-slot-card';
            slotCard.dataset.slotKey = slotDef.key;
            slotCard.style.cursor = 'pointer';

            slotCard.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-secondary small fw-bold font-monospace">${slotDef.label}</span>
                    <span class="badge bg-secondary text-dark rounded-0 font-monospace slot-status">ПУСТО</span>
                </div>
                <div class="slot-target p-2 bg-black border border-secondary text-secondary small font-monospace d-flex justify-content-between align-items-center" style="min-height: 42px;">
                    <span class="slot-content">${slotDef.placeholder}</span>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-0 d-none btn-clear-slot py-0 px-2 font-monospace" style="font-size: 0.75rem;">✕</button>
                </div>
            `;

            // Drag and drop для слота
            slotCard.addEventListener('dragover', (e) => e.preventDefault());
            slotCard.addEventListener('drop', (e) => {
                e.preventDefault();
                const tokenId = e.dataTransfer.getData('text/plain');
                const tokenEl = document.querySelector(`.p2-token[data-id="${tokenId}"]`);
                if (tokenEl) {
                    const tokenData = allTokens.find(t => t.id === tokenId);
                    placeTokenInSlot(tokenData, tokenEl, slotDef.key, slotCard);
                }
            });

            // Клик для размещения выбранного токена
            slotCard.addEventListener('click', () => {
                if (p2SelectedToken) {
                    const tokenId = p2SelectedToken.dataset.id;
                    const tokenData = allTokens.find(t => t.id === tokenId);
                    placeTokenInSlot(tokenData, p2SelectedToken, slotDef.key, slotCard);
                    p2SelectedToken.classList.remove('border-warning', 'bg-dark');
                    p2SelectedToken = null;
                }
            });

            // Кнопка очистки слота
            const clearBtn = slotCard.querySelector('.btn-clear-slot');
            clearBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                removeTokenFromSlot(slotDef.key, slotCard, paletteEl);
            });

            slotsCol.appendChild(slotCard);
        });

        updateP2State();
    }

    function createP2TokenElement(tokenObj) {
        const div = document.createElement('div');
        div.className = 'badge bg-black border border-success text-success p-2 rounded-0 p2-token user-select-none text-wrap text-start';
        div.style.cursor = 'grab';
        div.style.fontSize = '0.85rem';
        div.style.lineHeight = '1.2';
        div.style.maxWidth = '100%';
        div.draggable = true;
        div.dataset.id = tokenObj.id;
        div.textContent = tokenObj.text;

        div.addEventListener('dragstart', (e) => {
            div.style.cursor = 'grabbing';
            e.dataTransfer.setData('text/plain', tokenObj.id);
        });
        div.addEventListener('dragend', () => {
            div.style.cursor = 'grab';
        });

        div.addEventListener('click', (e) => {
            e.stopPropagation();
            document.querySelectorAll('.p2-token').forEach(t => t.classList.remove('border-warning', 'bg-dark'));
            if (p2SelectedToken === div) {
                p2SelectedToken = null;
            } else {
                p2SelectedToken = div;
                div.classList.add('border-warning', 'bg-dark');
            }
        });

        return div;
    }

    function placeTokenInSlot(tokenData, tokenEl, slotKey, slotCard) {
        // Если в этом слоте уже лежал токен — вернем его в палитру
        if (p2SlotAssignments[slotKey]) {
            const oldToken = p2SlotAssignments[slotKey];
            const oldTokenEl = createP2TokenElement(oldToken);
            document.getElementById('p2-tokens-palette').appendChild(oldTokenEl);
        }

        // Если этот токен уже лежал в другом слоте — очистим тот слот
        for (const [sKey, tObj] of Object.entries(p2SlotAssignments)) {
            if (tObj.id === tokenData.id) {
                const otherSlotCard = document.querySelector(`.p2-slot-card[data-slot-key="${sKey}"]`);
                if (otherSlotCard) {
                    resetSlotUI(sKey, otherSlotCard);
                }
                delete p2SlotAssignments[sKey];
            }
        }

        p2SlotAssignments[slotKey] = tokenData;
        tokenEl.remove();

        // Обновляем визуал слота
        const contentEl = slotCard.querySelector('.slot-content');
        const statusEl = slotCard.querySelector('.slot-status');
        const clearBtn = slotCard.querySelector('.btn-clear-slot');

        contentEl.textContent = tokenData.text;
        contentEl.className = 'slot-content text-success fw-bold';
        slotCard.className = 'card bg-dark border border-success rounded-0 p-2 p2-slot-card';
        statusEl.className = 'badge bg-success text-dark rounded-0 font-monospace slot-status';
        statusEl.textContent = 'ЗАПОЛНЕНО';
        clearBtn.classList.remove('d-none');

        updateP2State();
    }

    function removeTokenFromSlot(slotKey, slotCard, paletteEl) {
        const tokenData = p2SlotAssignments[slotKey];
        if (!tokenData) return;

        delete p2SlotAssignments[slotKey];
        resetSlotUI(slotKey, slotCard);

        const newEl = createP2TokenElement(tokenData);
        paletteEl.appendChild(newEl);
        updateP2State();
    }

    function resetSlotUI(slotKey, slotCard) {
        const slotDef = P2_SLOT_DEFS.find(d => d.key === slotKey);
        const contentEl = slotCard.querySelector('.slot-content');
        const statusEl = slotCard.querySelector('.slot-status');
        const clearBtn = slotCard.querySelector('.btn-clear-slot');

        contentEl.textContent = slotDef ? slotDef.placeholder : 'Пусто';
        contentEl.className = 'slot-content text-secondary';
        slotCard.className = 'card bg-dark border border-secondary rounded-0 p-2 p2-slot-card';
        statusEl.className = 'badge bg-secondary text-dark rounded-0 font-monospace slot-status';
        statusEl.textContent = 'ПУСТО';
        clearBtn.classList.add('d-none');
    }

    function updateP2State() {
        const previewEl = document.getElementById('p2-letter-preview');
        const verifyBtn = document.getElementById('btn-phase2');

        const r = p2SlotAssignments['recipient']?.text || '[Кому: не указано]';
        const s = p2SlotAssignments['subject']?.text || '[Тема: не указана]';
        const g = p2SlotAssignments['greeting']?.text || '[Приветствие: не указано]';
        const b = p2SlotAssignments['body']?.text || '[Текст письма: не заполнен]';
        const sign = p2SlotAssignments['signature']?.text || '[Подпись: не указана]';

        previewEl.textContent = `Кому: ${r}\n${s}\n\n${g}\n${b}\n\n${sign}`;

        const isAllFilled = P2_SLOT_DEFS.every(def => p2SlotAssignments[def.key]);
        verifyBtn.disabled = !isAllFilled;
    }

    document.getElementById('btn-phase2').addEventListener('click', () => {
        let isCorrect = true;
        let incorrectSlotName = '';

        P2_SLOT_DEFS.forEach(def => {
            const assigned = p2SlotAssignments[def.key];
            const expectedText = p2CurrentScenario.expected[def.key];
            if (!assigned || assigned.text !== expectedText) {
                isCorrect = false;
                if (!incorrectSlotName) incorrectSlotName = def.label;
            }
        });

        if (isCorrect) {
            document.getElementById('phase2').classList.add('d-none');
            document.getElementById('phase3').classList.remove('d-none');
            document.getElementById('phase-badge').textContent = 'Шаг 3 из 3';
            initPhase3();
        } else {
            triggerError(`ОШИБКА СЕТЕВОГО ЭТИКЕТА: Неверно подобран элемент для ${incorrectSlotName}! Исключите сленг, капслок и опасные вложения.`, () => {
                initPhase2();
            });
        }
    });

    // =========================================================================
    // БАНК ДАННЫХ ДЛЯ ФАЗЫ 3: Коммутация протоколов (Node Linking)
    // =========================================================================
    const P3_SOURCES_DATA = [
        {
            id: 'src_smtps',
            label: '1. Защищенная отправка почты (SMTPS)',
            role: 'Шифрование исходящих сообщений с локального клиента на почтовый сервер',
            correctTarget: 'tgt_465'
        },
        {
            id: 'src_pop3s',
            label: '2. Защищенное скачивание писем на 1 ПК (POP3S)',
            role: 'Загрузка корреспонденции в почтовую программу по криптографическому порту',
            correctTarget: 'tgt_995'
        },
        {
            id: 'src_imaps',
            label: '3. Защищенная синхронизация почты (IMAPS)',
            role: 'Работа с письмами на сервере с нескольких мобильных устройств и ПК',
            correctTarget: 'tgt_993'
        },
        {
            id: 'src_wifi',
            label: '4. Защита трафика в открытом общественном Wi-Fi',
            role: 'Предотвращение перехвата паролей и cookie снифферами злоумышленников',
            correctTarget: 'tgt_vpn'
        }
    ];

    const P3_TARGETS_DATA = [
        {
            id: 'tgt_465',
            title: 'Порт 465 (SMTPS)',
            desc: 'Стандарт безопасной передачи почты по защищенному каналу SSL/TLS'
        },
        {
            id: 'tgt_995',
            title: 'Порт 995 (POP3S)',
            desc: 'Криптографический порт для безопасной доставки писем по протоколу POP3'
        },
        {
            id: 'tgt_993',
            title: 'Порт 993 (IMAPS)',
            desc: 'Защищенный порт двусторонней синхронизации почтовых ящиков по протоколу IMAP'
        },
        {
            id: 'tgt_vpn',
            title: 'Туннель VPN / Протокол HTTPS',
            desc: 'Сквозное криптографическое шифрование всех сетевых пакетов клиента'
        },
        // Дистракторы
        {
            id: 'tgt_dist_25',
            title: 'Порт 25 (Открытый SMTP)',
            desc: '[УЯЗВИМОСТЬ] Передача исходящих сообщений в открытом незашифрованном виде'
        },
        {
            id: 'tgt_dist_110',
            title: 'Порт 110 (Открытый POP3)',
            desc: '[УЯЗВИМОСТЬ] Авторизация и загрузка писем без шифрования трафика'
        },
        {
            id: 'tgt_dist_http',
            title: 'Открытый HTTP без шифрования',
            desc: '[УЯЗВИМОСТЬ] Передача данных открытым текстом, доступная для перехвата сниффером'
        }
    ];

    const P3_CABLE_STYLES = [
        { border: 'border-success', badge: 'bg-success text-dark', name: 'Кабель 1 (Зеленый)' },
        { border: 'border-info', badge: 'bg-info text-dark', name: 'Кабель 2 (Голубой)' },
        { border: 'border-warning', badge: 'bg-warning text-dark', name: 'Кабель 3 (Желтый)' },
        { border: 'border-primary', badge: 'bg-primary text-light', name: 'Кабель 4 (Синий)' }
    ];

    let p3ActiveSource = null;
    let p3Connections = {}; // sourceId -> targetId

    function initPhase3() {
        const srcCol = document.getElementById('p3-sources');
        const tgtCol = document.getElementById('p3-targets');
        if (!srcCol || !tgtCol) return;

        srcCol.innerHTML = '';
        tgtCol.innerHTML = '';
        p3ActiveSource = null;
        p3Connections = {};

        // Источники
        P3_SOURCES_DATA.forEach((s, idx) => {
            const item = document.createElement('div');
            item.className = 'card bg-dark border border-secondary p-2 p3-source-node user-select-none';
            item.style.cursor = 'pointer';
            item.dataset.sourceId = s.id;
            item.dataset.cableIdx = idx;

            item.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-light fw-bold small">${s.label}</span>
                    <span class="badge bg-secondary text-dark rounded-0 font-monospace connection-badge" style="font-size: 0.7rem;">ОТКЛЮЧЕНО</span>
                </div>
                <div class="text-secondary small connection-status" style="font-size: 0.75rem;">${s.role}</div>
            `;

            item.addEventListener('click', () => {
                document.querySelectorAll('.p3-source-node').forEach(el => el.classList.remove('border-primary', 'bg-black'));
                if (p3ActiveSource === s.id) {
                    p3ActiveSource = null;
                } else {
                    p3ActiveSource = s.id;
                    item.classList.add('border-primary', 'bg-black');
                }
            });

            srcCol.appendChild(item);
        });

        // Приемники с дистракторами (перемешиваем)
        const shuffledTargets = shuffle(P3_TARGETS_DATA);
        shuffledTargets.forEach(t => {
            const item = document.createElement('div');
            item.className = 'card bg-dark border border-secondary p-2 p3-target-node user-select-none';
            item.style.cursor = 'pointer';
            item.dataset.targetId = t.id;

            item.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-light fw-bold small">${t.title}</span>
                    <span class="badge bg-secondary text-dark rounded-0 font-monospace target-badge" style="font-size: 0.7rem;">СВОБОДЕН</span>
                </div>
                <div class="text-secondary small target-status" style="font-size: 0.75rem;">${t.desc}</div>
            `;

            item.addEventListener('click', () => {
                if (!p3ActiveSource) return;

                // Если данный целевой узел уже занят другим источником — сбросим старое соединение
                for (const [src, tgt] of Object.entries(p3Connections)) {
                    if (tgt === t.id) delete p3Connections[src];
                }

                p3Connections[p3ActiveSource] = t.id;
                p3ActiveSource = null;
                document.querySelectorAll('.p3-source-node').forEach(el => el.classList.remove('border-primary', 'bg-black'));
                updateP3Visuals();
            });

            tgtCol.appendChild(item);
        });

        updateP3Visuals();
    }

    function updateP3Visuals() {
        // Обновляем визуальное состояние источников
        P3_SOURCES_DATA.forEach((s, idx) => {
            const sEl = document.querySelector(`.p3-source-node[data-source-id="${s.id}"]`);
            if (!sEl) return;

            const targetId = p3Connections[s.id];
            const badgeEl = sEl.querySelector('.connection-badge');
            const cableStyle = P3_CABLE_STYLES[idx];

            if (targetId) {
                const targetObj = P3_TARGETS_DATA.find(t => t.id === targetId);
                sEl.className = `card bg-dark border ${cableStyle.border} p-2 p3-source-node user-select-none`;
                if (badgeEl) {
                    badgeEl.className = `badge rounded-0 ${cableStyle.badge} font-monospace connection-badge`;
                    badgeEl.textContent = `СВЯЗЬ: ${targetObj ? targetObj.title.split(' ')[0] : 'OK'}`;
                }
            } else {
                sEl.className = 'card bg-dark border border-secondary p-2 p3-source-node user-select-none';
                if (badgeEl) {
                    badgeEl.className = 'badge bg-secondary text-dark rounded-0 font-monospace connection-badge';
                    badgeEl.textContent = 'ОТКЛЮЧЕНО';
                }
            }
        });

        // Обновляем визуальное состояние приемников
        P3_TARGETS_DATA.forEach(t => {
            const tEl = document.querySelector(`.p3-target-node[data-target-id="${t.id}"]`);
            if (!tEl) return;

            // Находим какой источник подключен к этому приемнику
            const connectedSourceId = Object.keys(p3Connections).find(src => p3Connections[src] === t.id);
            const badgeEl = tEl.querySelector('.target-badge');

            if (connectedSourceId) {
                const srcIdx = P3_SOURCES_DATA.findIndex(s => s.id === connectedSourceId);
                const cableStyle = P3_CABLE_STYLES[srcIdx] || P3_CABLE_STYLES[0];
                tEl.className = `card bg-dark border ${cableStyle.border} p-2 p3-target-node user-select-none`;
                if (badgeEl) {
                    badgeEl.className = `badge rounded-0 ${cableStyle.badge} font-monospace target-badge`;
                    badgeEl.textContent = `ПОДКЛЮЧЕН (${srcIdx + 1})`;
                }
            } else {
                tEl.className = 'card bg-dark border border-secondary p-2 p3-target-node user-select-none';
                if (badgeEl) {
                    badgeEl.className = 'badge bg-secondary text-dark rounded-0 font-monospace target-badge';
                    badgeEl.textContent = 'СВОБОДЕН';
                }
            }
        });
    }

    document.getElementById('btn-phase3').addEventListener('click', () => {
        let isAllCorrect = true;
        let connectedCount = 0;

        P3_SOURCES_DATA.forEach(s => {
            if (p3Connections[s.id]) connectedCount++;
            if (p3Connections[s.id] !== s.correctTarget) {
                isAllCorrect = false;
            }
        });

        if (connectedCount < P3_SOURCES_DATA.length) {
            triggerError('ОШИБКА КОММУТАЦИИ: Не все службы соединены с целевыми криптографическими стандартами!', () => {
                initPhase3();
            });
            return;
        }

        if (isAllCorrect) {
            document.getElementById('phase3').classList.add('d-none');
            document.getElementById('success-screen').classList.remove('d-none');
            document.getElementById('phase-badge').className = 'badge bg-success text-dark border border-success rounded-0 px-3 py-2';
            document.getElementById('phase-badge').textContent = 'Уровень пройден!';
            sendTelemetry('level_complete', 'completed', true);
        } else {
            triggerError('ОШИБКА КОММУТАЦИИ: Нарушена криптографическая стойкость каналов! Не используйте уязвимые открытые порты без шифрования.', () => {
                initPhase3();
            });
        }
    });

    // =========================================================================
    // СТАРТ УРОВНЯ
    // =========================================================================
    initPhase1();
</script>
