---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
// Уровень 1 (Базовый)
// Тема: Контрольная работа: Сервисы интернет-коммуникаций. Сетевой этикет. Стратегии безопасного поведения в Интернете (7 класс)
---

<TaskLayout level={1} bodyClass="font-monospace m-0 p-0">
<div class="container-fluid min-vh-100 p-2 p-md-4 rounded-0 bg-dark text-success">
    <div class="row">
        <div class="col-12">
            <!-- Шапка уровня -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center border-bottom border-success pb-2 mb-3 gap-2">
                <div>
                    <h2 class="h5 text-success font-monospace mb-0 text-uppercase">ЦЕНТР КИБЕРГИГИЕНЫ И СЕТЕВОЙ БЕЗОПАСНОСТИ</h2>
                    <span class="small text-secondary">7 КЛАСС // УРОК 8: КОНТРОЛЬНАЯ РАБОТА (УРОВЕНЬ 1)</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span id="phase-badge" class="badge bg-black text-success border border-success rounded-0 px-3 py-2">Шаг 1 из 3</span>
                    <span class="badge border border-success text-success bg-black rounded-0 px-3 py-2">БАЗОВЫЙ РЕЖИМ</span>
                </div>
            </div>

            <!-- Блок системных ошибок -->
            <div id="error-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3" role="alert">
                <span class="fw-bold">[СИСТЕМНЫЙ СБОЙ]</span> <span id="error-message">Неверная конфигурация параметров безопасности!</span>
            </div>

            <!-- ========================================================================= -->
            <!-- ФАЗА 1: Классификация входящей корреспонденции (Drag-to-Bucket)            -->
            <!-- ========================================================================= -->
            <div id="phase1" class="card bg-black border-success rounded-0 mb-4">
                <div class="card-header bg-dark border-success text-success d-flex justify-content-between align-items-center rounded-0 py-2">
                    <span class="fw-bold">ФАЗА 1 ИЗ 3: Сортировка сетевого контента и входящих сообщений</span>
                    <span class="badge bg-success text-dark rounded-0">МЕХАНИКА: DRAG-TO-BUCKET</span>
                </div>
                <div class="card-body p-2 p-md-3">
                    <p class="text-light small mb-3">
                        На шлюз фильтрации поступили входящие электронные письма, системные уведомления и сообщения. Распределите карточки по трем целевым шлюзам (перетащите карточку мышью или кликните сначала по карточке, затем по нужному шлюзу).
                    </p>

                    <!-- Пул поступивших карточек -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-secondary small text-uppercase">Поступившая корреспонденция (требует распределения):</span>
                            <span id="p1-pool-counter" class="small text-success">Осталось: 6</span>
                        </div>
                        <div id="p1-cards-pool" class="d-flex flex-wrap gap-2 p-2 bg-dark border border-secondary" style="min-height: 90px;">
                            <!-- Карточки генерируются процедурно через JS -->
                        </div>
                    </div>

                    <!-- Целевые шлюзы фильтрации -->
                    <div class="row g-2 g-md-3 mb-3">
                        <!-- Шлюз 1: Легитимная корреспонденция -->
                        <div class="col-12 col-md-4">
                            <div class="card bg-dark border-success rounded-0 h-100 p-2 p1-dropzone" data-bucket="legit" style="cursor: pointer;">
                                <div class="border-bottom border-success pb-1 mb-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-success small">1. ЛЕГИТИМНЫЕ СООБЩЕНИЯ</span>
                                    <span class="badge bg-black text-success border border-success count-badge">0</span>
                                </div>
                                <div class="text-secondary small mb-2" style="font-size: 0.75rem;">
                                    Официальные уведомления от учителей, школ (.edu.ru), друзей без вредоносных ссылок и файлов.
                                </div>
                                <div class="bucket-slots d-flex flex-column gap-2 p-2 bg-black border border-secondary" style="min-height: 140px;">
                                    <!-- Размещенные карточки -->
                                </div>
                            </div>
                        </div>

                        <!-- Шлюз 2: Спам и деструктив -->
                        <div class="col-12 col-md-4">
                            <div class="card bg-dark border-warning rounded-0 h-100 p-2 p1-dropzone" data-bucket="spam" style="cursor: pointer;">
                                <div class="border-bottom border-warning pb-1 mb-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-warning small">2. СПАМ И ДЕСТРУКТИВ</span>
                                    <span class="badge bg-black text-warning border border-warning count-badge">0</span>
                                </div>
                                <div class="text-secondary small mb-2" style="font-size: 0.75rem;">
                                    Навязчивая реклама игр, эмоциональный капслок, флуд знаками, оверквотинг, троллинг и агрессия.
                                </div>
                                <div class="bucket-slots d-flex flex-column gap-2 p-2 bg-black border border-secondary" style="min-height: 140px;">
                                    <!-- Размещенные карточки -->
                                </div>
                            </div>
                        </div>

                        <!-- Шлюз 3: Киберугрозы и фишинг -->
                        <div class="col-12 col-md-4">
                            <div class="card bg-dark border-danger rounded-0 h-100 p-2 p1-dropzone" data-bucket="threat" style="cursor: pointer;">
                                <div class="border-bottom border-danger pb-1 mb-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-danger small">3. КИБЕРУГРОЗЫ И ФИШИНГ</span>
                                    <span class="badge bg-black text-danger border border-danger count-badge">0</span>
                                </div>
                                <div class="text-secondary small mb-2" style="font-size: 0.75rem;">
                                    Тайпосквоттинг ссылок, выманивание паролей и номеров карт родителей, опасные вложения (.exe, .scr).
                                </div>
                                <div class="bucket-slots d-flex flex-column gap-2 p-2 bg-black border border-secondary" style="min-height: 140px;">
                                    <!-- Размещенные карточки -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <button id="btn-phase1" class="btn btn-outline-success rounded-0 px-4 py-2 font-monospace" style="min-height: 48px;" disabled>
                        [ПРОВЕРИТЬ МАРШРУТИЗАЦИЮ КОРРЕСПОНДЕНЦИИ]
                    </button>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- ФАЗА 2: Конструирование безопасного письма (Slot & Snap)                   -->
            <!-- ========================================================================= -->
            <div id="phase2" class="card bg-black border-success rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-success text-success d-flex justify-content-between align-items-center rounded-0 py-2">
                    <span class="fw-bold">ФАЗА 2 ИЗ 3: Конструирование безопасного электронного письма</span>
                    <span class="badge bg-success text-dark rounded-0">МЕХАНИКА: SLOT & SNAP</span>
                </div>
                <div class="card-body p-2 p-md-3">
                    <div class="alert alert-dark bg-dark border-secondary text-light rounded-0 mb-3 p-2">
                        <div class="fw-bold text-success mb-1 small text-uppercase">ТЕКУЩАЯ МИССИЯ СЕТЕВОГО ЭТИКЕТА:</div>
                        <div id="p2-mission-prompt" class="small text-light">Загрузка задания...</div>
                    </div>

                    <p class="text-light small mb-3">
                        Соберите официальное электронное письмо в строгом соответствии с нормами сетевого этикета и кибербезопасности. Перетащите нужные токены в слоты (кликните по токену, затем по слоту). Отсеките разговорный сленг, спам-шаблоны и опасные вложения в палитре дистракторов!
                    </p>

                    <!-- Палитра токенов -->
                    <div class="mb-3">
                        <div class="text-secondary small mb-1 text-uppercase">Палитра доступных блоков (кликните для выбора):</div>
                        <div id="p2-tokens-palette" class="d-flex flex-wrap gap-2 p-2 bg-dark border border-secondary" style="min-height: 80px;">
                            <!-- Генерируется через JS -->
                        </div>
                    </div>

                    <!-- Целевые слоты структуры письма -->
                    <div class="mb-3">
                        <div class="text-secondary small mb-1 text-uppercase">Целевые слоты структуры письма (нажмите на слот для размещения токена):</div>
                        <div class="d-flex flex-column gap-2" id="p2-slots-col">
                            <!-- 5 слотов генерируются через JS -->
                        </div>
                    </div>

                    <!-- Предварительный просмотр письма -->
                    <div class="p-2 mb-3 bg-black border border-secondary text-secondary small">
                        <div class="text-success fw-bold mb-1 text-uppercase">ПРЕДВАРИТЕЛЬНЫЙ ПРОСМОТР СФОРМИРОВАННОГО ПИСЬМА:</div>
                        <div id="p2-letter-preview" class="font-monospace text-light p-2 bg-dark border border-secondary" style="white-space: pre-line;">-- Письмо не укомплектовано --</div>
                    </div>

                    <button id="btn-phase2" class="btn btn-outline-success rounded-0 px-4 py-2 font-monospace" style="min-height: 48px;" disabled>
                        [ОТПРАВИТЬ СФОРМИРОВАННОЕ ПИСЬМО]
                    </button>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- ФАЗА 3: Коммутация протоколов и уровней защиты (Node Linking)              -->
            <!-- ========================================================================= -->
            <div id="phase3" class="card bg-black border-success rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-success text-success d-flex justify-content-between align-items-center rounded-0 py-2">
                    <span class="fw-bold">ФАЗА 3 ИЗ 3: Интерактивная коммутация сетевых протоколов и стандартов шифрования</span>
                    <span class="badge bg-success text-dark rounded-0">МЕХАНИКА: NODE LINKING</span>
                </div>
                <div class="card-body p-2 p-md-3">
                    <p class="text-light small mb-3">
                        Соедините прикладные службы интернет-коммуникаций с их защищенными криптографическими портами и протоколами шифрования. Кликните сначала по службе слева, затем по целевому защищенному стандарту справа (в списке присутствуют открытые уязвимые порты-дистракторы!).
                    </p>

                    <!-- Блок коммутации: Источники слева, Цели справа -->
                    <div class="row g-3 mb-3">
                        <!-- Источники (Службы) -->
                        <div class="col-12 col-md-6">
                            <div class="text-secondary small mb-2 text-uppercase fw-bold">1. Прикладные службы интернет-коммуникаций:</div>
                            <div id="p3-sources" class="d-flex flex-column gap-2">
                                <!-- Генерируется через JS -->
                            </div>
                        </div>

                        <!-- Приемники (Порты и уровни защиты) -->
                        <div class="col-12 col-md-6">
                            <div class="text-secondary small mb-2 text-uppercase fw-bold">2. Стандарты шифрования и криптографические порты:</div>
                            <div id="p3-targets" class="d-flex flex-column gap-2">
                                <!-- Генерируется через JS -->
                            </div>
                        </div>
                    </div>

                    <button id="btn-phase3" class="btn btn-outline-success rounded-0 px-4 py-2 font-monospace" style="min-height: 48px;">
                        [АКТИВИРОВАТЬ ЗАЩИЩЕННУЮ МАТРИЦУ ПРОТОКОЛОВ]
                    </button>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- ЭКРАН УСПЕХА                                                              -->
            <!-- ========================================================================= -->
            <div id="success-screen" class="card bg-success text-black border-success rounded-0 mb-4 d-none">
                <div class="card-body text-center py-5">
                    <h1 class="display-6 fw-bold mb-3">АТТЕСТАЦИЯ БАЗОВОГО УРОВНЯ УСПЕШНО ПРОЙДЕНА!</h1>
                    <p class="lead mb-4">
                        Входящая корреспонденция отфильтрована, нормы сетевого этикета соблюдены, защищенные каналы связи коммутированы без уязвимостей.
                    </p>
                    <div class="badge bg-black text-success border border-black rounded-0 fs-6 px-4 py-2">
                        УРОВЕНЬ 1 ЗАВЕРШЕН // СТАТУС: SUCCESS // ТЕЛЕМЕТРИЯ ЗАФИКСИРОВАНА
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
</TaskLayout>

<script is:inline>
    // =========================================================================
    // ТЕЛЕМЕТРИЯ (Стандарты xAPI / IMS Caliper)
    // =========================================================================
    const startTime = new Date();
    let attempts = 0;
    const missionName = '7 класс :: Урок 8 :: Контрольная работа: Сервисы интернет-коммуникаций. Сетевой этикет. Стратегии безопасного поведения в Интернете (Уровень 1)';

    function sendTelemetry(action_type, status, success) {
        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: action_type,
            status: status,
            start_time: startTime.toISOString(),
            time_spent_sec: Math.floor((new Date() - startTime) / 1000),
            attempts_count: attempts,
            success: success
        }, '*');
    }

    sendTelemetry('in_progress', 'in_progress', false);

    function triggerError(message, retryCallback) {
        attempts++;
        const errorBox = document.getElementById('error-box');
        const errorMessage = document.getElementById('error-message');
        if (errorMessage) errorMessage.textContent = message;
        if (errorBox) errorBox.classList.remove('d-none');

        // Сигнал телеметрии об ошибке текущей попытки
        sendTelemetry('hardcore_reset', 'in_progress', false);

        setTimeout(() => {
            if (errorBox) errorBox.classList.add('d-none');
            if (retryCallback) retryCallback();
        }, 1500);
    }

    // Утилита детерминированного перемешивания
    function shuffle(array) {
        const arr = [...array];
        for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr;
    }

    // =========================================================================
    // БАНК ДАННЫХ ДЛЯ ФАЗЫ 1: Классификация контента (Drag-to-Bucket)
    // =========================================================================
