---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
// Уровень 3 (Аркада / «Финальный босс»): 7 класс, Урок 8 - Контрольная работа: Сервисы интернет-коммуникаций. Сетевой этикет. Стратегии безопасного поведения в Интернете
// Архетип 9: «Active Firewall Interceptor / Магистральный щит коммуникаций»
// Декларативный стек: Vue 3
// 10 процедурных волн под таймером (6.5 сек -> 3.5 сек), тотальный хардкор-сброс на шаг 1 при любой ошибке.
---

<TaskLayout level={3} bodyClass="font-monospace m-0 p-0">
<div id="app" class="container-fluid min-vh-100 p-2 p-md-3 bg-black text-danger font-monospace" v-cloak>

    <!-- 1. СТАРТОВЫЙ ЭКРАН (БРИФИНГ МИССИИ) -->
    <div v-if="!started && !completed" class="text-center py-4 py-md-5">
        <div class="d-inline-block border border-danger p-3 p-md-4 bg-dark rounded-0 mb-4 text-start shadow-lg" style="max-width: 840px;">
            <div class="d-flex justify-content-between align-items-center border-bottom border-danger pb-2 mb-3">
                <h1 class="h3 text-danger mb-0 fw-bold">🛡️ FIREWALL INTERCEPTOR // АРХЕТИП 9</h1>
                <span class="badge bg-danger text-black rounded-0 fw-bold px-3 py-2">ФИНАЛЬНЫЙ БОСС</span>
            </div>
            
            <p class="text-light fs-5 mb-3">
                На пограничный сетевой шлюз школы обрушился поток входящих коммуникационных запросов (веб-сессии, электронные письма, мессенджеры, переводы данных).
                Вам поручено отразить <span class="text-danger fw-bold">10 нарастающих волн коммуникационного трафика</span> 
                до переполнения буфера брандмауэра.
            </p>

            <div class="alert alert-danger bg-black border border-danger rounded-0 mb-3 text-light">
                <div class="fw-bold text-danger mb-2 text-uppercase">[ПРОТОКОЛ ХАРДКОР-РЕАГИРОВАНИЯ]:</div>
                <ul class="mb-0 ps-3">
                    <li class="mb-1">• <span class="text-warning fw-bold">Динамический таймер такта:</span> От <span class="text-danger fw-bold">6.5 секунд</span> на 1-й волне до <span class="text-danger fw-bold">3.5 секунд</span> на 10-й волне!</li>
                    <li class="mb-1">• <span class="text-warning fw-bold">Тотальный сброс (Full Wipeout):</span> Любая ошибка классификации, пропуск фишинга, ложная блокировка или тайм-аут вызывают аварийную тревогу и <span class="text-danger fw-bold">ПОЛНОСТЬЮ СБРАСЫВАЮТ ПРОГРЕСС НА ВОЛНУ 1</span> с новой процедурной генерацией!</li>
                    <li class="mb-1">• <span class="text-warning fw-bold">Два рубежа фильтрации:</span> <span class="text-success fw-bold">[ALLOW: Пропустить]</span> для легитимного защищенного трафика и <span class="text-danger fw-bold">[DROP: Блокировать]</span> для фишинга, опасных вложений, перехвата паролей и утечек ПДн.</li>
                </ul>
            </div>

            <div class="text-secondary small mb-4">
                Управление: кликами по кнопкам шлюза или горячими клавишами:
                <kbd class="bg-dark text-success border border-success">1</kbd> / <kbd class="bg-dark text-success border border-success">A</kbd> / <kbd class="bg-dark text-success border border-success">←</kbd> (ALLOW), 
                <kbd class="bg-dark text-danger border border-danger">0</kbd> / <kbd class="bg-dark text-danger border border-danger">D</kbd> / <kbd class="bg-dark text-danger border border-danger">→</kbd> (DROP).
            </div>

            <div class="text-center pt-2">
                <button @click="startGame" id="btn-start" class="btn btn-outline-danger btn-lg rounded-0 fw-bold px-5 py-3 shadow">
                    АКТИВИРОВАТЬ ЩИТ БРАНДМАУЭРА [ENTER]
                </button>
            </div>
        </div>
    </div>

    <!-- 2. ЭКРАН ПОБЕДЫ -->
    <div v-else-if="completed" id="success-screen" class="text-center py-4 py-md-5">
        <div class="d-inline-block border border-success p-4 p-md-5 bg-dark rounded-0 shadow-lg" style="max-width: 800px;">
            <div class="text-success display-2 mb-3">🛡️ СИСТЕМА ЗАЩИЩЕНА 🛡️</div>
            <h1 class="display-6 text-success fw-bold mb-3">ПЕРИМЕТР БЕЗОПАСНОСТИ УСПЕШНО ОТРАЗИЛ АТАКУ</h1>
            <p class="fs-5 text-light mb-4">
                Все 10 волн коммуникационного трафика успешно нейтрализованы! Фишинговые атаки, вредоносные вложения, спуфинг заголовков и утечки персональных данных заблокированы. Легитимные школьные службы функционируют без сбоев.
            </p>
            <div class="d-inline-block p-4 border border-success bg-black text-start small mx-auto mb-4" style="min-width: 360px;">
                <div class="mb-1 text-light">СТАТУС: <span class="text-success fw-bold">АРКАДНЫЙ БОСС УРОВНЯ 3 ПОВЕРЖЕН</span></div>
                <div class="mb-1 text-light">ОТРАЖЕНО ВОЛН: <span class="text-success fw-bold">10 / 10</span></div>
                <div class="mb-1 text-light">ЗАТРАЧЕНО ВРЕМЕНИ: <span class="text-warning fw-bold"><span v-text="totalTimeSpent"></span> СЕК</span></div>
                <div class="text-light">СБРОСОВ ХАРДКОРА: <span class="text-warning fw-bold"><span v-text="attempts"></span></span></div>
            </div>
            <div>
                <button @click="startGame" id="btn-replay" class="btn btn-outline-success btn-lg rounded-0 fw-bold px-5 py-3 shadow">
                    ПОВТОРИТЬ МИССИЮ [ENTER]
                </button>
            </div>
        </div>
    </div>

    <!-- 3. ИГРОВОЙ ЭКРАН (ОТРАЖЕНИЕ ВОЛН БРАНДМАУЭРА) -->
    <div v-else class="row justify-content-center">
        <div class="col-12 col-xl-10">

            <!-- Шапка волны и таймера -->
            <div class="card bg-dark border-danger rounded-0 mb-3 p-3 shadow">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-secondary small fw-bold">СЕТЕВОЙ ЭКРАН // ШЛЮЗ ШКОЛЫ:</span>
                            <span id="phase-counter" class="text-danger fw-bold fs-5">ВОЛНА <span v-text="currentWaveIndex + 1"></span> ИЗ 10</span>
                        </div>
                        <div class="progress bg-black border border-secondary rounded-0" style="height: 12px;">
                            <div class="progress-bar bg-danger" :style="{ width: progressPercent + '%' }"></div>
                        </div>
                    </div>
                    <div class="col-md-6 mt-3 mt-md-0 text-md-end">
                        <div class="text-secondary small fw-bold mb-1">ТАЙМЕР РЕАКЦИИ БУФЕРА:</div>
                        <div class="d-flex align-items-center justify-content-md-end gap-2">
                            <span id="timer-display" :class="timeLeft <= 2.0 ? 'text-danger fw-bold' : 'text-warning fw-bold'" class="fs-4">
                                <span v-text="formattedTime"></span> сек
                            </span>
                            <div class="progress bg-black border border-secondary rounded-0 d-inline-block" style="width: 140px; height: 12px;">
                                <div class="progress-bar" :class="timeLeft <= 2.0 ? 'bg-danger' : 'bg-warning'" :style="{ width: (timeLeft / waveTimeLimit * 100) + '%' }"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Сирена тревоги при сбросе -->
            <div v-if="alarmActive" id="alarm-box" class="alert alert-danger bg-black border-danger rounded-0 text-center py-3 mb-3 shadow" role="alert">
                <h4 class="fw-bold mb-1">[СИСТЕМНАЯ СИРЕНА // АВАРИЙНЫЙ СБРОС]</h4>
                <div class="text-light fs-5" v-text="alarmMessage"></div>
                <div class="text-warning small mt-2">ТОТАЛЬНЫЙ СБРОС НА ВОЛНУ 1... ПЕРЕЗАГРУЗКА ПАКЕТНОГО ФИЛЬТРА...</div>
            </div>

            <!-- Карточка входящего пакета (Firewall Target Packet) -->
            <div v-if="currentWave" id="target-packet-card" :data-target="currentWave.target" class="card bg-dark border-danger rounded-0 p-3 p-md-4 mb-3 shadow">
                <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom border-secondary pb-2 mb-3 gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-danger text-black rounded-0 fw-bold px-3 py-1">
                            PACKET #<span v-text="currentWave.id"></span>
                        </span>
                        <span class="badge bg-black border border-secondary text-info rounded-0 px-2 py-1">
                            <span v-text="currentWave.protocol"></span>:<span v-text="currentWave.port"></span>
                        </span>
                    </div>
                    <span class="text-secondary small">
                        СЛУЖБА: <span class="text-warning fw-bold" v-text="currentWave.service"></span>
                    </span>
                    <span class="badge bg-black border border-danger text-danger rounded-0 px-2 py-1">
                        ШЛЮЗ: <span v-text="currentWave.direction"></span>
                    </span>
                </div>

                <!-- Блок технических характеристик пакета (Data Source) -->
                <div class="row g-2 mb-3 text-start small">
                    <div class="col-md-6">
                        <div class="bg-black border border-secondary p-2">
                            <span class="text-secondary">УЗЕЛ / ИСТОЧНИК: </span>
                            <span class="text-light fw-bold font-monospace" v-text="currentWave.source"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-black border border-secondary p-2">
                            <span class="text-secondary">НАЗНАЧЕНИЕ / СЕРВЕР: </span>
                            <span class="text-light fw-bold font-monospace" v-text="currentWave.destination"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-black border border-secondary p-2">
                            <span class="text-secondary">КАНАЛ / ШИФРОВАНИЕ: </span>
                            <span :class="currentWave.encryptionClass" class="fw-bold" v-text="currentWave.encryption"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-black border border-secondary p-2">
                            <span class="text-secondary">СИСТЕМНЫЙ СТАТУС: </span>
                            <span :class="currentWave.flagsClass" class="fw-bold" v-text="currentWave.flags"></span>
                        </div>
                    </div>
                </div>

                <!-- Инспектируемое содержимое пакета (Payload Preview) -->
                <div class="text-secondary small mb-1 fw-bold">СОДЕРЖИМОЕ ПАКЕТА (DATA PAYLOAD):</div>
                <div class="card bg-black border-secondary rounded-0 p-3 mb-3 text-start">
                    <pre class="m-0 text-light font-monospace" style="white-space: pre-wrap; word-break: break-all; font-size: 0.95rem;" v-text="currentWave.details"></pre>
                </div>

                <div class="text-secondary small mb-3">
                    АНАЛИЗАТОР УГРОЗ: <span class="text-warning" v-text="currentWave.hint"></span>
                </div>

                <!-- Клавиши экстренного реагирования шлюза (ALLOW / DROP) -->
                <div class="row g-3">
                    <!-- Кнопка 1: ПРОПУСТИТЬ (ALLOW) -->
                    <div class="col-md-6">
                        <button @click="submitAction('allow')" 
                                id="btn-action-allow"
                                data-action="allow"
                                :disabled="alarmActive"
                                class="btn btn-outline-success w-100 py-3 rounded-0 fw-bold d-flex flex-column align-items-center justify-content-center shadow"
                                style="min-height: 58px;">
                            <span class="fs-4">✓ ПРОПУСТИТЬ [ALLOW]</span>
                            <span class="small text-secondary mt-1">Легитимный трафик • [ 1 ] / [ A ] / [ ← ]</span>
                        </button>
                    </div>

                    <!-- Кнопка 2: БЛОКИРОВАТЬ (DROP) -->
                    <div class="col-md-6">
                        <button @click="submitAction('drop')" 
                                id="btn-action-drop"
                                data-action="drop"
                                :disabled="alarmActive"
                                class="btn btn-outline-danger w-100 py-3 rounded-0 fw-bold d-flex flex-column align-items-center justify-content-center shadow"
                                style="min-height: 58px;">
                            <span class="fs-4">✗ БЛОКИРОВАТЬ [DROP]</span>
                            <span class="small text-secondary mt-1">Угроза / Sinkhole • [ 0 ] / [ D ] / [ → ]</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Информационная полоса статуса -->
            <div class="d-flex justify-content-between text-secondary small px-1">
                <span>ШЛЮЗ: ACTIVE_FIREWALL_v7.8</span>
                <span>РЕЖИМ: ХАРДКОР (ТОТАЛЬНЫЙ СБРОС)</span>
                <span>СБРОСОВ ХАРДКОРА: <span class="text-warning fw-bold" v-text="attempts"></span></span>
            </div>

        </div>
    </div>

</div>

<script src="/static/vue.global.js" is:inline></script>
<script is:inline>
    (function() {
        const missionName = '7 класс :: Урок 8 :: Контрольная работа: Сервисы интернет-коммуникаций. Сетевой этикет. Стратегии безопасного поведения в Интернете (Уровень 3)';
        const sessionStartTime = Date.now();
        let attempts = 0;

        function sendTelemetry(actionType, success = false) {
            const timeSpent = Math.max(1, Math.floor((Date.now() - sessionStartTime) / 1000));
            window.parent.postMessage({
                type: 'TELEMETRY_EVENT',
                mission_name: missionName,
                action_type: actionType,
                status: actionType === 'level_complete' ? 'completed' : 'in_progress',
                start_time: new Date(sessionStartTime).toISOString(),
                time_spent_sec: timeSpent,
                attempts_count: attempts,
                success: success
            }, '*');
        }

        // Старт сессии
        sendTelemetry('in_progress', false);

        // Синтезатор звуковых сигналов (Web Audio API)
        let audioCtx = null;
        function getAudioContext() {
            if (!audioCtx) {
                const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
                if (AudioCtxClass) audioCtx = new AudioCtxClass();
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            return audioCtx;
        }

        function playSound(type) {
            try {
                const ctx = getAudioContext();
                if (!ctx) return;
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);
                const now = ctx.currentTime;

                if (type === 'success') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(587.33, now); // D5
                    osc.frequency.exponentialRampToValueAtTime(880.00, now + 0.15); // A5
                    gain.gain.setValueAtTime(0.12, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
                    osc.start(now);
                    osc.stop(now + 0.15);
                } else if (type === 'alarm') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(140, now);
                    osc.frequency.linearRampToValueAtTime(100, now + 0.35);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
                    osc.start(now);
                    osc.stop(now + 0.35);
                } else if (type === 'victory') {
                    const freqs = [523.25, 659.25, 783.99, 1046.50];
                    freqs.forEach((f, idx) => {
                        const o = ctx.createOscillator();
                        const g = ctx.createGain();
                        o.connect(g);
                        g.connect(ctx.destination);
                        o.type = 'triangle';
                        o.frequency.setValueAtTime(f, now + idx * 0.1);
                        g.gain.setValueAtTime(0.15, now + idx * 0.1);
                        g.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.1 + 0.3);
                        o.start(now + idx * 0.1);
                        o.stop(now + idx * 0.1 + 0.3);
                    });
                }
            } catch (e) {
                // Audio failure ignored gracefully
            }
        }

        const { createApp, ref, computed, onMounted, onUnmounted } = Vue;

        createApp({
            setup() {
                const started = ref(false);
                const completed = ref(false);
                const alarmActive = ref(false);
                const alarmMessage = ref('');
                const currentWaveIndex = ref(0);
                const waveTimeLimit = ref(6.5);
                const timeLeft = ref(6.5);
                const totalTimeSpent = ref(0);
                const waves = ref([]);
                let timerInterval = null;

                const formattedTime = computed(() => {
                    return Math.max(0, timeLeft.value).toFixed(1);
                });

                const progressPercent = computed(() => {
                    return Math.round(((currentWaveIndex.value) / 10) * 100);
                });

                const currentWave = computed(() => {
                    return waves.value[currentWaveIndex.value] || null;
                });

                // Генератор банка волн для 7 класса (Урок 8)
                function createWave(waveNum) {
                    const idNum = Math.floor(Math.random() * 899) + 100;
                    const packetId = `SEC-708-${idNum}`;

                    // Наборы вариантов для каждой из 10 волн
                    const wavePresets = {
                        1: [
                            {
                                service: 'Веб-доступ к образовательному порталу',
                                protocol: 'HTTPS',
                                port: 443,
                                direction: 'WAN ➔ ШКОЛА',
                                source: '178.208.83.42 (Минпросвещения РФ)',
                                destination: 'Кабинет информатики (ПК-04)',
                                encryption: 'TLS 1.3 (Сертификат Минцифры РФ валиден)',
                                encryptionClass: 'text-success',
                                flags: 'Проверенный национальный образовательный узел',
                                flagsClass: 'text-success',
                                details: 'GET https://resh.edu.ru/subject/lesson/informatics/7/ HTTP/2.0\nHost: resh.edu.ru\nAccept: text/html,application/xhtml+xml',
                                hint: 'Официальный портал РЭШ по защищенному протоколу HTTPS (порт 443).',
                                target: 'allow',
                                errorExplanation: 'Официальные образовательные порталы с проверенным сертификатом HTTPS (порт 443) являются доверенными и должны пропускаться.'
                            },
                            {
                                service: 'Приманка на выигрыш / Фишинговый сбор карт',
                                protocol: 'HTTP',
                                port: 80,
                                direction: 'WAN ➔ ШКОЛА',
                                source: '91.240.118.15 (Анонимный хостинг)',
                                destination: 'Планшет школьника',
                                encryption: 'НЕТ (Открытый незашифрованный канал HTTP)',
                                encryptionClass: 'text-danger',
                                flags: 'Подозрительный домен-однодневка, призыв ввести CVC',
                                flagsClass: 'text-danger',
                                details: 'POST http://gosuslugi-bonus-2026.net/claim HTTP/1.1\nHost: gosuslugi-bonus-2026.net\nBody: card_num=220220334455&cvc=789&pin=1122',
                                hint: 'Поддельный сайт Госуслуг в незащищенном HTTP (порт 80) требует данные банковской карты.',
                                target: 'drop',
                                errorExplanation: 'Фишинговые сайты-подделки в открытом канале HTTP, выманивающие платежные реквизиты, подлежат немедленной блокировке!'
                            }
                        ],
                        2: [
                            {
                                service: 'Электронная почта от учителя',
                                protocol: 'SMTPS',
                                port: 465,
                                direction: 'WAN ➔ ПОЧТА ШКОЛЫ',
                                source: 'petrova_teacher@school42.ru',
                                destination: 'student_7a@school42.ru',
                                encryption: 'SSL/TLS Encrypted (Школьный почтовый сервер)',
                                encryptionClass: 'text-success',
                                flags: 'SPF: PASS | DKIM: PASS | Заголовок From подтвержден',
                                flagsClass: 'text-success',
                                details: 'Subject: Домашнее задание по информатике на вторник\nAttachment: zadanie_7a.pdf (MIME: application/pdf, 185 Кб)\nBody: Здравствуйте, ребята! В приложении тест к следующему уроку.',
                                hint: 'Письмо учителя с корректного домена школы с безопасным PDF-файлом.',
                                target: 'allow',
                                errorExplanation: 'Письма от подтвержденных школьных адресов с вложением формата .pdf безопасны и должны пропускаться.'
                            },
                            {
                                service: 'Вредоносный исполняемый спам под видом обновления',
                                protocol: 'SMTP',
                                port: 25,
                                direction: 'WAN ➔ ПОЧТА ШКОЛЫ',
                                source: 'support-mailbox@portal-security-update.com',
                                destination: 'student_7a@school42.ru',
                                encryption: 'НЕТ (Нешифрованный транзитный релей)',
                                encryptionClass: 'text-danger',
                                flags: 'SPF: FAIL | Вложение содержит исполняемый файл .exe',
                                flagsClass: 'text-danger',
                                details: 'Subject: ВНИМАНИЕ: Ваш почтовый ящик переполнен! Срочно обновите\nAttachment: mailbox_patch.exe (MIME: application/x-msdownload, 420 Кб)\nBody: Запустите прикрепленный файл для увеличения квоты.',
                                hint: 'Запугивание блокировкой и прикрепленный исполняемый файл .exe.',
                                target: 'drop',
                                errorExplanation: 'Категорически запрещено пропускать почту с исполняемыми вложениями .exe, особенно с требованием срочного запуска!'
                            }
                        ],
                        3: [
                            {
                                service: 'Защищенное чтение почты учеником (IMAPS)',
