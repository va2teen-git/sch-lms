                function initAllWaves() {
                    const list = [];
                    for (let w = 1; w <= 10; w++) {
                        list.push(createWave(w));
                    }
                    waves.value = list;
                }

                function startWave(index) {
                    currentWaveIndex.value = index;

                    // Динамический таймер такта для 7 класса (от 6.5 до 3.5 сек):
                    // Волны 1-3: 6.5 сек
                    // Волны 4-6: 5.5 сек
                    // Волны 7-9: 4.5 сек
                    // Волна 10: 3.5 сек
                    let limit = 6.5;
                    if (index >= 9) limit = 3.5;
                    else if (index >= 6) limit = 4.5;
                    else if (index >= 3) limit = 5.5;

                    waveTimeLimit.value = limit;
                    timeLeft.value = limit;

                    clearInterval(timerInterval);
                    timerInterval = setInterval(() => {
                        timeLeft.value -= 0.1;
                        if (timeLeft.value <= 0) {
                            clearInterval(timerInterval);
                            triggerHardcoreFail('ТАЙМ-АУТ ШЛЮЗА: Время реакции истекло! Буфер брандмауэра переполнен необработанным трафиком.');
                        }
                    }, 100);
                }

                function submitAction(action) {
                    if (!started.value || completed.value || alarmActive.value) return;

                    clearInterval(timerInterval);
                    const expected = currentWave.value.target;

                    if (action === expected) {
                        // Успешный перехват
                        playSound('success');
                        if (currentWaveIndex.value < 9) {
                            startWave(currentWaveIndex.value + 1);
                        } else {
                            // Финальная победа
                            finishGame();
                        }
                    } else {
                        // Ошибка аудитора
                        const actionName = action === 'allow' ? '«ПРОПУСТИТЬ [ALLOW]»' : '«БЛОКИРОВАТЬ [DROP]»';
                        const expectedName = expected === 'allow' ? '«ПРОПУСТИТЬ [ALLOW]»' : '«БЛОКИРОВАТЬ [DROP]»';
                        const reason = `ОШИБКА АУДИТА: Вы выбрали ${actionName}, а требовалось ${expectedName}. ${currentWave.value.errorExplanation || ''}`;
                        triggerHardcoreFail(reason);
                    }
                }

                function triggerHardcoreFail(reason) {
                    clearInterval(timerInterval);
                    attempts++;
                    sendTelemetry('hardcore_reset', false);
                    playSound('alarm');

                    alarmMessage.value = reason;
                    alarmActive.value = true;

                    // Через 2.2 секунды сброс на Волну 1 с новой процедурной генерацией!
                    setTimeout(() => {
                        alarmActive.value = false;
                        initAllWaves();
                        startWave(0);
                    }, 2200);
                }

                function startGame() {
                    attempts = 0;
                    completed.value = false;
                    alarmActive.value = false;
                    started.value = true;
                    initAllWaves();
                    sendTelemetry('in_progress', false);
                    startWave(0);
                }

                function finishGame() {
                    clearInterval(timerInterval);
                    completed.value = true;
                    totalTimeSpent.value = Math.max(1, Math.floor((Date.now() - sessionStartTime) / 1000));
                    sendTelemetry('level_complete', true);
                    playSound('victory');
                }

                function handleKeyDown(e) {
                    if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;

                    if (!started.value || completed.value) {
                        if (e.key === 'Enter') {
                            startGame();
                        }
                        return;
                    }

                    if (started.value && !completed.value && !alarmActive.value) {
                        if (e.key === '1' || e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft' || e.key === 'z' || e.key === 'Z') {
                            submitAction('allow');
                        } else if (e.key === '0' || e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight' || e.key === 'x' || e.key === 'X') {
                            submitAction('drop');
                        }
                    }
                }

                // Экспорт состояния для автотестов Playwright и симулятора персон
                window.__DEV_LEVEL3_STATE__ = {
                    get started() { return started.value; },
                    get completed() { return completed.value; },
                    get currentWaveIndex() { return currentWaveIndex.value; },
                    get currentWave() { return currentWave.value; },
                    get waves() { return waves.value; },
                    get attempts() { return attempts; },
                    startGame,
                    submitAction,
                    solveCurrentWave() {
                        if (currentWave.value) {
                            submitAction(currentWave.value.target);
                        }
                    }
                };

                onMounted(() => {
                    window.addEventListener('keydown', handleKeyDown);
                });

                onUnmounted(() => {
                    clearInterval(timerInterval);
                    window.removeEventListener('keydown', handleKeyDown);
                });

                return {
                    started,
                    completed,
                    alarmActive,
                    alarmMessage,
                    waves,
                    currentWaveIndex,
                    currentWave,
                    progressPercent,
                    waveTimeLimit,
                    timeLeft,
                    formattedTime,
                    totalTimeSpent,
                    attempts,
                    startGame,
                    submitAction
                };
            }
        }).mount('#app');
    })();
</script>
</TaskLayout>
