---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
// Уровень 2: 7 класс, Урок 8 - Контрольная работа: Сервисы интернет-коммуникаций. Сетевой этикет. Стратегии безопасного поведения в Интернете
// Механика: Аналитика криптостойкости паролей, прикладные порты IANA, инверсный аудит служебных заголовков RFC, выявление фишинговых аномалий и юридическая квалификация по статьям РФ.
// Строго ручной ввод (Zero Multiple Choice), платформа anti-paste.
// 5 процедурных фаз. Ошибка = hardcore_reset и генерация нового варианта текущей фазы.
---

<TaskLayout level={2} bodyClass="font-monospace m-0 p-0">
<div class="container-fluid min-vh-100 p-2 p-md-4 rounded-0 bg-dark text-warning">
    <div class="row">
        <div class="col-12">
            <!-- Шапка терминала -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center border-bottom border-warning pb-2 mb-3 gap-2">
                <div>
                    <h2 class="h5 text-warning font-monospace mb-0 text-uppercase">ТЕРМИНАЛ ИБ-АНАЛИТИКА // КРИПТОЗАЩИТА И ПРАВОВЫЕ ОСНОВЫ</h2>
                    <span class="small text-secondary">7 КЛАСС // УРОК 8: КОНТРОЛЬНАЯ РАБОТА (УРОВЕНЬ 2)</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span id="phase-badge" class="badge bg-black text-warning border border-warning rounded-0 px-3 py-2">Шаг 1 из 5</span>
                    <span class="badge border border-warning text-warning bg-black rounded-0 px-3 py-2">ПРОДВИНУТЫЙ РЕЖИМ</span>
                </div>
            </div>

            <!-- Блок системных ошибок -->
            <div id="error-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3" role="alert">
                <span class="fw-bold">[СИСТЕМНЫЙ СБОЙ]</span> <span id="error-message">Неверный ввод! Процедурная перегенерация параметров...</span>
            </div>

            <!-- ========================================================================= -->
            <!-- ФАЗА 1: Расчет мощности алфавита и энтропии паролей (N = A^L)             -->
            <!-- ========================================================================= -->
            <div id="phase1" class="card bg-black border-warning rounded-0 mb-4">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0 py-2">
                    <span class="fw-bold">ФАЗА 1 ИЗ 5: Мощность алфавита и комбинаторный расчет паролей</span>
                    <span class="badge bg-warning text-dark rounded-0">РУЧНОЙ ВВОД В ПОЛЕ</span>
                </div>
                <div class="card-body p-2 p-md-3">
                    <p class="text-light small mb-3">
                        Количество уникальных комбинаций парольной защиты определяется по комбинаторной формуле 
                        <strong class="text-warning">N = A<sup>L</sup></strong>, где <strong>A</strong> — мощность используемого алфавита символов, 
                        а <strong>L</strong> — длина пароля.
                    </p>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3" style="max-width: 680px;">
                        <div class="text-secondary small mb-1 text-uppercase fw-bold">Аналитическая задача:</div>
                        <div id="p1-task-desc" class="text-light font-monospace small mb-3">Загрузка задания...</div>

                        <div class="mb-2">
                            <label for="p1-input" class="form-label text-warning small font-monospace" id="p1-label">Введите рассчитанное число:</label>
                            <input type="number" id="p1-input" class="form-control rounded-0 bg-black text-warning border-warning font-monospace anti-paste" style="max-width: 320px;" placeholder="Числовой результат..." autocomplete="off">
                        </div>
                    </div>

                    <button id="btn-phase1" class="btn btn-outline-warning rounded-0 px-4 py-2 font-monospace" style="min-height: 48px;">
                        [ПРОВЕРИТЬ РАСЧЕТ И ПЕРЕЙТИ К ФАЗЕ 2]
                    </button>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- ФАЗА 2: Анализ сетевых портов IANA и прикладных протоколов                 -->
            <!-- ========================================================================= -->
            <div id="phase2" class="card bg-black border-warning rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0 py-2">
                    <span class="fw-bold">ФАЗА 2 ИЗ 5: Стандартные и криптографические порты IANA</span>
                    <span class="badge bg-warning text-dark rounded-0">РУЧНОЙ ВВОД В ПОЛЕ</span>
                </div>
                <div class="card-body p-2 p-md-3">
                    <p class="text-light small mb-3">
                        Прикладные службы интернет-коммуникаций используют фиксированные номера портов TCP/IP для маршрутизации и установки защищенных соединений SSL/TLS.
                    </p>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3" style="max-width: 680px;">
                        <div class="text-secondary small mb-1 text-uppercase fw-bold">Сетевой сценарий:</div>
                        <div id="p2-task-desc" class="text-light font-monospace small mb-3">Загрузка параметров...</div>

                        <div class="mb-2">
                            <label for="p2-input" class="form-label text-warning small font-monospace">Введите номер порта TCP:</label>
                            <input type="number" id="p2-input" class="form-control rounded-0 bg-black text-warning border-warning font-monospace anti-paste" style="max-width: 320px;" placeholder="Номер порта (например, 443)..." autocomplete="off">
                        </div>
                    </div>

                    <button id="btn-phase2" class="btn btn-outline-warning rounded-0 px-4 py-2 font-monospace" style="min-height: 48px;">
                        [ПОДТВЕРДИТЬ ПОРТ И ПЕРЕЙТИ К ФАЗЕ 3]
                    </button>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- ФАЗА 3: [Пик 1] Инверсный анализ служебных заголовков RFC                  -->
            <!-- ========================================================================= -->
            <div id="phase3" class="card bg-black border-warning rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0 py-2">
                    <span class="fw-bold">ФАЗА 3 ИЗ 5: [ПИК 1] Инверсный анализ служебных заголовков электронной почты (RFC)</span>
                    <span class="badge bg-warning text-dark rounded-0">АНАЛИТИЧЕСКИЙ АУДИТ</span>
                </div>
                <div class="card-body p-2 p-md-3">
                    <p class="text-light small mb-3">
                        Злоумышленники могут сфальсифицировать видимое поле отправителя <code>From</code> в почтовом клиенте. Инверсный аудит служебных заголовков письма позволяет выявить реальный сервер отправления, обратный адрес возврата <code>Return-Path / Reply-To</code> и скрытые угрозы.
                    </p>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3" style="max-width: 760px;">
                        <div class="text-secondary small mb-1 text-uppercase fw-bold">Служебный дамп поступившего письма (RFC 5322):</div>
                        <pre id="p3-headers-dump" class="p-3 bg-black border border-secondary text-light font-monospace small mb-3" style="white-space: pre-wrap; font-size: 0.8rem; line-height: 1.3;">Загрузка заголовков...</pre>

                        <div id="p3-task-question" class="text-warning font-monospace small mb-2 fw-bold">Вопрос аудита...</div>
                        <div>
                            <input type="text" id="p3-input" class="form-control rounded-0 bg-black text-warning border-warning font-monospace anti-paste" style="max-width: 480px;" placeholder="Введите искомый параметр..." autocomplete="off">
                        </div>
                    </div>

                    <button id="btn-phase3" class="btn btn-outline-warning rounded-0 px-4 py-2 font-monospace" style="min-height: 48px;">
                        [ПОДТВЕРДИТЬ АУДИТ И ПЕРЕЙТИ К ФАЗЕ 4]
                    </button>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- ФАЗА 4: [Долина консолидации] Синтаксический аудит подозрительных URL     -->
            <!-- ========================================================================= -->
            <div id="phase4" class="card bg-black border-warning rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0 py-2">
                    <span class="fw-bold">ФАЗА 4 ИЗ 5: [КОНСОЛИДАЦИЯ] Синтаксический аудит фишинговых доменов и URL-аномалий</span>
                    <span class="badge bg-warning text-dark rounded-0">СИНТАКСИЧЕСКИЙ АНАЛИЗ</span>
                </div>
                <div class="card-body p-2 p-md-3">
                    <p class="text-light small mb-3">
                        Фишинговые сайты маскируются под официальные сервисы с помощью длинных составных имен, поддоменов 3-го уровня и тайпосквоттинга (замены символов). Истинным владельцем узла всегда является домен 2-го уровня, расположенный непосредственно перед национальной или общей зоной.
                    </p>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3" style="max-width: 680px;">
                        <div class="text-secondary small mb-1 text-uppercase fw-bold">Подозрительный сетевой адрес:</div>
                        <div id="p4-url-box" class="p-2 bg-black border border-warning text-light font-monospace small mb-3">URL...</div>

                        <div id="p4-task-desc" class="text-light font-monospace small mb-3">Загрузка задания...</div>

                        <div class="mb-2">
                            <label for="p4-input" class="form-label text-warning small font-monospace">Введите результат анализа:</label>
                            <input type="text" id="p4-input" class="form-control rounded-0 bg-black text-warning border-warning font-monospace anti-paste" style="max-width: 480px;" placeholder="Например, domain.ru..." autocomplete="off">
                        </div>
                    </div>

                    <button id="btn-phase4" class="btn btn-outline-warning rounded-0 px-4 py-2 font-monospace" style="min-height: 48px;">
                        [ПОДТВЕРДИТЬ СИНТАКСИС И ПЕРЕЙТИ К ФАЗЕ 5]
                    </button>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- ФАЗА 5: [Кульминационный пик] Квалификация киберинцидентов по статьям РФ  -->
            <!-- ========================================================================= -->
            <div id="phase5" class="card bg-black border-warning rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0 py-2">
                    <span class="fw-bold">ФАЗА 5 ИЗ 5: [КУЛЬМИНАЦИЯ] Квалификация инцидентов ИБ по законодательству РФ</span>
                    <span class="badge bg-warning text-dark rounded-0">ПРАВОВОЙ АНАЛИЗ</span>
                </div>
                <div class="card-body p-2 p-md-3">
                    <p class="text-light small mb-3">
                        Определите правовую норму законодательства Российской Федерации, под действие которой подпадает описанный инцидент информационной безопасности (Уголовный кодекс РФ или Федеральные законы).
                    </p>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3" style="max-width: 720px;">
                        <div class="text-secondary small mb-1 text-uppercase fw-bold">Материалы инцидента:</div>
                        <div id="p5-case-desc" class="text-light font-monospace small mb-3" style="line-height: 1.4;">Загрузка описания инцидента...</div>

                        <div id="p5-task-question" class="text-warning font-monospace small mb-2 fw-bold">Вопрос:</div>
                        <div>
                            <input type="text" id="p5-input" class="form-control rounded-0 bg-black text-warning border-warning font-monospace anti-paste" style="max-width: 320px;" placeholder="Номер статьи или закона..." autocomplete="off">
                        </div>
                    </div>

                    <button id="btn-phase5" class="btn btn-outline-warning rounded-0 px-4 py-2 font-monospace" style="min-height: 48px;">
                        [ЗАВЕРШИТЬ АТТЕСТАЦИЮ УРОВНЯ 2]
                    </button>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- ЭКРАН УСПЕХА                                                              -->
            <!-- ========================================================================= -->
            <div id="success-screen" class="card bg-warning text-black border-warning rounded-0 mb-4 d-none">
                <div class="card-body text-center py-5">
                    <h1 class="display-6 fw-bold mb-3">АТТЕСТАЦИЯ ПРОДВИНУТОГО УРОВНЯ ЗАВЕРШЕНА!</h1>
                    <p class="lead mb-4">
                        Комбинаторная энтропия паролей вычислена, криптографические порты подтверждены, служебные заголовки проверены, фишинговые аномалии выявлены, правовые нормы квалифицированы без ошибок.
                    </p>
                    <div class="badge bg-black text-warning border border-black rounded-0 fs-6 px-4 py-2">
                        УРОВЕНЬ 2 ЗАВЕРШЕН // СТАТУС: SUCCESS // ТЕЛЕМЕТРИЯ ЗАФИКСИРОВАНА
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
</TaskLayout>

<script is:inline>
    // =========================================================================
    // ТЕЛЕМЕТРИЯ (Стандарты xAPI / IMS Caliper)
    // =========================================================================
    const startTime = new Date();
    let attempts = 0;
    const missionName = '7 класс :: Урок 8 :: Контрольная работа: Сервисы интернет-коммуникаций. Сетевой этикет. Стратегии безопасного поведения в Интернете (Уровень 2)';

    function sendTelemetry(action_type, status, success) {
        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: action_type,
            status: status,
            start_time: startTime.toISOString(),
            time_spent_sec: Math.floor((new Date() - startTime) / 1000),
            attempts_count: attempts,
            success: success
        }, '*');
    }

    sendTelemetry('in_progress', 'in_progress', false);

    function triggerError(message, retryCallback) {
        attempts++;
        const errorBox = document.getElementById('error-box');
        const errorMessage = document.getElementById('error-message');
        if (errorMessage) errorMessage.textContent = message;
        if (errorBox) errorBox.classList.remove('d-none');

        // Отправка сигнала телеметрии о сбое текущей попытки
        sendTelemetry('hardcore_reset', 'in_progress', false);

        setTimeout(() => {
            if (errorBox) errorBox.classList.add('d-none');
            if (retryCallback) retryCallback();
        }, 1500);
    }

    // Защита от вставки из буфера обмена (Anti-Paste)
    document.querySelectorAll('.anti-paste').forEach(input => {
        input.addEventListener('paste', (e) => {
            e.preventDefault();
            triggerError('Вставка из буфера обмена заблокирована! Вводите значение вручную с клавиатуры.');
        });
        input.addEventListener('drop', (e) => {
            e.preventDefault();
        });
    });

    // Утилита перемешивания
    function shuffle(array) {
        const arr = [...array];
        for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr;
    }

    // Нормализация строковых ответов
    function cleanInput(str) {
        return (str || '').trim().toLowerCase().replace(/['"«»]/g, '');
    }

    // =========================================================================
    // БАНК ДАННЫХ И ЛОГИКА ФАЗЫ 1: Расчет энтропии паролей (N = A^L)
    // =========================================================================
    const P1_VARIANTS = [
        {
            desc: 'В банковском приложении для быстрой авторизации используется цифровой PIN-код длиной ровно 4 символа (разрешены только десятичные цифры от 0 до 9). Рассчитайте общее количество уникальных возможных комбинаций PIN-кодов (N = A^L):',
            label: 'Общее число уникальных комбинаций N:',
            expected: 10000
        },
        {
            desc: 'Для доступа к школьному сетевому диску создается пароль длиной ровно 3 символа, состоящий исключительно из цифр (0-9). Рассчитайте общее число возможных комбинаций пароля (N = A^L):',
            label: 'Общее число уникальных комбинаций N:',
            expected: 1000
        },
        {
            desc: 'Политика безопасности сервера требует использовать в паролях строчные и прописные латинские буквы (a-z и A-Z, по 26 букв в каждом регистре), а также десятичные цифры (0-9). Определите общую мощность используемого алфавита символов A:',
            label: 'Мощность алфавита A:',
            expected: 62
        },
        {
            desc: 'В упрощенной системе авторизации разрешено использовать только строчные латинские буквы (a-z, 26 символов) и десятичные цифры (0-9, 10 символов). Чему равна мощность алфавита A для данной системы?',
            label: 'Мощность алфавита A:',
            expected: 36
        },
        {
            desc: 'Система генерации временных кодов формирует 8-битный двоичный ключ (каждый символ может быть только 0 или 1, то есть A = 2, длина L = 8). Рассчитайте общее количество уникальных ключей (N = 2^8):',
            label: 'Количество комбинаций N:',
            expected: 256
        },
        {
            desc: 'Парольная политика требует составлять пароль только из латинских букв обоих регистров (a-z и A-Z, без цифр и специальных знаков). Чему равна мощность алфавита A (26 строчных + 26 прописных)?',
            label: 'Мощность алфавита A:',
            expected: 52
        },
        {
            desc: 'Сервис генерации одноразовых паролей формирует 5-значный числовой SMS-код из цифр от 0 до 9 (A = 10, L = 5). Рассчитайте общее количество уникальных вариантов кода:',
            label: 'Общее число комбинаций N:',
            expected: 100000
        }
    ];

    let p1CurrentExpected = 0;

    function initPhase1() {
        const variant = shuffle(P1_VARIANTS)[0];
        document.getElementById('p1-task-desc').textContent = variant.desc;
        document.getElementById('p1-label').textContent = variant.label;
        document.getElementById('p1-input').value = '';
        p1CurrentExpected = variant.expected;
    }

    document.getElementById('btn-phase1').addEventListener('click', () => {
        const val = parseInt(document.getElementById('p1-input').value.trim(), 10);
        if (val === p1CurrentExpected) {
            document.getElementById('phase1').classList.add('d-none');
            document.getElementById('phase2').classList.remove('d-none');
            document.getElementById('phase-badge').textContent = 'Шаг 2 из 5';
            initPhase2();
        } else {
            triggerError('ОШИБКА РАСЧЕТА: Неверно вычислено значение! Проверьте формулу N = A^L и мощности наборов символов.', () => {
                initPhase1();
            });
        }
    });

    // =========================================================================
    // БАНК ДАННЫХ И ЛОГИКА ФАЗЫ 2: Порты IANA и сетевые протоколы
    // =========================================================================
    const P2_VARIANTS = [
        {
            desc: 'Сетевой администратор настраивает почтовый шлюз для безопасной отправки электронной почты по защищенному криптографическому протоколу SMTPS (SSL/TLS). Введите стандартный номер порта IANA:',
            expected: 465
        },
        {
            desc: 'Пользователь открывает защищенный веб-сайт образовательного портала по протоколу HTTPS. Укажите стандартный номер сетевого порта TCP для защищенного веб-трафика:',
            expected: 443
        },
        {
            desc: 'Почтовый клиент на смартфоне выполняет безопасную двустороннюю синхронизацию писем и папок по протоколу IMAPS с шифрованием SSL/TLS. Введите стандартный криптографический порт IMAPS:',
            expected: 993
        },
        {
            desc: 'Почтовая программа на стационарном ПК загружает входящие сообщения с сервера по защищенному протоколу POP3S (SSL/TLS). Введите номер защищенного порта POP3S:',
            expected: 995
        },
        {
            desc: 'В локальной сети обнаружен незащищенный веб-трафик, передаваемый открытым текстом по классическому протоколу HTTP. Укажите стандартный номер порта HTTP:',
            expected: 80
        },
        {
            desc: 'Почтовый сервер передает служебные сообщения на внешний релей по традиционному открытому протоколу SMTP по умолчанию. Введите стандартный номер порта SMTP:',
            expected: 25
        },
        {
            desc: 'Почтовый клиент проверяет почту по открытому протоколу IMAP без использования шифрования трафика. Введите номер порта незащищенного IMAP:',
            expected: 143
        },
        {
            desc: 'Почтовый клиент забирает письма по устаревшему открытому протоколу POP3 без шифрования соединения. Введите номер стандартного открытого порта POP3:',
            expected: 110
        }
    ];

    let p2CurrentExpected = 0;

    function initPhase2() {
        const variant = shuffle(P2_VARIANTS)[0];
        document.getElementById('p2-task-desc').textContent = variant.desc;
        document.getElementById('p2-input').value = '';
        p2CurrentExpected = variant.expected;
    }

    document.getElementById('btn-phase2').addEventListener('click', () => {
        const val = parseInt(document.getElementById('p2-input').value.trim(), 10);
        if (val === p2CurrentExpected) {
            document.getElementById('phase2').classList.add('d-none');
            document.getElementById('phase3').classList.remove('d-none');
            document.getElementById('phase-badge').textContent = 'Шаг 3 из 5';
            initPhase3();
        } else {
            triggerError('ОШИБКА ПОРТА: Неверно указан номер сетевого порта IANA для данного протокола!', () => {
                initPhase2();
            });
        }
    });

    // =========================================================================
    // БАНК ДАННЫХ И ЛОГИКА ФАЗЫ 3: [Пик 1] Инверсный анализ заголовков RFC
    // =========================================================================
    const P3_VARIANTS = [
        {
            dump: `Return-Path: <scam-collector@dark-server.xyz>
Received: from evil-host.net (unknown [198.51.100.42])
    by mail.school-portal.edu.ru with ESMTP for <ivanov@school-portal.edu.ru>;
From: "Администрация школы" <admin@school-portal.edu.ru>
Reply-To: <scam-collector@dark-server.xyz>
Subject: Срочно подтвердите пароль от личного кабинета!`,
            question: 'Злоумышленник сымитировал адрес школьной администрации в поле From. Введите реальный адрес электронной почты из полей Return-Path / Reply-To, на который уйдет ответ пользователя:',
            expected: 'scam-collector@dark-server.xyz'
        },
        {
            dump: `Return-Path: <bounces@fake-bank-auth.com>
Received: from sender-relay.botnet.cc ([203.0.113.15])
    by mx1.mail-provider.ru with ESMTP;
