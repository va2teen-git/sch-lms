    by mail.gosuslugi.ru;
From: "Госуслуги" <support@gosuslugi.ru>
Reply-To: <collector@gosuslugi-verif.ru>
Subject: Предоставьте СНИЛС для подтверждения профиля`,
            question: 'Злоумышленники используют фишинговый домен для сбора паролей. Введите поддельное доменное имя второго уровня из поля Reply-To (домен с зоной .ru):',
            expected: 'gosuslugi-verif.ru'
        }
    ];

    let p3CurrentExpected = '';

    function initPhase3() {
        const variant = shuffle(P3_VARIANTS)[0];
        document.getElementById('p3-headers-dump').textContent = variant.dump;
        document.getElementById('p3-task-question').textContent = variant.question;
        document.getElementById('p3-input').value = '';
        p3CurrentExpected = variant.expected.toLowerCase();
    }

    document.getElementById('btn-phase3').addEventListener('click', () => {
        const val = cleanInput(document.getElementById('p3-input').value);
        if (val === p3CurrentExpected) {
            document.getElementById('phase3').classList.add('d-none');
            document.getElementById('phase4').classList.remove('d-none');
            document.getElementById('phase-badge').textContent = 'Шаг 4 из 5';
            initPhase4();
        } else {
            triggerError('ОШИБКА АУДИТА RFC: Неверно извлечен параметр из служебных заголовков письма! Проверьте поля Return-Path, Reply-To и нижний узел Received.', () => {
                initPhase3();
            });
        }
    });

    // =========================================================================
    // БАНК ДАННЫХ И ЛОГИКА ФАЗЫ 4: [Долина консолидации] Синтаксис URL
    // =========================================================================
    const P4_VARIANTS = [
        {
            url: 'https://gosuslugi.ru.user-auth-check.org/login',
            desc: 'В ссылке имя официального портала помещено в поддомен 3-го уровня. Определите настоящий домен 2-го уровня (включая зону .org):',
            expected: 'user-auth-check.org'
        },
        {
            url: 'https://vkk-auth-security.ru/login.php',
            desc: 'В фишинговом адресе использовано удвоение букв (тайпосквоттинг). Введите доменное имя 2-го уровня (с зоной .ru):',
            expected: 'vkk-auth-security.ru'
        },
        {
            url: 'https://sberbank.online-verif24.net/auth',
            desc: 'Анализируя поддельную ссылку интернет-банка, определите истинный домен 2-го уровня (с зоной .net):',
            expected: 'online-verif24.net'
        },
        {
            url: 'https://schoo1-portal.ru/profile',
            desc: 'В фишинговом домене латинская буква «l» в слове «school» заменена схожей цифрой. Какая цифра использована злоумышленниками?',
            expected: '1'
        },
        {
            url: 'https://mail.yandx-security.ru/inbox',
            desc: 'В фишинговом домене пропущена буква «e» из названия популярного поисковика. Введите доменное имя 2-го уровня:',
            expected: 'yandx-security.ru'
        },
        {
            url: 'https://dnevnik.mos-service.org/grades',
            desc: 'Определите домен второго уровня в подозрительной ссылке электронного дневника (с зоной .org):',
            expected: 'mos-service.org'
