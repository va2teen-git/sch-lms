        document.getElementById('p4-task-desc').textContent = variant.desc;
        document.getElementById('p4-input').value = '';
        p4CurrentExpected = variant.expected.toLowerCase();
    }

    document.getElementById('btn-phase4').addEventListener('click', () => {
        const val = cleanInput(document.getElementById('p4-input').value);
        if (val === p4CurrentExpected) {
            document.getElementById('phase4').classList.add('d-none');
            document.getElementById('phase5').classList.remove('d-none');
            document.getElementById('phase-badge').textContent = 'Шаг 5 из 5';
            initPhase5();
        } else {
            triggerError('ОШИБКА АНАЛИЗА URL: Неверно определен домен 2-го уровня или символ подмены!', () => {
                initPhase4();
            });
        }
    });

    // =========================================================================
    // БАНК ДАННЫХ И ЛОГИКА ФАЗЫ 5: [Кульминация] Законодательство РФ
    // =========================================================================
    const P5_VARIANTS = [
        {
            caseText: 'Ученик подобрал пароль от учетной записи одноклассника в социальной сети, вошел в чужой аккаунт без разрешения владельца и скопировал личные фотографии и файлы.',
            question: 'Какая статья Уголовного кодекса РФ (УК РФ) устанавливает ответственность за неправомерный доступ к компьютерной информации? Введите только номер статьи:',
            expected: ['272', 'ст 272', 'ст. 272', 'статья 272']
        },
        {
            caseText: 'Злоумышленники создали поддельный сайт банка, разослали фишинговые письма и с помощью перехваченных учетных данных похитили денежные средства со счетов граждан через систему дистанционных платежей.',
            question: 'Какая специализированная статья УК РФ предусматривает ответственность за мошенничество в сфере компьютерной информации? Введите номер статьи (например, 159.6):',
            expected: ['159.6', '159,6', 'ст 159.6', 'ст. 159.6', 'статья 159.6']
        },
        {
            caseText: 'Подросток тайно читал личные сообщения и диалоги своих знакомых, после чего опубликовал скриншоты чужой переписки в публичном канале без их согласия.',
            question: 'Какая статья УК РФ защищает конституционную тайну переписки и предусматривает уголовную ответственность за ее нарушение? Введите только номер статьи:',
            expected: ['138', 'ст 138', 'ст. 138', 'статья 138']
        },
        {
            caseText: 'В открытом доступе был опубликован каталог с полными паспортными данными, домашними адресами и личными номерами телефонов сотен школьников без согласия их родителей.',
            question: 'Какой Федеральный закон Российской Федерации о защите персональных данных был грубо нарушен? Введите только номер закона (например, 152):',
            expected: ['152', '152-фз', '152 фз', '№152-фз', '№ 152-фз']
        },
        {
            caseText: 'Правонарушитель использовал вредоносную программу для несанкционированного блокирования доступа к компьютеру директора школы и модификации оценок в электронном журнале.',
            question: 'Под действие какой статьи УК РФ подпадает неправомерный доступ к охраняемой законом компьютерной информации, повлекший модификацию или блокирование данных? Введите номер статьи:',
            expected: ['272', 'ст 272', 'ст. 272', 'статья 272']
        }
    ];

    let p5CurrentExpected = [];

    function initPhase5() {
        const variant = shuffle(P5_VARIANTS)[0];
        document.getElementById('p5-case-desc').textContent = variant.caseText;
        document.getElementById('p5-task-question').textContent = variant.question;
        document.getElementById('p5-input').value = '';
        p5CurrentExpected = variant.expected.map(e => cleanInput(e));
    }

    document.getElementById('btn-phase5').addEventListener('click', () => {
        const val = cleanInput(document.getElementById('p5-input').value);
        if (p5CurrentExpected.includes(val)) {
            document.getElementById('phase5').classList.add('d-none');
            document.getElementById('success-screen').classList.remove('d-none');
            document.getElementById('phase-badge').className = 'badge bg-warning text-dark border border-warning rounded-0 px-3 py-2';
            document.getElementById('phase-badge').textContent = 'Уровень пройден!';
            sendTelemetry('level_complete', 'completed', true);
        } else {
            triggerError('ОШИБКА ПРАВОВОЙ КВАЛИФИКАЦИИ: Неверно указан номер статьи УК РФ или Федерального закона!', () => {
                initPhase5();
            });
        }
    });

    // =========================================================================
    // СТАРТ УРОВНЯ
    // =========================================================================
    initPhase1();
</script>
