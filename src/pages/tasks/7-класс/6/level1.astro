---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
// Уровень 1 (Базовый)
// Тема: Компьютерные вирусы и антивирусные программы (7 класс)
---

<TaskLayout level={1} bodyClass="font-monospace m-0 p-0">
<div class="container-fluid min-vh-100 p-4 rounded-0 bg-dark text-success">
    <div class="row">
        <div class="col-12">
            <!-- Шапка -->
            <div class="d-flex justify-content-between align-items-center border-bottom border-success pb-2 mb-4">
                <h2 class="h4 text-success font-monospace mb-0">ТЕРМИНАЛ ЦЕНТРА КИБЕРБЕЗОПАСНОСТИ // АНАЛИЗ УГРОЗ (УРОВЕНЬ 1)</h2>
                <span class="badge border border-success text-success bg-black rounded-0 px-3 py-2">БАЗОВЫЙ РЕЖИМ</span>
            </div>

            <!-- Блок системных ошибок -->
            <div id="error-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-4" role="alert">
                [СИСТЕМНЫЙ СБОЙ] <span id="error-message">Неверная конфигурация параметров безопасности!</span>
            </div>

            <!-- ================= ФАЗА 1 ================= -->
            <div id="phase1" class="card bg-black border-success rounded-0 mb-4">
                <div class="card-header bg-dark border-success text-success d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 1 ИЗ 3: Классификация перехваченных образцов Malware</span>
                    <span class="badge bg-success text-dark rounded-0">МЕХАНИКА: DRAG-TO-BUCKET</span>
                </div>
                <div class="card-body">
                    <p class="text-light">
                        Служба мониторинга перехватила 4 образца программной активности. Распределите карточки по целевым шлюзам классификации (перетащите мышью или кликните по карточке, затем по шлюзу).
                    </p>

                    <!-- Пул карточек для распределения -->
                    <div class="mb-4">
                        <div class="text-secondary small mb-2 text-uppercase">Перехваченные образцы (зажмите и перетащите в контейнер):</div>
                        <div id="p1-cards-pool" class="d-flex flex-wrap gap-2 p-3 bg-dark border border-secondary min-vh-10" style="min-height: 90px;">
                            <!-- Генерируется через JS -->
                        </div>
                    </div>

                    <!-- Контейнеры (Шлюзы классификации) -->
                    <div class="row g-3 mb-4">
                        <!-- Контейнер: Классический вирус -->
                        <div class="col-md-4">
                            <div class="card bg-dark border-success rounded-0 h-100 p-2 p1-dropzone" data-bucket="virus">
                                <div class="border-bottom border-success pb-2 mb-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-success">1. КЛАССИЧЕСКИЙ ВИРУС</span>
                                    <span class="badge bg-black text-success border border-success count-badge">0</span>
                                </div>
                                <div class="text-secondary small mb-2">Паразитирует в чужих файлах/секторах, требует запуска пользователем.</div>
                                <div class="bucket-slots d-flex flex-column gap-2 p-2 bg-black border border-secondary" style="min-height: 120px;">
                                    <!-- Сюда падают карточки -->
                                </div>
                            </div>
                        </div>

                        <!-- Контейнер: Сетевой червь -->
                        <div class="col-md-4">
                            <div class="card bg-dark border-success rounded-0 h-100 p-2 p1-dropzone" data-bucket="worm">
                                <div class="border-bottom border-success pb-2 mb-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-success">2. СЕТЕВОЙ ЧЕРВЬ</span>
                                    <span class="badge bg-black text-success border border-success count-badge">0</span>
                                </div>
                                <div class="text-secondary small mb-2">Автономный файл, самостоятельно распространяется по сети без участия человека.</div>
                                <div class="bucket-slots d-flex flex-column gap-2 p-2 bg-black border border-secondary" style="min-height: 120px;">
                                    <!-- Сюда падают карточки -->
                                </div>
                            </div>
                        </div>

                        <!-- Контейнер: Троянская программа -->
                        <div class="col-md-4">
                            <div class="card bg-dark border-success rounded-0 h-100 p-2 p1-dropzone" data-bucket="trojan">
                                <div class="border-bottom border-success pb-2 mb-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-success">3. ТРОЯНСКАЯ ПРОГРАММА</span>
                                    <span class="badge bg-black text-success border border-success count-badge">0</span>
                                </div>
                                <div class="text-secondary small mb-2">Маскируется под полезное ПО, принципиально НЕ размножается самостоятельно.</div>
                                <div class="bucket-slots d-flex flex-column gap-2 p-2 bg-black border border-secondary" style="min-height: 120px;">
                                    <!-- Сюда падают карточки -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <button id="btn-phase1" class="btn btn-outline-success rounded-0 px-4 py-2" disabled>Проверить классификацию образцов</button>
                </div>
            </div>

            <!-- ================= ФАЗА 2 ================= -->
            <div id="phase2" class="card bg-black border-success rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-success text-success d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 2 ИЗ 3: Архитектура антивирусного комплекса</span>
                    <span class="badge bg-success text-dark rounded-0">МЕХАНИКА: SLOT & SNAP</span>
                </div>
                <div class="card-body">
                    <p class="text-light">
                        Сконфигурируйте подсистемы антивирусной защиты рабочей станции. Перетащите нужные модули из палитры компонентов в соответствующие целевые слоты задач.
                    </p>

                    <!-- Палитра строительных блоков (токенов) -->
                    <div class="mb-4">
                        <div class="text-secondary small mb-2 text-uppercase">Палитра доступных модулей (включает лишние компоненты):</div>
                        <div id="p2-tokens-palette" class="d-flex flex-wrap gap-2 p-3 bg-dark border border-secondary" style="min-height: 80px;">
                            <!-- Генерируется через JS -->
                        </div>
                    </div>

                    <!-- Целевые слоты задач -->
                    <div class="mb-4">
                        <div class="text-secondary small mb-2 text-uppercase">Целевые функциональные слоты безопасности:</div>
                        <div id="p2-slots-container" class="d-flex flex-column gap-3">
                            <!-- Генерируется через JS -->
                        </div>
                    </div>

                    <button id="btn-phase2" class="btn btn-outline-success rounded-0 px-4 py-2" disabled>Активировать подсистемы защиты</button>
                </div>
            </div>

            <!-- ================= ФАЗА 3 ================= -->
            <div id="phase3" class="card bg-black border-success rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-success text-success d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 3 ИЗ 3: Управление сетевыми шлюзами и отражение атаки</span>
                    <span class="badge bg-success text-dark rounded-0">МЕХАНИКА: INTERACTIVE MATRIX TOGGLE</span>
                </div>
                <div class="card-body">
                    <p class="text-light">
                        Сервер безопасности зафиксировал сетевой трафик по 4 магистральным каналам. Проанализируйте входящие потоки: кликами переключите тумблеры, чтобы заблокировать опасные пакеты и оставить открытыми легитимные службы.
                    </p>

                    <div id="p3-grid-container" class="row g-3 mb-4">
                        <!-- 4 сетевых узла генерируются через JS -->
                    </div>

                    <button id="btn-phase3" class="btn btn-outline-success rounded-0 px-4 py-2">Применить политику безопасности сети</button>
                </div>
            </div>

            <!-- ================= ЭКРАН УСПЕХА ================= -->
            <div id="success-screen" class="card bg-success text-black border-success rounded-0 mb-4 d-none">
                <div class="card-body text-center py-5">
                    <h1 class="display-5 fw-bold mb-3">СИСТЕМА БЕЗОПАСНОСТИ УСПЕШНО АКТИВИРОВАНА</h1>
                    <p class="lead mb-4">Все вредоносные объекты классифицированы, антивирусные модули настроены, периметр защищен.</p>
                    <div class="badge bg-black text-success border border-black rounded-0 fs-6 px-4 py-2">УРОВЕНЬ 1 ЗАВЕРШЕН // СТАТУС: SUCCESS</div>
                </div>
            </div>

        </div>
    </div>
</div>
</TaskLayout>

<script is:inline>
    // ================= ТЕЛЕМЕТРИЯ =================
    const startTime = new Date();
    let attempts = 0;
    const missionName = 'Урок 6 :: Компьютерные вирусы и антивирусные программы (Уровень 1)';

    function sendTelemetry(action_type, status, success) {
        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: action_type,
            status: status,
            start_time: startTime.toISOString(),
            time_spent_sec: Math.floor((new Date() - startTime) / 1000),
            attempts_count: attempts,
            success: success
        }, '*');
    }

    sendTelemetry('in_progress', 'in_progress', false);

    function triggerError(message, retryCallback) {
        attempts++;
        const errorBox = document.getElementById('error-box');
        const errorMessage = document.getElementById('error-message');
        errorMessage.textContent = message;
        errorBox.classList.remove('d-none');

        // Отправка сигнала сброса текущей попытки
        sendTelemetry('hardcore_reset', 'in_progress', false);

        setTimeout(() => {
            errorBox.classList.add('d-none');
            if (retryCallback) retryCallback();
        }, 1500);
    }

    // Вспомогательная утилита перемешивания
    function shuffle(array) {
        const arr = [...array];
        for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr;
    }

    // ================= ДАННЫЕ ФАЗЫ 1 (БАНК ОБРАЗЦОВ) =================
    const P1_SAMPLES_BANK = [
        // Вирусы
        { id: 'v1', type: 'virus', title: 'Образец Alpha-PE', text: 'Внедряет свой код в заголовок файла game.exe и заражает соседние исполняемые файлы при запуске пользователем.' },
        { id: 'v2', type: 'virus', title: 'Макромодуль DOCM', text: 'Скрытый VBA-скрипт в документе отчета; при открытии файла перехватывает сохранение и заражает шаблон Normal.dotm.' },
        { id: 'v3', type: 'virus', title: 'Загрузочный MBR-модуль', text: 'Заражает главную загрузочную запись жесткого диска и стартует при включении ПК до загрузки операционной системы.' },
        { id: 'v4', type: 'virus', title: 'Паразитический инжектор', text: 'Дописывает свои инструкции в конец системной утилиты calc.exe, изменяя точку входа (Entry Point).' },
        // Черви
        { id: 'w1', type: 'worm', title: 'Сетевой сканнер NetScan', text: 'Автономная программа, сканирует адреса подсети и сама копирует себя на чужие ПК через открытый порт 445.' },
        { id: 'w2', type: 'worm', title: 'Массовый почтовый бот', text: 'Считывает адресную книгу почтового клиента и автоматически рассылает письма с копией себя всем контактам без участия человека.' },
        { id: 'w3', type: 'worm', title: 'Автономный модуль SMB', text: 'Использует уязвимость сетевой службы, размножается лавинообразно и полностью забивает пропускную способность каналов школы.' },
        { id: 'w4', type: 'worm', title: 'Червь съемных дисков', text: 'Автоматически распространяется между компьютерами сети, записывая скрытые исполняемые копии на все подключенные общие папки.' },
        // Трояны
        { id: 't1', type: 'trojan', title: 'Утилита SpeedBooster.exe', text: 'Притворяется оптимизатором памяти, но тайно открывает хакеру удаленный доступ к веб-камере (бэкдор). Не размножается.' },
        { id: 't2', type: 'trojan', title: 'Игровой чит CheatPro', text: 'Маскируется под чит для онлайн-игры, скрытно логирует все нажатия клавиш клавиатуры (кейлоггер). Сам не размножается.' },
        { id: 't3', type: 'trojan', title: 'Архив CryptLocker', text: 'Пользователь запустил псевдо-обновление: программа зашифровала все фото и потребовала выкуп. Другие файлы не заражает.' },
        { id: 't4', type: 'trojan', title: 'Плеер MediaPlay.exe', text: 'Внедряет в браузер всплывающие рекламные баннеры (Adware). Не внедряется в файлы и не распространяется по сети.' }
    ];

    let p1SelectedCard = null;
    let p1CurrentItems = [];

    function initPhase1() {
        const pool = document.getElementById('p1-cards-pool');
        pool.innerHTML = '';
        document.querySelectorAll('.bucket-slots').forEach(slot => slot.innerHTML = '');
        document.querySelectorAll('.count-badge').forEach(badge => badge.textContent = '0');
        document.getElementById('btn-phase1').disabled = true;

        // Выбираем процедурно: 1-2 вируса, 1-2 червя, 1-2 трояна (всего 4 карточки)
        const viruses = shuffle(P1_SAMPLES_BANK.filter(s => s.type === 'virus')).slice(0, Math.random() > 0.5 ? 2 : 1);
        const worms = shuffle(P1_SAMPLES_BANK.filter(s => s.type === 'worm')).slice(0, viruses.length === 2 ? 1 : 2);
        const remaining = 4 - (viruses.length + worms.length);
        const trojans = shuffle(P1_SAMPLES_BANK.filter(s => s.type === 'trojan')).slice(0, remaining);

        p1CurrentItems = shuffle([...viruses, ...worms, ...trojans]);

        p1CurrentItems.forEach(item => {
            const card = document.createElement('div');
            card.className = 'card bg-black border border-success p-2 rounded-0 text-light user-select-none p1-card';
            card.style.cursor = 'grab';
            card.style.maxWidth = '280px';
            card.draggable = true;
            card.dataset.id = item.id;
            card.dataset.expected = item.type;
            card.innerHTML = `
                <div class="fw-bold text-success small mb-1">${item.title}</div>
                <div class="small text-secondary lh-sm">${item.text}</div>
            `;

            // Drag события
            card.addEventListener('dragstart', (e) => {
                card.style.cursor = 'grabbing';
                e.dataTransfer.setData('text/plain', item.id);
            });
            card.addEventListener('dragend', () => {
                card.style.cursor = 'grab';
            });

            // Клик-выбор (альтернатива drag & drop для тач/быстрого ввода)
            card.addEventListener('click', (e) => {
                e.stopPropagation();
                document.querySelectorAll('.p1-card').forEach(c => c.classList.remove('border-warning'));
                if (p1SelectedCard === card) {
                    p1SelectedCard = null;
                } else {
                    p1SelectedCard = card;
                    card.classList.add('border-warning');
                }
            });

            pool.appendChild(card);
        });

        updatePhase1State();
    }

    function updatePhase1State() {
        const pool = document.getElementById('p1-cards-pool');
        const remainingInPool = pool.querySelectorAll('.p1-card').length;
        const btn = document.getElementById('btn-phase1');
        btn.disabled = remainingInPool > 0;

        document.querySelectorAll('.p1-dropzone').forEach(dropzone => {
            const count = dropzone.querySelectorAll('.p1-card').length;
            dropzone.querySelector('.count-badge').textContent = count;
        });
    }

    // Настройка зон сброса Фазы 1
    document.querySelectorAll('.p1-dropzone').forEach(zone => {
        zone.addEventListener('dragover', (e) => {
            e.preventDefault();
            zone.classList.add('border-warning');
        });
        zone.addEventListener('dragleave', () => {
            zone.classList.remove('border-warning');
        });
        zone.addEventListener('drop', (e) => {
            e.preventDefault();
            zone.classList.remove('border-warning');
            const cardId = e.dataTransfer.getData('text/plain');
            const card = document.querySelector(`.p1-card[data-id="${cardId}"]`);
            if (card) {
                zone.querySelector('.bucket-slots').appendChild(card);
                updatePhase1State();
            }
        });
        // Клик по корзине перемещает выбранную карточку
        zone.addEventListener('click', () => {
            if (p1SelectedCard) {
                p1SelectedCard.classList.remove('border-warning');
                zone.querySelector('.bucket-slots').appendChild(p1SelectedCard);
                p1SelectedCard = null;
                updatePhase1State();
            }
        });
    });

    // Возврат карточки в исходный пул по клику на пул
    document.getElementById('p1-cards-pool').addEventListener('click', () => {
        if (p1SelectedCard) {
            p1SelectedCard.classList.remove('border-warning');
            document.getElementById('p1-cards-pool').appendChild(p1SelectedCard);
            p1SelectedCard = null;
            updatePhase1State();
        }
    });

    document.getElementById('btn-phase1').addEventListener('click', () => {
        let hasErrors = false;
        document.querySelectorAll('.p1-dropzone').forEach(zone => {
            const expectedBucket = zone.dataset.bucket;
            const cards = zone.querySelectorAll('.p1-card');
            cards.forEach(card => {
                if (card.dataset.expected !== expectedBucket) {
                    hasErrors = true;
                }
            });
        });

        if (hasErrors) {
            triggerError('Один или несколько образцов помещены в неверный шлюз! Процедурная перегенерация вариантов...', () => {
                initPhase1();
            });
        } else {
            // Успех Фазы 1
            document.getElementById('phase1').classList.add('d-none');
            document.getElementById('phase2').classList.remove('d-none');
            initPhase2();
        }
    });

    // ================= ДАННЫЕ ФАЗЫ 2 (АРХИТЕКТУРА АНТИВИРУСА) =================
    const P2_ALL_MODULES = [
        { id: 'm_monitor', name: 'Монитор (Сторож)', desc: 'Фоновый перехват в оперативной памяти и проверка на лету' },
        { id: 'm_scanner', name: 'Сканер (Детектор)', desc: 'Полная проверка файлов диска по расписанию или требованию' },
        { id: 'm_doctor', name: 'Доктор (Фаг)', desc: 'Удаление кода вируса из тела файла и восстановление программы' },
        { id: 'm_auditor', name: 'Ревизор целостности', desc: 'Контроль неизменности контрольных сумм и размеров файлов' },
        { id: 'm_blocker', name: 'Поведенческий блокиратор', desc: 'Перехват подозрительных опасных системных вызовов в реальном времени' }
    ];

    const P2_DISTRACTORS = [
        { id: 'd_zip', name: 'Архиватор ZIP', desc: 'Служебная программа сжатия файлов' },
        { id: 'd_keylog', name: 'Кейлоггер Spy', desc: 'Модуль перехвата нажатий клавиатуры' },
        { id: 'd_defrag', name: 'Дефрагментатор', desc: 'Оптимизация кластеров жесткого диска' }
    ];

    let p2SelectedToken = null;
    let p2ActiveSlots = [];

    function initPhase2() {
        const palette = document.getElementById('p2-tokens-palette');
        const container = document.getElementById('p2-slots-container');
        palette.innerHTML = '';
        container.innerHTML = '';
        document.getElementById('btn-phase2').disabled = true;

        // Выбираем 3 случайных модуля для слотов
        p2ActiveSlots = shuffle(P2_ALL_MODULES).slice(0, 3);

        // Палитра: 3 правильных + 2 дистрактора
        const tokensToDisplay = shuffle([...p2ActiveSlots, ...shuffle(P2_DISTRACTORS).slice(0, 2)]);

        // Рендерим токены
        tokensToDisplay.forEach(item => {
            const token = document.createElement('div');
            token.className = 'badge bg-black border border-success text-success p-2 rounded-0 p2-token user-select-none';
            token.style.cursor = 'grab';
            token.style.fontSize = '0.9rem';
            token.draggable = true;
            token.dataset.id = item.id;
            token.innerHTML = `<span class="fw-bold">${item.name}</span>`;

            token.addEventListener('dragstart', (e) => {
                token.style.cursor = 'grabbing';
                e.dataTransfer.setData('text/plain', item.id);
            });
            token.addEventListener('dragend', () => {
                token.style.cursor = 'grab';
            });
            token.addEventListener('click', (e) => {
                e.stopPropagation();
                document.querySelectorAll('.p2-token').forEach(t => t.classList.remove('border-warning'));
                if (p2SelectedToken === token) {
                    p2SelectedToken = null;
                } else {
                    p2SelectedToken = token;
                    token.classList.add('border-warning');
                }
            });

            palette.appendChild(token);
        });

        // Рендерим 3 целевых слота
        p2ActiveSlots.forEach((slotData, idx) => {
            const slotCard = document.createElement('div');
            slotCard.className = 'card bg-dark border-secondary rounded-0 p-3 p2-slot-card';
            slotCard.dataset.expected = slotData.id;
            slotCard.innerHTML = `
                <div class="row align-items-center">
                    <div class="col-md-7">
                        <div class="text-secondary small">СЛОТ ЗАДАЧИ #${idx + 1}:</div>
                        <div class="text-light fw-bold">${slotData.desc}</div>
                    </div>
                    <div class="col-md-5 mt-2 mt-md-0">
                        <div class="p2-drop-target border border-dashed border-success p-2 text-center bg-black" style="min-height: 48px;">
                            <span class="text-secondary small slot-placeholder">[Перетащите модуль сюда]</span>
                        </div>
                    </div>
                </div>
            `;

            const dropTarget = slotCard.querySelector('.p2-drop-target');
            dropTarget.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropTarget.classList.add('border-warning');
            });
            dropTarget.addEventListener('dragleave', () => {
                dropTarget.classList.remove('border-warning');
            });
            dropTarget.addEventListener('drop', (e) => {
                e.preventDefault();
                dropTarget.classList.remove('border-warning');
                const tokenId = e.dataTransfer.getData('text/plain');
                const token = document.querySelector(`.p2-token[data-id="${tokenId}"]`);
                if (token) {
                    // Если в слоте уже был токен - возвращаем его в палитру
                    const existing = dropTarget.querySelector('.p2-token');
                    if (existing) palette.appendChild(existing);

                    dropTarget.querySelector('.slot-placeholder')?.remove();
                    dropTarget.appendChild(token);
                    updatePhase2State();
                }
            });

            dropTarget.addEventListener('click', () => {
                if (p2SelectedToken) {
                    p2SelectedToken.classList.remove('border-warning');
                    const existing = dropTarget.querySelector('.p2-token');
                    if (existing) palette.appendChild(existing);

                    dropTarget.querySelector('.slot-placeholder')?.remove();
                    dropTarget.appendChild(p2SelectedToken);
                    p2SelectedToken = null;
                    updatePhase2State();
                }
            });

            container.appendChild(slotCard);
        });

        // Возврат токена в палитру по клику
        palette.addEventListener('click', () => {
            if (p2SelectedToken) {
                p2SelectedToken.classList.remove('border-warning');
                palette.appendChild(p2SelectedToken);
                p2SelectedToken = null;
                updatePhase2State();
            }
        });

        updatePhase2State();
    }

    function updatePhase2State() {
        const slots = document.querySelectorAll('.p2-drop-target');
        let filledCount = 0;
        slots.forEach(slot => {
            if (slot.querySelector('.p2-token')) filledCount++;
        });
        document.getElementById('btn-phase2').disabled = filledCount < p2ActiveSlots.length;
    }

    document.getElementById('btn-phase2').addEventListener('click', () => {
        const slotCards = document.querySelectorAll('.p2-slot-card');
        let hasErrors = false;

        slotCards.forEach(card => {
            const expected = card.dataset.expected;
            const token = card.querySelector('.p2-token');
            if (!token || token.dataset.id !== expected) {
                hasErrors = true;
            }
        });

        if (hasErrors) {
            triggerError('Неверное распределение модулей по функциональным слотам! Сброс конфигурации...', () => {
                initPhase2();
            });
        } else {
            // Успех Фазы 2
            document.getElementById('phase2').classList.add('d-none');
            document.getElementById('phase3').classList.remove('d-none');
            initPhase3();
        }
    });

    // ================= ДАННЫЕ ФАЗЫ 3 (ШЛЮЗЫ СЕТИ) =================
    const P3_CHANNELS = [
        {
            name: 'Шлюз почты (Порт 25 / SMTP)',
            safe: { title: 'Легитимное письмо', desc: 'Входящее письмо с текстовым вложением report.txt без исполняемых макросов.', state: 'ALLOW' },
            danger: { title: 'Фишинговая атака', desc: 'Входящее письмо с двойным расширением invoice.pdf.exe и опасной сигнатурой.', state: 'BLOCK' }
        },
        {
            name: 'Веб-трафик (Порты 80, 443 / HTTP, HTTPS)',
            safe: { title: 'Образовательный ресурс', desc: 'Загрузка статьи из проверенной электронной библиотеки с валидным SSL-сертификатом.', state: 'ALLOW' },
            danger: { title: 'Вредоносный сайт (Drive-by)', desc: 'Скрытый редирект на фишинговый домен с попыткой фоновой загрузки трояна-вымогателя.', state: 'BLOCK' }
        },
        {
            name: 'Общий сетевой доступ (Порт 445 / SMB)',
            safe: { title: 'Документооборот школы', desc: 'Штатное обращение к сетевой папке обмена рефератами учителей без аномалий трафика.', state: 'ALLOW' },
            danger: { title: 'Атака сетевого червя', desc: 'Сетевой червь лавинообразно сканирует уязвимость SMBv1 с частотой 15 000 пакетов/сек.', state: 'BLOCK' }
        },
        {
            name: 'Системный шлюз обновлений (WSUS)',
            safe: { title: 'Обновление безопасности ОС', desc: 'Пакет официального патча операционной системы с проверенной цифровой подписью вендора.', state: 'ALLOW' },
            danger: { title: 'Поддельный активатор', desc: 'Несанкционированный запрос на загрузку пиратского активатора с неизвестного IP-адреса.', state: 'BLOCK' }
        }
    ];

    let p3CurrentState = [];

    function initPhase3() {
        const container = document.getElementById('p3-grid-container');
        container.innerHTML = '';
        p3CurrentState = [];

        P3_CHANNELS.forEach((channel, idx) => {
            const isThreat = Math.random() > 0.5;
            const scenario = isThreat ? channel.danger : channel.safe;
            const expectedAction = scenario.state; // 'ALLOW' или 'BLOCK'

            // По умолчанию все шлюзы в нейтральном/ALLOW состоянии
            const nodeState = {
                idx: idx,
                expected: expectedAction,
                current: 'ALLOW'
            };
            p3CurrentState.push(nodeState);

            const col = document.createElement('div');
            col.className = 'col-md-6';
            col.innerHTML = `
                <div class="card bg-dark border-secondary rounded-0 p-3 h-100 p3-node-card" id="p3-card-${idx}">
                    <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-2 mb-2">
                        <span class="text-success fw-bold small">${channel.name}</span>
                        <span class="badge ${isThreat ? 'bg-danger text-light' : 'bg-success text-black'} rounded-0">${isThreat ? 'УГРОЗА ОБНАРУЖЕНА' : 'ШТАТНЫЙ ТРАФИК'}</span>
                    </div>
                    <div class="mb-2">
                        <div class="text-light fw-bold">${scenario.title}</div>
                        <div class="text-secondary small">${scenario.desc}</div>
                    </div>
                    <div class="mt-auto pt-2 border-top border-secondary d-flex justify-content-between align-items-center">
                        <span class="small text-secondary">РЕЖИМ ШЛЮЗА:</span>
                        <button class="btn btn-sm btn-outline-success rounded-0 p3-toggle-btn fw-bold px-3" data-idx="${idx}">
                            🟢 ПРОПУСК (ALLOW)
                        </button>
                    </div>
                </div>
            `;

            container.appendChild(col);
        });

        // Слушатели переключателей
        document.querySelectorAll('.p3-toggle-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const idx = parseInt(btn.dataset.idx);
                const stateObj = p3CurrentState.find(s => s.idx === idx);
                const card = document.getElementById(`p3-card-${idx}`);

                if (stateObj.current === 'ALLOW') {
                    stateObj.current = 'BLOCK';
                    btn.className = 'btn btn-sm btn-danger rounded-0 p3-toggle-btn fw-bold px-3';
                    btn.textContent = '🔴 БЛОКИРОВКА (BLOCK)';
                    card.classList.remove('border-secondary');
                    card.classList.add('border-danger');
                } else {
                    stateObj.current = 'ALLOW';
                    btn.className = 'btn btn-sm btn-outline-success rounded-0 p3-toggle-btn fw-bold px-3';
                    btn.textContent = '🟢 ПРОПУСК (ALLOW)';
                    card.classList.remove('border-danger');
                    card.classList.add('border-secondary');
                }
            });
        });
    }

    document.getElementById('btn-phase3').addEventListener('click', () => {
        let hasErrors = false;
        p3CurrentState.forEach(node => {
            if (node.current !== node.expected) {
                hasErrors = true;
            }
        });

        if (hasErrors) {
            triggerError('Политика безопасности нарушена: пропущен вредоносный трафик либо заблокирована легитимная служба!', () => {
                initPhase3();
            });
        } else {
            // Успешное завершение Уровня 1!
            document.getElementById('phase3').classList.add('d-none');
            document.getElementById('success-screen').classList.remove('d-none');
            sendTelemetry('level_complete', 'completed', true);
        }
    });

    // Старт первой фазы при загрузке
    initPhase1();
</script>
