---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
// Уровень 2: 7 класс, Урок 6 - Компьютерные вирусы и антивирусные программы
// Механика: Аналитика, расчеты, распознавание маскировки (только ручной клавиатурный ввод).
// 5 процедурных фаз. Ошибка = отправка hardcore_reset и процедурная генерация нового варианта.
---

<TaskLayout level={2} bodyClass="font-monospace m-0 p-0">
<div class="container-fluid min-vh-100 p-4 rounded-0 bg-dark text-warning">
    <div class="row">
        <div class="col-12">
            <!-- Шапка -->
            <div class="d-flex justify-content-between align-items-center border-bottom border-warning pb-2 mb-4">
                <h2 class="h4 text-warning font-monospace mb-0">ТЕРМИНАЛ АНАЛИТИКА КИБЕРБЕЗОПАСНОСТИ // ИССЛЕДОВАНИЕ УГРОЗ (УРОВЕНЬ 2)</h2>
                <span class="badge border border-warning text-warning bg-black rounded-0 px-3 py-2">ПРОДВИНУТЫЙ РЕЖИМ</span>
            </div>

            <!-- Блок системных ошибок -->
            <div id="error-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-4" role="alert">
                [ОШИБКА АНАЛИЗА] <span id="error-message">Неверный ответ! Процедурная перегенерация задания...</span>
            </div>

            <!-- ================= ФАЗА 1 ================= -->
            <div id="phase1" class="card bg-black border-warning rounded-0 mb-4">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 1 ИЗ 5: Детектор двойных расширений и маскировки файлов</span>
                    <span class="badge bg-warning text-dark rounded-0">РУЧНОЙ ВВОД</span>
                </div>
                <div class="card-body">
                    <p class="text-light">
                        Злоумышленники часто маскируют вредоносные программы под безобидные документы, используя двойные расширения (например, <code>Документ.docx.exe</code>).
                    </p>
                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">ИМЯ ПЕРЕХВАЧЕННОГО ФАЙЛА В ПИСЬМЕ:</div>
                        <div id="p1-filename" class="fs-4 text-warning fw-bold"></div>
                    </div>
                    <p class="text-light mb-2">
                        Каково <strong>истинное расширение</strong> этого файла, которое операционная система будет использовать для его запуска? Введите расширение без пробелов (например: <code>exe</code>, <code>vbs</code>, <code>bat</code>):
                    </p>
                    <div class="input-group mb-3 w-50">
                        <input type="text" id="input-p1" class="form-control bg-dark text-warning border-warning rounded-0" placeholder="Введите расширение..." autocomplete="off" spellcheck="false">
                        <button id="btn-phase1" class="btn btn-outline-warning rounded-0 px-4">Подтвердить</button>
                    </div>
                </div>
            </div>

            <!-- ================= ФАЗА 2 ================= -->
            <div id="phase2" class="card bg-black border-warning rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 2 ИЗ 5: Аналитика антивирусных логов и таксономия угроз</span>
                    <span class="badge bg-warning text-dark rounded-0">РУЧНОЙ ВВОД</span>
                </div>
                <div class="card-body">
                    <p class="text-light">
                        Изучите системную запись журнала службы безопасности и определите точный тип/класс вредоносной программы по учебнику Полякова.
                    </p>
                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">ЖУРНАЛ СОБЫТИЙ БЕЗОПАСНОСТИ:</div>
                        <div id="p2-log-text" class="fs-5 text-light"></div>
                    </div>
                    <p id="p2-prompt" class="text-light mb-2">
                        Определите тип угрозы и введите название на русском языке (например: <code>кейлоггер</code>, <code>червь</code>, <code>шифровальщик</code>, <code>макровирус</code>, <code>троян</code>, <code>логическая бомба</code>):
                    </p>
                    <div class="input-group mb-3 w-50">
                        <input type="text" id="input-p2" class="form-control bg-dark text-warning border-warning rounded-0" placeholder="Введите тип угрозы..." autocomplete="off" spellcheck="false">
                        <button id="btn-phase2" class="btn btn-outline-warning rounded-0 px-4">Подтвердить</button>
                    </div>
                </div>
            </div>

            <!-- ================= ФАЗА 3 ================= -->
            <div id="phase3" class="card bg-black border-warning rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 3 ИЗ 5: Расчет изменения размера зараженного файла</span>
                    <span class="badge bg-warning text-dark rounded-0">АНАЛИТИЧЕСКИЙ РАСЧЕТ</span>
                </div>
                <div class="card-body">
                    <p class="text-light">
                        Паразитический файловый вирус дописывает свой код в тело программы-хоста. Ревизор целостности зафиксировал изменение размера объекта на диске.
                    </p>
                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">ОТЧЕТ РЕВИЗОРА ЦЕЛОСТНОСТИ ФАЙЛОВОЙ СИСТЕМЫ:</div>
                        <div id="p3-task-text" class="fs-5 text-light"></div>
                    </div>
                    <p id="p3-prompt" class="text-light mb-2">Введите вычисленное числовое значение:</p>
                    <div class="input-group mb-3 w-50">
                        <input type="number" id="input-p3" class="form-control bg-dark text-warning border-warning rounded-0" placeholder="Введите число..." autocomplete="off">
                        <span id="p3-unit" class="input-group-text bg-dark text-warning border-warning rounded-0">КБ</span>
                        <button id="btn-phase3" class="btn btn-outline-warning rounded-0 px-4">Подтвердить</button>
                    </div>
                </div>
            </div>

            <!-- ================= ФАЗА 4 ================= -->
            <div id="phase4" class="card bg-black border-warning rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 4 ИЗ 5: Выбор вердикта антивирусного действия</span>
                    <span class="badge bg-warning text-dark rounded-0">КОМАНДА ОПЕРАТОРА</span>
                </div>
                <div class="card-body">
                    <p class="text-light">
                        Антивирусный комплекс завершил сканирование подозрительного объекта и ожидает команду администратора безопасности.
                    </p>
                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">ВЕРДИКТ СИСТЕМЫ СКАНИРОВАНИЯ:</div>
                        <div id="p4-verdict-text" class="fs-5 text-light"></div>
                    </div>
                    <p class="text-light mb-2">
                        Какое целевое действие необходимо применить к данному файлу? Введите команду на русском языке (<code>лечить</code>, <code>карантин</code> или <code>удалить</code>):
                    </p>
                    <div class="input-group mb-3 w-50">
                        <input type="text" id="input-p4" class="form-control bg-dark text-warning border-warning rounded-0" placeholder="лечить / карантин / удалить..." autocomplete="off" spellcheck="false">
                        <button id="btn-phase4" class="btn btn-outline-warning rounded-0 px-4">Применить действие</button>
                    </div>
                </div>
            </div>

            <!-- ================= ФАЗА 5 ================= -->
            <div id="phase5" class="card bg-black border-warning rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 5 ИЗ 5: Правовая оценка инцидента (Уголовный кодекс РФ)</span>
                    <span class="badge bg-warning text-dark rounded-0">ЗАКОНОДАТЕЛЬСТВО</span>
                </div>
                <div class="card-body">
                    <p class="text-light">
                        Для передачи материалов кибератаки в правоохранительные органы необходимо указать точную статью Уголовного кодекса Российской Федерации.
                    </p>
                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">ПРАВОВАЯ КВАЛИФИКАЦИЯ КИБЕРПРЕСТУПЛЕНИЯ:</div>
                        <div id="p5-law-text" class="fs-5 text-light"></div>
                    </div>
                    <p id="p5-prompt" class="text-light mb-2">Введите только числовое значение (номер статьи или срок):</p>
                    <div class="input-group mb-3 w-50">
                        <input type="number" id="input-p5" class="form-control bg-dark text-warning border-warning rounded-0" placeholder="Введите число..." autocomplete="off">
                        <button id="btn-phase5" class="btn btn-outline-warning rounded-0 px-4">Подтвердить</button>
                    </div>
                </div>
            </div>

            <!-- ================= ЭКРАН УСПЕХА ================= -->
            <div id="success-screen" class="card bg-warning text-black border-warning rounded-0 mb-4 d-none">
                <div class="card-body text-center py-5">
                    <h1 class="display-5 fw-bold mb-3">ЭКСПЕРТНЫЙ АНАЛИЗ УСПЕШНО ЗАВЕРШЕН</h1>
                    <p class="lead mb-4">Все 5 этапов аналитического расследования пройдены: маскировки раскрыты, метрики рассчитаны, правовые статьи подтверждены.</p>
                    <div class="badge bg-black text-warning border border-black rounded-0 fs-6 px-4 py-2">УРОВЕНЬ 2 ЗАВЕРШЕН // СТАТУС: SUCCESS</div>
                </div>
            </div>

        </div>
    </div>
</div>
</TaskLayout>

<script is:inline>
    // ================= ТЕЛЕМЕТРИЯ =================
    const startTime = new Date();
    let attempts = 0;
    const missionName = 'Урок 6 :: Компьютерные вирусы и антивирусные программы (Уровень 2)';

    function sendTelemetry(action_type, status, success) {
        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: action_type,
            status: status,
            start_time: startTime.toISOString(),
            time_spent_sec: Math.floor((new Date() - startTime) / 1000),
            attempts_count: attempts,
            success: success
        }, '*');
    }

    sendTelemetry('in_progress', 'in_progress', false);

    function triggerError(message, retryCallback) {
        attempts++;
        const errorBox = document.getElementById('error-box');
        const errorMessage = document.getElementById('error-message');
        errorMessage.textContent = message;
        errorBox.classList.remove('d-none');

        // Отправка сигнала hardcore_reset
        sendTelemetry('hardcore_reset', 'in_progress', false);

        setTimeout(() => {
            errorBox.classList.add('d-none');
            if (retryCallback) retryCallback();
        }, 1500);
    }

    function shuffle(array) {
        const arr = [...array];
        for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr;
    }

    // ================= ФАЗА 1: ДВОЙНЫЕ РАСШИРЕНИЯ =================
    const P1_VARIANTS = [
        { fakeExt: 'pdf', realExt: 'exe', names: ['Приказ_директора', 'Ведомость_оценок', 'Инструкция_ЕГЭ'] },
        { fakeExt: 'jpg', realExt: 'scr', names: ['Фото_с_линейки', 'Снимок_документа', 'Фотография_класса'] },
        { fakeExt: 'xlsx', realExt: 'vbs', names: ['Финансовый_отчет', 'Табель_посещаемости', 'Смета_ремонта'] },
        { fakeExt: 'docx', realExt: 'bat', names: ['Договор_обучения', 'Реферат_по_истории', 'Текст_доклада'] },
        { fakeExt: 'mp3', realExt: 'cmd', names: ['Гимн_школы', 'Аудиозапись_урока', 'Музыкальный_трек'] },
        { fakeExt: 'png', realExt: 'com', names: ['Схема_проезда', 'Эмблема_класса', 'План_эвакуации'] }
    ];

    let p1CurrentExpected = '';

    function initPhase1() {
        const variant = P1_VARIANTS[Math.floor(Math.random() * P1_VARIANTS.length)];
        const name = variant.names[Math.floor(Math.random() * variant.names.length)];
        const fullName = `${name}.${variant.fakeExt}.${variant.realExt}`;
        p1CurrentExpected = variant.realExt.toLowerCase();

        document.getElementById('p1-filename').textContent = fullName;
        document.getElementById('input-p1').value = '';
        document.getElementById('input-p1').focus();
    }

    function checkPhase1() {
        const val = document.getElementById('input-p1').value.trim().toLowerCase().replace(/^\./, '');
        if (val === p1CurrentExpected) {
            document.getElementById('phase1').classList.add('d-none');
            document.getElementById('phase2').classList.remove('d-none');
            initPhase2();
        } else {
            triggerError(`Неверно! Файл "${document.getElementById('p1-filename').textContent}" запускается по своему последнему расширению. Генерация нового файла...`, () => {
                initPhase1();
            });
        }
    }

    document.getElementById('btn-phase1').addEventListener('click', checkPhase1);
    document.getElementById('input-p1').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') checkPhase1();
    });

    // ================= ФАЗА 2: АНАЛИЗ ЛОГОВ =================
    const P2_VARIANTS = [
        {
            log: 'Служба EDR перехватила скрытый хук функции GetAsyncKeyState / SetWindowsHookEx. Процесс непрерывно сохраняет символы клавиатурного ввода в файл secret.log для последующей кражи паролей.',
            expected: ['кейлоггер', 'keylogger', 'клавиатурный шпион', 'шпион клавиатуры']
        },
        {
            log: 'Сетевой монитор зафиксировал автономный процесс svchost_fake.exe. Без участия пользователя программа непрерывно сканирует адреса подсети и рассылает свои копии через порт 445, забивая трафик.',
            expected: ['червь', 'сетевой червь', 'worm', 'net-worm']
        },
        {
            log: 'На диске обнаружен модуль CryptLocker. За последние 3 минуты зашифрованы 450 файлов .docx и .jpg с заменой расширения на .locked. На рабочий стол выведено требование заплатить выкуп.',
            expected: ['шифровальщик', 'вымогатель', 'программа-вымогатель', 'ransomware', 'винлокер', 'блокировщик']
        },
        {
            log: 'В глобальный шаблон Microsoft Word (Normal.dotm) внедрен скрытый макрос AutoOpen. При каждом открытии любого офисного документа макрос дописывает свой код в открываемый файл.',
            expected: ['макровирус', 'макро-вирус', 'макро вирус', 'macro virus']
        },
        {
            log: 'Пользователь установил бесплатную утилиту GameBooster.exe. Программа не размножается, но скрытно открыла входящий TCP-порт 8088 и предоставила удаленный скрытый контроль над веб-камерой.',
            expected: ['троян', 'троянская программа', 'бэкдор', 'backdoor', 'rat']
        },
        {
            log: 'В коде программы обнаружена инструкция: IF (Date == "13.10.2026") THEN WipeDisk(). Программа находится в спящем состоянии и ожидает наступления указанного условия/даты для запуска вредоносного кода.',
            expected: ['логическая бомба', 'логическая-бомба', 'logic bomb']
        }
    ];

    let p2CurrentExpectedList = [];

    function initPhase2() {
        const item = P2_VARIANTS[Math.floor(Math.random() * P2_VARIANTS.length)];
        p2CurrentExpectedList = item.expected;

        document.getElementById('p2-log-text').textContent = item.log;
        document.getElementById('input-p2').value = '';
        document.getElementById('input-p2').focus();
    }

    function checkPhase2() {
        const val = document.getElementById('input-p2').value.trim().toLowerCase();
        const isMatch = p2CurrentExpectedList.some(exp => val === exp || val.includes(exp));

        if (isMatch && val.length > 0) {
            document.getElementById('phase2').classList.add('d-none');
            document.getElementById('phase3').classList.remove('d-none');
            initPhase3();
        } else {
            triggerError('Неверный класс угрозы! Перепроверьте формулировку в логе. Генерация нового инцидента...', () => {
                initPhase2();
            });
        }
    }

    document.getElementById('btn-phase2').addEventListener('click', checkPhase2);
    document.getElementById('input-p2').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') checkPhase2();
    });

    // ================= ФАЗА 3: РАСЧЕТ РАЗМЕРА =================
    let p3CurrentExpectedNumber = 0;

    function initPhase3() {
        // Два типа задач
        const taskType = Math.random() > 0.5 ? 'new_size' : 'virus_size';

        if (taskType === 'new_size') {
            const origSize = (Math.floor(Math.random() * 8) + 3) * 64; // 192..640 КБ
            const virusSize = (Math.floor(Math.random() * 5) + 2) * 8; // 16..48 КБ
            p3CurrentExpectedNumber = origSize + virusSize;

            document.getElementById('p3-task-text').innerHTML = 
                `Исходный размер исполняемого файла <code>system_utility.exe</code> составлял <strong>${origSize} КБ</strong>. ` +
                `Паразитический вирус внедрился в файл, дописав код размером <strong>${virusSize} КБ</strong>. ` +
                `Чему равен новый размер зараженного файла на жестком диске (в КБ)?`;
            document.getElementById('p3-prompt').textContent = 'Введите новый размер файла в КБ (только число):';
        } else {
            const origSize = (Math.floor(Math.random() * 6) + 4) * 100; // 400..900 КБ
            const delta = (Math.floor(Math.random() * 6) + 3) * 12; // 36..96 КБ
            const finalSize = origSize + delta;
            p3CurrentExpectedNumber = delta;

            document.getElementById('p3-task-text').innerHTML = 
                `До заражения размер текстового процессора составлял <strong>${origSize} КБ</strong>. ` +
                `После вирусной атаки размер файла на диске вырос до <strong>${finalSize} КБ</strong>. ` +
                `Каков точный объем внедренного вирусного кода в КБ?`;
            document.getElementById('p3-prompt').textContent = 'Введите объем внедренного кода в КБ (только число):';
        }

        document.getElementById('input-p3').value = '';
        document.getElementById('input-p3').focus();
    }

    function checkPhase3() {
        const val = parseInt(document.getElementById('input-p3').value.trim(), 10);
        if (val === p3CurrentExpectedNumber) {
            document.getElementById('phase3').classList.add('d-none');
            document.getElementById('phase4').classList.remove('d-none');
            initPhase4();
        } else {
            triggerError(`Ошибка в вычислениях! Ожидалось верное расчетное значение. Генерация новых параметров...`, () => {
                initPhase3();
            });
        }
    }

    document.getElementById('btn-phase3').addEventListener('click', checkPhase3);
    document.getElementById('input-p3').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') checkPhase3();
    });

    // ================= ФАЗА 4: ВЫБОР ДЕЙСТВИЯ =================
    const P4_VARIANTS = [
        {
            verdict: 'В системном файле notepad.exe обнаружен файловый вирус. Тело вируса локализовано в конце файла, сигнатура известна. Исходный код программы может быть полностью восстановлен без повреждений.',
            expected: ['лечить', 'дезинфекция', 'вылечить', 'лечение', 'cure', 'disinfect']
        },
        {
            verdict: 'Обнаружен ранее неизвестный подозрительный файл с полиморфными инструкциями. Точный вердикт не ясен. Чтобы файл не навредил системе, но сохранился в зашифрованном виде для отправки в лабораторию, куда его поместить?',
            expected: ['карантин', 'изоляция', 'в карантин', 'quarantine']
        },
        {
            verdict: 'Во временном каталоге AppData\\Local\\Temp обнаружен исполняемый дроппер трояна helper_setup.exe. Полезного кода не содержит, восстановлению не подлежит, представляет прямую опасность.',
            expected: ['удалить', 'удаление', 'стереть', 'delete']
        }
    ];

    let p4CurrentExpectedList = [];

    function initPhase4() {
        const item = P4_VARIANTS[Math.floor(Math.random() * P4_VARIANTS.length)];
        p4CurrentExpectedList = item.expected;

        document.getElementById('p4-verdict-text').textContent = item.verdict;
        document.getElementById('input-p4').value = '';
        document.getElementById('input-p4').focus();
    }

    function checkPhase4() {
        const val = document.getElementById('input-p4').value.trim().toLowerCase();
        const isMatch = p4CurrentExpectedList.some(exp => val === exp);

        if (isMatch) {
            document.getElementById('phase4').classList.add('d-none');
            document.getElementById('phase5').classList.remove('d-none');
            initPhase5();
        } else {
            triggerError('Неверно выбранное действие! Для ценных файлов используют лечение, для неизвестных - карантин, для бесполезного зловреда - удаление. Регенерация...', () => {
                initPhase4();
            });
        }
    }

    document.getElementById('btn-phase4').addEventListener('click', checkPhase4);
    document.getElementById('input-p4').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') checkPhase4();
    });

    // ================= ФАЗА 5: ПРАВОВАЯ СТАТЬЯ =================
    const P5_VARIANTS = [
        {
            text: 'По какой статье Уголовного кодекса Российской Федерации (УК РФ) наказывается «Создание, распространение или использование вредоносных компьютерных программ»?',
            prompt: 'Введите только номер статьи УК РФ (число):',
            expected: 273
        },
        {
            text: 'Согласно статье 273 Уголовного кодекса РФ, за создание и умышленное распространение вредоносных программ, повлекших тяжкие последствия, предусмотрено лишение свободы на максимальный срок до N лет.',
            prompt: 'Введите максимальный срок лишения свободы в годах (число):',
            expected: 7
        }
    ];

    let p5CurrentExpected = 0;

    function initPhase5() {
        const item = P5_VARIANTS[Math.floor(Math.random() * P5_VARIANTS.length)];
        p5CurrentExpected = item.expected;

        document.getElementById('p5-law-text').textContent = item.text;
        document.getElementById('p5-prompt').textContent = item.prompt;
        document.getElementById('input-p5').value = '';
        document.getElementById('input-p5').focus();
    }

    function checkPhase5() {
        const val = parseInt(document.getElementById('input-p5').value.trim(), 10);
        if (val === p5CurrentExpected) {
            // Успешное завершение Уровня 2!
            document.getElementById('phase5').classList.add('d-none');
            document.getElementById('success-screen').classList.remove('d-none');
            sendTelemetry('level_complete', 'completed', true);
        } else {
            triggerError('Неверно! Вспомните материалы теории (статья 273 УК РФ и до 7 лет лишения свободы). Повторный опрос...', () => {
                initPhase5();
            });
        }
    }

    document.getElementById('btn-phase5').addEventListener('click', checkPhase5);
    document.getElementById('input-p5').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') checkPhase5();
    });

    // Запуск первой фазы при загрузке
    initPhase1();
</script>
