---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
// Уровень 1 (Базовый)
// Тема: Компьютерные сети. Поиск информации в сети Интернет (7 класс)
---

<TaskLayout level={1} bodyClass="font-monospace m-0 p-0">
<div class="container-fluid min-vh-100 p-4 rounded-0 bg-dark text-success">
    <div class="row">
        <div class="col-12">
            <!-- Шапка -->
            <div class="d-flex justify-content-between align-items-center border-bottom border-success pb-2 mb-4">
                <h2 class="h4 text-success font-monospace mb-0">СЕТЕВОЙ ЦЕНТР УПРАВЛЕНИЯ // АРХИТЕКТУРА И МАРШРУТИЗАЦИЯ (УРОВЕНЬ 1)</h2>
                <span class="badge border border-success text-success bg-black rounded-0 px-3 py-2">БАЗОВЫЙ РЕЖИМ</span>
            </div>

            <!-- Блок системных ошибок -->
            <div id="error-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-4" role="alert">
                [СИСТЕМНЫЙ СБОЙ] <span id="error-message">Неверная конфигурация сетевых параметров!</span>
            </div>

            <!-- ================= ФАЗА 1 ================= -->
            <div id="phase1" class="card bg-black border-success rounded-0 mb-4">
                <div class="card-header bg-dark border-success text-success d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 1 ИЗ 3: Классификация доменных зон Интернета (DNS)</span>
                    <span class="badge bg-success text-dark rounded-0">МЕХАНИКА: DRAG-TO-BUCKET</span>
                </div>
                <div class="card-body">
                    <p class="text-light">
                        Сервер DNS принял пакет зарегистрированных доменов верхнего уровня (TLD). Распределите поступающие доменные зоны по целевым шлюзам (перетащите карточки мышью или кликните сначала по карточке, затем по нужному шлюзу).
                    </p>

                    <!-- Пул карточек для распределения -->
                    <div class="mb-4">
                        <div class="text-secondary small mb-2 text-uppercase">Поступившие доменные зоны (перетащите в шлюзы):</div>
                        <div id="p1-cards-pool" class="d-flex flex-wrap gap-2 p-3 bg-dark border border-secondary" style="min-height: 90px;">
                            <!-- Генерируется через JS -->
                        </div>
                    </div>

                    <!-- Контейнеры (Шлюзы классификации) -->
                    <div class="row g-3 mb-4">
                        <!-- Контейнер: Географические домены -->
                        <div class="col-md-6">
                            <div class="card bg-dark border-success rounded-0 h-100 p-2 p1-dropzone" data-bucket="geo">
                                <div class="border-bottom border-success pb-2 mb-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-success">1. ГЕОГРАФИЧЕСКИЕ (НАЦИОНАЛЬНЫЕ) ДОМЕНЫ</span>
                                    <span class="badge bg-black text-success border border-success count-badge">0</span>
                                </div>
                                <div class="text-secondary small mb-2">Обозначают конкретные страны и государственные территории (.ru, .рф, .su, .by, .de...).</div>
                                <div class="bucket-slots d-flex flex-column gap-2 p-2 bg-black border border-secondary" style="min-height: 140px;">
                                    <!-- Сюда падают карточки -->
                                </div>
                            </div>
                        </div>

                        <!-- Контейнер: Общие тематические домены -->
                        <div class="col-md-6">
                            <div class="card bg-dark border-success rounded-0 h-100 p-2 p1-dropzone" data-bucket="generic">
                                <div class="border-bottom border-success pb-2 mb-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-success">2. ОБЩИЕ ТЕМАТИЧЕСКИЕ ДОМЕНЫ НАЗНАЧЕНИЯ</span>
                                    <span class="badge bg-black text-success border border-success count-badge">0</span>
                                </div>
                                <div class="text-secondary small mb-2">Обозначают сферу деятельности: коммерция, образование, госорганы (.com, .org, .edu, .gov...).</div>
                                <div class="bucket-slots d-flex flex-column gap-2 p-2 bg-black border border-secondary" style="min-height: 140px;">
                                    <!-- Сюда падают карточки -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <button id="btn-phase1" class="btn btn-outline-success rounded-0 px-4 py-2" disabled>Проверить классификацию доменов</button>
                </div>
            </div>

            <!-- ================= ФАЗА 2 ================= -->
            <div id="phase2" class="card bg-black border-success rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-success text-success d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 2 ИЗ 3: Конструирование универсального адреса документа (URL)</span>
                    <span class="badge bg-success text-dark rounded-0">МЕХАНИКА: SLOT & SNAP</span>
                </div>
                <div class="card-body">
                    <div class="alert alert-dark bg-dark border-secondary text-light rounded-0 mb-3">
                        <div class="fw-bold text-success mb-1">ТЕКУЩАЯ СЕТЕВАЯ МИССИЯ:</div>
                        <div id="p2-mission-prompt" class="small text-light">Загрузка задания...</div>
                    </div>

                    <p class="text-light">
                        Соберите валидный URL-адрес документа в строгой последовательности стандартов Всемирной паутины (WWW). Перетащите нужные токены из палитры компонентов в соответствующие целевые слоты (в палитре присутствуют лишние дистракторы!).
                    </p>

                    <!-- Палитра строительных блоков (токенов) -->
                    <div class="mb-4">
                        <div class="text-secondary small mb-2 text-uppercase">Палитра доступных блоков адреса (кликните для выбора):</div>
                        <div id="p2-tokens-palette" class="d-flex flex-wrap gap-2 p-3 bg-dark border border-secondary" style="min-height: 80px;">
                            <!-- Генерируется через JS -->
                        </div>
                    </div>

                    <!-- Целевые слоты URL-адреса -->
                    <div class="mb-4">
                        <div class="text-secondary small mb-2 text-uppercase">Целевые слоты структуры URL (нажмите на слот для размещения):</div>
                        <div class="row g-2" id="p2-slots-row">
                            <!-- 4 слота: Протокол, Домен, Каталог, Имя файла -->
                        </div>
                    </div>

                    <!-- Предварительный просмотр собираемого URL -->
                    <div class="p-2 mb-4 bg-black border border-secondary text-secondary small d-flex align-items-center gap-2">
                        <span class="text-success fw-bold">URL PREVIEW:</span>
                        <span id="p2-url-preview" class="font-monospace text-light">-- не собран --</span>
                    </div>

                    <button id="btn-phase2" class="btn btn-outline-success rounded-0 px-4 py-2" disabled>Собрать и проверить URL-адрес</button>
                </div>
            </div>

            <!-- ================= ФАЗА 3 ================= -->
            <div id="phase3" class="card bg-black border-success rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-success text-success d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 3 ИЗ 3: Коммутация оборудования локальной сети (Топология «Звезда»)</span>
                    <span class="badge bg-success text-dark rounded-0">МЕХАНИКА: INTERACTIVE PORT MATRIX</span>
                </div>
                <div class="card-body">
                    <p class="text-light">
                        Для школьного компьютерного класса развертывается локальная сеть с топологией «Звезда». К центральному коммутатору (свитчу) необходимо подключить 4 сетевых узла. Проанализируйте тип устройства и физическое расстояние: кликами по портам выберите правильный физический канал передачи данных.
                    </p>

                    <!-- Схема коммутатора и узлов -->
                    <div id="p3-nodes-container" class="row g-3 mb-4">
                        <!-- 4 сетевых узла генерируются через JS -->
                    </div>

                    <button id="btn-phase3" class="btn btn-outline-success rounded-0 px-4 py-2">Активировать линки коммутатора</button>
                </div>
            </div>

            <!-- ================= ЭКРАН УСПЕХА ================= -->
            <div id="success-screen" class="card bg-success text-black border-success rounded-0 mb-4 d-none">
                <div class="card-body text-center py-5">
                    <h1 class="display-5 fw-bold mb-3">СЕТЕВОЙ ЦЕНТР УСПЕШНО АКТИВИРОВАН</h1>
                    <p class="lead mb-4">Доменные зоны классифицированы, структура URL собрана без ошибок, линки коммутатора стабильны.</p>
                    <div class="badge bg-black text-success border border-black rounded-0 fs-6 px-4 py-2">УРОВЕНЬ 1 ЗАВЕРШЕН // СТАТУС: SUCCESS</div>
                </div>
            </div>

        </div>
    </div>
</div>
</TaskLayout>

<script is:inline>
    // ================= ТЕЛЕМЕТРИЯ =================
    const startTime = new Date();
    let attempts = 0;
    const missionName = '7 класс :: Урок 7 :: Компьютерные сети. Поиск информации в сети Интернет (Уровень 1)';

    function sendTelemetry(action_type, status, success) {
        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: action_type,
            status: status,
            start_time: startTime.toISOString(),
            time_spent_sec: Math.floor((new Date() - startTime) / 1000),
            attempts_count: attempts,
            success: success
        }, '*');
    }

    sendTelemetry('in_progress', 'in_progress', false);

    function triggerError(message, retryCallback) {
        attempts++;
        const errorBox = document.getElementById('error-box');
        const errorMessage = document.getElementById('error-message');
        errorMessage.textContent = message;
        errorBox.classList.remove('d-none');

        // Отправка сигнала сброса текущей попытки
        sendTelemetry('hardcore_reset', 'in_progress', false);

        setTimeout(() => {
            errorBox.classList.add('d-none');
            if (retryCallback) retryCallback();
        }, 1500);
    }

    // Вспомогательная утилита перемешивания массива
    function shuffle(array) {
        const arr = [...array];
        for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr;
    }

    // =========================================================================
    // ДАННЫЕ И ЛОГИКА ФАЗЫ 1: Классификация доменных зон (Drag-to-Bucket)
    // =========================================================================
    const P1_DOMAINS_BANK = [
        // Географические домены
        { id: 'geo_ru', type: 'geo', domain: '.ru', title: 'Российская Федерация', desc: 'Основной национальный домен России (латиница)' },
        { id: 'geo_rf', type: 'geo', domain: '.рф', title: 'Россия (кириллица)', desc: 'Кириллический национальный домен Российской Федерации' },
        { id: 'geo_su', type: 'geo', domain: '.su', title: 'Советский Союз (исторический)', desc: 'Действующий домен бывшего СССР (Soviet Union)' },
        { id: 'geo_by', type: 'geo', domain: '.by', title: 'Республика Беларусь', desc: 'Национальный домен государства Беларусь' },
        { id: 'geo_kz', type: 'geo', domain: '.kz', title: 'Республика Казахстан', desc: 'Национальный домен государства Казахстан' },
        { id: 'geo_de', type: 'geo', domain: '.de', title: 'Германия (Deutschland)', desc: 'Национальный домен Федеративной Республики Германия' },
        { id: 'geo_cn', type: 'geo', domain: '.cn', title: 'Китай (China)', desc: 'Национальный домен Китайской Народной Республики' },
        { id: 'geo_uk', type: 'geo', domain: '.uk', title: 'Великобритания (United Kingdom)', desc: 'Национальный географический домен Соединенного Королевства' },
        { id: 'geo_fr', type: 'geo', domain: '.fr', title: 'Франция (France)', desc: 'Национальный географический домен Французской Республики' },
        // Общие тематические домены
        { id: 'gen_com', type: 'generic', domain: '.com', title: 'Коммерческие структуры', desc: 'Домен для коммерческих компаний и предприятий (commercial)' },
        { id: 'gen_org', type: 'generic', domain: '.org', title: 'Некоммерческие организации', desc: 'Для некоммерческих и общественных объединений (organization)' },
        { id: 'gen_edu', type: 'generic', domain: '.edu', title: 'Образовательные учреждения', desc: 'Для школ, колледжей и университетов (education)' },
        { id: 'gen_gov', type: 'generic', domain: '.gov', title: 'Государственные органы', desc: 'Для официальных государственных органов власти (government)' },
        { id: 'gen_net', type: 'generic', domain: '.net', title: 'Сетевые организации', desc: 'Для провайдеров и структур сетевой инфраструктуры (network)' },
        { id: 'gen_info', type: 'generic', domain: '.info', title: 'Информационные ресурсы', desc: 'Общий домен для справочников и энциклопедий (information)' },
        { id: 'gen_mil', type: 'generic', domain: '.mil', title: 'Военные ведомства', desc: 'Домен для оборонных ведомств и армейских структур (military)' }
    ];

    let p1SelectedCard = null;
    let p1CurrentItems = [];

    function initPhase1() {
        const pool = document.getElementById('p1-cards-pool');
        pool.innerHTML = '';
        document.querySelectorAll('.bucket-slots').forEach(slot => slot.innerHTML = '');
        document.querySelectorAll('.count-badge').forEach(badge => badge.textContent = '0');
        document.getElementById('btn-phase1').disabled = true;
        p1SelectedCard = null;

        // Выбираем 5 карточек: 2-3 географических и 2-3 общих (всего 5 штук)
        const geoCount = Math.random() > 0.5 ? 3 : 2;
        const genCount = 5 - geoCount;

        const geoItems = shuffle(P1_DOMAINS_BANK.filter(d => d.type === 'geo')).slice(0, geoCount);
        const genItems = shuffle(P1_DOMAINS_BANK.filter(d => d.type === 'generic')).slice(0, genCount);

        p1CurrentItems = shuffle([...geoItems, ...genItems]);

        p1CurrentItems.forEach(item => {
            const card = document.createElement('div');
            card.className = 'card bg-black border border-success p-2 rounded-0 text-light user-select-none p1-card';
            card.style.cursor = 'grab';
            card.style.maxWidth = '260px';
            card.draggable = true;
            card.dataset.id = item.id;
            card.dataset.expected = item.type;
            card.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="badge bg-success text-dark font-monospace fw-bold">${item.domain}</span>
                    <span class="small text-secondary font-monospace">TLD</span>
                </div>
                <div class="fw-bold text-success small mb-1">${item.title}</div>
                <div class="small text-secondary lh-sm">${item.desc}</div>
            `;

            // HTML5 Drag-and-Drop
            card.addEventListener('dragstart', (e) => {
                e.dataTransfer.setData('text/plain', item.id);
                card.classList.add('opacity-50');
            });
            card.addEventListener('dragend', () => {
                card.classList.remove('opacity-50');
            });

            // Клик для выбора карточки
            card.addEventListener('click', (e) => {
                e.stopPropagation();
                if (p1SelectedCard === card) {
                    p1SelectedCard.classList.remove('border-warning', 'border-2');
                    p1SelectedCard = null;
                } else {
                    if (p1SelectedCard) p1SelectedCard.classList.remove('border-warning', 'border-2');
                    p1SelectedCard = card;
                    card.classList.add('border-warning', 'border-2');
                }
            });

            pool.appendChild(card);
        });

        // Навешиваем слушатели на дроп-зоны шлюзов
        document.querySelectorAll('.p1-dropzone').forEach(zone => {
            zone.addEventListener('dragover', (e) => {
                e.preventDefault();
                zone.classList.add('border-warning');
            });
            zone.addEventListener('dragleave', () => {
                zone.classList.remove('border-warning');
            });
            zone.addEventListener('drop', (e) => {
                e.preventDefault();
                zone.classList.remove('border-warning');
                const cardId = e.dataTransfer.getData('text/plain');
                const cardElem = document.querySelector(`.p1-card[data-id="${cardId}"]`);
                if (cardElem) {
                    moveCardToBucket(cardElem, zone);
                }
            });

            // Поддержка перемещения по клику
            zone.addEventListener('click', () => {
                if (p1SelectedCard) {
                    moveCardToBucket(p1SelectedCard, zone);
                    p1SelectedCard.classList.remove('border-warning', 'border-2');
                    p1SelectedCard = null;
                }
            });
        });
    }

    function moveCardToBucket(card, zone) {
        const slotsContainer = zone.querySelector('.bucket-slots');
        slotsContainer.appendChild(card);
        updateP1Counts();
    }

    function updateP1Counts() {
        document.querySelectorAll('.p1-dropzone').forEach(zone => {
            const count = zone.querySelectorAll('.p1-card').length;
            zone.querySelector('.count-badge').textContent = count;
        });

        const poolCount = document.querySelectorAll('#p1-cards-pool .p1-card').length;
        document.getElementById('btn-phase1').disabled = (poolCount > 0);
    }

    document.getElementById('btn-phase1').addEventListener('click', () => {
        let isCorrect = true;
        document.querySelectorAll('.p1-dropzone').forEach(zone => {
            const expectedType = zone.dataset.bucket;
            const cards = zone.querySelectorAll('.p1-card');
            cards.forEach(card => {
                if (card.dataset.expected !== expectedType) {
                    isCorrect = false;
                }
            });
        });

        if (isCorrect) {
            document.getElementById('phase1').classList.add('d-none');
            document.getElementById('phase2').classList.remove('d-none');
            initPhase2();
        } else {
            triggerError('ОШИБКА МАРШРУТИЗАЦИИ: Некоторые доменные зоны распределены неверно!', () => {
                initPhase1();
            });
        }
    });

    // =========================================================================
    // ДАННЫЕ И ЛОГИКА ФАЗЫ 2: Конструирование URL-адреса (Slot & Snap)
    // =========================================================================
    const P2_SCENARIOS = [
        {
            prompt: 'Соберите защищенный URL для скачивания учебного пособия по сетям «guide.pdf» с образовательного портала «school-collection.edu.ru» из каталога «materials/» по безопасному протоколу «https».',
            expected: {
                protocol: 'https://',
                domain: 'school-collection.edu.ru',
                path: 'materials/',
                file: 'guide.pdf'
            },
            distractors: ['http://', 'ftp://', 'school-collection.ru', 'download/', 'guide.docx']
        },
        {
            prompt: 'Соберите URL для перехода на страницу учебника «probook.htm» авторского сайта К.Ю. Полякова «kpolyakov.spb.ru» в разделе «school/» по стандартному веб-протоколу «http».',
            expected: {
                protocol: 'http://',
                domain: 'kpolyakov.spb.ru',
                path: 'school/',
                file: 'probook.htm'
            },
            distractors: ['https://', 'ftp://', 'polyakov.ru', 'books/', 'probook.pdf']
        },
        {
            prompt: 'Соберите защищенный URL для просмотра государственного доклада «report.pdf» с официального портала «kremlin.ru» в каталоге «documents/» по безопасному протоколу «https».',
            expected: {
                protocol: 'https://',
                domain: 'kremlin.ru',
                path: 'documents/',
                file: 'report.pdf'
            },
            distractors: ['http://', 'ftp://', 'kremlin.com', 'archive/', 'report.txt']
        },
        {
            prompt: 'Соберите URL для скачивания дистрибутива браузера «setup.exe» с файлового FTP-сервера школы «ftp.school7.ru» из архива «distrib/» по протоколу передачи файлов «ftp».',
            expected: {
                protocol: 'ftp://',
                domain: 'ftp.school7.ru',
                path: 'distrib/',
                file: 'setup.exe'
            },
            distractors: ['https://', 'http://', 'school7.ru', 'files/', 'setup.zip']
        }
    ];

    let p2CurrentScenario = null;
    let p2SelectedToken = null;

    function initPhase2() {
        const palette = document.getElementById('p2-tokens-palette');
        const slotsRow = document.getElementById('p2-slots-row');
        palette.innerHTML = '';
        slotsRow.innerHTML = '';
        document.getElementById('btn-phase2').disabled = true;
        document.getElementById('p2-url-preview').textContent = '-- не собран --';
        p2SelectedToken = null;

        p2CurrentScenario = P2_SCENARIOS[Math.floor(Math.random() * P2_SCENARIOS.length)];
        document.getElementById('p2-mission-prompt').textContent = p2CurrentScenario.prompt;

        // Определяем 4 слота
        const slotsDef = [
            { type: 'protocol', label: '1. ПРОТОКОЛ', placeholder: 'протокол://' },
            { type: 'domain', label: '2. СЕРВЕР (ХОСТ)', placeholder: 'домен_сервера' },
            { type: 'path', label: '3. КАТАЛОГ (ПУТЬ)', placeholder: 'каталог/' },
            { type: 'file', label: '4. ИМЯ ФАЙЛА', placeholder: 'имя_файла.ext' }
        ];

        slotsDef.forEach(s => {
            const col = document.createElement('div');
            col.className = 'col-md-3 p2-slot-card';
            col.dataset.slotType = s.type;
            col.dataset.expected = p2CurrentScenario.expected[s.type];
            col.innerHTML = `
                <div class="card bg-dark border border-secondary p-2 h-100 rounded-0">
                    <div class="small text-secondary fw-bold mb-1">${s.label}</div>
                    <div class="p2-drop-target bg-black border border-dashed border-success p-2 text-center text-truncate text-secondary rounded-0 d-flex align-items-center justify-content-center" style="min-height: 52px; cursor: pointer;">
                        <span class="placeholder-text small text-secondary">${s.placeholder}</span>
                    </div>
                </div>
            `;

            const dropTarget = col.querySelector('.p2-drop-target');

            // Клик по слоту: разместить выбранный токен или вернуть назад в палитру
            dropTarget.addEventListener('click', () => {
                const existingToken = dropTarget.querySelector('.p2-token');
                if (p2SelectedToken) {
                    if (existingToken) {
                        palette.appendChild(existingToken);
                    }
                    dropTarget.innerHTML = '';
                    dropTarget.appendChild(p2SelectedToken);
                    p2SelectedToken.classList.remove('border-warning', 'border-2');
                    p2SelectedToken = null;
                    updateP2State();
                } else if (existingToken) {
                    palette.appendChild(existingToken);
                    dropTarget.innerHTML = `<span class="placeholder-text small text-secondary">${s.placeholder}</span>`;
                    updateP2State();
                }
            });

            // HTML5 Drag over / drop
            dropTarget.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropTarget.classList.add('border-warning');
            });
            dropTarget.addEventListener('dragleave', () => {
                dropTarget.classList.remove('border-warning');
            });
            dropTarget.addEventListener('drop', (e) => {
                e.preventDefault();
                dropTarget.classList.remove('border-warning');
                const tokenId = e.dataTransfer.getData('text/plain');
                const tokenElem = document.querySelector(`.p2-token[data-id="${tokenId}"]`);
                if (tokenElem) {
                    const existingToken = dropTarget.querySelector('.p2-token');
                    if (existingToken) {
                        palette.appendChild(existingToken);
                    }
                    dropTarget.innerHTML = '';
                    dropTarget.appendChild(tokenElem);
                    updateP2State();
                }
            });

            slotsRow.appendChild(col);
        });

        // Формируем токены: 4 правильных + дистракторы
        const tokensList = [
            { id: 't_prot', type: 'protocol', text: p2CurrentScenario.expected.protocol },
            { id: 't_dom', type: 'domain', text: p2CurrentScenario.expected.domain },
            { id: 't_path', type: 'path', text: p2CurrentScenario.expected.path },
            { id: 't_file', type: 'file', text: p2CurrentScenario.expected.file }
        ];

        p2CurrentScenario.distractors.forEach((dText, idx) => {
            tokensList.push({ id: `d_${idx}`, type: 'distractor', text: dText });
        });

        const shuffledTokens = shuffle(tokensList);

        shuffledTokens.forEach(t => {
            const token = document.createElement('div');
            token.className = 'badge bg-black border border-success text-success p-2 fs-6 rounded-0 p2-token user-select-none';
            token.style.cursor = 'grab';
            token.draggable = true;
            token.dataset.id = t.id;
            token.dataset.val = t.text;
            token.textContent = t.text;

            token.addEventListener('dragstart', (e) => {
                e.dataTransfer.setData('text/plain', t.id);
                token.classList.add('opacity-50');
            });
            token.addEventListener('dragend', () => {
                token.classList.remove('opacity-50');
            });

            token.addEventListener('click', (e) => {
                e.stopPropagation();
                if (p2SelectedToken === token) {
                    p2SelectedToken.classList.remove('border-warning', 'border-2');
                    p2SelectedToken = null;
                } else {
                    if (p2SelectedToken) p2SelectedToken.classList.remove('border-warning', 'border-2');
                    p2SelectedToken = token;
                    token.classList.add('border-warning', 'border-2');
                }
            });

            palette.appendChild(token);
        });
    }

    function updateP2State() {
        const slots = document.querySelectorAll('.p2-slot-card');
        let allFilled = true;
        const parts = [];

        slots.forEach(slot => {
            const token = slot.querySelector('.p2-token');
            if (token) {
                parts.push(token.dataset.val);
            } else {
                allFilled = false;
            }
        });

        const previewElem = document.getElementById('p2-url-preview');
        if (allFilled) {
            previewElem.textContent = parts.join('');
            document.getElementById('btn-phase2').disabled = false;
        } else {
            previewElem.textContent = parts.length > 0 ? parts.join('') + '...' : '-- не собран --';
            document.getElementById('btn-phase2').disabled = true;
        }
    }

    document.getElementById('btn-phase2').addEventListener('click', () => {
        const slots = document.querySelectorAll('.p2-slot-card');
        let isSuccess = true;

        slots.forEach(slot => {
            const expectedVal = slot.dataset.expected;
            const token = slot.querySelector('.p2-token');
            if (!token || token.dataset.val !== expectedVal) {
                isSuccess = false;
            }
        });

        if (isSuccess) {
            document.getElementById('phase2').classList.add('d-none');
            document.getElementById('phase3').classList.remove('d-none');
            initPhase3();
        } else {
            triggerError('ОШИБКА СИНТАКСИСА URL: Компоненты адреса документа собраны неверно!', () => {
                initPhase2();
            });
        }
    });

    // =========================================================================
    // ДАННЫЕ И ЛОГИКА ФАЗЫ 3: Коммутация сети «Звезда» (Interactive Port Matrix)
    // =========================================================================
    const CABLE_TYPES = [
        { key: 'none', label: 'ОТКЛЮЧЕНО', badge: 'bg-dark text-secondary' },
        { key: 'twisted', label: 'ВИТАЯ ПАРА (RJ-45, МЕДЬ)', badge: 'bg-success text-dark' },
        { key: 'fiber', label: 'ОПТОВОЛОКНО (СВЕТ)', badge: 'bg-info text-dark' },
        { key: 'wifi', label: 'WI-FI РАДИОКАНАЛ', badge: 'bg-warning text-dark' }
    ];

    const P3_NODES_CONFIG = [
        {
            id: 'node1',
            title: 'Рабочая станция ПК-01 (Ученик)',
            distance: '15 метров',
            role: 'Стационарный клиент в кабинете',
            expected: 'twisted',
            desc: 'Расстояние 15 м, подключение сетевой карты ПК к розетке RJ-45'
        },
        {
            id: 'node2',
            title: 'Рабочая станция ПК-08 (Ученик)',
            distance: '35 метров',
            role: 'Стационарный клиент дальнего ряда',
            expected: 'twisted',
            desc: 'Расстояние 35 м, стандартный медный кабель Ethernet'
        },
        {
            id: 'node3',
            title: 'Планшет учителя (Мобильный)',
            distance: '10 метров (в движении)',
            role: 'Беспроводной мобильный клиент',
            expected: 'wifi',
            desc: 'Передвижение по классу без проводов'
        },
        {
            id: 'node4',
            title: 'Внешний магистральный канал (Провайдер)',
            distance: '12 километров (до узла города)',
            role: 'Магистраль WAN высокой скорости',
            expected: 'fiber',
            desc: 'Передача данных лазерными импульсами на дальние расстояния'
        }
    ];

    let p3State = {};

    function initPhase3() {
        const container = document.getElementById('p3-nodes-container');
        container.innerHTML = '';
        p3State = {};

        P3_NODES_CONFIG.forEach(node => {
            p3State[node.id] = 'none';

            const col = document.createElement('div');
            col.className = 'col-md-6';
            col.innerHTML = `
                <div class="card bg-dark border border-success p-3 rounded-0 h-100 p3-node-card" data-id="${node.id}">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold text-success font-monospace">${node.title}</span>
                        <span class="badge border border-secondary text-secondary bg-black">${node.distance}</span>
                    </div>
                    <div class="small text-light mb-1">${node.role}</div>
                    <div class="small text-secondary mb-3">${node.desc}</div>

                    <div class="d-flex justify-content-between align-items-center bg-black p-2 border border-secondary">
                        <span class="small text-secondary font-monospace">ИНТЕРФЕЙС ПОРТА:</span>
                        <button type="button" class="btn btn-sm btn-outline-success font-monospace rounded-0 p3-toggle-btn" data-id="${node.id}">
                            [КЛИК: ВЫБРАТЬ КАНАЛ]
                        </button>
                    </div>
                    <div class="mt-2 text-center">
                        <span class="badge ${CABLE_TYPES[0].badge} rounded-0 p3-status-badge font-monospace">ОТКЛЮЧЕНО</span>
                    </div>
                </div>
            `;

            const btn = col.querySelector('.p3-toggle-btn');
            const badge = col.querySelector('.p3-status-badge');

            btn.addEventListener('click', () => {
                const currentKey = p3State[node.id];
                const currentIndex = CABLE_TYPES.findIndex(c => c.key === currentKey);
                const nextIndex = (currentIndex + 1) % CABLE_TYPES.length;
                const nextType = CABLE_TYPES[nextIndex];

                p3State[node.id] = nextType.key;
                badge.className = `badge ${nextType.badge} rounded-0 p3-status-badge font-monospace`;
                badge.textContent = nextType.label;
                btn.textContent = `[СМЕНИТЬ: ${nextType.key.toUpperCase()}]`;
            });

            container.appendChild(col);
        });
    }

    document.getElementById('btn-phase3').addEventListener('click', () => {
        let isAllCorrect = true;
        P3_NODES_CONFIG.forEach(node => {
            if (p3State[node.id] !== node.expected) {
                isAllCorrect = false;
            }
        });

        if (isAllCorrect) {
            document.getElementById('phase3').classList.add('d-none');
            document.getElementById('success-screen').classList.remove('d-none');
            sendTelemetry('level_complete', 'completed', true);
        } else {
            triggerError('ОШИБКА КОММУТАЦИИ: Неверно подобран тип физического канала связи для некоторых узлов!', () => {
                initPhase3();
            });
        }
    });

    // Инициализация при первой загрузке
    initPhase1();
</script>
