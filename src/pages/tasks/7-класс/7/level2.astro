---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
// Уровень 2: 7 класс, Урок 7 - Компьютерные сети. Поиск информации в сети Интернет
// Механика: Аналитика адресации, синтаксический разбор URL/DNS, поисковые операторы и правовые нормы.
// Строго ручной ввод (Zero Multiple Choice), платформа anti-paste.
// 5 процедурных фаз. Ошибка = hardcore_reset и генерация нового варианта фазы.
---

<TaskLayout level={2} bodyClass="font-monospace m-0 p-0">
<div class="container-fluid min-vh-100 p-4 rounded-0 bg-dark text-warning">
    <div class="row">
        <div class="col-12">
            <!-- Шапка терминала -->
            <div class="d-flex justify-content-between align-items-center border-bottom border-warning pb-2 mb-4">
                <h2 class="h4 text-warning font-monospace mb-0">ТЕРМИНАЛ СЕТЕВОГО АНАЛИТИКА // АДРЕСАЦИЯ И ПОИСК (УРОВЕНЬ 2)</h2>
                <span class="badge border border-warning text-warning bg-black rounded-0 px-3 py-2">ПРОДВИНУТЫЙ РЕЖИМ</span>
            </div>

            <!-- Блок системных ошибок -->
            <div id="error-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-4" role="alert">
                [СИСТЕМНЫЙ СБОЙ] <span id="error-message">Неверный ввод! Процедурная перегенерация задания...</span>
            </div>

            <!-- ================= ФАЗА 1 ================= -->
            <div id="phase1" class="card bg-black border-warning rounded-0 mb-4">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 1 ИЗ 5: Иерархия DNS и синтаксический анализ доменных уровней</span>
                    <span class="badge bg-warning text-dark rounded-0">РУЧНОЙ ВВОД</span>
                </div>
                <div class="card-body">
                    <p class="text-light">
                        Доменные имена в сети Интернет строятся по строгой иерархической схеме и читаются <strong>справа налево</strong>. 
                        Крайняя правая часть — это домен 1-го (верхнего) уровня, далее через точку следуют домены 2-го, 3-го и последующих уровней.
                    </p>
                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">АНАЛИЗИРУЕМЫЙ СЕТЕВОЙ АДРЕС:</div>
                        <div id="p1-domain-display" class="fs-4 text-warning fw-bold"></div>
                    </div>
                    <p id="p1-question" class="text-light mb-2"></p>
                    <div class="input-group mb-3 w-50">
                        <input type="number" id="input-p1" class="form-control bg-dark text-warning border-warning rounded-0 anti-paste" placeholder="Введите номер уровня (1, 2, 3 или 4)..." autocomplete="off" min="1" max="5">
                        <button id="btn-phase1" class="btn btn-outline-warning rounded-0 px-4">Подтвердить</button>
                    </div>
                    <div class="form-text text-secondary">
                        Примечание: введите только одну цифру (например, <code>1</code>, <code>2</code>, <code>3</code> или <code>4</code>). Буфер обмена заблокирован.
                    </div>
                </div>
            </div>

            <!-- ================= ФАЗА 2 ================= -->
            <div id="phase2" class="card bg-black border-warning rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 2 ИЗ 5: Валидация IPv4-адресов и байтовая адресация</span>
                    <span class="badge bg-warning text-dark rounded-0">БАЙТОВЫЙ АНАЛИЗ</span>
                </div>
                <div class="card-body">
                    <p class="text-light">
                        Согласно спецификации IPv4, сетевой адрес узла состоит из 4 десятичных октетов, разделенных точками. 
                        Каждый октет кодируется 1 байтом (8 бит), поэтому его значение строго ограничено диапазоном <code>0 &le; октет &le; 255</code>.
                    </p>
                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">ДИАГНОСТИЧЕСКИЙ ОТЧЕТ СЕТЕВОГО ШЛЮЗА:</div>
                        <div id="p2-task-display" class="fs-5 text-light"></div>
                    </div>
                    <p id="p2-prompt" class="text-light mb-2"></p>
                    <div class="input-group mb-3 w-50">
                        <input type="number" id="input-p2" class="form-control bg-dark text-warning border-warning rounded-0 anti-paste" placeholder="Введите число..." autocomplete="off">
                        <button id="btn-phase2" class="btn btn-outline-warning rounded-0 px-4">Подтвердить</button>
                    </div>
                    <div class="form-text text-secondary">
                        Внимательно проверьте диапазон допустимых значений октетов. Введите только числовое значение.
                    </div>
                </div>
            </div>

            <!-- ================= ФАЗА 3 ================= -->
            <div id="phase3" class="card bg-black border-warning rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 3 ИЗ 5: Спецификация URL и сетевые порты по умолчанию</span>
                    <span class="badge bg-warning text-dark rounded-0">СЕТЕВЫЕ ПРОТОКОЛЫ</span>
                </div>
                <div class="card-body">
                    <p class="text-light">
                        В структуре URL после имени хоста может указываться сетевой порт приложения. 
                        Если порт не указан явным образом, клиентская программа автоматически подставляет стандартный порт протокола по умолчанию.
                    </p>
                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">ТЕХНИЧЕСКИЙ ЗАПРОС КЛИЕНТСКОГО ПРИЛОЖЕНИЯ:</div>
                        <div id="p3-task-display" class="fs-5 text-light"></div>
                    </div>
                    <p id="p3-prompt" class="text-light mb-2"></p>
                    <div class="input-group mb-3 w-50">
                        <input type="number" id="input-p3" class="form-control bg-dark text-warning border-warning rounded-0 anti-paste" placeholder="Введите числовое значение..." autocomplete="off">
                        <button id="btn-phase3" class="btn btn-outline-warning rounded-0 px-4">Подтвердить</button>
                    </div>
                    <div class="form-text text-secondary">
                        Вспомните стандартные порты (HTTP, HTTPS, FTP), длину кабельного сегмента и коды ошибок веб-серверов.
                    </div>
                </div>
            </div>

            <!-- ================= ФАЗА 4 ================= -->
            <div id="phase4" class="card bg-black border-warning rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 4 ИЗ 5: Язык поисковых запросов и логические операторы</span>
                    <span class="badge bg-warning text-dark rounded-0">КОНСТРУКТОР ЗАПРОСОВ</span>
                </div>
                <div class="card-body">
                    <p class="text-light">
                        Для повышения точности поиска в глобальной паутине применяются специальные операторы: 
                        знак минус <code>-слово</code> для исключения паразитных терминов (без пробела после минуса), 
                        кавычки <code>"..."</code> для точного поиска фразы, а также операторы <code>site:</code> и <code>filetype:</code>.
                    </p>
                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">ТЕХНИЧЕСКОЕ ЗАДАНИЕ НА ПОИСК ИНФОРМАЦИИ:</div>
                        <div id="p4-task-display" class="fs-5 text-light"></div>
                    </div>
                    <p class="text-light mb-2">Введите сформированный поисковый запрос строго в соответствии с правилами синтаксиса:</p>
                    <div class="input-group mb-3 w-75">
                        <input type="text" id="input-p4" class="form-control bg-dark text-warning border-warning rounded-0 anti-paste" placeholder="Введите поисковый запрос..." autocomplete="off" spellcheck="false">
                        <button id="btn-phase4" class="btn btn-outline-warning rounded-0 px-4">Проверить запрос</button>
                    </div>
                    <div class="form-text text-secondary">
                        Внимание: оператор исключения пишется слитно с исключаемым словом (например, <code>-собачки</code>). В кавычках слова пишутся через пробел.
                    </div>
                </div>
            </div>

            <!-- ================= ФАЗА 5 ================= -->
            <div id="phase5" class="card bg-black border-warning rounded-0 mb-4 d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0">
                    <span class="fw-bold">ФАЗА 5 ИЗ 5: Законодательство РФ и этические нормы в сети Интернет</span>
                    <span class="badge bg-warning text-dark rounded-0">ПРАВОВАЯ КВАЛИФИКАЦИЯ</span>
                </div>
                <div class="card-body">
                    <p class="text-light">
                        Свобода информации не означает безнаказанности. Незаконное копирование, присвоение авторства (плагиат) 
                        и нарушение интеллектуальных прав регулируются Гражданским и Уголовным кодексами Российской Федерации.
                    </p>
                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">ЮРИДИЧЕСКАЯ СПРАВКА ИЛИ ПРАВОВОЙ ВОПРОС:</div>
                        <div id="p5-task-display" class="fs-5 text-light"></div>
                    </div>
                    <p id="p5-prompt" class="text-light mb-2"></p>
                    <div class="input-group mb-3 w-50">
                        <input type="number" id="input-p5" class="form-control bg-dark text-warning border-warning rounded-0 anti-paste" placeholder="Введите число..." autocomplete="off">
                        <button id="btn-phase5" class="btn btn-outline-warning rounded-0 px-4">Подтвердить</button>
                    </div>
                    <div class="form-text text-secondary">
                        Введите только числовое значение (номер статьи УК РФ, срок, допустимый процент или сумму штрафа).
                    </div>
                </div>
            </div>

            <!-- ================= ЭКРАН УСПЕХА ================= -->
            <div id="success-screen" class="card bg-warning text-black border-warning rounded-0 mb-4 d-none">
                <div class="card-body text-center py-5">
                    <h1 class="display-5 fw-bold mb-3">СЕТЕВОЙ АНАЛИЗ УСПЕШНО ЗАВЕРШЕН</h1>
                    <p class="lead mb-4">
                        Все 5 этапов продвинутого анализа выполнены: синтаксис DNS и URL расшифрован, 
                        октеты IPv4 валидированы, поисковые запросы составлены без ошибок, правовые нормы подтверждены.
                    </p>
                    <div class="badge bg-black text-warning border border-black rounded-0 fs-6 px-4 py-2">
                        УРОВЕНЬ 2 ЗАВЕРШЕН // СТАТУС: SUCCESS
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
</TaskLayout>

<script is:inline>
    // ================= ТЕЛЕМЕТРИЯ И АРХИТЕКТУРНЫЙ КОНТРАКТ =================
    const startTime = new Date();
    let attempts = 0;
    const missionName = 'Урок 7 :: Компьютерные сети. Поиск информации в сети Интернет (Уровень 2)';

    function sendTelemetry(action_type, status, success) {
        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: action_type,
            status: status,
            start_time: startTime.toISOString(),
            time_spent_sec: Math.floor((new Date() - startTime) / 1000),
            attempts_count: attempts,
            success: success
        }, '*');
    }

    sendTelemetry('in_progress', 'in_progress', false);

    function triggerError(message, retryCallback) {
        attempts++;
        const errorBox = document.getElementById('error-box');
        const errorMessage = document.getElementById('error-message');
        errorMessage.textContent = message;
        errorBox.classList.remove('d-none');

        // Отправка сигнала hardcore_reset
        sendTelemetry('hardcore_reset', 'in_progress', false);

        setTimeout(() => {
            errorBox.classList.add('d-none');
            if (retryCallback) retryCallback();
        }, 1500);
    }

    // Защита от вставки из буфера обмена (Anti-Paste)
    document.querySelectorAll('.anti-paste').forEach(input => {
        input.addEventListener('paste', (e) => {
            e.preventDefault();
            triggerError('Вставка из буфера обмена заблокирована! Вводите значение вручную с клавиатуры.');
        });
        input.addEventListener('drop', (e) => {
            e.preventDefault();
        });
    });

    // ================= ФАЗА 1: СИНТАКСИС ДОМЕННЫХ ИМЕН (DNS) =================
    const P1_VARIANTS = [
        {
            domain: 'school-collection.edu.ru',
            target: 'edu.ru',
            expected: 2,
            question: 'Определите, домен какого уровня представляет собой фрагмент <code>edu.ru</code> в данном сетевом адресе?'
        },
        {
            domain: 'school-collection.edu.ru',
            target: 'school-collection.edu.ru',
            expected: 3,
            question: 'Определите, домен какого уровня представляет собой полное имя <code>school-collection.edu.ru</code>?'
        },
        {
            domain: 'school-collection.edu.ru',
            target: 'ru',
            expected: 1,
            question: 'Определите, домен какого уровня представляет собой национальная зона <code>ru</code>?'
        },
        {
            domain: 'kpolyakov.spb.ru',
            target: 'spb.ru',
            expected: 2,
            question: 'Определите, домен какого уровня представляет собой фрагмент <code>spb.ru</code>?'
        },
        {
            domain: 'kpolyakov.spb.ru',
            target: 'kpolyakov.spb.ru',
            expected: 3,
            question: 'Определите, домен какого уровня представляет собой адрес <code>kpolyakov.spb.ru</code>?'
        },
        {
            domain: 'olymp.hse.ru',
            target: 'hse.ru',
            expected: 2,
            question: 'Определите, домен какого уровня представляет собой фрагмент <code>hse.ru</code>?'
        },
        {
            domain: 'olymp.hse.ru',
            target: 'olymp.hse.ru',
            expected: 3,
            question: 'Определите, домен какого уровня представляет собой поддомен <code>olymp.hse.ru</code>?'
        },
        {
            domain: 'portal.ege.edu.ru',
            target: 'portal.ege.edu.ru',
            expected: 4,
            question: 'Определите, домен какого уровня представляет собой полный адрес <code>portal.ege.edu.ru</code>?'
        },
        {
            domain: 'президент.рф',
            target: 'рф',
            expected: 1,
            question: 'Определите, домен какого уровня представляет собой кириллическая зона <code>рф</code>?'
        },
        {
            domain: 'maps.yandex.ru',
            target: 'yandex.ru',
            expected: 2,
            question: 'Определите, домен какого уровня представляет собой доменное имя <code>yandex.ru</code>?'
        }
    ];

    let p1CurrentExpected = 0;

    function initPhase1() {
        const item = P1_VARIANTS[Math.floor(Math.random() * P1_VARIANTS.length)];
        p1CurrentExpected = item.expected;
        window.__DEV_LEVEL2_STATE__ = { phase: 1, expected: p1CurrentExpected };

        document.getElementById('p1-domain-display').textContent = item.domain;
        document.getElementById('p1-question').innerHTML = item.question;
        const input = document.getElementById('input-p1');
        input.value = '';
        input.focus();
    }

    function checkPhase1() {
        const val = parseInt(document.getElementById('input-p1').value.trim(), 10);
        if (val === p1CurrentExpected) {
            document.getElementById('phase1').classList.add('d-none');
            document.getElementById('phase2').classList.remove('d-none');
            initPhase2();
        } else {
            triggerError('Неверный уровень домена! Помните: уровни считаются справа налево, начиная с домена 1-го уровня. Перегенерация...', () => {
                initPhase1();
            });
        }
    }

    document.getElementById('btn-phase1').addEventListener('click', checkPhase1);
    document.getElementById('input-p1').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') checkPhase1();
    });

    // ================= ФАЗА 2: ВАЛИДАЦИЯ IPv4-АДРЕСОВ =================
    const P2_INVALID_OCTETS = [260, 275, 290, 312, 340, 420, 512];
    const P2_VALID_PREFIXES = [
        ['192.168.1.', '.12'],
        ['172.16.0.', '.45'],
        ['10.0.', '.200'],
        ['77.88.55.', '.1'],
        ['213.180.', '.14']
    ];

    let p2ExpectedNumber = 0;

    function initPhase2() {
        const mode = Math.random();

        if (mode < 0.6) {
            // Поиск ошибочного октета (> 255)
            const badOctet = P2_INVALID_OCTETS[Math.floor(Math.random() * P2_INVALID_OCTETS.length)];
            const prefix = P2_VALID_PREFIXES[Math.floor(Math.random() * P2_VALID_PREFIXES.length)];
            const fakeIp = `${prefix[0]}${badOctet}${prefix[1]}`;
            p2ExpectedNumber = badOctet;

            document.getElementById('p2-task-display').innerHTML = 
                `Сетевой коммутатор отбросил некорректный сетевой пакет со строкой адреса: <code class="text-danger fw-bold fs-4">${fakeIp}</code>.<br>` +
                `Один из октетов нарушает фундаментальное правило стандарта IPv4.`;
            document.getElementById('p2-prompt').innerHTML = 
                `Найдите и введите ошибочное числовое значение октета, которое превышает допустимый предел:`;
        } else if (mode < 0.8) {
            // Максимальное значение октета
            p2ExpectedNumber = 255;
            document.getElementById('p2-task-display').innerHTML = 
                `Каждый октет в адресе IPv4 занимает ровно 8 бит (1 байт) памяти. Диапазон возможных значений октета начинается с 0.`;
            document.getElementById('p2-prompt').innerHTML = 
                `Каково максимально возможное десятичное значение, которое может принимать один октет? Введите число:`;
        } else {
            // Битовая разрядность октета
            p2ExpectedNumber = 8;
            document.getElementById('p2-task-display').innerHTML = 
                `Сетевой протокол IPv4 разделяет 32-битный сетевой адрес на 4 равных блока (октета).`;
            document.getElementById('p2-prompt').innerHTML = 
                `Сколько бит информации кодирует каждый отдельный октет? Введите число:`;
        }

        const input = document.getElementById('input-p2');
        input.value = '';
        input.focus();
        window.__DEV_LEVEL2_STATE__ = { phase: 2, expected: p2ExpectedNumber };
    }

    function checkPhase2() {
        const val = parseInt(document.getElementById('input-p2').value.trim(), 10);
        if (val === p2ExpectedNumber) {
            document.getElementById('phase2').classList.add('d-none');
            document.getElementById('phase3').classList.remove('d-none');
            initPhase3();
        } else {
            triggerError('Ошибка в анализе адреса! Напоминание: значение каждого октета IPv4 обязано быть в диапазоне от 0 до 255 (8 бит). Перегенерация...', () => {
                initPhase2();
            });
        }
    }

    document.getElementById('btn-phase2').addEventListener('click', checkPhase2);
    document.getElementById('input-p2').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') checkPhase2();
    });

    // ================= ФАЗА 3: СЕТЕВЫЕ ПОРТЫ И ПАРАМЕТРЫ СЕТИ =================
    const P3_VARIANTS = [
        {
            task: 'Браузер отправляет стандартный веб-запрос к сайту по незащищенному протоколу <code>http://school.edu.ru/index.html</code>. Номер порта в строке не указан.',
            prompt: 'Какой сетевой порт протокола HTTP используется браузером по умолчанию (введите число)?',
            expected: 80
        },
        {
            task: 'Ученик авторизуется в электронном дневнике по защищенному криптографическому протоколу с шифрованием <code>https://dnevnik.mos.ru/login</code>.',
            prompt: 'Какой стандартный сетевой порт протокола HTTPS используется по умолчанию (введите число)?',
            expected: 443
        },
        {
            task: 'Администратор школы загружает резервную копию базы данных на файловый сервер по протоколу <code>ftp://backup.school.org/archive.zip</code>.',
            prompt: 'Какой стандартный порт протокола передачи файлов FTP используется по умолчанию (введите число)?',
            expected: 21
        },
        {
            task: 'Веб-сервер успешно принял HTTP-запрос от браузера, но запрашиваемый файл не был найден на диске сервера (документ переименован или удален).',
            prompt: 'Какой трехзначный числовой код ошибки веб-сервера (Not Found) будет возвращен клиенту?',
            expected: 404
        },
        {
            task: 'Системный администратор прокладывает локальную сеть кабинетов информатики кабелем «витая пара» категории 5e без промежуточных усилителей и коммутаторов.',
            prompt: 'Какова максимально допустимая длина одного цельного сегмента витой пары в метрах? Введите число:',
            expected: 100
        }
    ];

