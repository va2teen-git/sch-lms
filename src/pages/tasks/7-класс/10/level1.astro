    let p1SelectedCard = null;

    function createP1Card(item) {
        const card = document.createElement('div');
        card.className = 'p1-card card bg-dark border border-secondary rounded-0 p-2 text-start user-select-none';
        card.style.cursor = 'grab';
        card.style.minHeight = '48px';
        card.style.minWidth = '180px';
        card.style.maxWidth = '100%';
        card.draggable = true;
        card.dataset.id = item.id;
        card.dataset.type = item.type;

        card.innerHTML = `
            <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                <span class="badge bg-black border border-secondary text-secondary rounded-0" style="font-size: 0.65rem;">${item.sphere}</span>
                <span class="p1-return-hint text-warning d-none" style="font-size: 0.65rem;">[в пул ↩]</span>
            </div>
            <div class="text-light small lh-sm">${item.text}</div>
        `;

        card.addEventListener('dragstart', (e) => {
            if (isLocked) return;
            e.dataTransfer.setData('text/plain', item.id);
            card.classList.add('opacity-50');
        });

        card.addEventListener('dragend', () => {
            card.classList.remove('opacity-50');
        });

        card.addEventListener('click', (e) => {
            e.stopPropagation();
            if (isLocked) return;
            const pool = document.getElementById('p1-cards-pool');
            if (card.parentElement !== pool) {
                // Клик по размещенной карточке возвращает её в пул
                card.querySelector('.p1-return-hint').classList.add('d-none');
                card.classList.remove('border-warning', 'border-2');
                card.classList.add('border-secondary');
                pool.appendChild(card);
                updateP1UI();
                return;
            }

            if (p1SelectedCard === card) {
                card.classList.remove('border-warning', 'border-2');
                card.classList.add('border-secondary');
                p1SelectedCard = null;
            } else {
                if (p1SelectedCard) {
                    p1SelectedCard.classList.remove('border-warning', 'border-2');
                    p1SelectedCard.classList.add('border-secondary');
                }
                p1SelectedCard = card;
                card.classList.remove('border-secondary');
                card.classList.add('border-warning', 'border-2');
            }
        });

        return card;
    }

    function placeP1Card(card, zone) {
        const slots = zone.querySelector('.p1-slots');
        if (!slots) return;
        card.classList.remove('border-warning', 'border-2');
        card.classList.add('border-secondary');
        card.querySelector('.p1-return-hint').classList.remove('d-none');
        slots.appendChild(card);
        if (p1SelectedCard === card) p1SelectedCard = null;
        updateP1UI();
    }

    function updateP1UI() {
        const pool = document.getElementById('p1-cards-pool');
        const remaining = pool.querySelectorAll('.p1-card').length;
        document.getElementById('p1-counter').textContent = `Осталось в потоке: ${remaining}`;

        document.querySelectorAll('.p1-dropzone').forEach(zone => {
            const count = zone.querySelectorAll('.p1-card').length;
            const badge = zone.querySelector('.p1-bucket-count');
            if (badge) badge.textContent = `В блоке: ${count}`;
        });

        document.getElementById('p1-verify-btn').disabled = remaining > 0;
    }

    function initPhase1() {
        p1SelectedCard = null;
        const pool = document.getElementById('p1-cards-pool');
        pool.innerHTML = '';
        document.querySelectorAll('.p1-slots').forEach(s => { s.innerHTML = ''; });

        // Гарантируем присутствие всех 4 процессов + 2 случайные карточки из остатка (неравномерное заполнение!)
        const chosen = [];
        const rest = [];
        ['collect', 'store', 'transmit', 'process'].forEach(cat => {
            const shuffled = shuffle(P1_POOL[cat]);
            chosen.push(shuffled[0]);
            rest.push(...shuffled.slice(1));
        });
        const extra = shuffle(rest).slice(0, 2);
        const allCards = shuffle([...chosen, ...extra]);

        allCards.forEach(item => pool.appendChild(createP1Card(item)));
        updateP1UI();
    }

    // Привязка обработчиков Фазы 1 (единоразово)
    document.querySelectorAll('.p1-dropzone').forEach(zone => {
        zone.addEventListener('dragover', (e) => {
            e.preventDefault();
            zone.classList.add('bg-dark');
        });
        zone.addEventListener('dragleave', () => {
            zone.classList.remove('bg-dark');
        });
        zone.addEventListener('drop', (e) => {
            e.preventDefault();
            zone.classList.remove('bg-dark');
            if (isLocked) return;
            const id = e.dataTransfer.getData('text/plain');
            const card = document.querySelector(`.p1-card[data-id="${id}"]`);
            if (card) placeP1Card(card, zone);
        });
        zone.addEventListener('click', () => {
            if (isLocked || !p1SelectedCard) return;
            placeP1Card(p1SelectedCard, zone);
        });
    });

    document.getElementById('p1-reset-btn').addEventListener('click', () => {
        if (isLocked) return;
        const pool = document.getElementById('p1-cards-pool');
        document.querySelectorAll('.p1-card').forEach(card => {
            card.querySelector('.p1-return-hint').classList.add('d-none');
            card.classList.remove('border-warning', 'border-2');
            card.classList.add('border-secondary');
            pool.appendChild(card);
        });
        p1SelectedCard = null;
        updateP1UI();
    });

    document.getElementById('p1-verify-btn').addEventListener('click', () => {
        if (isLocked) return;
        let allCorrect = true;
        document.querySelectorAll('.p1-dropzone').forEach(zone => {
            const expectedType = zone.dataset.bucket;
            zone.querySelectorAll('.p1-card').forEach(card => {
                if (card.dataset.type !== expectedType) {
                    allCorrect = false;
                }
            });
        });

        if (!allCorrect) {
            triggerError('Часть ситуаций отнесена не к тому информационному процессу (различайте получение, фиксацию во времени, передачу и преобразование).', initPhase1);
            return;
        }

        sendTelemetry('in_progress', 'in_progress', false, [{ action: 'phase1_complete' }]);
        document.getElementById('phase-1-container').classList.add('d-none');
        document.getElementById('phase-2-container').classList.remove('d-none');
        document.getElementById('phase-badge').textContent = 'Шаг 2 из 3';
        initPhase2();
    });

