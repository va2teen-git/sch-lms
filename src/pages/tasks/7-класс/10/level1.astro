    let p3Connections = {}; // caseId -> portId
    let p3SelectedCaseId = null;

    function drawPhase3Wires() {
        const svg = document.getElementById('p3-wires-svg');
        const board = document.getElementById('p3-board');
        if (!svg || !board) return;
        svg.innerHTML = '';

        const boardRect = board.getBoundingClientRect();
        if (boardRect.width === 0 || boardRect.height === 0) return;

        Object.entries(p3Connections).forEach(([caseId, portId]) => {
            const leftCard = document.querySelector(`.p3-case-card[data-case-id="${caseId}"]`);
            const rightCard = document.querySelector(`.p3-port-card[data-port-id="${portId}"]`);
            if (!leftCard || !rightCard) return;

            const lRect = leftCard.getBoundingClientRect();
            const rRect = rightCard.getBoundingClientRect();

            const x1 = lRect.right - boardRect.left;
            const y1 = lRect.top + lRect.height / 2 - boardRect.top;
            const x2 = rRect.left - boardRect.left;
            const y2 = rRect.top + rRect.height / 2 - boardRect.top;
            const dx = Math.max(24, (x2 - x1) * 0.5);

            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            path.setAttribute('d', `M ${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`);
            path.setAttribute('fill', 'none');
            path.setAttribute('stroke', '#198754');
            path.setAttribute('stroke-width', '2.5');
            svg.appendChild(path);

            [ [x1, y1], [x2, y2] ].forEach(([cx, cy]) => {
                const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                dot.setAttribute('cx', String(cx));
                dot.setAttribute('cy', String(cy));
                dot.setAttribute('r', '4');
                dot.setAttribute('fill', '#20c997');
                svg.appendChild(dot);
            });
        });
    }

    function updatePhase3UI() {
        const count = Object.keys(p3Connections).length;
        document.getElementById('p3-status').textContent = `Скоммутировано линий: ${count} из 4`;
        document.getElementById('p3-verify-btn').disabled = count < 4;

        document.querySelectorAll('.p3-case-card').forEach(card => {
            const id = card.dataset.caseId;
            const badge = card.querySelector('.p3-case-badge');
            const isSelected = p3SelectedCaseId === id;
            const linkedPortId = p3Connections[id];

            card.classList.remove('border-secondary', 'border-warning', 'border-success', 'border-2');
            if (isSelected) {
                card.classList.add('border-warning', 'border-2');
            } else if (linkedPortId) {
                card.classList.add('border-success');
            } else {
                card.classList.add('border-secondary');
            }

            if (badge) {
                if (linkedPortId) {
                    const portEl = document.querySelector(`.p3-port-card[data-port-id="${linkedPortId}"]`);
                    const title = portEl ? portEl.dataset.portTitle : linkedPortId;
                    badge.className = 'p3-case-badge badge bg-success text-dark rounded-0 text-wrap text-start';
                    badge.textContent = `→ ${title}`;
                } else {
                    badge.className = 'p3-case-badge badge bg-dark border border-secondary text-secondary rounded-0';
                    badge.textContent = isSelected ? 'ВЫБЕРИТЕ ПОРТ →' : 'НЕ СВЯЗАНО';
                }
            }
        });

        document.querySelectorAll('.p3-port-card').forEach(port => {
            const pid = port.dataset.portId;
            const used = Object.values(p3Connections).includes(pid);
            const stateEl = port.querySelector('.p3-port-state');
            port.classList.remove('border-secondary', 'border-success');
            port.classList.add(used ? 'border-success' : 'border-secondary');
            if (stateEl) {
                stateEl.className = used ? 'p3-port-state text-success fw-bold' : 'p3-port-state text-secondary';
                stateEl.textContent = used ? '[ПОДКЛЮЧЁН ×]' : '[СВОБОДЕН]';
            }
        });

        requestAnimationFrame(drawPhase3Wires);
    }

    function connectCaseToPort(caseId, portId) {
        // Один порт можно подключить только к одному кейсу (переключение)
        Object.keys(p3Connections).forEach(existingCase => {
            if (p3Connections[existingCase] === portId) {
                delete p3Connections[existingCase];
            }
        });
        p3Connections[caseId] = portId;
        p3SelectedCaseId = null;
        updatePhase3UI();
    }

    function initPhase3() {
        p3Connections = {};
        p3SelectedCaseId = null;

        const casesCol = document.getElementById('p3-cases-col');
        const portsCol = document.getElementById('p3-ports-col');
        casesCol.innerHTML = '';
        portsCol.innerHTML = '';

        // Генерируем 4 кейса (по 1 из каждого кластера)
        const chosenCases = shuffle(P3_CLUSTERS.map((cluster, idx) => {
            const text = cluster.cases[Math.floor(Math.random() * cluster.cases.length)];
            return {
                caseId: 'case_' + idx,
                targetId: cluster.targetId,
                text: text
            };
        }));

        chosenCases.forEach(c => {
            const card = document.createElement('div');
            card.className = 'p3-case-card card bg-dark border border-secondary rounded-0 p-2 user-select-none';
            card.style.cursor = 'pointer';
            card.style.minHeight = '64px';
            card.draggable = true;
            card.dataset.caseId = c.caseId;
            card.dataset.targetId = c.targetId;
            card.innerHTML = `
                <div class="text-light small lh-sm mb-2">${c.text}</div>
                <div class="d-flex justify-content-between align-items-center gap-1">
                    <span class="p3-case-badge badge bg-dark border border-secondary text-secondary rounded-0">НЕ СВЯЗАНО</span>
                    <span class="text-success fw-bold small">●</span>
                </div>
            `;

            card.addEventListener('dragstart', (e) => {
                if (isLocked) return;
                e.dataTransfer.setData('text/plain', c.caseId);
            });

            card.addEventListener('click', () => {
                if (isLocked) return;
                p3SelectedCaseId = (p3SelectedCaseId === c.caseId) ? null : c.caseId;
                updatePhase3UI();
            });

            casesCol.appendChild(card);
        });

        // Сборка 4 верных портов + 3 случайных ловушек
        const rightPorts = [
            ...P3_CLUSTERS.map(cl => ({ id: cl.targetId, portTitle: cl.portTitle, portDesc: cl.portDesc })),
            ...shuffle(P3_DISTRACTORS).slice(0, 3)
        ];

        shuffle(rightPorts).forEach(port => {
            const pCard = document.createElement('div');
            pCard.className = 'p3-port-card card bg-dark border border-secondary rounded-0 p-2 user-select-none';
            pCard.style.cursor = 'pointer';
            pCard.style.minHeight = '52px';
            pCard.dataset.portId = port.id;
            pCard.dataset.portTitle = port.portTitle;
            pCard.innerHTML = `
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-1 mb-1">
                    <span class="text-success fw-bold small" style="font-size: 0.78rem;">○ ${port.portTitle}</span>
                    <span class="p3-port-state text-secondary" style="font-size: 0.68rem;">[СВОБОДЕН]</span>
                </div>
                <div class="text-secondary lh-sm" style="font-size: 0.7rem;">${port.portDesc}</div>
            `;

            pCard.addEventListener('dragover', (e) => {
                e.preventDefault();
                pCard.classList.add('bg-black');
            });
            pCard.addEventListener('dragleave', () => {
                pCard.classList.remove('bg-black');
            });
            pCard.addEventListener('drop', (e) => {
                e.preventDefault();
                pCard.classList.remove('bg-black');
                if (isLocked) return;
                const caseId = e.dataTransfer.getData('text/plain');
                if (caseId && caseId.startsWith('case_')) {
                    connectCaseToPort(caseId, port.id);
                }
            });

            pCard.addEventListener('click', () => {
                if (isLocked) return;
                if (p3SelectedCaseId) {
                    connectCaseToPort(p3SelectedCaseId, port.id);
                } else {
                    // Снять связь при клике на уже подключенный порт
                    let changed = false;
                    Object.keys(p3Connections).forEach(cId => {
                        if (p3Connections[cId] === port.id) {
                            delete p3Connections[cId];
                            changed = true;
                        }
                    });
                    if (changed) updatePhase3UI();
                }
            });

            portsCol.appendChild(pCard);
        });

        updatePhase3UI();
    }

    window.addEventListener('resize', drawPhase3Wires);

    document.getElementById('p3-verify-btn').addEventListener('click', () => {
        if (isLocked) return;
        let allCorrect = true;
        document.querySelectorAll('.p3-case-card').forEach(card => {
            const cId = card.dataset.caseId;
            const targetId = card.dataset.targetId;
            if (p3Connections[cId] !== targetId) {
                allCorrect = false;
            }
        });

        if (!allCorrect) {
            triggerError('Найдена ошибка коммутации или выбран модуль-ловушка (различайте получение нового смысла и изменение формы представления).', initPhase3);
            return;
        }

        const totalSec = Math.floor((Date.now() - startTime.getTime()) / 1000);
        document.getElementById('stat-time').textContent = `${totalSec} с`;
        document.getElementById('stat-attempts').textContent = String(attempts);

        document.getElementById('phase-3-container').classList.add('d-none');
        document.getElementById('success-screen').classList.remove('d-none');
        const badge = document.getElementById('phase-badge');
        badge.className = 'badge bg-success text-dark border border-success rounded-0 px-3 py-2';
        badge.textContent = 'Уровень пройден!';

        sendTelemetry('level_complete', 'completed', true, [{ action: 'phase3_complete' }]);
    });

    // Запуск уровня с Фазы 1
    initPhase1();
})();
</script>
