    function updateP2UI() {
        const slots = document.querySelectorAll('.p2-slot');
        let filled = 0;
        slots.forEach(s => {
            if (s.querySelector('.p2-token')) filled++;
        });
        document.getElementById('p2-progress-badge').textContent = `Заполнено: ${filled} / 5`;
        document.getElementById('p2-verify-btn').disabled = filled < 5;
        const hint = document.getElementById('p2-selected-hint');
        if (hint) {
            hint.textContent = p2SelectedToken ? 'Выбран блок → кликните по слоту' : '';
        }
    }

    const P2_PLACEHOLDERS = {
        source: '[Поместите источник сообщения]',
        encoder: '[Поместите кодирующее устройство]',
        channel: '[Поместите среду передачи сигнала]',
        noise: '[Поместите источник искажений]',
        receiver: '[Поместите получателя сигнала]'
    };

    function resetP2SlotPlaceholder(slot) {
        const key = slot.dataset.slot;
        slot.innerHTML = `<span class="text-secondary">${P2_PLACEHOLDERS[key] || '[Перетащите блок]'}</span>`;
        slot.removeAttribute('data-placed-slot');
    }

    function placeP2Token(token, slot) {
        const pool = document.getElementById('p2-tokens-pool');
        const oldParent = token.parentElement;
        if (oldParent === slot) return;

        const existing = slot.querySelector('.p2-token');
        if (existing && existing !== token) {
            existing.classList.remove('border-success', 'border-warning', 'border-2');
            existing.classList.add('border-secondary');
            pool.appendChild(existing);
        }

        slot.innerHTML = '';
        token.classList.remove('border-secondary', 'border-warning', 'border-2');
        token.classList.add('border-success');
        slot.appendChild(token);
        slot.dataset.placedSlot = token.dataset.expectedSlot;

        if (oldParent && oldParent.classList.contains('p2-slot')) {
            resetP2SlotPlaceholder(oldParent);
        }

        if (p2SelectedToken === token) p2SelectedToken = null;
        updateP2UI();
    }

    function initPhase2() {
        p2SelectedToken = null;
        const pool = document.getElementById('p2-tokens-pool');
        pool.innerHTML = '';

        document.querySelectorAll('.p2-slot').forEach(slot => {
            resetP2SlotPlaceholder(slot);
        });

        // Выбираем сценарий, отличный от предыдущего при ошибке
        const candidates = P2_SCENARIOS.filter(s => s.id !== p2LastScenarioId);
        const scenario = candidates[Math.floor(Math.random() * candidates.length)] || P2_SCENARIOS[0];
        p2LastScenarioId = scenario.id;

        document.getElementById('p2-scenario-title').textContent = `«${scenario.title}»`;

        const selectedDistractors = shuffle(scenario.distractors).slice(0, 2);
        const allTokens = shuffle([...scenario.tokens, ...selectedDistractors]);

        allTokens.forEach((tok, idx) => {
            const el = document.createElement('div');
            el.className = 'p2-token card bg-dark border border-secondary rounded-0 p-2 text-light small user-select-none';
            el.style.cursor = 'grab';
            el.style.minHeight = '48px';
            el.style.maxWidth = '100%';
            el.draggable = true;
            el.dataset.tokenId = 'p2_tok_' + idx;
            el.dataset.expectedSlot = tok.slot;
            el.textContent = tok.text;

            el.addEventListener('dragstart', (e) => {
                if (isLocked) return;
                e.dataTransfer.setData('text/plain', el.dataset.tokenId);
                el.classList.add('opacity-50');
            });

            el.addEventListener('dragend', () => {
                el.classList.remove('opacity-50');
            });

            el.addEventListener('click', (e) => {
                e.stopPropagation();
                if (isLocked) return;
                if (el.parentElement !== pool) {
                    const parentSlot = el.parentElement;
                    resetP2SlotPlaceholder(parentSlot);
                    el.classList.remove('border-success', 'border-warning', 'border-2');
                    el.classList.add('border-secondary');
                    pool.appendChild(el);
                    updateP2UI();
                    return;
                }

                if (p2SelectedToken === el) {
                    el.classList.remove('border-warning', 'border-2');
                    el.classList.add('border-secondary');
                    p2SelectedToken = null;
                } else {
                    if (p2SelectedToken) {
                        p2SelectedToken.classList.remove('border-warning', 'border-2');
                        p2SelectedToken.classList.add('border-secondary');
                    }
                    p2SelectedToken = el;
                    el.classList.remove('border-secondary');
                    el.classList.add('border-warning', 'border-2');
                }
                updateP2UI();
            });

            pool.appendChild(el);
        });

        updateP2UI();
    }

