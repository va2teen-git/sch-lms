---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
// Уровень 1 (Базовый)
// Тема: Информационные процессы (7 класс, Урок 10)
---

<TaskLayout level={1} title="Урок 10 :: Информационные процессы (Уровень 1)">
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Верхняя панель заголовка -->
        <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom border-success pb-2 mb-3 gap-2">
            <div>
                <h2 class="h5 text-success mb-0 fw-bold text-uppercase">ЛАБОРАТОРИЯ ИНФОРМАЦИОННЫХ ПРОЦЕССОВ</h2>
                <div class="small text-secondary">7 КЛАСС // УРОК 10: ИНФОРМАЦИОННЫЕ ПРОЦЕССЫ (УРОВЕНЬ 1)</div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span id="phase-badge" class="badge bg-success text-dark border border-success rounded-0 px-3 py-2">Шаг 1 из 3</span>
                <span class="badge bg-black text-warning border border-secondary rounded-0 px-3 py-2">
                    Ошибок: <span id="attempts-display">0</span>
                </span>
            </div>
        </div>

        <!-- Блок оповещений об ошибке -->
        <div id="error-box" class="alert alert-danger bg-black border border-danger text-danger rounded-0 d-none mb-3 py-2" role="alert">
            <div class="d-flex align-items-center justify-content-between gap-2">
                <div class="small">
                    <strong>[СБОЙ КОНВЕЙЕРА]</strong> <span id="error-message">Обнаружена ошибка классификации.</span> Перегенерация задания...
                </div>
                <span class="spinner-border spinner-border-sm text-danger flex-shrink-0" role="status"></span>
            </div>
        </div>

        <!-- Экран успешного прохождения -->
        <div id="success-screen" class="card bg-black border border-success rounded-0 p-4 text-center d-none my-4">
            <div class="badge bg-success text-dark rounded-0 px-4 py-2 mb-3 fs-6">
                МИССИЯ УСПЕШНО ВЫПОЛНЕНА // УРОВЕНЬ 1 ПРОЙДЕН
            </div>
            <h3 class="h4 text-success text-uppercase mb-2 fw-bold">Конвейер информационных процессов настроен!</h3>
            <p class="text-light small mb-4 mx-auto" style="max-width: 580px;">
                Вы верно распределили жизненные и технические ситуации по четырём процессам, собрали схему передачи данных по Клоду Шеннону и разделили операции обработки и защиты информации.
            </p>
            <div class="d-inline-flex flex-wrap justify-content-center gap-4 border border-secondary bg-dark p-3 rounded-0 mx-auto">
                <div>
                    <div class="text-secondary small">Затрачено времени</div>
                    <div id="stat-time" class="text-success fs-5 fw-bold">0 с</div>
                </div>
                <div class="border-end border-secondary d-none d-sm-block"></div>
                <div>
                    <div class="text-secondary small">Ошибок</div>
                    <div id="stat-attempts" class="text-warning fs-5 fw-bold">0</div>
                </div>
                <div class="border-end border-secondary d-none d-sm-block"></div>
                <div>
                    <div class="text-secondary small">Статус</div>
                    <div class="text-info fs-5 fw-bold">100% ЗАЧЁТ</div>
                </div>
            </div>
        </div>

        <!-- ==================== ФАЗА 1: СОРТИРОВКА ПО КОНТЕЙНЕРАМ ==================== -->
        <div id="phase-1-container">
            <div class="card bg-black border border-secondary rounded-0 p-3 mb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <span class="badge bg-secondary text-dark rounded-0">ФАЗА 1: КЛАССИФИКАЦИЯ ПРОЦЕССОВ</span>
                    <span class="text-secondary small">МЕХАНИКА: ПЕРЕТАСКИВАНИЕ / КЛИК</span>
                </div>
                <p class="text-light small mb-2">
                    Распределите 6 реальных ситуаций из природы, быта и вычислительной техники по четырём базовым информационным процессам. Перетащите карточку в нужный сектор или нажмите на карточку, а затем на контейнер.
                </p>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span id="p1-counter" class="small text-warning fw-bold">Осталось в потоке: 6</span>
                    <button id="p1-reset-btn" type="button" class="btn btn-outline-secondary btn-sm rounded-0 text-uppercase" style="min-height: 48px;">
                        Вернуть карточки в пул
                    </button>
                </div>
            </div>

            <!-- Входящий пул карточек -->
            <div class="card bg-black border border-secondary rounded-0 p-3 mb-3">
                <div class="small text-secondary mb-2 text-uppercase">Входящий поток ситуаций:</div>
                <div id="p1-cards-pool" class="d-flex flex-wrap gap-2" style="min-height: 76px;"></div>
            </div>

            <!-- 4 целевых контейнера (сетка 2x2 для удобства в сплит-экране) -->
            <div class="row g-2 mb-3">
                <div class="col-12 col-sm-6">
                    <div class="card bg-black border border-success rounded-0 h-100 p1-dropzone" data-bucket="collect" style="min-height: 150px; cursor: pointer;">
                        <div class="card-header bg-dark border-bottom border-success rounded-0 py-2 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-success small">1. СБОР ИНФОРМАЦИИ</span>
                            <span class="badge bg-black text-success border border-success rounded-0 p1-bucket-count">В блоке: 0</span>
                        </div>
                        <div class="px-2 pt-2 text-secondary" style="font-size: 0.72rem;">Получение сведений органами чувств, приборами, датчиками или сканерами</div>
                        <div class="card-body p-2 p1-slots d-flex flex-column gap-2" style="min-height: 96px;"></div>
                    </div>
                </div>
                <div class="col-12 col-sm-6">
                    <div class="card bg-black border border-info rounded-0 h-100 p1-dropzone" data-bucket="store" style="min-height: 150px; cursor: pointer;">
                        <div class="card-header bg-dark border-bottom border-info rounded-0 py-2 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-info small">2. ХРАНЕНИЕ ИНФОРМАЦИИ</span>
                            <span class="badge bg-black text-info border border-info rounded-0 p1-bucket-count">В блоке: 0</span>
                        </div>
                        <div class="px-2 pt-2 text-secondary" style="font-size: 0.72rem;">Фиксация на материальном носителе для использования во времени</div>
                        <div class="card-body p-2 p1-slots d-flex flex-column gap-2" style="min-height: 96px;"></div>
                    </div>
                </div>
                <div class="col-12 col-sm-6">
                    <div class="card bg-black border border-warning rounded-0 h-100 p1-dropzone" data-bucket="transmit" style="min-height: 150px; cursor: pointer;">
                        <div class="card-header bg-dark border-bottom border-warning rounded-0 py-2 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-warning small">3. ПЕРЕДАЧА ИНФОРМАЦИИ</span>
                            <span class="badge bg-black text-warning border border-warning rounded-0 p1-bucket-count">В блоке: 0</span>
                        </div>
                        <div class="px-2 pt-2 text-secondary" style="font-size: 0.72rem;">Перемещение сообщений в пространстве от источника к приёмнику</div>
                        <div class="card-body p-2 p1-slots d-flex flex-column gap-2" style="min-height: 96px;"></div>
                    </div>
                </div>
                <div class="col-12 col-sm-6">
                    <div class="card bg-black border border-light rounded-0 h-100 p1-dropzone" data-bucket="process" style="min-height: 150px; cursor: pointer;">
                        <div class="card-header bg-dark border-bottom border-secondary rounded-0 py-2 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-light small">4. ОБРАБОТКА ИНФОРМАЦИИ</span>
                            <span class="badge bg-black text-light border border-secondary rounded-0 p1-bucket-count">В блоке: 0</span>
                        </div>
                        <div class="px-2 pt-2 text-secondary" style="font-size: 0.72rem;">Вычисления, перевод, сортировка, сжатие или логический вывод</div>
                        <div class="card-body p-2 p1-slots d-flex flex-column gap-2" style="min-height: 96px;"></div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button id="p1-verify-btn" type="button" class="btn btn-success rounded-0 px-4 py-2 fw-bold text-uppercase text-wrap" style="min-height: 48px;" disabled>
                    Подтвердить сортировку [Шаг 1]
                </button>
            </div>
        </div>

        <!-- ==================== ФАЗА 2: СЛОТ-ПАЗЛ (СХЕМА ШЕННОНА) ==================== -->
        <div id="phase-2-container" class="d-none">
            <div class="card bg-black border border-secondary rounded-0 p-3 mb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <span class="badge bg-secondary text-dark rounded-0">ФАЗА 2: СБОРКА КАНАЛА СВЯЗИ (МОДЕЛЬ ШЕННОНА)</span>
                    <span class="text-secondary small">МЕХАНИКА: СЛОТ-ПАЗЛ</span>
                </div>
                <p class="text-light small mb-2">
                    Сценарий: <strong id="p2-scenario-title" class="text-info"></strong>.
                    Соберите все 5 звеньев цепи передачи информации. В палитре присутствуют 2 лишних блока из других процессов — не используйте их!
                </p>
                <div class="small text-secondary">
                    Перетащите токен в нужный слот или нажмите на токен, затем на целевой слот. Клик по заполненному слоту возвращает блок в палитру.
                </div>
            </div>

            <!-- Целевые слоты цепи передачи -->
            <div class="card bg-black border border-secondary rounded-0 mb-3">
                <div class="card-header bg-dark border-bottom border-secondary rounded-0 py-2 d-flex justify-content-between align-items-center">
                    <span class="text-success small fw-bold">СХЕМА ПЕРЕДАЧИ ИНФОРМАЦИИ</span>
                    <span id="p2-progress-badge" class="badge bg-black text-warning border border-secondary rounded-0">Заполнено: 0 / 5</span>
                </div>
                <div class="card-body p-2 d-flex flex-column gap-2">
                    <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2 border border-secondary bg-dark p-2">
                        <div class="text-success fw-bold small" style="min-width: 175px;">1. ИСТОЧНИК:</div>
                        <div class="p2-slot flex-fill border border-secondary bg-black p-2 rounded-0 text-secondary small d-flex align-items-center justify-content-center text-center" data-slot="source" style="min-height: 52px; cursor: pointer;">
                            <span class="text-secondary">[Поместите источник сообщения]</span>
                        </div>
                    </div>
                    <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2 border border-secondary bg-dark p-2">
                        <div class="text-info fw-bold small" style="min-width: 175px;">2. КОДЕР:</div>
                        <div class="p2-slot flex-fill border border-secondary bg-black p-2 rounded-0 text-secondary small d-flex align-items-center justify-content-center text-center" data-slot="encoder" style="min-height: 52px; cursor: pointer;">
                            <span class="text-secondary">[Поместите кодирующее устройство]</span>
                        </div>
                    </div>
                    <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2 border border-secondary bg-dark p-2">
                        <div class="text-warning fw-bold small" style="min-width: 175px;">3. КАНАЛ СВЯЗИ:</div>
                        <div class="p2-slot flex-fill border border-secondary bg-black p-2 rounded-0 text-secondary small d-flex align-items-center justify-content-center text-center" data-slot="channel" style="min-height: 52px; cursor: pointer;">
                            <span class="text-secondary">[Поместите среду передачи сигнала]</span>
                        </div>
                    </div>
                    <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2 border border-danger bg-dark p-2">
                        <div class="text-danger fw-bold small" style="min-width: 175px;">4. ПОМЕХИ (ШУМ):</div>
                        <div class="p2-slot flex-fill border border-secondary bg-black p-2 rounded-0 text-secondary small d-flex align-items-center justify-content-center text-center" data-slot="noise" style="min-height: 52px; cursor: pointer;">
                            <span class="text-secondary">[Поместите источник искажений]</span>
                        </div>
                    </div>
                    <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2 border border-secondary bg-dark p-2">
                        <div class="text-light fw-bold small" style="min-width: 175px;">5. ПРИЁМНИК И ДЕКОДЕР:</div>
                        <div class="p2-slot flex-fill border border-secondary bg-black p-2 rounded-0 text-secondary small d-flex align-items-center justify-content-center text-center" data-slot="receiver" style="min-height: 52px; cursor: pointer;">
                            <span class="text-secondary">[Поместите получателя сигнала]</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Палитра блоков -->
            <div class="card bg-black border border-secondary rounded-0 mb-3">
                <div class="card-header bg-dark border-bottom border-secondary rounded-0 py-2 d-flex justify-content-between align-items-center">
                    <span class="small text-secondary text-uppercase">Палитра блоков (содержит 2 дистрактора)</span>
                    <span id="p2-selected-hint" class="small text-warning"></span>
                </div>
                <div class="card-body p-2">
                    <div id="p2-tokens-pool" class="d-flex flex-wrap gap-2" style="min-height: 70px;"></div>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button id="p2-verify-btn" type="button" class="btn btn-success rounded-0 px-4 py-2 fw-bold text-uppercase text-wrap" style="min-height: 48px;" disabled>
                    Запустить канал связи [Шаг 2]
                </button>
            </div>
        </div>

        <!-- ==================== ФАЗА 3: КОММУТАЦИЯ УЗЛОВ (ОБРАБОТКА И ЗАЩИТА) ==================== -->
        <div id="phase-3-container" class="d-none">
            <div class="card bg-black border border-secondary rounded-0 p-3 mb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <span class="badge bg-secondary text-dark rounded-0">ФАЗА 3: АУДИТ ОБРАБОТКИ И ЗАЩИТЫ ДАННЫХ</span>
                    <span class="text-secondary small">МЕХАНИКА: КОММУТАЦИЯ СВЯЗЕЙ</span>
                </div>
                <p class="text-light small mb-1">
                    Соедините каждую операцию слева с её <strong>точным классом обработки или защиты</strong> справа. Будьте внимательны: среди портов справа присутствуют 3 ложных модуля-ловушки!
                </p>
                <div class="small text-secondary">
                    Кликните по операции слева, затем по целевому порту справа (или перетащите провод). Повторный клик по занятому порту снимает связь.
                </div>
            </div>

            <!-- Коммутационная панель с SVG-проводами -->
            <div id="p3-board" class="position-relative border border-secondary bg-black p-2 p-sm-3 mb-3">
                <svg id="p3-wires-svg" class="position-absolute top-0 start-0 w-100 h-100" style="pointer-events: none; z-index: 2;"></svg>
                <div class="row g-3 position-relative" style="z-index: 3;">
                    <div class="col-6">
                        <div class="small text-secondary text-uppercase mb-2">Операции (4 кейса):</div>
                        <div id="p3-cases-col" class="d-flex flex-column gap-3"></div>
                    </div>
                    <div class="col-6">
                        <div class="small text-secondary text-uppercase mb-2">Целевые модули (с ловушками):</div>
                        <div id="p3-ports-col" class="d-flex flex-column gap-2"></div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span id="p3-status" class="small text-warning fw-bold">Скоммутировано линий: 0 из 4</span>
                <button id="p3-verify-btn" type="button" class="btn btn-success rounded-0 px-4 py-2 fw-bold text-uppercase text-wrap" style="min-height: 48px;" disabled>
                    Подтвердить коммутацию [Завершить]
                </button>
            </div>
        </div>
    </div>
</TaskLayout>

<script is:inline>
(function() {
    const missionName = 'Урок 10 :: Информационные процессы (Уровень 1)';
    const startTime = new Date();
    let attempts = 0;
    let isLocked = false;

    function sendTelemetry(actionType, status, success, extraLog) {
        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: actionType,
            status: status,
            start_time: startTime.toISOString(),
            time_spent_sec: Math.floor((Date.now() - startTime.getTime()) / 1000),
            attempts_count: attempts,
            success: success,
            action_log: extraLog || []
        }, '*');
    }

    sendTelemetry('in_progress', 'in_progress', false, [{ action: 'level_start' }]);

    function triggerError(message, retryCallback) {
        if (isLocked) return;
        isLocked = true;
        attempts++;

        const attemptsDisplay = document.getElementById('attempts-display');
        if (attemptsDisplay) attemptsDisplay.textContent = String(attempts);

        const errorBox = document.getElementById('error-box');
        const errorMessage = document.getElementById('error-message');
        if (errorMessage) errorMessage.textContent = message;
        if (errorBox) errorBox.classList.remove('d-none');

        sendTelemetry('hardcore_reset', 'in_progress', false, [{ action: 'error', detail: message }]);

        setTimeout(() => {
            if (errorBox) errorBox.classList.add('d-none');
            isLocked = false;
            if (retryCallback) retryCallback();
        }, 1300);
    }

    function shuffle(array) {
        const copy = [...array];
        for (let i = copy.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [copy[i], copy[j]] = [copy[j], copy[i]];
        }
        return copy;
    }

    // =========================================================================
    // ФАЗА 1: КЛАССИФИКАЦИЯ СИТУАЦИЙ ПО 4 ПРОЦЕССАМ
    // =========================================================================
    const P1_POOL = {
        collect: [
            { id: 'c1', sphere: 'ТЕХНИКА', text: 'Электронный датчик теплицы измеряет влажность почвы', type: 'collect' },
            { id: 'c2', sphere: 'ТОРГОВЛЯ', text: 'Лазерный сканер на кассе считывает штрихкод товара', type: 'collect' },
            { id: 'c3', sphere: 'НАУКА', text: 'Метеозонд регистрирует атмосферное давление на высоте 10 км', type: 'collect' },
            { id: 'c4', sphere: 'ОБЩЕСТВО', text: 'Пешеход осматривает дорожный знак перед переходом улицы', type: 'collect' },
            { id: 'c5', sphere: 'БЕЗОПАСНОСТЬ', text: 'Видеокамера фиксирует поток автомобилей на перекрёстке', type: 'collect' },
            { id: 'c6', sphere: 'ПРИРОДА', text: 'Медоносная пчела обнаруживает цветущий луг по аромату нектара', type: 'collect' }
        ],
        store: [
            { id: 's1', sphere: 'ШКОЛА', text: 'Ученик записывает домашние задания в бумажный дневник', type: 'store' },
            { id: 's2', sphere: 'ИТ-ПРАКТИКА', text: 'Сохранение готового проекта презентации на USB-флешку', type: 'store' },
            { id: 's3', sphere: 'БЭКАП', text: 'Копирование семейных фотографий в облачный архив на годы', type: 'store' },
            { id: 's4', sphere: 'ОБЩЕСТВО', text: 'Библиотечный каталог сберегает сведения о книжном фонде', type: 'store' },
            { id: 's5', sphere: 'ТЕХНИКА', text: 'Карта памяти фотоаппарата удерживает кадры без питания', type: 'store' },
            { id: 's6', sphere: 'ЧЕЛОВЕК', text: 'Мозг удерживает в памяти выученное наизусть стихотворение', type: 'store' }
        ],
        transmit: [
            { id: 't1', sphere: 'ТРАНСПОРТ', text: 'Светофор подаёт зелёный сигнал водителям на перекрёстке', type: 'transmit' },
            { id: 't2', sphere: 'СВЯЗЬ', text: 'Радиовышка транслирует прогноз погоды в эфир на 100 км', type: 'transmit' },
            { id: 't3', sphere: 'СЕТЬ', text: 'Отправка сообщения другу через Wi-Fi и сеть провайдера', type: 'transmit' },
            { id: 't4', sphere: 'ШКОЛА', text: 'Звонок оповещает все этажи здания об окончании урока', type: 'transmit' },
            { id: 't5', sphere: 'КОСМОС', text: 'Спутник направляет навигационный радиосигнал к приёмнику в авто', type: 'transmit' },
            { id: 't6', sphere: 'СЕТИ', text: 'Кабель витая пара доставляет сетевые пакеты от роутера к ПК', type: 'transmit' }
        ],
        process: [
            { id: 'p1', sphere: 'РАСЧЁТ', text: 'Вычисление площади комнаты по известным длине и ширине', type: 'process' },
            { id: 'p2', sphere: 'ЛИНГВИСТИКА', text: 'Перевод текста инструкции с английского языка на русский', type: 'process' },
            { id: 'p3', sphere: 'ТАБЛИЦЫ', text: 'Упорядочивание списка учеников класса по алфавиту', type: 'process' },
            { id: 'p4', sphere: 'ИТ-ПРАКТИКА', text: 'Упаковка папки с отчётами в сжатый архив формата ZIP', type: 'process' },
            { id: 'p5', sphere: 'КОДИРОВАНИЕ', text: 'Перевод фразы в последовательность точек и тире азбуки Морзе', type: 'process' },
            { id: 'p6', sphere: 'АНАЛИЗ', text: 'Составление прогноза погоды по замерам ветра и давления', type: 'process' }
