---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
// Уровень 1 (Базовый)
// Тема: Информация и данные (7 класс, Урок 9)
---

<TaskLayout level={1} bodyClass="font-monospace m-0 p-0">
<div class="container-fluid min-vh-100 p-2 p-md-4 rounded-0 bg-dark text-success">
    <div class="row">
        <div class="col-12">
            <!-- Шапка уровня -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center border-bottom border-success pb-2 mb-3 gap-2">
                <div>
                    <h2 class="h5 text-success font-monospace mb-0 text-uppercase">ЛАБОРАТОРИЯ СИГНАЛОВ И СЕМАНТИКИ</h2>
                    <span class="small text-secondary">7 КЛАСС // УРОК 9: ИНФОРМАЦИЯ И ДАННЫЕ (УРОВЕНЬ 1)</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span id="phase-badge" class="badge bg-black text-success border border-success rounded-0 px-3 py-2">Шаг 1 из 3</span>
                    <span class="badge border border-success text-success bg-black rounded-0 px-3 py-2">БАЗОВЫЙ РЕЖИМ</span>
                </div>
            </div>

            <!-- Блок оповещений об ошибке -->
            <div id="error-box" class="alert alert-danger bg-black border border-danger text-danger rounded-0 d-none mb-3" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">⚠️</span>
                    <div id="error-message" class="font-monospace small">ОШИБКА ОБРАБОТКИ ДАННЫХ: Неверная классификация или коммутация.</div>
                </div>
            </div>

            <!-- Экран успешного прохождения -->
            <div id="success-screen" class="card bg-black border border-success rounded-0 p-4 text-center d-none my-4">
                <div class="mb-3 fs-1">📡</div>
                <h3 class="text-success font-monospace text-uppercase mb-2">Уровень 1 Успешно Завершен!</h3>
                <p class="text-secondary small font-monospace mb-3">
                    Сенсорные каналы откалиброваны, сырые данные наделены контекстом, свойства информации верифицированы.
                </p>
                <div class="d-flex justify-content-center">
                    <span class="badge bg-success text-dark px-3 py-2 rounded-0 font-monospace">СТАТУС: ДАННЫЕ ВАЛИДИРОВАНЫ</span>
                </div>
            </div>

            <!-- ==================== ФАЗА 1: СЕНСОРНЫЕ КАНАЛЫ ==================== -->
            <div id="phase1" class="phase-container">
                <div class="card bg-black border border-secondary rounded-0 p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-secondary text-dark rounded-0 font-monospace">ФАЗА 1: СЕНСОРНАЯ СОРТИРОВКА</span>
                        <span class="text-secondary small">МЕХАНИКА: ПЕРЕТАСКИВАНИЕ / КЛИК</span>
                    </div>
                    <p class="text-light small mb-2">
                        Распределите поступающие сигналы внешнего мира по трем сенсорным каналам человека (органам чувств). Нажимайте на карточку, затем на целевой контейнер (или перетаскивайте мышью).
                    </p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span id="p1-counter" class="small text-warning font-monospace">Осталось распределить: 6</span>
                        <button id="p1-reset-btn" class="btn btn-outline-secondary btn-sm rounded-0 font-monospace text-uppercase">
                            Сбросить выбор
                        </button>
                    </div>
                </div>

                <!-- Пул нераспределенных карточек -->
                <div class="card bg-black border border-secondary rounded-0 p-3 mb-3">
                    <div class="small text-secondary font-monospace mb-2 text-uppercase">Входящий поток сигналов:</div>
                    <div id="p1-cards-pool" class="d-flex flex-wrap gap-2 min-vh-10" style="min-height: 80px;">
                        <!-- Карточки генерируются процедурно -->
                    </div>
                </div>

                <!-- Контейнеры-приемники -->
                <div class="row g-2 mb-3">
                    <div class="col-12 col-md-4">
                        <div class="card bg-black border border-success rounded-0 p-3 h-100 p1-dropzone" data-bucket="visual">
                            <div class="d-flex justify-content-between align-items-center border-bottom border-success pb-2 mb-2">
                                <span class="fw-bold text-success font-monospace p1-dropzone-header">👁️ ЗРИТЕЛЬНЫЙ КАНАЛ</span>
                                <span class="badge bg-success text-dark rounded-0 p1-bucket-count">0 / 2</span>
                            </div>
                            <div class="text-secondary small mb-2" style="font-size: 0.75rem;">Глаза: цвет, форма, текст, световые импульсы (~80-90%)</div>
                            <div class="p1-slots d-flex flex-column gap-2" style="min-height: 120px;"></div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card bg-black border border-info rounded-0 p-3 h-100 p1-dropzone" data-bucket="auditory">
                            <div class="d-flex justify-content-between align-items-center border-bottom border-info pb-2 mb-2">
                                <span class="fw-bold text-info font-monospace p1-dropzone-header">👂 СЛУХОВОЙ КАНАЛ</span>
                                <span class="badge bg-info text-dark rounded-0 p1-bucket-count">0 / 2</span>
                            </div>
                            <div class="text-secondary small mb-2" style="font-size: 0.75rem;">Органы слуха: звуковые волны, речь, акустические сигналы (~9-10%)</div>
                            <div class="p1-slots d-flex flex-column gap-2" style="min-height: 120px;"></div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card bg-black border border-warning rounded-0 p-3 h-100 p1-dropzone" data-bucket="tactile">
                            <div class="d-flex justify-content-between align-items-center border-bottom border-warning pb-2 mb-2">
                                <span class="fw-bold text-warning font-monospace p1-dropzone-header">✋ ТАКТИЛЬНЫЙ КАНАЛ</span>
                                <span class="badge bg-warning text-dark rounded-0 p1-bucket-count">0 / 2</span>
                            </div>
                            <div class="text-secondary small mb-2" style="font-size: 0.75rem;">Кожа / рецепторы: температура, вибрация, текстура (~1-2%)</div>
                            <div class="p1-slots d-flex flex-column gap-2" style="min-height: 120px;"></div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button id="btn-phase1" class="btn btn-success rounded-0 px-4 py-2 font-monospace text-uppercase fw-bold" disabled>
                        Подтвердить сортировку сигналов
                    </button>
                </div>
            </div>

            <!-- ==================== ФАЗА 2: СЕМАНТИЧЕСКИЙ СЛОТ-ПАЗЛ ==================== -->
            <div id="phase2" class="phase-container d-none">
                <div class="card bg-black border border-secondary rounded-0 p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-secondary text-dark rounded-0 font-monospace">ФАЗА 2: СЛОТ-ПАЗЛ «ДАННЫЕ → ИНФОРМАЦИЯ»</span>
                        <span class="text-secondary small">МЕХАНИКА: СЛОТЫ И ТОКЕНЫ</span>
                    </div>
                    <p class="text-light small mb-1">
                        Числа сами по себе — это лишь сырые данные. Сопоставьте каждому числу его <strong>контекст (единицы измерения и назначение)</strong> и итоговое <strong>практическое знание</strong>.
                    </p>
                    <p class="text-secondary small mb-0">
                        Нажмите на токен в палитре, затем нажмите на целевой слот в карточке задачи (в палитре присутствуют ложные токены-дистракторы).
                    </p>
                </div>

                <!-- Палитра токенов -->
                <div class="card bg-black border border-secondary rounded-0 p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-secondary font-monospace text-uppercase">Палитра токенов (контекст и выводы):</span>
                        <span id="p2-selected-hint" class="small text-warning font-monospace"></span>
                    </div>
                    <div id="p2-palette" class="d-flex flex-wrap gap-2" style="min-height: 60px;">
                        <!-- Токены генерируются процедурно -->
                    </div>
                </div>

                <!-- 3 задачи со слотами -->
                <div id="p2-tasks-container" class="row g-3 mb-3">
                    <!-- Задачи генерируются процедурно -->
                </div>

                <div class="d-flex justify-content-end">
                    <button id="btn-phase2" class="btn btn-success rounded-0 px-4 py-2 font-monospace text-uppercase fw-bold" disabled>
                        Синтезировать информацию
                    </button>
                </div>
            </div>

            <!-- ==================== ФАЗА 3: КОММУТАЦИЯ СВОЙСТВ ИНФОРМАЦИИ ==================== -->
            <div id="phase3" class="phase-container d-none">
                <div class="card bg-black border border-secondary rounded-0 p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-secondary text-dark rounded-0 font-monospace">ФАЗА 3: ЭКСПЕРТИЗА КАЧЕСТВА И СВОЙСТВ</span>
                        <span class="text-secondary small">МЕХАНИКА: КОММУТАЦИЯ УЗЛОВ</span>
                    </div>
                    <p class="text-light small mb-1">
                        Оператор допустил сбои из-за некачественной информации. Свяжите каждый инцидент слева с <strong>точно нарушенным свойством информации</strong> справа.
                    </p>
                    <p class="text-secondary small mb-0">
                        Кликните на карточку инцидента, затем кликните на порт свойства в правой колонке. Повторный клик снимает связь.
                    </p>
                </div>

                <div class="row g-3 mb-3">
                    <!-- Левая колонка: Инциденты -->
                    <div class="col-12 col-md-7">
                        <div class="small text-secondary font-monospace mb-2 text-uppercase">Инциденты в диспетчерской:</div>
                        <div id="p3-incidents" class="d-flex flex-column gap-2">
                            <!-- Генерируются процедурно -->
                        </div>
                    </div>

                    <!-- Правая колонка: Свойства информации -->
                    <div class="col-12 col-md-5">
                        <div class="small text-secondary font-monospace mb-2 text-uppercase">Порты свойств информации:</div>
                        <div id="p3-properties" class="d-flex flex-column gap-2">
                            <!-- Генерируются процедурно -->
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <span id="p3-status" class="small text-secondary font-monospace">Скоммутировано: 0 из 4</span>
                    <button id="btn-phase3" class="btn btn-success rounded-0 px-4 py-2 font-monospace text-uppercase fw-bold" disabled>
                        Подтвердить экспертизу свойств
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>
</TaskLayout>

<script is:inline>
(function() {
    const missionName = 'Урок 9 :: Информация и данные (Уровень 1)';
    const startTime = new Date();
    let attempts = 0;

    function sendTelemetry(action_type, status, success) {
        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: action_type,
            status: status,
            start_time: startTime.toISOString(),
            time_spent_sec: Math.floor((new Date() - startTime) / 1000),
            attempts_count: attempts,
            success: success
        }, '*');
    }

    sendTelemetry('in_progress', 'in_progress', false);

    function triggerError(message, retryCallback) {
        attempts++;
        const errorBox = document.getElementById('error-box');
        const errorMessage = document.getElementById('error-message');
        if (errorMessage) errorMessage.textContent = message;
        if (errorBox) errorBox.classList.remove('d-none');

        sendTelemetry('hardcore_reset', 'in_progress', false);

        setTimeout(() => {
            if (errorBox) errorBox.classList.add('d-none');
            if (retryCallback) retryCallback();
        }, 1500);
    }

    function shuffle(array) {
        const copy = [...array];
        for (let i = copy.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [copy[i], copy[j]] = [copy[j], copy[i]];
        }
        return copy;
    }

    // ==========================================
    // ЛОГИКА ФАЗЫ 1
    // ==========================================
    const P1_DATABASE = {
        visual: [
            { id: 'v1', text: 'Красный сигнал светофора на перекрестке', tag: 'Оптический', type: 'visual' },
            { id: 'v2', text: 'График курса валют на экране терминала', tag: 'Графика', type: 'visual' },
            { id: 'v3', text: 'Штрих-код формата EAN-13 на коробке', tag: 'Символьный', type: 'visual' },
            { id: 'v4', text: 'Мигание зеленого светодиода сетевой карты', tag: 'Индикация', type: 'visual' },
            { id: 'v5', text: 'Чертеж системного блока в формате CAD', tag: 'Схема', type: 'visual' }
        ],
        auditory: [
            { id: 'a1', text: 'Громкий звуковой сигнал сирены 110 дБ', tag: 'Акустика', type: 'auditory' },
            { id: 'a2', text: 'Голосовое сообщение диспетчера вокзала', tag: 'Речь', type: 'auditory' },
            { id: 'a3', text: 'Зуммер материнской платы (1 длинный, 2 коротких)', tag: 'POST-код', type: 'auditory' },
            { id: 'a4', text: 'Щелчок реле аварийного выключателя', tag: 'Звук', type: 'auditory' },
            { id: 'a5', text: 'Мелодия вызова входящего звонка', tag: 'Аудио', type: 'auditory' }
        ],
        tactile: [
            { id: 't1', text: 'Вибрация смартфона в кармане куртки', tag: 'Вибросигнал', type: 'tactile' },
            { id: 't2', text: 'Шероховатая зернистая поверхность наждачки', tag: 'Текстура', type: 'tactile' },
            { id: 't3', text: 'Горячий радиатор кулера процессора (+65 °C)', tag: 'Терморецептор', type: 'tactile' },
            { id: 't4', text: 'Тактильный щелчок механической клавиши свитча', tag: 'Осязание', type: 'tactile' },
            { id: 't5', text: 'Холодный металлический корпус ноутбука', tag: 'Терморецептор', type: 'tactile' }
        ]
    };

    let p1SelectedCard = null;
    let p1CurrentItems = [];

    function initPhase1() {
        p1SelectedCard = null;
        const poolEl = document.getElementById('p1-cards-pool');
        poolEl.innerHTML = '';

        // Очистить слоты корзин
        document.querySelectorAll('.p1-dropzone').forEach(dz => {
            const slot = dz.querySelector('.p1-slots');
            if (slot) slot.innerHTML = '';
            const countBadge = dz.querySelector('.p1-bucket-count');
            if (countBadge) countBadge.textContent = '0 / 2';
        });

        const vItems = shuffle(P1_DATABASE.visual).slice(0, 2);
        const aItems = shuffle(P1_DATABASE.auditory).slice(0, 2);
        const tItems = shuffle(P1_DATABASE.tactile).slice(0, 2);
        p1CurrentItems = shuffle([...vItems, ...aItems, ...tItems]);

        p1CurrentItems.forEach(item => {
            poolEl.appendChild(createP1CardElement(item));
        });

        updateP1UI();
    }

    function createP1CardElement(item) {
        const card = document.createElement('div');
        card.className = 'card bg-black border border-secondary p-2 p1-card user-select-none';
        card.style.cursor = 'pointer';
        card.style.minWidth = '180px';
        card.style.maxWidth = '320px';
        card.style.flex = '1 1 200px';
        card.dataset.id = item.id;
        card.dataset.type = item.type;
        card.draggable = true;

        card.innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="badge bg-secondary text-dark rounded-0 font-monospace" style="font-size: 0.65rem;">${item.tag}</span>
                <span class="text-secondary small font-monospace" style="font-size: 0.65rem;">СИГНАЛ</span>
            </div>
            <div class="small text-light font-monospace fw-bold">${item.text}</div>
        `;

        card.addEventListener('dragstart', (e) => {
            e.dataTransfer.setData('text/plain', item.id);
        });

        card.addEventListener('click', (e) => {
            const parentDropzone = card.closest('.p1-dropzone');
            if (parentDropzone) {
                if (p1SelectedCard) {
                    parentDropzone.querySelector('.p1-slots').appendChild(p1SelectedCard);
                    p1SelectedCard.classList.remove('border-warning');
                    p1SelectedCard.classList.add('border-secondary');
                    p1SelectedCard = null;
                    updateP1UI();
                    e.stopPropagation();
                    return;
                }
                e.stopPropagation();
                document.getElementById('p1-cards-pool').appendChild(card);
                card.classList.remove('border-warning');
                card.classList.add('border-secondary');
                if (p1SelectedCard === card) p1SelectedCard = null;
                updateP1UI();
                return;
            }

            e.stopPropagation();
            // Выбор карточки в пуле
            if (p1SelectedCard === card) {
                card.classList.remove('border-warning');
                card.classList.add('border-secondary');
                p1SelectedCard = null;
            } else {
                if (p1SelectedCard) {
                    p1SelectedCard.classList.remove('border-warning');
                    p1SelectedCard.classList.add('border-secondary');
                }
                p1SelectedCard = card;
                card.classList.remove('border-secondary');
                card.classList.add('border-warning');
            }
        });

        return card;
    }

    // Обработка зон сброса Фазы 1
    document.querySelectorAll('.p1-dropzone').forEach(zone => {
        zone.addEventListener('dragover', (e) => e.preventDefault());
        zone.addEventListener('drop', (e) => {
            e.preventDefault();
            const id = e.dataTransfer.getData('text/plain');
            const card = document.querySelector(`.p1-card[data-id="${id}"]`);
            if (card) {
                zone.querySelector('.p1-slots').appendChild(card);
                card.classList.remove('border-warning');
                card.classList.add('border-secondary');
                p1SelectedCard = null;
                updateP1UI();
            }
        });

        zone.addEventListener('click', () => {
            if (p1SelectedCard) {
                zone.querySelector('.p1-slots').appendChild(p1SelectedCard);
                p1SelectedCard.classList.remove('border-warning');
                p1SelectedCard.classList.add('border-secondary');
                p1SelectedCard = null;
                updateP1UI();
            }
        });
    });

    document.getElementById('p1-reset-btn')?.addEventListener('click', () => {
        initPhase1();
    });

    function updateP1UI() {
        let totalPlaced = 0;
        document.querySelectorAll('.p1-dropzone').forEach(zone => {
            const count = zone.querySelectorAll('.p1-card').length;
            totalPlaced += count;
            const badge = zone.querySelector('.p1-bucket-count');
            if (badge) badge.textContent = `${count} / 2`;
        });

        const poolCount = document.querySelectorAll('#p1-cards-pool .p1-card').length;
        const counterEl = document.getElementById('p1-counter');
        if (counterEl) counterEl.textContent = `Осталось распределить: ${poolCount}`;

        const verifyBtn = document.getElementById('btn-phase1');
        if (verifyBtn) verifyBtn.disabled = totalPlaced !== 6;
    }

    document.getElementById('btn-phase1')?.addEventListener('click', () => {
        let hasError = false;
        document.querySelectorAll('.p1-dropzone').forEach(zone => {
            const bucketType = zone.dataset.bucket;
            const cards = zone.querySelectorAll('.p1-card');
            cards.forEach(card => {
                if (card.dataset.type !== bucketType) hasError = true;
            });
        });

        if (hasError) {
            triggerError('ОШИБКА КЛАССИФИКАЦИИ: Сигналы попали в несоответствующий орган чувств. Повторите калибровку сенсоров.', () => {
                initPhase1();
            });
        } else {
            document.getElementById('phase1').classList.add('d-none');
            document.getElementById('phase2').classList.remove('d-none');
            document.getElementById('phase-badge').textContent = 'Шаг 2 из 3';
            initPhase2();
        }
    });

    // ==========================================
    // ЛОГИКА ФАЗЫ 2: СЛОТ-ПАЗЛ
    // ==========================================
    const P2_DATABASE = [
        {
            id: 'task_volt',
            title: 'Энергоснабжение серверной стойки',
            rawValue: '220',
            context: { id: 'c_volt', text: 'В, переменное напряжение бытовой электросети', isContext: true },
            meaning: { id: 'm_volt', text: 'Стандартный режим электропитания без скачков', isMeaning: true }
        },
        {
            id: 'task_temp',
            title: 'Климат-контроль дата-центра',
            rawValue: '19.5',
            context: { id: 'c_temp', text: '°C, показания датчика температуры процессора', isContext: true },
            meaning: { id: 'm_temp', text: 'Оптимальное охлаждение, перегрев отсутствует', isMeaning: true }
        },
        {
            id: 'task_net',
            title: 'Магистральный канал связи',
            rawValue: '1000',
            context: { id: 'c_net', text: 'Мбит/с, пропускная способность оптоволокна', isContext: true },
            meaning: { id: 'm_net', text: 'Высокоскоростной гигабитный обмен трафиком', isMeaning: true }
        }
    ];

    const P2_DISTRACTORS = [
        { id: 'd1', text: 'кг, масса корпуса системного блока', isContext: true },
        { id: 'd2', text: 'Аварийный отказ и критический перегрев узла', isMeaning: true }
    ];

    let p2SelectedToken = null;
    let p2ActiveTasks = [];

    function initPhase2() {
        p2SelectedToken = null;
        p2ActiveTasks = shuffle(P2_DATABASE);
        const paletteEl = document.getElementById('p2-palette');
        const tasksEl = document.getElementById('p2-tasks-container');
        paletteEl.innerHTML = '';
        tasksEl.innerHTML = '';

        // Сбор всех токенов + дистракторов
        let tokens = [];
        p2ActiveTasks.forEach(t => {
            tokens.push(t.context);
            tokens.push(t.meaning);
        });
        tokens.push(...P2_DISTRACTORS);
        tokens = shuffle(tokens);

        tokens.forEach(tok => {
            paletteEl.appendChild(createP2TokenElement(tok));
        });

        // Создание 3 задач
        p2ActiveTasks.forEach((t, idx) => {
            const col = document.createElement('div');
            col.className = 'col-12 col-md-4';
            col.innerHTML = `
                <div class="card bg-black border border-secondary rounded-0 p-3 h-100 p2-task-card" data-task-id="${t.id}">
                    <div class="small text-secondary font-monospace mb-1">ЗАДАЧА ${idx + 1}:</div>
                    <div class="fw-bold text-light font-monospace small mb-2">${t.title}</div>
                    
                    <div class="p-2 border border-secondary bg-dark text-center mb-3">
                        <span class="text-secondary small font-monospace d-block">СЫРЫЕ ДАННЫЕ (Data):</span>
                        <span class="fs-4 text-warning font-monospace fw-bold">${t.rawValue}</span>
                    </div>

                    <div class="mb-2">
                        <span class="text-secondary small font-monospace d-block mb-1">КОНТЕКСТ (Смысл / Единицы):</span>
                        <div class="p2-slot border border-secondary p-2 min-vh-5 bg-black text-center" data-slot="context" style="min-height: 48px;">
                            <span class="text-secondary small italic placeholder-text">[Вставьте токен контекста]</span>
                        </div>
                    </div>

                    <div>
                        <span class="text-secondary small font-monospace d-block mb-1">ИНФОРМАЦИЯ (Практический вывод):</span>
                        <div class="p2-slot border border-secondary p-2 min-vh-5 bg-black text-center" data-slot="meaning" style="min-height: 48px;">
                            <span class="text-secondary small italic placeholder-text">[Вставьте токен вывода]</span>
                        </div>
                    </div>
                </div>
            `;
            tasksEl.appendChild(col);
        });

        // Обработка клика по слотам
        document.querySelectorAll('.p2-slot').forEach(slot => {
            slot.addEventListener('click', () => {
                if (p2SelectedToken) {
                    const existingToken = slot.querySelector('.p2-token');
                    if (existingToken) {
                        paletteEl.appendChild(existingToken);
                    }
                    const ph = slot.querySelector('.placeholder-text');
                    if (ph) ph.classList.add('d-none');
                    slot.appendChild(p2SelectedToken);
                    p2SelectedToken.classList.remove('border-warning');
                    p2SelectedToken.classList.add('border-info');
                    p2SelectedToken = null;
                    updateP2UI();
                } else {
                    // Возврат токена из слота в палитру
                    const token = slot.querySelector('.p2-token');
                    if (token) {
                        paletteEl.appendChild(token);
                        const ph = slot.querySelector('.placeholder-text');
                        if (ph) ph.classList.remove('d-none');
                        token.classList.remove('border-warning');
                        token.classList.add('border-info');
                        updateP2UI();
                    }
                }
            });
        });

        updateP2UI();
    }

    function createP2TokenElement(tok) {
        const div = document.createElement('div');
        div.className = 'badge bg-dark text-info border border-info p-2 rounded-0 p2-token user-select-none font-monospace';
        div.style.cursor = 'pointer';
        div.style.fontSize = '0.75rem';
        div.style.whiteSpace = 'normal';
        div.style.lineHeight = '1.3';
        div.dataset.tokenId = tok.id;
        div.textContent = tok.text;

        div.addEventListener('click', (e) => {
            e.stopPropagation();
            const parentSlot = div.closest('.p2-slot');
            if (parentSlot) {
                if (p2SelectedToken) {
                    document.getElementById('p2-palette').appendChild(div);
                    div.classList.remove('border-warning');
                    div.classList.add('border-info');

                    parentSlot.appendChild(p2SelectedToken);
                    p2SelectedToken.classList.remove('border-warning');
                    p2SelectedToken.classList.add('border-info');
                    p2SelectedToken = null;
                    updateP2UI();
                    return;
                }
                // Возврат в палитру
                document.getElementById('p2-palette').appendChild(div);
                const ph = parentSlot.querySelector('.placeholder-text');
                if (ph) ph.classList.remove('d-none');
                div.classList.remove('border-warning');
                div.classList.add('border-info');
                if (p2SelectedToken === div) p2SelectedToken = null;
                updateP2UI();
                return;
            }

            // Выбор в палитре
            if (p2SelectedToken === div) {
                div.classList.remove('border-warning');
                div.classList.add('border-info');
                p2SelectedToken = null;
            } else {
                if (p2SelectedToken) {
                    p2SelectedToken.classList.remove('border-warning');
                    p2SelectedToken.classList.add('border-info');
                }
                p2SelectedToken = div;
                div.classList.remove('border-info');
                div.classList.add('border-warning');
            }
            updateP2UI();
        });

        return div;
    }

    function updateP2UI() {
        const hintEl = document.getElementById('p2-selected-hint');
        if (hintEl) {
            hintEl.textContent = p2SelectedToken ? 'Токен выбран. Нажмите на слот задачи.' : '';
        }

        let filledSlots = 0;
        document.querySelectorAll('.p2-slot').forEach(s => {
            if (s.querySelector('.p2-token')) filledSlots++;
        });

        const verifyBtn = document.getElementById('btn-phase2');
        if (verifyBtn) verifyBtn.disabled = filledSlots !== 6;
    }

    document.getElementById('btn-phase2')?.addEventListener('click', () => {
        let hasError = false;
        document.querySelectorAll('.p2-task-card').forEach(card => {
            const taskId = card.dataset.taskId;
            const taskObj = P2_DATABASE.find(t => t.id === taskId);

            const contextToken = card.querySelector('.p2-slot[data-slot="context"] .p2-token');
            const meaningToken = card.querySelector('.p2-slot[data-slot="meaning"] .p2-token');

            if (!contextToken || contextToken.dataset.tokenId !== taskObj.context.id) hasError = true;
            if (!meaningToken || meaningToken.dataset.tokenId !== taskObj.meaning.id) hasError = true;
        });

        if (hasError) {
            triggerError('ОШИБКА СЕМАНТИКИ: Неверно подобран контекст или сделан ложный вывод из данных. Повторите синтез.', () => {
                initPhase2();
            });
        } else {
            document.getElementById('phase2').classList.add('d-none');
            document.getElementById('phase3').classList.remove('d-none');
            document.getElementById('phase-badge').textContent = 'Шаг 3 из 3';
            initPhase3();
        }
    });

    // ==========================================
    // ЛОГИКА ФАЗЫ 3: КОММУТАЦИЯ СВОЙСТВ
    // ==========================================
    const P3_DATABASE = [
        {
            id: 'inc_act',
            text: 'Штормовое предупреждение поступило на пульт через 2 часа после окончания урагана',
            targetProp: 'prop_act',
            propTitle: 'АКТУАЛЬНОСТЬ',
            propDesc: 'Своевременность и ценность сведений в настоящий момент'
        },
        {
            id: 'inc_und',
            text: 'Диспетчер получил служебную инструкцию на древнем диалекте без перевода',
            targetProp: 'prop_und',
            propTitle: 'ПОНЯТНОСТЬ',
            propDesc: 'Выражение сведений на доступном получателю языке'
        },
        {
            id: 'inc_rel',
            text: 'Сенсор температуры передал значение -350 °C (ниже абсолютного нуля) из-за пробоя провода',
            targetProp: 'prop_rel',
            propTitle: 'ДОСТОВЕРНОСТЬ',
            propDesc: 'Истинность и отсутствие ошибок/фальсификаций в сведениях'
        },
        {
            id: 'inc_com',
            text: 'В сводке написано: "Произошел сбой", но не указаны ни цех, ни агрегат, ни масштабы',
            targetProp: 'prop_com',
            propTitle: 'ПОЛНОТА',
            propDesc: 'Достаточность сведений для принятия единственно верного решения'
        }
    ];

    const P3_PROP_DISTRACTORS = [
        { id: 'prop_obj', propTitle: 'ОБЪЕКТИВНОСТЬ', propDesc: 'Независимость сведений от личного мнения и суждений' },
        { id: 'prop_col', propTitle: 'КРАСОЧНОСТЬ', propDesc: 'Эстетическое художественное оформление текста' }
    ];

    let p3Connections = {}; // incidentId -> propId
    let p3SelectedIncident = null;

    function initPhase3() {
        p3Connections = {};
        p3SelectedIncident = null;

        const incContainer = document.getElementById('p3-incidents');
        const propContainer = document.getElementById('p3-properties');
        incContainer.innerHTML = '';
        propContainer.innerHTML = '';

        const incidents = shuffle(P3_DATABASE);
        incidents.forEach(inc => {
            const card = document.createElement('div');
            card.className = 'card bg-black border border-secondary p-3 p3-incident-card user-select-none';
            card.style.cursor = 'pointer';
            card.dataset.id = inc.id;
            card.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="badge bg-secondary text-dark rounded-0 font-monospace" style="font-size: 0.65rem;">ИНЦИДЕНТ</span>
                    <span class="p3-link-badge badge bg-black border border-secondary text-secondary rounded-0 font-monospace">НЕ СВЯЗАН</span>
                </div>
                <div class="text-light small font-monospace">${inc.text}</div>
            `;

            card.addEventListener('click', () => {
                if (p3SelectedIncident === inc.id) {
                    p3SelectedIncident = null;
                    card.classList.remove('border-warning');
                    card.classList.add('border-secondary');
                } else {
                    document.querySelectorAll('.p3-incident-card').forEach(c => {
                        c.classList.remove('border-warning');
                        c.classList.add('border-secondary');
                    });
                    p3SelectedIncident = inc.id;
                    card.classList.remove('border-secondary');
                    card.classList.add('border-warning');
                }
            });

            incContainer.appendChild(card);
        });

        // Свойства + дистракторы
        let props = P3_DATABASE.map(item => ({
            id: item.targetProp,
            propTitle: item.propTitle,
            propDesc: item.propDesc
        }));
        props.push(...P3_PROP_DISTRACTORS);
        props = shuffle(props);

        props.forEach(prop => {
            const card = document.createElement('div');
            card.className = 'card bg-black border border-secondary p-2 p3-prop-card user-select-none';
            card.style.cursor = 'pointer';
            card.dataset.id = prop.id;
            card.innerHTML = `
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-success font-monospace small">${prop.propTitle}</span>
                    <span class="p3-prop-status text-secondary font-monospace" style="font-size: 0.65rem;">[СВОБОДЕН]</span>
                </div>
                <div class="text-secondary small" style="font-size: 0.7rem; line-height: 1.2;">${prop.propDesc}</div>
            `;

            card.addEventListener('click', () => {
                if (p3SelectedIncident) {
                    // Связать выбранный инцидент с этим свойством
                    p3Connections[p3SelectedIncident] = prop.id;

                    const incCard = document.querySelector(`.p3-incident-card[data-id="${p3SelectedIncident}"]`);
                    if (incCard) {
                        incCard.classList.remove('border-warning');
                        incCard.classList.add('border-success');
                    }
                    p3SelectedIncident = null;
                    updateP3UI();
                } else {
                    // Отвязать, если на это свойство уже назначена связь
                    for (const [incId, pId] of Object.entries(p3Connections)) {
                        if (pId === prop.id) {
                            delete p3Connections[incId];
                            const incCard = document.querySelector(`.p3-incident-card[data-id="${incId}"]`);
                            if (incCard) {
                                incCard.classList.remove('border-success');
                                incCard.classList.add('border-secondary');
                            }
                        }
                    }
                    updateP3UI();
                }
            });

            propContainer.appendChild(card);
        });

        updateP3UI();
    }

    function updateP3UI() {
        const count = Object.keys(p3Connections).length;
        const statusEl = document.getElementById('p3-status');
        if (statusEl) statusEl.textContent = `Скоммутировано: ${count} из 4`;

        document.querySelectorAll('.p3-incident-card').forEach(incCard => {
            const id = incCard.dataset.id;
            const badge = incCard.querySelector('.p3-link-badge');
            if (p3Connections[id]) {
                const targetProp = P3_DATABASE.find(item => item.targetProp === p3Connections[id]) ||
                                   P3_PROP_DISTRACTORS.find(item => item.id === p3Connections[id]);
                if (badge && targetProp) {
                    badge.className = 'badge bg-success text-dark rounded-0 font-monospace';
                    badge.textContent = `СВЯЗЬ: ${targetProp.propTitle}`;
                }
            } else {
                if (badge) {
                    badge.className = 'badge bg-black border border-secondary text-secondary rounded-0 font-monospace';
                    badge.textContent = 'НЕ СВЯЗАН';
                }
            }
        });

        document.querySelectorAll('.p3-prop-card').forEach(pCard => {
            const id = pCard.dataset.id;
            const isUsed = Object.values(p3Connections).includes(id);
            const statusBadge = pCard.querySelector('.p3-prop-status');
            if (isUsed) {
                pCard.classList.add('border-success');
                pCard.classList.remove('border-secondary');
                if (statusBadge) {
                    statusBadge.className = 'p3-prop-status text-success font-monospace fw-bold';
                    statusBadge.textContent = '[ПОДКЛЮЧЕН]';
                }
            } else {
                pCard.classList.remove('border-success');
                pCard.classList.add('border-secondary');
                if (statusBadge) {
                    statusBadge.className = 'p3-prop-status text-secondary font-monospace';
                    statusBadge.textContent = '[СВОБОДЕН]';
                }
            }
        });

        const verifyBtn = document.getElementById('btn-phase3');
        if (verifyBtn) verifyBtn.disabled = count !== 4;
    }

    document.getElementById('btn-phase3')?.addEventListener('click', () => {
        let hasError = false;
        P3_DATABASE.forEach(item => {
            if (p3Connections[item.id] !== item.targetProp) {
                hasError = true;
            }
        });

        if (hasError) {
            triggerError('ОШИБКА АУДИТА: Нарушенные свойства информации определены неверно. Проверьте признаки полноты, актуальности и достоверности.', () => {
                initPhase3();
            });
        } else {
            document.getElementById('phase3').classList.add('d-none');
            document.getElementById('success-screen').classList.remove('d-none');
            document.getElementById('phase-badge').className = 'badge bg-success text-dark border border-success rounded-0 px-3 py-2';
            document.getElementById('phase-badge').textContent = 'Уровень пройден!';
            sendTelemetry('level_complete', 'completed', true);
        }
    });

    // Старт с 1 фазы
    initPhase1();
})();
</script>
