---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
// Уровень 2 (Продвинутый)
// Тема: Информация и данные (7 класс, Урок 9)
// Аналитические расчеты: сенсорный поток, параметры оцифровки и дискретизации, фильтрация шума, формула Хартли.
// Исключительно ручной ввод (Zero Multiple Choice), платформа anti-paste.
// 5 процедурных фаз. Ошибка = hardcore_reset и процедурная перегенерация текущей фазы.
---

<TaskLayout level={2} bodyClass="font-monospace m-0 p-0">
<div class="container-fluid min-vh-100 p-2 p-md-4 rounded-0 bg-dark text-warning">
    <div class="row">
        <div class="col-12">
            <!-- Шапка терминала -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center border-bottom border-warning pb-2 mb-3 gap-2">
                <div>
                    <h2 class="h5 text-warning font-monospace mb-0 text-uppercase">ТЕРМИНАЛ АНАЛИТИКА // МЕТРИКИ ДАННЫХ И ДИСКРЕТИЗАЦИЯ</h2>
                    <span class="small text-secondary">7 КЛАСС // УРОК 9: ИНФОРМАЦИЯ И ДАННЫЕ (УРОВЕНЬ 2)</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span id="phase-badge" class="badge bg-black text-warning border border-warning rounded-0 px-3 py-2">Шаг 1 из 5</span>
                    <span class="badge border border-warning text-warning bg-black rounded-0 px-3 py-2">ПРОДВИНУТЫЙ РЕЖИМ</span>
                </div>
            </div>

            <!-- Блок системных ошибок -->
            <div id="error-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3" role="alert">
                <span class="fw-bold">[СИСТЕМНЫЙ СБОЙ]</span> <span id="error-message">Неверный ввод! Процедурная перегенерация параметров...</span>
            </div>

            <!-- Уведомление о попытке вставки (Anti-Paste) -->
            <div id="paste-notice" class="alert alert-warning bg-black text-warning border border-warning rounded-0 d-none mb-3" role="alert">
                <span class="fw-bold">🛡️ АНТИ-СПИСЫВАНИЕ:</span> Вставка из буфера обмена заблокирована. Рассчитайте значение на черновике и наберите число вручную с клавиатуры!
            </div>

            <!-- Экран успешного прохождения -->
            <div id="success-screen" class="card bg-black border border-warning rounded-0 p-4 text-center d-none my-4">
                <div class="mb-3 fs-1">📊</div>
                <h3 class="text-warning font-monospace text-uppercase mb-2">Уровень 2 Успешно Завершен!</h3>
                <p class="text-secondary small font-monospace mb-3">
                    Все аналитические расчеты выполнены безошибочно. Параметры дискретизации, сенсорного баланса и кодовых емкостей подтверждены.
                </p>
                <div class="d-flex justify-content-center">
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-0 font-monospace">СТАТУС: АНАЛИТИЧЕСКИЙ ЗАЧЕТ ПОЛУЧЕН</span>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- ФАЗА 1: Сенсорный баланс человека (CCS = 4)                               -->
            <!-- ========================================================================= -->
            <div id="phase1" class="card bg-black border-warning rounded-0 mb-4 phase-card">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0 py-2">
                    <span class="fw-bold">ФАЗА 1 ИЗ 5: Расчет сенсорного баланса восприятия</span>
                    <span class="badge bg-warning text-dark rounded-0">РУЧНОЙ ВВОД ЧИСЛА</span>
                </div>
                <div class="card-body p-2 p-md-3">
                    <p class="text-light small mb-3">
                        Органы чувств человека воспринимают информацию неравномерно. Подавляющая часть внешнего информационного потока поступает через зрительный сенсорный канал (глаза).
                    </p>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3" style="max-width: 680px;">
                        <div class="text-secondary small mb-1 text-uppercase fw-bold">Аналитическая задача:</div>
                        <div id="p1-task-desc" class="text-light font-monospace small mb-3">Загрузка задания...</div>

                        <div class="mb-2">
                            <label for="p1-input" class="form-label text-warning small font-monospace" id="p1-label">Объем зрительной информации (Кбайт):</label>
                            <div class="input-group">
                                <input type="text" inputmode="numeric" id="p1-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Введите число..." autocomplete="off">
                                <button id="p1-btn" class="btn btn-warning rounded-0 font-monospace text-uppercase fw-bold">Проверить</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- ФАЗА 2: Многошаговая дискретизация аналогового потока (CCS = 6)            -->
            <!-- ========================================================================= -->
            <div id="phase2" class="card bg-black border-warning rounded-0 mb-4 phase-card d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0 py-2">
                    <span class="fw-bold">ФАЗА 2 ИЗ 5: Оцифровка аналогового сигнала датчика</span>
                    <span class="badge bg-warning text-dark rounded-0">МНОГОШАГОВЫЙ РАСЧЕТ</span>
                </div>
                <div class="card-body p-2 p-md-3">
                    <p class="text-light small mb-3">
                        При дискретизации непрерывный аналоговый сигнал измеряется через равные промежутки времени, а каждое мгновенное значение кодируется числом фиксированной длины в байтах.
                    </p>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3" style="max-width: 680px;">
                        <div class="text-secondary small mb-1 text-uppercase fw-bold">Аналитическая задача:</div>
                        <div id="p2-task-desc" class="text-light font-monospace small mb-3">Загрузка задания...</div>

                        <div class="mb-2">
                            <label for="p2-input" class="form-label text-warning small font-monospace" id="p2-label">Общий объем сырых данных (байт):</label>
                            <div class="input-group">
                                <input type="text" inputmode="numeric" id="p2-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Введите число..." autocomplete="off">
                                <button id="p2-btn" class="btn btn-warning rounded-0 font-monospace text-uppercase fw-bold">Проверить</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- ФАЗА 3: ПИК 1 — Инверсный расчет частоты оцифровки звука (CCS = 7-8)       -->
            <!-- ========================================================================= -->
            <div id="phase3" class="card bg-black border-warning rounded-0 mb-4 phase-card d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0 py-2">
                    <span class="fw-bold">ФАЗА 3 ИЗ 5: Инверсный аудит параметров оцифровки звука</span>
                    <span class="badge bg-danger text-light rounded-0">ПИК СЛОЖНОСТИ // ИНВЕРСИЯ</span>
                </div>
                <div class="card-body p-2 p-md-3">
                    <p class="text-light small mb-3">
                        Инверсная задача: зная итоговый размер оцифрованного моно-аудиофайла, его длительность и глубину кодирования одного отсчета (в битах), восстановите частоту дискретизации (количество измерений в 1 секунду).
                    </p>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3" style="max-width: 680px;">
                        <div class="text-secondary small mb-1 text-uppercase fw-bold">Аналитическая задача:</div>
                        <div id="p3-task-desc" class="text-light font-monospace small mb-3">Загрузка задания...</div>

                        <div class="mb-2">
                            <label for="p3-input" class="form-label text-warning small font-monospace" id="p3-label">Частота дискретизации (Гц):</label>
                            <div class="input-group">
                                <input type="text" inputmode="numeric" id="p3-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Введите частоту в Гц..." autocomplete="off">
                                <button id="p3-btn" class="btn btn-warning rounded-0 font-monospace text-uppercase fw-bold">Проверить</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- ФАЗА 4: Фильтрация информационного шума и дубликатов (CCS = 5-6)          -->
            <!-- ========================================================================= -->
            <div id="phase4" class="card bg-black border-warning rounded-0 mb-4 phase-card d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0 py-2">
                    <span class="fw-bold">ФАЗА 4 ИЗ 5: Фильтрация информационного шума и избыточности</span>
                    <span class="badge bg-info text-dark rounded-0">ДОЛИНА КОНСОЛИДАЦИИ</span>
                </div>
                <div class="card-body p-2 p-md-3">
                    <p class="text-light small mb-3">
                        В реальных сетях сырой поток данных засорен паразитными шумами и избыточными дубликатами. Полезной информацией становятся только достоверные и уникальные пакеты.
                    </p>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3" style="max-width: 680px;">
                        <div class="text-secondary small mb-1 text-uppercase fw-bold">Аналитическая задача:</div>
                        <div id="p4-task-desc" class="text-light font-monospace small mb-3">Загрузка задания...</div>

                        <div class="mb-2">
                            <label for="p4-input" class="form-label text-warning small font-monospace" id="p4-label">Количество полезных уникальных пакетов:</label>
                            <div class="input-group">
                                <input type="text" inputmode="numeric" id="p4-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Введите число..." autocomplete="off">
                                <button id="p4-btn" class="btn btn-warning rounded-0 font-monospace text-uppercase fw-bold">Проверить</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- ФАЗА 5: КУЛЬМИНАЦИЯ — Формула Хартли и кодовый резерв (CCS = 8-9)          -->
            <!-- ========================================================================= -->
            <div id="phase5" class="card bg-black border-warning rounded-0 mb-4 phase-card d-none">
                <div class="card-header bg-dark border-warning text-warning d-flex justify-content-between align-items-center rounded-0 py-2">
                    <span class="fw-bold">ФАЗА 5 ИЗ 5: Формула Хартли и резерв дискретного кодирования</span>
                    <span class="badge bg-danger text-light rounded-0">КУЛЬМИНАЦИОННЫЙ ПИК</span>
                </div>
                <div class="card-body p-2 p-md-3">
                    <p class="text-light small mb-3">
                        Для дискретного кодирования <strong>N</strong> различных команд или состояний используется формула Хартли 
                        <strong class="text-warning">2<sup>i</sup> ≥ N</strong>, где <strong>i</strong> — целое минимальное число бит. 
                        Разница между максимальной кодовой емкостью <strong>2<sup>i</sup></strong> и количеством команд <strong>N</strong> составляет резервный запас кодов.
                    </p>

                    <div class="card bg-dark border-secondary rounded-0 p-3 mb-3" style="max-width: 680px;">
                        <div class="text-secondary small mb-1 text-uppercase fw-bold">Аналитическая задача:</div>
                        <div id="p5-task-desc" class="text-light font-monospace small mb-3">Загрузка задания...</div>

                        <div class="mb-2">
                            <label for="p5-input" class="form-label text-warning small font-monospace" id="p5-label">Количество свободных резервных кодов:</label>
                            <div class="input-group">
                                <input type="text" inputmode="numeric" id="p5-input" class="form-control bg-black text-warning border-warning rounded-0 font-monospace" placeholder="Введите число резервных кодов..." autocomplete="off">
                                <button id="p5-btn" class="btn btn-warning rounded-0 font-monospace text-uppercase fw-bold">Проверить</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
</TaskLayout>

<script is:inline>
(function() {
    const missionName = 'Урок 9 :: Информация и данные (Уровень 2)';
    const startTime = new Date();
    let attempts = 0;

    function sendTelemetry(action_type, status, success) {
        window.parent.postMessage({
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: action_type,
            status: status,
            start_time: startTime.toISOString(),
            time_spent_sec: Math.floor((new Date() - startTime) / 1000),
            attempts_count: attempts,
            success: success
        }, '*');
    }

    sendTelemetry('in_progress', 'in_progress', false);

    function triggerError(message, retryCallback) {
        attempts++;
        const errorBox = document.getElementById('error-box');
        const errorMessage = document.getElementById('error-message');
        if (errorMessage) errorMessage.textContent = message;
        if (errorBox) errorBox.classList.remove('d-none');

        sendTelemetry('hardcore_reset', 'in_progress', false);

        setTimeout(() => {
            if (errorBox) errorBox.classList.add('d-none');
            if (retryCallback) retryCallback();
        }, 1500);
    }

    function showNotice(msg) {
        const notice = document.getElementById('paste-notice');
        if (notice) {
            notice.classList.remove('d-none');
            setTimeout(() => notice.classList.add('d-none'), 3000);
        }
    }

    // Защита от копипасты на всех полях ввода
    document.querySelectorAll('input').forEach(input => {
        input.addEventListener('paste', (e) => {
            e.preventDefault();
            showNotice();
        });
        input.addEventListener('drop', (e) => {
            e.preventDefault();
        });
    });

    function parseCleanNumber(inputEl) {
        const raw = inputEl ? inputEl.value : '';
        if (!raw) return NaN;
        const cleaned = String(raw).trim().replace(/\s+/g, '').replace(',', '.');
        return Math.round(parseFloat(cleaned));
    }

    ['p1-input', 'p2-input', 'p3-input', 'p4-input', 'p5-input'].forEach((id, idx) => {
        const input = document.getElementById(id);
        if (input) {
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    document.getElementById(`p${idx + 1}-btn`)?.click();
                }
            });
        }
    });

    // =========================================================================
    // ФАЗА 1: Сенсорный баланс
    // =========================================================================
    let p1CorrectVal = 0;

    function initPhase1() {
        const volumes = [800, 1000, 1200, 1400, 1500, 1600, 2000];
        const percents = [80, 85, 90];
        const v = volumes[Math.floor(Math.random() * volumes.length)];
        const p = percents[Math.floor(Math.random() * percents.length)];

        p1CorrectVal = Math.round(v * (p / 100));

        const desc = document.getElementById('p1-task-desc');
        if (desc) {
            desc.innerHTML = `В ходе эксперимента установлено, что за сутки оператор воспринял мультимедийный информационный поток общим объемом <strong>${v} Кбайт</strong>. Известно, что доля визуальной (зрительной) информации составила ровно <strong>${p}%</strong> от общего объема. Рассчитайте объем зрительной информации в <strong>Кбайтах</strong>.`;
        }
        const input = document.getElementById('p1-input');
        if (input) input.value = '';
    }

    document.getElementById('p1-btn')?.addEventListener('click', () => {
        const val = parseCleanNumber(document.getElementById('p1-input'));
        if (val === p1CorrectVal) {
            document.getElementById('phase1').classList.add('d-none');
            document.getElementById('phase2').classList.remove('d-none');
            document.getElementById('phase-badge').textContent = 'Шаг 2 из 5';
            initPhase2();
        } else {
            triggerError(`ОШИБКА РАСЧЕТА: Получено значение ${val}. Проверьте вычисление процентов: V = Общий_объем * (Процент / 100). Перегенерация...`, () => {
                initPhase1();
            });
        }
    });

    // =========================================================================
    // ФАЗА 2: Многошаговая дискретизация
    // =========================================================================
    let p2CorrectVal = 0;

    function initPhase2() {
        const intervals = [1, 2, 5]; // секунды между замерами
        const minutes = [2, 3, 4, 5]; // длительность измерения
        const bytesPerSample = [2, 4]; // байт на отсчет

        const s = intervals[Math.floor(Math.random() * intervals.length)];
        const m = minutes[Math.floor(Math.random() * minutes.length)];
        const b = bytesPerSample[Math.floor(Math.random() * bytesPerSample.length)];

        const totalSeconds = m * 60;
        const samplesCount = Math.floor(totalSeconds / s);
        p2CorrectVal = samplesCount * b;

        const desc = document.getElementById('p2-task-desc');
        if (desc) {
            desc.innerHTML = `Метеорологический датчик выполняет дискретизацию аналогового сигнала температуры, сохраняя одно измерение каждые <strong>${s} с</strong>. Мониторинг продолжался ровно <strong>${m} мин</strong>. Каждое измерение фиксируется числом размером <strong>${b} байт</strong>. Рассчитайте суммарный объем накопленных сырых данных в <strong>байтах</strong>.`;
        }
        const input = document.getElementById('p2-input');
        if (input) input.value = '';
    }

    document.getElementById('p2-btn')?.addEventListener('click', () => {
        const val = parseCleanNumber(document.getElementById('p2-input'));
        if (val === p2CorrectVal) {
            document.getElementById('phase2').classList.add('d-none');
            document.getElementById('phase3').classList.remove('d-none');
            document.getElementById('phase-badge').textContent = 'Шаг 3 из 5';
            initPhase3();
        } else {
            triggerError(`ОШИБКА ДИСКРЕТИЗАЦИИ: Получено значение ${val}. Переведите минуты в секунды, найдите число отсчетов и умножьте на размер одного замера. Перегенерация...`, () => {
                initPhase2();
            });
        }
    });

    // =========================================================================
    // ФАЗА 3: ПИК 1 — Инверсный расчет частоты оцифровки звука
    // =========================================================================
    let p3CorrectVal = 0;

    function initPhase3() {
        // Частоты дискретизации (Гц)
        const sampleRates = [8000, 11025, 16000, 22050];
        const durations = [5, 10, 20]; // секунды
        const bitsPerSample = 16; // 2 байта на отсчет (моно)

        const f = sampleRates[Math.floor(Math.random() * sampleRates.length)];
        const t = durations[Math.floor(Math.random() * durations.length)];
        const bytesPerSample = bitsPerSample / 8; // 2

        const totalBytes = f * t * bytesPerSample;
        p3CorrectVal = f;

        const desc = document.getElementById('p3-task-desc');
        if (desc) {
            desc.innerHTML = `В ходе криминалистического анализа звукового фрагмента выяснилось, что монофоническая аудиозапись длительностью <strong>${t} с</strong> заняла в памяти ровно <strong>${totalBytes.toLocaleString('ru-RU')} байт</strong>. Разрешение звука (глубина кодирования одного замера) составляет <strong>${bitsPerSample} бит</strong>. Рассчитайте частоту дискретизации аудиофайла (в <strong>герцах, Гц</strong>).`;
        }
        const input = document.getElementById('p3-input');
        if (input) input.value = '';
    }

    document.getElementById('p3-btn')?.addEventListener('click', () => {
        const val = parseCleanNumber(document.getElementById('p3-input'));
        if (val === p3CorrectVal) {
            document.getElementById('phase3').classList.add('d-none');
            document.getElementById('phase4').classList.remove('d-none');
            document.getElementById('phase-badge').textContent = 'Шаг 4 из 5';
            initPhase4();
        } else {
            triggerError(`ОШИБКА ИНВЕРСИИ: Получено ${val} Гц. Помните: 16 бит = 2 байта. Разделите общий размер на 2, затем на длительность в секундах. Перегенерация...`, () => {
                initPhase3();
            });
        }
    });

    // =========================================================================
    // ФАЗА 4: Фильтрация информационного шума
    // =========================================================================
    let p4CorrectVal = 0;

    function initPhase4() {
        const totals = [300, 400, 500, 600, 750];
        const noiseValues = [35, 45, 50, 60];
        const dupValues = [65, 75, 80, 90];

        const total = totals[Math.floor(Math.random() * totals.length)];
        const noise = noiseValues[Math.floor(Math.random() * noiseValues.length)];
        const dup = dupValues[Math.floor(Math.random() * dupValues.length)];

        p4CorrectVal = total - noise - dup;

        const desc = document.getElementById('p4-task-desc');
        if (desc) {
            desc.innerHTML = `На станцию приема данных со спутника поступил телеметрический пакет общим объемом <strong>${total} пакетов</strong>. В процессе аппаратного декодирования выяснилось, что <strong>${noise} пакетов</strong> повреждены электромагнитным шумом и отброшены, а еще <strong>${dup} пакетов</strong> являются избыточными копиями (дубликатами). Сколько <strong>уникальных полезных информационных пакетов</strong> поступило на сервер?`;
        }
        const input = document.getElementById('p4-input');
        if (input) input.value = '';
    }

    document.getElementById('p4-btn')?.addEventListener('click', () => {
        const val = parseCleanNumber(document.getElementById('p4-input'));
        if (val === p4CorrectVal) {
            document.getElementById('phase4').classList.add('d-none');
            document.getElementById('phase5').classList.remove('d-none');
            document.getElementById('phase-badge').textContent = 'Шаг 5 из 5';
            initPhase5();
        } else {
            triggerError(`ОШИБКА ФИЛЬТРАЦИИ: Получено значение ${val}. Полезная информация = Всего - Шум - Дубликаты. Перегенерация...`, () => {
                initPhase4();
            });
        }
    });

    // =========================================================================
    // ФАЗА 5: КУЛЬМИНАЦИЯ — Формула Хартли и резервный запас кодов
    // =========================================================================
    let p5CorrectVal = 0;

    function initPhase5() {
        // Команды, требующие 5, 6 или 7 бит
        // 2^5 = 32, 2^6 = 64, 2^7 = 128
        const presets = [
            { n: 20, pow: 32, bits: 5 },
            { n: 25, pow: 32, bits: 5 },
            { n: 40, pow: 64, bits: 6 },
            { n: 50, pow: 64, bits: 6 },
            { n: 75, pow: 128, bits: 7 },
            { n: 90, pow: 128, bits: 7 }
        ];

        const p = presets[Math.floor(Math.random() * presets.length)];
        p5CorrectVal = p.pow - p.n;

        const desc = document.getElementById('p5-task-desc');
        if (desc) {
            desc.innerHTML = `Для автоматического управления манипулятором робота разработана система из <strong>${p.n} различных команд</strong>. Все команды решено закодировать двоичным кодом минимально возможной фиксированной длины (в битах), одинаковой для каждой команды (по формуле Хартли 2<sup>i</sup> ≥ N). Сколько еще <strong>дополнительных резервных команд</strong> можно будет добавить в систему, не увеличивая длину двоичного кода?`;
        }
        const input = document.getElementById('p5-input');
        if (input) input.value = '';
    }

    document.getElementById('p5-btn')?.addEventListener('click', () => {
        const val = parseCleanNumber(document.getElementById('p5-input'));
        if (val === p5CorrectVal) {
            document.getElementById('phase5').classList.add('d-none');
            document.getElementById('success-screen').classList.remove('d-none');
            document.getElementById('phase-badge').className = 'badge bg-warning text-dark border border-warning rounded-0 px-3 py-2';
            document.getElementById('phase-badge').textContent = 'Уровень пройден!';
            sendTelemetry('level_complete', 'completed', true);
        } else {
            triggerError(`ОШИБКА ХАРТЛИ: Получено значение ${val}. Найдите ближайшую степень двойки 2^i >= N, и рассчитайте разницу: Резерв = 2^i - N. Перегенерация...`, () => {
                initPhase5();
            });
        }
    });

    // Запуск с 1 фазы
    initPhase1();
})();
</script>
