---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={1}>
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <h2 class="h4 text-success mb-0">Тренажер: Таблицы истинности (Уровень 1)</h2>
            <span class="badge border border-success text-success bg-dark rounded-0 px-3 py-2">Манипуляция мышью // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-success rounded-0">
            <div class="card-body p-3 p-md-4">

                <!-- Панель статуса шагов и счетчика попыток -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2 gap-2">
                    <div>
                        <span id="phase-badge" class="badge bg-success text-dark rounded-0 fs-6 me-2">Шаг 1 из 3</span>
                        <span id="phase-title" class="text-light fw-bold fs-6">Синтез матрицы истинности (Прямое переключение ячеек)</span>
                    </div>
                    <div class="text-secondary small">
                        Ошибки / Перекалибровки: <span id="attempts-display" class="text-warning fw-bold">0</span>
                    </div>
                </div>

                <!-- Алерт ошибки / процедурной перекалибровки -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between">
                        <span>[СБОЙ ЛОГИЧЕСКОГО КОНТУРА] <span id="feedback-text">Нарушено логическое правило вычисления!</span> Перекалибровка параметров...</span>
                        <span class="spinner-border spinner-border-sm text-danger ms-2" role="status"></span>
                    </div>
                </div>

                <!-- ================= ФАЗА 1: СИНТЕЗ МАТРИЦЫ ИСТИННОСТИ (Interactive Grid Cell Toggle) ================= -->
                <div id="phase1" class="phase-container">
                    <div class="mb-3 text-light">
                        <p class="mb-1">
                            <span class="text-success fw-bold">Целевая директива:</span> Постройте полную таблицу истинности для составного логического выражения.
                        </p>
                        <p class="text-secondary small mb-2">
                            Кликайте по интерактивным ячейкам <code>[ ? ]</code> для переключения логического сигнала (<code>0 ↔ 1</code>) в соответствии с правилами конъюнкции, дизъюнкции и инверсии.
                        </p>
                        <div class="p-3 bg-black border border-secondary text-center mb-3">
                            <span class="text-secondary me-2">Исследуемое логическое выражение:</span>
                            <span id="p1-formula-display" class="text-warning fw-bold fs-5">F = ¬(A ∧ B) ∨ ¬A</span>
                        </div>
                    </div>

                    <!-- Таблица истинности с интерактивными ячейками -->
                    <div class="table-responsive mb-3">
                        <table class="table table-bordered border-secondary table-dark text-center align-middle mb-0 font-monospace">
                            <thead>
                                <tr class="border-bottom border-success text-success">
                                    <th style="width: 15%; min-width: 60px;">A</th>
                                    <th style="width: 15%; min-width: 60px;">B</th>
                                    <th id="p1-header-op1" style="width: 23%; min-width: 110px;">Действие 1</th>
                                    <th id="p1-header-op2" style="width: 23%; min-width: 110px;">Действие 2</th>
                                    <th id="p1-header-res" class="text-warning" style="width: 24%; min-width: 120px;">F (Итог)</th>
                                </tr>
                            </thead>
                            <tbody id="p1-table-body">
                                <!-- Строки генерируются процедурно -->
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4">
                        <div class="text-secondary small">
                            Статус матрицы: <span id="p1-status-text" class="text-info">Заполните все ячейки со знаком [ ? ]</span>
                        </div>
                        <button id="p1-verify-btn" type="button" class="btn btn-success rounded-0 px-4 py-2 fw-bold text-dark" style="min-height: 48px;" disabled>
                            ПРОВЕРИТЬ МАТРИЦУ ИСТИННОСТИ →
                        </button>
                    </div>
                </div>

                <!-- ================= ФАЗА 2: ДЕШИФРОВКА СКРЫТЫХ ПЕРЕМЕННЫХ (Slot & Snap D&D) ================= -->
                <div id="phase2" class="phase-container d-none">
                    <div class="mb-3 text-light">
                        <p class="mb-1">
                            <span class="text-success fw-bold">Целевая директива:</span> Восстановите привязку логических переменных к столбцам таблицы истинности.
                        </p>
                        <p class="text-secondary small mb-2">
                            Имена входных столбцов зашифрованы. Перетащите токены переменных мышью (или используйте клик по токену, затем по слоту) в правильные гнезда над таблицей.
                        </p>
                        <div class="p-3 bg-black border border-secondary text-center mb-3">
                            <span class="text-secondary me-2">Исследуемая функция:</span>
                            <span id="p2-formula-display" class="text-warning fw-bold fs-5">F = (x ∧ ¬y) ∨ z</span>
                        </div>
                    </div>

                    <!-- Таблица с целевыми слотами в шапке -->
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered border-secondary table-dark text-center align-middle mb-0 font-monospace">
                            <thead>
                                <tr class="bg-black">
                                    <th style="width: 25%; min-width: 100px;">
                                        <div class="text-secondary small mb-1">Столбец 1</div>
                                        <div id="p2-slot-0" class="p2-slot border border-secondary bg-dark text-warning p-2 d-flex align-items-center justify-content-center" style="min-height: 48px; cursor: pointer;" data-slot-idx="0">
                                            [ СЛОТ 1 ]
                                        </div>
                                    </th>
                                    <th style="width: 25%; min-width: 100px;">
                                        <div class="text-secondary small mb-1">Столбец 2</div>
                                        <div id="p2-slot-1" class="p2-slot border border-secondary bg-dark text-warning p-2 d-flex align-items-center justify-content-center" style="min-height: 48px; cursor: pointer;" data-slot-idx="1">
                                            [ СЛОТ 2 ]
                                        </div>
                                    </th>
                                    <th style="width: 25%; min-width: 100px;">
                                        <div class="text-secondary small mb-1">Столбец 3</div>
                                        <div id="p2-slot-2" class="p2-slot border border-secondary bg-dark text-warning p-2 d-flex align-items-center justify-content-center" style="min-height: 48px; cursor: pointer;" data-slot-idx="2">
                                            [ СЛОТ 3 ]
                                        </div>
                                    </th>
                                    <th class="text-success" style="width: 25%; min-width: 100px;">
                                        <div class="text-secondary small mb-1">Результат</div>
                                        <div class="border border-success bg-black text-success p-2 d-flex align-items-center justify-content-center fw-bold" style="min-height: 48px;">
                                            F
                                        </div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="p2-table-body">
                                <!-- Строки значений генерируются процедурно -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Палитра токенов с дистракторами -->
                    <div class="p-3 bg-black border border-secondary mb-3">
                        <div class="text-secondary small mb-2 d-flex justify-content-between align-items-center">
                            <span>ДОСТУПНЫЕ ТОКЕНЫ ПЕРЕМЕННЫХ (Перетащите или выберите кликом):</span>
                            <span class="text-info small">Присутствуют токены-дистракторы!</span>
                        </div>
                        <div id="p2-tokens-pool" class="d-flex flex-wrap gap-2 align-items-center">
                            <!-- Токены генерируются процедурно -->
                        </div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4">
                        <button id="p2-clear-btn" type="button" class="btn btn-outline-secondary rounded-0 px-3 py-2 small" style="min-height: 48px;">
                            Очистить слоты
                        </button>
                        <button id="p2-verify-btn" type="button" class="btn btn-success rounded-0 px-4 py-2 fw-bold text-dark" style="min-height: 48px;" disabled>
                            ПРОВЕРИТЬ СОПОСТАВЛЕНИЕ →
                        </button>
                    </div>
                </div>

                <!-- ================= ФАЗА 3: СОРТИРОВКА ВЫРАЖЕНИЙ ПО БУНКЕРАМ (Drag-to-Bucket Classification) ================= -->
                <div id="phase3" class="phase-container d-none">
                    <div class="mb-3 text-light">
                        <p class="mb-1">
                            <span class="text-success fw-bold">Целевая директива:</span> Классифицируйте логические выражения по свойствам их таблиц истинности.
                        </p>
                        <p class="text-secondary small mb-2">
                            Перетащите каждую карточку выражения мышью в соответствующий бункер (или кликните карточку, затем нужный бункер).
                        </p>
                    </div>

                    <!-- Пул карточек для сортировки -->
                    <div class="p-3 bg-black border border-secondary mb-4">
                        <div class="text-secondary small mb-2">
                            ПУЛ ЛОГИЧЕСКИХ ВЫРАЖЕНИЙ ДЛЯ АНАЛИЗА:
                        </div>
                        <div id="p3-source-pool" class="d-flex flex-wrap gap-2 p-2 border border-dashed border-secondary bg-dark" style="min-height: 70px;">
                            <!-- Карточки генерируются процедурно -->
                        </div>
                    </div>

                    <!-- Три целевых бункера -->
                    <div class="row g-3 mb-4">
                        <!-- Бункер 1: Тавтология -->
                        <div class="col-12 col-sm-4">
                            <div class="p3-bucket card bg-black border border-success rounded-0 h-100" data-bucket="tautology" style="min-height: 140px; cursor: pointer;">
                                <div class="card-header bg-dark border-bottom border-success text-success p-2 text-center">
                                    <div class="fw-bold">ТАВТОЛОГИЯ</div>
                                    <div class="small text-secondary">Закон логики // Все [ 1 ]</div>
                                </div>
                                <div id="p3-bucket-tautology-body" class="card-body p-2 d-flex flex-column gap-2" style="min-height: 90px;">
                                    <!-- Сюда складываются карточки -->
                                </div>
                            </div>
                        </div>

                        <!-- Бункер 2: Противоречие -->
                        <div class="col-12 col-sm-4">
                            <div class="p3-bucket card bg-black border border-danger rounded-0 h-100" data-bucket="contradiction" style="min-height: 140px; cursor: pointer;">
                                <div class="card-header bg-dark border-bottom border-danger text-danger p-2 text-center">
                                    <div class="fw-bold">ПРОТИВОРЕЧИЕ</div>
                                    <div class="small text-secondary">Тождественно ложно // Все [ 0 ]</div>
                                </div>
                                <div id="p3-bucket-contradiction-body" class="card-body p-2 d-flex flex-column gap-2" style="min-height: 90px;">
                                    <!-- Сюда складываются карточки -->
                                </div>
                            </div>
                        </div>

                        <!-- Бункер 3: Выполнимое -->
                        <div class="col-12 col-sm-4">
                            <div class="p3-bucket card bg-black border border-warning rounded-0 h-100" data-bucket="contingent" style="min-height: 140px; cursor: pointer;">
                                <div class="card-header bg-dark border-bottom border-warning text-warning p-2 text-center">
                                    <div class="fw-bold">ВЫПОЛНИМОЕ</div>
                                    <div class="small text-secondary">Нейтральное // Есть и [ 0 ], и [ 1 ]</div>
                                </div>
                                <div id="p3-bucket-contingent-body" class="card-body p-2 d-flex flex-column gap-2" style="min-height: 90px;">
                                    <!-- Сюда складываются карточки -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4">
                        <div class="text-secondary small">
                            Осталось распределить карточек: <span id="p3-remaining-count" class="text-warning fw-bold">4</span>
                        </div>
                        <button id="p3-verify-btn" type="button" class="btn btn-success rounded-0 px-4 py-2 fw-bold text-dark" style="min-height: 48px;" disabled>
                            ЗАВЕРШИТЬ АНАЛИЗ И СДАТЬ УРОВЕНЬ 1 ✓
                        </button>
                    </div>
                </div>

                <!-- ================= ЭКРАН ТРИУМФА / ЗАВЕРШЕНИЕ УРОВНЯ ================= -->
                <div id="victory-screen" class="d-none text-center py-5">
                    <div class="display-5 text-success fw-bold mb-3">✓ УРОВЕНЬ 1 ПРОЙДЕН</div>
                    <p class="fs-5 text-light mb-2">
                        Манипуляционный тренажер таблиц истинности успешно завершен.
                    </p>
                    <p class="text-secondary mb-4">
                        Все матрицы вычислены, скрытые переменные идентифицированы, законы логики и противоречия верифицированы.
                    </p>
                    <div class="p-3 bg-black border border-success d-inline-block text-start mb-4 font-monospace">
                        <div class="text-success mb-1">СВОДНЫЙ ОТЧЕТ ТЕЛЕМЕТРИИ:</div>
                        <div class="text-light small">Статус: <span class="text-success fw-bold">LEVEL_COMPLETE</span></div>
                        <div class="text-light small">Зафиксировано попыток: <span id="final-attempts" class="text-warning fw-bold">0</span></div>
                        <div class="text-light small">Время сессии: <span id="final-time" class="text-info fw-bold">0</span> сек.</div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script is:inline>
        const missionName = 'Урок 10 :: Таблицы истинности (Уровень 1)';
        const startTime = Date.now();
        let attempts = 0;
        let isLocked = false;
        let currentPhase = 1;

        // Отправка сообщений в родительское окно LMS
        function sendTelemetry(action_type, success = false) {
            const timeSpent = Math.max(1, Math.floor((Date.now() - startTime) / 1000));
            window.parent.postMessage({
                type: 'TELEMETRY_EVENT',
                mission_name: missionName,
                action_type: action_type,
                status: action_type === 'level_complete' ? 'completed' : 'in_progress',
                start_time: new Date(startTime).toISOString(),
                time_spent_sec: timeSpent,
                attempts_count: attempts,
                success: success
            }, '*');
        }

        function rnd(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function shuffle(arr) {
            const a = [...arr];
            for (let i = a.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [a[i], a[j]] = [a[j], a[i]];
            }
            return a;
        }

        // Обработка ошибки: показ алертом, отправка hardcore_reset, перегенерация текущей фазы
        function triggerErrorAndRegenerate(message, regenerateFn) {
            if (isLocked) return;
            isLocked = true;
            attempts++;
            document.getElementById('attempts-display').textContent = String(attempts);
            sendTelemetry('hardcore_reset', false);

            const feedbackBox = document.getElementById('feedback-box');
            const feedbackText = document.getElementById('feedback-text');
            feedbackText.textContent = message;
            feedbackBox.classList.remove('d-none');

            setTimeout(() => {
                feedbackBox.classList.add('d-none');
                isLocked = false;
                regenerateFn();
            }, 1300);
        }

        // =========================================================================
        // ФАЗА 1: ИНТЕРАКТИВНОЕ ЗАПОЛНЕНИЕ МАТРИЦЫ ИСТИННОСТИ (Grid Cell Toggle)
        // =========================================================================
        let p1CurrentTemplate = null;

        const p1Templates = [
            {
                formula: 'F = ¬(A ∧ B) ∨ ¬A',
                op1Label: '1. A ∧ B',
                op2Label: '2. ¬(A ∧ B)',
                resLabel: '3. F = ¬(A ∧ B) ∨ ¬A',
                evalRow: (a, b) => {
                    const op1 = (a && b) ? 1 : 0;
                    const op2 = op1 ? 0 : 1;
                    const notA = a ? 0 : 1;
                    const res = (op2 || notA) ? 1 : 0;
                    return [op1, op2, res];
                }
            },
            {
                formula: 'F = ¬A ∨ (A ∧ B)',
                op1Label: '1. ¬A',
                op2Label: '2. A ∧ B',
                resLabel: '3. F = ¬A ∨ (A ∧ B)',
                evalRow: (a, b) => {
                    const op1 = a ? 0 : 1;
                    const op2 = (a && b) ? 1 : 0;
                    const res = (op1 || op2) ? 1 : 0;
                    return [op1, op2, res];
                }
            },
            {
                formula: 'F = (A ∨ ¬B) ∧ A',
                op1Label: '1. ¬B',
                op2Label: '2. A ∨ ¬B',
                resLabel: '3. F = (A ∨ ¬B) ∧ A',
                evalRow: (a, b) => {
                    const op1 = b ? 0 : 1;
                    const op2 = (a || op1) ? 1 : 0;
                    const res = (op2 && a) ? 1 : 0;
                    return [op1, op2, res];
                }
            },
            {
                formula: 'F = ¬(A ∨ B) ∨ (A ∧ B)',
                op1Label: '1. A ∨ B',
                op2Label: '2. ¬(A ∨ B)',
                resLabel: '3. F = ¬(A ∨ B) ∨ (A ∧ B)',
                evalRow: (a, b) => {
                    const op1 = (a || b) ? 1 : 0;
                    const op2 = op1 ? 0 : 1;
                    const andAB = (a && b) ? 1 : 0;
                    const res = (op2 || andAB) ? 1 : 0;
                    return [op1, op2, res];
                }
            },
            {
                formula: 'F = (¬A ∧ B) ∨ ¬B',
                op1Label: '1. ¬A',
                op2Label: '2. ¬A ∧ B',
                resLabel: '3. F = (¬A ∧ B) ∨ ¬B',
                evalRow: (a, b) => {
                    const op1 = a ? 0 : 1;
                    const op2 = (op1 && b) ? 1 : 0;
                    const notB = b ? 0 : 1;
                    const res = (op2 || notB) ? 1 : 0;
                    return [op1, op2, res];
                }
            },
            {
                formula: 'F = ¬A ∧ (A ∨ B)',
                op1Label: '1. ¬A',
                op2Label: '2. A ∨ B',
                resLabel: '3. F = ¬A ∧ (A ∨ B)',
                evalRow: (a, b) => {
                    const op1 = a ? 0 : 1;
                    const op2 = (a || b) ? 1 : 0;
                    const res = (op1 && op2) ? 1 : 0;
                    return [op1, op2, res];
                }
            },
            {
                formula: 'F = (A ∧ ¬B) ∨ (¬A ∧ B)',
                op1Label: '1. A ∧ ¬B',
                op2Label: '2. ¬A ∧ B',
                resLabel: '3. F = (A ∧ ¬B) ∨ (¬A ∧ B)',
                evalRow: (a, b) => {
                    const op1 = (a && !b) ? 1 : 0;
                    const op2 = (!a && b) ? 1 : 0;
                    const res = (op1 || op2) ? 1 : 0;
                    return [op1, op2, res];
                }
            }
        ];

        function initPhase1() {
            p1CurrentTemplate = p1Templates[rnd(0, p1Templates.length - 1)];

            document.getElementById('p1-formula-display').textContent = p1CurrentTemplate.formula;
            document.getElementById('p1-header-op1').textContent = p1CurrentTemplate.op1Label;
            document.getElementById('p1-header-op2').textContent = p1CurrentTemplate.op2Label;
            document.getElementById('p1-header-res').textContent = p1CurrentTemplate.resLabel;

            const tbody = document.getElementById('p1-table-body');
            tbody.innerHTML = '';

            const inputRows = [
                { a: 0, b: 0 },
                { a: 0, b: 1 },
                { a: 1, b: 0 },
                { a: 1, b: 1 }
            ];

            inputRows.forEach((r, rowIdx) => {
                const tr = document.createElement('tr');

                // Столбцы входов A и B
                tr.innerHTML = `
                    <td class="bg-black text-light fw-bold">${r.a}</td>
                    <td class="bg-black text-light fw-bold">${r.b}</td>
                    <td class="p-1">
                        <button type="button" class="btn btn-outline-secondary p1-cell font-monospace fs-5 fw-bold rounded-0 w-100" style="min-width: 48px; min-height: 48px;" data-row="${rowIdx}" data-col="0" data-val="?">?</button>
                    </td>
                    <td class="p-1">
                        <button type="button" class="btn btn-outline-secondary p1-cell font-monospace fs-5 fw-bold rounded-0 w-100" style="min-width: 48px; min-height: 48px;" data-row="${rowIdx}" data-col="1" data-val="?">?</button>
                    </td>
                    <td class="p-1">
                        <button type="button" class="btn btn-outline-secondary p1-cell font-monospace fs-5 fw-bold rounded-0 w-100" style="min-width: 48px; min-height: 48px;" data-row="${rowIdx}" data-col="2" data-val="?">?</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            updatePhase1VerifyBtn();
        }

        function updatePhase1VerifyBtn() {
            const cells = document.querySelectorAll('.p1-cell');
            let allSet = true;
            cells.forEach(c => {
                if (c.getAttribute('data-val') === '?') allSet = false;
            });
            document.getElementById('p1-verify-btn').disabled = !allSet;
            const statusEl = document.getElementById('p1-status-text');
            if (allSet) {
                statusEl.textContent = 'Все ячейки заполнены. Нажмите кнопку проверки.';
                statusEl.className = 'text-success fw-bold';
            } else {
                statusEl.textContent = 'Заполните все ячейки со знаком [ ? ] кликом мыши.';
                statusEl.className = 'text-info';
            }
        }

        document.getElementById('p1-table-body').addEventListener('click', (e) => {
            if (isLocked) return;
            const btn = e.target.closest('.p1-cell');
            if (!btn) return;

            const curVal = btn.getAttribute('data-val');
            let nextVal = '0';
            if (curVal === '?') nextVal = '0';
            else if (curVal === '0') nextVal = '1';
            else if (curVal === '1') nextVal = '0';

            btn.setAttribute('data-val', nextVal);
            btn.textContent = nextVal;

            if (nextVal === '1') {
                btn.className = 'btn btn-dark text-success border border-success p1-cell font-monospace fs-5 fw-bold rounded-0 w-100';
            } else if (nextVal === '0') {
                btn.className = 'btn btn-dark text-warning border border-warning p1-cell font-monospace fs-5 fw-bold rounded-0 w-100';
            }

            updatePhase1VerifyBtn();
        });

        document.getElementById('p1-verify-btn').addEventListener('click', () => {
            if (isLocked) return;

            const inputRows = [
                { a: 0, b: 0 },
                { a: 0, b: 1 },
                { a: 1, b: 0 },
                { a: 1, b: 1 }
            ];

            let hasError = false;
            let errorMsg = '';

            inputRows.forEach((r, rowIdx) => {
                const expected = p1CurrentTemplate.evalRow(r.a, r.b);
                for (let colIdx = 0; colIdx < 3; colIdx++) {
                    const btn = document.querySelector(`.p1-cell[data-row="${rowIdx}"][data-col="${colIdx}"]`);
                    const userVal = parseInt(btn.getAttribute('data-val'), 10);
                    if (userVal !== expected[colIdx]) {
                        hasError = true;
                        btn.classList.remove('border-success', 'border-warning');
                        btn.classList.add('border-danger', 'text-danger');
                        if (!errorMsg) {
                            const colNames = ['Действие 1', 'Действие 2', 'Итоговая функция F'];
                            errorMsg = `Ошибка в строке (A=${r.a}, B=${r.b}), столбец "${colNames[colIdx]}". Ожидалось ${expected[colIdx]}, введено ${userVal}!`;
                        }
                    }
                }
            });

            if (hasError) {
                triggerErrorAndRegenerate(errorMsg, initPhase1);
                return;
            }

            // Переход к Фазе 2
            currentPhase = 2;
            sendTelemetry('in_progress', false);
            document.getElementById('phase-badge').textContent = 'Шаг 2 из 3';
            document.getElementById('phase-title').textContent = 'Дешифровка скрытых переменных (Slot & Snap токенами)';
            document.getElementById('phase1').classList.add('d-none');
            document.getElementById('phase2').classList.remove('d-none');
            initPhase2();
        });

        // =========================================================================
        // ФАЗА 2: ДЕШИФРОВКА СКРЫТЫХ ПЕРЕМЕННЫХ (Slot & Snap D&D)
        // =========================================================================
        let p2SelectedToken = null;
        let p2CurrentScenario = null;

        // Банк сценариев дешифровки таблицы истинности (по материалам теории, раздел 7)
        const p2Scenarios = [
            {
                formula: 'F = (x ∧ ¬y) ∨ z',
                // Эталонная функция
                fn: (x, y, z) => ((x && !y) || z) ? 1 : 0,
                // Целевой порядок столбцов
                targetColumns: ['z', 'y', 'x'],
                // Строки значений (x, y, z) для генерации таблицы
                rows: [
                    { x: 0, y: 1, z: 0 },
                    { x: 1, y: 0, z: 0 },
                    { x: 0, y: 0, z: 1 },
                    { x: 1, y: 1, z: 0 }
                ],
                distractors: ['w', 'u', '¬x']
            },
            {
                formula: 'F = (¬x ∨ y) ∧ z',
                fn: (x, y, z) => ((!x || y) && z) ? 1 : 0,
                targetColumns: ['y', 'x', 'z'],
                rows: [
                    { x: 1, y: 0, z: 1 },
                    { x: 0, y: 0, z: 1 },
                    { x: 0, y: 1, z: 1 },
                    { x: 1, y: 1, z: 0 }
                ],
                distractors: ['w', 'v', 'k']
            },
            {
                formula: 'F = (x ∨ y) ∧ ¬z',
                fn: (x, y, z) => ((x || y) && !z) ? 1 : 0,
                targetColumns: ['z', 'x', 'y'],
                rows: [
                    { x: 1, y: 0, z: 0 },
                    { x: 0, y: 1, z: 0 },
                    { x: 0, y: 0, z: 0 },
                    { x: 1, y: 1, z: 1 }
                ],
                distractors: ['w', 'p', '¬z']
            },
            {
                formula: 'F = ¬x ∧ (y ∨ ¬z)',
                fn: (x, y, z) => (!x && (y || !z)) ? 1 : 0,
                targetColumns: ['x', 'z', 'y'],
                rows: [
                    { x: 0, y: 1, z: 1 },
                    { x: 1, y: 1, z: 0 },
                    { x: 0, y: 0, z: 1 },
                    { x: 0, y: 0, z: 0 }
                ],
                distractors: ['w', 'u', '¬y']
            },
            {
                formula: 'F = ¬(x ∧ y) ∧ z',
                fn: (x, y, z) => (!(x && y) && z) ? 1 : 0,
                targetColumns: ['y', 'z', 'x'],
                rows: [
                    { x: 1, y: 1, z: 1 },
                    { x: 1, y: 0, z: 1 },
                    { x: 0, y: 1, z: 1 },
                    { x: 0, y: 0, z: 0 }
                ],
                distractors: ['w', 'm', 'q']
            }
        ];

        function initPhase2() {
            p2CurrentScenario = p2Scenarios[rnd(0, p2Scenarios.length - 1)];
            p2SelectedToken = null;

            document.getElementById('p2-formula-display').textContent = p2CurrentScenario.formula;

            // Очистка слотов
            for (let i = 0; i < 3; i++) {
                const slot = document.getElementById(`p2-slot-${i}`);
                slot.textContent = `[ СЛОТ ${i + 1} ]`;
                slot.className = 'p2-slot border border-secondary bg-dark text-warning p-2 d-flex align-items-center justify-content-center';
                slot.removeAttribute('data-val');
            }

            // Заполнение строк таблицы
            const tbody = document.getElementById('p2-table-body');
            tbody.innerHTML = '';

            p2CurrentScenario.rows.forEach(r => {
                const tr = document.createElement('tr');
                const rowObj = { x: r.x, y: r.y, z: r.z };
                const col0Val = rowObj[p2CurrentScenario.targetColumns[0]];
                const col1Val = rowObj[p2CurrentScenario.targetColumns[1]];
                const col2Val = rowObj[p2CurrentScenario.targetColumns[2]];
                const resVal = p2CurrentScenario.fn(r.x, r.y, r.z);

                tr.innerHTML = `
                    <td class="bg-black text-light fw-bold fs-5">${col0Val}</td>
                    <td class="bg-black text-light fw-bold fs-5">${col1Val}</td>
                    <td class="bg-black text-light fw-bold fs-5">${col2Val}</td>
                    <td class="bg-dark text-success fw-bold fs-5 border border-success">${resVal}</td>
                `;
                tbody.appendChild(tr);
            });

            // Заполнение палитры токенов
            const pool = document.getElementById('p2-tokens-pool');
            pool.innerHTML = '';

            const allTokens = shuffle(['x', 'y', 'z', ...p2CurrentScenario.distractors]);
            allTokens.forEach(t => {
                const btn = document.createElement('div');
                btn.className = 'p2-token btn btn-outline-warning font-monospace fs-5 fw-bold rounded-0 px-3 py-2 text-center';
                btn.style.minWidth = '52px';
                btn.style.minHeight = '48px';
                btn.style.cursor = 'grab';
                btn.draggable = true;
                btn.textContent = t;
                btn.setAttribute('data-val', t);
                pool.appendChild(btn);
            });

            updatePhase2VerifyBtn();
        }

        function updatePhase2VerifyBtn() {
            let allFilled = true;
            for (let i = 0; i < 3; i++) {
                const slot = document.getElementById(`p2-slot-${i}`);
                if (!slot.getAttribute('data-val')) allFilled = false;
            }
            document.getElementById('p2-verify-btn').disabled = !allFilled;
        }

        function assignTokenToSlot(slot, val) {
            // Если такой токен уже был в другом слоте, освобождаем тот слот
            for (let i = 0; i < 3; i++) {
                const s = document.getElementById(`p2-slot-${i}`);
                if (s !== slot && s.getAttribute('data-val') === val) {
                    s.removeAttribute('data-val');
                    s.textContent = `[ СЛОТ ${i + 1} ]`;
                    s.className = 'p2-slot border border-secondary bg-dark text-warning p-2 d-flex align-items-center justify-content-center';
                }
            }

            slot.setAttribute('data-val', val);
            slot.textContent = val;
            slot.className = 'p2-slot border border-success bg-black text-success fw-bold fs-5 p-2 d-flex align-items-center justify-content-center';
            updatePhase2VerifyBtn();
        }

        // Клик по палитре токенов
        document.getElementById('p2-tokens-pool').addEventListener('click', (e) => {
            if (isLocked) return;
            const tok = e.target.closest('.p2-token');
            if (!tok) return;

            document.querySelectorAll('.p2-token').forEach(b => b.classList.remove('active', 'border-success', 'bg-warning', 'text-dark'));
            p2SelectedToken = tok;
            tok.classList.add('active', 'border-success', 'bg-warning', 'text-dark');
        });

        // Drag & Drop токенов
        document.getElementById('p2-tokens-pool').addEventListener('dragstart', (e) => {
            const tok = e.target.closest('.p2-token');
            if (!tok) return;
            p2SelectedToken = tok;
            if (e.dataTransfer) {
                e.dataTransfer.setData('text/plain', tok.getAttribute('data-val'));
            }
        });

        // Клик по слотам
        for (let i = 0; i < 3; i++) {
            const slot = document.getElementById(`p2-slot-${i}`);

            slot.addEventListener('click', () => {
                if (isLocked) return;
                if (p2SelectedToken) {
                    const val = p2SelectedToken.getAttribute('data-val');
                    assignTokenToSlot(slot, val);
                    document.querySelectorAll('.p2-token').forEach(b => b.classList.remove('active', 'border-success', 'bg-warning', 'text-dark'));
                    p2SelectedToken = null;
                } else if (slot.getAttribute('data-val')) {
                    // Очистить слот по повторному клику
                    slot.removeAttribute('data-val');
                    slot.textContent = `[ СЛОТ ${i + 1} ]`;
                    slot.className = 'p2-slot border border-secondary bg-dark text-warning p-2 d-flex align-items-center justify-content-center';
                    updatePhase2VerifyBtn();
                }
            });

            slot.addEventListener('dragover', (e) => {
                e.preventDefault();
            });

            slot.addEventListener('drop', (e) => {
                if (isLocked) return;
                e.preventDefault();
                const val = (e.dataTransfer && e.dataTransfer.getData('text/plain')) || (p2SelectedToken && p2SelectedToken.getAttribute('data-val'));
                if (val) {
                    assignTokenToSlot(slot, val);
                    p2SelectedToken = null;
                }
            });
        }

        document.getElementById('p2-clear-btn').addEventListener('click', () => {
            if (isLocked) return;
            for (let i = 0; i < 3; i++) {
                const s = document.getElementById(`p2-slot-${i}`);
                s.removeAttribute('data-val');
                s.textContent = `[ СЛОТ ${i + 1} ]`;
                s.className = 'p2-slot border border-secondary bg-dark text-warning p-2 d-flex align-items-center justify-content-center';
            }
            updatePhase2VerifyBtn();
        });

        document.getElementById('p2-verify-btn').addEventListener('click', () => {
            if (isLocked) return;

            const userColumns = [
                document.getElementById('p2-slot-0').getAttribute('data-val'),
                document.getElementById('p2-slot-1').getAttribute('data-val'),
                document.getElementById('p2-slot-2').getAttribute('data-val')
            ];

            const targetCols = p2CurrentScenario.targetColumns;
            const isMatch = userColumns[0] === targetCols[0] && userColumns[1] === targetCols[1] && userColumns[2] === targetCols[2];

            if (!isMatch) {
                const msg = `Неверное сопоставление переменных! Столбцы не удовлетворяют строкам таблицы истинности для функции ${p2CurrentScenario.formula}.`;
                triggerErrorAndRegenerate(msg, initPhase2);
                return;
            }

            // Переход к Фазе 3
            currentPhase = 3;
            sendTelemetry('in_progress', false);
            document.getElementById('phase-badge').textContent = 'Шаг 3 из 3';
            document.getElementById('phase-title').textContent = 'Классификация выражений по свойствам таблиц истинности (Drag-to-Bucket)';
            document.getElementById('phase2').classList.add('d-none');
            document.getElementById('phase3').classList.remove('d-none');
            initPhase3();
        });

        // =========================================================================
        // ФАЗА 3: СОРТИРОВКА ВЫРАЖЕНИЙ ПО БУНКЕРАМ (Drag-to-Bucket Classification)
        // =========================================================================
        let p3SelectedCard = null;

        const p3ExpressionsPool = {
            tautology: [
                'A ∨ ¬A',
                '¬(A ∧ ¬A)',
                'A ∨ (¬A ∨ B)',
                '(A ∧ B) ∨ ¬(A ∧ B)',
                '(A ∨ B) ∨ ¬A',
                '¬(A ∧ B) ∨ A',
                '(A ∨ ¬A) ∨ B',
                '¬A ∨ (A ∨ ¬B)'
            ],
            contradiction: [
                'A ∧ ¬A',
                '¬(A ∨ ¬A)',
                '(A ∧ B) ∧ ¬A',
                '(A ∧ ¬B) ∧ B',
                '(A ∨ B) ∧ (¬A ∧ ¬B)',
                'A ∧ (¬A ∧ B)',
                '¬(A ∨ ¬B) ∧ ¬B',
                '(A ∧ ¬A) ∧ B'
            ],
            contingent: [
                'A ∧ B',
                'A ∨ ¬B',
                '¬A ∧ (A ∨ B)',
                '(A ∨ B) ∧ ¬B',
                '(A ∧ B) ∨ ¬A',
                '¬A ∨ (B ∧ A)',
                '(A ∨ ¬B) ∧ B',
                'A ∧ (B ∨ ¬A)'
            ]
        };

        function initPhase3() {
            p3SelectedCard = null;
            const sourcePool = document.getElementById('p3-source-pool');
            sourcePool.innerHTML = '';
            document.getElementById('p3-bucket-tautology-body').innerHTML = '';
            document.getElementById('p3-bucket-contradiction-body').innerHTML = '';
            document.getElementById('p3-bucket-contingent-body').innerHTML = '';

            // Выбираем 4 карточки: 1 тавтология, 1 противоречие, 1 выполнимое + 1 случайное
            const types = ['tautology', 'contradiction', 'contingent'];
            const extraType = types[rnd(0, 2)];
            const selectedTypes = ['tautology', 'contradiction', 'contingent', extraType];

            const chosenCards = [];
            const usedTexts = new Set();

            selectedTypes.forEach((type, idx) => {
                const pool = p3ExpressionsPool[type];
                let expr = pool[rnd(0, pool.length - 1)];
                let tries = 0;
                while (usedTexts.has(expr) && tries < 20) {
                    expr = pool[rnd(0, pool.length - 1)];
                    tries++;
                }
                usedTexts.add(expr);
                chosenCards.push({
                    id: `card-${idx}-${Date.now()}`,
                    text: expr,
                    category: type
                });
            });

            const shuffledCards = shuffle(chosenCards);

            shuffledCards.forEach(c => {
                const el = document.createElement('div');
                el.className = 'p3-card btn btn-dark border border-secondary text-light font-monospace fw-bold rounded-0 text-start px-3 py-2 d-flex align-items-center justify-content-between';
                el.style.minHeight = '48px';
                el.style.cursor = 'grab';
                el.draggable = true;
                el.id = c.id;
                el.setAttribute('data-category', c.category);
                el.setAttribute('data-text', c.text);
                el.innerHTML = `
                    <span>${c.text}</span>
                    <span class="badge bg-black text-secondary border border-secondary small ms-2">:: ПЕРЕТАЩИТЬ</span>
                `;
                sourcePool.appendChild(el);
            });

            updatePhase3Remaining();
        }

        function updatePhase3Remaining() {
            const remaining = document.querySelectorAll('#p3-source-pool .p3-card').length;
            document.getElementById('p3-remaining-count').textContent = String(remaining);
            document.getElementById('p3-verify-btn').disabled = remaining > 0;
        }

        function moveCardToContainer(card, targetContainer) {
            if (!card || !targetContainer) return;
            card.classList.remove('active', 'border-warning', 'bg-warning', 'text-dark');
            targetContainer.appendChild(card);
            p3SelectedCard = null;
            updatePhase3Remaining();
        }

        // Клик по фазе 3 (выбор карточки и клик по бункеру)
        document.getElementById('phase3').addEventListener('click', (e) => {
            if (isLocked) return;

            const card = e.target.closest('.p3-card');
            const bucket = e.target.closest('.p3-bucket');
            const sourcePool = e.target.closest('#p3-source-pool');

            // Клик по карточке в бункере для возврата в исходный пул
            if (card && card.closest('.p3-bucket') && !p3SelectedCard) {
                moveCardToContainer(card, document.getElementById('p3-source-pool'));
                return;
            }

            // Выбор карточки
            if (card) {
                document.querySelectorAll('.p3-card').forEach(c => c.classList.remove('active', 'border-warning', 'bg-warning', 'text-dark'));
                p3SelectedCard = card;
                card.classList.add('active', 'border-warning');
                return;
            }

            // Клик по бункеру при выбранной карточке
            if (bucket && p3SelectedCard) {
                const bucketType = bucket.getAttribute('data-bucket');
                const targetBody = document.getElementById(`p3-bucket-${bucketType}-body`);
                moveCardToContainer(p3SelectedCard, targetBody);
                return;
            }

            // Клик по исходному пулу при выбранной карточке
            if (sourcePool && p3SelectedCard) {
                moveCardToContainer(p3SelectedCard, sourcePool);
                return;
            }
        });

        // Drag & Drop карточек в бункеры
        document.getElementById('phase3').addEventListener('dragstart', (e) => {
            const card = e.target.closest('.p3-card');
            if (!card) return;
            p3SelectedCard = card;
            if (e.dataTransfer) {
                e.dataTransfer.setData('text/plain', card.id);
            }
        });

        document.querySelectorAll('.p3-bucket').forEach(bucket => {
            bucket.addEventListener('dragover', (e) => {
                e.preventDefault();
            });

            bucket.addEventListener('drop', (e) => {
                if (isLocked) return;
                e.preventDefault();
                const bucketType = bucket.getAttribute('data-bucket');
                const targetBody = document.getElementById(`p3-bucket-${bucketType}-body`);
                const cardId = (e.dataTransfer && e.dataTransfer.getData('text/plain')) || (p3SelectedCard && p3SelectedCard.id);
                if (cardId) {
                    const card = document.getElementById(cardId);
                    moveCardToContainer(card, targetBody);
                }
            });
        });

        document.getElementById('p3-source-pool').addEventListener('dragover', (e) => {
            e.preventDefault();
        });

        document.getElementById('p3-source-pool').addEventListener('drop', (e) => {
            if (isLocked) return;
            e.preventDefault();
            const cardId = (e.dataTransfer && e.dataTransfer.getData('text/plain')) || (p3SelectedCard && p3SelectedCard.id);
            if (cardId) {
                const card = document.getElementById(cardId);
                moveCardToContainer(card, document.getElementById('p3-source-pool'));
            }
        });

        document.getElementById('p3-verify-btn').addEventListener('click', () => {
            if (isLocked) return;

            const categories = ['tautology', 'contradiction', 'contingent'];
            let hasError = false;
            let errorMsg = '';

            categories.forEach(cat => {
                const bucketBody = document.getElementById(`p3-bucket-${cat}-body`);
                const cards = bucketBody.querySelectorAll('.p3-card');
                cards.forEach(card => {
                    const correctCat = card.getAttribute('data-category');
                    if (correctCat !== cat) {
                        hasError = true;
                        const text = card.getAttribute('data-text');
                        const catNames = {
                            tautology: 'ТАВТОЛОГИЯ (Все 1)',
                            contradiction: 'ПРОТИВОРЕЧИЕ (Все 0)',
                            contingent: 'ВЫПОЛНИМОЕ (0 и 1)'
                        };
                        if (!errorMsg) {
                            errorMsg = `Ошибка классификации! Выражение "${text}" помещено в "${catNames[cat]}", но на самом деле это "${catNames[correctCat]}"!`;
                        }
                    }
                });
            });

            if (hasError) {
                triggerErrorAndRegenerate(errorMsg, initPhase3);
                return;
            }

            // Успешное завершение Уровня 1!
            const finalTimeSec = Math.max(1, Math.floor((Date.now() - startTime) / 1000));
            document.getElementById('final-attempts').textContent = String(attempts);
            document.getElementById('final-time').textContent = String(finalTimeSec);

            document.getElementById('phase3').classList.add('d-none');
            document.getElementById('victory-screen').classList.remove('d-none');
            document.getElementById('phase-badge').className = 'badge bg-success text-dark rounded-0 fs-6 me-2';
            document.getElementById('phase-badge').textContent = 'Успешно завершено';
            document.getElementById('phase-title').textContent = 'Все 3 этапа манипуляционного тренажера пройдены!';

            sendTelemetry('level_complete', true);
        });

        // Экспорт DEV-состояния для Playwright автотестов и симулятора персон
        window.__DEV_LEVEL1_STATE__ = {
            getPhase: () => currentPhase,
            getAttempts: () => attempts,
            getP1Template: () => p1CurrentTemplate,
            getP2Scenario: () => p2CurrentScenario,
            solvePhase1: () => {
                const inputRows = [
                    { a: 0, b: 0 },
                    { a: 0, b: 1 },
                    { a: 1, b: 0 },
                    { a: 1, b: 1 }
                ];
                inputRows.forEach((r, rowIdx) => {
                    const expected = p1CurrentTemplate.evalRow(r.a, r.b);
                    for (let colIdx = 0; colIdx < 3; colIdx++) {
                        const btn = document.querySelector(`.p1-cell[data-row="${rowIdx}"][data-col="${colIdx}"]`);
                        const targetVal = expected[colIdx];
                        btn.setAttribute('data-val', String(targetVal));
                        btn.textContent = String(targetVal);
                        if (targetVal === 1) {
                            btn.className = 'btn btn-dark text-success border border-success p1-cell font-monospace fs-5 fw-bold rounded-0 w-100';
                        } else {
                            btn.className = 'btn btn-dark text-warning border border-warning p1-cell font-monospace fs-5 fw-bold rounded-0 w-100';
                        }
                    }
                });
                updatePhase1VerifyBtn();
                document.getElementById('p1-verify-btn').click();
            },
            solvePhase2: () => {
                const targetCols = p2CurrentScenario.targetColumns;
                for (let i = 0; i < 3; i++) {
                    const slot = document.getElementById(`p2-slot-${i}`);
                    assignTokenToSlot(slot, targetCols[i]);
                }
                updatePhase2VerifyBtn();
                document.getElementById('p2-verify-btn').click();
            },
            solvePhase3: () => {
                const cards = Array.from(document.querySelectorAll('#p3-source-pool .p3-card'));
                cards.forEach(c => {
                    const cat = c.getAttribute('data-category');
                    const targetBody = document.getElementById(`p3-bucket-${cat}-body`);
                    moveCardToContainer(c, targetBody);
                });
                document.getElementById('p3-verify-btn').click();
            }
        };

        // =========================================================================
        // ИНИЦИАЛИЗАЦИЯ ТРЕНАЖЕРА
        // =========================================================================
        initPhase1();
        sendTelemetry('in_progress', false);
    </script>
</TaskLayout>
