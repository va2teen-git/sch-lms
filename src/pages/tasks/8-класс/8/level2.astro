---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={2}>
    <div class="container my-4 font-monospace">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 text-warning mb-0">Тренажер: Аналитический верификатор логических выражений (Уровень 2)</h2>
            <span class="badge border border-warning text-warning bg-dark rounded-0 px-3 py-2">Ручной ввод // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-warning rounded-0">
            <div class="card-body p-4">

                <!-- Заголовок и счетчик попыток -->
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="level-badge" class="badge bg-warning text-dark rounded-0 fs-6 me-2">Шаг 1 из 5</span>
                        <span id="level-title" class="text-light fw-bold fs-6">Вычисление булевых формул по приоритетам</span>
                    </div>
                    <div class="text-secondary small">
                        Ошибок: <span id="attempts-display" class="text-warning">0</span>
                    </div>
                </div>

                <!-- ================= ФАЗА 1: ВЫЧИСЛЕНИЕ БУЛЕВЫХ ФОРМУЛ ================= -->
                <div id="phase1" class="phase-container">
                    <h5 class="text-warning mb-2">Шаг 1: Вычисление составного логического выражения с приоритетами</h5>
                    <p class="text-light">
                        Процессор перехватил логическое условие шины управления. Зафиксированы значения входных булевых переменных:
                        <span class="badge bg-black border border-warning text-warning fs-6" id="p1-vars-display"></span>.
                    </p>
                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">ЛОГИЧЕСКОЕ ВЫРАЖЕНИЕ:</div>
                        <div class="fs-4 text-light fw-bold" id="p1-expr-display"></div>
                        <div class="text-secondary small mt-2">
                            * Порядок действий: 1) Скобки; 2) Отрицание (¬); 3) Умножение (∧); 4) Сложение (∨).
                        </div>
                    </div>
                    <p class="text-secondary small">
                        Вычислите итоговое логическое значение выражения. Введите <strong class="text-warning">1</strong> (Истина) или <strong class="text-warning">0</strong> (Ложь):
                    </p>
                    <div class="input-group mb-3 w-50">
                        <input type="text" id="p1-input" class="form-control bg-black text-warning border-warning rounded-0" placeholder="1 или 0" autocomplete="off">
                        <button id="p1-btn" class="btn btn-outline-warning rounded-0 px-4">ПРОВЕРИТЬ</button>
                    </div>
                    <div id="p1-feedback" class="alert alert-danger bg-black text-danger border-danger rounded-0 d-none py-2">
                        [ОШИБКА РАСЧЕТА] Неверное булево значение! Перегенерация формулы...
                    </div>
                </div>

                <!-- ================= ФАЗА 2: ЧИСЛОВЫЕ ИНТЕРВАЛЫ И НЕРАВЕНСТВА ================= -->
                <div id="phase2" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 2: Анализ числовых интервалов и раскрытие отрицаний</h5>
                    <p class="text-light">
                        Система мониторинга анализирует числовой телеметрический параметр датчика: 
                        <span class="badge bg-black border border-warning text-warning fs-6" id="p2-x-display"></span>.
                    </p>
                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">ПРОВЕРЯЕМОЕ УСЛОВИЕ:</div>
                        <div class="fs-4 text-light fw-bold" id="p2-statement-display"></div>
                        <div class="text-secondary small mt-2">
                            * Помните: отрицание строгого неравенства ¬(x &lt; A) превращается в нестрогое: (x &ge; A).
                        </div>
                    </div>
                    <p class="text-secondary small">
                        Истинно ли данное условие при заданном значении x? Введите <strong class="text-warning">1</strong> (Истина) или <strong class="text-warning">0</strong> (Ложь):
                    </p>
                    <div class="input-group mb-3 w-50">
                        <input type="text" id="p2-input" class="form-control bg-black text-warning border-warning rounded-0" placeholder="1 или 0" autocomplete="off">
                        <button id="p2-btn" class="btn btn-outline-warning rounded-0 px-4">ПРОВЕРИТЬ</button>
                    </div>
                    <div id="p2-feedback" class="alert alert-danger bg-black text-danger border-danger rounded-0 d-none py-2">
                        [СБОЙ ИНТЕРВАЛА] Ошибка в оценке числового неравенства! Пересчет диапазона...
                    </div>
                </div>

                <!-- ================= ФАЗА 3: ПРЕДИКАТЫ ДЕЛИМОСТИ И ЧЕТНОСТИ ================= -->
                <div id="phase3" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 3: Составные предикаты делимости и свойств чисел</h5>
                    <p class="text-light">
                        Фильтр базы данных проверяет транзакцию с целочисленным ключом:
                        <span class="badge bg-black border border-warning text-warning fs-6" id="p3-x-display"></span>.
                    </p>
                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">ЛОГИЧЕСКОЕ УТВЕРЖДЕНИЕ:</div>
                        <div class="fs-4 text-light fw-bold" id="p3-statement-display"></div>
                    </div>
                    <p class="text-secondary small">
                        Определите истинность условия. Введите <strong class="text-warning">1</strong> (Истина) или <strong class="text-warning">0</strong> (Ложь):
                    </p>
                    <div class="input-group mb-3 w-50">
                        <input type="text" id="p3-input" class="form-control bg-black text-warning border-warning rounded-0" placeholder="1 или 0" autocomplete="off">
                        <button id="p3-btn" class="btn btn-outline-warning rounded-0 px-4">ПРОВЕРИТЬ</button>
                    </div>
                    <div id="p3-feedback" class="alert alert-danger bg-black text-danger border-danger rounded-0 d-none py-2">
                        [ОШИБКА ДЕЛИМОСТИ] Неверный расчет предикатов делимости! Генерация нового ключа...
                    </div>
                </div>

                <!-- ================= ФАЗА 4: ПОИСК ЭКСТРЕМАЛЬНОГО ЧИСЛА (УСЛОВИЕ ИСТИННО) ================= -->
                <div id="phase4" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 4: Аналитический синтез (Поиск экстремального числа X — задача ОГЭ)</h5>
                    <p class="text-light">
                        Определите граничное целое число <strong class="text-warning">x</strong>, удовлетворяющее составному условию истинности.
                    </p>
                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">УСЛОВИЕ ИСТИННОСТИ:</div>
                        <div class="fs-4 text-light fw-bold mb-2" id="p4-statement-display"></div>
                        <div class="text-warning small fw-bold" id="p4-instruction-display"></div>
                    </div>
                    <p class="text-secondary small">
                        Вычислите на черновике и введите точное целое число <strong class="text-warning">x</strong>:
                    </p>
                    <div class="input-group mb-3 w-50">
                        <input type="number" id="p4-input" class="form-control bg-black text-warning border-warning rounded-0" placeholder="Введите число x" autocomplete="off">
                        <button id="p4-btn" class="btn btn-outline-warning rounded-0 px-4">ПРОВЕРИТЬ</button>
                    </div>
                    <div id="p4-feedback" class="alert alert-danger bg-black text-danger border-danger rounded-0 d-none py-2">
                        [ГРАНИЧНЫЙ СБОЙ] Введено неверное число! Вычисление новых границ интервала...
                    </div>
                </div>

                <!-- ================= ФАЗА 5: ПОИСК ЭКСТРЕМАЛЬНОГО ЧИСЛА (УСЛОВИЕ ЛОЖНО) ================= -->
                <div id="phase5" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 5: Аналитический синтез при условии ЛОЖНОСТИ (Повышенная сложность)</h5>
                    <p class="text-light">
                        В протоколах безопасности часто требуется найти границу отсечения, при которой правило бракуется.
                    </p>
                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">УСЛОВИЕ ДЛЯ ПРОВЕРКИ:</div>
                        <div class="fs-4 text-light fw-bold mb-2" id="p5-statement-display"></div>
                        <div class="badge bg-danger text-light rounded-0 fs-6 p-2 mb-2" id="p5-instruction-display"></div>
                        <div class="text-secondary small">
                            * Внимание: связка (A ∨ B) ЛОЖНА только тогда, когда ЛОЖНЫ обе части одновременно!
                        </div>
                    </div>
                    <p class="text-secondary small">
                        Рассчитайте граничное значение и введите целое число <strong class="text-warning">x</strong>:
                    </p>
                    <div class="input-group mb-3 w-50">
                        <input type="number" id="p5-input" class="form-control bg-black text-warning border-warning rounded-0" placeholder="Введите число x" autocomplete="off">
                        <button id="p5-btn" class="btn btn-outline-warning rounded-0 px-4">ПРОВЕРИТЬ</button>
                    </div>
                    <div id="p5-feedback" class="alert alert-danger bg-black text-danger border-danger rounded-0 d-none py-2">
                        [ОШИБКА АНАЛИЗА] Неверная граница ложности! Генерация новой комплексной задачи...
                    </div>
                </div>

                <!-- ================= ЭКРАН УСПЕХА ================= -->
                <div id="success-screen" class="d-none text-center py-5 border border-warning bg-black mt-3">
                    <div class="text-warning fs-1 mb-3">✓</div>
                    <h3 class="text-warning mb-2">АНАЛИТИЧЕСКИЙ ВЕРИФИКАТОР ЗАВЕРШЕН</h3>
                    <p class="text-light mb-4">
                        Все 5 аналитических фаз успешно рассчитаны и верифицированы.<br>
                        Навыки работы с логическими операциями «НЕ», «И» и «ИЛИ» закреплены на уровне ОГЭ.
                    </p>
                    <div class="d-inline-block p-3 border border-warning bg-dark text-start font-monospace small mb-4">
                        <div>СТАТУС: <span class="text-warning">УРОВЕНЬ 2 ПРОЙДЕН</span></div>
                        <div>ЗАТРАЧЕНО ВРЕМЕНИ: <span id="final-time" class="text-warning"></span> СЕК</div>
                        <div>ОШИБОК РАСЧЕТА: <span id="final-attempts" class="text-warning"></span></div>
                    </div>
                    <br>
                    <div class="badge border border-warning text-warning bg-dark rounded-0 px-4 py-2 fs-6">
                        ПРОГРЕСС СОХРАНЕН // УРОВЕНЬ 2 ВЫПОЛНЕН
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script is:inline>
        (function() {
            const courseSlug = '8-класс';
            const lessonId = '8';
            const missionName = 'Урок 8 :: Логические операции «и», «или», «не» (Уровень 2)';
            
            const startTime = Date.now();
            let attempts = 0;
            let currentPhase = 1;

            // Телеметрия
            function sendTelemetry(actionType, isSuccess = false) {
                const timeSpent = Math.max(1, Math.floor((Date.now() - startTime) / 1000));
                const payload = {
                    type: 'TELEMETRY_EVENT',
                    course_slug: courseSlug,
                    lesson_id: lessonId,
                    level_number: 2,
                    mission_name: missionName,
                    action_type: actionType,
                    status: actionType === 'level_complete' ? 'completed' : 'in_progress',
                    start_time: new Date(startTime).toISOString(),
                    time_spent_sec: timeSpent,
                    attempts_count: attempts,
                    success: isSuccess
                };
                window.parent.postMessage(payload, '*');

                if (actionType === 'level_complete') {
                    try {
                        localStorage.setItem(`progress_${courseSlug}_${lessonId}_level2`, 'completed');
                        window.parent.postMessage({ type: 'PROGRESS_UPDATE', level: 2, status: 'completed' }, '*');
                    } catch (e) {
                        console.error('Storage error:', e);
                    }
                }
            }

            sendTelemetry('in_progress', false);

            function showPhase(phaseNum) {
                currentPhase = phaseNum;
                document.querySelectorAll('.phase-container').forEach(el => el.classList.add('d-none'));
                const active = document.getElementById(`phase${phaseNum}`);
                if (active) active.classList.remove('d-none');

                document.getElementById('level-badge').textContent = `Шаг ${phaseNum} из 5`;
                const titles = [
                    'Вычисление булевых формул по приоритетам',
                    'Анализ числовых интервалов и раскрытие отрицаний',
                    'Составные предикаты делимости и свойств чисел',
                    'Поиск экстремального числа X (Условие истинно)',
                    'Поиск экстремального числа X (Условие ложно)'
                ];
                document.getElementById('level-title').textContent = titles[phaseNum - 1];
            }

            function triggerError(feedbackId, retryCallback) {
                attempts++;
                document.getElementById('attempts-display').textContent = attempts;
                sendTelemetry('hardcore_reset', false);

                const fb = document.getElementById(feedbackId);
                if (fb) fb.classList.remove('d-none');

                setTimeout(() => {
                    if (fb) fb.classList.add('d-none');
                    if (retryCallback) retryCallback();
                }, 1200);
            }

            /* =========================================================================
               ФАЗА 1: ВЫЧИСЛЕНИЕ БУЛЕВЫХ ФОРМУЛ С ПРИОРИТЕТАМИ
            ========================================================================= */
            let p1Expected = -1;

            function initPhase1() {
                const a = Math.random() < 0.5 ? 0 : 1;
                const b = Math.random() < 0.5 ? 0 : 1;
                const c = Math.random() < 0.5 ? 0 : 1;

                document.getElementById('p1-vars-display').textContent = `A = ${a},  B = ${b},  C = ${c}`;

                const formulas = [
                    {
                        text: 'F = (¬A ∧ B) ∨ (A ∧ ¬C)',
                        eval: () => ((!a && b) || (a && !c)) ? 1 : 0
                    },
                    {
                        text: 'F = ¬(A ∨ ¬B) ∧ (B ∨ C)',
                        eval: () => (! (a || !b) && (b || c)) ? 1 : 0
                    },
                    {
                        text: 'F = (A ∧ ¬B) ∨ ¬(¬A ∧ C)',
                        eval: () => ((a && !b) || !(!a && c)) ? 1 : 0
                    },
                    {
                        text: 'F = ¬A ∧ ¬B ∨ (A ∧ C)',
                        eval: () => ((!a && !b) || (a && c)) ? 1 : 0
                    },
                    {
                        text: 'F = ¬(A ∧ B) ∧ (¬B ∨ ¬C)',
                        eval: () => (!(a && b) && (!b || !c)) ? 1 : 0
                    }
                ];

                const chosen = formulas[Math.floor(Math.random() * formulas.length)];
                document.getElementById('p1-expr-display').textContent = chosen.text;
                p1Expected = chosen.eval();

                const input = document.getElementById('p1-input');
                input.value = '';
                input.focus();
            }

            document.getElementById('p1-btn').addEventListener('click', () => {
                const val = document.getElementById('p1-input').value.trim();
                if (val !== '0' && val !== '1') {
                    triggerError('p1-feedback', initPhase1);
                    return;
                }
                if (parseInt(val, 10) === p1Expected) {
                    showPhase(2);
                    initPhase2();
                } else {
                    triggerError('p1-feedback', initPhase1);
                }
            });


            /* =========================================================================
               ФАЗА 2: ЧИСЛОВЫЕ ИНТЕРВАЛЫ И НЕРАВЕНСТВА
            ========================================================================= */
            let p2Expected = -1;

            function initPhase2() {
                const a = Math.floor(Math.random() * 15) + 5;   // 5 .. 19
                const b = a + Math.floor(Math.random() * 15) + 6; // a + 6 .. a + 20

                // Выбираем x: либо внутри, либо слева, либо справа
                const mode = Math.floor(Math.random() * 3);
                let x = 0;
                if (mode === 0) x = a - Math.floor(Math.random() * 4); // около a
                else if (mode === 1) x = Math.floor((a + b) / 2);      // внутри
                else x = b + Math.floor(Math.random() * 4);            // около b

                document.getElementById('p2-x-display').textContent = `x = ${x}`;

                const variants = [
                    {
                        statement: `F = ¬(x < ${a}) ∧ (x ≤ ${b})`,
                        eval: () => (!(x < a) && (x <= b)) ? 1 : 0
                    },
                    {
                        statement: `F = (x > ${a}) ∧ ¬(x > ${b})`,
                        eval: () => ((x > a) && !(x > b)) ? 1 : 0
                    },
                    {
                        statement: `F = ¬(x ≥ ${a}) ∨ (x > ${b})`,
                        eval: () => (!(x >= a) || (x > b)) ? 1 : 0
                    },
                    {
                        statement: `F = (x < ${a}) ∨ ¬(x ≤ ${b})`,
                        eval: () => ((x < a) || !(x <= b)) ? 1 : 0
                    }
                ];

                const chosen = variants[Math.floor(Math.random() * variants.length)];
                document.getElementById('p2-statement-display').textContent = chosen.statement;
                p2Expected = chosen.eval();

                const input = document.getElementById('p2-input');
                input.value = '';
                input.focus();
            }

            document.getElementById('p2-btn').addEventListener('click', () => {
                const val = document.getElementById('p2-input').value.trim();
                if (val !== '0' && val !== '1') {
                    triggerError('p2-feedback', initPhase2);
                    return;
                }
                if (parseInt(val, 10) === p2Expected) {
                    showPhase(3);
                    initPhase3();
                } else {
                    triggerError('p2-feedback', initPhase2);
                }
            });


            /* =========================================================================
               ФАЗА 3: ПРЕДИКАТЫ ДЕЛИМОСТИ И ЧЕТНОСТИ
            ========================================================================= */
            let p3Expected = -1;

            function initPhase3() {
                const x = Math.floor(Math.random() * 60) + 10; // 10 .. 69
                document.getElementById('p3-x-display').textContent = `x = ${x}`;

                const divisors = [3, 4, 5, 6, 7];
                const d1 = divisors[Math.floor(Math.random() * divisors.length)];
                let d2 = divisors[Math.floor(Math.random() * divisors.length)];
                while (d2 === d1) d2 = divisors[Math.floor(Math.random() * divisors.length)];

                const variants = [
                    {
                        statement: `(x делится на ${d1}) ∧ ¬(x делится на ${d2})`,
                        eval: () => (x % d1 === 0 && !(x % d2 === 0)) ? 1 : 0
                    },
                    {
                        statement: `¬(x четное) ∧ (x делится на ${d1})`,
                        eval: () => (!(x % 2 === 0) && (x % d1 === 0)) ? 1 : 0
                    },
                    {
                        statement: `(x нечетное) ∨ ¬(x делится на ${d1})`,
                        eval: () => (x % 2 !== 0 || !(x % d1 === 0)) ? 1 : 0
                    },
                    {
                        statement: `¬(x делится на ${d1}) ∧ ¬(x делится на ${d2})`,
                        eval: () => (!(x % d1 === 0) && !(x % d2 === 0)) ? 1 : 0
                    }
                ];

                const chosen = variants[Math.floor(Math.random() * variants.length)];
                document.getElementById('p3-statement-display').textContent = chosen.statement;
                p3Expected = chosen.eval();

                const input = document.getElementById('p3-input');
                input.value = '';
                input.focus();
            }

            document.getElementById('p3-btn').addEventListener('click', () => {
                const val = document.getElementById('p3-input').value.trim();
                if (val !== '0' && val !== '1') {
                    triggerError('p3-feedback', initPhase3);
                    return;
                }
                if (parseInt(val, 10) === p3Expected) {
                    showPhase(4);
                    initPhase4();
                } else {
                    triggerError('p3-feedback', initPhase3);
                }
            });


            /* =========================================================================
               ФАЗА 4: ПОИСК ЭКСТРЕМАЛЬНОГО ЧИСЛА (УСЛОВИЕ ИСТИННО — ОГЭ)
            ========================================================================= */
            let p4Expected = null;

            function initPhase4() {
                const a = Math.floor(Math.random() * 20) + 10; // 10 .. 29
                const b = a + Math.floor(Math.random() * 15) + 6; // a+6 .. a+20

                const scenarios = [
                    {
                        statement: `(x < ${b}) ∧ ¬(x ≤ ${a})`,
                        // ¬(x <= a) -> x > a. Значит a < x < b.
                        // Наибольшее целое число x = b - 1.
                        instruction: 'Найдите НАИБОЛЬШЕЕ целое число x, для которого высказывание ИСТИННО:',
                        ans: b - 1
                    },
                    {
                        statement: `¬(x < ${a}) ∧ (x ≤ ${b})`,
                        // ¬(x < a) -> x >= a. Значит a <= x <= b.
                        // Наименьшее целое число x = a.
                        instruction: 'Найдите НАИМЕНЬШЕЕ целое число x, для которого высказывание ИСТИННО:',
                        ans: a
                    },
                    {
                        statement: `(x ≤ ${b}) ∧ ¬(x < ${a}) ∧ (x четное)`,
                        // a <= x <= b, четное. Наибольшее четное <= b.
                        instruction: 'Найдите НАИБОЛЬШЕЕ ЧЕТНОЕ целое число x, для которого высказывание ИСТИННО:',
                        ans: b % 2 === 0 ? b : b - 1
                    },
                    {
                        statement: `¬(x ≤ ${a}) ∧ (x < ${b}) ∧ (x нечетное)`,
                        // a < x < b, нечетное. Наименьшее нечетное > a.
                        instruction: 'Найдите НАИМЕНЬШЕЕ НЕЧЕТНОЕ целое число x, для которого высказывание ИСТИННО:',
                        ans: (a + 1) % 2 !== 0 ? (a + 1) : (a + 2)
                    }
                ];

                const chosen = scenarios[Math.floor(Math.random() * scenarios.length)];
                document.getElementById('p4-statement-display').textContent = chosen.statement;
                document.getElementById('p4-instruction-display').textContent = chosen.instruction;
                p4Expected = chosen.ans;

                const input = document.getElementById('p4-input');
                input.value = '';
                input.focus();
            }

            document.getElementById('p4-btn').addEventListener('click', () => {
                const val = document.getElementById('p4-input').value.trim();
                if (!val) return;

                if (parseInt(val, 10) === p4Expected) {
                    showPhase(5);
                    initPhase5();
                } else {
                    triggerError('p4-feedback', initPhase4);
                }
            });


            /* =========================================================================
               ФАЗА 5: ПОИСК ЭКСТРЕМАЛЬНОГО ЧИСЛА (УСЛОВИЕ ЛОЖНОСТИ)
            ========================================================================= */
            let p5Expected = null;

            function initPhase5() {
                const a = Math.floor(Math.random() * 15) + 8; // 8 .. 22
                const b = a + Math.floor(Math.random() * 15) + 6; // a+6 .. a+20

                const scenarios = [
                    {
                        statement: `(x > ${b}) ∨ (x < ${a})`,
                        // Высказывание ЛОЖНО, когда обе части ложны:
                        // x <= b И x >= a  ==>  a <= x <= b.
                        // Наибольшее целое число x = b.
                        instruction: 'Найдите НАИБОЛЬШЕЕ целое число x, для которого высказывание ЛОЖНО:',
                        ans: b
                    },
                    {
                        statement: `(x > ${b}) ∨ (x < ${a})`,
                        // Высказывание ЛОЖНО: a <= x <= b.
                        // Наименьшее целое число x = a.
                        instruction: 'Найдите НАИМЕНЬШЕЕ целое число x, для которого высказывание ЛОЖНО:',
                        ans: a
                    },
                    {
                        statement: `(x ≥ ${b}) ∨ ¬(x ≥ ${a})`,
                        // ¬(x >= a) -> x < a.
                        // Значит условие: (x >= b) ∨ (x < a).
                        // ЛОЖНО, когда: x < b И x >= a  ==>  a <= x < b.
                        // Наибольшее целое число x = b - 1.
                        instruction: 'Найдите НАИБОЛЬШЕЕ целое число x, для которого высказывание ЛОЖНО:',
                        ans: b - 1
                    },
                    {
                        statement: `¬(x ≤ ${b}) ∨ (x ≤ ${a})`,
                        // ¬(x <= b) -> x > b.
                        // Условие: (x > b) ∨ (x <= a).
                        // ЛОЖНО, когда: x <= b И x > a  ==>  a < x <= b.
                        // Наименьшее целое число x = a + 1.
                        instruction: 'Найдите НАИМЕНЬШЕЕ целое число x, для которого высказывание ЛОЖНО:',
                        ans: a + 1
                    }
                ];

                const chosen = scenarios[Math.floor(Math.random() * scenarios.length)];
                document.getElementById('p5-statement-display').textContent = chosen.statement;
                document.getElementById('p5-instruction-display').textContent = chosen.instruction;
                p5Expected = chosen.ans;

                const input = document.getElementById('p5-input');
                input.value = '';
                input.focus();
            }

            document.getElementById('p5-btn').addEventListener('click', () => {
                const val = document.getElementById('p5-input').value.trim();
                if (!val) return;

                if (parseInt(val, 10) === p5Expected) {
                    finishMission();
                } else {
                    triggerError('p5-feedback', initPhase5);
                }
            });

            // Завершение миссии
            function finishMission() {
                const timeSpent = Math.max(1, Math.floor((Date.now() - startTime) / 1000));
                sendTelemetry('level_complete', true);

                document.querySelectorAll('.phase-container').forEach(el => el.classList.add('d-none'));
                document.getElementById('level-badge').textContent = 'УСПЕХ';
                document.getElementById('level-title').textContent = 'Все 5 фаз успешно пройдены';

                document.getElementById('final-time').textContent = timeSpent;
                document.getElementById('final-attempts').textContent = attempts;
                document.getElementById('success-screen').classList.remove('d-none');
            }

            // Клавиша Enter в полях ввода
            ['p1-input', 'p2-input', 'p3-input', 'p4-input', 'p5-input'].forEach((id, idx) => {
                const el = document.getElementById(id);
                if (el) {
                    el.addEventListener('keydown', (e) => {
                        if (e.key === 'Enter') {
                            document.getElementById(`p${idx + 1}-btn`).click();
                        }
                    });
                }
            });

            // Тестовый хук для автоматизации и e2e тестов
            window.__testState = {
                getP1Expected: () => p1Expected,
                getP2Expected: () => p2Expected,
                getP3Expected: () => p3Expected,
                getP4Expected: () => p4Expected,
                getP5Expected: () => p5Expected
            };

            // Старт
            showPhase(1);
            initPhase1();
        })();
    </script>
</TaskLayout>
