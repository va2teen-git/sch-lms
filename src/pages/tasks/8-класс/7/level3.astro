---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={3}>
    <div id="app" class="container-fluid px-2 px-md-3 my-3 font-monospace" v-cloak>
        
        <!-- Стартовый экран (Брифинг) -->
        <div v-if="gameState === 'intro'" class="card bg-black border-danger rounded-0 p-4 p-md-5 text-center">
            <div class="display-4 text-danger mb-3">🛡️ WAF: ПАКЕТНЫЙ МАРШРУТИЗАТОР 🛡️</div>
            <h2 class="text-light mb-3 fs-3">REAL-TIME LOGIC PACKET ROUTER // ARCHETYPE 2</h2>
            <p class="fs-6 text-secondary mx-auto mb-4" style="max-width: 720px;">
                На коммуникационный шлюз WAF непрерывно поступают неструктурированные пакеты данных.
                Используя интерактивные узлы коммутации (роутеры), направьте входящий импульс в нужный терминал до истечения таймера такта.
            </p>

            <div class="card bg-dark border-secondary rounded-0 p-3 mx-auto mb-4 text-start small" style="max-width: 680px;">
                <div class="text-danger fw-bold mb-2">[РЕГЛАМЕНТ АРКАДНОГО УРОВНЯ (АРХЕТИП 2)]:</div>
                <div class="text-light mb-1">• <span class="text-warning">Коммутация потока:</span> Узел 1 переключает магистраль (Высказывание ↔ Синтаксический карантин). Узел 2 переключает полярность (Истина [1] ↔ Ложь [0]).</div>
                <div class="text-light mb-1">• <span class="text-warning">Динамический тайминг:</span> Время такта сжимается от 7.0 с до 3.8 с к 8-й волне.</div>
                <div class="text-light mb-1">• <span class="text-warning">Механика форсажа:</span> После настройки маршрута нажмите <kbd class="bg-black text-warning border border-secondary px-2">ПРОБЕЛ</kbd> или кнопку «ФОРСАЖ», чтобы мгновенно отправить импульс.</div>
                <div class="text-light">• <span class="text-danger">Хардкор-вайп:</span> Доставка в неверный терминал или срыв такта вызывают сброс на Волну 1!</div>
            </div>

            <div>
                <button id="start-btn" @click="startGame" class="btn btn-danger btn-lg rounded-0 fw-bold px-5 py-3 shadow">
                    АКТИВИРОВАТЬ МАРШРУТИЗАТОР WAF
                </button>
            </div>
        </div>

        <!-- Игровой процесс -->
        <div v-else-if="gameState === 'playing'" class="card bg-black border-danger rounded-0 p-3 p-md-4">
            
            <!-- Хедер со статусом и таймером -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <span class="text-secondary small d-block">ШЛЮЗ WAF // АРХЕТИП 2:</span>
                    <span id="phase-counter" class="text-danger fw-bold fs-4">ВОЛНА <span v-text="currentWave"></span> ИЗ 8</span>
                </div>
                <div class="text-end">
                    <span class="text-secondary small d-block">ТАЙМ-ПРЕССИНГ (ТАКТ):</span>
                    <span id="timer-display" class="fw-bold fs-4" :class="phaseTimeLeft <= 2.0 ? 'text-danger' : 'text-warning'">
                        <span v-text="formattedTime"></span> сек
                    </span>
                </div>
            </div>

            <!-- Прогресс-бар таймера -->
            <div class="progress mb-3 bg-dark border border-secondary rounded-0" style="height: 10px;">
                <div class="progress-bar"
                     :class="phaseTimeLeft <= 2.0 ? 'bg-danger' : 'bg-warning'"
                     role="progressbar"
                     :style="'width: ' + ((phaseTimeLeft / maxPhaseTime) * 100) + '%'">
                </div>
            </div>

            <!-- Информационная панель полезной нагрузки (Payload) -->
            <div class="card bg-dark border-secondary rounded-0 p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-2 mb-2">
                    <span class="badge bg-danger text-black rounded-0 fw-bold px-2 py-1">
                        ВХОДЯЩИЙ ПАКЕТ #<span v-text="currentWave"></span>
                    </span>
                    <span class="text-secondary small">
                        КАТЕГОРИЯ: <span class="text-info fw-bold" v-text="currentPacket.category"></span>
                    </span>
                </div>

                <div class="text-secondary small mb-1">ПЕРЕХВАЧЕННОЕ ВЫСКАЗЫВАНИЕ:</div>
                <div class="card bg-black border-secondary rounded-0 p-3 mb-2 text-center">
                    <div class="fs-4 text-light fw-bold my-1" v-text="currentPacket.payload"></div>
                </div>
                <div class="text-secondary small">
                    ДИАГНОСТИКА: <span class="text-warning" v-text="currentPacket.hint"></span>
                </div>
            </div>

            <!-- Пространственная коммутационная матрица (Маршрутизатор потоков) -->
            <div class="card bg-dark border-danger rounded-0 p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                    <span class="text-warning fw-bold small">[КОММУТАЦИОННАЯ МАТРИЦА МАРШРУТИЗАЦИИ]</span>
                    <span class="text-secondary small">Кликните по узлу или используйте клавиши [1], [2], [ПРОБЕЛ]</span>
                </div>

                <div class="row g-3 align-items-center">
                    
                    <!-- Узел 1: Магистральный селектор -->
                    <div class="col-12 col-md-5">
                        <div class="card bg-black border border-secondary rounded-0 p-2 text-center">
                            <span class="text-secondary small d-block mb-1">УЗЕЛ 1: СЕЛЕКТОР МАГИСТРАЛИ [1]</span>
                            <button id="router-node-1" 
                                    @click="toggleNode1"
                                    type="button"
                                    class="btn w-100 rounded-0 py-2 fw-bold text-uppercase d-flex align-items-center justify-content-between px-3"
                                    :class="node1Route === 'statement' ? 'btn-outline-primary border-primary text-primary' : 'btn-outline-warning border-warning text-warning'">
                                <span v-text="node1Route === 'statement' ? '⮑ ТРАНК А: ВЫСКАЗЫВАНИЕ' : '⮐ ТРАНК Б: КАРАНТИН (ШУМ)'"></span>
                                <span class="badge bg-dark border border-secondary text-light">ПЕРЕКЛЮЧИТЬ</span>
                            </button>
                        </div>
                    </div>

                    <!-- Стрелочный разделитель -->
                    <div class="col-12 col-md-2 text-center d-none d-md-block text-secondary fs-4">
                        ➔ ➔
                    </div>

                    <!-- Узел 2: Поляризатор истинности (активен при транке Высказывание) -->
                    <div class="col-12 col-md-5">
                        <div class="card bg-black border border-secondary rounded-0 p-2 text-center"
                             :class="node1Route !== 'statement' ? 'opacity-50' : ''">
                            <span class="text-secondary small d-block mb-1">УЗЕЛ 2: ПОЛЯРИЗАТОР ИСТИННОСТИ [2]</span>
                            <button id="router-node-2" 
                                    @click="toggleNode2"
                                    :disabled="node1Route !== 'statement'"
                                    type="button"
                                    class="btn w-100 rounded-0 py-2 fw-bold text-uppercase d-flex align-items-center justify-content-between px-3"
                                    :class="node2Polarity === 'true' ? 'btn-outline-success border-success text-success' : 'btn-outline-danger border-danger text-danger'">
                                <span v-text="node2Polarity === 'true' ? '⚡ ПОЛЮС: ИСТИНА [1]' : '⛔ ПОЛЮС: ЛОЖЬ [0]'"></span>
                                <span class="badge bg-dark border border-secondary text-light">ПЕРЕКЛЮЧИТЬ</span>
                            </button>
                        </div>
                    </div>

                </div>

                <!-- Визуализация активного маршрута и терминалов назначения -->
                <div class="mt-4 pt-3 border-top border-secondary">
                    <div class="text-secondary small mb-2">АКТИВНЫЙ ТЕРМИНАЛ НАЗНАЧЕНИЯ:</div>
                    <div class="row g-2">
                        <!-- Терминал 1: ИСТИНА -->
                        <div class="col-12 col-md-4">
                            <div id="terminal-true" 
                                 class="p-2 border text-center rounded-0 transition-all"
                                 :class="activeTargetTerminal === 'true' ? 'bg-success text-black border-success fw-bold shadow' : 'bg-black text-secondary border-secondary'">
                                <div class="small">ТЕРМИНАЛ #1</div>
                                <div class="fs-6">ИСТИНА (1)</div>
                            </div>
                        </div>

                        <!-- Терминал 2: ЛОЖЬ -->
                        <div class="col-12 col-md-4">
                            <div id="terminal-false" 
                                 class="p-2 border text-center rounded-0 transition-all"
                                 :class="activeTargetTerminal === 'false' ? 'bg-danger text-black border-danger fw-bold shadow' : 'bg-black text-secondary border-secondary'">
                                <div class="small">ТЕРМИНАЛ #2</div>
                                <div class="fs-6">ЛОЖЬ (0)</div>
                            </div>
                        </div>

                        <!-- Терминал 3: НЕ ВЫСКАЗЫВАНИЕ -->
                        <div class="col-12 col-md-4">
                            <div id="terminal-not-statement" 
                                 class="p-2 border text-center rounded-0 transition-all"
                                 :class="activeTargetTerminal === 'not_statement' ? 'bg-warning text-black border-warning fw-bold shadow' : 'bg-black text-secondary border-secondary'">
                                <div class="small">ТЕРМИНАЛ #3</div>
                                <div class="fs-6">НЕ ВЫСКАЗЫВАНИЕ (Q)</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Кнопка Форсажа (Запуск пакета) -->
                <div class="mt-4 text-center">
                    <button id="launch-packet-btn" 
                            @click="launchPacket"
                            class="btn btn-warning text-black btn-lg rounded-0 fw-bold px-5 py-2 shadow w-100 w-md-auto">
                        ⚡ ФОРСАЖ // ЗАПУСТИТЬ ПАКЕТ [ПРОБЕЛ] ⚡
                    </button>
                </div>
            </div>

            <!-- Индикатор прогресса волн -->
            <div class="d-flex justify-content-between align-items-center text-secondary small">
                <div>МАРШРУТИЗАТОР: <span class="text-success fw-bold">СИНХРОНИЗИРОВАН</span></div>
                <div class="d-flex gap-1">
                    <span v-for="w in 8" :key="w" class="badge rounded-0 px-2 py-1"
                          :class="w < currentWave ? 'bg-success text-black' : (w === currentWave ? 'bg-danger text-light' : 'bg-dark border border-secondary text-secondary')">
                        W<span v-text="w"></span>
                    </span>
                </div>
            </div>
        </div>

        <!-- Экран сбоя (Хардкор-сброс) -->
        <div v-else-if="gameState === 'failed'" class="card bg-black border-danger rounded-0 p-5 text-center">
            <h1 class="text-danger display-2 mb-3">CRITICAL ROUTING COLLISION</h1>
            <h3 class="text-light mb-3">ПАКЕТ ДОСТАВЛЕН В НЕВЕРНЫЙ ТЕРМИНАЛ // КРАХ СЕССИИ</h3>
            <p class="fs-5 text-secondary mx-auto mb-4" style="max-width: 600px;" v-text="failReason"></p>
            <div class="text-warning fs-5">
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                Аварийная реконфигурация WAF... Возврат на Волну 1
            </div>
        </div>

        <!-- Экран победы -->
        <div v-else-if="gameState === 'success'" class="card bg-black border-success rounded-0 p-5 text-center">
            <div class="text-success display-1 mb-3">🛡️ СИСТЕМА ЗАЩИЩЕНА 🛡️</div>
            <h2 class="text-light mb-3">ШЛЮЗ WAF УСПЕШНО ОТРАЗИЛ ВСЕ 8 ВОЛН АТАКИ</h2>
            <p class="fs-5 text-secondary mb-4">
                Все логические пакеты успешно смаршрутизированы. Аномалии изолированы. Сервер стабилен.
            </p>
            <div class="d-inline-block p-4 border border-success bg-dark text-start small mx-auto">
                <div class="mb-1">СТАТУС: <span class="text-success fw-bold">АРКАДНЫЙ БОСС УРОВНЯ 3 ПОВЕРЖЕН</span></div>
                <div class="mb-1">ОТРАЖЕНО ВОЛН: <span class="text-light fw-bold">8 / 8</span></div>
                <div class="mb-1">ЗАТРАЧЕНО ВРЕМЕНИ: <span class="text-warning fw-bold"><span v-text="totalTimeSpent"></span> СЕК</span></div>
                <div>СБРОСОВ ХАРДКОРА: <span class="text-warning fw-bold"><span v-text="attempts"></span></span></div>
            </div>
        </div>

    </div>

    <script src="/static/vue.global.js" is:inline></script>
    <script is:inline>
        (function() {
            const missionName = 'Урок 7 :: Логические высказывания (Уровень 3)';
            const sessionStartTime = Date.now();
            let attempts = 0;

            function sendTelemetry(actionType, success = false) {
                const timeSpent = Math.max(1, Math.floor((Date.now() - sessionStartTime) / 1000));
                window.parent.postMessage({
                    type: 'TELEMETRY_EVENT',
                    mission_name: missionName,
                    action_type: actionType,
                    status: actionType === 'level_complete' ? 'completed' : 'in_progress',
                    start_time: new Date(sessionStartTime).toISOString(),
                    time_spent_sec: timeSpent,
                    attempts_count: attempts,
                    success: success
                }, '*');
            }

            // Старт сессии
            sendTelemetry('in_progress', false);

            const { createApp, ref, computed, onMounted, onUnmounted } = Vue;

            createApp({
                setup() {
                    const gameState = ref('intro'); // 'intro', 'playing', 'failed', 'success'
                    const currentWave = ref(1);
                    const phaseTimeLeft = ref(7.0);
                    const maxPhaseTime = ref(7.0);
                    const failReason = ref('');
                    const totalTimeSpent = ref(0);

                    // Состояние роутеров (Коммутаторы)
                    const node1Route = ref('statement'); // 'statement' или 'quarantine'
                    const node2Polarity = ref('true');   // 'true' или 'false'

                    let timerInterval = null;

                    const formattedTime = computed(() => {
                        return Math.max(0, phaseTimeLeft.value).toFixed(1);
                    });

                    // Активный целевой терминал на основе положения узлов
                    const activeTargetTerminal = computed(() => {
                        if (node1Route.value === 'quarantine') {
                            return 'not_statement';
                        }
                        return node2Polarity.value; // 'true' или 'false'
                    });

                    // Банк пакетов по 8 волнам
                    const WAVE_PACKETS = [
                        // Волна 1: Архитектура ЭВМ и единицы измерения
                        [
                            { payload: '«В одном килобайте ровно 1024 байта»', target: 'true', category: 'ОБЪЕМ ПАМЯТИ', hint: 'Анализ соотношения двоичных приставок' },
                            { payload: '«Монитор является устройством ввода текстовой информации»', target: 'false', category: 'ПЕРИФЕРИЯ', hint: 'Проверка типа функционального устройства' },
                            { payload: '«Сколько бит содержится в половине байта?»', target: 'not_statement', category: 'СЕТЕВОЙ ЗАПРОС', hint: 'Синтаксический разбор вопросительной формы' }
                        ],
                        // Волна 2: Числовые равенства и неравенства
                        [
                            { payload: '«19 ≥ 19»', target: 'true', category: 'НЕСТРОГОЕ НЕРАВЕНСТВО', hint: 'Проверка условия больше или равно' },
                            { payload: '«45 < 20»', target: 'false', category: 'СТРОГОЕ НЕРАВЕНСТВО', hint: 'Сравнение двух натуральных чисел' },
                            { payload: '«x > 100»', target: 'not_statement', category: 'НЕОПРЕДЕЛЕННАЯ ПЕРЕМЕННАЯ', hint: 'Попытка инъекции неинициализированного аргумента' }
                        ],
                        // Волна 3: Позиционные системы счисления
                        [
                            { payload: '«101₂ = 5₁₀»', target: 'true', category: 'ДВОИЧНЫЙ КОД', hint: 'Сверка эквивалентности двоичной и десятичной записи' },
                            { payload: '«1111₂ = 12₁₀»', target: 'false', category: 'ДВОИЧНЫЙ КОД', hint: 'Проверка значения 4-битной тетрады' },
                            { payload: '«Переведите число 25 в шестнадцатеричную систему!»', target: 'not_statement', category: 'КОМАНДНЫЙ ПРИКАЗ', hint: 'Повелительное наклонение в заголовке' }
                        ],
                        // Волна 4: Субъективные оценки и системные факты
                        [
                            { payload: '«Операционная система управляет файловой структурой носителя»', target: 'true', category: 'СИСТЕМНОЕ ПО', hint: 'Базовая функция системного уровня' },
                            { payload: '«Клавиатура преобразует электрический ток в звуковые волны»', target: 'false', category: 'АППАРАТНАЯ СХЕМА', hint: 'Анализ назначения устройства ввода' },
                            { payload: '«Язык программирования Python гораздо приятнее, чем C++»', target: 'not_statement', category: 'СУБЪЕКТИВНАЯ ОЦЕНКА', hint: 'Личное мнение пользователя без измеримого критерия' }
                        ],
                        // Волна 5: Предикаты с неизвестными и парадоксы
                        [
                            { payload: '«2⁴ = 16»', target: 'true', category: 'СТЕПЕНЬ ДВОЙКИ', hint: 'Вычисление значения машинного регистра' },
                            { payload: '«Число 33 делится нацело на 5»', target: 'false', category: 'АРИФМЕТИКА', hint: 'Проверка признака делимости на 5' },
                            { payload: '«То, что утверждает данный сетевой пакет, является ложью»', target: 'not_statement', category: 'ПАРАДОКС ЛЖЕЦА', hint: 'Самоприменимая циклическая аномалия' }
                        ],
                        // Волна 6: Логические связки «И»
                        [
                            { payload: '«(15 > 10) И (8 является чётным числом)»', target: 'true', category: 'КОНЪЮНКЦИЯ', hint: 'Конъюнкция двух истинных условий' },
                            { payload: '«(15 > 10) И (9 является чётным числом)»', target: 'false', category: 'КОНЪЮНКЦИЯ', hint: 'Конъюнкция истинного и ложного условия' },
                            { payload: '«(x > 5) И (x < 15)»', target: 'not_statement', category: 'ПРЕДИКАТ', hint: 'Предикат с неизвестным параметром x' }
                        ],
                        // Волна 7: Логические связки «ИЛИ»
                        [
                            { payload: '«(5 > 10) ИЛИ (16 кратно 4)»', target: 'true', category: 'ДИЗЪЮНКЦИЯ', hint: 'Дизъюнкция с одним истинным высказыванием' },
                            { payload: '«(5 > 10) ИЛИ (15 кратно 4)»', target: 'false', category: 'ДИЗЪЮНКЦИЯ', hint: 'Дизъюнкция двух ложных утверждений' },
                            { payload: '«Не выключайте питание компьютера во время обновления системы!»', target: 'not_statement', category: 'ИНСТРУКЦИЯ', hint: 'Предупреждение службы безопасности' }
                        ],
                        // Волна 8: Финальный рубеж (Комплексный анализ)
                        [
                            { payload: '«Символ "A" в кодировке ASCII имеет код 65, а "B" — код 66»', target: 'true', category: 'ТАБЛИЦА ASCII', hint: 'Сверка последовательности кодовых позиций' },
                            { payload: '«Число 100 в десятичной системе записывается как 100 в двоичной»', target: 'false', category: 'СИСТЕМЫ СЧИСЛЕНИЯ', hint: 'Сравнение числовых эквивалентов' },
                            { payload: '«k кратно 7 без остатка»', target: 'not_statement', category: 'ПРЕДИКАТ', hint: 'Выражение с неопределенной переменной k' }
                        ]
                    ];

                    const currentPacket = ref(WAVE_PACKETS[0][0]);

                    function toggleNode1() {
                        node1Route.value = node1Route.value === 'statement' ? 'quarantine' : 'statement';
                    }

                    function toggleNode2() {
                        node2Polarity.value = node2Polarity.value === 'true' ? 'false' : 'true';
                    }

                    function calculatePhaseTime(wave) {
                        // Динамический тайминг: от 7.0 с на волне 1 до 3.8 с на волне 8
                        return Math.max(3.8, 7.0 - (wave - 1) * 0.45);
                    }

                    function loadWave(wave) {
                        currentWave.value = wave;
                        const wavePool = WAVE_PACKETS[wave - 1];
                        currentPacket.value = wavePool[Math.floor(Math.random() * wavePool.length)];

                        const allocatedTime = calculatePhaseTime(wave);
                        maxPhaseTime.value = allocatedTime;
                        phaseTimeLeft.value = allocatedTime;

                        startTimer();
                    }

                    function startTimer() {
                        clearInterval(timerInterval);
                        const intervalMs = 100;
                        timerInterval = setInterval(() => {
                            phaseTimeLeft.value -= 0.1;
                            if (phaseTimeLeft.value <= 0) {
                                clearInterval(timerInterval);
                                triggerFailure('Истекло допустимое время такта маршрутизации! Буфер переполнен.');
                            }
                        }, intervalMs);
                    }

                    function launchPacket() {
                        clearInterval(timerInterval);
                        const chosen = activeTargetTerminal.value;
                        const expected = currentPacket.value.target;

                        if (chosen === expected) {
                            // Успешно доставлен
                            if (currentWave.value < 8) {
                                loadWave(currentWave.value + 1);
                            } else {
                                // Победа над боссом
                                gameState.value = 'success';
                                totalTimeSpent.value = Math.max(1, Math.floor((Date.now() - sessionStartTime) / 1000));
                                sendTelemetry('level_complete', true);
                            }
                        } else {
                            // Коллизия
                            triggerFailure(`Пакет направлен в терминал [${chosen}], но требовался терминал [${expected}]!`);
                        }
                    }

                    function triggerFailure(reason) {
                        clearInterval(timerInterval);
                        attempts++;
                        failReason.value = reason;
                        gameState.value = 'failed';
                        sendTelemetry('hardcore_reset', false);

                        setTimeout(() => {
                            // Автоматический рестарт на волну 1
                            gameState.value = 'playing';
                            node1Route.value = 'statement';
                            node2Polarity.value = 'true';
                            loadWave(1);
                        }, 1800);
                    }

                    function startGame() {
                        gameState.value = 'playing';
                        node1Route.value = 'statement';
                        node2Polarity.value = 'true';
                        loadWave(1);
                    }

                    // Обработка горячих клавиш: 1 (узел 1), 2 (узел 2), Пробел / Enter (форсаж)
                    function handleKeyDown(e) {
                        if (gameState.value !== 'playing') return;

                        if (e.key === '1') {
                            e.preventDefault();
                            toggleNode1();
                        } else if (e.key === '2') {
                            e.preventDefault();
                            toggleNode2();
                        } else if (e.code === 'Space' || e.key === 'Enter') {
                            e.preventDefault();
                            launchPacket();
                        }
                    }

                    onMounted(() => {
                        window.addEventListener('keydown', handleKeyDown);
                    });

                    onUnmounted(() => {
                        clearInterval(timerInterval);
                        window.removeEventListener('keydown', handleKeyDown);
                    });

                    return {
                        gameState,
                        currentWave,
                        phaseTimeLeft,
                        maxPhaseTime,
                        formattedTime,
                        currentPacket,
                        node1Route,
                        node2Polarity,
                        activeTargetTerminal,
                        failReason,
                        totalTimeSpent,
                        attempts,
                        startGame,
                        toggleNode1,
                        toggleNode2,
                        launchPacket
                    };
                }
            }).mount('#app');
        })();
    </script>
</TaskLayout>
