---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={2}>
    <div class="container my-4 font-monospace">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 text-warning mb-0">Тренажер: Статический верификатор булевых условий (Уровень 2)</h2>
            <span class="badge border border-warning text-warning bg-dark rounded-0 px-3 py-2">Ручной ввод // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-warning rounded-0">
            <div class="card-body p-4">

                <!-- Заголовок и счетчик попыток -->
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="level-badge" class="badge bg-warning text-dark rounded-0 fs-6 me-2">Шаг 1 из 5</span>
                        <span id="level-title" class="text-light fw-bold fs-6">Верификация элементарных условий</span>
                    </div>
                    <div class="text-secondary small">
                        Ошибок: <span id="attempts-display" class="text-warning">0</span>
                    </div>
                </div>

                <!-- Фаза 1 -->
                <div id="phase1" class="phase-container">
                    <h5 class="text-warning mb-2">Шаг 1: Проверка условия авторизации (Сравнение чисел)</h5>
                    <p class="text-light">
                        В файле конфигурации брандмауэра обнаружено правило фильтрации. Система перехватила параметр переменной: 
                        <span class="badge bg-black border border-warning text-warning fs-6" id="p1-param"></span>.
                    </p>
                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">ПРОВЕРЯЕМОЕ ВЫСКАЗЫВАНИЕ:</div>
                        <div class="fs-4 text-light fw-bold" id="p1-statement"></div>
                    </div>
                    <p class="text-secondary small">
                        Определите истинность данного высказывания. Введите <strong class="text-warning">1</strong> (Истина) или <strong class="text-warning">0</strong> (Ложь):
                    </p>
                    <div class="input-group mb-3 w-50">
                        <input type="text" id="p1-input" class="form-control bg-black text-warning border-warning rounded-0" placeholder="1 или 0" autocomplete="off">
                        <button id="p1-btn" class="btn btn-outline-warning rounded-0 px-4">ПРОВЕРИТЬ</button>
                    </div>
                    <div id="p1-feedback" class="alert alert-danger bg-black text-danger border-danger rounded-0 d-none py-2">
                        [ОШИБКА РАСЧЕТА] Неверное значение истинности! Перегенерация условия...
                    </div>
                </div>

                <!-- Фаза 2 -->
                <div id="phase2" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 2: Предикат делимости и кратности</h5>
                    <p class="text-light">
                        Модуль балансировки потоков данных проверяет распределение пакетов по признаку делимости целочисленного идентификатора.
                    </p>
                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">ПРОВЕРЯЕМОЕ УТВЕРЖДЕНИЕ:</div>
                        <div class="fs-4 text-light fw-bold" id="p2-statement"></div>
                    </div>
                    <p class="text-secondary small">
                        Истинно ли данное утверждение? Введите <strong class="text-warning">1</strong> (Истина) или <strong class="text-warning">0</strong> (Ложь):
                    </p>
                    <div class="input-group mb-3 w-50">
                        <input type="text" id="p2-input" class="form-control bg-black text-warning border-warning rounded-0" placeholder="1 или 0" autocomplete="off">
                        <button id="p2-btn" class="btn btn-outline-warning rounded-0 px-4">ПРОВЕРИТЬ</button>
                    </div>
                    <div id="p2-feedback" class="alert alert-danger bg-black text-danger border-danger rounded-0 d-none py-2">
                        [ОШИБКА ДЕЛИМОСТИ] Неверный расчет кратности! Пересчет нового идентификатора...
                    </div>
                </div>

                <!-- Фаза 3 -->
                <div id="phase3" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 3: Верификация числовых кодов в разных системах счисления</h5>
                    <p class="text-light">
                        При чтении шестнадцатеричного дампа и двоичного регистра контроллер сверяет эквивалентность значений.
                    </p>
                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">СВЕРЯЕМОЕ ВЫСКАЗЫВАНИЕ:</div>
                        <div class="fs-4 text-light fw-bold" id="p3-statement"></div>
                    </div>
                    <p class="text-secondary small">
                        Является ли данное равенство/неравенство истинным? Введите <strong class="text-warning">1</strong> (Истина) или <strong class="text-warning">0</strong> (Ложь):
                    </p>
                    <div class="input-group mb-3 w-50">
                        <input type="text" id="p3-input" class="form-control bg-black text-warning border-warning rounded-0" placeholder="1 или 0" autocomplete="off">
                        <button id="p3-btn" class="btn btn-outline-warning rounded-0 px-4">ПРОВЕРИТЬ</button>
                    </div>
                    <div id="p3-feedback" class="alert alert-danger bg-black text-danger border-danger rounded-0 d-none py-2">
                        [СБОЙ КОНВЕРТАЦИИ] Ошибка сопоставления систем счисления! Загрузка нового сектора...
                    </div>
                </div>

                <!-- Фаза 4 -->
                <div id="phase4" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 4: Аудит составного логического правила (Связки «И» / «ИЛИ»)</h5>
                    <p class="text-light">
                        Аудитор проверяет сложное составное условие безопасности с заданными параметрами сетевого соединения:
                        <span class="badge bg-black border border-warning text-warning fs-6" id="p4-params"></span>.
                    </p>
                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">СОСТАВНОЕ ЛОГИЧЕСКОЕ ВЫРАЖЕНИЕ:</div>
                        <div class="fs-4 text-light fw-bold" id="p4-statement"></div>
                    </div>
                    <p class="text-secondary small">
                        Вычислите итоговое логическое значение всего составного выражения. Введите <strong class="text-warning">1</strong> (Истина) или <strong class="text-warning">0</strong> (Ложь):
                    </p>
                    <div class="input-group mb-3 w-50">
                        <input type="text" id="p4-input" class="form-control bg-black text-warning border-warning rounded-0" placeholder="1 или 0" autocomplete="off">
                        <button id="p4-btn" class="btn btn-outline-warning rounded-0 px-4">ПРОВЕРИТЬ</button>
                    </div>
                    <div id="p4-feedback" class="alert alert-danger bg-black text-danger border-danger rounded-0 d-none py-2">
                        [СБОЙ СОСТАВНОГО ПРАВИЛА] Неверная оценка связки! Реконфигурация параметров...
                    </div>
                </div>

                <!-- Фаза 5 -->
                <div id="phase5" class="phase-container d-none">
                    <h5 class="text-warning mb-2">Шаг 5: Аналитический синтез (Поиск граничного значения переменной)</h5>
                    <p class="text-light">
                        Для прохождения верификатора необходимо вычислить точное граничное целое число <strong class="text-warning">x</strong>, при котором составное высказывание становится истинным.
                    </p>
                    <div class="card bg-black border-warning rounded-0 p-3 mb-3">
                        <div class="text-secondary small mb-1">УСЛОВИЕ ИСТИННОСТИ:</div>
                        <div class="fs-4 text-light fw-bold mb-2" id="p5-statement"></div>
                        <div class="text-warning small" id="p5-target-instruction"></div>
                    </div>
                    <p class="text-secondary small">
                        Рассчитайте на черновике и введите точное число <strong class="text-warning">x</strong> (целое число):
                    </p>
                    <div class="input-group mb-3 w-50">
                        <input type="number" id="p5-input" class="form-control bg-black text-warning border-warning rounded-0" placeholder="Введите число x" autocomplete="off">
                        <button id="p5-btn" class="btn btn-outline-warning rounded-0 px-4">ПРОВЕРИТЬ</button>
                    </div>
                    <div id="p5-feedback" class="alert alert-danger bg-black text-danger border-danger rounded-0 d-none py-2">
                        [ГРАНИЧНЫЙ СБОЙ] Введено неверное число! Вычисление новых границ диапазона...
                    </div>
                </div>

                <!-- Экран завершения уровня -->
                <div id="success-screen" class="d-none text-center py-5 border border-warning bg-black mt-3">
                    <div class="text-warning fs-1 mb-3">✓</div>
                    <h3 class="text-warning mb-2">СТАТИЧЕСКАЯ ВЕРИФИКАЦИЯ ЗАВЕРШЕНА</h3>
                    <p class="text-light mb-4">
                        Все 5 аналитических фаз успешно рассчитаны и подтверждены. 
                        Булевы статусы условий согласованы.
                    </p>
                    <div class="d-inline-block p-3 border border-warning bg-dark text-start font-monospace small">
                        <div>СТАТУС: <span class="text-warning">УРОВЕНЬ 2 ПРОЙДЕН</span></div>
                        <div>ЗАТРАЧЕНО ВРЕМЕНИ: <span id="final-time" class="text-warning"></span> СЕК</div>
                        <div>ОШИБОК РАСЧЕТА: <span id="final-attempts" class="text-warning"></span></div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script is:inline>
        (function() {
            const missionName = 'Урок 7 :: Логические высказывания (Уровень 2)';
            const startTime = Date.now();
            let attempts = 0;
            let currentPhase = 1;

            // Телеметрия
            function sendTelemetry(actionType, isSuccess = false) {
                const timeSpent = Math.max(1, Math.floor((Date.now() - startTime) / 1000));
                window.parent.postMessage({
                    type: 'TELEMETRY_EVENT',
                    mission_name: missionName,
                    action_type: actionType,
                    status: actionType === 'level_complete' ? 'completed' : 'in_progress',
                    start_time: new Date(startTime).toISOString(),
                    time_spent_sec: timeSpent,
                    attempts_count: attempts,
                    success: isSuccess
                }, '*');
            }

            // Старт миссии
            sendTelemetry('in_progress', false);

            function showPhase(phaseNum) {
                currentPhase = phaseNum;
                document.querySelectorAll('.phase-container').forEach(el => el.classList.add('d-none'));
                const active = document.getElementById(`phase${phaseNum}`);
                if (active) active.classList.remove('d-none');

                document.getElementById('level-badge').textContent = `Шаг ${phaseNum} из 5`;
                const titles = [
                    'Верификация элементарных условий',
                    'Предикаты делимости и кратности',
                    'Числовые коды в разных системах счисления',
                    'Аудит составных логических связок',
                    'Аналитический синтез граничных значений'
                ];
                document.getElementById('level-title').textContent = titles[phaseNum - 1];
            }

            function triggerError(feedbackId, retryCallback) {
                attempts++;
                document.getElementById('attempts-display').textContent = attempts;
                sendTelemetry('hardcore_reset', false);

                const fb = document.getElementById(feedbackId);
                fb.classList.remove('d-none');

                setTimeout(() => {
                    fb.classList.add('d-none');
                    retryCallback();
                }, 1300);
            }

            // ==========================================
            // ФАЗА 1: Сравнение чисел (x op B)
            // ==========================================
            let p1Expected = '0';
            function initPhase1() {
                const val = Math.floor(Math.random() * 80) + 10;
                const threshold = Math.floor(Math.random() * 80) + 10;
                const ops = [
                    { sym: '>', fn: (a, b) => a > b },
                    { sym: '<', fn: (a, b) => a < b },
                    { sym: '≥', fn: (a, b) => a >= b },
                    { sym: '≤', fn: (a, b) => a <= b },
                    { sym: '==', fn: (a, b) => a === b },
                    { sym: '≠', fn: (a, b) => a !== b }
                ];
                const op = ops[Math.floor(Math.random() * ops.length)];
                const result = op.fn(val, threshold);
                p1Expected = result ? '1' : '0';

                document.getElementById('p1-param').textContent = `x = ${val}`;
                document.getElementById('p1-statement').textContent = `x ${op.sym} ${threshold}`;
                document.getElementById('p1-input').value = '';
                document.getElementById('p1-input').focus();
            }

            document.getElementById('p1-btn').addEventListener('click', () => {
                const ans = document.getElementById('p1-input').value.trim();
                if (ans === p1Expected) {
                    showPhase(2);
                    initPhase2();
                } else {
                    triggerError('p1-feedback', initPhase1);
                }
            });
            document.getElementById('p1-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') document.getElementById('p1-btn').click();
            });

            // ==========================================
            // ФАЗА 2: Делимость и кратность
            // ==========================================
            let p2Expected = '0';
            function initPhase2() {
                const divisors = [2, 3, 5, 10];
                const k = divisors[Math.floor(Math.random() * divisors.length)];
                
                // 50% вероятность истинности
                const makeTrue = Math.random() < 0.5;
                let n;
                if (makeTrue) {
                    const factor = Math.floor(Math.random() * 30) + 5;
                    n = factor * k;
                } else {
                    const factor = Math.floor(Math.random() * 30) + 5;
                    n = factor * k + (Math.floor(Math.random() * (k - 1)) + 1);
                }

                const modes = [
                    {
                        text: `«Число ${n} делится нацело на ${k}»`,
                        result: (n % k === 0)
                    },
                    {
                        text: `«Число ${n} является ${n % 2 === 0 ? 'чётным' : 'нечётным'}»`,
                        result: true
                    },
                    {
                        text: `«Число ${n} является ${n % 2 === 0 ? 'нечётным' : 'чётным'}»`,
                        result: false
                    }
                ];

                const mode = modes[Math.floor(Math.random() * modes.length)];
                p2Expected = mode.result ? '1' : '0';

                document.getElementById('p2-statement').textContent = mode.text;
                document.getElementById('p2-input').value = '';
                document.getElementById('p2-input').focus();
            }

            document.getElementById('p2-btn').addEventListener('click', () => {
                const ans = document.getElementById('p2-input').value.trim();
                if (ans === p2Expected) {
                    showPhase(3);
                    initPhase3();
                } else {
                    triggerError('p2-feedback', initPhase2);
                }
            });
            document.getElementById('p2-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') document.getElementById('p2-btn').click();
            });

            // ==========================================
            // ФАЗА 3: Системы счисления
            // ==========================================
            let p3Expected = '0';
            function initPhase3() {
                const decVal = Math.floor(Math.random() * 25) + 10; // 10..34
                const isTrue = Math.random() < 0.5;
                const offset = isTrue ? 0 : (Math.random() < 0.5 ? 1 : -1);

                const types = ['bin_eq_dec', 'hex_eq_dec', 'bin_eq_hex'];
                const type = types[Math.floor(Math.random() * types.length)];

                let stmt = '';
                let realVal = false;

                if (type === 'bin_eq_dec') {
                    const binStr = (decVal + offset).toString(2);
                    stmt = `${binStr}₂ == ${decVal}₁₀`;
                    realVal = (parseInt(binStr, 2) === decVal);
                } else if (type === 'hex_eq_dec') {
                    const hexStr = (decVal + offset).toString(16).toUpperCase();
                    stmt = `${hexStr}₁₆ == ${decVal}₁₀`;
                    realVal = (parseInt(hexStr, 16) === decVal);
                } else {
                    const hexStr = decVal.toString(16).toUpperCase();
                    const binStr = (decVal + offset).toString(2);
                    stmt = `${binStr}₂ == ${hexStr}₁₆`;
                    realVal = (parseInt(binStr, 2) === parseInt(hexStr, 16));
                }

                p3Expected = realVal ? '1' : '0';
                document.getElementById('p3-statement').textContent = stmt;
                document.getElementById('p3-input').value = '';
                document.getElementById('p3-input').focus();
            }

            document.getElementById('p3-btn').addEventListener('click', () => {
                const ans = document.getElementById('p3-input').value.trim();
                if (ans === p3Expected) {
                    showPhase(4);
                    initPhase4();
                } else {
                    triggerError('p3-feedback', initPhase3);
                }
            });
            document.getElementById('p3-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') document.getElementById('p3-btn').click();
            });

            // ==========================================
            // ФАЗА 4: Составные связки (И / ИЛИ)
            // ==========================================
            let p4Expected = '0';
            function initPhase4() {
                const port = Math.floor(Math.random() * 2000) + 1; // 1..2000
                const size = Math.floor(Math.random() * 3000) + 500; // 500..3500

                const c1 = port > 1024;
                const c2 = size < 1500;
                const useAnd = Math.random() < 0.5;

                let statementText = '';
                let result = false;

                if (useAnd) {
                    statementText = `(порт > 1024) И (размер < 1500)`;
                    result = c1 && c2;
                } else {
                    statementText = `(порт > 1024) ИЛИ (размер < 1500)`;
                    result = c1 || c2;
                }

                p4Expected = result ? '1' : '0';
                document.getElementById('p4-params').textContent = `порт = ${port}, размер = ${size}`;
                document.getElementById('p4-statement').textContent = statementText;
                document.getElementById('p4-input').value = '';
                document.getElementById('p4-input').focus();
            }

            document.getElementById('p4-btn').addEventListener('click', () => {
                const ans = document.getElementById('p4-input').value.trim();
                if (ans === p4Expected) {
                    showPhase(5);
                    initPhase5();
                } else {
                    triggerError('p4-feedback', initPhase4);
                }
            });
            document.getElementById('p4-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') document.getElementById('p4-btn').click();
            });

            // ==========================================
            // ФАЗА 5: Граничные значения переменной x
            // ==========================================
            let p5Expected = 0;
            function initPhase5() {
                const a = Math.floor(Math.random() * 40) + 10; // 10..49
                const span = Math.floor(Math.random() * 10) + 5; // 5..14
                const b = a + span; // e.g. a=15, b=25
                const askMax = Math.random() < 0.5;

                // Случайные типы строгости
                if (askMax) {
                    // (x > a) И (x < b) => max = b - 1
                    // (x ≥ a) И (x ≤ b) => max = b
                    const strictB = Math.random() < 0.5;
                    if (strictB) {
                        document.getElementById('p5-statement').textContent = `(x > ${a}) И (x < ${b})`;
                        p5Expected = b - 1;
                    } else {
                        document.getElementById('p5-statement').textContent = `(x > ${a}) И (x ≤ ${b})`;
                        p5Expected = b;
                    }
                    document.getElementById('p5-target-instruction').textContent = 'Найдите НАИБОЛЬШЕЕ целое число x, удовлетворяющее высказыванию:';
                } else {
                    // (x > a) И (x < b) => min = a + 1
                    // (x ≥ a) И (x ≤ b) => min = a
                    const strictA = Math.random() < 0.5;
                    if (strictA) {
                        document.getElementById('p5-statement').textContent = `(x > ${a}) И (x < ${b})`;
                        p5Expected = a + 1;
                    } else {
                        document.getElementById('p5-statement').textContent = `(x ≥ ${a}) И (x < ${b})`;
                        p5Expected = a;
                    }
                    document.getElementById('p5-target-instruction').textContent = 'Найдите НАИМЕНЬШЕЕ целое число x, удовлетворяющее высказыванию:';
                }

                document.getElementById('p5-input').value = '';
                document.getElementById('p5-input').focus();
            }

            document.getElementById('p5-btn').addEventListener('click', () => {
                const ans = parseInt(document.getElementById('p5-input').value.trim(), 10);
                if (ans === p5Expected) {
                    finishMission();
                } else {
                    triggerError('p5-feedback', initPhase5);
                }
            });
            document.getElementById('p5-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter') document.getElementById('p5-btn').click();
            });

            // ==========================================
            // Финал миссии
            // ==========================================
            function finishMission() {
                const timeSpent = Math.max(1, Math.floor((Date.now() - startTime) / 1000));
                sendTelemetry('level_complete', true);

                document.querySelectorAll('.phase-container').forEach(el => el.classList.add('d-none'));
                document.getElementById('level-badge').textContent = 'УСПЕХ';
                document.getElementById('level-title').textContent = 'Все 5 фаз пройдены';

                document.getElementById('final-time').textContent = timeSpent;
                document.getElementById('final-attempts').textContent = attempts;
                document.getElementById('success-screen').classList.remove('d-none');
            }

            // Старт с Фазы 1
            showPhase(1);
            initPhase1();
        })();
    </script>
</TaskLayout>
