---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={3}>
    <div id="arcade-app" class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Шапка аркады -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h4 text-danger mb-0">Аркада: LOGIC PULSE RUNNER // Логические элементы (Уровень 3)</h2>
            <span class="badge border border-danger text-danger bg-black rounded-0 px-3 py-2">
                Keyboard-Only // 16 клавиш // Hardcore
            </span>
        </div>

        <div
            id="game-card"
            :class="['card bg-black rounded-0', screenShake ? 'border-warning' : 'border-danger']"
            :style="{ transform: shakeOffset ? 'translateX(' + shakeOffset + 'px)' : 'none' }">
            <div class="card-body p-3 p-md-4">

                <!-- ==================== ЭКРАН INTRO (ОБЯЗАТЕЛЬНЫЙ БРИФИНГ) ==================== -->
                <div v-if="gameState === 'intro'" id="intro-screen" class="py-2">
                    <div class="border border-danger bg-dark p-3 p-md-4 mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <span class="badge bg-danger text-black rounded-0 fs-6">ХАРДКОР-РЕЖИМ // 10 ВОЛН</span>
                            <span class="text-warning small">Волна 1: 34.0 с → Волна 10: 15.0 с</span>
                        </div>
                        <h3 class="h5 text-light mb-2">Протокол калибровки логических вентилей (ГОСТ) под потоком 2 тактов</h3>
                        <p class="text-light small mb-3">
                            На входную шину платы поступают двухразрядные последовательности сигналов (такт 1 и такт 2:
                            <span class="badge bg-success text-black rounded-0">1</span> и
                            <span class="badge bg-info text-dark rounded-0">0</span>).
                            Ваша задача — настроить функцию каждого логического вентиля (<code>&amp;</code> И, <code>1</code> ИЛИ) и
                            выходную инверсию <code>○</code> (И-НЕ, ИЛИ-НЕ, НЕ) с клавиатуры, чтобы выходные сигналы на всех датчиках справа совпали с целью до прихода фронта импульса.
                            Любое короткое замыкание или тайм-аут сбрасывает прогресс на Волну 1.
                        </p>

                        <div class="border border-secondary bg-black p-3 mb-3">
                            <div class="text-danger small text-uppercase fw-bold mb-2">Клавиатурное управление (16 клавиш, мышь в игре отключена):</div>
                            <div class="row g-2 small text-light">
                                <div class="col-12 col-sm-6">
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">A</kbd> /
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">D</kbd> или
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">&larr;</kbd> /
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">&rarr;</kbd>
                                    — переместить курсор на соседний вентиль
                                </div>
                                <div class="col-12 col-sm-6">
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">W</kbd> /
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">S</kbd> или
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">&uarr;</kbd> /
                                    <kbd class="bg-dark border border-secondary text-warning rounded-0 px-2">&darr;</kbd>
                                    — переключить ядро (<code>&amp;</code> И ↔ <code>1</code> ИЛИ)
                                </div>
                                <div class="col-12 col-sm-6">
                                    <kbd class="bg-dark border border-secondary text-info rounded-0 px-2">1</kbd>–<kbd class="bg-dark border border-secondary text-info rounded-0 px-2">6</kbd>
                                    — быстрый выбор вентиля по номеру [1..6]
                                </div>
                                <div class="col-12 col-sm-6">
                                    <kbd class="bg-dark border border-secondary text-danger rounded-0 px-2">Shift</kbd> — инверсия выхода <code>○</code>,
                                    <kbd class="bg-dark border border-secondary text-success rounded-0 px-2">Space</kbd> — подать импульс
                                </div>
                            </div>
                        </div>

                        <div class="text-center">
                            <button id="start-btn" type="button" @click="startGame" class="btn btn-danger text-black fw-bold rounded-0 px-4 py-2 fs-5" style="min-width: 220px; min-height: 48px;">
                                Начать [Space]
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ==================== ИГРОВОЙ ЭКРАН (KEYBOARD-ONLY) ==================== -->
                <div v-else-if="gameState === 'playing'" id="playing-screen">
                    <!-- Верхний HUD -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 border-bottom border-danger pb-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span id="wave-badge" class="badge bg-danger text-black rounded-0 fs-6" v-text="'Волна ' + currentWave + ' / 10'"></span>
                            <span class="text-light fw-bold small" v-text="currentWaveData.title"></span>
                            <span
                                v-if="currentWaveData.modeTag"
                                class="badge bg-warning text-dark rounded-0 small"
                                v-text="currentWaveData.modeTag">
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-3 small">
                            <span class="text-secondary">Сбросы: <strong id="alarm-count" class="text-danger" v-text="alarmCount"></strong></span>
                            <span class="text-secondary">Время: <strong class="text-info" v-text="formatTime(totalElapsedSec)"></strong></span>
                            <span id="wave-timer" :class="['badge rounded-0 fs-6', waveTimeLeft <= 5 ? 'bg-danger text-black' : 'bg-dark border border-warning text-warning']" v-text="waveTimeLeft.toFixed(1) + ' с'"></span>
                        </div>
                    </div>

                    <!-- Прогресс-бар движения логического фронта импульса -->
                    <div class="mb-2">
                        <div class="d-flex justify-content-between small text-secondary mb-1">
                            <span>ФРОНТ ИМПУЛЬСА → ВЫХОДНЫЕ ДАТЧИКИ</span>
                            <span v-text="pulsePercent + '%'"></span>
                        </div>
                        <div class="progress rounded-0 bg-dark border border-secondary" style="height: 12px;">
                            <div
                                class="progress-bar rounded-0"
                                :class="waveTimeLeft <= 5 ? 'bg-danger' : 'bg-warning'"
                                role="progressbar"
                                :style="{ width: pulsePercent + '%' }">
                            </div>
                        </div>
                    </div>

                    <!-- Аварийный баннер хардкор-сброса (#alarm-box) -->
                    <div id="alarm-box" v-show="alarmActive" class="alert alert-danger bg-black text-danger border border-danger rounded-0 mb-2 py-2" role="alert">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <span>
                                <strong v-text="'[HARDCORE RESET #' + alarmCount + ']'"></strong>
                                <span class="ms-1" v-text="alarmMessage + ' Возврат на Волну 1...'"></span>
                            </span>
                            <span class="spinner-border spinner-border-sm text-danger flex-shrink-0" role="status"></span>
                        </div>
                    </div>

                    <!-- Игровое поле: СТРОГО pointer-events: none (ЗАПРЕТ МЫШИ В ИГРЕ) -->
                    <div id="arcade-field" style="pointer-events: none; user-select: none;">
                        <!-- Интерактивная принципиальная схема платы (Data Source + Direct Surface + Event FX) -->
                        <div class="border border-secondary bg-black mb-2 p-1">
                            <svg id="circuit-svg" viewBox="0 0 840 300" class="w-100 d-block bg-black" role="img" aria-label="Принципиальная логическая схема">
                                <!-- Фоновая монтажная сетка платы (статическая) -->
                                <g stroke="#1e293b" stroke-width="1">
                                    <line x1="120" y1="0" x2="120" y2="300"></line>
                                    <line x1="220" y1="0" x2="220" y2="300"></line>
                                    <line x1="360" y1="0" x2="360" y2="300"></line>
                                    <line x1="540" y1="0" x2="540" y2="300"></line>
                                    <line x1="710" y1="0" x2="710" y2="300"></line>
                                </g>

                                <!-- Заголовки зон платы -->
                                <text x="58" y="14" fill="#94a3b8" font-size="10" text-anchor="middle" font-family="monospace">ВХОДЫ (2 ТАКТА)</text>
                                <text x="277" y="14" fill="#94a3b8" font-size="10" text-anchor="middle" font-family="monospace">КАСКАД 1</text>
                                <text x="457" y="14" fill="#94a3b8" font-size="10" text-anchor="middle" font-family="monospace">КАСКАД 2</text>
                                <text x="627" y="14" fill="#94a3b8" font-size="10" text-anchor="middle" font-family="monospace">ВЫХ. КАСКАД</text>
                                <text x="778" y="14" fill="#94a3b8" font-size="10" text-anchor="middle" font-family="monospace">ЦЕЛЬ ДАТЧИКОВ</text>

                                <!-- Линия приближения тактового фронта (синхронизирована с pulsePercent) -->
                                <line
                                    :x1="wavefrontSvgX"
                                    y1="20"
                                    :x2="wavefrontSvgX"
                                    y2="294"
                                    :stroke="waveTimeLeft <= 5 ? '#ef4444' : '#f59e0b'"
                                    stroke-width="2"
                                    stroke-dasharray="5,4"
                                    opacity="0.75">
                                </line>

                                <!-- Проводники схемы (реактивная подсветка только во время pulseFxActive) -->
                                <g fill="none" stroke-linecap="square" stroke-linejoin="miter">
                                    <path
                                        v-for="(w, wIdx) in currentWaveData.wires"
                                        :key="'w-' + wIdx"
                                        :d="w.d"
                                        :stroke="getWireStroke(w)"
                                        :stroke-width="pulseFxActive ? 3.5 : 2.2">
                                    </path>
                                </g>

                                <!-- Точки разветвления ГОСТ (●) -->
                                <g>
                                    <circle
                                        v-for="(dot, dIdx) in currentWaveData.dots"
                                        :key="'dot-' + dIdx"
                                        :cx="dot.x"
                                        :cy="dot.y"
                                        r="4.5"
                                        fill="#e2e8f0"
                                        stroke="#0f172a"
                                        stroke-width="1">
                                    </circle>
                                </g>

                                <!-- Входные генераторы 2-тактного сигнала (слева) -->
                                <g
                                    v-for="inp in currentWaveData.inputs"
                                    :key="'in-' + inp.id"
                                    :data-input-pin="inp.id"
                                    :data-ticks="inp.ticks.join(',')">
                                    <rect :x="12" :y="inp.y - 16" width="90" height="32" fill="#0f172a" stroke="#475569" stroke-width="1.5"></rect>
                                    <text :x="25" :y="inp.y + 5" fill="#f8fafc" font-size="15" font-weight="bold" text-anchor="middle" font-family="monospace" v-text="inp.id"></text>
                                    <rect :x="40" :y="inp.y - 11" width="24" height="22" :fill="inp.ticks[0] ? '#22c55e' : '#38bdf8'"></rect>
                                    <text :x="52" :y="inp.y + 5" fill="#000000" font-size="14" font-weight="bold" text-anchor="middle" font-family="monospace" v-text="inp.ticks[0]"></text>
                                    <rect :x="69" :y="inp.y - 11" width="24" height="22" :fill="inp.ticks[1] ? '#22c55e' : '#38bdf8'"></rect>
                                    <text :x="81" :y="inp.y + 5" fill="#000000" font-size="14" font-weight="bold" text-anchor="middle" font-family="monospace" v-text="inp.ticks[1]"></text>
                                </g>

                                <!-- Аппаратные фиксированные инверторы (FIX 1○) -->
                                <g
                                    v-for="(fx, fIdx) in currentWaveData.fixedInverters"
                                    :key="'fx-' + fIdx"
                                    data-fix-inverter="true"
                                    :data-source="fx.source"
                                    :data-ticks="fx.ticks.join(',')">
                                    <rect :x="fx.x" :y="fx.y - 18" width="40" height="36" fill="#1e293b" stroke="#94a3b8" stroke-width="1.5"></rect>
                                    <text :x="fx.x + 20" :y="fx.y - 3" fill="#94a3b8" font-size="9" text-anchor="middle" font-family="monospace">FIX</text>
                                    <text :x="fx.x + 20" :y="fx.y + 12" fill="#f8fafc" font-size="15" font-weight="bold" text-anchor="middle" font-family="monospace">1</text>
                                    <circle :cx="fx.x + 45" :cy="fx.y" r="5" fill="#000000" stroke="#f59e0b" stroke-width="2"></circle>
                                </g>

                                <!-- Программируемые логические вентили ГОСТ [1..K] (Direct Surface, Keyboard-Only) -->
                                <g
                                    v-for="g in currentWaveData.gates"
                                    :key="'gate-' + g.id"
                                    :data-gate-id="g.id"
                                    :data-arity="g.arity"
                                    :data-base="gateStates[g.id] ? gateStates[g.id].base : 'AND'"
                                    :data-inv="gateStates[g.id] && gateStates[g.id].inv ? '1' : '0'"
                                    :data-op="getGateOp(g.id)"
                                    :data-inputs="g.inputs.join(',')"
                                    :data-cursor="cursorGateId === g.id ? 'true' : 'false'">
                                    <!-- Неоновая рамка курсора -->
                                    <rect
                                        v-if="cursorGateId === g.id"
                                        :x="g.x - 5"
                                        :y="g.y - 29"
                                        width="74"
                                        height="58"
                                        fill="none"
                                        stroke="#ffc107"
                                        stroke-width="2"
                                        stroke-dasharray="4,3">
                                    </rect>
                                    <!-- Корпус вентиля ГОСТ -->
                                    <rect
                                        :x="g.x"
                                        :y="g.y - 24"
                                        width="64"
                                        height="48"
                                        :fill="getGateFill(g.id)"
                                        :stroke="getGateStroke(g.id)"
                                        :stroke-width="cursorGateId === g.id ? 3 : 2">
                                    </rect>
                                    <!-- Номер вентиля [1..6] -->
                                    <text
                                        :x="g.x + 13"
                                        :y="g.y - 10"
                                        :fill="cursorGateId === g.id ? '#ffc107' : '#38bdf8'"
                                        font-size="11"
                                        font-weight="bold"
                                        text-anchor="middle"
                                        font-family="monospace"
                                        v-text="'[' + g.id + ']'">
                                    </text>
                                    <!-- Маркировка ГОСТ (& или 1) -->
                                    <text
                                        :x="g.x + 36"
                                        :y="g.y + 5"
                                        fill="#ffffff"
                                        font-size="22"
                                        font-weight="bold"
                                        text-anchor="middle"
                                        font-family="monospace"
                                        v-text="getGateGostSymbol(g.id)">
                                    </text>
                                    <!-- Подпись операции (И / ИЛИ / И-НЕ / ИЛИ-НЕ / ПРЯМ / НЕ) -->
                                    <text
                                        :x="g.x + 32"
                                        :y="g.y + 19"
                                        :fill="gateStates[g.id] && gateStates[g.id].inv ? '#fbbf24' : '#cbd5e1'"
                                        font-size="10"
                                        font-weight="bold"
                                        text-anchor="middle"
                                        font-family="monospace"
                                        v-text="getGateRuLabel(g.id)">
                                    </text>
                                    <!-- Инверсный кружок ГОСТ на выходе (○) -->
                                    <circle
                                        v-if="gateStates[g.id] && gateStates[g.id].inv"
                                        :cx="g.x + 70"
                                        :cy="g.y"
                                        r="6"
                                        fill="#000000"
                                        stroke="#f59e0b"
                                        stroke-width="2.5">
                                    </circle>
                                </g>

                                <!-- Целевые выходные датчики (справа) -->
                                <g
                                    v-for="s in currentWaveData.sensors"
                                    :key="'sens-' + s.id"
                                    :data-sensor-id="s.id"
                                    :data-source-gate="s.sourceGate"
                                    :data-target="s.target.join(',')">
                                    <rect
                                        :x="732"
                                        :y="s.y - 16"
                                        width="96"
                                        height="32"
                                        fill="#0f172a"
                                        :stroke="getSensorStroke(s)"
                                        :stroke-width="pulseFxActive ? 3 : 1.5">
                                    </rect>
                                    <text :x="749" :y="s.y + 5" fill="#f8fafc" font-size="13" font-weight="bold" text-anchor="middle" font-family="monospace" v-text="s.id"></text>
                                    <rect :x="768" :y="s.y - 11" width="24" height="22" :fill="s.target[0] ? '#22c55e' : '#38bdf8'"></rect>
                                    <text :x="780" :y="s.y + 5" fill="#000000" font-size="14" font-weight="bold" text-anchor="middle" font-family="monospace" v-text="s.target[0]"></text>
                                    <rect :x="797" :y="s.y - 11" width="24" height="22" :fill="s.target[1] ? '#22c55e' : '#38bdf8'"></rect>
                                    <text :x="809" :y="s.y + 5" fill="#000000" font-size="14" font-weight="bold" text-anchor="middle" font-family="monospace" v-text="s.target[1]"></text>
                                </g>
                            </svg>
                        </div>

                        <!-- Панель состояния активного курсора (строго без дублирования условий схемы) -->
                        <div class="border border-secondary bg-dark px-3 py-2 mb-2 d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                            <span class="text-light">
                                Курсор: <strong class="text-warning" v-text="'Вентиль [' + cursorGateId + ']'"></strong>
                                <span class="text-secondary ms-2" v-text="'(' + activeCursorMetaText + ')'"></span>
                            </span>
                            <span class="text-info" v-text="'Режим вентиля: ' + getGateRuLabel(cursorGateId) + ' [' + getGateGostSymbol(cursorGateId) + (gateStates[cursorGateId] && gateStates[cursorGateId].inv ? '○' : '') + ']'"></span>
                        </div>

                        <!-- Компактный Keycap HUD -->
                        <div class="border border-secondary bg-dark p-2 text-center small text-light">
                            <kbd class="bg-black border border-secondary text-warning rounded-0 px-1">A/D</kbd>
                            <kbd class="bg-black border border-secondary text-warning rounded-0 px-1">&larr;/&rarr;</kbd> курсор &middot;
                            <kbd class="bg-black border border-secondary text-warning rounded-0 px-1">W/S</kbd>
                            <kbd class="bg-black border border-secondary text-warning rounded-0 px-1">&uarr;/&darr;</kbd> И / ИЛИ &middot;
                            <kbd class="bg-black border border-secondary text-danger rounded-0 px-1">Shift</kbd> инверсия ○ &middot;
                            <kbd class="bg-black border border-secondary text-info rounded-0 px-1">1..6</kbd> узел &middot;
                            <kbd class="bg-black border border-secondary text-success rounded-0 px-1">Space</kbd> ПОДАТЬ ИМПУЛЬС
                        </div>
                    </div>
                </div>

                <!-- ==================== ЭКРАН ПОБЕДЫ ==================== -->
                <div v-else-if="gameState === 'victory'" id="victory-screen" class="text-center py-4">
                    <div class="border border-success bg-dark p-4 mb-3">
                        <h3 class="text-success mb-2">[ УРОВЕНЬ 3 ПРОЙДЕН // ЛОГИЧЕСКАЯ ПЛАТА СТАБИЛИЗИРОВАНА ]</h3>
                        <p class="text-light mb-3">
                            Все 10 волн калибровки логических элементов И, ИЛИ, НЕ, И-НЕ и ИЛИ-НЕ пройдены с клавиатуры без единого замыкания.
                        </p>
                        <div class="d-flex justify-content-center gap-4 text-secondary small mb-3">
                            <span>Хардкор-сбросов: <strong class="text-danger" v-text="alarmCount"></strong></span>
                            <span>Время: <strong class="text-info" v-text="formatTime(totalElapsedSec)"></strong></span>
                        </div>
                        <button id="restart-btn" type="button" @click="restartGame" class="btn btn-outline-success rounded-0 fw-bold px-4 py-2" style="min-height: 48px;">
                            Пройти снова [Space]
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script is:inline src="/static/vue.global.js"></script>
    <script is:inline>
    (function() {
        const ALL_TICKS = [
            [0, 0],
            [0, 1],
            [1, 0],
            [1, 1]
        ];
        const BINARY_OPS = ['AND', 'OR', 'NAND', 'NOR'];

        let audioCtx = null;
        let resetTimeoutId = null;
        let pulseTimeoutId = null;
        let shakeTimerIds = [];
        let appInstance = null;

        function getAudioContext() {
            if (!audioCtx && (window.AudioContext || window.webkitAudioContext)) {
                const Ctx = window.AudioContext || window.webkitAudioContext;
                try { audioCtx = new Ctx(); } catch (e) {}
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume().catch(function() {});
            }
            return audioCtx;
        }

        function playTone(freq, type, duration, vol) {
            const ctx = getAudioContext();
            if (!ctx) return;
            try {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = type || 'square';
                osc.frequency.setValueAtTime(freq, ctx.currentTime);
                gain.gain.setValueAtTime(vol || 0.05, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + (duration || 0.08));
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + (duration || 0.08));
            } catch (e) {}
        }

        function playCursorSound() { playTone(340, 'triangle', 0.04, 0.04); }
        function playGateSwitchSound() { playTone(520, 'square', 0.06, 0.045); }
        function playInvertSound(isInv) { playTone(isInv ? 660 : 390, 'sawtooth', 0.07, 0.045); }
        function playWaveClearSound() {
            playTone(523, 'triangle', 0.08, 0.06);
            setTimeout(function() { playTone(784, 'triangle', 0.14, 0.06); }, 85);
        }
        function playAlarmSiren() {
            playTone(210, 'sawtooth', 0.18, 0.09);
            setTimeout(function() { playTone(150, 'sawtooth', 0.24, 0.09); }, 180);
        }
        function playVictoryFanfare() {
            [523, 659, 784, 1046].forEach(function(freq, idx) {
                setTimeout(function() { playTone(freq, 'triangle', 0.16, 0.06); }, idx * 95);
            });
        }

        function randInt(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function pickRandom(arr) {
            return arr[randInt(0, arr.length - 1)];
        }

        function shuffle(arr) {
            const copy = arr.slice();
            for (let i = copy.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                const tmp = copy[i];
                copy[i] = copy[j];
                copy[j] = tmp;
            }
            return copy;
        }

        function cloneTicks(t) {
            return [t[0], t[1]];
        }

        function invTicks(t) {
            return [1 - t[0], 1 - t[1]];
        }

        function hamming(a, b) {
            return (a[0] ^ b[0]) + (a[1] ^ b[1]);
        }

        function sameTicks(a, b) {
            return a[0] === b[0] && a[1] === b[1];
        }

        function neighborsOf(t) {
            return [
                [1 - t[0], t[1]],
                [t[0], 1 - t[1]]
            ];
        }

        function evalGateTicks(arity, op, in1, in2) {
            if (arity === 1) {
                return op === 'NOT' ? [1 - in1[0], 1 - in1[1]] : [in1[0], in1[1]];
            }
            const a0 = in1[0], a1 = in1[1];
            const b0 = in2[0], b1 = in2[1];
            if (op === 'AND') return [a0 & b0, a1 & b1];
            if (op === 'OR') return [a0 | b0, a1 | b1];
            if (op === 'NAND') return [1 - (a0 & b0), 1 - (a1 & b1)];
            return [1 - (a0 | b0), 1 - (a1 | b1)];
        }

        function opToState(arity, op) {
            if (arity === 1) {
                return { base: 'BUF', inv: op === 'NOT' };
            }
            return {
                base: (op === 'AND' || op === 'NAND') ? 'AND' : 'OR',
                inv: (op === 'NAND' || op === 'NOR')
            };
        }

        function stateToOp(arity, st) {
            if (arity === 1) {
                return st.inv ? 'NOT' : 'BUF';
            }
            if (st.base === 'AND') {
                return st.inv ? 'NAND' : 'AND';
            }
            return st.inv ? 'NOR' : 'OR';
        }

        function pickDifferentOp(op, pool) {
            const candidates = pool.filter(function(c) { return c !== op; });
            return pickRandom(candidates);
        }

        function buildInitialGateStates(gates, solutionOps, mismatchedIds, forceNonInv) {
            const mismatchSet = {};
            mismatchedIds.forEach(function(id) { mismatchSet[id] = true; });
            const init = {};
            gates.forEach(function(g) {
                const targetOp = solutionOps[g.id];
                if (!mismatchSet[g.id]) {
                    init[g.id] = opToState(g.arity, targetOp);
                    return;
                }
                if (g.arity === 1) {
                    init[g.id] = opToState(1, targetOp === 'NOT' ? 'BUF' : 'NOT');
                    return;
                }
                if (forceNonInv) {
                    const nonInvPool = ['AND', 'OR'];
                    const chosen = pickDifferentOp(targetOp, nonInvPool);
                    init[g.id] = opToState(2, chosen);
                } else {
                    const st = opToState(2, targetOp);
                    if (st.inv) {
                        // Неинверсная база (без ○), чтобы ученик явно включил инверсию через Shift
                        init[g.id] = { base: Math.random() < 0.5 ? 'AND' : 'OR', inv: false };
                    } else {
                        init[g.id] = { base: st.base === 'AND' ? 'OR' : 'AND', inv: false };
                    }
                }
            });
            return init;
        }

        function evaluateCircuit(wave, gateStates) {
            const values = {};
            wave.inputs.forEach(function(inp) {
                values[inp.id] = cloneTicks(inp.ticks);
            });
            (wave.fixedInverters || []).forEach(function(fx) {
                values[fx.id] = invTicks(values[fx.source]);
            });
            wave.gates.forEach(function(g) {
                const op = stateToOp(g.arity, gateStates[g.id]);
                const in1 = values[g.inputs[0]];
                const in2 = g.arity === 2 ? values[g.inputs[1]] : null;
                values['G' + g.id] = evalGateTicks(g.arity, op, in1, in2);
            });
            return values;
        }

