                ],
                solutionOps: { 1: op1, 2: op2, 3: op3 },
                initialGateStates: buildInitialGateStates(gatesMeta, { 1: op1, 2: op2, 3: op3 }, [1, 2, 3], true)
            };
        }

        function buildWave9or10(waveNum, timeLimit, withCascade3) {
            const A = pickRandom(ALL_TICKS);
            const B = pickRandom(neighborsOf(A));
            const C = pickRandom(neighborsOf(B));
            const D = pickRandom(neighborsOf(C));

            const op1 = pickRandom(BINARY_OPS);
            const F1 = evalGateTicks(2, op1, A, B);

            const op2Pool = shuffle(BINARY_OPS).filter(function(op) {
                return hamming(F1, evalGateTicks(2, op, B, C)) === 1;
            });
            const op2 = op2Pool[0];
            const F2 = evalGateTicks(2, op2, B, C);

            const op3Pool = shuffle(BINARY_OPS).filter(function(op) {
                return hamming(F2, evalGateTicks(2, op, C, D)) === 1;
            });
            const op3 = op3Pool[0];
            const F3 = evalGateTicks(2, op3, C, D);

            const op4 = pickRandom(BINARY_OPS);
            const F4 = evalGateTicks(2, op4, F1, F2);

            let op5;
            if (withCascade3) {
                const op5Pool = shuffle(BINARY_OPS).filter(function(op) {
                    return hamming(F4, evalGateTicks(2, op, F2, F3)) === 1;
                });
                op5 = op5Pool[0];
            } else {
                op5 = pickRandom(BINARY_OPS);
            }
            const F5 = evalGateTicks(2, op5, F2, F3);

            const gatesMeta = [
                { id: 1, arity: 2, x: 245, y: 56, inputs: ['A', 'B'] },
                { id: 2, arity: 2, x: 245, y: 150, inputs: ['B', 'C'] },
                { id: 3, arity: 2, x: 245, y: 244, inputs: ['C', 'D'] },
                { id: 4, arity: 2, x: 425, y: 103, inputs: ['G1', 'G2'] },
                { id: 5, arity: 2, x: 425, y: 197, inputs: ['G2', 'G3'] }
            ];
            const solutionOps = { 1: op1, 2: op2, 3: op3, 4: op4, 5: op5 };

            const wires = [
                { src: 'A', d: 'M102,42 L200,42 L200,45 L245,45' },
                { src: 'B', d: 'M102,114 L155,114 L155,67 L245,67' },
                { src: 'B', d: 'M155,114 L155,139 L245,139' },
                { src: 'C', d: 'M102,186 L185,186 L185,161 L245,161' },
                { src: 'C', d: 'M185,186 L185,233 L245,233' },
                { src: 'D', d: 'M102,258 L200,258 L200,255 L245,255' },
                { src: 'G1', d: 'M309,56 L345,56 L345,28 L732,28' },
                { src: 'G1', d: 'M345,56 L385,56 L385,92 L425,92' },
                { src: 'G2', d: 'M309,150 L360,150 L360,54 L732,54' },
                { src: 'G2', d: 'M360,150 L385,150 L385,114 L425,114' },
                { src: 'G2', d: 'M360,150 L385,150 L385,186 L425,186' },
                { src: 'G3', d: 'M309,244 L345,244 L345,274 L732,274' },
                { src: 'G3', d: 'M345,244 L385,244 L385,208 L425,208' }
            ];

            const dots = [
                { x: 155, y: 114 },
                { x: 185, y: 186 },
                { x: 345, y: 56 },
                { x: 360, y: 150 },
                { x: 345, y: 244 }
            ];

            const sensors = [
                { id: 'F₁', y: 28, sourceGate: 1, target: F1 },
                { id: 'F₂', y: 54, sourceGate: 2, target: F2 },
                { id: 'F₄', y: 98, sourceGate: 4, target: F4 },
                { id: 'F₅', y: 204, sourceGate: 5, target: F5 },
                { id: 'F₃', y: 274, sourceGate: 3, target: F3 }
            ];

            if (!withCascade3) {
                wires.push({ src: 'G4', d: 'M489,103 L520,103 L520,98 L732,98' });
                wires.push({ src: 'G5', d: 'M489,197 L520,197 L520,204 L732,204' });
                const mismatched5 = shuffle([1, 2, 3, 4, 5]).slice(0, 4);
                return {
                    wave: waveNum,
                    timeLimit: timeLimit,
                    title: '5-вентильная многокаскадная матрица',
                    modeTag: '',
                    inputs: [
                        { id: 'A', y: 42, ticks: A },
                        { id: 'B', y: 114, ticks: B },
                        { id: 'C', y: 186, ticks: C },
                        { id: 'D', y: 258, ticks: D }
                    ],
                    fixedInverters: [],
                    gates: gatesMeta,
                    sensors: sensors,
                    dots: dots,
                    wires: wires,
                    solutionOps: solutionOps,
                    initialGateStates: buildInitialGateStates(gatesMeta, solutionOps, mismatched5, false)
                };
            }

            const op6 = pickRandom(BINARY_OPS);
            const F6 = evalGateTicks(2, op6, F4, F5);
            gatesMeta.push({ id: 6, arity: 2, x: 595, y: 150, inputs: ['G4', 'G5'] });
            solutionOps[6] = op6;

            wires.push({ src: 'G4', d: 'M489,103 L528,103 L528,98 L732,98' });
            wires.push({ src: 'G4', d: 'M528,103 L558,103 L558,139 L595,139' });
            wires.push({ src: 'G5', d: 'M489,197 L528,197 L528,204 L732,204' });
            wires.push({ src: 'G5', d: 'M528,197 L558,197 L558,161 L595,161' });
            wires.push({ src: 'G6', d: 'M659,150 L732,150' });
            dots.push({ x: 528, y: 103 });
            dots.push({ x: 528, y: 197 });

            sensors.splice(3, 0, { id: 'F₆', y: 150, sourceGate: 6, target: F6 });
            // Переупорядочим Y для 6 датчиков без наложения
            sensors[0].y = 24;
            sensors[1].y = 58;
            sensors[2].y = 98;
            sensors[3].y = 150;
            sensors[4].y = 204;
            sensors[5].y = 274;
            // Обновим конечные Y на проводах F1, F2
            wires[6].d = 'M309,56 L345,56 L345,24 L732,24';
            wires[8].d = 'M309,150 L360,150 L360,58 L732,58';

            const mismatched6 = shuffle([1, 2, 3, 4, 5, 6]).slice(0, 4);

            return {
                wave: waveNum,
                timeLimit: timeLimit,
                title: 'ФИНАЛЬНЫЙ ШТУРМ // 3-каскадная шина (6 вентилей)',
                modeTag: 'ФИНАЛ',
                inputs: [
                    { id: 'A', y: 42, ticks: A },
                    { id: 'B', y: 114, ticks: B },
                    { id: 'C', y: 186, ticks: C },
                    { id: 'D', y: 258, ticks: D }
                ],
                fixedInverters: [],
                gates: gatesMeta,
                sensors: sensors,
                dots: dots,
                wires: wires,
                solutionOps: solutionOps,
                initialGateStates: buildInitialGateStates(gatesMeta, solutionOps, mismatched6, false)
            };
        }

        function generateWaves() {
            return [
                buildWave1(),
                buildWave2(),
                buildWave3or4(3, 26.0, false),
                buildWave3or4(4, 24.0, true),
                buildWave5or6(5, 22.0, false),
                buildWave5or6(6, 19.5, true),
                buildWave7(),
                buildWave8(),
                buildWave9or10(9, 16.5, false),
                buildWave9or10(10, 15.0, true)
            ];
        }

        function cloneGateStates(map) {
            const copy = {};
            Object.keys(map).forEach(function(k) {
                copy[k] = { base: map[k].base, inv: Boolean(map[k].inv) };
            });
            return copy;
        }

        const telemetry = window.LMSTelemetry.create({
            missionName: 'Урок 11 :: Логические элементы (Уровень 3)',
            level: 3,
            totalWaves: 10,
            showAfkOverlay: true,
            onAfkStop: function() {
                if (appInstance) {
                    appInstance.handleAfkPaused();
                }
            },
            onAfkRetry: function() {
                if (appInstance) {
                    appInstance.handleAfkResumed();
                }
            }
        });

        const { createApp } = Vue;
        const app = createApp({
            data: function() {
                const initialWaves = generateWaves();
                return {
                    gameState: 'intro', // 'intro' | 'playing' | 'victory'
                    activeWaves: initialWaves,
                    currentWave: 1,
                    gateStates: cloneGateStates(initialWaves[0].initialGateStates),
                    cursorGateId: 1,
                    waveTimeLeft: 34.0,
                    totalElapsedSec: 0,
                    alarmActive: false,
                    alarmMessage: '',
                    alarmCount: 0,
                    isActionBlocked: false,
                    afkPaused: false,
                    screenShake: false,
                    shakeOffset: 0,
                    lastMutatedGateId: -1,
                    pulseFxActive: false,
                    pulseFxOutcome: 'none', // 'none' | 'ok' | 'err'
                    lastEvalValues: {},
                    lastFailedSensors: {},
                    waveTimerHandle: null
                };
            },

            computed: {
                currentWaveData: function() {
                    return this.activeWaves[this.currentWave - 1] || this.activeWaves[0];
                },

                pulsePercent: function() {
                    const lim = this.currentWaveData.timeLimit || 34;
                    const pct = Math.round(((lim - this.waveTimeLeft) / lim) * 100);
                    return Math.max(0, Math.min(100, pct));
                },

                wavefrontSvgX: function() {
                    return Math.round(108 + (this.pulsePercent / 100) * 620);
                },

                activeCursorMetaText: function() {
                    const gates = this.currentWaveData.gates || [];
                    const found = gates.find(function(g) { return g.id === this.cursorGateId; }, this);
                    if (!found) return '';
                    return found.arity === 1 ? 'одноместный вход' : 'двухместный вход';
                }
            },

            mounted: function() {
                window.addEventListener('keydown', this.handleKeyDown);
            },

            unmounted: function() {
                window.removeEventListener('keydown', this.handleKeyDown);
                this.stopTimers();
            },

            methods: {
                stopTimers: function() {
                    if (this.waveTimerHandle) {
                        clearInterval(this.waveTimerHandle);
                        this.waveTimerHandle = null;
                    }
                    if (resetTimeoutId) {
                        clearTimeout(resetTimeoutId);
                        resetTimeoutId = null;
                    }
                    if (pulseTimeoutId) {
                        clearTimeout(pulseTimeoutId);
                        pulseTimeoutId = null;
                    }
                    shakeTimerIds.forEach(function(id) { clearTimeout(id); });
                    shakeTimerIds = [];
                },

                triggerShake: function() {
                    const self = this;
                    shakeTimerIds.forEach(function(id) { clearTimeout(id); });
                    shakeTimerIds = [];
                    self.screenShake = true;
                    const steps = [-6, 6, -4, 4, 0];
                    steps.forEach(function(offset, idx) {
                        const tid = setTimeout(function() {
                            self.shakeOffset = offset;
                            if (offset === 0) self.screenShake = false;
                        }, idx * 55);
                        shakeTimerIds.push(tid);
                    });
                },

                getGateOp: function(gateId) {
                    const g = (this.currentWaveData.gates || []).find(function(item) { return item.id === gateId; });
                    const st = this.gateStates[gateId];
                    if (!g || !st) return 'AND';
                    return stateToOp(g.arity, st);
                },

                getGateGostSymbol: function(gateId) {
                    const op = this.getGateOp(gateId);
                    if (op === 'AND' || op === 'NAND') return '&';
                    return '1';
                },

                getGateRuLabel: function(gateId) {
                    const op = this.getGateOp(gateId);
                    if (op === 'AND') return 'И';
                    if (op === 'OR') return 'ИЛИ';
                    if (op === 'NAND') return 'И-НЕ';
                    if (op === 'NOR') return 'ИЛИ-НЕ';
                    if (op === 'NOT') return 'НЕ';
                    return 'ПРЯМ';
                },

                getGateFill: function(gateId) {
                    if (this.pulseFxActive && this.pulseFxOutcome === 'err') return '#3b0a0a';
                    if (this.pulseFxActive && this.pulseFxOutcome === 'ok') return '#052e16';
                    if (this.lastMutatedGateId === gateId) return '#1e293b';
                    return this.cursorGateId === gateId ? '#172554' : '#0f172a';
                },

                getGateStroke: function(gateId) {
                    if (this.pulseFxActive && this.pulseFxOutcome === 'ok') return '#22c55e';
                    if (this.pulseFxActive && this.pulseFxOutcome === 'err') return '#ef4444';
                    return this.cursorGateId === gateId ? '#ffc107' : '#94a3b8';
                },

                getWireStroke: function(wire) {
                    if (!this.pulseFxActive) return '#64748b';
                    if (this.pulseFxOutcome === 'err') return '#ef4444';
                    const vals = this.lastEvalValues[wire.src];
                    if (!vals) return '#22c55e';
                    return vals[0] === 1 || vals[1] === 1 ? '#22c55e' : '#38bdf8';
                },

                getSensorStroke: function(sensor) {
                    if (!this.pulseFxActive) return '#64748b';
                    return this.lastFailedSensors[sensor.id] ? '#ef4444' : '#22c55e';
                },

                loadWave: function(waveNum) {
                    this.currentWave = waveNum;
                    const w = this.currentWaveData;
                    this.gateStates = cloneGateStates(w.initialGateStates);
                    this.cursorGateId = w.gates[0].id;
                    this.waveTimeLeft = w.timeLimit;
                    this.alarmActive = false;
                    this.isActionBlocked = false;
                    this.pulseFxActive = false;
                    this.pulseFxOutcome = 'none';
                    this.lastFailedSensors = {};
                    this.lastEvalValues = {};
                },

                startWaveInterval: function() {
                    const self = this;
                    if (this.waveTimerHandle) clearInterval(this.waveTimerHandle);
                    this.waveTimerHandle = setInterval(function() {
                        if (self.gameState !== 'playing' || self.alarmActive || self.isActionBlocked || self.afkPaused) {
                            return;
                        }
                        self.totalElapsedSec = telemetry.getTimeSpentSec();
                        self.waveTimeLeft = Math.max(0, Number((self.waveTimeLeft - 0.1).toFixed(1)));
                        if (self.waveTimeLeft <= 0) {
                            self.triggerHardcoreReset('Тайм-аут фронта импульса! Калибровка схемы не завершена вовремя.', true);
                        }
                    }, 100);
                },

                startGame: function() {
                    getAudioContext();
                    this.stopTimers();
                    this.activeWaves = generateWaves();
                    this.alarmCount = 0;
                    this.afkPaused = false;
                    this.gameState = 'playing';
                    telemetry.start();
                    this.totalElapsedSec = telemetry.getTimeSpentSec();
                    this.loadWave(1);
                    this.startWaveInterval();
                },

                restartGame: function() {
                    this.stopTimers();
                    telemetry.reset({ allowRecomplete: true });
                    this.startGame();
                },

                handleAfkPaused: function() {
                    this.afkPaused = true;
                    this.stopTimers();
                },

                handleAfkResumed: function() {
                    this.afkPaused = false;
                    this.alarmActive = false;
                    this.isActionBlocked = false;
                    this.activeWaves = generateWaves();
                    this.loadWave(1);
                    this.startWaveInterval();
                },

                moveCursor: function(delta) {
                    const gates = this.currentWaveData.gates || [];
                    if (!gates.length) return;
                    const curIdx = gates.findIndex(function(g) { return g.id === this.cursorGateId; }, this);
                    const baseIdx = curIdx >= 0 ? curIdx : 0;
                    const nextIdx = (baseIdx + delta + gates.length) % gates.length;
                    this.cursorGateId = gates[nextIdx].id;
                    playCursorSound();
                },

                selectGateByNumber: function(num) {
                    const gates = this.currentWaveData.gates || [];
                    const found = gates.find(function(g) { return g.id === num; });
                    if (!found) return;
                    this.cursorGateId = found.id;
                    playCursorSound();
                },

                flashGateMutation: function(gateId) {
                    const self = this;
                    this.lastMutatedGateId = gateId;
                    setTimeout(function() {
                        if (self.lastMutatedGateId === gateId) {
                            self.lastMutatedGateId = -1;
                        }
                    }, 180);
                },

                toggleCoreBase: function() {
                    const g = (this.currentWaveData.gates || []).find(function(item) { return item.id === this.cursorGateId; }, this);
                    const st = this.gateStates[this.cursorGateId];
                    if (!g || !st) return;
                    if (g.arity === 1) {
                        st.inv = !st.inv;
                    } else {
                        st.base = st.base === 'AND' ? 'OR' : 'AND';
                    }
                    playGateSwitchSound();
                    this.flashGateMutation(this.cursorGateId);
                },

                toggleInversionBubble: function() {
                    const st = this.gateStates[this.cursorGateId];
                    if (!st) return;
                    st.inv = !st.inv;
                    playInvertSound(st.inv);
                    this.flashGateMutation(this.cursorGateId);
                },

                triggerHardcoreReset: function(message, isTimeout) {
                    const self = this;
                    if (this.alarmActive || this.afkPaused) return;
                    if (pulseTimeoutId) {
                        clearTimeout(pulseTimeoutId);
                        pulseTimeoutId = null;
                    }
                    this.isActionBlocked = true;
                    this.stopTimers();
                    playAlarmSiren();
                    this.triggerShake();

                    const res = telemetry.fail({ wave: this.currentWave, isTimeout: Boolean(isTimeout) });
                    this.alarmCount = telemetry.getState().attemptsCount;

                    if (res === false || telemetry.getState().isAfkPaused) {
                        this.afkPaused = true;
                        return;
                    }

                    this.alarmMessage = message;
                    this.alarmActive = true;

                    resetTimeoutId = setTimeout(function() {
                        resetTimeoutId = null;
                        if (self.afkPaused || self.gameState !== 'playing') return;
                        self.activeWaves = generateWaves();
                        self.loadWave(1);
                        self.startWaveInterval();
                    }, 1500);
                },

                launchPulse: function() {
                    const self = this;
                    if (this.alarmActive || this.isActionBlocked || this.afkPaused) return;

                    const w = this.currentWaveData;
                    const vals = evaluateCircuit(w, this.gateStates);
                    this.lastEvalValues = vals;

                    const failed = [];
                    const failedMap = {};
                    w.sensors.forEach(function(s) {
                        const actual = vals['G' + s.sourceGate];
                        if (!actual || !sameTicks(actual, s.target)) {
                            failed.push(s.id);
                            failedMap[s.id] = true;
                        }
                    });
                    this.lastFailedSensors = failedMap;

                    if (failed.length > 0) {
                        this.pulseFxActive = true;
                        this.pulseFxOutcome = 'err';
                        this.triggerHardcoreReset('Короткое замыкание! Сигнал на датчике ' + failed.join(', ') + ' не совпал с целью.', false);
                        return;
                    }

                    this.isActionBlocked = true;
                    this.pulseFxActive = true;
                    this.pulseFxOutcome = 'ok';

                    if (this.currentWave >= 10) {
                        this.stopTimers();
                        this.totalElapsedSec = telemetry.getTimeSpentSec();
                        playVictoryFanfare();
                        telemetry.complete({ wave: 10, total_waves: 10 });
                        pulseTimeoutId = setTimeout(function() {
                            pulseTimeoutId = null;
                            self.pulseFxActive = false;
                            self.pulseFxOutcome = 'none';
                            self.gameState = 'victory';
                            self.isActionBlocked = false;
                        }, 220);
                        return;
                    }

                    playWaveClearSound();
                    const nextWave = this.currentWave + 1;
                    telemetry.advanceWave(nextWave);
                    pulseTimeoutId = setTimeout(function() {
                        pulseTimeoutId = null;
                        if (self.afkPaused || self.gameState !== 'playing') return;
                        self.loadWave(nextWave);
                    }, 220);
                },

                handleKeyDown: function(e) {
                    if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'ArrowDown' || e.code === 'ArrowLeft' || e.code === 'ArrowRight') {
                        e.preventDefault();
                    }

                    if (this.afkPaused || telemetry.getState().isAfkPaused) {
                        if (e.code === 'Space') {
                            telemetry.resumeFromAfk();
                        }
                        return;
                    }

                    if (this.gameState === 'intro') {
                        if (e.code === 'Space') {
                            this.startGame();
                        }
                        return;
                    }

                    if (this.gameState === 'victory') {
                        if (e.code === 'Space') {
                            this.restartGame();
                        }
                        return;
                    }

                    if (this.gameState !== 'playing' || this.alarmActive || this.isActionBlocked) {
                        return;
                    }

                    switch (e.code) {
                        case 'KeyA':
                        case 'ArrowLeft':
                            this.moveCursor(-1);
                            return;
                        case 'KeyD':
                        case 'ArrowRight':
                            this.moveCursor(1);
                            return;
                        case 'KeyW':
                        case 'ArrowUp':
                        case 'KeyS':
                        case 'ArrowDown':
                            this.toggleCoreBase();
                            return;
                        case 'ShiftLeft':
                        case 'ShiftRight':
                            this.toggleInversionBubble();
                            return;
                        case 'Space':
                            this.launchPulse();
                            return;
                        default:
                            break;
                    }

                    const digitMatch = e.code && (e.code.match(/^Digit([1-6])$/) || e.code.match(/^Numpad([1-6])$/));
                    if (digitMatch) {
                        this.selectGateByNumber(Number(digitMatch[1]));
                    }
                },

                formatTime: function(sec) {
                    const m = Math.floor(sec / 60);
                    const s = sec % 60;
                    return m + 'м ' + String(s).padStart(2, '0') + 'с';
                }
            }
        });

        appInstance = app.mount('#arcade-app');

        // Отладочный и регрессионный хук E2E (не используется в тестах персон Black-Box)
        window.__DEV_LEVEL3_STATE__ = {
            get waves() {
                return appInstance ? appInstance.activeWaves : [];
            },
            get currentWaveIndex() {
                return appInstance ? appInstance.currentWave - 1 : 0;
            },
            get currentWave() {
                return appInstance ? appInstance.currentWaveData : null;
            },
            solveCurrentWave: function() {
                if (!appInstance || appInstance.gameState !== 'playing' || appInstance.alarmActive || appInstance.isActionBlocked || appInstance.afkPaused) {
                    return false;
                }
                const w = appInstance.currentWaveData;
                w.gates.forEach(function(g) {
                    appInstance.gateStates[g.id] = opToState(g.arity, w.solutionOps[g.id]);
                });
                appInstance.launchPulse();
                return true;
            },
            submitAction: function(action) {
                if (!appInstance) return false;
                if (action === 'solve') {
                    return this.solveCurrentWave();
                }
                if (action === 'wrong') {
                    if (appInstance.gameState !== 'playing' || appInstance.alarmActive || appInstance.isActionBlocked) return false;
                    const w = appInstance.currentWaveData;
                    const g1 = w.gates[0];
                    const sol = w.solutionOps[g1.id];
                    const wrongOp = g1.arity === 1 ? (sol === 'NOT' ? 'BUF' : 'NOT') : pickDifferentOp(sol, BINARY_OPS);
                    appInstance.gateStates[g1.id] = opToState(g1.arity, wrongOp);
                    appInstance.launchPulse();
                    return true;
                }
                if (action === 'timeout') {
                    appInstance.triggerHardcoreReset('Тайм-аут фронта импульса (тест)', true);
                    return true;
                }
                return false;
            }
        };
    })();
    </script>
</TaskLayout>
