---
import TaskLayout from '../../../../layouts/TaskLayout.astro';
---

<TaskLayout level={1} title="Урок 11 :: Логические элементы (Уровень 1)">
    <div class="container-fluid px-2 px-md-3 my-3 font-monospace">
        <!-- Шапка тренажера -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h4 text-success mb-0">Тренажер: Логические элементы (Уровень 1)</h2>
            <span class="badge border border-success text-success bg-dark rounded-0 px-3 py-2">Манипуляция мышью // Zero Multiple Choice</span>
        </div>

        <div id="game-container" class="card bg-dark border-success rounded-0">
            <div class="card-body p-3 p-md-4">

                <!-- Заголовок фазы и телеметрия -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 border-bottom border-secondary pb-2">
                    <div>
                        <span id="phase-badge" class="badge bg-success text-dark rounded-0 fs-6 me-2">Шаг 1 из 3</span>
                        <span id="phase-title" class="text-light fw-bold fs-6">Стендовая установка базовых вентилей ГОСТ (Slot &amp; Snap)</span>
                    </div>
                    <div class="text-secondary small">
                        Ошибки: <span id="attempts-display" class="text-warning">0</span> | Время: <span id="timer-display" class="text-info">00:00</span>
                    </div>
                </div>

                <!-- Системный баннер ошибки -->
                <div id="feedback-box" class="alert alert-danger bg-black text-danger border border-danger rounded-0 d-none mb-3 py-2" role="alert">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <span>[СИСТЕМНЫЙ СБОЙ] <span id="feedback-text">Неверная конфигурация!</span> Перегенерация варианта...</span>
                        <span class="spinner-border spinner-border-sm text-danger flex-shrink-0" role="status"></span>
                    </div>
                </div>

                <!-- ==================== ФАЗА 1: SLOT & SNAP (БАЗОВЫЕ ВЕНТИЛИ ГОСТ) ==================== -->
                <div id="phase1" class="phase-container">
                    <p class="text-light mb-2">
                        Определите неизвестные элементы на трёх испытательных стендах по их контрольным сигналам.
                        Перетащите мышью нужные вентили ГОСТ 2.743-91 в слоты стендов (или кликните по вентилю и затем по слоту).
                    </p>
                    <div class="text-warning small mb-3">
                        Внимание: в палитре присутствует лишний комбинированный вентиль-дистрактор! Клик по заполненному слоту возвращает элемент в палитру.
                    </div>

                    <!-- Испытательные стенды -->
                    <div id="p1-stands-row" class="row g-2 g-md-3 mb-3">
                        <!-- Генерируется JS -->
                    </div>

                    <!-- Палитра элементов -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 border-bottom border-secondary pb-2">
                            <span class="text-secondary small text-uppercase">Палитра логических вентилей (ГОСТ 2.743-91):</span>
                            <button id="p1-reset-btn" type="button" class="btn btn-outline-secondary btn-sm rounded-0 px-3" style="min-width: 48px; min-height: 48px;">
                                Сбросить стенды
                            </button>
                        </div>
                        <div id="p1-palette" class="d-flex flex-wrap justify-content-center gap-2 gap-sm-3 pt-1">
                            <!-- Токены генерируются JS -->
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span id="p1-counter" class="text-secondary small">Заполнено стендов: 0 / 3</span>
                        <button id="p1-submit-btn" type="button" class="btn btn-success rounded-0 fw-bold px-4 py-2" style="min-width: 48px; min-height: 48px;" disabled>
                            Проверить стенды &rarr;
                        </button>
                    </div>
                </div>

                <!-- ==================== ФАЗА 2: ТРАССИРОВКА СИГНАЛОВ НА СХЕМЕ ==================== -->
                <div id="phase2" class="phase-container d-none">
                    <p class="text-light mb-2">
                        Проанализируйте двухкаскадную схему слева направо и выставьте значения контрольных щупов
                        <strong class="text-info">F<sub>1</sub></strong>, <strong class="text-info">F<sub>2</sub></strong> и итогового выхода <strong class="text-success">F</strong> для обоих наборов входных сигналов.
                    </p>
                    <div class="text-warning small mb-3">
                        Кликайте непосредственно по кнопкам щупов для переключения состояния (<span class="text-secondary">?</span> &rarr; <span class="text-light">0</span> &rarr; <span class="text-success">1</span>). Узел <strong>●</strong> означает соединение шин.
                    </div>

                    <!-- SVG схема (Data Source) -->
                    <div class="card bg-black border-secondary rounded-0 p-2 p-sm-3 mb-3">
                        <div class="text-secondary small text-uppercase mb-1">Принципиальная схема устройства (ГОСТ 2.743-91):</div>
                        <div id="p2-circuit-wrap" class="w-100 d-flex justify-content-center">
                            <!-- SVG генерируется JS -->
                        </div>
                    </div>

                    <!-- Панель щупов -->
                    <div class="card bg-black border-secondary rounded-0 p-3 mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 border-bottom border-secondary pb-2">
                            <span class="text-secondary small text-uppercase">Измерительные щупы (два контрольных набора):</span>
                            <button id="p2-reset-btn" type="button" class="btn btn-outline-secondary btn-sm rounded-0 px-3" style="min-width: 48px; min-height: 48px;">
                                Сбросить щупы
                            </button>
                        </div>
                        <div id="p2-probes-list" class="d-flex flex-column gap-2 pt-1">
                            <!-- Строки щупов генерируются JS -->
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span id="p2-counter" class="text-secondary small">Выставлено щупов: 0 / 6</span>
                        <button id="p2-submit-btn" type="button" class="btn btn-success rounded-0 fw-bold px-4 py-2" style="min-width: 48px; min-height: 48px;" disabled>
                            Зафиксировать сигналы &rarr;
                        </button>
                    </div>
                </div>

                <!-- ==================== ФАЗА 3: КОММУТАЦИЯ ЛОГИЧЕСКОЙ СХЕМЫ (WIRE PATCHING) ==================== -->
                <div id="phase3" class="phase-container d-none">
                    <p class="text-light mb-2">
                        Соберите логическую схему для целевой функции:
                        <strong id="p3-formula-display" class="text-success fs-5 ms-1"></strong>
                    </p>
                    <div class="text-warning small mb-3">
                        Соединяйте выходы (справа от шин/вентилей) со входами (слева от вентилей) перетаскиванием или двумя кликами.
                        Лишнюю шину и незадействованный вентиль оставьте неподключёнными. Клик по подключённому входу снимает провод.
                    </div>

                    <div class="card bg-black border-secondary rounded-0 p-2 p-sm-3 mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 border-bottom border-secondary pb-2">
                            <span class="text-secondary small text-uppercase">Коммутационная доска (Шины &rarr; Каскад 1 &rarr; Выход F):</span>
                            <button id="p3-reset-btn" type="button" class="btn btn-outline-secondary btn-sm rounded-0 px-3" style="min-width: 48px; min-height: 48px;">
                                Снять все провода
                            </button>
                        </div>

                        <div id="p3-board" class="position-relative p-2 bg-dark border border-secondary rounded-0">
                            <svg id="p3-wires-svg" class="position-absolute top-0 start-0 w-100 h-100" style="pointer-events: none; z-index: 1;"></svg>

                            <div class="d-flex justify-content-between align-items-center gap-2 gap-sm-3 position-relative" style="z-index: 2;">
                                <!-- Колонка 1: Входные шины -->
                                <div class="d-flex flex-column gap-2 align-items-stretch" style="min-width: 68px;">
                                    <div class="text-secondary text-center small mb-1">Шины</div>
                                    <button type="button" class="btn btn-outline-info rounded-0 fw-bold p3-out-port d-flex align-items-center justify-content-between px-2" data-out-port="A" draggable="true" style="min-width: 60px; min-height: 48px;">
                                        <span>A</span><span class="text-info">&bull;</span>
                                    </button>
                                    <button type="button" class="btn btn-outline-info rounded-0 fw-bold p3-out-port d-flex align-items-center justify-content-between px-2" data-out-port="B" draggable="true" style="min-width: 60px; min-height: 48px;">
                                        <span>B</span><span class="text-info">&bull;</span>
                                    </button>
                                    <button type="button" class="btn btn-outline-info rounded-0 fw-bold p3-out-port d-flex align-items-center justify-content-between px-2" data-out-port="C" draggable="true" style="min-width: 60px; min-height: 48px;">
                                        <span>C</span><span class="text-info">&bull;</span>
                                    </button>
                                    <button type="button" class="btn btn-outline-info rounded-0 fw-bold p3-out-port d-flex align-items-center justify-content-between px-2" data-out-port="D" draggable="true" style="min-width: 60px; min-height: 48px;">
                                        <span>D</span><span class="text-info">&bull;</span>
                                    </button>
                                </div>

                                <!-- Колонка 2: Каскад 1 -->
                                <div class="d-flex flex-column gap-2 align-items-stretch flex-grow-1" style="max-width: 240px;">
                                    <div class="text-secondary text-center small mb-1">Каскад 1</div>

                                    <!-- Вентиль И (&) -->
                                    <div class="border border-secondary bg-black p-2 d-flex align-items-center justify-content-between gap-1">
                                        <div class="d-flex flex-column gap-1">
                                            <button type="button" class="btn btn-outline-secondary rounded-0 p-1 p3-in-port small" data-in-port="g_and_in1" style="min-width: 52px; min-height: 48px;">IN1</button>
                                            <button type="button" class="btn btn-outline-secondary rounded-0 p-1 p3-in-port small" data-in-port="g_and_in2" style="min-width: 52px; min-height: 48px;">IN2</button>
                                        </div>
                                        <div class="text-center px-1">
                                            <div class="border border-success text-success fw-bold px-2 py-1">&amp;</div>
                                            <div class="text-secondary" style="font-size: 0.7rem;">И</div>
                                        </div>
                                        <button type="button" class="btn btn-outline-success rounded-0 p-1 p3-out-port small fw-bold" data-out-port="g_and_out" draggable="true" style="min-width: 52px; min-height: 48px;">OUT</button>
                                    </div>

                                    <!-- Вентиль ИЛИ (1) -->
                                    <div class="border border-secondary bg-black p-2 d-flex align-items-center justify-content-between gap-1">
                                        <div class="d-flex flex-column gap-1">
                                            <button type="button" class="btn btn-outline-secondary rounded-0 p-1 p3-in-port small" data-in-port="g_or_in1" style="min-width: 52px; min-height: 48px;">IN1</button>
                                            <button type="button" class="btn btn-outline-secondary rounded-0 p-1 p3-in-port small" data-in-port="g_or_in2" style="min-width: 52px; min-height: 48px;">IN2</button>
                                        </div>
                                        <div class="text-center px-1">
                                            <div class="border border-success text-success fw-bold px-2 py-1">1</div>
                                            <div class="text-secondary" style="font-size: 0.7rem;">ИЛИ</div>
                                        </div>
                                        <button type="button" class="btn btn-outline-success rounded-0 p-1 p3-out-port small fw-bold" data-out-port="g_or_out" draggable="true" style="min-width: 52px; min-height: 48px;">OUT</button>
                                    </div>

                                    <!-- Вентиль НЕ (1○) -->
                                    <div class="border border-secondary bg-black p-2 d-flex align-items-center justify-content-between gap-1">
                                        <button type="button" class="btn btn-outline-secondary rounded-0 p-1 p3-in-port small" data-in-port="g_not_in1" style="min-width: 52px; min-height: 48px;">IN</button>
                                        <div class="text-center px-1">
                                            <div class="border border-warning text-warning fw-bold px-2 py-1">1○</div>
                                            <div class="text-secondary" style="font-size: 0.7rem;">НЕ</div>
                                        </div>
                                        <button type="button" class="btn btn-outline-success rounded-0 p-1 p3-out-port small fw-bold" data-out-port="g_not_out" draggable="true" style="min-width: 52px; min-height: 48px;">OUT</button>
                                    </div>
                                </div>

                                <!-- Колонка 3: Выходной каскад -->
                                <div class="d-flex flex-column gap-2 align-items-stretch" style="min-width: 145px;">
                                    <div class="text-secondary text-center small mb-1">Каскад 2</div>
                                    <div class="border border-success bg-black p-2 d-flex align-items-center justify-content-between gap-2">
                                        <div class="d-flex flex-column gap-2">
                                            <button type="button" class="btn btn-outline-secondary rounded-0 p-1 p3-in-port small" data-in-port="g_out_in1" style="min-width: 54px; min-height: 48px;">IN1</button>
                                            <button type="button" class="btn btn-outline-secondary rounded-0 p-1 p3-in-port small" data-in-port="g_out_in2" style="min-width: 54px; min-height: 48px;">IN2</button>
                                        </div>
                                        <div class="text-center">
                                            <div id="p3-out-gate-symbol" class="border border-success text-success fw-bold px-2 py-2 fs-5">&amp;</div>
                                            <div id="p3-out-gate-label" class="text-secondary mt-1" style="font-size: 0.7rem;">И &rarr; F</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span id="p3-counter" class="text-secondary small">Подключено проводов: 0 | Выходной каскад: 0 / 2</span>
                        <button id="p3-submit-btn" type="button" class="btn btn-success rounded-0 fw-bold px-4 py-2" style="min-width: 48px; min-height: 48px;" disabled>
                            Подать питание и проверить &rarr;
                        </button>
                    </div>
                </div>

                <!-- ==================== ЭКРАН ПОБЕДЫ ==================== -->
                <div id="victory-screen" class="d-none text-center py-4">
                    <div class="border border-success bg-black p-4 mb-3">
                        <h3 class="text-success mb-2">[ УРОВЕНЬ 1 ПРОЙДЕН ]</h3>
                        <p class="text-light mb-3">Все 3 фазы манипулятивного моделирования логических вентилей и схем успешно выполнены.</p>
                        <div class="d-flex justify-content-center gap-4 text-secondary small">
                            <span>Ошибок: <strong id="final-attempts" class="text-warning">0</strong></span>
                            <span>Время: <strong id="final-time" class="text-info">00:00</strong></span>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0">Переключайтесь на вкладку «Уровень 2» для аналитических расчетов с ручным вводом.</p>
                </div>

            </div>
        </div>
    </div>

    <script is:inline>
    (function() {
        const SVG_NS = 'http://www.w3.org/2000/svg';
        const WIRE_COLORS = ['#198754', '#0dcaf0', '#ffc107', '#20c997', '#6ea8fe', '#fd7e14'];

        let currentPhase = 1;
        let isProcessingError = false;
        let timerInterval = null;

        const telemetry = window.LMSTelemetry.create({
            missionName: 'Урок 11 :: Логические элементы (Уровень 1)',
            level: 1,
            totalStages: 3
        });

        const attemptsDisplay = document.getElementById('attempts-display');
        const timerDisplay = document.getElementById('timer-display');
        const phaseBadge = document.getElementById('phase-badge');
        const phaseTitle = document.getElementById('phase-title');
        const feedbackBox = document.getElementById('feedback-box');
        const feedbackText = document.getElementById('feedback-text');

        function randInt(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function pickRandom(arr) {
            return arr[Math.floor(Math.random() * arr.length)];
        }

        function shuffle(arr) {
            const copy = arr.slice();
            for (let i = copy.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                const tmp = copy[i];
                copy[i] = copy[j];
                copy[j] = tmp;
            }
            return copy;
        }

        function formatTime(sec) {
            const m = String(Math.floor(sec / 60)).padStart(2, '0');
            const s = String(sec % 60).padStart(2, '0');
            return `${m}:${s}`;
        }

        function updateTimerDisplay() {
            if (timerDisplay) {
                timerDisplay.textContent = formatTime(telemetry.getTimeSpentSec());
            }
        }

        function createEl(tag, className, text) {
            const el = document.createElement(tag);
            if (className) el.className = className;
            if (text !== undefined) el.textContent = text;
            return el;
        }

        function svgEl(tag, attrs) {
            const el = document.createElementNS(SVG_NS, tag);
            if (attrs) {
                for (const [k, v] of Object.entries(attrs)) {
                    el.setAttribute(k, String(v));
                }
            }
            return el;
        }

        function evalGate(type, a, b) {
            if (type === 'NOT') return a ? 0 : 1;
            if (type === 'AND') return (a && b) ? 1 : 0;
            if (type === 'OR') return (a || b) ? 1 : 0;
            if (type === 'NAND') return (a && b) ? 0 : 1;
            if (type === 'NOR') return (a || b) ? 0 : 1;
            return 0;
        }

        function triggerFailure(message, resetCallback) {
            if (isProcessingError) return;
            isProcessingError = true;
            telemetry.fail({ stage: currentPhase, total_stages: 3 });
            if (attemptsDisplay) {
                attemptsDisplay.textContent = String(telemetry.getState().attemptsCount);
            }
            if (feedbackText) feedbackText.textContent = message;
            if (feedbackBox) feedbackBox.classList.remove('d-none');

            setTimeout(() => {
                if (feedbackBox) feedbackBox.classList.add('d-none');
                isProcessingError = false;
                resetCallback();
            }, 1250);
        }

        function switchToPhase(nextPhase) {
            document.getElementById(`phase${currentPhase}`).classList.add('d-none');
            currentPhase = nextPhase;
            if (nextPhase <= 3) {
                telemetry.advanceStage(nextPhase);
                document.getElementById(`phase${nextPhase}`).classList.remove('d-none');
                phaseBadge.textContent = `Шаг ${nextPhase} из 3`;
                if (nextPhase === 2) {
                    phaseTitle.textContent = 'Трассировка сигналов на схеме (Direct Manipulation)';
                    generatePhase2();
                } else if (nextPhase === 3) {
                    phaseTitle.textContent = 'Коммутация логической схемы по формуле (Wire Patching)';
                    generatePhase3();
                }
            }
        }

        function showVictory() {
            document.getElementById('phase3').classList.add('d-none');
            if (timerInterval) clearInterval(timerInterval);
            telemetry.complete({ stage: 3, total_stages: 3 });
            document.getElementById('final-attempts').textContent = String(telemetry.getState().attemptsCount);
            document.getElementById('final-time').textContent = formatTime(telemetry.getTimeSpentSec());
            document.getElementById('victory-screen').classList.remove('d-none');
            phaseBadge.textContent = 'Завершено';
            phaseTitle.textContent = 'Все 3 фазы выполнены';
        }

        /* =========================================================================
           ОБЩИЙ РЕНДЕР МИНИ-ВЕНТИЛЯ ГОСТ 2.743-91 ДЛЯ ПАЛИТРЫ И СЛОТОВ
           ========================================================================= */
        const GATE_META = {
            NOT: { type: 'NOT', label: 'Инвертор (НЕ)', inputs: 1, symbol: '1', inverted: true },
            AND: { type: 'AND', label: 'Конъюнктор (И)', inputs: 2, symbol: '&', inverted: false },
            OR: { type: 'OR', label: 'Дизъюнктор (ИЛИ)', inputs: 2, symbol: '1', inverted: false },
            NAND: { type: 'NAND', label: 'И-НЕ (NAND)', inputs: 2, symbol: '&', inverted: true },
            NOR: { type: 'NOR', label: 'ИЛИ-НЕ (NOR)', inputs: 2, symbol: '1', inverted: true }
        };

        function createMiniGateSvg(gateType) {
            const meta = GATE_META[gateType];
            const svg = svgEl('svg', { viewBox: '0 0 84 44', width: '76', height: '40' });
            const stroke = meta.inverted ? '#ffc107' : '#198754';

            if (meta.inputs === 1) {
                svg.appendChild(svgEl('line', { x1: 4, y1: 22, x2: 24, y2: 22, stroke: '#adb5bd', 'stroke-width': 2 }));
            } else {
                svg.appendChild(svgEl('line', { x1: 4, y1: 14, x2: 24, y2: 14, stroke: '#adb5bd', 'stroke-width': 2 }));
                svg.appendChild(svgEl('line', { x1: 4, y1: 30, x2: 24, y2: 30, stroke: '#adb5bd', 'stroke-width': 2 }));
            }

            svg.appendChild(svgEl('rect', {
                x: 24, y: 4, width: 30, height: 36,
                fill: '#0b0e11', stroke: stroke, 'stroke-width': 2
            }));

            const txt = svgEl('text', {
                x: 39, y: 27,
                fill: '#f8f9fa', 'font-size': '16', 'font-weight': 'bold',
                'text-anchor': 'middle', 'font-family': 'monospace'
            });
            txt.textContent = meta.symbol;
            svg.appendChild(txt);

            if (meta.inverted) {
                svg.appendChild(svgEl('circle', {
                    cx: 59, cy: 22, r: 4.5,
                    fill: '#0b0e11', stroke: stroke, 'stroke-width': 2
                }));
                svg.appendChild(svgEl('line', { x1: 64, y1: 22, x2: 80, y2: 22, stroke: '#adb5bd', 'stroke-width': 2 }));
            } else {
                svg.appendChild(svgEl('line', { x1: 54, y1: 22, x2: 80, y2: 22, stroke: '#adb5bd', 'stroke-width': 2 }));
            }

            return svg;
        }

        /* =========================================================================
           ФАЗА 1: SLOT & SNAP (СТЕНДОВАЯ УСТАНОВКА БАЗОВЫХ ВЕНТИЛЕЙ)
           ========================================================================= */
        const p1State = {
            stands: [],        // [{ id, expectedType, inputsCount, tests: [...] }]
            tokens: [],        // [{ id, type }]
            slots: [null, null, null], // tokenId | null
            selectedTokenId: null,
            dragTokenId: null,
            prevKey: ''
        };

        const p1StandsRow = document.getElementById('p1-stands-row');
        const p1Palette = document.getElementById('p1-palette');
        const p1Counter = document.getElementById('p1-counter');
        const p1ResetBtn = document.getElementById('p1-reset-btn');
        const p1SubmitBtn = document.getElementById('p1-submit-btn');

        function buildStandTests(type) {
            if (type === 'NOT') {
                return shuffle([
                    { text: 'A = 0  →  F = 1' },
                    { text: 'A = 1  →  F = 0' }
                ]);
            }
            if (type === 'AND') {
                const zeroSample = Math.random() < 0.5 ? 'A = 0, B = 1  →  F = 0' : 'A = 1, B = 0  →  F = 0';
                return shuffle([
                    { text: 'A = 1, B = 1  →  F = 1' },
                    { text: zeroSample }
                ]);
            }
            // OR
            const oneSample = Math.random() < 0.5 ? 'A = 0, B = 1  →  F = 1' : 'A = 1, B = 0  →  F = 1';
            return shuffle([
                { text: 'A = 0, B = 0  →  F = 0' },
                { text: oneSample }
            ]);
        }

        function generatePhase1() {
            let order;
            let distractor;
            let key;
            do {
                order = shuffle(['NOT', 'AND', 'OR']);
                distractor = Math.random() < 0.5 ? 'NAND' : 'NOR';
                key = `${order.join('-')}:${distractor}`;
            } while (key === p1State.prevKey);

            p1State.prevKey = key;
            p1State.stands = order.map((type, idx) => ({
                idx,
                expectedType: type,
                inputsCount: GATE_META[type].inputs,
                tests: buildStandTests(type)
            }));

            const tokenTypes = shuffle(['NOT', 'AND', 'OR', distractor]);
            p1State.tokens = tokenTypes.map((type, idx) => ({
                id: `p1_tok_${idx}`,
                type
            }));

            p1State.slots = [null, null, null];
            p1State.selectedTokenId = null;
            p1State.dragTokenId = null;
            renderPhase1();
        }

        function getP1UsedTokenIds() {
            return new Set(p1State.slots.filter(Boolean));
        }

        function getTokenById(id) {
            return p1State.tokens.find((t) => t.id === id) || null;
        }

        function renderPhase1() {
            const usedIds = getP1UsedTokenIds();
            p1StandsRow.innerHTML = '';

            p1State.stands.forEach((stand) => {
                const col = createEl('div', 'col-12 col-sm-4');
                const card = createEl('div', 'border border-secondary bg-black p-2 p-sm-3 h-100 d-flex flex-column justify-content-between gap-2');

                const header = createEl('div', 'd-flex justify-content-between align-items-center border-bottom border-secondary pb-1');
                header.appendChild(createEl('span', 'text-success fw-bold small', `Стенд #${stand.idx + 1}`));
                header.appendChild(createEl('span', 'badge border border-secondary text-secondary rounded-0', stand.inputsCount === 1 ? '1 вход' : '2 входа'));
                card.appendChild(header);

                // Схема включения слота: входы -> [слот] -> F
                const schematicRow = createEl('div', 'd-flex align-items-center justify-content-center gap-1 my-1');
                const inLabels = createEl('div', 'd-flex flex-column justify-content-center align-items-end text-info small fw-bold');
                if (stand.inputsCount === 1) {
                    inLabels.appendChild(createEl('span', '', 'A ─'));
                } else {
                    inLabels.appendChild(createEl('span', '', 'A ─'));
                    inLabels.appendChild(createEl('span', '', 'B ─'));
                }
                schematicRow.appendChild(inLabels);

                const placedTokenId = p1State.slots[stand.idx];
                const placedToken = placedTokenId ? getTokenById(placedTokenId) : null;

                const slotBtn = createEl(
                    'button',
                    `btn rounded-0 p-1 d-flex flex-column align-items-center justify-content-center p1-slot-btn ${
                        placedToken ? 'btn-outline-success bg-dark' : 'btn-outline-secondary bg-black'
                    }`
                );
                slotBtn.type = 'button';
                slotBtn.dataset.slotIdx = String(stand.idx);
                slotBtn.style.minWidth = '112px';
                slotBtn.style.minHeight = '64px';
                slotBtn.style.borderStyle = placedToken ? 'solid' : 'dashed';

                if (placedToken) {
                    slotBtn.appendChild(createMiniGateSvg(placedToken.type));
                    slotBtn.appendChild(createEl('span', 'text-light fw-bold', GATE_META[placedToken.type].label));
                    slotBtn.lastChild.style.fontSize = '0.72rem';
                } else {
                    slotBtn.appendChild(createEl('span', 'text-secondary small', '[ Вставить ]'));
                }
                schematicRow.appendChild(slotBtn);

                schematicRow.appendChild(createEl('span', 'text-success small fw-bold', '─ F'));
                card.appendChild(schematicRow);

                // Решающие тесты стенда
                const testsBox = createEl('div', 'border-top border-secondary pt-2');
                testsBox.appendChild(createEl('div', 'text-secondary mb-1', 'Контрольные замеры:'));
                testsBox.lastChild.style.fontSize = '0.72rem';
                stand.tests.forEach((t) => {
                    const line = createEl('div', 'bg-dark border border-secondary px-2 py-1 mb-1 text-light small text-center', t.text);
                    testsBox.appendChild(line);
                });
                card.appendChild(testsBox);

                col.appendChild(card);
                p1StandsRow.appendChild(col);
            });

            // Палитра токенов
            p1Palette.innerHTML = '';
            p1State.tokens.forEach((tok) => {
                if (usedIds.has(tok.id)) return;
                const isSelected = p1State.selectedTokenId === tok.id;
                const btn = createEl(
                    'button',
                    `btn rounded-0 p-2 d-flex flex-column align-items-center justify-content-center gap-1 p1-token-btn ${
                        isSelected ? 'btn-success text-dark border-light' : 'btn-outline-success bg-dark text-light'
                    }`
                );
                btn.type = 'button';
                btn.draggable = true;
                btn.dataset.tokenId = tok.id;
                btn.style.minWidth = '132px';
                btn.style.minHeight = '68px';
                btn.appendChild(createMiniGateSvg(tok.type));
                const lbl = createEl('span', `fw-bold ${isSelected ? 'text-dark' : 'text-light'}`, GATE_META[tok.type].label);
                lbl.style.fontSize = '0.78rem';
                btn.appendChild(lbl);
                p1Palette.appendChild(btn);
            });

            const filledCount = p1State.slots.filter(Boolean).length;
            p1Counter.textContent = `Заполнено стендов: ${filledCount} / 3`;
            p1SubmitBtn.disabled = filledCount < 3;
        }

        /* =========================================================================
           ФАЗА 2: ТРАССИРОВКА СИГНАЛОВ НА 2-КАСКАДНОЙ СХЕМЕ
           ========================================================================= */
        const p2State = {
            schema: null,      // { template, g1, g2, g3 }
            cases: [],         // [{ a, b, c, expF1, expF2, expF, uF1, uF2, uF }]
            prevKey: ''
        };

        const p2CircuitWrap = document.getElementById('p2-circuit-wrap');
        const p2ProbesList = document.getElementById('p2-probes-list');
        const p2Counter = document.getElementById('p2-counter');
        const p2ResetBtn = document.getElementById('p2-reset-btn');
        const p2SubmitBtn = document.getElementById('p2-submit-btn');

        function evalPhase2Schema(schema, a, b, c) {
            let f1 = 0;
            let f2 = 0;
            if (schema.template === 'splitB') {
                f1 = evalGate(schema.g1, a, b);
                f2 = evalGate(schema.g2, b, c);
            } else if (schema.template === 'notC') {
                f1 = evalGate(schema.g1, a, b);
                f2 = evalGate('NOT', c, 0);
            } else {
                // notA
                f1 = evalGate('NOT', a, 0);
                f2 = evalGate(schema.g2, b, c);
            }
            const f = evalGate(schema.g3, f1, f2);
            return { f1, f2, f };
        }

        function drawGostGateOnSvg(svg, x, y, w, h, gateType) {
            const meta = GATE_META[gateType];
            const stroke = meta.inverted ? '#ffc107' : '#198754';
            svg.appendChild(svgEl('rect', {
                x, y, width: w, height: h,
                fill: '#101418', stroke, 'stroke-width': 2
            }));
            const txt = svgEl('text', {
                x: x + w / 2, y: y + h / 2 + 7,
                fill: '#f8f9fa', 'font-size': '20', 'font-weight': 'bold',
                'text-anchor': 'middle', 'font-family': 'monospace'
            });
            txt.textContent = meta.symbol;
            svg.appendChild(txt);
            if (meta.inverted) {
                svg.appendChild(svgEl('circle', {
                    cx: x + w + 6, cy: y + h / 2, r: 5.5,
                    fill: '#101418', stroke, 'stroke-width': 2
                }));
            }
        }

        function renderPhase2Svg(schema) {
            p2CircuitWrap.innerHTML = '';
            const svg = svgEl('svg', { viewBox: '0 0 560 210', class: 'w-100' });
            svg.style.maxHeight = '220px';

            const lineColor = '#adb5bd';
            const labelAttrs = { fill: '#0dcaf0', 'font-size': '16', 'font-weight': 'bold', 'font-family': 'monospace' };

            // Входы и провода до каскада 1 (x=140)
            if (schema.template === 'splitB') {
                // A -> G1 top (y=42), B -> split at x=90 -> G1 bot (y=76) & G2 top (y=134), C -> G2 bot (y=168)
                const lblA = svgEl('text', { ...labelAttrs, x: 18, y: 47 }); lblA.textContent = 'A'; svg.appendChild(lblA);
                const lblB = svgEl('text', { ...labelAttrs, x: 18, y: 110 }); lblB.textContent = 'B'; svg.appendChild(lblB);
                const lblC = svgEl('text', { ...labelAttrs, x: 18, y: 173 }); lblC.textContent = 'C'; svg.appendChild(lblC);

                svg.appendChild(svgEl('line', { x1: 38, y1: 42, x2: 140, y2: 42, stroke: lineColor, 'stroke-width': 2 }));
                svg.appendChild(svgEl('line', { x1: 38, y1: 105, x2: 90, y2: 105, stroke: lineColor, 'stroke-width': 2 }));
                svg.appendChild(svgEl('circle', { cx: 90, cy: 105, r: 4.5, fill: '#0dcaf0' }));
                svg.appendChild(svgEl('polyline', { points: '90,105 90,76 140,76', fill: 'none', stroke: lineColor, 'stroke-width': 2 }));
                svg.appendChild(svgEl('polyline', { points: '90,105 90,134 140,134', fill: 'none', stroke: lineColor, 'stroke-width': 2 }));
                svg.appendChild(svgEl('line', { x1: 38, y1: 168, x2: 140, y2: 168, stroke: lineColor, 'stroke-width': 2 }));
            } else if (schema.template === 'notC') {
                // A -> G1 top (42), B -> G1 bot (76), C -> G2 center (151)
                const lblA = svgEl('text', { ...labelAttrs, x: 18, y: 47 }); lblA.textContent = 'A'; svg.appendChild(lblA);
                const lblB = svgEl('text', { ...labelAttrs, x: 18, y: 81 }); lblB.textContent = 'B'; svg.appendChild(lblB);
                const lblC = svgEl('text', { ...labelAttrs, x: 18, y: 156 }); lblC.textContent = 'C'; svg.appendChild(lblC);

                svg.appendChild(svgEl('line', { x1: 38, y1: 42, x2: 140, y2: 42, stroke: lineColor, 'stroke-width': 2 }));
                svg.appendChild(svgEl('line', { x1: 38, y1: 76, x2: 140, y2: 76, stroke: lineColor, 'stroke-width': 2 }));
                svg.appendChild(svgEl('line', { x1: 38, y1: 151, x2: 140, y2: 151, stroke: lineColor, 'stroke-width': 2 }));
            } else {
                // notA: A -> G1 center (59), B -> G2 top (134), C -> G2 bot (168)
                const lblA = svgEl('text', { ...labelAttrs, x: 18, y: 64 }); lblA.textContent = 'A'; svg.appendChild(lblA);
                const lblB = svgEl('text', { ...labelAttrs, x: 18, y: 139 }); lblB.textContent = 'B'; svg.appendChild(lblB);
                const lblC = svgEl('text', { ...labelAttrs, x: 18, y: 173 }); lblC.textContent = 'C'; svg.appendChild(lblC);

                svg.appendChild(svgEl('line', { x1: 38, y1: 59, x2: 140, y2: 59, stroke: lineColor, 'stroke-width': 2 }));
                svg.appendChild(svgEl('line', { x1: 38, y1: 134, x2: 140, y2: 134, stroke: lineColor, 'stroke-width': 2 }));
                svg.appendChild(svgEl('line', { x1: 38, y1: 168, x2: 140, y2: 168, stroke: lineColor, 'stroke-width': 2 }));
            }

            // Вентили каскада 1
            drawGostGateOnSvg(svg, 140, 26, 66, 66, schema.g1);
            drawGostGateOnSvg(svg, 140, 118, 66, 66, schema.g2);

            const g1Start = GATE_META[schema.g1].inverted ? 218 : 206;
            const g2Start = GATE_META[schema.g2].inverted ? 218 : 206;

            // Провода от каскада 1 к G3 (x=340, yTop=88, yBot=122)
            svg.appendChild(svgEl('polyline', {
                points: `${g1Start},59 292,59 292,88 340,88`,
                fill: 'none', stroke: lineColor, 'stroke-width': 2
            }));
            svg.appendChild(svgEl('polyline', {
                points: `${g2Start},151 292,151 292,122 340,122`,
                fill: 'none', stroke: lineColor, 'stroke-width': 2
            }));

            // Метки контрольных точек F1, F2
            svg.appendChild(svgEl('circle', { cx: 254, cy: 59, r: 4, fill: '#0dcaf0' }));
            const lblF1 = svgEl('text', { x: 246, y: 47, fill: '#0dcaf0', 'font-size': '15', 'font-weight': 'bold', 'font-family': 'monospace' });
            lblF1.textContent = 'F₁';
            svg.appendChild(lblF1);

            svg.appendChild(svgEl('circle', { cx: 254, cy: 151, r: 4, fill: '#0dcaf0' }));
            const lblF2 = svgEl('text', { x: 246, y: 174, fill: '#0dcaf0', 'font-size': '15', 'font-weight': 'bold', 'font-family': 'monospace' });
            lblF2.textContent = 'F₂';
            svg.appendChild(lblF2);

            // Выходной вентиль G3
            drawGostGateOnSvg(svg, 340, 72, 66, 66, schema.g3);
            svg.appendChild(svgEl('line', { x1: 406, y1: 105, x2: 492, y2: 105, stroke: '#198754', 'stroke-width': 2.5 }));
            svg.appendChild(svgEl('circle', { cx: 455, cy: 105, r: 4.5, fill: '#198754' }));
            const lblF = svgEl('text', { x: 504, y: 111, fill: '#198754', 'font-size': '18', 'font-weight': 'bold', 'font-family': 'monospace' });
            lblF.textContent = 'F';
            svg.appendChild(lblF);

            p2CircuitWrap.appendChild(svg);
        }

        function generatePhase2() {
            const templates = ['splitB', 'notC', 'notA'];
            let schema;
            let key;
            do {
                const tpl = pickRandom(templates);
                if (tpl === 'splitB') {
                    const g1 = Math.random() < 0.5 ? 'AND' : 'OR';
                    const g2 = g1 === 'AND' ? 'OR' : 'AND';
                    const g3 = Math.random() < 0.5 ? 'AND' : 'OR';
                    schema = { template: tpl, g1, g2, g3 };
                } else if (tpl === 'notC') {
                    const g1 = Math.random() < 0.5 ? 'AND' : 'OR';
                    const g3 = Math.random() < 0.5 ? 'AND' : 'OR';
                    if (g1 === 'OR' && g3 === 'AND') continue; // исключаем (A ∨ B) ∧ ¬C из theory.md
                    schema = { template: tpl, g1, g2: 'NOT', g3 };
                } else {
                    const g2 = Math.random() < 0.5 ? 'AND' : 'OR';
                    const g3 = Math.random() < 0.5 ? 'AND' : 'OR';
                    schema = { template: tpl, g1: 'NOT', g2, g3 };
                }
                key = `${schema.template}:${schema.g1}:${schema.g2}:${schema.g3}`;
            } while (!schema || key === p2State.prevKey);

            p2State.prevKey = key;
            p2State.schema = schema;

            // Собираем все 8 наборов и выбираем пару с разным выходом F
            const allVecs = [];
            for (let a = 0; a <= 1; a++) {
                for (let b = 0; b <= 1; b++) {
                    for (let c = 0; c <= 1; c++) {
                        const res = evalPhase2Schema(schema, a, b, c);
                        allVecs.push({ a, b, c, expF1: res.f1, expF2: res.f2, expF: res.f });
                    }
                }
            }
            const ones = shuffle(allVecs.filter((v) => v.expF === 1));
            const zeros = shuffle(allVecs.filter((v) => v.expF === 0));
            const pair = shuffle([ones[0], zeros[0]]);

            p2State.cases = pair.map((v) => ({
                ...v,
                uF1: null,
                uF2: null,
                uF: null
            }));

            renderPhase2Svg(schema);
            renderPhase2Probes();
        }

        function probeBtnClass(val, isFinal) {
            if (val === null) return 'btn-outline-secondary text-secondary bg-dark';
            if (val === 1) return isFinal ? 'btn-success text-dark fw-bold' : 'btn-info text-dark fw-bold';
            return 'btn-outline-light text-light bg-black fw-bold';
        }

        function renderPhase2Probes() {
            p2ProbesList.innerHTML = '';
            let setCount = 0;

            p2State.cases.forEach((cItem, rowIdx) => {
                const row = createEl('div', 'border border-secondary bg-dark p-2 d-flex flex-wrap align-items-center justify-content-between gap-2');

                const inputsWrap = createEl('div', 'd-flex align-items-center gap-2');
                inputsWrap.appendChild(createEl('span', 'text-secondary small fw-bold', `Набор ${rowIdx + 1}:`));
                inputsWrap.appendChild(createEl('span', 'badge border border-info text-info bg-black rounded-0 px-2 py-1', `A = ${cItem.a}`));
                inputsWrap.appendChild(createEl('span', 'badge border border-info text-info bg-black rounded-0 px-2 py-1', `B = ${cItem.b}`));
                inputsWrap.appendChild(createEl('span', 'badge border border-info text-info bg-black rounded-0 px-2 py-1', `C = ${cItem.c}`));
                row.appendChild(inputsWrap);

                const probesWrap = createEl('div', 'd-flex align-items-center gap-2');
                const specs = [
                    { key: 'uF1', label: 'F₁', val: cItem.uF1, isFinal: false },
                    { key: 'uF2', label: 'F₂', val: cItem.uF2, isFinal: false },
                    { key: 'uF', label: 'F', val: cItem.uF, isFinal: true }
                ];

                specs.forEach((sp) => {
                    if (sp.val !== null) setCount++;
                    const btn = createEl('button', `btn rounded-0 px-2 py-1 p2-probe-btn ${probeBtnClass(sp.val, sp.isFinal)}`);
                    btn.type = 'button';
                    btn.dataset.rowIdx = String(rowIdx);
                    btn.dataset.probeKey = sp.key;
                    btn.style.minWidth = '64px';
                    btn.style.minHeight = '48px';
                    btn.textContent = `${sp.label} = ${sp.val === null ? '?' : sp.val}`;
                    probesWrap.appendChild(btn);
                });

                row.appendChild(probesWrap);
                p2ProbesList.appendChild(row);
            });

            p2Counter.textContent = `Выставлено щупов: ${setCount} / 6`;
            p2SubmitBtn.disabled = setCount < 6;
        }

        /* =========================================================================
           ФАЗА 3: КОММУТАЦИЯ ЛОГИЧЕСКОЙ СХЕМЫ (WIRE PATCHING)
           ========================================================================= */
        const ALL_VARS = ['A', 'B', 'C', 'D'];
        const IN_PORTS = ['g_and_in1', 'g_and_in2', 'g_or_in1', 'g_or_in2', 'g_not_in1', 'g_out_in1', 'g_out_in2'];

        const p3State = {
            spec: null,            // { unused, x, y, z, op1, op2, formulaText, targetFn }
            wires: {},             // inPort -> outPort
            selectedOutPort: null,
            dragOutPort: null,
            prevKey: ''
        };

        const p3FormulaDisplay = document.getElementById('p3-formula-display');
        const p3Board = document.getElementById('p3-board');
        const p3WiresSvg = document.getElementById('p3-wires-svg');
        const p3OutGateSymbol = document.getElementById('p3-out-gate-symbol');
        const p3OutGateLabel = document.getElementById('p3-out-gate-label');
        const p3Counter = document.getElementById('p3-counter');
        const p3ResetBtn = document.getElementById('p3-reset-btn');
        const p3SubmitBtn = document.getElementById('p3-submit-btn');

        function opSymbol(op) {
            return op === 'AND' ? '∧' : '∨';
        }

        function generatePhase3() {
            let spec;
            let key;
            do {
                const unused = pickRandom(ALL_VARS);
                const active = ALL_VARS.filter((v) => v !== unused);
                const z = pickRandom(active);
                const pair = active.filter((v) => v !== z).sort();
                const x = pair[0];
                const y = pair[1];
                const op1 = Math.random() < 0.5 ? 'AND' : 'OR';
                const op2 = Math.random() < 0.5 ? 'AND' : 'OR';

                // Исключаем (A ∨ B) ∧ ¬C из theory.md
                if (unused === 'D' && x === 'A' && y === 'B' && z === 'C' && op1 === 'OR' && op2 === 'AND') {
                    continue;
                }

                const swappedOrder = Math.random() < 0.5;
                const innerStr = `(${x} ${opSymbol(op1)} ${y})`;
                const notStr = `¬${z}`;
                const formulaText = swappedOrder
                    ? `F = ${notStr} ${opSymbol(op2)} ${innerStr}`
                    : `F = ${innerStr} ${opSymbol(op2)} ${notStr}`;

                const targetFn = (env) => {
                    const v1 = evalGate(op1, env[x], env[y]);
                    const v2 = evalGate('NOT', env[z], 0);
                    return evalGate(op2, v1, v2);
                };

                spec = { unused, x, y, z, op1, op2, formulaText, targetFn };
                key = `${unused}:${x}:${y}:${z}:${op1}:${op2}`;
            } while (!spec || key === p3State.prevKey);

            p3State.prevKey = key;
            p3State.spec = spec;
            p3State.wires = {};
            p3State.selectedOutPort = null;
            p3State.dragOutPort = null;

            p3FormulaDisplay.textContent = spec.formulaText;
            p3OutGateSymbol.textContent = spec.op2 === 'AND' ? '&' : '1';
            p3OutGateLabel.textContent = spec.op2 === 'AND' ? 'И → F' : 'ИЛИ → F';

            renderPhase3();
        }

        function isValidP3Link(outPort, inPort) {
            if (!outPort || !inPort) return false;
            if (ALL_VARS.includes(outPort)) {
                return IN_PORTS.includes(inPort);
            }
            if (outPort === 'g_and_out' || outPort === 'g_or_out' || outPort === 'g_not_out') {
                return inPort === 'g_out_in1' || inPort === 'g_out_in2';
            }
            return false;
        }

        function renderPhase3() {
            const outPorts = p3Board.querySelectorAll('.p3-out-port');
            const connectedOutSet = new Set(Object.values(p3State.wires));

            outPorts.forEach((btn) => {
                const portId = btn.dataset.outPort;
                const isSelected = p3State.selectedOutPort === portId;
                const isUsed = connectedOutSet.has(portId);
                const isBus = ALL_VARS.includes(portId);

                btn.classList.remove('btn-info', 'btn-outline-info', 'btn-success', 'btn-outline-success', 'btn-warning', 'text-dark', 'border-light');
                if (isSelected) {
                    btn.classList.add('btn-warning', 'text-dark', 'border-light');
                } else if (isUsed) {
                    btn.classList.add(isBus ? 'btn-info' : 'btn-success', 'text-dark');
                } else {
                    btn.classList.add(isBus ? 'btn-outline-info' : 'btn-outline-success');
                }
            });

            const inPorts = p3Board.querySelectorAll('.p3-in-port');
            inPorts.forEach((btn) => {
                const portId = btn.dataset.inPort;
                const src = p3State.wires[portId];
                btn.classList.remove('btn-outline-secondary', 'btn-outline-success', 'btn-success', 'text-dark', 'text-light', 'bg-black');
                if (src) {
                    btn.classList.add('btn-outline-success', 'text-light');
                } else {
                    btn.classList.add('btn-outline-secondary');
                }
            });

            const totalWires = Object.keys(p3State.wires).length;
            const outInReady = (p3State.wires.g_out_in1 ? 1 : 0) + (p3State.wires.g_out_in2 ? 1 : 0);
            p3Counter.textContent = `Подключено проводов: ${totalWires} | Выходной каскад: ${outInReady} / 2`;
            p3SubmitBtn.disabled = outInReady < 2;

            requestAnimationFrame(renderPhase3Wires);
        }

        function renderPhase3Wires() {
            if (currentPhase !== 3) return;
            const boardRect = p3Board.getBoundingClientRect();
            if (boardRect.width === 0 || boardRect.height === 0) return;

            p3WiresSvg.innerHTML = '';
            p3WiresSvg.setAttribute('viewBox', `0 0 ${boardRect.width} ${boardRect.height}`);

            const entries = Object.entries(p3State.wires);
            entries.forEach(([inPortId, outPortId], idx) => {
                const outEl = p3Board.querySelector(`[data-out-port="${outPortId}"]`);
                const inEl = p3Board.querySelector(`[data-in-port="${inPortId}"]`);
                if (!outEl || !inEl) return;

                const oR = outEl.getBoundingClientRect();
                const iR = inEl.getBoundingClientRect();

                const x1 = oR.right - boardRect.left;
                const y1 = oR.top + oR.height / 2 - boardRect.top;
                const x2 = iR.left - boardRect.left;
                const y2 = iR.top + iR.height / 2 - boardRect.top;
                const dx = Math.max(24, Math.abs(x2 - x1) * 0.45);
                const color = WIRE_COLORS[idx % WIRE_COLORS.length];

                p3WiresSvg.appendChild(svgEl('path', {
                    d: `M ${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`,
                    fill: 'none', stroke: color, 'stroke-width': 3, 'stroke-linecap': 'round'
                }));
                p3WiresSvg.appendChild(svgEl('circle', { cx: x1, cy: y1, r: 4, fill: color }));
                p3WiresSvg.appendChild(svgEl('circle', { cx: x2, cy: y2, r: 4, fill: color }));
            });
        }

        function evaluateWiredCircuit() {
            const w = p3State.wires;
            const usedCascadeGates = new Set();

            function resolveOut(portId, env, visited) {
                if (!portId) return { ok: false, reason: 'Не подключен один из входов задействованного вентиля!' };
                if (ALL_VARS.includes(portId)) return { ok: true, val: env[portId] };
                if (visited.has(portId)) return { ok: false, reason: 'Обнаружен недопустимый цикл проводов!' };
                visited.add(portId);

                if (portId === 'g_and_out') {
                    usedCascadeGates.add('AND');
                    const r1 = resolveOut(w.g_and_in1, env, new Set(visited));
                    const r2 = resolveOut(w.g_and_in2, env, new Set(visited));
                    if (!r1.ok) return r1;
                    if (!r2.ok) return r2;
                    return { ok: true, val: evalGate('AND', r1.val, r2.val) };
                }
                if (portId === 'g_or_out') {
                    usedCascadeGates.add('OR');
                    const r1 = resolveOut(w.g_or_in1, env, new Set(visited));
                    const r2 = resolveOut(w.g_or_in2, env, new Set(visited));
                    if (!r1.ok) return r1;
                    if (!r2.ok) return r2;
                    return { ok: true, val: evalGate('OR', r1.val, r2.val) };
                }
                if (portId === 'g_not_out') {
                    usedCascadeGates.add('NOT');
                    const r1 = resolveOut(w.g_not_in1, env, new Set(visited));
                    if (!r1.ok) return r1;
                    return { ok: true, val: evalGate('NOT', r1.val, 0) };
                }
                return { ok: false, reason: 'Неизвестный порт в схеме!' };
            }

            // Проверка 16 наборов (A, B, C, D)
            for (let mask = 0; mask < 16; mask++) {
                const env = {
                    A: (mask >> 3) & 1,
                    B: (mask >> 2) & 1,
                    C: (mask >> 1) & 1,
                    D: mask & 1
                };
                const r1 = resolveOut(w.g_out_in1, env, new Set());
                if (!r1.ok) return { ok: false, reason: r1.reason };
                const r2 = resolveOut(w.g_out_in2, env, new Set());
                if (!r2.ok) return { ok: false, reason: r2.reason };

                const actual = evalGate(p3State.spec.op2, r1.val, r2.val);
                const expected = p3State.spec.targetFn(env);
                if (actual !== expected) {
                    return {
                        ok: false,
                        reason: `Схема выдала ${actual} вместо ${expected} при A=${env.A}, B=${env.B}, C=${env.C}, D=${env.D}!`
                    };
                }
            }

            // Проверка на мусорные провода у незадействованного вентиля-дистрактора
            if (!usedCascadeGates.has('AND') && (w.g_and_in1 || w.g_and_in2)) {
                return { ok: false, reason: 'Уберите лишние провода с незадействованного вентиля И!' };
            }
            if (!usedCascadeGates.has('OR') && (w.g_or_in1 || w.g_or_in2)) {
                return { ok: false, reason: 'Уберите лишние провода с незадействованного вентиля ИЛИ!' };
            }
            if (!usedCascadeGates.has('NOT') && w.g_not_in1) {
                return { ok: false, reason: 'Уберите лишний провод с незадействованного инвертора НЕ!' };
            }

            return { ok: true };
        }

        /* =========================================================================
           ОДНОКРАТНАЯ ПРИВЯЗКА СОБЫТИЙ (ДЕЛЕГИРОВАНИЕ БЕЗ ПОВТОРНЫХ ПОДПИСОК)
           ========================================================================= */
        function bindEventsOnce() {
            // --- Фаза 1: Click + HTML5 Drag-and-Drop ---
            const phase1El = document.getElementById('phase1');

            p1Palette.addEventListener('click', (e) => {
                if (isProcessingError || currentPhase !== 1) return;
                const tokBtn = e.target.closest('.p1-token-btn');
                if (!tokBtn) return;
                const tokId = tokBtn.dataset.tokenId;
                p1State.selectedTokenId = p1State.selectedTokenId === tokId ? null : tokId;
                renderPhase1();
            });

            p1StandsRow.addEventListener('click', (e) => {
                if (isProcessingError || currentPhase !== 1) return;
                const slotBtn = e.target.closest('.p1-slot-btn');
                if (!slotBtn) return;
                const idx = Number(slotBtn.dataset.slotIdx);

                if (p1State.selectedTokenId) {
                    p1State.slots[idx] = p1State.selectedTokenId;
                    p1State.selectedTokenId = null;
                    renderPhase1();
                } else if (p1State.slots[idx]) {
                    p1State.slots[idx] = null;
                    renderPhase1();
                }
            });

            phase1El.addEventListener('dragstart', (e) => {
                const tokBtn = e.target.closest('.p1-token-btn');
                if (!tokBtn || isProcessingError || currentPhase !== 1) return;
                p1State.dragTokenId = tokBtn.dataset.tokenId;
                if (e.dataTransfer) {
                    e.dataTransfer.setData('text/plain', tokBtn.dataset.tokenId);
                    e.dataTransfer.effectAllowed = 'move';
                }
            });

            phase1El.addEventListener('dragover', (e) => {
                if (currentPhase !== 1) return;
                if (e.target.closest('.p1-slot-btn')) {
                    e.preventDefault();
                }
            });

            phase1El.addEventListener('drop', (e) => {
                if (isProcessingError || currentPhase !== 1) return;
                const slotBtn = e.target.closest('.p1-slot-btn');
                const tokId = (e.dataTransfer && e.dataTransfer.getData('text/plain')) || p1State.dragTokenId;
                p1State.dragTokenId = null;
                if (!slotBtn || !tokId) return;
                e.preventDefault();
                const idx = Number(slotBtn.dataset.slotIdx);
                p1State.slots[idx] = tokId;
                p1State.selectedTokenId = null;
                renderPhase1();
            });

            p1ResetBtn.addEventListener('click', () => {
                if (isProcessingError || currentPhase !== 1) return;
                p1State.slots = [null, null, null];
                p1State.selectedTokenId = null;
                renderPhase1();
            });

            p1SubmitBtn.addEventListener('click', () => {
                if (isProcessingError || currentPhase !== 1) return;
                const allOk = p1State.stands.every((stand) => {
                    const tokId = p1State.slots[stand.idx];
                    const tok = tokId ? getTokenById(tokId) : null;
                    return tok && tok.type === stand.expectedType;
                });
                if (allOk) {
                    switchToPhase(2);
                } else {
                    triggerFailure('Один или несколько вентилей на стендах определены неверно! Сверьтесь с замерами.', generatePhase1);
                }
            });

            // --- Фаза 2: Переключение щупов кликом ---
            p2ProbesList.addEventListener('click', (e) => {
                if (isProcessingError || currentPhase !== 2) return;
                const btn = e.target.closest('.p2-probe-btn');
                if (!btn) return;
                const rowIdx = Number(btn.dataset.rowIdx);
                const key = btn.dataset.probeKey;
                const cur = p2State.cases[rowIdx][key];
                p2State.cases[rowIdx][key] = cur === null ? 0 : (cur === 0 ? 1 : 0);
                renderPhase2Probes();
            });

            p2ResetBtn.addEventListener('click', () => {
                if (isProcessingError || currentPhase !== 2) return;
                p2State.cases.forEach((c) => {
                    c.uF1 = null;
                    c.uF2 = null;
                    c.uF = null;
                });
                renderPhase2Probes();
            });

            p2SubmitBtn.addEventListener('click', () => {
                if (isProcessingError || currentPhase !== 2) return;
                const allOk = p2State.cases.every((c) =>
                    c.uF1 === c.expF1 && c.uF2 === c.expF2 && c.uF === c.expF
                );
                if (allOk) {
                    switchToPhase(3);
                } else {
                    triggerFailure('Ошибка трассировки! Проверьте прохождение сигналов слева направо на схеме.', generatePhase2);
                }
            });

            // --- Фаза 3: Wire Patching (Click + HTML5 Drag-and-Drop) ---
            p3Board.addEventListener('click', (e) => {
                if (isProcessingError || currentPhase !== 3) return;
                const outBtn = e.target.closest('.p3-out-port');
                if (outBtn) {
                    const portId = outBtn.dataset.outPort;
                    p3State.selectedOutPort = p3State.selectedOutPort === portId ? null : portId;
                    renderPhase3();
                    return;
                }

                const inBtn = e.target.closest('.p3-in-port');
                if (inBtn) {
                    const inPortId = inBtn.dataset.inPort;
                    if (p3State.selectedOutPort) {
                        if (isValidP3Link(p3State.selectedOutPort, inPortId)) {
                            p3State.wires[inPortId] = p3State.selectedOutPort;
                            p3State.selectedOutPort = null;
                            renderPhase3();
                        }
                    } else if (p3State.wires[inPortId]) {
                        delete p3State.wires[inPortId];
                        renderPhase3();
                    }
                }
            });

            p3Board.addEventListener('dragstart', (e) => {
                const outBtn = e.target.closest('.p3-out-port');
                if (!outBtn || isProcessingError || currentPhase !== 3) return;
                p3State.dragOutPort = outBtn.dataset.outPort;
                if (e.dataTransfer) {
                    e.dataTransfer.setData('text/plain', outBtn.dataset.outPort);
                    e.dataTransfer.effectAllowed = 'link';
                }
            });

            p3Board.addEventListener('dragover', (e) => {
                if (currentPhase !== 3) return;
                if (e.target.closest('.p3-in-port')) {
                    e.preventDefault();
                }
            });

            p3Board.addEventListener('drop', (e) => {
                if (isProcessingError || currentPhase !== 3) return;
                const inBtn = e.target.closest('.p3-in-port');
                const outPortId = (e.dataTransfer && e.dataTransfer.getData('text/plain')) || p3State.dragOutPort;
                p3State.dragOutPort = null;
                if (!inBtn || !outPortId) return;
                e.preventDefault();
                const inPortId = inBtn.dataset.inPort;
                if (isValidP3Link(outPortId, inPortId)) {
                    p3State.wires[inPortId] = outPortId;
                    p3State.selectedOutPort = null;
                    renderPhase3();
                }
            });

            p3ResetBtn.addEventListener('click', () => {
                if (isProcessingError || currentPhase !== 3) return;
                p3State.wires = {};
                p3State.selectedOutPort = null;
                renderPhase3();
            });

            p3SubmitBtn.addEventListener('click', () => {
                if (isProcessingError || currentPhase !== 3) return;
                const check = evaluateWiredCircuit();
                if (check.ok) {
                    showVictory();
                } else {
                    triggerFailure(check.reason, generatePhase3);
                }
            });

            window.addEventListener('resize', () => {
                if (currentPhase === 3) {
                    renderPhase3Wires();
                }
            });
        }

        // Инициализация тренажера
        bindEventsOnce();
        generatePhase1();
        timerInterval = setInterval(updateTimerDisplay, 500);
    })();
    </script>
</TaskLayout>
