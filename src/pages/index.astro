---
import Layout from '../layouts/Layout.astro';
import courses from '../data/courses.json';
---

<Layout title="Вход | Школьная Платформа">
  <div class="flex items-center justify-center min-h-screen">
    <div class="bg-white p-8 shadow-md w-full max-w-md border border-gray-300">
      <h1 class="text-2xl font-bold mb-6 text-center">Вход в систему</h1>
      
      <form id="login-form" class="space-y-4">
        <div>
          <label for="firstName" class="block text-sm font-medium text-gray-700">Имя</label>
          <input type="text" id="firstName" name="firstName" required class="mt-1 block w-full border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Иван">
        </div>
        
        <div>
          <label for="lastName" class="block text-sm font-medium text-gray-700">Фамилия</label>
          <input type="text" id="lastName" name="lastName" required class="mt-1 block w-full border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Иванов">
        </div>

        <div>
          <label for="classSelect" class="block text-sm font-medium text-gray-700">Класс</label>
          <select id="classSelect" name="classSelect" required class="mt-1 block w-full border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
            <option value="" disabled selected>Выберите свой класс</option>
            {courses.map(course => (
              <option value={course.slug}>{course.name}</option>
            ))}
          </select>
        </div>

        <button type="submit" class="w-full bg-blue-600 text-white font-semibold py-2 px-4 hover:bg-blue-700 transition-colors">
          Войти
        </button>
      </form>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('login-form');
  
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const firstName = (document.getElementById('firstName') as HTMLInputElement).value;
      const lastName = (document.getElementById('lastName') as HTMLInputElement).value;
      const className = (document.getElementById('classSelect') as HTMLSelectElement).value;
      
      localStorage.setItem('student_firstName', firstName);
      localStorage.setItem('student_lastName', lastName);
      localStorage.setItem('student_class', className);
      
      window.location.href = '/courses';
    });
  }
</script>
