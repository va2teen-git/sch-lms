---
import Layout from '../layouts/Layout.astro';
import Database from 'better-sqlite3';
import path from 'path';
import coursesData from '../data/courses.json';

const dbPath = path.join(process.cwd(), 'telemetry.db');
let db: any;
let initialStudents: any[] = [];
let availableDates: string[] = [];
let initialKpi = {
  totalStudents: 0,
  completedCount: 0,
  hardcoreCount: 0,
  inProgressCount: 0,
  avgTimeSec: 0,
  totalErrors: 0
};

const now = new Date();
const todayStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;

try {
  db = new Database(dbPath, { readonly: true });
  
  // Available dates
  const dateRows = db.prepare(`SELECT DISTINCT DATE(timestamp) as d FROM telemetry ORDER BY d DESC LIMIT 30`).all();
  availableDates = dateRows.map((r: any) => r.d).filter(Boolean);



  // Default query: today's telemetry, excluding test users
  const rows = db.prepare(`
    SELECT id, first_name, last_name, class_name, mission_name, action_type,
           time_spent_sec, attempts_count, success, status, action_log,
           is_hardcore, student_class, course_slug, lesson_id, level_number, timestamp
    FROM telemetry
    WHERE DATE(timestamp) = ?
      AND first_name NOT LIKE '%Unknown%' 
      AND last_name NOT LIKE '%Unknown%' 
      AND first_name NOT LIKE '%Тест%' 
      AND last_name NOT LIKE '%Тест%' 
      AND COALESCE(student_class, class_name) NOT LIKE '%Unknown%'
      AND COALESCE(student_class, class_name) != '11-ИТ'
    ORDER BY timestamp ASC
  `).all(todayStr);

  const studentsMap: Record<string, any> = {};

  rows.forEach((r: any) => {
    const fn = (r.first_name || '').trim();
    const ln = (r.last_name || '').trim();
    const cls = (r.student_class || r.class_name || 'Unknown').trim();
    const nameWords = [fn.toLowerCase(), ln.toLowerCase()].sort();
    const canonicalKey = `${cls}_${nameWords.join('_')}`;

    if (!studentsMap[canonicalKey]) {
      let disp = `${ln} ${fn}`;
      if (fn.match(/(?:ов|ев|ин|ын|ский|цкий|ова|ева|ина|ына|ская|цкая)$/i) && !ln.match(/(?:ов|ев|ин|ын|ский|цкий|ова|ева|ина|ына|ская|цкая)$/i)) {
        disp = `${fn} ${ln}`;
      }

      studentsMap[canonicalKey] = {
        key: canonicalKey,
        displayName: disp,
        firstName: fn,
        lastName: ln,
        className: cls,
        firstSeen: r.timestamp,
        lastSeen: r.timestamp,
        levels: {
          1: { status: 'not_started', timeSpentSec: 0, errors: 0, attempts: 0, completed: false, hardcore: false },
          2: { status: 'not_started', timeSpentSec: 0, errors: 0, attempts: 0, completed: false, hardcore: false },
          3: { status: 'not_started', timeSpentSec: 0, errors: 0, attempts: 0, completed: false, hardcore: false }
        },
        normalCompletedLevels: new Set<number>(),
        allHardcoreCompletedLevels: new Set<number>(),
        hardcoreStreakLevels: new Set<number>(),
        hardcoreAttempted: false,
        hardcoreResetsCount: 0,
        hardcoreLevelsConquered: 0,
        totalActiveTimeSec: 0,
        totalErrors: 0,
        isHardcore: false,
        isHardcoreLegend: false,
        hardcoreStatus: 'none',
        lessonStatus: 'not_started',
        recentEvents: []
      };
    }

    const s = studentsMap[canonicalKey];
    s.lastSeen = r.timestamp;

    let lvlNum: 1 | 2 | 3 | null = null;
    if (r.level_number === 1 || r.level_number === 2 || r.level_number === 3) lvlNum = r.level_number as 1 | 2 | 3;
    else if (r.mission_name.includes('Уровень 1')) lvlNum = 1;
    else if (r.mission_name.includes('Уровень 2')) lvlNum = 2;
    else if (r.mission_name.includes('Уровень 3')) lvlNum = 3;

    const isError = r.action_type === 'hardcore_reset' || (r.action_log && r.action_log.includes('Error'));

    if (isError) s.totalErrors++;
    if (r.is_hardcore === 1) s.hardcoreAttempted = true;

    if (r.action_type === 'hardcore_reset' && r.is_hardcore === 1) {
      s.hardcoreStreakLevels.clear();
      s.hardcoreResetsCount++;
    }
    if (r.action_type === 'normal_reset' && r.is_hardcore === 0) {
      s.normalCompletedLevels.clear();
    }

    if (lvlNum) {
      const lvl = s.levels[lvlNum];
      lvl.attempts++;
      if (isError) lvl.errors++;

      if (r.action_type === 'level_complete') {
        lvl.completed = true;
        lvl.status = 'completed';
        if (r.is_hardcore === 1) {
          s.allHardcoreCompletedLevels.add(lvlNum);
          s.hardcoreStreakLevels.add(lvlNum);
        } else {
          s.normalCompletedLevels.add(lvlNum);
        }
        if (r.time_spent_sec > lvl.timeSpentSec) lvl.timeSpentSec = r.time_spent_sec;
      } else if (r.action_type === 'hardcore_reset') {
        if (!lvl.completed) lvl.status = 'reset';
      } else if (r.action_type === 'in_progress' || r.status === 'in_progress') {
        if (!lvl.completed) lvl.status = 'in_progress';
        if (r.time_spent_sec > lvl.timeSpentSec) lvl.timeSpentSec = r.time_spent_sec;
      }
    }

    s.recentEvents.push({
      id: r.id,
      mission: r.mission_name,
      action_type: r.action_type,
      timestamp: r.timestamp,
      time_spent: r.time_spent_sec,
      log: r.action_log
    });
    if (s.recentEvents.length > 20) s.recentEvents.shift();
  });

  const fifteenMinutesAgo = new Date(Date.now() - 15 * 60 * 1000).toISOString();

  initialStudents = Object.values(studentsMap).map(s => {
    s.totalActiveTimeSec = s.levels[1].timeSpentSec + s.levels[2].timeSpentSec + s.levels[3].timeSpentSec;
    
    const isHardcoreCompleted = s.hardcoreStreakLevels.size >= 3;
    const isNormalCompleted = s.normalCompletedLevels.size >= 3;
    s.hardcoreLevelsConquered = s.allHardcoreCompletedLevels.size;

    [1, 2, 3].forEach(num => {
      s.levels[num].hardcore = s.allHardcoreCompletedLevels.has(num);
    });

    if (isHardcoreCompleted) {
      s.lessonStatus = 'hardcore_completed';
      s.isHardcoreLegend = true;
      s.hardcoreStatus = 'completed';
    } else if (isNormalCompleted) {
      s.lessonStatus = 'completed';
      s.isHardcoreLegend = false;
      s.hardcoreStatus = s.hardcoreAttempted ? (s.hardcoreResetsCount > 0 ? 'failed' : 'attempting') : 'none';
    } else if (s.normalCompletedLevels.size > 0 || s.hardcoreStreakLevels.size > 0 || s.levels[1].attempts > 0 || s.levels[2].attempts > 0 || s.levels[3].attempts > 0) {
      s.lessonStatus = 'in_progress';
      s.isHardcoreLegend = false;
      s.hardcoreStatus = s.hardcoreAttempted ? 'attempting' : 'none';
    } else {
      s.lessonStatus = 'not_started';
      s.isHardcoreLegend = false;
      s.hardcoreStatus = 'none';
    }

    s.isHardcore = isHardcoreCompleted;
    s.isActiveNow = !!(s.lastSeen && (new Date(s.lastSeen + 'Z').toISOString() >= fifteenMinutesAgo));
    s.recentEvents.reverse();
    return s;
  });

  initialStudents.sort((a, b) => {
    const timeA = a.lastSeen ? new Date(a.lastSeen + 'Z').getTime() : 0;
    const timeB = b.lastSeen ? new Date(b.lastSeen + 'Z').getTime() : 0;
    return timeB - timeA;
  });

  const completed = initialStudents.filter(s => s.lessonStatus === 'completed' || s.lessonStatus === 'hardcore_completed');
  initialKpi = {
    totalStudents: initialStudents.length,
    completedCount: completed.length,
    hardcoreCount: initialStudents.filter(s => s.lessonStatus === 'hardcore_completed').length,
    inProgressCount: initialStudents.filter(s => s.lessonStatus === 'in_progress').length,
    avgTimeSec: completed.length > 0 ? Math.round(completed.reduce((acc, s) => acc + s.totalActiveTimeSec, 0) / completed.length) : 0,
    totalErrors: initialStudents.reduce((acc, s) => acc + s.totalErrors, 0)
  };

} catch (e) {
  console.error('Teacher SSR error:', e);
} finally {
  if (db) db.close();
}

function formatSec(sec: number): string {
  if (!sec || sec <= 0) return '0с';
  const m = Math.floor(sec / 60);
  const s = sec % 60;
  if (m === 0) return `${s}с`;
  return `${m}м ${s}с`;
}
---

<Layout title="Мониторинг урока | Панель управления учителя">
  <div class="w-full max-w-[1700px] mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- Top Navigation & Live Header -->
    <header class="bg-white border border-gray-200 p-5 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Панель мониторинга урока</h1>
          <span id="live-indicator" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 text-xs font-semibold bg-green-100 text-green-800 border border-green-300">
            <span class="w-2 h-2 rounded-full bg-green-600 animate-pulse"></span>
            LIVE
          </span>
        </div>
        <p class="text-sm text-gray-500 mt-1">
          Оперативная телеметрия учащихся в реальном времени • Автономный режим
        </p>
      </div>

      <div class="flex items-center flex-wrap gap-3">
        <!-- Live Polling Toggle -->
        <button id="toggle-live-btn" class="px-3 py-1.5 text-xs font-medium border border-gray-300 bg-gray-50 hover:bg-gray-100 text-gray-700 transition flex items-center gap-2" title="Включить / приостановить автообновление">
          <span id="live-btn-icon">⏸</span>
          <span id="live-btn-text">Автообновление (5с)</span>
        </button>

        <!-- Refresh Now Button -->
        <button id="refresh-now-btn" class="px-3 py-1.5 text-xs font-medium border border-blue-600 bg-blue-600 text-white hover:bg-blue-700 transition flex items-center gap-1.5">
          <span>🔄</span>
          <span>Обновить</span>
        </button>

        <!-- Export Excel/CSV Button -->
        <button id="export-btn" class="px-3 py-1.5 text-xs font-medium border border-emerald-700 bg-emerald-700 text-white hover:bg-emerald-800 transition flex items-center gap-1.5">
          <span>📊</span>
          <span>Экспорт в CSV</span>
        </button>

        <a href="/" class="px-3 py-1.5 text-xs font-medium border border-gray-300 bg-white hover:bg-gray-100 text-gray-700 transition">
          Выход
        </a>
      </div>
    </header>

    <!-- KPI Summary Pulse Cards -->
    <section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4" id="kpi-container">
      <div class="bg-white border border-gray-200 p-4 shadow-sm">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Учеников в выборке</div>
        <div class="mt-2 text-2xl font-bold text-gray-900" id="kpi-total">{initialKpi.totalStudents}</div>
        <div class="text-xs text-gray-400 mt-1">активных сейчас: <span id="kpi-active" class="text-green-600 font-semibold">{initialStudents.filter(s => s.isActiveNow).length}</span></div>
      </div>

      <div class="bg-white border border-gray-200 p-4 shadow-sm">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Урок завершен</div>
        <div class="mt-2 text-2xl font-bold text-green-700" id="kpi-completed">{initialKpi.completedCount}</div>
        <div class="text-xs text-gray-400 mt-1">в процессе: <span id="kpi-in-progress" class="text-amber-600 font-semibold">{initialKpi.inProgressCount}</span></div>
      </div>

      <div class="bg-white border border-gray-200 p-4 shadow-sm">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Хардкор-побед</div>
        <div class="mt-2 text-2xl font-bold text-red-600 flex items-center gap-1" id="kpi-hardcore">
          <span>💀</span>
          <span>{initialKpi.hardcoreCount}</span>
        </div>
        <div class="text-xs text-gray-400 mt-1">без единой ошибки</div>
      </div>

      <div class="bg-white border border-gray-200 p-4 shadow-sm">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Среднее время</div>
        <div class="mt-2 text-2xl font-bold text-blue-700" id="kpi-avg-time">{formatSec(initialKpi.avgTimeSec)}</div>
        <div class="text-xs text-gray-400 mt-1">чистое время урока</div>
      </div>

      <div class="bg-white border border-gray-200 p-4 shadow-sm">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Ошибок / Сбросов</div>
        <div class="mt-2 text-2xl font-bold text-amber-600" id="kpi-errors">{initialKpi.totalErrors}</div>
        <div class="text-xs text-gray-400 mt-1">всего попыток в классе</div>
      </div>

      <div class="bg-white border border-gray-200 p-4 shadow-sm">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Статус системы</div>
        <div class="mt-2 text-lg font-bold text-gray-800 flex items-center gap-2">
          <span class="w-3 h-3 bg-green-500 inline-block"></span>
          <span>БД: 100% OK</span>
        </div>
        <div class="text-xs text-gray-400 mt-1" id="kpi-last-sync">Обновлено только что</div>
      </div>
    </section>

    <!-- Filters & Search Toolbar -->
    <section class="bg-white border border-gray-200 p-4 shadow-sm space-y-3">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
        
        <!-- Class Multi-Select Filter -->
        <div class="relative" id="class-filter-container">
          <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Класс учащихся</label>
          <button type="button" id="filter-class" class="w-full border border-gray-300 p-2 text-sm bg-white focus:outline-none focus:border-blue-600 flex items-center justify-between text-left cursor-pointer hover:bg-gray-50/80 transition select-none">
            <span id="class-select-label" class="truncate text-gray-800">Все классы</span>
            <span class="text-[10px] text-gray-400 ml-1.5 shrink-0">▼</span>
          </button>
          
          <!-- Dropdown menu with checkboxes -->
          <div id="class-dropdown-menu" class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-gray-300 shadow-xl z-40 p-2 space-y-1.5 max-h-72 overflow-y-auto">
            <div class="flex items-center justify-between pb-1.5 border-b border-gray-100 text-[11px] font-semibold">
              <button type="button" id="btn-select-all-classes" class="text-blue-600 hover:text-blue-800 cursor-pointer">Выбрать все</button>
              <button type="button" id="btn-clear-all-classes" class="text-gray-400 hover:text-gray-600 cursor-pointer">Сбросить</button>
            </div>
            <div class="space-y-1">
              {coursesData.map(c => (
                <label class="flex items-center gap-2 px-1.5 py-1 hover:bg-blue-50/60 cursor-pointer text-xs select-none">
                  <input type="checkbox" value={c.slug} class="class-checkbox w-3.5 h-3.5 text-blue-600 border-gray-300 rounded-0" />
                  <span class="text-gray-800">{c.name}</span>
                </label>
              ))}
            </div>
          </div>
        </div>

        <!-- Course Filter -->
        <div>
          <label for="filter-course" class="block text-xs font-semibold text-gray-600 uppercase mb-1">Курс задания</label>
          <select id="filter-course" class="w-full border border-gray-300 p-2 text-sm bg-white focus:outline-none focus:border-blue-600">
            <option value="all">Все курсы</option>
            {coursesData.map(c => (
              <option value={c.slug}>{c.name}</option>
            ))}
          </select>
        </div>

        <!-- Lesson Filter -->
        <div>
          <label for="filter-lesson" class="block text-xs font-semibold text-gray-600 uppercase mb-1">Урок</label>
          <select id="filter-lesson" class="w-full border border-gray-300 p-2 text-sm bg-white focus:outline-none focus:border-blue-600">
            <option value="all">Все уроки курса</option>
          </select>
        </div>

        <!-- Date / Period Filter -->
        <div>
          <label for="filter-date" class="block text-xs font-semibold text-gray-600 uppercase mb-1">Период / Дата</label>
          <select id="filter-date" class="w-full border border-gray-300 p-2 text-sm bg-white focus:outline-none focus:border-blue-600">
            <option value="today" selected>Сегодня ({todayStr})</option>
            <option value="all">За всё время</option>
            {availableDates.filter(d => d !== todayStr).map(d => (
              <option value={d}>{d}</option>
            ))}
          </select>
        </div>

        <!-- Student Search -->
        <div>
          <label for="filter-search" class="block text-xs font-semibold text-gray-600 uppercase mb-1">Поиск ученика</label>
          <input type="text" id="filter-search" placeholder="Фамилия или имя..." class="w-full border border-gray-300 p-2 text-sm focus:outline-none focus:border-blue-600" />
        </div>

        <!-- Test Account Toggle -->
        <div class="flex items-center pt-5">
          <label class="flex items-center gap-2 cursor-pointer text-xs font-medium text-gray-700 select-none">
            <input type="checkbox" id="filter-exclude-tests" checked class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-0" />
            <span>Скрыть тесты и Unknown</span>
          </label>
        </div>

      </div>
    </section>

    <!-- Main Classroom Progress Matrix Table -->
    <section class="bg-white border border-gray-200 shadow-sm overflow-hidden">
      
      <!-- Responsive Table Container with Horizontal Scroll -->
      <div class="overflow-x-auto w-full">
        <table class="w-full min-w-[1150px] border-collapse text-left text-sm" id="progress-table">
          <thead>
            <tr class="bg-gray-100 border-b border-gray-200 text-xs font-bold text-gray-700 uppercase tracking-wider select-none">
              <th class="p-3 w-12 text-center">#</th>
              <th class="p-3 cursor-pointer hover:bg-gray-200 transition" data-sort="name" title="Сортировка. Удерживайте Ctrl/Shift для мульти-сортировки">Ученик <span id="sort-name-icon">↕</span></th>
              <th class="p-3 cursor-pointer hover:bg-gray-200 transition" data-sort="class" title="Сортировка. Удерживайте Ctrl/Shift для мульти-сортировки">Класс <span id="sort-class-icon">↕</span></th>
              <th class="p-3 text-center cursor-pointer hover:bg-gray-200 transition" data-sort="status" title="Сортировка. Удерживайте Ctrl/Shift для мульти-сортировки">Статус урока <span id="sort-status-icon">↕</span></th>
              <th class="p-3 text-center">Уровень 1</th>
              <th class="p-3 text-center">Уровень 2</th>
              <th class="p-3 text-center">Уровень 3</th>
              <th class="p-3 text-center cursor-pointer hover:bg-gray-200 transition" data-sort="time" title="Сортировка. Удерживайте Ctrl/Shift для мульти-сортировки">Активное время <span id="sort-time-icon">↕</span></th>
              <th class="p-3 text-center cursor-pointer hover:bg-gray-200 transition" data-sort="errors" title="Сортировка. Удерживайте Ctrl/Shift для мульти-сортировки">Ошибки <span id="sort-errors-icon">↕</span></th>
              <th class="p-3 text-center cursor-pointer hover:bg-gray-200 transition" data-sort="last" title="Сортировка. Удерживайте Ctrl/Shift для мульти-сортировки">Активность <span id="sort-last-icon">↕</span></th>
              <th class="p-3 text-center w-28">Действия</th>
            </tr>
          </thead>
          <tbody id="table-body" class="divide-y divide-gray-100">
            {initialStudents.length === 0 ? (
              <tr>
                <td colspan="11" class="p-12 text-center text-gray-500">
                  <div class="text-3xl mb-2">📋</div>
                  <div class="text-base font-semibold">Нет данных телеметрии по выбранным фильтрам</div>
                  <div class="text-xs text-gray-400 mt-1">Попробуйте выбрать другой класс, урок или период «За всё время»</div>
                </td>
              </tr>
            ) : (
              initialStudents.map((s, idx) => (
                <tr class="hover:bg-blue-50/30 transition student-row" data-key={s.key}>
                  <td class="p-3 text-center font-mono text-xs text-gray-400">{idx + 1}</td>
                  <td class="p-3 font-semibold text-gray-900">
                    <div class="flex items-center gap-2">
                      <span class={`w-2.5 h-2.5 inline-block ${s.isActiveNow ? 'bg-green-500 animate-pulse' : 'bg-gray-300'}`} title={s.isActiveNow ? 'Активен сейчас' : 'Офлайн'}></span>
                      <span>{s.displayName}</span>
                    </div>
                  </td>
                  <td class="p-3 text-xs text-gray-600">{s.className}</td>
                  <td class="p-3 text-center">
                    {s.lessonStatus === 'hardcore_completed' && (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-bold bg-red-100 text-red-800 border border-red-300">
                        💀 Хардкор сдан
                      </span>
                    )}
                    {s.lessonStatus === 'completed' && (
                      <div class="inline-flex flex-col items-center gap-0.5">
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-bold bg-green-100 text-green-800 border border-green-300">
                          ✓ Пройден
                        </span>
                        {s.hardcoreLevelsConquered > 0 ? (
                          <span class="text-[10px] text-red-600 font-semibold" title={`Пройдено на хардкоре: ${s.hardcoreLevelsConquered} из 3 уровней`}>
                            💀 {s.hardcoreLevelsConquered}/3 ур.
                          </span>
                        ) : s.hardcoreStatus === 'failed' ? (
                          <span class="text-[10px] text-red-600 font-medium" title="Была попытка пройти на хардкоре, сброшена на ошибке">
                            💀 сброс
                          </span>
                        ) : s.hardcoreStatus === 'attempting' ? (
                          <span class="text-[10px] text-amber-600 font-medium" title="Сейчас решает в режиме хардкора">
                            💀 попытка
                          </span>
                        ) : null}
                      </div>
                    )}
                    {s.lessonStatus === 'in_progress' && (
                      <div class="inline-flex flex-col items-center gap-0.5">
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-300">
                          ⏳ В процессе
                        </span>
                        {s.hardcoreStatus === 'attempting' && (
                          <span class="text-[10px] text-amber-600 font-medium">
                            💀 хардкор
                          </span>
                        )}
                      </div>
                    )}
                    {s.lessonStatus === 'not_started' && (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium bg-gray-100 text-gray-500">
                        — Не начат
                      </span>
                    )}
                  </td>
                  
                  <!-- Level 1 Badge -->
                  <td class="p-3 text-center">
                    {s.levels[1].completed ? (
                      <span class={`inline-block px-2 py-1 text-xs border ${s.levels[1].hardcore ? 'bg-red-50 text-red-700 border-red-200 font-semibold' : 'bg-emerald-50 text-emerald-700 border-emerald-200 font-medium'}`}>
                        {s.levels[1].hardcore ? '💀 ' : ''}✓ {formatSec(s.levels[1].timeSpentSec)} • {s.levels[1].errors} ош.
                      </span>
                    ) : s.levels[1].status === 'in_progress' ? (
                      <span class="inline-block px-2 py-1 text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200">
                        ⏳ {formatSec(s.levels[1].timeSpentSec)}
                      </span>
                    ) : s.levels[1].status === 'reset' ? (
                      <span class="inline-block px-2 py-1 text-xs font-medium bg-red-50 text-red-700 border border-red-200">
                        ❌ Сброс
                      </span>
                    ) : (
                      <span class="text-gray-300 text-xs">—</span>
                    )}
                  </td>

                  <!-- Level 2 Badge -->
                  <td class="p-3 text-center">
                    {s.levels[2].completed ? (
                      <span class={`inline-block px-2 py-1 text-xs border ${s.levels[2].hardcore ? 'bg-red-50 text-red-700 border-red-200 font-semibold' : 'bg-emerald-50 text-emerald-700 border-emerald-200 font-medium'}`}>
                        {s.levels[2].hardcore ? '💀 ' : ''}✓ {formatSec(s.levels[2].timeSpentSec)} • {s.levels[2].errors} ош.
                      </span>
                    ) : s.levels[2].status === 'in_progress' ? (
                      <span class="inline-block px-2 py-1 text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200">
                        ⏳ {formatSec(s.levels[2].timeSpentSec)}
                      </span>
                    ) : s.levels[2].status === 'reset' ? (
                      <span class="inline-block px-2 py-1 text-xs font-medium bg-red-50 text-red-700 border border-red-200">
                        ❌ Сброс
                      </span>
                    ) : (
                      <span class="text-gray-300 text-xs">—</span>
                    )}
                  </td>

                  <!-- Level 3 Badge -->
                  <td class="p-3 text-center">
                    {s.levels[3].completed ? (
                      <span class={`inline-block px-2 py-1 text-xs border ${s.levels[3].hardcore ? 'bg-red-50 text-red-700 border-red-200 font-semibold' : 'bg-emerald-50 text-emerald-700 border-emerald-200 font-medium'}`}>
                        {s.levels[3].hardcore ? '💀 ' : ''}✓ {formatSec(s.levels[3].timeSpentSec)} • {s.levels[3].errors} ош.
                      </span>
                    ) : s.levels[3].status === 'in_progress' ? (
                      <span class="inline-block px-2 py-1 text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200">
                        ⏳ {formatSec(s.levels[3].timeSpentSec)}
                      </span>
                    ) : s.levels[3].status === 'reset' ? (
                      <span class="inline-block px-2 py-1 text-xs font-medium bg-red-50 text-red-700 border border-red-200">
                        ❌ Сброс
                      </span>
                    ) : (
                      <span class="text-gray-300 text-xs">—</span>
                    )}
                  </td>

                  <!-- Total Time -->
                  <td class="p-3 text-center font-mono font-semibold text-gray-800">
                    {formatSec(s.totalActiveTimeSec)}
                  </td>

                  <!-- Total Errors -->
                  <td class="p-3 text-center">
                    <span class={`inline-block px-2 py-0.5 text-xs font-bold ${s.totalErrors > 15 ? 'bg-red-100 text-red-800' : s.totalErrors > 3 ? 'bg-amber-100 text-amber-800' : 'bg-green-100 text-green-800'}`}>
                      {s.totalErrors}
                    </span>
                  </td>

                  <!-- Last Activity -->
                  <td class="p-3 text-center text-xs text-gray-500 font-mono">
                    {s.lastSeen ? s.lastSeen.split(' ')[1] : '—'}
                  </td>

                  <!-- Actions / Details -->
                  <td class="p-3 text-center">
                    <button class="px-2 py-1 text-xs font-medium border border-gray-300 bg-gray-50 hover:bg-blue-50 hover:border-blue-300 text-gray-700 view-log-btn" data-student-key={s.key}>
                      Лог 📋
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
      
      <!-- Footer Note -->
      <div class="p-3 bg-gray-50 border-t border-gray-200 text-xs text-gray-500 flex justify-between items-center">
        <span>Всего отображено: <strong id="footer-count">{initialStudents.length}</strong> учащихся <span class="hidden sm:inline text-gray-400 ml-2">• Зажмите Ctrl / Shift для мульти-сортировки</span></span>
        <span>Школьная сеть • Автономный сбор телеметрии</span>
      </div>
    </section>

    <!-- Student Detail Modal (Drill-down Inspector) -->
    <div id="detail-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
      <div class="bg-white border border-gray-300 max-w-3xl w-full max-h-[85vh] flex flex-col shadow-2xl">
        <div class="p-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
          <div>
            <h3 class="text-lg font-bold text-gray-900" id="modal-student-name">Детализация ученика</h3>
            <p class="text-xs text-gray-500" id="modal-student-sub">Класс • Статистика сессии</p>
          </div>
          <button id="modal-close-btn" class="p-1.5 text-gray-400 hover:text-gray-700 text-xl font-bold leading-none">
            ✕
          </button>
        </div>

        <div class="p-4 overflow-y-auto space-y-4 flex-1">
          <!-- Quick level summary cards in modal -->
          <div class="grid grid-cols-3 gap-3" id="modal-level-cards">
            <!-- Will be populated by JS -->
          </div>

          <!-- History timeline -->
          <div>
            <h4 class="text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Хронология последних событий (Таймлайн)</h4>
            <div class="border border-gray-200 divide-y divide-gray-100 max-h-80 overflow-y-auto text-xs" id="modal-events-list">
              <!-- Populated by JS -->
            </div>
          </div>
        </div>

        <div class="p-3 bg-gray-50 border-t border-gray-200 flex justify-end">
          <button id="modal-ok-btn" class="px-4 py-1.5 text-xs font-semibold bg-gray-800 text-white hover:bg-gray-900">
            Закрыть
          </button>
        </div>
      </div>
    </div>

  </div>
</Layout>

<script is:inline define:vars={{ coursesData }}>
  let currentStudents = [];
  let isLive = true;
  let pollingInterval = null;
  let sortRules = [{ col: 'last', asc: false }];
  let activeStudent = null;

  const classDropdownBtn = document.getElementById('filter-class');
  const classDropdownMenu = document.getElementById('class-dropdown-menu');
  const classSelectLabel = document.getElementById('class-select-label');
  const classContainer = document.getElementById('class-filter-container');
  const classCheckboxes = document.querySelectorAll('.class-checkbox');
  const btnSelectAllClasses = document.getElementById('btn-select-all-classes');
  const btnClearAllClasses = document.getElementById('btn-clear-all-classes');

  const courseSelect = document.getElementById('filter-course');
  const lessonSelect = document.getElementById('filter-lesson');
  const dateSelect = document.getElementById('filter-date');
  const searchInput = document.getElementById('filter-search');
  const excludeTestsCheckbox = document.getElementById('filter-exclude-tests');
  const tableBody = document.getElementById('table-body');
  const liveIndicator = document.getElementById('live-indicator');
  const toggleLiveBtn = document.getElementById('toggle-live-btn');
  const refreshBtn = document.getElementById('refresh-now-btn');
  const exportBtn = document.getElementById('export-btn');
  const modal = document.getElementById('detail-modal');

  function getSelectedClasses() {
    const checked = Array.from(document.querySelectorAll('.class-checkbox:checked'));
    return checked.map(cb => cb.value);
  }

  function getSelectedClassesParam() {
    const sel = getSelectedClasses();
    if (sel.length === 0 || sel.length === classCheckboxes.length) return 'all';
    return sel.join(',');
  }

  function updateClassSelectLabel() {
    const sel = getSelectedClasses();
    if (!classSelectLabel) return;
    if (sel.length === 0 || sel.length === classCheckboxes.length) {
      classSelectLabel.textContent = 'Все классы';
    } else if (sel.length === 1) {
      const course = coursesData.find(c => c.slug === sel[0]);
      classSelectLabel.textContent = course ? course.name : sel[0];
    } else {
      classSelectLabel.textContent = `Выбрано: ${sel.length} кл.`;
    }
  }

  if (classDropdownBtn) {
    Object.defineProperty(classDropdownBtn, 'value', {
      get: () => getSelectedClassesParam(),
      configurable: true
    });
  }

  // Populate lessons dropdown based on selected course or selected classes
  function updateLessonsDropdown() {
    const selectedCourseSlug = courseSelect ? courseSelect.value : 'all';
    const selected = getSelectedClasses();
    const prevVal = lessonSelect.value;
    lessonSelect.innerHTML = '<option value="all">Все уроки курса / выборки</option>';

    if (selectedCourseSlug !== 'all') {
      const course = coursesData.find(c => c.slug === selectedCourseSlug);
      if (course) {
        course.lessons.forEach(l => {
          const opt = document.createElement('option');
          opt.value = `Урок ${l.id}`;
          opt.textContent = `Урок ${l.id}: ${l.topic.substring(0, 48)}${l.topic.length > 48 ? '...' : ''}`;
          lessonSelect.appendChild(opt);
        });
      }
    } else {
      const isSpecificSelection = selected.length > 0 && selected.length < classCheckboxes.length;

      if (isSpecificSelection) {
        // 1. Lessons of the selected classes first (primary context)
        const selectedCourses = coursesData.filter(c => selected.includes(c.slug));
        selectedCourses.forEach(c => {
          const group = document.createElement('optgroup');
          group.label = `★ Выбранный класс: ${c.name}`;
          c.lessons.forEach(l => {
            const opt = document.createElement('option');
            opt.value = `Урок ${l.id}`;
            opt.textContent = `Урок ${l.id}: ${l.topic.substring(0, 48)}${l.topic.length > 48 ? '...' : ''}`;
            group.appendChild(opt);
          });
          lessonSelect.appendChild(group);
        });

        // 2. Other courses available for cross-course evaluation & inter-class competitions
        const otherCourses = coursesData.filter(c => !selected.includes(c.slug));
        otherCourses.forEach(c => {
          const group = document.createElement('optgroup');
          group.label = `Другой курс: ${c.name}`;
          c.lessons.forEach(l => {
            const opt = document.createElement('option');
            opt.value = `Урок ${l.id}`;
            opt.textContent = `${c.name.split('_')[0]} • Урок ${l.id}: ${l.topic.substring(0, 42)}${l.topic.length > 42 ? '...' : ''}`;
            group.appendChild(opt);
          });
          lessonSelect.appendChild(group);
        });
      } else {
        // All classes or none selected: list each course
        coursesData.forEach(c => {
          const group = document.createElement('optgroup');
          group.label = `Курс: ${c.name}`;
          c.lessons.forEach(l => {
            const opt = document.createElement('option');
            opt.value = `Урок ${l.id}`;
            opt.textContent = `${c.name.split('_')[0]} • Урок ${l.id}: ${l.topic.substring(0, 42)}${l.topic.length > 42 ? '...' : ''}`;
            group.appendChild(opt);
          });
          lessonSelect.appendChild(group);
        });
      }

      // Generic lesson number group for rapid selection
      const genericGroup = document.createElement('optgroup');
      genericGroup.label = '— Быстрый выбор по номеру (любой курс) —';
      for (let i = 1; i <= 34; i++) {
        const opt = document.createElement('option');
        opt.value = `Урок ${i}`;
        opt.textContent = `Урок ${i}`;
        genericGroup.appendChild(opt);
      }
      lessonSelect.appendChild(genericGroup);
    }

    if (prevVal && Array.from(lessonSelect.options).some(o => o.value === prevVal)) {
      lessonSelect.value = prevVal;
    }
  }

  function formatTime(sec) {
    if (!sec || sec <= 0) return '0с';
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    if (m === 0) return `${s}с`;
    return `${m}м ${s}с`;
  }

  // Fetch telemetry from server API
  async function fetchTelemetry() {
    const cls = getSelectedClassesParam();
    const crs = courseSelect ? courseSelect.value : 'all';
    const lsn = lessonSelect.value;
    const dt = dateSelect.value;
    const exc = excludeTestsCheckbox.checked ? '1' : '0';
    const q = encodeURIComponent(searchInput.value.trim());

    try {
      const res = await fetch(`/api/teacher/stats?class=${encodeURIComponent(cls)}&course=${encodeURIComponent(crs)}&lesson=${encodeURIComponent(lsn)}&date=${encodeURIComponent(dt)}&exclude_tests=${exc}&search=${q}`);
      if (!res.ok) throw new Error('Network error');
      const data = await res.json();
      
      if (data.success) {
        currentStudents = data.students || [];
        updateKpi(data.kpi);
        renderTable();
        document.getElementById('kpi-last-sync').textContent = `Обновлено: ${new Date().toLocaleTimeString('ru-RU')}`;
      }
    } catch (e) {
      console.warn('Telemetry fetch error:', e);
      document.getElementById('kpi-last-sync').textContent = 'Ошибка сети при обновлении';
    }
  }

  function updateKpi(kpi) {
    if (!kpi) return;
    document.getElementById('kpi-total').textContent = kpi.totalStudents;
    document.getElementById('kpi-completed').textContent = kpi.completedCount;
    document.getElementById('kpi-hardcore').innerHTML = `<span>💀</span><span>${kpi.hardcoreCount}</span>`;
    document.getElementById('kpi-in-progress').textContent = kpi.inProgressCount;
    document.getElementById('kpi-avg-time').textContent = formatTime(kpi.avgTimeSec);
    document.getElementById('kpi-errors').textContent = kpi.totalErrors;

    const activeCount = currentStudents.filter(s => s.isActiveNow).length;
    document.getElementById('kpi-active').textContent = activeCount;
  }

  function updateSortIcons() {
    const cols = ['name', 'class', 'status', 'time', 'errors', 'last'];
    const superscripts = ['¹', '²', '³', '⁴', '⁵', '⁶'];

    cols.forEach(col => {
      const icon = document.getElementById(`sort-${col}-icon`);
      if (!icon) return;

      const ruleIdx = sortRules.findIndex(r => r.col === col);
      if (ruleIdx !== -1) {
        const rule = sortRules[ruleIdx];
        const arrow = rule.asc ? '↑' : '↓';
        if (sortRules.length > 1) {
          const num = superscripts[ruleIdx] || `${ruleIdx + 1}`;
          icon.textContent = `${num}${arrow}`;
          icon.title = `Приоритет ${ruleIdx + 1}: ${rule.asc ? 'по возрастанию' : 'по убыванию'}`;
        } else {
          icon.textContent = arrow;
          icon.title = rule.asc ? 'По возрастанию' : 'По убыванию';
        }
      } else {
        icon.textContent = '↕';
        icon.title = 'Не отсортировано';
      }
    });
  }

  function setSort(col, isMulti = false) {
    if (!currentStudents || currentStudents.length === 0) return;

    const defaultAsc = (col === 'name' || col === 'class');
    const existingIdx = sortRules.findIndex(r => r.col === col);

    if (isMulti) {
      if (existingIdx !== -1) {
        // If already in rules: toggle asc <-> desc
        sortRules[existingIdx].asc = !sortRules[existingIdx].asc;
      } else {
        // Append secondary/tertiary sort rule
        sortRules.push({ col, asc: defaultAsc });
      }
    } else {
      // Single column click
      if (sortRules.length === 1 && sortRules[0].col === col) {
        sortRules[0].asc = !sortRules[0].asc;
      } else {
        sortRules = [{ col, asc: defaultAsc }];
      }
    }

    renderTable();
  }

  function compareStudents(a, b, col, asc) {
    let diff = 0;
    if (col === 'name') {
      const valA = (a.displayName || '').toLowerCase();
      const valB = (b.displayName || '').toLowerCase();
      diff = valA.localeCompare(valB, 'ru');
    } else if (col === 'class') {
      const valA = a.className || '';
      const valB = b.className || '';
      diff = valA.localeCompare(valB, 'ru');
    } else if (col === 'status') {
      const statusWeight = {
        'hardcore_completed': 4,
        'completed': 3,
        'in_progress': 2,
        'not_started': 1
      };
      diff = (statusWeight[a.lessonStatus] || 0) - (statusWeight[b.lessonStatus] || 0);
    } else if (col === 'time') {
      diff = (a.totalActiveTimeSec || 0) - (b.totalActiveTimeSec || 0);
    } else if (col === 'errors') {
      diff = (a.totalErrors || 0) - (b.totalErrors || 0);
    } else if (col === 'last') {
      const timeA = a.lastSeen ? new Date(a.lastSeen + 'Z').getTime() : 0;
      const timeB = b.lastSeen ? new Date(b.lastSeen + 'Z').getTime() : 0;
      diff = timeA - timeB;
    }
    return asc ? diff : -diff;
  }

  function renderTable() {
    const tbody = tableBody;
    updateSortIcons();
    document.getElementById('footer-count').textContent = currentStudents.length;

    if (currentStudents.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="11" class="p-12 text-center text-gray-500">
            <div class="text-3xl mb-2">📋</div>
            <div class="text-base font-semibold">Нет данных телеметрии по выбранным фильтрам</div>
            <div class="text-xs text-gray-400 mt-1">Попробуйте выбрать другой класс, урок или период «За всё время»</div>
          </td>
        </tr>
      `;
      return;
    }

    // Sort students with chained multi-column rules
    const sorted = [...currentStudents].sort((a, b) => {
      for (const rule of sortRules) {
        const diff = compareStudents(a, b, rule.col, rule.asc);
        if (diff !== 0) return diff;
      }
      return (a.displayName || '').localeCompare(b.displayName || '', 'ru');
    });

    let html = '';
    sorted.forEach((s, idx) => {
      let statusBadge = '';
      if (s.lessonStatus === 'hardcore_completed') {
        statusBadge = '<span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-bold bg-red-100 text-red-800 border border-red-300">💀 Хардкор сдан</span>';
      } else if (s.lessonStatus === 'completed') {
        let extra = '';
        if (s.hardcoreLevelsConquered > 0) extra = `<span class="text-[10px] text-red-600 font-semibold" title="Пройдено на хардкоре: ${s.hardcoreLevelsConquered} из 3 уровней">💀 ${s.hardcoreLevelsConquered}/3 ур.</span>`;
        else if (s.hardcoreStatus === 'failed') extra = '<span class="text-[10px] text-red-600 font-medium" title="Была попытка пройти на хардкоре, сброшена на ошибке">💀 сброс</span>';
        else if (s.hardcoreStatus === 'attempting') extra = '<span class="text-[10px] text-amber-600 font-medium" title="Сейчас решает в режиме хардкора">💀 попытка</span>';
        statusBadge = `<div class="inline-flex flex-col items-center gap-0.5"><span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-bold bg-green-100 text-green-800 border border-green-300">✓ Пройден</span>${extra}</div>`;
      } else if (s.lessonStatus === 'in_progress') {
        let extra = s.hardcoreStatus === 'attempting' ? '<span class="text-[10px] text-amber-600 font-medium">💀 хардкор</span>' : '';
        statusBadge = `<div class="inline-flex flex-col items-center gap-0.5"><span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-300">⏳ В процессе</span>${extra}</div>`;
      } else {
        statusBadge = '<span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium bg-gray-100 text-gray-500">— Не начат</span>';
      }

      function levelBadge(lvl) {
        if (!lvl) return '<span class="text-gray-300 text-xs">—</span>';
        if (lvl.completed) {
          const hc = lvl.hardcore ? '💀 ' : '';
          const hcClass = lvl.hardcore ? 'bg-red-50 text-red-700 border-red-200 font-semibold' : 'bg-emerald-50 text-emerald-700 border-emerald-200 font-medium';
          return `<span class="inline-block px-2 py-1 text-xs ${hcClass} border">${hc}✓ ${formatTime(lvl.timeSpentSec)} • ${lvl.errors} ош.</span>`;
        }
        if (lvl.status === 'in_progress') {
          return `<span class="inline-block px-2 py-1 text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200">⏳ ${formatTime(lvl.timeSpentSec)}</span>`;
        }
        if (lvl.status === 'reset') {
          return `<span class="inline-block px-2 py-1 text-xs font-medium bg-red-50 text-red-700 border border-red-200">❌ Сброс</span>`;
        }
        return '<span class="text-gray-300 text-xs">—</span>';
      }

      const errClass = s.totalErrors > 15 ? 'bg-red-100 text-red-800' : s.totalErrors > 3 ? 'bg-amber-100 text-amber-800' : 'bg-green-100 text-green-800';
      const lastTime = s.lastSeen ? s.lastSeen.split(' ')[1] : '—';
      const activeDot = s.isActiveNow ? '<span class="w-2.5 h-2.5 inline-block bg-green-500 animate-pulse" title="Активен прямо сейчас"></span>' : '<span class="w-2.5 h-2.5 inline-block bg-gray-300" title="Офлайн"></span>';

      html += `
        <tr class="hover:bg-blue-50/30 transition student-row" data-key="${s.key}">
          <td class="p-3 text-center font-mono text-xs text-gray-400">${idx + 1}</td>
          <td class="p-3 font-semibold text-gray-900">
            <div class="flex items-center gap-2">
              ${activeDot}
              <span>${s.displayName}</span>
            </div>
          </td>
          <td class="p-3 text-xs text-gray-600">${s.className}</td>
          <td class="p-3 text-center">${statusBadge}</td>
          <td class="p-3 text-center">${levelBadge(s.levels[1])}</td>
          <td class="p-3 text-center">${levelBadge(s.levels[2])}</td>
          <td class="p-3 text-center">${levelBadge(s.levels[3])}</td>
          <td class="p-3 text-center font-mono font-semibold text-gray-800">${formatTime(s.totalActiveTimeSec)}</td>
          <td class="p-3 text-center"><span class="inline-block px-2 py-0.5 text-xs font-bold ${errClass}">${s.totalErrors}</span></td>
          <td class="p-3 text-center text-xs text-gray-500 font-mono">${lastTime}</td>
          <td class="p-3 text-center">
            <button class="px-2 py-1 text-xs font-medium border border-gray-300 bg-gray-50 hover:bg-blue-50 hover:border-blue-300 text-gray-700 view-log-btn" data-student-key="${s.key}">
              Лог 📋
            </button>
          </td>
        </tr>
      `;
    });

    tbody.innerHTML = html;

    // Attach click handlers to log buttons
    tbody.querySelectorAll('.view-log-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const key = btn.getAttribute('data-student-key');
        const student = currentStudents.find(s => s.key === key);
        if (student) openModal(student);
      });
    });
  }

  function openModal(student) {
    activeStudent = student;
    document.getElementById('modal-student-name').textContent = student.displayName;
    document.getElementById('modal-student-sub').textContent = `${student.className} • Чистое время: ${formatTime(student.totalActiveTimeSec)} • Всего ошибок: ${student.totalErrors}`;

    // Render level summary cards
    const cards = document.getElementById('modal-level-cards');
    let cardsHtml = '';
    [1, 2, 3].forEach(lvlNum => {
      const l = student.levels[lvlNum];
      const statusText = l.completed ? '✓ Сдан' : l.status === 'in_progress' ? '⏳ В работе' : l.status === 'reset' ? '❌ Сброс' : '⚪ Не начат';
      const color = l.completed ? 'border-green-300 bg-green-50 text-green-900' : l.status === 'in_progress' ? 'border-amber-300 bg-amber-50 text-amber-900' : 'border-gray-200 bg-gray-50 text-gray-600';
      cardsHtml += `
        <div class="border p-2.5 ${color}">
          <div class="text-xs font-bold uppercase">Уровень ${lvlNum}</div>
          <div class="text-sm font-semibold mt-1">${statusText}</div>
          <div class="text-xs opacity-75 mt-0.5">Время: ${formatTime(l.timeSpentSec)} • Ошибки: ${l.errors}</div>
        </div>
      `;
    });
    cards.innerHTML = cardsHtml;

    // Render recent events
    const list = document.getElementById('modal-events-list');
    if (!student.recentEvents || student.recentEvents.length === 0) {
      list.innerHTML = '<div class="p-4 text-center text-gray-400">Нет подробных событий</div>';
    } else {
      let eventsHtml = '';
      student.recentEvents.forEach(ev => {
        let actColor = 'text-gray-700';
        if (ev.action_type === 'level_complete') actColor = 'text-green-700 font-bold';
        else if (ev.action_type === 'hardcore_reset') actColor = 'text-red-700 font-bold';
        
        eventsHtml += `
          <div class="p-2.5 flex justify-between items-start hover:bg-gray-50">
            <div>
              <div class="font-medium ${actColor}">[${ev.action_type}] ${ev.mission}</div>
              <div class="text-gray-400 text-[11px] mt-0.5">${ev.timestamp} • затрачено: ${ev.time_spent}с</div>
              ${ev.log && ev.log !== '[]' ? `<div class="text-gray-500 font-mono text-[11px] mt-1 bg-gray-100 p-1 truncate max-w-lg" title="${ev.log}">${ev.log}</div>` : ''}
            </div>
          </div>
        `;
      });
      list.innerHTML = eventsHtml;
    }

    modal.classList.remove('hidden');
  }

  function closeModal() {
    modal.classList.add('hidden');
    activeStudent = null;
  }

  document.getElementById('modal-close-btn').addEventListener('click', closeModal);
  document.getElementById('modal-ok-btn').addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Export to CSV
  exportBtn.addEventListener('click', () => {
    if (!currentStudents.length) {
      alert('Нет данных для экспорта');
      return;
    }

    const headers = ['#', 'Ученик', 'Класс', 'Статус урока', 'Уровень 1 (время/ошибки)', 'Уровень 2 (время/ошибки)', 'Уровень 3 (время/ошибки)', 'Активное время (сек)', 'Активное время', 'Всего ошибок', 'Хардкор', 'Последняя активность'];
    const rows = currentStudents.map((s, idx) => [
      idx + 1,
      `"${s.displayName}"`,
      `"${s.className}"`,
      `"${s.lessonStatus}"`,
      `"${formatTime(s.levels[1]?.timeSpentSec)} / ${s.levels[1]?.errors || 0} ош."`,
      `"${formatTime(s.levels[2]?.timeSpentSec)} / ${s.levels[2]?.errors || 0} ош."`,
      `"${formatTime(s.levels[3]?.timeSpentSec)} / ${s.levels[3]?.errors || 0} ош."`,
      s.totalActiveTimeSec,
      `"${formatTime(s.totalActiveTimeSec)}"`,
      s.totalErrors,
      s.isHardcore ? 'Да' : 'Нет',
      `"${s.lastSeen || ''}"`
    ]);

    const csvContent = '\uFEFF' + [headers.join(';'), ...rows.map(r => r.join(';'))].join('\r\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', `Ведомость_телеметрии_${getSelectedClassesParam()}_${dateSelect.value}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  // Polling setup
  function setupPolling() {
    if (pollingInterval) clearInterval(pollingInterval);
    if (isLive) {
      pollingInterval = setInterval(fetchTelemetry, 5000);
      liveIndicator.classList.remove('opacity-40');
      document.getElementById('live-btn-icon').textContent = '⏸';
      document.getElementById('live-btn-text').textContent = 'Автообновление (5с)';
    } else {
      liveIndicator.classList.add('opacity-40');
      document.getElementById('live-btn-icon').textContent = '▶';
      document.getElementById('live-btn-text').textContent = 'Возобновить';
    }
  }

  toggleLiveBtn.addEventListener('click', () => {
    isLive = !isLive;
    setupPolling();
  });

  refreshBtn.addEventListener('click', () => {
    fetchTelemetry();
  });

  // Multi-class dropdown interaction
  classDropdownBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    classDropdownMenu.classList.toggle('hidden');
  });

  document.addEventListener('click', (e) => {
    if (classContainer && !classContainer.contains(e.target)) {
      classDropdownMenu.classList.add('hidden');
    }
  });

  classCheckboxes.forEach(cb => {
    cb.addEventListener('change', () => {
      updateClassSelectLabel();
      updateLessonsDropdown();
      fetchTelemetry();
    });
  });

  btnSelectAllClasses.addEventListener('click', (e) => {
    e.stopPropagation();
    classCheckboxes.forEach(cb => cb.checked = true);
    updateClassSelectLabel();
    updateLessonsDropdown();
    fetchTelemetry();
  });

  btnClearAllClasses.addEventListener('click', (e) => {
    e.stopPropagation();
    classCheckboxes.forEach(cb => cb.checked = false);
    updateClassSelectLabel();
    updateLessonsDropdown();
    fetchTelemetry();
  });

  courseSelect?.addEventListener('change', () => {
    updateLessonsDropdown();
    fetchTelemetry();
  });
  lessonSelect.addEventListener('change', fetchTelemetry);
  dateSelect.addEventListener('change', fetchTelemetry);
  excludeTestsCheckbox.addEventListener('change', fetchTelemetry);

  let searchTimeout = null;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(fetchTelemetry, 300);
  });

  // Table column sorting listeners (supports Ctrl / Cmd / Shift for multi-column sorting)
  document.querySelectorAll('th[data-sort]').forEach(th => {
    th.addEventListener('click', (e) => {
      const col = th.getAttribute('data-sort');
      const isMulti = !!(e.ctrlKey || e.metaKey || e.shiftKey);
      if (col) setSort(col, isMulti);
    });
  });
  window.setSort = setSort;
  window.getSortRules = () => sortRules;

  // Initialize
  updateSortIcons();
  updateLessonsDropdown();
  setupPolling();
  fetchTelemetry();
</script>
