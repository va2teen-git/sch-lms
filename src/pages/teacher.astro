---
import Layout from '../layouts/Layout.astro';
import Database from 'better-sqlite3';
import path from 'path';
import coursesData from '../data/courses.json';
import { computeTeacherStats } from '../lib/teacher-stats';

const dbPath = path.join(process.cwd(), 'telemetry.db');
let db: any;
let initialStudents: any[] = [];
let availableDates: string[] = [];
let initialKpi = {
  totalStudents: 0,
  completedCount: 0,
  hardcoreCount: 0,
  princeCount: 0,
  inProgressCount: 0,
  avgTimeSec: 0,
  totalErrors: 0
};

const now = new Date();
const todayStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;

try {
  db = new Database(dbPath, { readonly: true });
  const stats = computeTeacherStats(db, {
    dateFilter: 'today',
    excludeTests: true
  });
  initialStudents = stats.students;
  availableDates = stats.availableDates;
  initialKpi = stats.kpi;
} catch (e) {
  console.error('Teacher SSR error:', e);
} finally {
  if (db) db.close();
}

function formatSec(sec: number): string {
  if (!sec || sec <= 0) return '0с';
  const m = Math.floor(sec / 60);
  const s = sec % 60;
  if (m === 0) return `${s}с`;
  return `${m}м ${s}с`;
}

function getAttemptsWord(count: number): string {
  const mod10 = count % 10;
  const mod100 = count % 100;
  if (mod100 >= 11 && mod100 <= 19) return 'забегов';
  if (mod10 === 1) return 'забег';
  if (mod10 >= 2 && mod10 <= 4) return 'забега';
  return 'забегов';
}

function getStarsParts(lvl: any) {
  if (!lvl || !lvl.currentStage || !lvl.totalStages) return null;
  const total = Math.max(1, lvl.totalStages);
  const filled = Math.max(0, Math.min(total, lvl.currentStage));
  const empty = Math.max(0, total - filled);
  return {
    filledStr: '★'.repeat(filled),
    emptyStr: '☆'.repeat(empty),
    title: `Этап ${lvl.currentStage} из ${total}`
  };
}
---

<Layout title="Мониторинг урока | Панель управления учителя">
  <div class="w-full max-w-[1700px] mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- Top Navigation & Live Header -->
    <header class="bg-white border border-gray-200 p-5 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Панель мониторинга урока</h1>
          <span id="live-indicator" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 text-xs font-semibold bg-green-100 text-green-800 border border-green-300">
            <span class="w-2 h-2 rounded-full bg-green-600 animate-pulse"></span>
            LIVE
          </span>
        </div>
        <p class="text-sm text-gray-500 mt-1">
          Оперативная телеметрия учащихся в реальном времени • Автономный режим
        </p>
      </div>

      <div class="flex items-center flex-wrap gap-3">
        <!-- Live Polling Toggle -->
        <button id="toggle-live-btn" class="px-3 py-1.5 text-xs font-medium border border-gray-300 bg-gray-50 hover:bg-gray-100 text-gray-700 transition flex items-center gap-2" title="Включить / приостановить автообновление">
          <span id="live-btn-icon">⏸</span>
          <span id="live-btn-text">Автообновление (5с)</span>
        </button>

        <!-- Refresh Now Button -->
        <button id="refresh-now-btn" class="px-3 py-1.5 text-xs font-medium border border-blue-600 bg-blue-600 text-white hover:bg-blue-700 transition flex items-center gap-1.5">
          <span>🔄</span>
          <span>Обновить</span>
        </button>

        <!-- Export Excel/CSV Button -->
        <button id="export-btn" class="px-3 py-1.5 text-xs font-medium border border-emerald-700 bg-emerald-700 text-white hover:bg-emerald-800 transition flex items-center gap-1.5">
          <span>📊</span>
          <span>Экспорт в CSV</span>
        </button>

        <a href="/" class="px-3 py-1.5 text-xs font-medium border border-gray-300 bg-white hover:bg-gray-100 text-gray-700 transition">
          Выход
        </a>
      </div>
    </header>

    <!-- KPI Summary Pulse Cards -->
    <section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4" id="kpi-container">
      <div class="bg-white border border-gray-200 p-4 shadow-sm">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Учеников в выборке</div>
        <div class="mt-2 text-2xl font-bold text-gray-900" id="kpi-total">{initialKpi.totalStudents}</div>
        <div class="text-xs text-gray-400 mt-1">активных сейчас: <span id="kpi-active" class="text-green-600 font-semibold">{initialStudents.filter(s => s.isActiveNow).length}</span></div>
      </div>

      <div class="bg-white border border-gray-200 p-4 shadow-sm">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Урок завершен</div>
        <div class="mt-2 text-2xl font-bold text-green-700" id="kpi-completed">{initialKpi.completedCount}</div>
        <div class="text-xs text-gray-400 mt-1">в процессе: <span id="kpi-in-progress" class="text-amber-600 font-semibold">{initialKpi.inProgressCount}</span></div>
      </div>

      <div class="bg-white border border-gray-200 p-4 shadow-sm">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Хардкор-побед</div>
        <div class="mt-2 text-2xl font-bold text-red-600 flex items-center gap-1" id="kpi-hardcore">
          <span>💀</span>
          <span>{initialKpi.hardcoreCount}</span>
        </div>
        <div class="text-xs text-gray-400 mt-1">без единой ошибки</div>
      </div>

      <div class="bg-white border border-gray-200 p-4 shadow-sm">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Среднее время</div>
        <div class="mt-2 text-2xl font-bold text-blue-700" id="kpi-avg-time">{formatSec(initialKpi.avgTimeSec)}</div>
        <div class="text-xs text-gray-400 mt-1">чистое время урока</div>
      </div>

      <div class="bg-white border border-gray-200 p-4 shadow-sm">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Ошибок / Сбросов</div>
        <div class="mt-2 text-2xl font-bold text-amber-600" id="kpi-errors">{initialKpi.totalErrors}</div>
        <div class="text-xs text-gray-400 mt-1">всего попыток в классе</div>
      </div>

      <div class="bg-white border border-gray-200 p-4 shadow-sm">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Статус системы</div>
        <div class="mt-2 text-lg font-bold text-gray-800 flex items-center gap-2">
          <span class="w-3 h-3 bg-green-500 inline-block"></span>
          <span>БД: 100% OK</span>
        </div>
        <div class="text-xs text-gray-400 mt-1" id="kpi-last-sync">Обновлено только что</div>
      </div>
    </section>

    <!-- Filters & Search Toolbar -->
    <section class="bg-white border border-gray-200 p-4 shadow-sm space-y-3">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
        
        <!-- Class Multi-Select Filter -->
        <div class="relative" id="class-filter-container">
          <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Класс учащихся</label>
          <button type="button" id="filter-class" class="w-full border border-gray-300 p-2 text-sm bg-white focus:outline-none focus:border-blue-600 flex items-center justify-between text-left cursor-pointer hover:bg-gray-50/80 transition select-none">
            <span id="class-select-label" class="truncate text-gray-800">Все классы</span>
            <span class="text-[10px] text-gray-400 ml-1.5 shrink-0">▼</span>
          </button>
          
          <!-- Dropdown menu with checkboxes -->
          <div id="class-dropdown-menu" class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-gray-300 shadow-xl z-40 p-2 space-y-1.5 max-h-72 overflow-y-auto">
            <div class="flex items-center justify-between pb-1.5 border-b border-gray-100 text-[11px] font-semibold">
              <button type="button" id="btn-select-all-classes" class="text-blue-600 hover:text-blue-800 cursor-pointer">Выбрать все</button>
              <button type="button" id="btn-clear-all-classes" class="text-gray-400 hover:text-gray-600 cursor-pointer">Сбросить</button>
            </div>
            <div class="space-y-1">
              {coursesData.map(c => (
                <label class="flex items-center gap-2 px-1.5 py-1 hover:bg-blue-50/60 cursor-pointer text-xs select-none">
                  <input type="checkbox" value={c.slug} class="class-checkbox w-3.5 h-3.5 text-blue-600 border-gray-300 rounded-0" />
                  <span class="text-gray-800">{c.name}</span>
                </label>
              ))}
            </div>
          </div>
        </div>

        <!-- Course Filter -->
        <div>
          <label for="filter-course" class="block text-xs font-semibold text-gray-600 uppercase mb-1">Курс задания</label>
          <select id="filter-course" class="w-full border border-gray-300 p-2 text-sm bg-white focus:outline-none focus:border-blue-600">
            <option value="all">Все курсы</option>
            {coursesData.map(c => (
              <option value={c.slug}>{c.name}</option>
            ))}
          </select>
        </div>

        <!-- Lesson Filter -->
        <div>
          <label for="filter-lesson" class="block text-xs font-semibold text-gray-600 uppercase mb-1">Урок</label>
          <select id="filter-lesson" class="w-full border border-gray-300 p-2 text-sm bg-white focus:outline-none focus:border-blue-600">
            <option value="all">Все уроки курса</option>
          </select>
        </div>

        <!-- Date / Period Filter -->
        <div>
          <label for="filter-date" class="block text-xs font-semibold text-gray-600 uppercase mb-1">Период / Дата</label>
          <select id="filter-date" class="w-full border border-gray-300 p-2 text-sm bg-white focus:outline-none focus:border-blue-600">
            <option value="today" selected>Сегодня ({todayStr})</option>
            <option value="all">За всё время</option>
            {availableDates.filter(d => d !== todayStr).map(d => (
              <option value={d}>{d}</option>
            ))}
          </select>
        </div>

        <!-- Student Search -->
        <div>
          <label for="filter-search" class="block text-xs font-semibold text-gray-600 uppercase mb-1">Поиск ученика</label>
          <input type="text" id="filter-search" placeholder="Фамилия или имя..." class="w-full border border-gray-300 p-2 text-sm focus:outline-none focus:border-blue-600" />
        </div>

        <!-- Test Account Toggle -->
        <div class="flex items-center pt-5">
          <label class="flex items-center gap-2 cursor-pointer text-xs font-medium text-gray-700 select-none">
            <input type="checkbox" id="filter-exclude-tests" checked class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-0" />
            <span>Скрыть тесты и Unknown</span>
          </label>
        </div>

      </div>
    </section>

    <!-- Main Classroom Progress Matrix Table -->
    <section class="bg-white border border-gray-200 shadow-sm overflow-hidden">
      
      <!-- Responsive Table Container with Horizontal Scroll -->
      <div class="overflow-x-auto w-full">
        <table class="w-full min-w-[1150px] border-collapse text-left text-sm" id="progress-table">
          <thead>
            <tr class="bg-gray-100 border-b border-gray-200 text-xs font-bold text-gray-700 uppercase tracking-wider select-none">
              <th class="p-3 w-12 text-center">#</th>
              <th class="p-3 cursor-pointer hover:bg-gray-200 transition" data-sort="name" title="Сортировка. Удерживайте Ctrl/Shift для мульти-сортировки">Ученик <span id="sort-name-icon">↕</span></th>
              <th class="p-3 cursor-pointer hover:bg-gray-200 transition" data-sort="class" title="Сортировка. Удерживайте Ctrl/Shift для мульти-сортировки">Класс <span id="sort-class-icon">↕</span></th>
              <th class="p-3 text-center cursor-pointer hover:bg-gray-200 transition" data-sort="status" title="Сортировка. Удерживайте Ctrl/Shift для мульти-сортировки">Статус урока <span id="sort-status-icon">↕</span></th>
              <th class="p-3 text-center cursor-pointer hover:bg-gray-200 transition" data-sort="attempts" title="Сортировка. Удерживайте Ctrl/Shift для мульти-сортировки">Забеги <span id="sort-attempts-icon">↕</span></th>
              <th class="p-3 text-center">Уровень 1</th>
              <th class="p-3 text-center">Уровень 2</th>
              <th class="p-3 text-center">Уровень 3</th>
              <th class="p-3 text-center cursor-pointer hover:bg-gray-200 transition" data-sort="sprint" title="Сортировка по скорости Лого-Шторма. Удерживайте Ctrl/Shift для мульти-сортировки">
                <div class="leading-tight font-bold text-cyan-950">⚡ Лого-Шторм</div>
                <div class="text-[10px] text-gray-500 font-normal normal-case">зн/мин и сл/мин</div>
                <span id="sort-sprint-icon">↕</span>
              </th>
              <th class="p-3 text-center cursor-pointer hover:bg-gray-200 transition" data-sort="time" title="Сортировка. Удерживайте Ctrl/Shift для мульти-сортировки">
                <div class="leading-tight">Время решения</div>
                <div class="text-[10px] text-gray-500 font-normal normal-case">Активное время</div>
                <span id="sort-time-icon">↕</span>
              </th>
              <th class="p-3 text-center cursor-pointer hover:bg-gray-200 transition" data-sort="errors" title="Сортировка. Удерживайте Ctrl/Shift для мульти-сортировки">Ошибки <span id="sort-errors-icon">↕</span></th>
              <th class="p-3 text-center cursor-pointer hover:bg-gray-200 transition" data-sort="last" title="Сортировка. Удерживайте Ctrl/Shift для мульти-сортировки">
                <div class="leading-tight">Был на уроке</div>
                <div class="text-[10px] text-gray-500 font-normal normal-case">Время ухода</div>
                <span id="sort-last-icon">↕</span>
              </th>
              <th class="p-3 text-center w-28">Действия</th>
            </tr>
          </thead>
          <tbody id="table-body" class="divide-y divide-gray-100">
            {initialStudents.length === 0 ? (
              <tr>
                <td colspan="12" class="p-12 text-center text-gray-500">
                  <div class="text-3xl mb-2">📋</div>
                  <div class="text-base font-semibold">Нет данных телеметрии по выбранным фильтрам</div>
                  <div class="text-xs text-gray-400 mt-1">Попробуйте выбрать другой класс, урок или период «За всё время»</div>
                </td>
              </tr>
            ) : (
              initialStudents.map((s, idx) => (
                <>
                  <tr class="hover:bg-blue-50/30 transition student-row" data-key={s.key}>
                    <td class="p-3 text-center font-mono text-xs text-gray-400">{idx + 1}</td>
                    <td class="p-3 font-semibold text-gray-900">
                      <div class="flex items-center gap-2">
                        <span class={`w-2.5 h-2.5 inline-block ${s.isActiveNow ? 'bg-green-500 animate-pulse' : 'bg-gray-300'}`} title={s.isActiveNow ? 'Активен сейчас' : 'Офлайн'}></span>
                        <span>{s.displayName}</span>
                      </div>
                    </td>
                    <td class="p-3 text-xs text-gray-600">{s.className}</td>
                    <td class="p-3 text-center">
                      {s.lessonStatus === 'hardcore_completed' && (
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-bold bg-red-100 text-red-800 border border-red-300">
                          💀 Хардкор сдан
                        </span>
                      )}
                      {s.lessonStatus === 'completed' && (
                        <div class="inline-flex flex-col items-center gap-0.5">
                          <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-bold bg-green-100 text-green-800 border border-green-300">
                            ✓ Пройден
                          </span>
                          {s.hardcoreLevelsConquered > 0 ? (
                            <span class="text-[10px] text-red-600 font-semibold" title={`Пройдено на хардкоре: ${s.hardcoreLevelsConquered} из 3 уровней`}>
                              💀 {s.hardcoreLevelsConquered}/3 ур.
                            </span>
                          ) : s.hardcoreStatus === 'failed' ? (
                            <span class="text-[10px] text-red-600 font-medium" title="Была попытка пройти на хардкоре, сброшена на ошибке">
                              💀 сброс
                            </span>
                          ) : s.hardcoreStatus === 'attempting' ? (
                            <span class="text-[10px] text-amber-600 font-medium" title="Сейчас решает в режиме хардкора">
                              💀 попытка
                            </span>
                          ) : null}
                        </div>
                      )}
                      {s.lessonStatus === 'in_progress' && (
                        <div class="inline-flex flex-col items-center gap-0.5">
                          <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-300">
                            ⏳ В процессе
                          </span>
                          {s.hardcoreStatus === 'attempting' && (
                            <span class="text-[10px] text-amber-600 font-medium">
                              💀 хардкор
                            </span>
                          )}
                        </div>
                      )}
                      {s.lessonStatus === 'not_started' && (
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium bg-gray-100 text-gray-500">
                          — Не начат
                        </span>
                      )}
                    </td>

                    <!-- Attempts Column with Expand Toggle -->
                    <td class="p-3 text-center">
                      <button type="button" class="toggle-attempts-btn inline-flex items-center gap-1.5 px-2 py-1 text-xs font-semibold rounded hover:bg-blue-100/60 border border-transparent hover:border-blue-200 cursor-pointer transition select-none" data-student-key={s.key} title="Нажмите, чтобы развернуть/свернуть забеги">
                        <span class="attempt-toggle-icon text-[10px] text-gray-500 font-mono">▶</span>
                        {s.attemptsCount > 1 || s.hardcoreAttemptsCount > 0 ? (
                          <div class="inline-flex flex-col items-center gap-0.5">
                            <span class={`inline-flex items-center gap-1 px-1.5 py-0.2 text-xs font-semibold ${s.hardcoreAttemptsCount > 0 ? 'bg-purple-100 text-purple-900 border border-purple-200' : 'bg-blue-50 text-blue-800 border border-blue-200'}`} title={`Всего забегов: ${s.attemptsCount}${s.bestNormalTimeSec ? ` • Лучшее обычное: ${formatSec(s.bestNormalTimeSec)}` : ''}${s.bestHardcoreTimeSec ? ` • Лучшее хардкор: ${formatSec(s.bestHardcoreTimeSec)}` : ''}`}>
                              {s.attemptsCount} {getAttemptsWord(s.attemptsCount)}
                            </span>
                            <span class="text-[10px] text-gray-500 font-medium">
                              {s.normalAttemptsCount} обычн.{s.hardcoreAttemptsCount > 0 ? ` • ${s.hardcoreAttemptsCount} 💀` : ''}
                            </span>
                          </div>
                        ) : (
                          <span class="inline-flex items-center px-1.5 py-0.2 text-xs font-medium bg-gray-100 text-gray-600 rounded">
                            1 забег
                          </span>
                        )}
                      </button>
                    </td>
                    
                    <!-- Levels 1-3 Badges -->
                    {[1, 2, 3].map((lvlNum) => {
                      const lvl = s.levels[lvlNum];
                      const stars = getStarsParts(lvl);
                      const resetWaveText = lvlNum === 3 && lvl?.lastResetWave ? ` • В.${lvl.lastResetWave}` : '';
                      const errText = lvl?.errors > 0 ? ` • ${lvl.errors} ош.` : '';
                      return (
                        <td class="p-3 text-center">
                          {lvl?.completed ? (
                            <span
                              class={`inline-block px-2 py-1 text-xs border ${lvl.hardcore ? 'bg-red-50 text-red-700 border-red-200 font-semibold' : 'bg-emerald-50 text-emerald-700 border-emerald-200 font-medium'}`}
                              title={lvlNum === 3 && lvl.lastResetWave ? `Последний сброс был на волне ${lvl.lastResetWave}` : undefined}
                            >
                              {lvl.hardcore ? '💀 ' : ''}✓ {formatSec(lvl.timeSpentSec)} • {lvl.errors} ош.
                            </span>
                          ) : lvl?.status === 'in_progress' ? (
                            <div class="inline-flex flex-col items-center gap-0.5 px-2 py-1 text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200">
                              <span>⏳ {formatSec(lvl.timeSpentSec)}{errText}</span>
                              {(stars || (lvlNum === 3 && lvl.lastResetWave)) && (
                                <span class="inline-flex items-center gap-1 text-[10px] leading-none">
                                  {stars && (
                                    <span title={stars.title} class="tracking-tighter">
                                      <span class="text-amber-500">{stars.filledStr}</span><span class="text-gray-300">{stars.emptyStr}</span>
                                    </span>
                                  )}
                                  {lvlNum === 3 && lvl.lastResetWave && (
                                    <span class="text-red-600 font-semibold" title={`Последний сброс на волне ${lvl.lastResetWave}`}>
                                      ↩ В.{lvl.lastResetWave}
                                    </span>
                                  )}
                                </span>
                              )}
                            </div>
                          ) : lvl?.status === 'reset' ? (
                            <span
                              class="inline-block px-2 py-1 text-xs font-medium bg-red-50 text-red-700 border border-red-200"
                              title={lvlNum === 3 && lvl.lastResetWave ? `Сброс на волне ${lvl.lastResetWave}` : undefined}
                            >
                              ❌ Сброс{resetWaveText}{errText}
                            </span>
                          ) : (
                            <span class="text-gray-300 text-xs">—</span>
                          )}
                        </td>
                      );
                    })}

                    <!-- Logo-Storm Sprint Speed -->
                    <td class="p-3 text-center whitespace-nowrap">
                      {s.sprintCpm ? (
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-semibold bg-cyan-100 text-cyan-800 border border-cyan-300" title={`Лого-Шторм: скорость ${s.sprintCpm} зн/мин (${s.sprintWpm || Math.round(s.sprintCpm / 5)} сл/мин)${s.bestSprintTimeSec ? `, время ${formatSec(s.bestSprintTimeSec)}` : ''}${s.sprintAccuracy ? `, точность ${s.sprintAccuracy}%` : ''}`}>
                          ⚡ {s.sprintCpm} <span class="text-[10px] text-cyan-900 font-normal">зн/мин</span> <span class="text-[10px] text-cyan-700 font-medium">({s.sprintWpm || Math.round(s.sprintCpm / 5)} сл/мин)</span>
                        </span>
                      ) : (
                        <span class="text-gray-300 text-xs">—</span>
                      )}
                    </td>

                    <!-- Total Time -->
                    <td class="p-3 text-center font-mono font-semibold text-gray-800">
                      {formatSec(s.totalActiveTimeSec)}
                    </td>

                    <!-- Total Errors -->
                    <td class="p-3 text-center">
                      <span class={`inline-block px-2 py-0.5 text-xs font-bold ${s.totalErrors > 15 ? 'bg-red-100 text-red-800' : s.totalErrors > 3 ? 'bg-amber-100 text-amber-800' : 'bg-green-100 text-green-800'}`}>
                        {s.totalErrors}
                      </span>
                    </td>

                    <!-- Last Activity -->
                    <td class="p-3 text-center text-xs text-gray-500 font-mono">
                      {s.lastSeen ? s.lastSeen.split(' ')[1] : '—'}
                    </td>

                    <!-- Actions / Details -->
                    <td class="p-3 text-center">
                      <button class="px-2 py-1 text-xs font-medium border border-gray-300 bg-gray-50 hover:bg-blue-50 hover:border-blue-300 text-gray-700 view-log-btn" data-student-key={s.key}>
                        Лог 📋
                      </button>
                    </td>
                  </tr>

                  {s.attempts && s.attempts.map((att: any, attIdx: number) => {
                    const isHc = att.mode === 'hardcore';
                    return (
                      <tr class="attempt-subrow hidden bg-slate-50/90 hover:bg-blue-50/40 border-b border-gray-200/60 text-xs transition select-none" data-parent-key={s.key}>
                        <td class="p-2.5 text-center font-mono text-[11px] text-gray-400">↳</td>
                        <td class="p-2.5 pl-7 text-xs font-medium text-gray-800">
                          <div class="flex items-center gap-1.5">
                            <span class="font-bold text-gray-700">Забег #{att.attemptNumber || (attIdx + 1)}</span>
                            {isHc ? (
                              <span class="px-1.5 py-0.2 text-[10px] font-bold bg-red-100 text-red-800 border border-red-200">💀 Хардкор</span>
                            ) : (
                              <span class="px-1.5 py-0.2 text-[10px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">Обычный</span>
                            )}
                          </div>
                        </td>
                        <td class="p-2.5 text-center text-[11px] text-gray-500 font-mono">
                          {(att.courseSlug || att.lessonId) ? (
                            <span class={att.courseSlug && att.courseSlug !== s.className ? 'text-indigo-700 font-semibold' : 'text-gray-600'}>
                              {[att.courseSlug, att.lessonId ? `Ур. ${att.lessonId}` : ''].filter(Boolean).join(' • ')}
                            </span>
                          ) : '—'}
                        </td>
                        <td class="p-2.5 text-center">
                          {att.status === 'completed' ? (
                            isHc ? (
                              <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-bold bg-red-100 text-red-800 border border-red-300">👑 Покорен</span>
                            ) : (
                              <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-bold bg-green-100 text-green-800 border border-green-300">✓ Завершён</span>
                            )
                          ) : att.status === 'failed' ? (
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-medium bg-red-50 text-red-700 border border-red-200">❌ Сброс</span>
                          ) : (
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-medium bg-amber-50 text-amber-700 border border-amber-200">⏳ В процессе</span>
                          )}
                        </td>
                        <td class="p-2.5 text-center text-[11px] text-gray-600 font-mono font-medium">
                          {att.completedLevelsCount}/3 ур.
                        </td>
                        {[1, 2, 3].map((lvlNum) => {
                          const lvl = att.levels[lvlNum];
                          const stars = getStarsParts(lvl);
                          const resetWaveText = lvlNum === 3 && lvl?.lastResetWave ? ` • В.${lvl.lastResetWave}` : '';
                          const errText = lvl?.errors > 0 ? ` • ${lvl.errors} ош.` : '';
                          return (
                            <td class="p-2.5 text-center">
                              {lvl?.completed ? (
                                <span class={`inline-block px-1.5 py-0.5 text-[11px] border ${isHc ? 'bg-red-50 text-red-700 border-red-200 font-semibold' : 'bg-emerald-50 text-emerald-700 border-emerald-200 font-medium'}`}>
                                  ✓ {formatSec(lvl.timeSpentSec)} • {lvl.errors} ош.
                                </span>
                              ) : lvl?.status === 'in_progress' ? (
                                <div class="inline-flex flex-col items-center gap-0.5 px-1.5 py-0.5 text-[11px] font-medium bg-amber-50 text-amber-700 border border-amber-200">
                                  <span>⏳ {formatSec(lvl.timeSpentSec)}{errText}</span>
                                  {(stars || (lvlNum === 3 && lvl.lastResetWave)) && (
                                    <span class="inline-flex items-center gap-1 text-[9px] leading-none">
                                      {stars && (
                                        <span title={stars.title} class="tracking-tighter">
                                          <span class="text-amber-500">{stars.filledStr}</span><span class="text-gray-300">{stars.emptyStr}</span>
                                        </span>
                                      )}
                                      {lvlNum === 3 && lvl.lastResetWave && (
                                        <span class="text-red-600 font-semibold" title={`Последний сброс на волне ${lvl.lastResetWave}`}>
                                          ↩ В.{lvl.lastResetWave}
                                        </span>
                                      )}
                                    </span>
                                  )}
                                </div>
                              ) : lvl?.status === 'reset' ? (
                                <span class="inline-block px-1.5 py-0.5 text-[11px] font-medium bg-red-50 text-red-700 border border-red-200">
                                  ❌ Сброс{resetWaveText}{errText}
                                </span>
                              ) : (
                                <span class="text-gray-300 text-[11px]">—</span>
                              )}
                            </td>
                          );
                        })}
                        <td class="p-2.5 text-center whitespace-nowrap">
                          {att.sprintCpm ? (
                            <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[11px] font-semibold bg-cyan-100 text-cyan-800 border border-cyan-300" title={`Лого-Шторм: скорость ${att.sprintCpm} зн/мин (${att.sprintWpm || Math.round(att.sprintCpm / 5)} сл/мин)${att.sprintTimeSec ? `, время ${formatSec(att.sprintTimeSec)}` : ''}`}>
                              ⚡ {att.sprintCpm} <span class="text-[9px] text-cyan-900 font-normal">зн/мин</span>
                            </span>
                          ) : (
                            <span class="text-gray-300 text-[11px]">—</span>
                          )}
                        </td>
                        <td class="p-2.5 text-center font-mono font-medium text-gray-800 text-xs">
                          {formatSec(att.totalTimeSec)}
                        </td>
                        <td class="p-2.5 text-center">
                          <span class={`inline-block px-1.5 py-0.2 text-[11px] font-bold ${att.errorsCount > 15 ? 'bg-red-100 text-red-800' : att.errorsCount > 3 ? 'bg-amber-100 text-amber-800' : att.errorsCount > 0 ? 'bg-amber-50 text-amber-700' : 'text-gray-400'}`}>
                            {att.errorsCount}
                          </span>
                        </td>
                        <td class="p-2.5 text-center text-[11px] text-gray-500 font-mono">
                          {att.lastActiveAt ? att.lastActiveAt.split(' ')[1] : '—'}
                        </td>
                        <td class="p-2.5 text-center text-gray-300 text-[11px]">—</td>
                      </tr>
                    );
                  })}
                </>
              ))
            )}
          </tbody>
        </table>
      </div>
      
      <!-- Footer Note -->
      <div class="p-3 bg-gray-50 border-t border-gray-200 text-xs text-gray-500 flex justify-between items-center">
        <span>Всего отображено: <strong id="footer-count">{initialStudents.length}</strong> учащихся <span class="hidden sm:inline text-gray-400 ml-2">• Зажмите Ctrl / Shift для мульти-сортировки</span></span>
        <span>Школьная сеть • Автономный сбор телеметрии</span>
      </div>
    </section>

    <!-- Student Detail Modal (Drill-down Inspector) -->
    <div id="detail-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
      <div class="bg-white border border-gray-300 max-w-3xl w-full max-h-[85vh] flex flex-col shadow-2xl">
        <div class="p-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
          <div>
            <h3 class="text-lg font-bold text-gray-900" id="modal-student-name">Детализация ученика</h3>
            <p class="text-xs text-gray-500" id="modal-student-sub">Класс • Статистика сессии</p>
          </div>
          <button id="modal-close-btn" class="p-1.5 text-gray-400 hover:text-gray-700 text-xl font-bold leading-none">
            ✕
          </button>
        </div>

        <div class="p-4 overflow-y-auto space-y-4 flex-1">
          <!-- Quick level summary cards in modal -->
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3" id="modal-level-cards">
            <!-- Will be populated by JS -->
          </div>

          <!-- Attempts / Runs List in Modal -->
          <div id="modal-attempts-container" class="space-y-2">
            <h4 class="text-xs font-bold text-gray-600 uppercase tracking-wider">История забегов (Попытки прохождения)</h4>
            <div class="space-y-2 max-h-56 overflow-y-auto" id="modal-attempts-list">
              <!-- Populated by JS -->
            </div>
          </div>

          <!-- History timeline -->
          <div>
            <h4 class="text-xs font-bold text-gray-600 uppercase tracking-wider mb-2">Хронология последних событий (Таймлайн)</h4>
            <div class="border border-gray-200 divide-y divide-gray-100 max-h-80 overflow-y-auto text-xs" id="modal-events-list">
              <!-- Populated by JS -->
            </div>
          </div>
        </div>

        <div class="p-3 bg-gray-50 border-t border-gray-200 flex justify-end">
          <button id="modal-ok-btn" class="px-4 py-1.5 text-xs font-semibold bg-gray-800 text-white hover:bg-gray-900">
            Закрыть
          </button>
        </div>
      </div>
    </div>

  </div>
</Layout>

<script is:inline define:vars={{ coursesData, initialStudents }}>
  let currentStudents = Array.isArray(initialStudents) ? [...initialStudents] : [];
  let isLive = true;
  let pollingInterval = null;
  let sortRules = [{ col: 'last', asc: false }];
  let activeStudent = null;
  const expandedStudentKeys = new Set();

  const classDropdownBtn = document.getElementById('filter-class');
  const classDropdownMenu = document.getElementById('class-dropdown-menu');
  const classSelectLabel = document.getElementById('class-select-label');
  const classContainer = document.getElementById('class-filter-container');
  const classCheckboxes = document.querySelectorAll('.class-checkbox');
  const btnSelectAllClasses = document.getElementById('btn-select-all-classes');
  const btnClearAllClasses = document.getElementById('btn-clear-all-classes');

  const courseSelect = document.getElementById('filter-course');
  const lessonSelect = document.getElementById('filter-lesson');
  const dateSelect = document.getElementById('filter-date');
  const searchInput = document.getElementById('filter-search');
  const excludeTestsCheckbox = document.getElementById('filter-exclude-tests');
  const tableBody = document.getElementById('table-body');
  const liveIndicator = document.getElementById('live-indicator');
  const toggleLiveBtn = document.getElementById('toggle-live-btn');
  const refreshBtn = document.getElementById('refresh-now-btn');
  const exportBtn = document.getElementById('export-btn');
  const modal = document.getElementById('detail-modal');

  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.has('date') && dateSelect) {
    dateSelect.value = urlParams.get('date');
  }
  if (urlParams.has('search') && searchInput) {
    searchInput.value = urlParams.get('search');
  }
  if (urlParams.has('course') && courseSelect) {
    courseSelect.value = urlParams.get('course');
  }
  if (urlParams.has('lesson') && lessonSelect) {
    lessonSelect.value = urlParams.get('lesson');
  }

  function getSelectedClasses() {
    const checked = Array.from(document.querySelectorAll('.class-checkbox:checked'));
    return checked.map(cb => cb.value);
  }

  function getSelectedClassesParam() {
    const sel = getSelectedClasses();
    if (sel.length === 0 || sel.length === classCheckboxes.length) return 'all';
    return sel.join(',');
  }

  function updateClassSelectLabel() {
    const sel = getSelectedClasses();
    if (!classSelectLabel) return;
    if (sel.length === 0 || sel.length === classCheckboxes.length) {
      classSelectLabel.textContent = 'Все классы';
    } else if (sel.length === 1) {
      const course = coursesData.find(c => c.slug === sel[0]);
      classSelectLabel.textContent = course ? course.name : sel[0];
    } else {
      classSelectLabel.textContent = `Выбрано: ${sel.length} кл.`;
    }
  }

  if (classDropdownBtn) {
    Object.defineProperty(classDropdownBtn, 'value', {
      get: () => getSelectedClassesParam(),
      configurable: true
    });
  }

  // Populate lessons dropdown based on selected course or selected classes
  function updateLessonsDropdown() {
    const selectedCourseSlug = courseSelect ? courseSelect.value : 'all';
    const selected = getSelectedClasses();
    const prevVal = lessonSelect.value;
    lessonSelect.innerHTML = '<option value="all">Все уроки курса / выборки</option>';

    if (selectedCourseSlug !== 'all') {
      const course = coursesData.find(c => c.slug === selectedCourseSlug);
      if (course) {
        course.lessons.forEach(l => {
          const opt = document.createElement('option');
          opt.value = `Урок ${l.id}`;
          opt.textContent = `Урок ${l.id}: ${l.topic.substring(0, 48)}${l.topic.length > 48 ? '...' : ''}`;
          lessonSelect.appendChild(opt);
        });
      }
    } else {
      const isSpecificSelection = selected.length > 0 && selected.length < classCheckboxes.length;

      if (isSpecificSelection) {
        // 1. Lessons of the selected classes first (primary context)
        const selectedCourses = coursesData.filter(c => selected.includes(c.slug));
        selectedCourses.forEach(c => {
          const group = document.createElement('optgroup');
          group.label = `★ Выбранный класс: ${c.name}`;
          c.lessons.forEach(l => {
            const opt = document.createElement('option');
            opt.value = `${c.slug}::Урок ${l.id}`;
            opt.textContent = `Урок ${l.id}: ${l.topic.substring(0, 48)}${l.topic.length > 48 ? '...' : ''}`;
            group.appendChild(opt);
          });
          lessonSelect.appendChild(group);
        });

        // 2. Other courses available for cross-course evaluation & inter-class competitions
        const otherCourses = coursesData.filter(c => !selected.includes(c.slug));
        otherCourses.forEach(c => {
          const group = document.createElement('optgroup');
          group.label = `Другой курс: ${c.name}`;
          c.lessons.forEach(l => {
            const opt = document.createElement('option');
            opt.value = `${c.slug}::Урок ${l.id}`;
            opt.textContent = `${c.name.split('_')[0]} • Урок ${l.id}: ${l.topic.substring(0, 42)}${l.topic.length > 42 ? '...' : ''}`;
            group.appendChild(opt);
          });
          lessonSelect.appendChild(group);
        });
      } else {
        // All classes or none selected: list each course
        coursesData.forEach(c => {
          const group = document.createElement('optgroup');
          group.label = `Курс: ${c.name}`;
          c.lessons.forEach(l => {
            const opt = document.createElement('option');
            opt.value = `${c.slug}::Урок ${l.id}`;
            opt.textContent = `${c.name.split('_')[0]} • Урок ${l.id}: ${l.topic.substring(0, 42)}${l.topic.length > 42 ? '...' : ''}`;
            group.appendChild(opt);
          });
          lessonSelect.appendChild(group);
        });
      }

      // Generic lesson number group for rapid selection
      const genericGroup = document.createElement('optgroup');
      genericGroup.label = '— Быстрый выбор по номеру (любой курс) —';
      for (let i = 1; i <= 34; i++) {
        const opt = document.createElement('option');
        opt.value = `Урок ${i}`;
        opt.textContent = `Урок ${i}`;
        genericGroup.appendChild(opt);
      }
      lessonSelect.appendChild(genericGroup);
    }

    if (prevVal && Array.from(lessonSelect.options).some(o => o.value === prevVal)) {
      lessonSelect.value = prevVal;
    }
  }

  function formatTime(sec) {
    if (!sec || sec <= 0) return '0с';
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    if (m === 0) return `${s}с`;
    return `${m}м ${s}с`;
  }

  function getAttemptsWord(count) {
    const mod10 = count % 10;
    const mod100 = count % 100;
    if (mod100 >= 11 && mod100 <= 19) return 'забегов';
    if (mod10 === 1) return 'забег';
    if (mod10 >= 2 && mod10 <= 4) return 'забега';
    return 'забегов';
  }

  const COURSE_SHORT_LABELS = {
    '7-класс': '7 кл',
    '8-класс': '8 кл',
    '9-класс': '9 кл',
    '10-класс_базовый': '10 баз',
    '10-класс_углубленный': '10 угл',
    '11-класс_базовый': '11 баз',
    '11-класс_углубленный': '11 угл'
  };

  function getCourseShortLabel(slug) {
    if (!slug) return '';
    return COURSE_SHORT_LABELS[slug] || slug;
  }

  function getLessonTopicTitle(courseSlug, lessonId) {
    if (!courseSlug || !lessonId) return '';
    const c = coursesData.find(x => x.slug === courseSlug);
    const l = c?.lessons?.find(x => String(x.id) === String(lessonId));
    return l ? `${c.name} • Урок ${lessonId}: ${l.topic}` : `${courseSlug} • Урок ${lessonId}`;
  }

  function renderCourseLessonPill(courseSlug, lessonId, studentClass) {
    if (!courseSlug && !lessonId) return '';
    const shortCourse = getCourseShortLabel(courseSlug);
    const lessonPart = lessonId ? `Ур. ${lessonId}` : '';
    const text = [shortCourse, lessonPart].filter(Boolean).join(' • ');
    const isCrossCourse = !!(courseSlug && studentClass && courseSlug !== studentClass);
    const title = getLessonTopicTitle(courseSlug, lessonId);
    if (isCrossCourse) {
      return `<span class="inline-flex items-center gap-0.5 px-1.5 py-0.2 text-[10px] font-semibold bg-indigo-50 text-indigo-800 border border-indigo-300" title="Урок другого класса: ${title}">🔀 ${text}</span>`;
    }
    return `<span class="inline-flex items-center px-1.5 py-0.2 text-[10px] font-medium bg-gray-100 text-gray-600 border border-gray-200" title="${title}">${text}</span>`;
  }

  // Fetch telemetry from server API
  async function fetchTelemetry() {
    const cls = getSelectedClassesParam();
    let crs = courseSelect ? courseSelect.value : 'all';
    let lsn = lessonSelect.value;
    if (lsn && lsn.includes('::')) {
      const [optCourse, optLesson] = lsn.split('::');
      if (crs === 'all' && optCourse) {
        crs = optCourse;
      }
      lsn = optLesson || 'all';
    }
    const dt = dateSelect.value;
    const exc = excludeTestsCheckbox.checked ? '1' : '0';
    const q = encodeURIComponent(searchInput.value.trim());

    try {
      const res = await fetch(`/api/teacher/stats?class=${encodeURIComponent(cls)}&course=${encodeURIComponent(crs)}&lesson=${encodeURIComponent(lsn)}&date=${encodeURIComponent(dt)}&exclude_tests=${exc}&search=${q}`);
      if (!res.ok) throw new Error('Network error');
      const data = await res.json();
      
      if (data.success) {
        currentStudents = data.students || [];
        updateKpi(data.kpi);
        renderTable();
        document.getElementById('kpi-last-sync').textContent = `Обновлено: ${new Date().toLocaleTimeString('ru-RU')}`;
      }
    } catch (e) {
      console.warn('Telemetry fetch error:', e);
      document.getElementById('kpi-last-sync').textContent = 'Ошибка сети при обновлении';
    }
  }

  function updateKpi(kpi) {
    if (!kpi) return;
    document.getElementById('kpi-total').textContent = kpi.totalStudents;
    document.getElementById('kpi-completed').textContent = kpi.completedCount;
    document.getElementById('kpi-hardcore').innerHTML = `<span>💀</span><span>${kpi.hardcoreCount}</span>`;
    document.getElementById('kpi-in-progress').textContent = kpi.inProgressCount;
    document.getElementById('kpi-avg-time').textContent = formatTime(kpi.avgTimeSec);
    document.getElementById('kpi-errors').textContent = kpi.totalErrors;

    const activeCount = currentStudents.filter(s => s.isActiveNow).length;
    document.getElementById('kpi-active').textContent = activeCount;
  }

  function updateSortIcons() {
    const cols = ['name', 'class', 'status', 'attempts', 'sprint', 'time', 'errors', 'last'];
    const superscripts = ['¹', '²', '³', '⁴', '⁵', '⁶', '⁷', '⁸'];

    cols.forEach(col => {
      const icon = document.getElementById(`sort-${col}-icon`);
      if (!icon) return;

      const ruleIdx = sortRules.findIndex(r => r.col === col);
      if (ruleIdx !== -1) {
        const rule = sortRules[ruleIdx];
        const arrow = rule.asc ? '↑' : '↓';
        if (sortRules.length > 1) {
          const num = superscripts[ruleIdx] || `${ruleIdx + 1}`;
          icon.textContent = `${num}${arrow}`;
          icon.title = `Приоритет ${ruleIdx + 1}: ${rule.asc ? 'по возрастанию' : 'по убыванию'}`;
        } else {
          icon.textContent = arrow;
          icon.title = rule.asc ? 'По возрастанию' : 'По убыванию';
        }
      } else {
        icon.textContent = '↕';
        icon.title = 'Не отсортировано';
      }
    });
  }

  function setSort(col, isMulti = false) {
    const defaultAsc = (col === 'name' || col === 'class');
    const existingIdx = sortRules.findIndex(r => r.col === col);

    if (isMulti) {
      if (existingIdx !== -1) {
        // If already in rules: toggle asc <-> desc
        sortRules[existingIdx].asc = !sortRules[existingIdx].asc;
      } else {
        // Append secondary/tertiary sort rule
        sortRules.push({ col, asc: defaultAsc });
      }
    } else {
      // Single column click
      if (sortRules.length === 1 && sortRules[0].col === col) {
        sortRules[0].asc = !sortRules[0].asc;
      } else {
        sortRules = [{ col, asc: defaultAsc }];
      }
    }

    renderTable();
  }

  function compareStudents(a, b, col, asc) {
    let diff = 0;
    if (col === 'name') {
      const valA = (a.displayName || '').toLowerCase();
      const valB = (b.displayName || '').toLowerCase();
      diff = valA.localeCompare(valB, 'ru');
    } else if (col === 'class') {
      const valA = a.className || '';
      const valB = b.className || '';
      diff = valA.localeCompare(valB, 'ru');
    } else if (col === 'status') {
      const statusWeight = {
        'hardcore_completed': 4,
        'completed': 3,
        'in_progress': 2,
        'not_started': 1
      };
      diff = (statusWeight[a.lessonStatus] || 0) - (statusWeight[b.lessonStatus] || 0);
    } else if (col === 'attempts') {
      diff = (a.attemptsCount || 1) - (b.attemptsCount || 1);
    } else if (col === 'sprint') {
      const valA = (a.sprintCpm !== null && a.sprintCpm !== undefined) ? a.sprintCpm : ((a.bestSprintTimeSec !== null && a.bestSprintTimeSec !== undefined) ? 1 : (asc ? Infinity : -Infinity));
      const valB = (b.sprintCpm !== null && b.sprintCpm !== undefined) ? b.sprintCpm : ((b.bestSprintTimeSec !== null && b.bestSprintTimeSec !== undefined) ? 1 : (asc ? Infinity : -Infinity));
      diff = valA - valB;
    } else if (col === 'time') {
      diff = (a.totalActiveTimeSec || 0) - (b.totalActiveTimeSec || 0);
    } else if (col === 'errors') {
      diff = (a.totalErrors || 0) - (b.totalErrors || 0);
    } else if (col === 'last') {
      const timeA = a.lastSeen ? new Date(a.lastSeen + 'Z').getTime() : 0;
      const timeB = b.lastSeen ? new Date(b.lastSeen + 'Z').getTime() : 0;
      diff = timeA - timeB;
    }
    return asc ? diff : -diff;
  }

  function renderTable() {
    const tbody = tableBody;
    updateSortIcons();
    document.getElementById('footer-count').textContent = currentStudents.length;

    if (currentStudents.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="13" class="p-12 text-center text-gray-500">
            <div class="text-3xl mb-2">📋</div>
            <div class="text-base font-semibold">Нет данных телеметрии по выбранным фильтрам</div>
            <div class="text-xs text-gray-400 mt-1">Попробуйте выбрать другой класс, урок или период «За всё время»</div>
          </td>
        </tr>
      `;
      return;
    }

    // Sort students with chained multi-column rules
    const sorted = [...currentStudents].sort((a, b) => {
      for (const rule of sortRules) {
        const diff = compareStudents(a, b, rule.col, rule.asc);
        if (diff !== 0) return diff;
      }
      return (a.displayName || '').localeCompare(b.displayName || '', 'ru');
    });

    let html = '';
    sorted.forEach((s, idx) => {
      let statusBadge = '';
      if (s.lessonStatus === 'hardcore_completed') {
        statusBadge = '<span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-bold bg-red-100 text-red-800 border border-red-300">💀 Хардкор сдан</span>';
      } else if (s.lessonStatus === 'completed') {
        let extra = '';
        if (s.hardcoreLevelsConquered > 0) extra = `<span class="text-[10px] text-red-600 font-semibold" title="Пройдено на хардкоре: ${s.hardcoreLevelsConquered} из 3 уровней">💀 ${s.hardcoreLevelsConquered}/3 ур.</span>`;
        else if (s.hardcoreStatus === 'failed') extra = '<span class="text-[10px] text-red-600 font-medium" title="Была попытка пройти на хардкоре, сброшена на ошибке">💀 сброс</span>';
        else if (s.hardcoreStatus === 'attempting') extra = '<span class="text-[10px] text-amber-600 font-medium" title="Сейчас решает в режиме хардкора">💀 попытка</span>';
        statusBadge = `<div class="inline-flex flex-col items-center gap-0.5"><span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-bold bg-green-100 text-green-800 border border-green-300">✓ Пройден</span>${extra}</div>`;
      } else if (s.lessonStatus === 'in_progress') {
        let extra = s.hardcoreStatus === 'attempting' ? '<span class="text-[10px] text-amber-600 font-medium">💀 хардкор</span>' : '';
        statusBadge = `<div class="inline-flex flex-col items-center gap-0.5"><span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-300">⏳ В процессе</span>${extra}</div>`;
      } else {
        statusBadge = '<span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium bg-gray-100 text-gray-500">— Не начат</span>';
      }

      const workedList = Array.isArray(s.workedLessons) && s.workedLessons.length > 0
        ? s.workedLessons
        : (s.lastCourseSlug && s.lastLessonId ? [{ courseSlug: s.lastCourseSlug, lessonId: s.lastLessonId }] : []);
      const workedPillsHtml = workedList.length > 0
        ? `<div class="flex flex-wrap items-center justify-center gap-1 mt-0.5">${workedList.slice(0, 3).map(wl => renderCourseLessonPill(wl.courseSlug, wl.lessonId, s.className)).join('')}${workedList.length > 3 ? `<span class="text-[10px] text-gray-400">+${workedList.length - 3}</span>` : ''}</div>`
        : '';
      const princeBadgeHtml = s.princeCompleted
        ? `<span class="inline-flex items-center gap-1 px-1.5 py-0.2 text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-400 mt-0.5" title="Пройден бонусный уровень Prince of Persia${s.princeBestTimeSec ? ` • время: ${formatTime(s.princeBestTimeSec)}` : ''}">⚔️ Принц Персии</span>`
        : '';

      const isExpanded = expandedStudentKeys.has(s.key);
      const toggleIcon = isExpanded ? '▼' : '▶';

      let attemptsBadge = '';
      if ((s.attemptsCount && s.attemptsCount > 1) || (s.hardcoreAttemptsCount && s.hardcoreAttemptsCount > 0)) {
        const hcClass = s.hardcoreAttemptsCount > 0 ? 'bg-purple-100 text-purple-900 border-purple-200' : 'bg-blue-50 text-blue-800 border-blue-200';
        const bestInfo = `${s.bestNormalTimeSec ? ` • Лучшее обычное: ${formatTime(s.bestNormalTimeSec)}` : ''}${s.bestHardcoreTimeSec ? ` • Лучшее хардкор: ${formatTime(s.bestHardcoreTimeSec)}` : ''}`;
        const hcSub = s.hardcoreAttemptsCount > 0 ? ` • ${s.hardcoreAttemptsCount} 💀` : '';
        attemptsBadge = `
          <button type="button" class="toggle-attempts-btn inline-flex items-center gap-1.5 px-2 py-1 text-xs font-semibold rounded hover:bg-blue-100/60 border border-transparent hover:border-blue-200 cursor-pointer transition select-none" data-student-key="${s.key}" title="Нажмите, чтобы развернуть/свернуть забеги">
            <span class="attempt-toggle-icon text-[10px] text-gray-500 font-mono">${toggleIcon}</span>
            <div class="inline-flex flex-col items-center gap-0.5">
              <span class="inline-flex items-center gap-1 px-1.5 py-0.2 text-xs font-semibold ${hcClass} border" title="Всего забегов: ${s.attemptsCount}${bestInfo}">
                ${s.attemptsCount} ${getAttemptsWord(s.attemptsCount)}
              </span>
              <span class="text-[10px] text-gray-500 font-medium">
                ${s.normalAttemptsCount || 0} обычн.${hcSub}
              </span>
            </div>
          </button>
        `;
      } else {
        attemptsBadge = `
          <button type="button" class="toggle-attempts-btn inline-flex items-center gap-1.5 px-2 py-1 text-xs font-medium rounded hover:bg-gray-200/70 border border-transparent hover:border-gray-300 cursor-pointer transition select-none" data-student-key="${s.key}" title="Нажмите, чтобы развернуть/свернуть забег">
            <span class="attempt-toggle-icon text-[10px] text-gray-500 font-mono">${toggleIcon}</span>
            <span class="inline-flex items-center px-1.5 py-0.2 text-xs font-medium bg-gray-100 text-gray-600 rounded">
              1 забег
            </span>
          </button>
        `;
      }

      function renderStageStarsHtml(lvl, small = false) {
        if (!lvl || !lvl.currentStage || !lvl.totalStages) return '';
        const total = Math.max(1, lvl.totalStages);
        const filled = Math.max(0, Math.min(total, lvl.currentStage));
        const empty = Math.max(0, total - filled);
        const sz = small ? 'text-[9px]' : 'text-[10px]';
        return `<span class="tracking-tighter leading-none ${sz}" title="Этап ${lvl.currentStage} из ${total}"><span class="text-amber-500">${'★'.repeat(filled)}</span><span class="text-gray-300">${'☆'.repeat(empty)}</span></span>`;
      }

      function levelBadge(lvl, lvlNum) {
        if (!lvl) return '<span class="text-gray-300 text-xs">—</span>';
        const resetWaveText = lvlNum === 3 && lvl.lastResetWave ? ` • В.${lvl.lastResetWave}` : '';
        const errText = lvl.errors > 0 ? ` • ${lvl.errors} ош.` : '';
        if (lvl.completed) {
          const hc = lvl.hardcore ? '💀 ' : '';
          const hcClass = lvl.hardcore ? 'bg-red-50 text-red-700 border-red-200 font-semibold' : 'bg-emerald-50 text-emerald-700 border-emerald-200 font-medium';
          const titleAttr = lvlNum === 3 && lvl.lastResetWave ? ` title="Последний сброс был на волне ${lvl.lastResetWave}"` : '';
          return `<span class="inline-block px-2 py-1 text-xs ${hcClass} border"${titleAttr}>${hc}✓ ${formatTime(lvl.timeSpentSec)} • ${lvl.errors} ош.</span>`;
        }
        if (lvl.status === 'in_progress') {
          const starsHtml = renderStageStarsHtml(lvl, false);
          const resetSub = lvlNum === 3 && lvl.lastResetWave
            ? `<span class="text-red-600 font-semibold" title="Последний сброс на волне ${lvl.lastResetWave}">↩ В.${lvl.lastResetWave}</span>`
            : '';
          const subLine = (starsHtml || resetSub)
            ? `<span class="inline-flex items-center gap-1 leading-none">${starsHtml}${resetSub}</span>`
            : '';
          return `<div class="inline-flex flex-col items-center gap-0.5 px-2 py-1 text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200"><span>⏳ ${formatTime(lvl.timeSpentSec)}${errText}</span>${subLine}</div>`;
        }
        if (lvl.status === 'reset') {
          const titleAttr = lvlNum === 3 && lvl.lastResetWave ? ` title="Сброс на волне ${lvl.lastResetWave}"` : '';
          return `<span class="inline-block px-2 py-1 text-xs font-medium bg-red-50 text-red-700 border border-red-200"${titleAttr}>❌ Сброс${resetWaveText}${errText}</span>`;
        }
        return '<span class="text-gray-300 text-xs">—</span>';
      }

      const errClass = s.totalErrors > 15 ? 'bg-red-100 text-red-800' : s.totalErrors > 3 ? 'bg-amber-100 text-amber-800' : 'bg-green-100 text-green-800';
      const lastTime = s.lastSeen ? s.lastSeen.split(' ')[1] : '—';
      const activeDot = s.isActiveNow ? '<span class="w-2.5 h-2.5 inline-block bg-green-500 animate-pulse" title="Активен прямо сейчас"></span>' : '<span class="w-2.5 h-2.5 inline-block bg-gray-300" title="Офлайн"></span>';

      let sprintBadge = '<span class="text-gray-300 text-xs">—</span>';
      if (s.sprintCpm) {
        const wpm = s.sprintWpm || Math.round(s.sprintCpm / 5);
        const timeInfo = s.bestSprintTimeSec !== null && s.bestSprintTimeSec !== undefined ? `, время ${formatTime(s.bestSprintTimeSec)}` : '';
        const accInfo = s.sprintAccuracy ? `, точность ${s.sprintAccuracy}%` : '';
        sprintBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-semibold bg-cyan-100 text-cyan-800 border border-cyan-300" title="Лого-Шторм: скорость ${s.sprintCpm} зн/мин (${wpm} сл/мин)${timeInfo}${accInfo}">⚡ ${s.sprintCpm} <span class="text-[10px] text-cyan-900 font-normal">зн/мин</span> <span class="text-[10px] text-cyan-700 font-medium">(${wpm} сл/мин)</span></span>`;
      }

      html += `
        <tr class="hover:bg-blue-50/30 transition student-row" data-key="${s.key}">
          <td class="p-3 text-center font-mono text-xs text-gray-400">${idx + 1}</td>
          <td class="p-3 font-semibold text-gray-900">
            <div class="flex items-center gap-2">
              ${activeDot}
              <span>${s.displayName}</span>
            </div>
          </td>
          <td class="p-3 text-xs text-gray-600">${s.className}</td>
          <td class="p-3 text-center"><div class="inline-flex flex-col items-center gap-0.5">${statusBadge}${princeBadgeHtml}${workedPillsHtml}</div></td>
          <td class="p-3 text-center">${attemptsBadge}</td>
          <td class="p-3 text-center">${levelBadge(s.levels[1], 1)}</td>
          <td class="p-3 text-center">${levelBadge(s.levels[2], 2)}</td>
          <td class="p-3 text-center">${levelBadge(s.levels[3], 3)}</td>
          <td class="p-3 text-center whitespace-nowrap">${sprintBadge}</td>
          <td class="p-3 text-center font-mono font-semibold text-gray-800">${formatTime(s.totalActiveTimeSec)}</td>
          <td class="p-3 text-center"><span class="inline-block px-2 py-0.5 text-xs font-bold ${errClass}">${s.totalErrors}</span></td>
          <td class="p-3 text-center text-xs text-gray-500 font-mono">${lastTime}</td>
          <td class="p-3 text-center">
            <button class="px-2 py-1 text-xs font-medium border border-gray-300 bg-gray-50 hover:bg-blue-50 hover:border-blue-300 text-gray-700 view-log-btn" data-student-key="${s.key}">
              Лог 📋
            </button>
          </td>
        </tr>
      `;

      if (s.attempts && s.attempts.length > 0) {
        s.attempts.forEach((att, attIdx) => {
          const isHc = att.mode === 'hardcore';
          let attStatusBadge = '';
          if (att.status === 'completed') {
            attStatusBadge = isHc
              ? '<span class="inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-bold bg-red-100 text-red-800 border border-red-300">👑 Покорен</span>'
              : '<span class="inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-bold bg-green-100 text-green-800 border border-green-300">✓ Завершён</span>';
          } else if (att.status === 'failed') {
            attStatusBadge = '<span class="inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-medium bg-red-50 text-red-700 border border-red-200">❌ Сброс</span>';
          } else {
            attStatusBadge = '<span class="inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-medium bg-amber-50 text-amber-700 border border-amber-200">⏳ В процессе</span>';
          }

          function subLevelBadge(lvl, lvlNum) {
            if (!lvl) return '<span class="text-gray-300 text-[11px]">—</span>';
            const resetWaveText = lvlNum === 3 && lvl.lastResetWave ? ` • В.${lvl.lastResetWave}` : '';
            const errText = lvl.errors > 0 ? ` • ${lvl.errors} ош.` : '';
            if (lvl.completed) {
              const hc = isHc ? '💀 ' : '';
              const hcClass = isHc ? 'bg-red-50 text-red-700 border-red-200 font-semibold' : 'bg-emerald-50 text-emerald-700 border-emerald-200 font-medium';
              return `<span class="inline-block px-1.5 py-0.5 text-[11px] ${hcClass} border">${hc}✓ ${formatTime(lvl.timeSpentSec)} • ${lvl.errors} ош.</span>`;
            }
            if (lvl.status === 'in_progress') {
              const starsHtml = renderStageStarsHtml(lvl, true);
              const resetSub = lvlNum === 3 && lvl.lastResetWave
                ? `<span class="text-red-600 font-semibold" title="Последний сброс на волне ${lvl.lastResetWave}">↩ В.${lvl.lastResetWave}</span>`
                : '';
              const subLine = (starsHtml || resetSub)
                ? `<span class="inline-flex items-center gap-1 leading-none">${starsHtml}${resetSub}</span>`
                : '';
              return `<div class="inline-flex flex-col items-center gap-0.5 px-1.5 py-0.5 text-[11px] font-medium bg-amber-50 text-amber-700 border border-amber-200"><span>⏳ ${formatTime(lvl.timeSpentSec)}${errText}</span>${subLine}</div>`;
            }
            if (lvl.status === 'reset') {
              return `<span class="inline-block px-1.5 py-0.5 text-[11px] font-medium bg-red-50 text-red-700 border border-red-200">❌ Сброс${resetWaveText}${errText}</span>`;
            }
            return '<span class="text-gray-300 text-[11px]">—</span>';
          }

          const attErrClass = att.errorsCount > 15 ? 'bg-red-100 text-red-800' : att.errorsCount > 3 ? 'bg-amber-100 text-amber-800' : att.errorsCount > 0 ? 'bg-amber-50 text-amber-700' : 'text-gray-400';
          const attLastTime = att.lastActiveAt ? att.lastActiveAt.split(' ')[1] : '—';
          const subHiddenClass = isExpanded ? '' : 'hidden';

          const attSprintBadge = att.sprintCpm
            ? `<span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[11px] font-semibold bg-cyan-100 text-cyan-800 border border-cyan-300" title="Лого-Шторм: скорость ${att.sprintCpm} зн/мин (${att.sprintWpm || Math.round(att.sprintCpm / 5)} сл/мин)${att.sprintTimeSec ? `, время ${formatTime(att.sprintTimeSec)}` : ''}">⚡ ${att.sprintCpm} <span class="text-[9px] text-cyan-900 font-normal">зн/мин</span></span>`
            : '<span class="text-gray-300 text-[11px]">—</span>';

          html += `
            <tr class="attempt-subrow ${subHiddenClass} bg-slate-50/90 hover:bg-blue-50/40 border-b border-gray-200/60 text-xs transition select-none" data-parent-key="${s.key}">
              <td class="p-2.5 text-center font-mono text-[11px] text-gray-400">↳</td>
              <td class="p-2.5 pl-7 text-xs font-medium text-gray-800">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="font-bold text-gray-700">Забег #${att.attemptNumber || (attIdx + 1)}</span>
                  ${isHc ? '<span class="px-1.5 py-0.2 text-[10px] font-bold bg-red-100 text-red-800 border border-red-200">💀 Хардкор</span>' : '<span class="px-1.5 py-0.2 text-[10px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">Обычный</span>'}
                  ${att.princeCompleted ? '<span class="px-1.5 py-0.2 text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-300">⚔️ Принц</span>' : ''}
                </div>
              </td>
              <td class="p-2.5 text-center text-[11px] text-gray-500">${(att.courseSlug || att.lessonId) ? renderCourseLessonPill(att.courseSlug, att.lessonId, s.className) : '<span class="text-gray-400 font-mono">—</span>'}</td>
              <td class="p-2.5 text-center">${attStatusBadge}</td>
              <td class="p-2.5 text-center text-[11px] text-gray-600 font-mono font-medium">${att.completedLevelsCount}/3 ур.</td>
              <td class="p-2.5 text-center">${subLevelBadge(att.levels[1], 1)}</td>
              <td class="p-2.5 text-center">${subLevelBadge(att.levels[2], 2)}</td>
              <td class="p-2.5 text-center">${subLevelBadge(att.levels[3], 3)}</td>
              <td class="p-2.5 text-center whitespace-nowrap">${attSprintBadge}</td>
              <td class="p-2.5 text-center font-mono font-medium text-gray-800 text-xs">${formatTime(att.totalTimeSec)}</td>
              <td class="p-2.5 text-center"><span class="inline-block px-1.5 py-0.2 text-[11px] font-bold ${attErrClass}">${att.errorsCount}</span></td>
              <td class="p-2.5 text-center text-[11px] text-gray-500 font-mono">${attLastTime}</td>
              <td class="p-2.5 text-center text-gray-300 text-[11px]">—</td>
            </tr>
          `;
        });
      }
    });

    tbody.innerHTML = html;
  }

  // Delegated table clicks for attempt expand/collapse and log modal
  tableBody.addEventListener('click', (e) => {
    const toggleBtn = e.target.closest('.toggle-attempts-btn');
    if (toggleBtn) {
      e.stopPropagation();
      const key = toggleBtn.getAttribute('data-student-key');
      if (!key) return;
      if (expandedStudentKeys.has(key)) {
        expandedStudentKeys.delete(key);
      } else {
        expandedStudentKeys.add(key);
      }
      const isNowExpanded = expandedStudentKeys.has(key);
      const iconSpan = toggleBtn.querySelector('.attempt-toggle-icon');
      if (iconSpan) iconSpan.textContent = isNowExpanded ? '▼' : '▶';
      const subrows = tableBody.querySelectorAll(`.attempt-subrow[data-parent-key="${key}"]`);
      subrows.forEach(r => {
        if (isNowExpanded) r.classList.remove('hidden');
        else r.classList.add('hidden');
      });
      return;
    }

    const logBtn = e.target.closest('.view-log-btn');
    if (logBtn) {
      const key = logBtn.getAttribute('data-student-key');
      const student = currentStudents.find(s => s.key === key) || (Array.isArray(initialStudents) && initialStudents.find(s => s.key === key));
      if (student) openModal(student);
    }
  });

  function openModal(student) {
    activeStudent = student;
    document.getElementById('modal-student-name').textContent = student.displayName;
    const sprintSub = student.sprintCpm ? ` • ⚡ Скорость Лого-Шторма: ${student.sprintCpm} зн/мин (${student.sprintWpm || Math.round(student.sprintCpm / 5)} сл/мин)` : '';
    document.getElementById('modal-student-sub').textContent = `${student.className} • Чистое время: ${formatTime(student.totalActiveTimeSec)} • Всего ошибок: ${student.totalErrors} • Забегов: ${student.attemptsCount || 1}${sprintSub}`;

    // Render level summary cards
    const cards = document.getElementById('modal-level-cards');
    let cardsHtml = '';
    [1, 2, 3].forEach(lvlNum => {
      const l = student.levels[lvlNum];
      const statusText = l.completed ? '✓ Сдан' : l.status === 'in_progress' ? '⏳ В работе' : l.status === 'reset' ? '❌ Сброс' : '⚪ Не начат';
      const color = l.completed ? 'border-green-300 bg-green-50 text-green-900' : l.status === 'in_progress' ? 'border-amber-300 bg-amber-50 text-amber-900' : 'border-gray-200 bg-gray-50 text-gray-600';
      const stars = l.status === 'in_progress' && l.currentStage && l.totalStages
        ? `<div class="text-xs mt-1 tracking-tighter"><span class="text-amber-500">${'★'.repeat(Math.min(l.totalStages, l.currentStage))}</span><span class="text-gray-300">${'☆'.repeat(Math.max(0, l.totalStages - l.currentStage))}</span></div>`
        : '';
      const resetWave = lvlNum === 3 && l.lastResetWave
        ? `<div class="text-[11px] text-red-700 font-semibold mt-0.5">Последний сброс: Волна ${l.lastResetWave}</div>`
        : '';
      cardsHtml += `
        <div class="border p-2.5 ${color}">
          <div class="text-xs font-bold uppercase">Уровень ${lvlNum}</div>
          <div class="text-sm font-semibold mt-1">${statusText}</div>
          <div class="text-xs opacity-75 mt-0.5">Время: ${formatTime(l.timeSpentSec)} • Ошибки: ${l.errors}</div>
          ${stars}${resetWave}
        </div>
      `;
    });
    if (student.sprintCpm) {
      const wpm = student.sprintWpm || Math.round(student.sprintCpm / 5);
      const acc = student.sprintAccuracy ? ` • Точность: ${student.sprintAccuracy}%` : '';
      const time = student.bestSprintTimeSec ? ` • Время: ${formatTime(student.bestSprintTimeSec)}` : '';
      cardsHtml += `
        <div class="border p-2.5 border-cyan-300 bg-cyan-50 text-cyan-950">
          <div class="text-xs font-bold uppercase flex items-center gap-1">⚡ Лого-Шторм (Спринт)</div>
          <div class="text-sm font-bold text-cyan-800 mt-1">${student.sprintCpm} зн/мин <span class="text-xs font-normal text-cyan-700">(${wpm} сл/мин)</span></div>
          <div class="text-xs opacity-80 mt-0.5">${time}${acc}</div>
        </div>
      `;
    }
    if (student.princeCompleted) {
      const lvlTxt = Array.isArray(student.princeLevels) && student.princeLevels.length > 0 ? `Уровни: ${student.princeLevels.join(', ')}` : 'Бонусный уровень';
      const pTime = student.princeBestTimeSec ? ` • Время: ${formatTime(student.princeBestTimeSec)}` : '';
      cardsHtml += `
        <div class="border p-2.5 border-amber-400 bg-amber-50 text-amber-950">
          <div class="text-xs font-bold uppercase flex items-center gap-1">⚔️ Prince of Persia (1989)</div>
          <div class="text-sm font-bold text-amber-900 mt-1">✓ Покорен</div>
          <div class="text-xs opacity-80 mt-0.5">${lvlTxt}${pTime}</div>
        </div>
      `;
    }
    cards.innerHTML = cardsHtml;

    // Render attempts list
    const attemptsList = document.getElementById('modal-attempts-list');
    if (attemptsList) {
      if (!student.attempts || student.attempts.length === 0) {
        attemptsList.innerHTML = '<div class="p-3 text-center text-gray-400 bg-gray-50 border border-gray-100 text-xs">Нет данных по отдельным попыткам</div>';
      } else {
        let attHtml = '';
        student.attempts.forEach((att, idx) => {
          const isHc = att.mode === 'hardcore';
          const modeBadge = isHc
            ? '<span class="px-1.5 py-0.5 text-[10px] font-bold bg-red-100 text-red-800 border border-red-200">💀 Хардкор</span>'
            : '<span class="px-1.5 py-0.5 text-[10px] font-medium bg-emerald-100 text-emerald-800 border border-emerald-200">Обычный</span>';
          
          let stBadge = '<span class="text-amber-600 font-semibold">⏳ В процессе</span>';
          if (att.status === 'completed') {
            stBadge = isHc
              ? '<span class="text-red-700 font-bold">👑 Покорен</span>'
              : '<span class="text-green-700 font-bold">✓ Завершён</span>';
          } else if (att.status === 'failed') {
            stBadge = '<span class="text-red-600 font-medium">❌ Сброс</span>';
          }

          function miniLvl(l, num) {
            if (!l) return `<span class="text-[11px] text-gray-400">Ур.${num}: —</span>`;
            const icon = l.completed ? '✓' : l.status === 'reset' ? '❌' : l.status === 'in_progress' ? '⏳' : '—';
            const waveHint = num === 3 && l.lastResetWave ? ` <span class="text-red-600">(В.${l.lastResetWave})</span>` : '';
            const stageHint = l.status === 'in_progress' && l.currentStage && l.totalStages
              ? ` <span class="text-amber-500 tracking-tighter">${'★'.repeat(Math.min(l.totalStages, l.currentStage))}</span>`
              : '';
            return `<span class="text-[11px] text-gray-700">Ур.${num}: <strong>${icon} ${formatTime(l.timeSpentSec)}</strong>${stageHint}${waveHint}</span>`;
          }

          attHtml += `
            <div class="p-3 bg-gray-50 border border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
              <div class="space-y-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-bold text-gray-900">Забег #${att.attemptNumber || (idx + 1)}</span>
                  ${modeBadge}
                  ${stBadge}
                  ${att.princeCompleted ? '<span class="px-1.5 py-0.5 text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-300">⚔️ Принц</span>' : ''}
                  ${(att.courseSlug || att.lessonId) ? renderCourseLessonPill(att.courseSlug, att.lessonId, student.className) : ''}
                </div>
                <div class="flex items-center gap-2 text-gray-500 text-[11px]">
                  <span>Время: <strong class="text-gray-800 font-mono">${formatTime(att.totalTimeSec)}</strong></span>
                  <span>•</span>
                  <span>Ошибок: <strong class="text-gray-800">${att.errorsCount}</strong></span>
                  <span>•</span>
                  <span>Сдано: <strong>${att.completedLevelsCount}/3 уровней</strong></span>
                </div>
              </div>
              <div class="flex items-center gap-2 sm:gap-3 bg-white px-2.5 py-1.5 border border-gray-200 shrink-0">
                ${miniLvl(att.levels[1], 1)}
                <span class="text-gray-300">•</span>
                ${miniLvl(att.levels[2], 2)}
                <span class="text-gray-300">•</span>
                ${miniLvl(att.levels[3], 3)}
              </div>
            </div>
          `;
        });
        attemptsList.innerHTML = attHtml;
      }
    }

    // Render recent events
    const list = document.getElementById('modal-events-list');
    if (!student.recentEvents || student.recentEvents.length === 0) {
      list.innerHTML = '<div class="p-4 text-center text-gray-400">Нет подробных событий</div>';
    } else {
      let eventsHtml = '';
      student.recentEvents.forEach(ev => {
        let actColor = 'text-gray-700';
        if (ev.action_type === 'level_complete') actColor = 'text-green-700 font-bold';
        else if (ev.action_type === 'hardcore_reset') actColor = 'text-red-700 font-bold';
        else if (ev.action_type === 'sprint_complete') actColor = 'text-cyan-700 font-bold';
        
        let sprintSpeedDetail = '';
        if (ev.action_type === 'sprint_complete' && ev.log) {
          try {
            const parsed = JSON.parse(ev.log);
            if (parsed && (parsed.cpm || parsed.charsCount)) {
              const cpm = parsed.cpm || Math.round((parsed.charsCount / (ev.time_spent / 60)));
              const wpm = parsed.wpm || Math.round(cpm / 5);
              sprintSpeedDetail = ` • <span class="text-cyan-700 font-semibold">скорость: ${cpm} зн/мин (${wpm} сл/мин)</span>`;
            }
          } catch(e) {}
        }

        eventsHtml += `
          <div class="p-2.5 flex justify-between items-start hover:bg-gray-50">
            <div>
              <div class="font-medium ${actColor}">[${ev.action_type}] ${ev.mission}</div>
              <div class="text-gray-400 text-[11px] mt-0.5">${ev.timestamp} • затрачено: ${ev.time_spent}с${sprintSpeedDetail}</div>
              ${ev.log && ev.log !== '[]' ? `<div class="text-gray-500 font-mono text-[11px] mt-1 bg-gray-100 p-1 truncate max-w-lg" title="${ev.log}">${ev.log}</div>` : ''}
            </div>
          </div>
        `;
      });
      list.innerHTML = eventsHtml;
    }

    modal.classList.remove('hidden');
  }

  function closeModal() {
    modal.classList.add('hidden');
    activeStudent = null;
  }

  document.getElementById('modal-close-btn').addEventListener('click', closeModal);
  document.getElementById('modal-ok-btn').addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Export to CSV
  exportBtn.addEventListener('click', () => {
    if (!currentStudents.length) {
      alert('Нет данных для экспорта');
      return;
    }

    const headers = ['#', 'Ученик', 'Класс', 'Курс / Урок', 'Статус урока', 'Забеги (всего)', 'Забеги (хардкор)', 'Уровень 1 (время/ошибки)', 'Уровень 2 (время/ошибки)', 'Уровень 3 (время/ошибки)', 'Лого-Шторм (зн/мин)', 'Лого-Шторм (сл/мин)', 'Лого-Шторм (время)', 'Время решения (сек)', 'Время решения', 'Всего ошибок', 'Хардкор', 'Принц Персии', 'Был на уроке', 'Детали забегов'];
    const rows = currentStudents.map((s, idx) => [
      idx + 1,
      `"${s.displayName}"`,
      `"${s.className}"`,
      `"${(s.workedLessons && s.workedLessons.length > 0 ? s.workedLessons.map(w => `${w.courseSlug} Урок ${w.lessonId}`).join(', ') : (s.lastCourseSlug ? `${s.lastCourseSlug} Урок ${s.lastLessonId || ''}` : ''))}"`,
      `"${s.lessonStatus}"`,
      s.attemptsCount || 1,
      s.hardcoreAttemptsCount || 0,
      `"${formatTime(s.levels[1]?.timeSpentSec)} / ${s.levels[1]?.errors || 0} ош."`,
      `"${formatTime(s.levels[2]?.timeSpentSec)} / ${s.levels[2]?.errors || 0} ош."`,
      `"${formatTime(s.levels[3]?.timeSpentSec)} / ${s.levels[3]?.errors || 0} ош."`,
      s.sprintCpm !== null && s.sprintCpm !== undefined ? s.sprintCpm : '"—"',
      s.sprintCpm !== null && s.sprintCpm !== undefined ? (s.sprintWpm || Math.round(s.sprintCpm / 5)) : '"—"',
      s.bestSprintTimeSec !== null ? `"${formatTime(s.bestSprintTimeSec)}"` : '"—"',
      s.totalActiveTimeSec,
      `"${formatTime(s.totalActiveTimeSec)}"`,
      s.totalErrors,
      s.isHardcore ? 'Да' : 'Нет',
      s.princeCompleted ? 'Да' : 'Нет',
      `"${s.lastSeen || ''}"`,
      `"${(s.attempts || []).map(a => `Забег #${a.attemptNumber} (${a.mode === 'hardcore' ? 'Хардкор' : 'Обычный'}): ${a.status === 'completed' ? 'Сдан' : a.status === 'failed' ? 'Сброс' : 'В процессе'}, ${formatTime(a.totalTimeSec)}`).join(' | ')}"`
    ]);

    const csvContent = '\uFEFF' + [headers.join(';'), ...rows.map(r => r.join(';'))].join('\r\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', `Ведомость_телеметрии_${getSelectedClassesParam()}_${dateSelect.value}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  // Polling setup
  function setupPolling() {
    if (pollingInterval) clearInterval(pollingInterval);
    if (isLive) {
      pollingInterval = setInterval(fetchTelemetry, 5000);
      liveIndicator.classList.remove('opacity-40');
      document.getElementById('live-btn-icon').textContent = '⏸';
      document.getElementById('live-btn-text').textContent = 'Автообновление (5с)';
    } else {
      liveIndicator.classList.add('opacity-40');
      document.getElementById('live-btn-icon').textContent = '▶';
      document.getElementById('live-btn-text').textContent = 'Возобновить';
    }
  }

  toggleLiveBtn.addEventListener('click', () => {
    isLive = !isLive;
    setupPolling();
  });

  refreshBtn.addEventListener('click', () => {
    fetchTelemetry();
  });

  // Multi-class dropdown interaction
  classDropdownBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    classDropdownMenu.classList.toggle('hidden');
  });

  document.addEventListener('click', (e) => {
    if (classContainer && !classContainer.contains(e.target)) {
      classDropdownMenu.classList.add('hidden');
    }
  });

  classCheckboxes.forEach(cb => {
    cb.addEventListener('change', () => {
      updateClassSelectLabel();
      updateLessonsDropdown();
      fetchTelemetry();
    });
  });

  btnSelectAllClasses.addEventListener('click', (e) => {
    e.stopPropagation();
    classCheckboxes.forEach(cb => cb.checked = true);
    updateClassSelectLabel();
    updateLessonsDropdown();
    fetchTelemetry();
  });

  btnClearAllClasses.addEventListener('click', (e) => {
    e.stopPropagation();
    classCheckboxes.forEach(cb => cb.checked = false);
    updateClassSelectLabel();
    updateLessonsDropdown();
    fetchTelemetry();
  });

  courseSelect?.addEventListener('change', () => {
    updateLessonsDropdown();
    fetchTelemetry();
  });
  lessonSelect.addEventListener('change', fetchTelemetry);
  dateSelect.addEventListener('change', fetchTelemetry);
  excludeTestsCheckbox.addEventListener('change', fetchTelemetry);

  let searchTimeout = null;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(fetchTelemetry, 300);
  });

  // Table column sorting listeners (supports Ctrl / Cmd / Shift for multi-column sorting)
  document.querySelectorAll('th[data-sort]').forEach(th => {
    th.addEventListener('click', (e) => {
      const col = th.getAttribute('data-sort');
      const isMulti = !!(e.ctrlKey || e.metaKey || e.shiftKey);
      if (col) setSort(col, isMulti);
    });
  });
  window.setSort = setSort;
  window.getSortRules = () => sortRules;

  // Initialize
  updateSortIcons();
  updateLessonsDropdown();
  setupPolling();
  fetchTelemetry();
</script>
