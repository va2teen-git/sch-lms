---
import Layout from '../../../layouts/Layout.astro';
import coursesData from '../../../data/courses.json';
import fs from 'fs';
import path from 'path';
import { marked } from 'marked';
import markedAlert from 'marked-alert';

marked.use(markedAlert());

const { class: classSlug, id: lessonId } = Astro.params;

const course = coursesData.find(c => c.slug === classSlug);
const lesson = course?.lessons.find(l => l.id === lessonId);

if (!course || !lesson) {
  return Astro.redirect('/courses');
}

const princeBonusLevel = lesson?.princeBonusLevel ? parseInt(lesson.princeBonusLevel, 10) : null;

// Попытка загрузить теорию
const theoryPath = path.join(process.cwd(), 'src', 'content', 'lessons', classSlug, lessonId, 'theory.md');
let theoryHtml = '<p class="text-gray-500">Теоретический материал еще не добавлен.</p>';

if (fs.existsSync(theoryPath)) {
  const mdContent = fs.readFileSync(theoryPath, 'utf-8');
  theoryHtml = marked.parse(mdContent);
}

// Check if monolithic legacy task.html exists
const legacyTaskPath = path.join(process.cwd(), 'public', 'tasks', classSlug, lessonId, 'task.html');
const hasLegacyTask = fs.existsSync(legacyTaskPath);

// Пути к тренажерам (поддержка старых .html и новых Astro роутов)
const getTaskUrl = (levelNum, cSlug, lId) => {
  const publicPath = path.join(process.cwd(), 'public', 'tasks', cSlug, lId, `level${levelNum}.html`);
  if (fs.existsSync(publicPath)) {
    return `/tasks/${cSlug}/${lId}/level${levelNum}.html`; // legacy static
  }
  return `/tasks/${cSlug}/${lId}/level${levelNum}`; // new dynamic Astro route
};

const tasks = [
  { level: 1, name: 'Уровень 1', url: getTaskUrl(1, classSlug, lessonId) },
  { level: 2, name: 'Уровень 2', url: getTaskUrl(2, classSlug, lessonId) },
  { level: 3, name: 'Уровень 3', url: getTaskUrl(3, classSlug, lessonId) }
];
---

<Layout title={`${lesson.topic} | Урок ${lesson.id}`}>
  <div class="flex h-screen flex-col">
    
    <!-- Header -->
    <header class="bg-gray-800 text-white p-3 sm:p-4 flex flex-wrap justify-between items-center gap-2 shrink-0">
      <div class="flex items-center gap-3 sm:gap-4 min-w-0">
        <a href="/courses" class="border border-white px-3 py-1 hover:bg-gray-700 transition-colors shrink-0 text-sm">← Назад</a>
        <h1 class="text-base sm:text-xl font-bold truncate" title={`Урок ${lesson.id}: ${lesson.topic}`}>Урок {lesson.id}: {lesson.topic}</h1>
      </div>
      <div class="flex items-center gap-2 sm:gap-4 shrink-0">
        <button id="hardcore-toggle" class="border border-gray-600 bg-gray-700 px-2 sm:px-3 py-1 flex items-center gap-1.5 sm:gap-2 hover:bg-red-900 transition-colors" title="Режим Хардкора">
          <span class="text-lg sm:text-xl opacity-50 transition-opacity" id="hardcore-icon">💀</span>
          <span class="text-xs sm:text-sm font-semibold uppercase tracking-wider">Хардкор</span>
        </button>
        <button id="logout-btn" class="border border-red-500 text-red-500 hover:bg-red-900 px-2 sm:px-3 py-1 transition-colors text-xs sm:text-sm font-semibold uppercase tracking-wider">Выйти</button>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 flex overflow-hidden">
      <!-- Left: Theory -->
      <section class="w-1/2 border-r border-gray-300 bg-white overflow-y-auto p-4 sm:p-6 lg:p-8 prose prose-slate max-w-none min-w-0">
        <div set:html={theoryHtml} />
      </section>

      <!-- Right: Interactive Tasks -->
      <section class="w-1/2 bg-gray-50 flex flex-col relative min-w-0">
        <div id="lesson-content" class="absolute inset-0 flex flex-col">
          {hasLegacyTask ? (
            <div class="flex-1 relative bg-white">
              <iframe 
                src={`/tasks/${classSlug}/${lessonId}/task.html`}
                class="w-full h-full absolute inset-0 border-0"
                title="Interactive Task"
              ></iframe>
            </div>
          ) : (
            <>
              <!-- Tabs -->
              <div class="flex border-b border-gray-300 bg-gray-200 shrink-0">
                {tasks.map((task, idx) => (
                  <button 
                    class={`tab-btn flex-1 py-2 sm:py-3 px-1 sm:px-3 text-xs sm:text-sm font-semibold border-r border-gray-300 last:border-r-0 truncate ${idx === 0 ? 'bg-white border-b-2 border-b-blue-600 text-blue-600' : 'text-gray-600 hover:bg-gray-100'}`}
                    data-target={`iframe-${task.level}`}
                  >
                    {task.name}
                  </button>
                ))}
              </div>
              
              <!-- Iframes Container -->
              <div class="flex-1 relative bg-white">
                {tasks.map((task, idx) => (
                  <iframe 
                    id={`iframe-${task.level}`} 
                    src={task.url}
                    class={`w-full h-full absolute inset-0 border-0 ${idx === 0 ? 'block' : 'hidden'}`}
                    title={task.name}
                  ></iframe>
                ))}
              </div>
            </>
          )}
        </div>
        <div id="completion-screen" class="hidden absolute inset-0 bg-white flex-col items-center justify-center p-8 text-center z-10 overflow-y-auto">
          <h2 class="text-4xl font-bold mb-4" id="completion-title">🎉 Урок пройден!</h2>
          <p class="text-xl text-gray-600 mb-6" id="completion-subtitle">Вы успешно завершили все задания.</p>
          
          {princeBonusLevel && (
            <div id="prince-bonus-card" class="hidden mb-6 p-5 border-2 border-amber-500 bg-gray-900 text-left max-w-lg shadow-2xl rounded-0">
              <div class="flex items-center justify-between border-b border-amber-600/40 pb-2 mb-3">
                <span class="text-xs uppercase tracking-widest text-amber-400 font-mono font-bold flex items-center gap-1.5">
                  <span>🏆</span> РЕТРО-АРХИВ 1989 // РАЗБЛОКИРОВАНО
                </span>
                <span class="bg-amber-500/20 text-amber-300 border border-amber-500/50 text-xs px-2 py-0.5 font-mono font-bold">
                  УРОВЕНЬ {princeBonusLevel}
                </span>
              </div>
              <div class="text-lg font-bold text-amber-300 font-mono mb-1">
                ⚔️ PRINCE OF PERSIA (1989)
              </div>
              <p class="text-xs text-amber-200/90 font-serif italic mb-2">
                «О доблестный путник! За твою непреклонную стойкость и чистый разум падишах дарует тебе ключ от древней сокровищницы...»
              </p>
              <p class="text-xs text-gray-300 font-mono mb-4 leading-relaxed">
                За безупречное прохождение режима «Хардкор» вам открыт секретный Уровень {princeBonusLevel} классической игры Prince of Persia. Испытайте свои навыки в легендарном ретро-платформере!
              </p>
              <button 
                id="open-prince-btn" 
                class="w-full py-2.5 bg-amber-500 hover:bg-amber-400 text-black font-bold uppercase tracking-wider text-sm font-mono transition-colors flex items-center justify-center gap-2 rounded-0 shadow"
              >
                <span>▶ ЗАПУСТИТЬ УРОВЕНЬ {princeBonusLevel}</span>
              </button>
            </div>
          )}

          <button id="reset-lesson-btn" class="px-6 py-3 bg-blue-600 text-white rounded-0 font-bold hover:bg-blue-700 transition-colors">Пройти заново</button>
        </div>

        {princeBonusLevel && (
          <div id="prince-overlay" class="hidden absolute inset-0 bg-black flex-col z-20">
            <div class="bg-gray-900 border-b border-gray-700 px-3 py-2 flex items-center justify-between shrink-0 text-white font-mono text-sm">
              <div class="flex items-center gap-2">
                <span class="text-amber-400">⚔️</span>
                <span class="font-bold text-amber-300">PRINCE OF PERSIA (1989)</span>
                <span class="text-xs bg-gray-800 text-gray-300 px-2 py-0.5 border border-gray-600">УРОВЕНЬ {princeBonusLevel}</span>
              </div>
              <div class="flex items-center gap-2">
                <button id="prince-reload-btn" class="px-2 py-1 bg-gray-800 hover:bg-gray-700 text-xs text-gray-200 border border-gray-600 transition-colors" title="Перезапустить уровень">
                  🔄 Рестарт
                </button>
                <button id="prince-fullscreen-btn" class="px-2 py-1 bg-gray-800 hover:bg-gray-700 text-xs text-gray-200 border border-gray-600 transition-colors" title="На весь экран">
                  ⛶ На весь экран
                </button>
                <button id="close-prince-btn" class="px-3 py-1 bg-red-900 hover:bg-red-800 text-xs font-bold text-white border border-red-700 transition-colors">
                  ✖ Свернуть
                </button>
              </div>
            </div>
            <div class="bg-gray-950 text-gray-400 text-xs px-3 py-1.5 border-b border-gray-800 font-mono flex justify-between flex-wrap items-center gap-2">
              <span>Управление: <strong>[← / →]</strong> Движение | <strong>[↑]</strong> Прыжок | <strong>[↓]</strong> Присесть | <strong>[Shift]</strong> Меч/Шаг</span>
              <span class="text-amber-400 font-bold bg-amber-950/80 border border-amber-600/50 px-2 py-0.5 animate-pulse">💡 Кликните по экрану игры или нажмите Enter для старта</span>
            </div>
            <div class="flex-1 relative bg-black flex items-center justify-center overflow-hidden">
              <iframe 
                id="prince-game-iframe"
                src={`/static/prince/index.html?level=${princeBonusLevel}&maxLevel=${princeBonusLevel}&skipTitle=true`}
                class="w-full h-full border-0 absolute inset-0"
                title="Prince of Persia"
                allow="fullscreen; gamepad; autoplay"
                tabindex="0"
              ></iframe>
            </div>

            <!-- Persian Congratulations & Victory Modal -->
            <div id="prince-victory-modal" class="hidden absolute inset-0 bg-black/90 backdrop-blur-md z-30 flex-col items-center justify-center p-4 sm:p-6 overflow-y-auto">
              <div class="max-w-2xl w-full bg-gradient-to-b from-gray-950 via-gray-900 to-black border-2 border-amber-500 p-6 sm:p-8 text-center shadow-2xl relative rounded-0">
                <div class="text-amber-500/80 font-mono text-xs tracking-widest uppercase mb-1">
                  ✦ ════════════════════════════════════════════════ ✦
                </div>
                <div class="flex items-center justify-center gap-2 mb-2">
                  <span class="text-2xl">👑</span>
                  <span class="text-xs uppercase tracking-widest text-amber-400 font-mono font-bold bg-amber-500/10 border border-amber-500/30 px-3 py-1">
                    СЕКРЕТНЫЙ РЕТРО-АРХИВ // ПОЛНЫЙ ТРИУМФ
                  </span>
                  <span class="text-2xl">👑</span>
                </div>
                <h3 class="text-2xl sm:text-3xl font-bold text-amber-300 font-serif tracking-wide mb-2 uppercase">
                  ХВАЛА И СЛАВА ПОБЕДИТЕЛЮ ТЕМНИЦ ПЕРСИИ!
                </h3>
                <div class="text-xs font-mono text-amber-400 mb-4">
                  ДАР ВЕЛИКОГО ПАДИШАХА // УРОВЕНЬ <span id="prince-victory-level">{princeBonusLevel}</span> ПОКОРЕН
                </div>

                <div class="border-t border-b border-amber-500/40 py-4 my-3 text-amber-100 text-sm sm:text-base leading-relaxed text-justify space-y-3 font-serif bg-black/50 p-4 max-h-[45vh] overflow-y-auto">
                  <p class="italic text-center font-semibold text-amber-300">
                    «О солнцеподобный витязь, услада очей мудрецов и непревзойденный владыка кремниевых стихий!»
                  </p>
                  <p>
                    Да осыплют небеса твой путь лепестками дамасских роз и сиянием неугасимых звезд семи небес! Твой ясный ум и непоколебимая доблесть рассекли мрак древних катакомб коварного визиря Джаффара, подобно сверкающему булатному клинку из благородной стали Исфахана.
                  </p>
                  <p>
                    Ни бездонные пропасти, ни скрытые в плитах лезвия, ни коварные шипы не заставили дрогнуть твое благородное сердце. С грацией барса и терпением великого суфия ты прошел сквозь каменный лабиринт, явив миру величие истинного знания, силу духа и безупречность холодного расчета!
                  </p>
                  <p>
                    Пусть же отныне звонкие струны ситара и сладкогласые поэты разносят весть о твоем подвиге по всем оазисам, базарам и караван-сараям Востока! Твое благословенное имя золотой вязью навечно вписано в скрижали славы, о светозарный повелитель алгоритмов и победитель Песков Времени!
                  </p>
                </div>

                <div class="border border-amber-500/40 bg-amber-500/10 p-3 text-xs font-mono text-amber-300 my-4 flex items-center justify-center gap-2">
                  <span>🔒</span>
                  <span>ДАЛЬНЕЙШИЕ ЧЕРТОГИ ДВОРЦА ЗАПЕЧАТАНЫ ДРЕВНЕЙ МАГИЕЙ // ДОСТУПЕН ТОЛЬКО УРОВЕНЬ 1</span>
                  <span>🔒</span>
                </div>

                <div class="text-amber-500/80 font-mono text-xs tracking-widest uppercase mb-5">
                  ✦ ════════════════════════════════════════════════ ✦
                </div>

                <div class="flex flex-col sm:flex-row gap-3 justify-center items-center font-mono">
                  <button 
                    id="prince-victory-close-btn"
                    class="w-full sm:w-auto px-6 py-2.5 bg-amber-500 hover:bg-amber-400 text-black font-bold uppercase tracking-wider text-xs transition-colors rounded-0 shadow-lg cursor-pointer"
                  >
                    📜 Вернуться к уроку с почетом
                  </button>
                  <button 
                    id="prince-retry-btn"
                    class="w-full sm:w-auto px-6 py-2.5 bg-gray-800 hover:bg-gray-700 text-amber-300 border border-amber-500/50 font-bold uppercase tracking-wider text-xs transition-colors rounded-0 cursor-pointer"
                  >
                    🔄 Пройти Уровень 1 заново
                  </button>
                </div>
              </div>
            </div>
          </div>
        )}
      </section>
    </main>

  </div>
</Layout>

<script define:vars={{ classSlug, lessonId, princeBonusLevel }}>
  const tabs = document.querySelectorAll('.tab-btn');
  const iframes = document.querySelectorAll('iframe');

  const HARDCORE_KEY = `school_lms_hardcore_${classSlug}_${lessonId}`;
  let isHardcore = sessionStorage.getItem(HARDCORE_KEY) === 'true' || localStorage.getItem('hardcore_mode') === 'true' || localStorage.getItem(HARDCORE_KEY) === 'true';
  let currentUnlockedLevel = 1;
  let isHardcoreCompleted = false;
  let isNormalCompleted = false;

  const fullTitle = document.querySelector('h1')?.textContent?.trim() || '';
  const lessonPrefix = fullTitle.split(':')[0].trim(); // 'Урок X'

  const ATTEMPT_KEY = `school_lms_attempt_${classSlug}_${lessonId}`;
  function getOrCreateAttempt(forceNew = false, modeOverride = null) {
    const raw = sessionStorage.getItem(ATTEMPT_KEY);
    let attempt = null;
    let prevNum = 0;
    if (raw) {
      try {
        const parsed = JSON.parse(raw);
        if (parsed && typeof parsed.number === 'number') prevNum = parsed.number;
        if (!forceNew) attempt = parsed;
      } catch (e) {}
    }
    const currentMode = modeOverride || (isHardcore ? 'hardcore' : 'normal');
    if (!attempt || forceNew || attempt.mode !== currentMode) {
      attempt = {
        id: 'att_' + Date.now() + '_' + Math.random().toString(36).substring(2, 7),
        number: prevNum + 1,
        mode: currentMode,
        startTime: Date.now()
      };
      sessionStorage.setItem(ATTEMPT_KEY, JSON.stringify(attempt));
    }
    return attempt;
  }
  let currentAttempt = getOrCreateAttempt();
  
  // Set initial state to locked
  tabs.forEach((tab, index) => {
    if (index > 0) {
      tab.classList.add('opacity-50', 'cursor-not-allowed');
      if (!tab.innerHTML.includes('🔒')) tab.innerHTML += ' 🔒';
    }
  });

  async function syncProgress() {
    const fName = localStorage.getItem('student_firstName');
    const lName = localStorage.getItem('student_lastName');
    const cName = localStorage.getItem('student_class');

    if (fName && lName && cName) {
      try {
        const res = await fetch(`/api/progress?firstName=${encodeURIComponent(fName)}&lastName=${encodeURIComponent(lName)}&className=${encodeURIComponent(cName)}&lessonPrefix=${encodeURIComponent(lessonPrefix)}&courseSlug=${encodeURIComponent(classSlug)}&lessonId=${encodeURIComponent(lessonId)}`);
        if (res.ok) {
          const data = await res.json();
          isNormalCompleted = data.isNormalCompleted;
          isHardcoreCompleted = data.isHardcoreCompleted;
          currentUnlockedLevel = isHardcore ? data.unlockedHardcore : data.unlockedNormal;
        }
      } catch (e) {
        console.error(e);
      }
    }
    updateTabsState();
    if (currentUnlockedLevel <= 3) {
      switchTab(`iframe-${currentUnlockedLevel}`);
    }
  }

  function checkCompletion() {
    const displayHardcore = isHardcoreCompleted || (isHardcore && isNormalCompleted);
    
    if (currentUnlockedLevel > 3 || isHardcoreCompleted || (isNormalCompleted && !isHardcore)) {
      document.getElementById('lesson-content')?.classList.add('hidden');
      const compScreen = document.getElementById('completion-screen');
      compScreen?.classList.remove('hidden');
      compScreen?.classList.add('flex');
      
      const title = document.getElementById('completion-title');
      if (title) {
        if (displayHardcore) {
          title.innerHTML = '💀 Урок пройден в режиме Хардкор!';
          title.classList.add('text-red-600');
        } else {
          title.innerHTML = '🎉 Урок пройден!';
          title.classList.remove('text-red-600');
        }
      }

      // Проверка разблокировки бонусного уровня Prince of Persia
      const princeBonusCard = document.getElementById('prince-bonus-card');
      if (princeBonusCard) {
        if (displayHardcore && princeBonusLevel) {
          princeBonusCard.classList.remove('hidden');
        } else {
          princeBonusCard.classList.add('hidden');
        }
      }

      return true;
    }
    
    document.getElementById('lesson-content')?.classList.remove('hidden');
    const compScreen = document.getElementById('completion-screen');
    compScreen?.classList.add('hidden');
    compScreen?.classList.remove('flex');

    const princeBonusCard = document.getElementById('prince-bonus-card');
    if (princeBonusCard) princeBonusCard.classList.add('hidden');

    return false;
  }

  function updateTabsState() {
    if (checkCompletion()) return;

    tabs.forEach((tab, index) => {
      const level = index + 1;
      const isLocked = level > currentUnlockedLevel;
      
      if (isLocked) {
        tab.classList.add('opacity-50', 'cursor-not-allowed');
        if (!tab.innerHTML.includes('🔒')) {
          tab.innerHTML += ' 🔒';
        }
      } else {
        tab.classList.remove('opacity-50', 'cursor-not-allowed');
        tab.innerHTML = tab.innerHTML.replace(' 🔒', '');
      }
    });
  }

  syncProgress();

  document.getElementById('reset-lesson-btn')?.addEventListener('click', () => {
    const btn = document.getElementById('reset-lesson-btn');
    if (btn) btn.innerHTML = 'Сброс...';
    
    const nextAttempt = getOrCreateAttempt(true, isHardcore ? 'hardcore' : 'normal');

    fetch('/api/telemetry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          student_firstName: localStorage.getItem('student_firstName'),
          student_lastName: localStorage.getItem('student_lastName'),
          student_class: localStorage.getItem('student_class'),
          course_slug: classSlug,
          lesson_id: lessonId,
          is_hardcore: isHardcore,
          attempt_id: nextAttempt.id,
          attempt_number: nextAttempt.number,
          attempt_mode: nextAttempt.mode,
          action_type: isHardcore ? 'hardcore_reset' : 'normal_reset',
          mission_name: fullTitle
        })
    }).then(() => {
        window.location.reload();
    });
  });

  function switchTab(targetId) {
    const targetLevel = parseInt(targetId.replace('iframe-', ''), 10);
    if (targetLevel > currentUnlockedLevel) return; // Locked

    tabs.forEach(t => {
      t.classList.remove('bg-white', 'border-b-2', 'border-b-blue-600', 'text-blue-600');
      t.classList.add('text-gray-600', 'hover:bg-gray-100');
    });
    
    const activeTab = Array.from(tabs).find(t => t.getAttribute('data-target') === targetId);
    if (activeTab) {
        activeTab.classList.add('bg-white', 'border-b-2', 'border-b-blue-600', 'text-blue-600');
        activeTab.classList.remove('text-gray-600', 'hover:bg-gray-100');
    }

    iframes.forEach(iframe => {
      if (iframe.id === targetId) {
        iframe.classList.remove('hidden');
        iframe.classList.add('block');
      } else {
        iframe.classList.remove('block');
        iframe.classList.add('hidden');
      }
    });
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', (e) => {
      const targetId = (e.currentTarget).getAttribute('data-target');
      if (targetId) {
        switchTab(targetId);
      }
    });
  });

  const hardcoreBtn = document.getElementById('hardcore-toggle');
  const hardcoreIcon = document.getElementById('hardcore-icon');
  
  function updateHardcoreUI() {
    if (isHardcore) {
      hardcoreIcon?.classList.remove('opacity-50');
      hardcoreIcon?.classList.add('opacity-100');
      hardcoreBtn?.classList.add('bg-red-900', 'border-red-500');
      hardcoreBtn?.classList.remove('bg-gray-700', 'border-gray-600');
    } else {
      hardcoreIcon?.classList.remove('opacity-100');
      hardcoreIcon?.classList.add('opacity-50');
      hardcoreBtn?.classList.remove('bg-red-900', 'border-red-500');
      hardcoreBtn?.classList.add('bg-gray-700', 'border-gray-600');
    }
  }
  
  updateHardcoreUI();
  
  hardcoreBtn?.addEventListener('click', () => {
    isHardcore = !isHardcore;
    sessionStorage.setItem(HARDCORE_KEY, String(isHardcore));
    localStorage.removeItem('hardcore_mode');
    updateHardcoreUI();
    getOrCreateAttempt(true, isHardcore ? 'hardcore' : 'normal');
    window.location.reload();
  });

  const platformTimers = {};

  window.addEventListener('message', (event) => {
    const data = event.data;
    if (data && data.type === 'PRINCE_EVENT') {
      console.log('Received Prince event:', data);
      if (data.action === 'level_complete') {
        const victoryModal = document.getElementById('prince-victory-modal');
        const victoryLevelSpan = document.getElementById('prince-victory-level');
        if (victoryLevelSpan && data.completedLevel) {
          victoryLevelSpan.textContent = String(data.completedLevel);
        }
        if (victoryModal) {
          victoryModal.classList.remove('hidden');
          victoryModal.classList.add('flex');
        }

        // Send telemetry for Prince bonus level completion
        fetch('/api/telemetry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            student_firstName: localStorage.getItem('student_firstName'),
            student_lastName: localStorage.getItem('student_lastName'),
            student_class: localStorage.getItem('student_class'),
            course_slug: classSlug,
            lesson_id: lessonId,
            mission_name: `${fullTitle} :: Prince of Persia (Уровень ${data.completedLevel || princeBonusLevel})`,
            action_type: 'level_complete',
            status: 'completed',
            time_spent_sec: 60,
            attempts_count: 1,
            success: true,
            is_hardcore: isHardcore,
            attempt_id: currentAttempt.id,
            attempt_number: currentAttempt.number,
            attempt_mode: currentAttempt.mode
          })
        }).catch(err => console.error('Prince telemetry error:', err));
      }
      return;
    }

    if (data && data.type === 'TELEMETRY_EVENT') {
      let levelNum = null;
      const sourceIframe = Array.from(iframes).find(iframe => iframe.contentWindow === event.source);
      if (sourceIframe) {
        levelNum = parseInt(sourceIframe.id.replace('iframe-', ''), 10) || null;
      }
      if (!levelNum && data.mission_name) {
        if (data.mission_name.includes('Уровень 1')) levelNum = 1;
        else if (data.mission_name.includes('Уровень 2')) levelNum = 2;
        else if (data.mission_name.includes('Уровень 3')) levelNum = 3;
      }

      // CRITICAL: Block automated 0-second in_progress heartbeats from locked background iframes!
      // When page loads, locked levels mount in background and send 0s in_progress.
      // If the level is locked (levelNum > currentUnlockedLevel), we MUST NOT pollute telemetry!
      if (levelNum && levelNum > currentUnlockedLevel && data.action_type === 'in_progress' && (!data.time_spent_sec || data.time_spent_sec === 0)) {
        return;
      }

      console.log('Received telemetry:', data);
      
      if (!data.mission_name) {
        const lessonTitle = document.querySelector('h1')?.textContent || 'Неизвестный урок';
        const taskTitle = sourceIframe ? (sourceIframe.title || sourceIframe.id) : 'Неизвестное задание';
        data.mission_name = `${lessonTitle} :: ${taskTitle}`;
      } else {
        if (lessonPrefix && !data.mission_name.includes(lessonPrefix)) {
          data.mission_name = `${lessonPrefix} :: ${data.mission_name}`;
        }
      }

      // Preserve pure time spent from iframe if already provided; fallback to platform timer only if missing
      if (typeof data.time_spent_sec !== 'number') {
        const mName = data.mission_name;
        if (!platformTimers[mName]) {
          platformTimers[mName] = Date.now();
        }
        data.time_spent_sec = Math.floor((Date.now() - platformTimers[mName]) / 1000);
      }

      if ((data.action_type === 'hardcore_reset' || data.action_type === 'level_fail') && isHardcore) {
        data.action_type = 'hardcore_reset';
        alert('💀 ОШИБКА В РЕЖИМЕ ХАРДКОРА! Прогресс сброшен!');
        currentUnlockedLevel = 1;
        updateTabsState();
        switchTab('iframe-1');

        iframes.forEach(iframe => {
          const src = iframe.src;
          iframe.src = src; 
        });

        currentAttempt = getOrCreateAttempt(true, 'hardcore');
      } else if (data.action_type === 'hardcore_reset' && !isHardcore) {
        // Normal mode safety: if an iframe sent hardcore_reset while in normal mode, downgrade to level_fail
        data.action_type = 'level_fail';
      }

      if (data.action_type === 'level_complete') {
        if (sourceIframe) {
          const completedLevel = parseInt(sourceIframe.id.replace('iframe-', ''), 10);
          if (completedLevel === currentUnlockedLevel) {
            if (completedLevel < 3) {
              currentUnlockedLevel++;
              updateTabsState();
              switchTab(`iframe-${currentUnlockedLevel}`);
            } else if (completedLevel === 3) {
              currentUnlockedLevel = 4;
              if (isHardcore) isHardcoreCompleted = true;
              else isNormalCompleted = true;
              updateTabsState();
            }
          }
        }
      }

      fetch('/api/telemetry', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          student_firstName: localStorage.getItem('student_firstName'),
          student_lastName: localStorage.getItem('student_lastName'),
          student_class: localStorage.getItem('student_class'),
          course_slug: classSlug,
          lesson_id: lessonId,
          level_number: levelNum,
          is_hardcore: isHardcore,
          attempt_id: currentAttempt.id,
          attempt_number: currentAttempt.number,
          attempt_mode: currentAttempt.mode,
          ...data
        })
      }).catch(err => console.error('Telemetry error:', err));
    }
  });

  const logoutBtn = document.getElementById('logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      sessionStorage.clear();
      localStorage.removeItem('student_firstName');
      localStorage.removeItem('student_lastName');
      localStorage.removeItem('student_class');
      localStorage.removeItem('hardcore_mode');
      window.location.href = '/';
    });
  }

  // Глобальный запрет копирования и вставки на уровне всей системы LMS
  // 1. Для родительского окна (блок теории) - чтобы нельзя было скопировать текст
  document.addEventListener('copy', e => e.preventDefault());
  document.addEventListener('paste', e => e.preventDefault());
  
  // 2. Для всех интерактивных заданий (iframe)
  iframes.forEach(iframe => {
    iframe.addEventListener('load', () => {
      try {
        const doc = iframe.contentDocument || iframe.contentWindow?.document;
        if (doc) {
          // Запрет копирования/вставки в документе тренажера
          doc.addEventListener('copy', e => e.preventDefault());
          doc.addEventListener('paste', e => e.preventDefault());
          
          // Жесткая блокировка вставки и перетаскивания (drag-and-drop текста) для всех полей ввода
          const inputs = doc.querySelectorAll('input, textarea');
          inputs.forEach(input => {
            input.addEventListener('paste', e => e.preventDefault());
            input.addEventListener('drop', e => e.preventDefault());
            input.onpaste = () => false;
            input.ondrop = () => false;
          });
        }
      } catch (e) {
        console.warn('CORS не позволяет модифицировать iframe, но так как мы отдаем статику локально, этого быть не должно.', e);
      }
    });
  });

  // Интерактивное управление бонусным модулем Prince of Persia
  const openPrinceBtn = document.getElementById('open-prince-btn');
  const closePrinceBtn = document.getElementById('close-prince-btn');
  const princeOverlay = document.getElementById('prince-overlay');
  const princeReloadBtn = document.getElementById('prince-reload-btn');
  const princeFullscreenBtn = document.getElementById('prince-fullscreen-btn');
  const princeIframe = document.getElementById('prince-game-iframe');
  const princeRetryBtn = document.getElementById('prince-retry-btn');
  const princeVictoryCloseBtn = document.getElementById('prince-victory-close-btn');
  const princeVictoryModal = document.getElementById('prince-victory-modal');

  const focusPrince = () => {
    if (!princeIframe) return;
    try {
      princeIframe.focus();
      princeIframe.contentWindow?.focus();
      princeIframe.contentWindow?.postMessage({ type: 'FOCUS_GAME' }, '*');
    } catch (e) {}
  };

  if (openPrinceBtn && princeOverlay) {
    openPrinceBtn.addEventListener('click', () => {
      princeOverlay.classList.remove('hidden');
      princeOverlay.classList.add('flex');

      if (princeIframe) {
        // Если фрейм был предзагружен в скрытом состоянии (display: none),
        // перезапускаем его при первом открытии, чтобы Phaser CE построил канвас
        // с корректными реальными размерами контейнера и сразу запустил игровой цикл
        if (!princeIframe.dataset.activated) {
          princeIframe.dataset.activated = 'true';
          const currentSrc = princeIframe.src;
          princeIframe.src = currentSrc;
        }

        princeIframe.addEventListener('load', () => {
          setTimeout(focusPrince, 60);
        }, { once: true });

        setTimeout(focusPrince, 100);
      }
    });
  }

  // Клик в любой части оверлея возвращает фокус в игру
  if (princeOverlay && princeIframe) {
    princeOverlay.addEventListener('click', (e) => {
      if ((e.target).closest('button')) return;
      focusPrince();
    });
  }

  // Мост клавиатурных событий: если фокус случайно ушел в родительское окно,
  // перехватываем клавиши управления Принцем и пробрасываем их внутрь фрейма
  window.addEventListener('keydown', (e) => {
    if (princeOverlay && !princeOverlay.classList.contains('hidden') && princeIframe?.contentWindow) {
      const isGameKey = [
        'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight',
        'Enter', ' ', 'Shift'
      ].includes(e.key);

      if (isGameKey && document.activeElement !== princeIframe) {
        focusPrince();
        try {
          const forwarded = new KeyboardEvent(e.type, {
            key: e.key,
            code: e.code,
            keyCode: e.keyCode,
            which: e.which,
            shiftKey: e.shiftKey,
            ctrlKey: e.ctrlKey,
            altKey: e.altKey,
            bubbles: true,
            cancelable: true
          });
          princeIframe.contentWindow.dispatchEvent(forwarded);
          princeIframe.contentDocument?.dispatchEvent(forwarded);
        } catch (err) {}
      }
    }
  });

  window.addEventListener('keyup', (e) => {
    if (princeOverlay && !princeOverlay.classList.contains('hidden') && princeIframe?.contentWindow) {
      const isGameKey = [
        'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight',
        'Enter', ' ', 'Shift'
      ].includes(e.key);

      if (isGameKey && document.activeElement !== princeIframe) {
        try {
          const forwarded = new KeyboardEvent(e.type, {
            key: e.key,
            code: e.code,
            keyCode: e.keyCode,
            which: e.which,
            shiftKey: e.shiftKey,
            ctrlKey: e.ctrlKey,
            altKey: e.altKey,
            bubbles: true,
            cancelable: true
          });
          princeIframe.contentWindow.dispatchEvent(forwarded);
          princeIframe.contentDocument?.dispatchEvent(forwarded);
        } catch (err) {}
      }
    }
  });

  if (closePrinceBtn && princeOverlay) {
    closePrinceBtn.addEventListener('click', () => {
      if (princeVictoryModal) {
        princeVictoryModal.classList.remove('flex');
        princeVictoryModal.classList.add('hidden');
      }
      princeOverlay.classList.remove('flex');
      princeOverlay.classList.add('hidden');
    });
  }

  if (princeReloadBtn && princeIframe) {
    princeReloadBtn.addEventListener('click', () => {
      if (princeVictoryModal) {
        princeVictoryModal.classList.remove('flex');
        princeVictoryModal.classList.add('hidden');
      }
      princeIframe.src = princeIframe.src;
      princeIframe.addEventListener('load', () => setTimeout(focusPrince, 60), { once: true });
    });
  }

  if (princeRetryBtn && princeIframe) {
    princeRetryBtn.addEventListener('click', () => {
      if (princeVictoryModal) {
        princeVictoryModal.classList.remove('flex');
        princeVictoryModal.classList.add('hidden');
      }
      princeIframe.src = princeIframe.src;
      princeIframe.addEventListener('load', () => setTimeout(focusPrince, 60), { once: true });
    });
  }

  if (princeVictoryCloseBtn && princeVictoryModal && princeOverlay) {
    princeVictoryCloseBtn.addEventListener('click', () => {
      princeVictoryModal.classList.remove('flex');
      princeVictoryModal.classList.add('hidden');
      princeOverlay.classList.remove('flex');
      princeOverlay.classList.add('hidden');
    });
  }

  if (princeFullscreenBtn && princeOverlay) {
    princeFullscreenBtn.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        princeOverlay.requestFullscreen().catch(err => console.warn(err));
        princeFullscreenBtn.textContent = '✖ Свернуть экран';
      } else {
        document.exitFullscreen().catch(err => console.warn(err));
        princeFullscreenBtn.textContent = '⛶ На весь экран';
      }
      setTimeout(focusPrince, 100);
    });

    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement && princeFullscreenBtn) {
        princeFullscreenBtn.textContent = '⛶ На весь экран';
      }
      setTimeout(focusPrince, 100);
    });
  }
</script>
