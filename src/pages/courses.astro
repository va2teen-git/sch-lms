---
import Layout from '../layouts/Layout.astro';
import coursesData from '../data/courses.json';
import { getTotalCampaignStages } from '../lib/prince-campaign';
import fs from 'fs';
import path from 'path';

const totalCampaignStages = getTotalCampaignStages();

const COURSE_META: Record<string, { order: number; short: string }> = {
  '7-класс': { order: 1, short: '7 кл' },
  '8-класс': { order: 2, short: '8 кл' },
  '9-класс': { order: 3, short: '9 кл' },
  '10-класс_базовый': { order: 4, short: '10 баз' },
  '10-класс_углубленный': { order: 5, short: '10 угл' },
  '11-класс_базовый': { order: 6, short: '11 баз' },
  '11-класс_углубленный': { order: 7, short: '11 угл' },
};

const hasLessonContent = (slug: string, id: string): boolean => {
  const cwd = process.cwd();
  return (
    fs.existsSync(path.join(cwd, 'src', 'pages', 'tasks', slug, id, 'level1.astro')) ||
    fs.existsSync(path.join(cwd, 'public', 'tasks', slug, id, 'level1.html')) ||
    fs.existsSync(path.join(cwd, 'public', 'tasks', slug, id, 'task.html')) ||
    fs.existsSync(path.join(cwd, 'src', 'content', 'lessons', slug, id, 'theory.md'))
  );
};

const matrixCourses = [...coursesData]
  .sort((a, b) => (COURSE_META[a.slug]?.order ?? 99) - (COURSE_META[b.slug]?.order ?? 99))
  .map((c) => {
    const shortLabel = COURSE_META[c.slug]?.short ?? c.name;
    return {
      slug: c.slug,
      name: c.name,
      shortLabel,
      lessons: c.lessons.map((l) => ({
        id: l.id,
        topic: l.topic,
        ready: hasLessonContent(c.slug, String(l.id)),
      })),
    };
  });
---

<Layout title="Матрица уроков | Школьная Платформа">
  <div class="h-screen flex flex-col bg-gray-100 overflow-hidden">
    <header class="bg-white border-b border-gray-300 px-3 sm:px-4 py-2 flex items-center justify-between gap-3 shrink-0">
      <div class="flex items-center gap-3 min-w-0">
        <h1 class="text-base sm:text-lg font-bold tracking-tight text-gray-900 shrink-0">Матрица уроков</h1>
        <div class="hidden lg:flex items-center gap-2.5 text-[11px] text-gray-600 border-l border-gray-300 pl-3 select-none">
          <span class="inline-flex items-center gap-1" title="Остановился на Уровне 1">
            <span class="w-2.5 h-2.5 bg-emerald-500 border border-emerald-700 inline-block"></span>Ур.1
          </span>
          <span class="inline-flex items-center gap-1" title="Остановился на Уровне 2">
            <span class="w-2.5 h-2.5 bg-amber-500 border border-amber-700 inline-block"></span>Ур.2
          </span>
          <span class="inline-flex items-center gap-1" title="Остановился на Уровне 3">
            <span class="w-2.5 h-2.5 bg-red-500 border border-red-700 inline-block"></span>Ур.3
          </span>
          <span title="Урок пройден">✅ Сдан</span>
          <span title="Пройден в режиме Хардкор">💀 Хардкор</span>
          <span title="Пройден бонусный уровень Prince of Persia">⚔️ Принц</span>
          <span title="Пройден Лого-Шторм">⚡ Лого-Шторм</span>
        </div>
      </div>

      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <span
          id="prince-campaign-counter"
          class="text-xs font-bold text-amber-900 bg-amber-100 border border-amber-400 px-2 py-0.5 select-none"
          title="Прогресс сквозной кампании Prince of Persia"
        >
          ⚔️ Принц: 0 / {totalCampaignStages} этапов
        </span>
        <span id="student-name" class="font-semibold text-xs sm:text-sm text-gray-900"></span>
        <span id="class-name" class="text-xs text-gray-600 bg-gray-100 border border-gray-300 px-2 py-0.5"></span>
        <button id="logout-btn" class="border border-red-500 text-red-600 px-2.5 py-0.5 hover:bg-red-50 transition-colors text-xs font-semibold cursor-pointer">
          Выйти
        </button>
      </div>
    </header>

    <main id="lessons-matrix" class="flex-1 min-h-0 overflow-auto p-2 bg-gray-100">
      <div class="inline-flex flex-col gap-1 min-w-max">
        {matrixCourses.map((course) => (
          <section class="flex items-stretch gap-1" data-course-row={course.slug}>
            <div
              class="w-16 sm:w-20 shrink-0 sticky left-0 z-10 bg-gray-900 text-white px-2 py-1 flex flex-col justify-center border border-gray-900 select-none"
              title={course.name}
            >
              <span class="text-[11px] font-bold leading-tight truncate">{course.shortLabel}</span>
              <span class="text-[9px] text-gray-400 font-mono leading-tight">{course.lessons.length} ур.</span>
            </div>

            <div class="flex flex-nowrap gap-1">
              {course.lessons.map((lesson) => (
                <a
                  href={`/lesson/${course.slug}/${lesson.id}`}
                  data-course={course.slug}
                  data-lesson={lesson.id}
                  data-ready={lesson.ready ? '1' : '0'}
                  data-base-title={`${course.name} • Урок ${lesson.id}: ${lesson.topic}`}
                  title={`${course.name} • Урок ${lesson.id}: ${lesson.topic}`}
                  class={
                    lesson.ready
                      ? 'lesson-card w-[144px] h-[60px] p-1.5 flex flex-col justify-between bg-white border border-gray-300 text-gray-900 hover:border-blue-600 hover:bg-blue-50/40 transition-colors shrink-0'
                      : 'lesson-card w-[144px] h-[60px] p-1.5 flex flex-col justify-between bg-gray-50 border border-gray-200 text-gray-400 hover:border-gray-400 hover:text-gray-700 hover:bg-white transition-colors shrink-0'
                  }
                >
                  <div class="flex items-center justify-between gap-1 text-[10px] leading-none">
                    <span class={lesson.ready ? 'font-semibold text-gray-500 uppercase truncate shrink-0' : 'font-medium text-gray-400 uppercase truncate shrink-0'}>
                      {course.shortLabel}
                    </span>
                    <span class="card-status-badges flex items-center gap-0.5 text-[10px] leading-none truncate"></span>
                    <span class={lesson.ready ? 'font-mono font-bold text-blue-700 shrink-0' : 'font-mono font-semibold text-gray-400 shrink-0'}>
                      №{lesson.id}
                    </span>
                  </div>
                  <div class="text-[11px] leading-[1.2] font-medium line-clamp-2 overflow-hidden">
                    {lesson.topic}
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </main>
  </div>
</Layout>

<script>
  import coursesData from '../data/courses.json';

  const firstName = localStorage.getItem('student_firstName');
  const lastName = localStorage.getItem('student_lastName');
  const studentClass = localStorage.getItem('student_class');

  if (!firstName || !lastName || !studentClass) {
    window.location.href = '/';
  } else {
    const studentNameEl = document.getElementById('student-name');
    const classNameEl = document.getElementById('class-name');

    if (studentNameEl) studentNameEl.textContent = `${lastName} ${firstName}`;

    const homeCourse = coursesData.find((c) => c.slug === studentClass);
    if (classNameEl) {
      classNameEl.textContent = homeCourse ? `Мой класс: ${homeCourse.name}` : studentClass;
    }

    const matrixEl = document.getElementById('lessons-matrix');
    if (matrixEl) {
      matrixEl.addEventListener(
        'wheel',
        (e) => {
          if (e.deltaY !== 0 && e.deltaX === 0 && matrixEl.scrollHeight <= matrixEl.clientHeight) {
            e.preventDefault();
            matrixEl.scrollLeft += e.deltaY;
          }
        },
        { passive: false }
      );
    }

    async function loadMatrixProgress() {
      try {
        const res = await fetch(
          `/api/matrix-progress?firstName=${encodeURIComponent(firstName!)}&lastName=${encodeURIComponent(lastName!)}&className=${encodeURIComponent(studentClass!)}`
        );
        if (!res.ok) return;
        const data = await res.json();
        const lessons = data?.lessons || {};

        const campaignCounterEl = document.getElementById('prince-campaign-counter');
        if (campaignCounterEl && data?.princeCampaign) {
          const completedCount = Number(data.princeCampaign.completedCount ?? 0);
          const totalStages = Number(data.princeCampaign.totalStages ?? 0);
          const currentStage = data.princeCampaign.currentStage;
          campaignCounterEl.textContent = `⚔️ Принц: ${completedCount} / ${totalStages} этапов`;
          if (totalStages > 0 && completedCount >= totalStages) {
            campaignCounterEl.className =
              'text-xs font-bold text-emerald-900 bg-emerald-100 border border-emerald-500 px-2 py-0.5 select-none';
            campaignCounterEl.title = `Кампания Prince of Persia полностью пройдена (${completedCount} из ${totalStages})!`;
          } else if (currentStage) {
            campaignCounterEl.title = `Прогресс кампании Prince of Persia • Следующий этап: №${currentStage}`;
          }
        }

        const cards = document.querySelectorAll<HTMLAnchorElement>('.lesson-card');
        cards.forEach((card) => {
          const cSlug = card.dataset.course;
          const lId = card.dataset.lesson;
          if (!cSlug || !lId) return;

          const info = lessons[`${cSlug}::${lId}`];
          if (!info) return;

          const badgesEl = card.querySelector('.card-status-badges');
          const statusParts: string[] = [];

          // Apply level color when stopped in progress, or completed style when finished
          if (info.completed) {
            card.className =
              'lesson-card w-[144px] h-[60px] p-1.5 flex flex-col justify-between bg-sky-50 border-2 border-sky-600 text-gray-900 hover:bg-sky-100/70 transition-colors shrink-0';
            card.dataset.progressState = 'completed';
            statusParts.push('Урок сдан');
          } else if (info.stoppedLevel === 1) {
            card.className =
              'lesson-card w-[144px] h-[60px] p-1.5 flex flex-col justify-between bg-emerald-50 border-2 border-emerald-500 text-emerald-950 hover:bg-emerald-100/70 transition-colors shrink-0';
            card.dataset.progressState = 'stopped-1';
            statusParts.push('Остановился на Уровне 1');
          } else if (info.stoppedLevel === 2) {
            card.className =
              'lesson-card w-[144px] h-[60px] p-1.5 flex flex-col justify-between bg-amber-50 border-2 border-amber-500 text-amber-950 hover:bg-amber-100/70 transition-colors shrink-0';
            card.dataset.progressState = 'stopped-2';
            statusParts.push('Остановился на Уровне 2');
          } else if (info.stoppedLevel === 3) {
            card.className =
              'lesson-card w-[144px] h-[60px] p-1.5 flex flex-col justify-between bg-red-50 border-2 border-red-500 text-red-950 hover:bg-red-100/70 transition-colors shrink-0';
            card.dataset.progressState = 'stopped-3';
            statusParts.push('Остановился на Уровне 3');
          }

          if (badgesEl) {
            let badgesHtml = '';
            if (info.completed) {
              badgesHtml += '<span title="Урок пройден">✅</span>';
            } else if (info.stoppedLevel > 0) {
              const lvlBadgeColor =
                info.stoppedLevel === 1
                  ? 'bg-emerald-600 text-white'
                  : info.stoppedLevel === 2
                    ? 'bg-amber-500 text-white'
                    : 'bg-red-600 text-white';
              badgesHtml += `<span class="px-1 py-0 text-[9px] font-bold ${lvlBadgeColor}" title="Текущий уровень">Ур.${info.stoppedLevel}</span>`;
            }

            if (info.hardcoreCompleted) {
              badgesHtml += '<span title="Пройден в режиме Хардкор">💀</span>';
              statusParts.push('💀 Хардкор');
            }
            if (typeof info.princeStage === 'number') {
              badgesHtml += `<span class="px-1 py-0 text-[9px] font-bold bg-amber-100 text-amber-900 border border-amber-400 leading-none shrink-0" title="Пройден этап ${info.princeStage} кампании Prince of Persia">⚔️ Эт.${info.princeStage}</span>`;
              statusParts.push(`⚔️ Принц: Этап ${info.princeStage}`);
            } else if (info.princeCompleted) {
              badgesHtml += '<span title="Пройден бонусный уровень Prince of Persia">⚔️</span>';
              statusParts.push('⚔️ Prince of Persia');
            }
            if (info.sprintCompleted) {
              badgesHtml += '<span title="Пройден Лого-Шторм">⚡</span>';
              statusParts.push('⚡ Лого-Шторм');
            }

            badgesEl.innerHTML = badgesHtml;
          }

          const baseTitle = card.dataset.baseTitle || card.title;
          if (statusParts.length > 0) {
            card.title = `${baseTitle} [${statusParts.join(' • ')}]`;
          }
        });
      } catch (e) {
        console.warn('Matrix progress fetch failed:', e);
      }
    }

    loadMatrixProgress();

    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        localStorage.removeItem('student_firstName');
        localStorage.removeItem('student_lastName');
        localStorage.removeItem('student_class');
        window.location.href = '/';
      });
    }
  }
</script>
