---
import Layout from '../../layouts/Layout.astro';
import HotlineKumir from '../../components/HotlineKumir.astro';
---

<Layout title="Кибер-Boy — Ночной стелс и скоростное программирование">
  <HotlineKumir />
</Layout>

<script is:inline src="/static/lms-telemetry.js"></script>
<script>
  import { initHotlineKumirController } from '../../lib/hotline-kumir/controller.ts';
  import type { MaskId } from '../../lib/hotline-kumir/types.ts';

  const root = document.getElementById('hotline-kumir-root');
  const studentBadge = document.getElementById('hk-student-badge');
  const backLink = document.getElementById('hk-back-link') as HTMLAnchorElement | null;

  const urlParams = new URLSearchParams(window.location.search);
  const rawReturnTo = urlParams.get('returnTo') || '';
  if (backLink && /^\/lesson\/[^/]+\/[^/]+$/.test(rawReturnTo) && !rawReturnTo.includes('//')) {
    backLink.href = rawReturnTo;
    backLink.textContent = '← К УРОКУ';
  }

  const firstName = (localStorage.getItem('student_firstName') || 'Агент').trim();
  const lastName = (localStorage.getItem('student_lastName') || 'Ночной').trim();
  const studentClass = (localStorage.getItem('student_class') || '8-класс').trim();

  if (studentBadge) {
    studentBadge.textContent = `${lastName} ${firstName} (${studentClass})`;
  }

  const studentStorageKey = `${studentClass}:${lastName}:${firstName}`;
  const levelStorageKey = `cyber_boy_level:${studentStorageKey}`;
  const maskStorageKey = `cyber_boy_mask:${studentStorageKey}`;

  const cachedLevel = parseInt(localStorage.getItem(levelStorageKey) || '1', 10);
  const initialLevel = Number.isFinite(cachedLevel) ? Math.min(5, Math.max(1, cachedLevel)) : 1;
  const cachedMask = (localStorage.getItem(maskStorageKey) || 'richard') as MaskId;

  if (root) {
    const tracker = window.LMSTelemetry?.create?.({
      missionName: 'Кибер-Boy',
      totalStages: 5,
    });

    initHotlineKumirController(root, {
      initialLevel,
      initialMask: cachedMask,
      loadSavedProgress: async () => {
        try {
          const res = await fetch(
            `/api/hotline-kumir/progress?firstName=${encodeURIComponent(firstName)}&lastName=${encodeURIComponent(lastName)}&className=${encodeURIComponent(studentClass)}`
          );
          if (!res.ok) return null;
          const data = await res.json();
          const currentLevel = Math.min(5, Math.max(1, Number(data?.currentLevel || 1)));
          localStorage.setItem(levelStorageKey, String(currentLevel));
          if (data?.selectedMask) {
            localStorage.setItem(maskStorageKey, String(data.selectedMask));
          }
          return {
            currentLevel,
            completedCount: Number(data?.completedCount || 0),
            campaignCompleted: Boolean(data?.campaignCompleted),
            selectedMask: data?.selectedMask as MaskId | undefined,
          };
        } catch {
          return null;
        }
      },
      onLevelChange: (levelId, mask) => {
        localStorage.setItem(levelStorageKey, String(levelId));
        localStorage.setItem(maskStorageKey, mask);
      },
      onMissionStart: () => {
        tracker?.start?.();
        tracker?.markActivity?.();
      },
      onMissionComplete: async (result, snap) => {
        const optimisticNext = Math.min(5, result.levelId + 1);
        localStorage.setItem(levelStorageKey, String(optimisticNext));
        localStorage.setItem(maskStorageKey, result.mask);
        const meta = {
          level: result.levelId,
          mask: result.mask,
          outcome_branch: result.outcomeBranch,
          grade: result.grade,
          score: result.score,
          lines_of_code: result.locCount,
          used_loops: result.usedLoops,
          used_conditions: result.usedConditions,
          used_subprograms: result.usedSubprograms,
          linux_commands_count: result.linuxCommandsCount,
          time_spent_sec: result.timeSpentSec,
        };

        const payload = {
          student_firstName: firstName,
          student_lastName: lastName,
          student_class: studentClass,
          course_slug: 'games',
          lesson_id: 'hotline-kumir',
          level_number: 0,
          mission_name: `Сцена ${result.levelId}: ${snap.levelTitle} [${result.styleBadge}]`,
          action_type: 'hotline_kumir_complete',
          start_time: new Date().toISOString(),
          time_spent_sec: result.timeSpentSec,
          attempts_count: Math.max(1, result.turnsUsed),
          success: true,
          status: 'completed',
          action_log: [meta],
        };

        try {
          if (window.parent && window.parent !== window && tracker?.send) {
            tracker.send('hotline_kumir_complete', payload);
          } else {
            const [, progRes] = await Promise.all([
              fetch('/api/telemetry', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
              }),
              fetch('/api/hotline-kumir/progress', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  firstName,
                  lastName,
                  className: studentClass,
                  levelId: result.levelId,
                  grade: result.grade,
                  score: result.score,
                  styleBadge: result.styleBadge,
                  maskId: result.mask,
                  locCount: result.locCount,
                  usedLoops: result.usedLoops,
                  usedConditions: result.usedConditions,
                  usedSubprograms: result.usedSubprograms,
                  linuxCommandsCount: result.linuxCommandsCount,
                  timeSpentSec: result.timeSpentSec,
                }),
              }),
            ]);
            if (progRes.ok) {
              const progData = await progRes.json();
              if (progData?.currentLevel) {
                localStorage.setItem(levelStorageKey, String(progData.currentLevel));
              }
            }
          }
        } catch (err) {
          console.warn('Telemetry send error:', err);
        }
      },
    });
  }
</script>
