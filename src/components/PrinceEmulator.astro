---
// src/components/PrinceEmulator.astro
export interface Props {
  missionName?: string;
  level?: number;
  maxLevel?: number;
  health?: number;
  skipTitle?: boolean;
  theme?: 'gold' | 'green' | 'orange' | 'red';
}

const {
  missionName = 'Prince of Persia (1989)',
  level = 1,
  maxLevel,
  health = 3,
  skipTitle = true,
  theme = 'gold'
} = Astro.props;

const themeBorder = theme === 'green' ? 'border-success' : theme === 'orange' ? 'border-warning' : theme === 'red' ? 'border-danger' : 'border-warning';
const themeText = theme === 'green' ? 'text-success' : theme === 'orange' ? 'text-warning' : theme === 'red' ? 'text-danger' : 'text-warning';
const btnClass = theme === 'green' ? 'btn-outline-success' : theme === 'orange' ? 'btn-outline-warning' : theme === 'red' ? 'btn-outline-danger' : 'btn-outline-warning';

const effectiveMaxLevel = maxLevel !== undefined ? maxLevel : level;
const iframeUrl = `/static/prince/index.html?level=${level}&maxLevel=${effectiveMaxLevel}&health=${health}&skipTitle=${skipTitle}`;
---

<div class={`prince-emulator-wrapper d-flex flex-column h-100 bg-black rounded-0 border ${themeBorder}`} style="font-family: monospace;">
  <!-- Retro Game Header -->
  <div class="d-flex justify-content-between align-items-center bg-dark p-2 border-bottom border-secondary">
    <div class="d-flex align-items-center gap-2">
      <span class="fs-5">⚔️</span>
      <span class={`fw-bold ${themeText}`}>PRINCE OF PERSIA (1989)</span>
      <span class="badge bg-black text-white border border-secondary rounded-0 font-monospace">УРОВЕНЬ {level}</span>
    </div>
    
    <div class="d-flex align-items-center gap-2">
      <button type="button" id="prince-restart-btn" class="btn btn-outline-secondary btn-sm rounded-0 font-monospace text-light" title="Перезапустить уровень">
        🔄 РЕСТАРТ
      </button>
      <button type="button" id="prince-fs-btn" class={`btn ${btnClass} btn-sm rounded-0 font-monospace fw-bold`} title="Полноэкранный режим">
        ⛶ НА ВЕСЬ ЭКРАН
      </button>
    </div>
  </div>

  <!-- Controls Reminder Banner -->
  <div class="bg-black text-secondary px-3 py-1 border-bottom border-secondary small d-flex justify-content-between flex-wrap">
    <span>Управление: <strong>[← / →]</strong> Движение/Шаг | <strong>[↑]</strong> Прыжок/Подтянуться | <strong>[↓]</strong> Присесть | <strong>[Shift]</strong> Удар мечом/Шаг/Предмет</span>
    <span class="text-muted">Jordan Mechner / HTML5: Oliver Klemenz</span>
  </div>

  <!-- Game Container -->
  <div class="flex-grow-1 position-relative bg-black d-flex align-items-center justify-content-center overflow-hidden" id="prince-screen-box">
    <iframe
      id="prince-frame"
      src={iframeUrl}
      class="w-100 h-100 border-0"
      title="Prince of Persia"
      allow="fullscreen; gamepad"
    ></iframe>
  </div>
</div>

<script define:vars={{ missionName, level }}>
  const wrapper = document.querySelector('.prince-emulator-wrapper');
  const iframe = document.getElementById('prince-frame');
  const fsBtn = document.getElementById('prince-fs-btn');
  const restartBtn = document.getElementById('prince-restart-btn');

  let startTime = Date.now();

  if (restartBtn && iframe) {
    restartBtn.addEventListener('click', () => {
      iframe.src = iframe.src;
    });
  }

  if (fsBtn && wrapper) {
    fsBtn.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        wrapper.requestFullscreen().catch(err => {
          console.warn('Fullscreen request failed:', err);
        });
        fsBtn.innerText = '✖ СВЕРНУТЬ';
      } else {
        document.exitFullscreen().catch(err => console.warn(err));
        fsBtn.innerText = '⛶ НА ВЕСЬ ЭКРАН';
      }
    });

    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) {
        fsBtn.innerText = '⛶ НА ВЕСЬ ЭКРАН';
      }
    });
  }

  window.addEventListener('message', (event) => {
    const data = event.data;
    if (data && data.type === 'PRINCE_EVENT') {
      console.log('[PrinceEmulator] Received event:', data);
      if (data.action === 'level_complete' && missionName) {
        const timeSpent = Math.floor((Date.now() - startTime) / 1000);
        window.parent.postMessage({
          type: 'TELEMETRY_EVENT',
          mission_name: `${missionName} :: Уровень ${data.completedLevel || level}`,
          action_type: 'level_complete',
          status: 'completed',
          time_spent_sec: timeSpent,
          attempts_count: 1,
          success: true
        }, '*');
      }
    }
  });
</script>
