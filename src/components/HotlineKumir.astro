---
// Cyber-Boy UI shell (30% Mission + KuMir editor / 70% Canvas 2D arena)
import CyberTerminal from './ui/CyberTerminal.astro';
import LinuxTerminalHelpModal from './ui/LinuxTerminalHelpModal.astro';
---

<div
  id="hotline-kumir-root"
  class="h-screen w-full overflow-hidden flex flex-col bg-[#0B0618] text-slate-100 font-mono select-none"
>
  <!-- Top HUD Bar -->
  <header class="shrink-0 bg-black border-b-2 border-pink-600 px-3 py-1.5 flex items-center justify-between gap-2 flex-wrap">
    <div class="flex items-center gap-2 min-w-0">
      <a
        id="hk-back-link"
        href="/courses"
        class="px-2 py-0.5 text-xs font-bold bg-slate-900 border border-slate-600 text-slate-300 hover:border-cyan-400 hover:text-cyan-300 rounded-0"
      >
        ← КУРСЫ
      </a>
      <span class="text-sm sm:text-base font-black tracking-wider text-pink-500">КИБЕР-BOY</span>
      <span
        id="hk-campaign-badge"
        class="hidden px-2 py-0.5 text-xs font-bold bg-emerald-950 border border-emerald-400 text-emerald-300 rounded-0"
      >
        ПРОЙДЕНО 5/5
      </span>
      <span
        id="hk-mask-badge"
        class="hidden md:inline-block px-2 py-0.5 text-xs bg-pink-950/70 border border-pink-500 text-pink-200 rounded-0"
      >
        Петух «Ричард»
      </span>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <span id="hk-phase-badge" class="px-2 py-0.5 text-xs font-bold bg-cyan-950 text-cyan-300 border border-cyan-500 rounded-0">
        СТЕЛС
      </span>
      <span id="hk-hp-badge" class="px-2 py-0.5 text-xs bg-slate-900 border border-emerald-500 text-emerald-300 rounded-0">
        ЗДОРОВЬЕ: 3
      </span>
      <span id="hk-ids-badge" class="px-2 py-0.5 text-xs bg-slate-900 border border-amber-500 text-amber-300 rounded-0">
        IDS: 0/3
      </span>
      <span id="hk-student-badge" class="hidden lg:inline-block px-2 py-0.5 text-xs bg-slate-900 border border-slate-700 text-slate-300 rounded-0">
        АГЕНТ
      </span>
      <button
        id="hk-btn-mute"
        type="button"
        class="px-2 py-0.5 text-xs bg-slate-900 border border-slate-600 text-slate-200 hover:border-cyan-400 rounded-0 cursor-pointer"
      >
        🔊 ЗВУК: ВКЛ
      </button>
    </div>
  </header>

  <!-- GBR Alert Dispatch Tracker -->
  <div
    id="hk-gbr-tracker"
    class="hidden shrink-0 bg-red-950/80 border-b-2 border-red-500 px-3 py-1 flex items-center justify-between gap-3 flex-wrap"
  >
    <div class="flex items-center gap-2">
      <canvas
        id="hk-gbr-portrait"
        width="32"
        height="32"
        class="shrink-0 border border-red-400 bg-black"
        style="image-rendering: pixelated;"
      ></canvas>
      <span class="px-1.5 py-0.5 text-[11px] font-black bg-red-600 text-white rounded-0">РАЦИЯ ГБР</span>
      <span id="hk-gbr-eta-text" class="text-xs font-bold text-red-200">ГБР ПРИБУДЕТ ЧЕРЕЗ: 5 ХОД.</span>
    </div>
    <div class="flex items-center gap-2">
      <div
        id="hk-gbr-road-track"
        class="relative w-44 sm:w-56 h-5 bg-slate-950 border border-red-500/80 overflow-hidden shrink-0"
      >
        <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 border-t border-dashed border-amber-400/50"></div>
        <div
          id="hk-gbr-van-marker"
          class="absolute top-0.5 bottom-0.5 left-0 w-7 bg-slate-800 border border-slate-300 flex items-center justify-between px-0.5 transition-all duration-300 ease-out"
          style="left: 0%;"
        >
          <span class="w-1.5 h-1.5 bg-red-500 animate-pulse"></span>
          <span class="text-[8px] font-black text-white leading-none">ГБР</span>
          <span class="w-1.5 h-1.5 bg-cyan-400 animate-pulse"></span>
        </div>
      </div>
      <div class="flex items-center gap-1">
        <span data-gbr-seg="0" class="px-1.5 py-0.5 text-[10px] bg-red-600 text-white border border-red-300 rounded-0">БАЗА</span>
        <span data-gbr-seg="1" class="px-1.5 py-0.5 text-[10px] bg-slate-900 text-slate-400 border border-slate-700 rounded-0">УЛИЦА</span>
        <span data-gbr-seg="2" class="px-1.5 py-0.5 text-[10px] bg-slate-900 text-slate-400 border border-slate-700 rounded-0">ДВОР</span>
        <span data-gbr-seg="3" class="px-1.5 py-0.5 text-[10px] bg-slate-900 text-slate-400 border border-slate-700 rounded-0">ГЛ. ВХОД</span>
      </div>
    </div>
  </div>

  <!-- Main Split-Screen (30% Left Panel / 70% Arena, calibrated for 1366x768) -->
  <main class="flex-1 min-h-0 grid grid-cols-1 lg:grid-cols-10 gap-2 p-2 overflow-hidden">
    <!-- Left Column (30%): Top Detailed Mission + Middle KuMir Editor + Bottom 6 Clue Slots -->
    <section id="hk-editor-pane" class="lg:col-span-3 flex flex-col gap-2 min-h-0 overflow-hidden">
      <!-- Top Left: Detailed Mission Description Only -->
      <div id="hk-mission-panel" class="shrink-0 max-h-[29%] flex flex-col bg-[#110824] border-2 border-cyan-500/80 rounded-0 overflow-hidden">
        <div class="shrink-0 px-2.5 py-1 bg-black/85 border-b border-cyan-700/60 flex items-center justify-between gap-2">
          <span class="text-[11px] font-black tracking-wide text-cyan-300">ЗАДАЧА МИССИИ</span>
          <span
            id="hk-level-badge"
            class="bg-slate-950 border border-cyan-500/80 text-cyan-300 text-[10px] font-bold px-1.5 py-0.5 rounded-0 truncate max-w-[170px]"
          >
            Ур.1/5: Ночной КПП
          </span>
        </div>
        <div class="flex-1 min-h-0 overflow-y-auto px-2.5 py-1.5 space-y-1 select-text">
          <p id="hk-mission-desc" class="text-[11px] leading-snug text-slate-200"></p>
          <ul id="hk-mission-objectives" class="space-y-0.5 text-[10px] leading-4 text-slate-300"></ul>
        </div>
        <div class="shrink-0 px-2.5 py-0.5 bg-black/75 border-t border-cyan-900/60 text-[10px] text-cyan-300/90">
          Справка по языку: введите «помощь» или «справка»
        </div>
      </div>

      <!-- Middle Left: KuMir Speed-Coding Editor -->
      <div id="hk-code-panel" class="flex-1 min-h-0 flex flex-col bg-[#110824] border-2 border-pink-600/80 rounded-0 overflow-hidden">
        <div class="shrink-0 px-2.5 py-1.5 bg-black/80 border-b border-pink-700/60 flex items-center justify-between gap-2">
          <div class="flex items-center gap-1.5 min-w-0">
            <span class="text-xs font-bold text-cyan-300 truncate">РЕДАКТОР КУМИР</span>
            <span id="hk-active-line-label" class="text-[10px] text-slate-400 shrink-0">Готов</span>
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            <span class="text-[10px] text-pink-300 hidden xl:inline">ХОД:</span>
            <span id="hk-turn-timer" class="px-2 py-0.5 font-mono text-base font-black bg-slate-950 border-2 border-cyan-400 text-cyan-300 rounded-0">
              35с
            </span>
          </div>
        </div>

        <!-- Editor Area -->
        <div class="flex-1 min-h-0 flex bg-[#090414] overflow-hidden">
          <pre
            id="hk-line-gutter"
            class="w-9 shrink-0 py-2 px-1 text-right text-xs leading-5 text-pink-400/70 bg-black/50 border-r border-pink-900/60 overflow-hidden select-none"
          >  1</pre>
          <textarea
            id="hk-code-editor"
            aria-label="Редактор программы КуМир"
            spellcheck="false"
            class="flex-1 min-w-0 p-2 bg-transparent text-sm leading-5 text-cyan-100 focus:outline-none resize-none overflow-auto select-text"
          ></textarea>
        </div>

        <!-- Error Bar -->
        <div
          id="hk-error-box"
          class="hidden shrink-0 px-2.5 py-1.5 bg-red-950 border-t border-red-500 text-xs font-bold text-red-200 rounded-0"
        ></div>

        <!-- Action Buttons -->
        <div class="shrink-0 px-2 py-1.5 bg-black border-t border-pink-600/80 flex items-center justify-between gap-1.5 flex-wrap">
          <div class="flex items-center gap-1">
            <button
              id="hk-btn-run"
              type="button"
              class="px-2.5 py-1 text-[11px] font-black bg-pink-600 hover:bg-pink-500 text-white border border-pink-300 rounded-0 cursor-pointer"
            >
              ▶ ЗАПУСК
            </button>
            <button
              id="hk-btn-step"
              type="button"
              class="px-2 py-1 text-[11px] font-bold bg-slate-900 hover:bg-slate-800 text-cyan-300 border border-cyan-500 rounded-0 cursor-pointer"
            >
              ШАГ (F8)
            </button>
            <button
              id="hk-btn-reset"
              type="button"
              class="px-2 py-1 text-[11px] font-bold bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-600 rounded-0 cursor-pointer"
            >
              ↺ [R]
            </button>
          </div>
          <button
            id="hk-btn-open-term"
            type="button"
            class="px-2 py-1 text-[11px] font-bold bg-emerald-950 hover:bg-emerald-900 text-emerald-300 border border-emerald-500 rounded-0 cursor-pointer"
          >
            &gt;_ ПК
          </button>
        </div>
      </div>

      <!-- Bottom Left: Collected Clues Panel (6 interactive slots) -->
      <div
        id="hk-clues-panel"
        class="shrink-0 h-[156px] flex flex-col bg-[#110824] border-2 border-amber-500/80 rounded-0 overflow-hidden"
      >
        <div class="shrink-0 px-2.5 py-1 bg-black/85 border-b border-amber-700/60 flex items-center justify-between gap-2">
          <span class="text-[11px] font-black tracking-wide text-amber-300">СОБРАННЫЕ УЛИКИ</span>
          <span
            id="hk-clues-count"
            class="bg-slate-950 border border-amber-500/70 text-amber-200 text-[10px] font-bold px-1.5 py-0.5 rounded-0"
          >
            0/6
          </span>
        </div>
        <div
          id="hk-clue-slots"
          class="shrink-0 grid grid-cols-6 gap-1 px-2 py-1 bg-black/60 border-b border-amber-900/60"
        >
          <button type="button" data-clue-slot="0" disabled class="h-7 text-[10px] font-bold bg-slate-950/80 border border-slate-800 text-slate-600 rounded-0">1</button>
          <button type="button" data-clue-slot="1" disabled class="h-7 text-[10px] font-bold bg-slate-950/80 border border-slate-800 text-slate-600 rounded-0">2</button>
          <button type="button" data-clue-slot="2" disabled class="h-7 text-[10px] font-bold bg-slate-950/80 border border-slate-800 text-slate-600 rounded-0">3</button>
          <button type="button" data-clue-slot="3" disabled class="h-7 text-[10px] font-bold bg-slate-950/80 border border-slate-800 text-slate-600 rounded-0">4</button>
          <button type="button" data-clue-slot="4" disabled class="h-7 text-[10px] font-bold bg-slate-950/80 border border-slate-800 text-slate-600 rounded-0">5</button>
          <button type="button" data-clue-slot="5" disabled class="h-7 text-[10px] font-bold bg-slate-950/80 border border-slate-800 text-slate-600 rounded-0">6</button>
        </div>
        <div
          id="hk-intel-box"
          class="flex-1 min-h-0 overflow-y-auto px-2.5 py-1.5 text-[11px] leading-snug text-slate-400 select-text"
        >
          Улики пока не собраны. Подойди к объекту [?] и введи «осмотреть».
        </div>
      </div>
    </section>

    <!-- Right Column: Night Canvas 2D Arena (70%) -->
    <section id="hk-arena-pane" class="lg:col-span-7 flex flex-col min-h-0 bg-black border-2 border-cyan-500/80 rounded-0 overflow-hidden">
      <div class="shrink-0 px-3 py-1.5 bg-slate-950 border-b border-cyan-700/60 flex items-center justify-between gap-2 flex-wrap">
        <span id="hk-obj-status" class="text-xs font-bold text-cyan-300">ПК: ЗАКРЫТ | МЕТКИ (*): 0/1 | ВЫХОД: ЗАБЛОКИРОВАН</span>
        <div class="flex items-center gap-1.5">
          <span id="hk-hover-info" class="hidden xl:inline-block px-1.5 py-0.5 text-[11px] bg-black border border-slate-700 text-amber-200 font-mono truncate max-w-[260px] rounded-0">Наведи на объект</span>
          <span id="hk-tile-coords" class="px-1.5 py-0.5 text-[11px] bg-black border border-slate-700 text-cyan-200 font-mono rounded-0">x:— y:—</span>
          <button
            id="hk-btn-cam-follow"
            type="button"
            class="px-2 py-0.5 text-[11px] font-bold bg-cyan-950 border border-cyan-400 text-cyan-200 hover:bg-cyan-900 rounded-0 cursor-pointer"
          >
            🎯 РОБОТ
          </button>
          <button
            id="hk-btn-cam-overview"
            type="button"
            class="px-2 py-0.5 text-[11px] font-bold bg-slate-900 border border-slate-600 text-slate-300 hover:border-pink-400 rounded-0 cursor-pointer"
          >
            🗺 ОБЗОР [Tab]
          </button>
          <button
            id="hk-btn-cam-zoom-in"
            type="button"
            aria-label="Приблизить камеру"
            class="px-2 py-0.5 text-[11px] font-bold bg-slate-900 border border-slate-600 text-slate-200 hover:border-cyan-400 rounded-0 cursor-pointer"
          >
            +
          </button>
          <button
            id="hk-btn-cam-zoom-out"
            type="button"
            aria-label="Отдалить камеру"
            class="px-2 py-0.5 text-[11px] font-bold bg-slate-900 border border-slate-600 text-slate-200 hover:border-cyan-400 rounded-0 cursor-pointer"
          >
            −
          </button>
        </div>
      </div>

      <div class="flex-1 min-h-0 relative bg-[#070312] overflow-hidden">
        <canvas
          id="hk-arena-canvas"
          class="w-full h-full block cursor-grab active:cursor-grabbing bg-[#070312]"
          style="image-rendering: pixelated;"
        ></canvas>
      </div>
    </section>
  </main>

  <!-- Briefing & Mask Overlay -->
  <div
    id="hk-briefing-overlay"
    class="hidden fixed inset-0 z-30 bg-black/90 items-center justify-center p-4"
  >
    <div class="w-full max-w-2xl bg-[#110824] border-2 border-pink-500 p-5 rounded-0 flex flex-col gap-4">
      <div class="flex items-center justify-between border-b border-pink-600 pb-2">
        <div>
          <div id="hk-briefing-time" class="text-xs font-bold text-cyan-400">АВТООТВЕТЧИК // 00:14</div>
          <h2 id="hk-briefing-title" class="text-xl font-black text-pink-400">УРОВЕНЬ 1: НОЧНОЙ КПП</h2>
        </div>
        <span id="hk-briefing-curriculum" class="px-2 py-1 text-[11px] bg-slate-900 border border-slate-700 text-slate-300 rounded-0">
          8 класс
        </span>
      </div>

      <div class="flex items-start gap-4">
        <canvas
          id="hk-briefing-portrait"
          width="96"
          height="96"
          class="shrink-0 border-2 border-pink-500 bg-[#090414]"
          style="image-rendering: pixelated;"
        ></canvas>
        <p id="hk-briefing-text" class="text-sm leading-relaxed text-slate-200"></p>
      </div>

      <div>
        <div class="text-xs font-bold text-cyan-300 mb-2">ВЫБОР ЗВЕРИНОЙ МАСКИ:</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <button type="button" data-mask-choice="richard" class="p-2 text-left border-2 border-cyan-400 bg-cyan-950/70 text-white rounded-0 cursor-pointer flex items-center gap-2.5">
            <canvas data-mask-portrait="richard" width="36" height="36" class="shrink-0 border border-slate-600 bg-black" style="image-rendering: pixelated;"></canvas>
            <div>
              <div class="text-xs font-bold text-cyan-300">🐓 Петух «Ричард»</div>
              <div class="text-[11px] text-slate-300">Эталонный баланс и чёткий маршрут</div>
            </div>
          </button>
          <button type="button" data-mask-choice="rasmus" class="p-2 text-left border border-slate-700 bg-slate-900 text-slate-300 rounded-0 cursor-pointer flex items-center gap-2.5">
            <canvas data-mask-portrait="rasmus" width="36" height="36" class="shrink-0 border border-slate-600 bg-black" style="image-rendering: pixelated;"></canvas>
            <div>
              <div class="text-xs font-bold text-cyan-300">🦉 Сова «Расмус»</div>
              <div class="text-[11px] text-slate-300">Прогноз камер и шагов на +1 такт</div>
            </div>
          </button>
          <button type="button" data-mask-choice="tony" class="p-2 text-left border border-slate-700 bg-slate-900 text-slate-300 rounded-0 cursor-pointer flex items-center gap-2.5">
            <canvas data-mask-portrait="tony" width="36" height="36" class="shrink-0 border border-slate-600 bg-black" style="image-rendering: pixelated;"></canvas>
            <div>
              <div class="text-xs font-bold text-pink-300">🐺 Волк «Тони»</div>
              <div class="text-[11px] text-slate-300">+1 такт оглушения и быстрый рывок</div>
            </div>
          </button>
          <button type="button" data-mask-choice="sprint" class="p-2 text-left border border-slate-700 bg-slate-900 text-slate-300 rounded-0 cursor-pointer flex items-center gap-2.5">
            <canvas data-mask-portrait="sprint" width="36" height="36" class="shrink-0 border border-slate-600 bg-black" style="image-rendering: pixelated;"></canvas>
            <div>
              <div class="text-xs font-bold text-amber-300">🦊 Лис «Спринт»</div>
              <div class="text-[11px] text-slate-300">+1 ход / +15 с к ETA ГБР и лимит IDS 4</div>
            </div>
          </button>
        </div>
      </div>

      <div class="flex justify-end">
        <button
          id="hk-btn-start-mission"
          type="button"
          class="px-5 py-2 text-sm font-black bg-pink-600 hover:bg-pink-500 text-white border-2 border-pink-300 rounded-0 cursor-pointer"
        >
          НАЧАТЬ ОПЕРАЦИЮ ▶
        </button>
      </div>
    </div>
  </div>

  <!-- Linux Terminal Popup Overlay -->
  <div
    id="hk-terminal-overlay"
    class="hidden fixed inset-0 z-40 bg-black/90 backdrop-blur-md items-center justify-center p-4 sm:p-6"
  >
    <CyberTerminal
      id="hk-term-window"
      title="agent@kpp-gate:~ — bash"
      titleId="hk-term-title"
      mode="interactive"
      outputId="hk-term-output"
      outputTag="pre"
      inputId="hk-term-input"
      promptId="hk-term-prompt"
      promptText="agent@kpp-gate:~>"
      placeholder="Введи команду (например: ls -la, help)..."
      size="lg"
      compact={false}
      showGrid={true}
      showChevron={true}
      windowClass="w-full max-w-5xl h-[min(84vh,760px)]"
    >
      <Fragment slot="titlebar-right">
        <span id="hk-term-perimeter" class="ct-badge ct-badge--amber">КАМЕРЫ: 1 | IDS ШУМ: 0/3</span>
        <button id="hk-term-help" type="button" class="ct-btn">СПРАВКА [MAN]</button>
        <button id="hk-term-close" type="button" class="ct-btn ct-btn--danger">ЗАКРЫТЬ [ESC]</button>
      </Fragment>
      <Fragment slot="footer">
        <div class="ct-footer-hint">Справка по командам: введите «man», «help» или «справка [команда/раздел]»</div>
      </Fragment>
    </CyberTerminal>
  </div>

  <LinuxTerminalHelpModal id="hk-term-help-overlay" closeButtonId="hk-term-help-close" />

  <!-- KuMir Language Help Modal Overlay -->
  <div
    id="hk-help-overlay"
    class="hidden fixed inset-0 z-40 bg-black/88 items-center justify-center p-4"
  >
    <div class="w-full max-w-3xl max-h-[85vh] bg-[#110824] border-2 border-cyan-400 rounded-0 flex flex-col overflow-hidden">
      <div class="shrink-0 px-4 py-2.5 bg-black border-b border-cyan-600 flex items-center justify-between gap-2">
        <span class="text-xs sm:text-sm font-black tracking-wide text-cyan-300">
          РУКОВОДСТВО ПО ЯЗЫКУ КУМИР // КИБЕР-BOY
        </span>
        <button
          id="hk-help-close"
          type="button"
          class="px-2.5 py-1 text-xs font-bold bg-red-950 border border-red-500 text-red-200 hover:bg-red-900 rounded-0 cursor-pointer"
        >
          ЗАКРЫТЬ [ESC]
        </button>
      </div>
      <div
        id="hk-help-content"
        class="flex-1 min-h-0 overflow-y-auto p-4 space-y-4 text-xs leading-relaxed text-slate-200 select-text"
      ></div>
    </div>
  </div>

  <!-- Mission Result Overlay -->
  <div
    id="hk-result-overlay"
    class="hidden fixed inset-0 z-50 bg-black/90 items-center justify-center p-4"
  >
    <div class="w-full max-w-lg bg-[#110824] border-2 border-cyan-400 p-5 rounded-0 flex flex-col gap-4">
      <div class="flex items-center justify-between border-b border-cyan-600 pb-2">
        <h2 id="hk-result-title" class="text-lg font-black text-cyan-300">МИССИЯ ВЫПОЛНЕНА</h2>
        <span id="hk-result-grade" class="px-3 py-1 text-2xl font-black bg-pink-600 text-white border border-pink-300 rounded-0">S</span>
      </div>
      <div id="hk-result-style" class="text-sm font-bold text-pink-400">ПРИЗРАК (GHOST)</div>
      <div id="hk-result-stats" class="text-xs leading-6 text-slate-200"></div>
      <div class="flex items-center justify-end gap-2">
        <button
          id="hk-btn-retry-level"
          type="button"
          class="px-4 py-2 text-xs font-bold bg-slate-900 border border-slate-500 text-slate-200 hover:border-cyan-400 rounded-0 cursor-pointer"
        >
          ПОВТОРИТЬ [R]
        </button>
        <button
          id="hk-btn-next-level"
          type="button"
          class="px-4 py-2 text-xs font-black bg-emerald-600 hover:bg-emerald-500 text-white border border-emerald-300 rounded-0 cursor-pointer"
