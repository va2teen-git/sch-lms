<link rel="stylesheet" href="/static/jodit/jodit.min.css" />
<link rel="stylesheet" href="/static/lo-writer-26.css" />
<script src="/static/bootstrap.bundle.min.js" is:inline></script>
<script src="/static/jodit/jodit.min.js" is:inline></script>
<script src="/static/writer-validator.js" is:inline></script>

<script define:vars={{ missionName, hardcoreReset, checkOgeFormat, disableAutoTelemetry }}>
    let attempts = 0;
    let startTime = Date.now();
    let editor = null;
    let isNonPrintingActive = false;
    let isRulerActive = true;
    let isStatusBarVisible = true;
    let isTableToolbarPinned = false;
    let isFullscreenActive = false;
    let lastActivePara = null;
    let lastActiveTable = null;
    let lastActiveCell = null;
    let selectedTableCells = [];
    let lastSavedRange = null;
    let lastOgeReport = null;
    let dynamicCheckOgeFormat = checkOgeFormat !== false;
    let writerActionLog = [];
    let activeFontColor = '#c9211e';
    let activeBackColor = '#ffff00';
    let rulerDragState = null;
    const pendingInlineStates = {
        bold: false,
        italic: false,
        underline: false,
        strikethrough: false,
        superscript: false,
        subscript: false
    };

    function showLoStatusHint(text) {
        const statusEl = document.getElementById('writer-status');
        if (statusEl) {
            statusEl.className = 'text-secondary px-2';
            statusEl.innerText = text;
        }
    }

    function initRulersAndDrag() {
        // Отрисовка штрихов горизонтальной линейки (1..16 см с делениями по 0.5 см)
        const ticksEl = document.getElementById('ruler-ticks');
        if (ticksEl) {
            ticksEl.innerHTML = '';
            for (let cm = 0; cm <= 17; cm++) {
                const x = cm * 40;
                if (cm >= 1 && cm <= 16) {
                    const num = document.createElement('span');
                    num.style.cssText = `position:absolute; left:${x - 4}px; top:1px; width:12px; text-align:center; font-size:9px; line-height:11px; color:#333;`;
                    num.innerText = String(cm);
                    ticksEl.appendChild(num);
                }
                if (cm < 17) {
                    const halfTick = document.createElement('span');
                    halfTick.style.cssText = `position:absolute; left:${x + 20}px; bottom:0; width:1px; height:4px; background:#888;`;
                    ticksEl.appendChild(halfTick);
                    const quarter1 = document.createElement('span');
                    quarter1.style.cssText = `position:absolute; left:${x + 10}px; bottom:0; width:1px; height:2px; background:#bbb;`;
                    ticksEl.appendChild(quarter1);
                    const quarter3 = document.createElement('span');
                    quarter3.style.cssText = `position:absolute; left:${x + 30}px; bottom:0; width:1px; height:2px; background:#bbb;`;
                    ticksEl.appendChild(quarter3);
                }
            }
        }
        // Шкала вертикальной линейки
        const vTicks = document.getElementById('vruler-ticks');
        if (vTicks) {
            vTicks.innerHTML = '';
            for (let cm = 1; cm <= 27; cm++) {
                const y = cm * 40;
                const lbl = document.createElement('span');
                lbl.style.cssText = `position:absolute; top:${y - 5}px; left:1px; width:11px; text-align:center; font-size:8px; line-height:9px; color:#555;`;
                lbl.innerText = String(cm);
                vTicks.appendChild(lbl);
            }
        }

        // Интерактивное перетаскивание маркера красной строки (#ruler-first-line) с сохранением одиночного клика -> 1.0 см
        const firstLineMarker = document.getElementById('ruler-first-line');
        if (firstLineMarker) {
            firstLineMarker.addEventListener('mousedown', (e) => {
                e.preventDefault();
                saveCurrentEditorRange();
                const startX = e.clientX;
                const leftPx = Math.round(pageMargins.leftCm * 40);
                const curLeft = parseFloat(firstLineMarker.style.left || String(leftPx)) || leftPx;
                rulerDragState = { startX, origIndentPx: curLeft - leftPx, moved: false };
            });
            document.addEventListener('mousemove', (e) => {
                if (!rulerDragState) return;
                const dx = e.clientX - rulerDragState.startX;
                if (Math.abs(dx) > 4) {
                    rulerDragState.moved = true;
                    const newPx = Math.max(0, Math.min(200, rulerDragState.origIndentPx + dx));
                    const snappedCm = Math.round((newPx / 40) * 4) / 4; // шаг 0.25 см
                    updateRulerFirstLineMarker(snappedCm);
                    rulerDragState.snappedCm = snappedCm;
                }
            });
            document.addEventListener('mouseup', () => {
                if (!rulerDragState) return;
                const drag = rulerDragState;
                rulerDragState = null;
                if (drag.moved && typeof drag.snappedCm === 'number') {
                    applyParagraphStyle({ textIndent: `${drag.snappedCm}cm` });
                    recordWriterAction('ruler_first_line', { textIndent: `${drag.snappedCm}cm` });
                    showLoStatusHint(`Отступ первой строки: ${drag.snappedCm.toFixed(2).replace('.', ',')} см`);
                }
            });
        }
    }

    function toggleFullscreenMode(forceState = null) {
        const root = document.getElementById('lo-root-window');
        const pill = document.getElementById('lo-fullscreen-exit-btn');
        const nextState = forceState !== null ? !!forceState : !isFullscreenActive;
        isFullscreenActive = nextState;

        if (root) {
            root.classList.toggle('lo-is-fullscreen', isFullscreenActive);
        }
        if (pill) {
            pill.classList.toggle('d-none', !isFullscreenActive);
        }
        toggleBtnActive('btn-fullscreen', isFullscreenActive);
        toggleBtnActive('btn-window-fullscreen', isFullscreenActive);

        if (isFullscreenActive) {
            if (!document.fullscreenElement && root && root.requestFullscreen) {
                root.requestFullscreen().catch(() => {});
            }
        } else {
            if (document.fullscreenElement && document.exitFullscreen) {
                document.exitFullscreen().catch(() => {});
            }
        }
        recordWriterAction('toggle_fullscreen', { active: isFullscreenActive });
    }

    function saveCurrentEditorRange() {
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        if (!wysiwyg) return;
        const sel = window.getSelection();
        if (sel && sel.rangeCount > 0) {
            const r = sel.getRangeAt(0);
            if (wysiwyg.contains(r.commonAncestorContainer)) {
                lastSavedRange = r.cloneRange();
                const startEl = r.startContainer.nodeType === 1 ? r.startContainer : r.startContainer.parentElement;
                const p = startEl?.closest ? startEl.closest('p, h1, h2, h3, li') : null;
                if (p && wysiwyg.contains(p)) lastActivePara = p;
                const tbl = startEl?.closest ? startEl.closest('table') : null;
                if (tbl && wysiwyg.contains(tbl)) lastActiveTable = tbl;
            }
        }
    }

    function restoreSavedEditorRange() {
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        if (!wysiwyg) return;
        if (document.activeElement !== wysiwyg && !wysiwyg.contains(document.activeElement)) {
            wysiwyg.focus();
            if (lastSavedRange && wysiwyg.contains(lastSavedRange.commonAncestorContainer)) {
                const sel = window.getSelection();
                if (sel) {
                    sel.removeAllRanges();
                    sel.addRange(lastSavedRange.cloneRange());
                }
            }
        }
    }

    // Поля страницы по умолчанию (сырой режим: сброшены в 1.0 см)
    let pageMargins = {
        leftCm: 1.0,
        rightCm: 1.0,
        topCm: 1.0,
        bottomCm: 1.0
    };

    function recordWriterAction(type, details = {}) {
        const entry = {
            timestamp: new Date().toISOString(),
            elapsedMs: Date.now() - startTime,
            type,
            ...details
        };
        writerActionLog.push(entry);
        document.dispatchEvent(new CustomEvent('writer-action', { detail: entry }));
        emitWriterChange();
    }

    function getWriterState() {
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        const rawHtml = (wysiwyg && wysiwyg.innerHTML !== undefined) ? wysiwyg.innerHTML : (editor ? editor.value : '');
        const rawText = wysiwyg ? (wysiwyg.innerText || wysiwyg.textContent || '') : (editor ? editor.text : '');
        const html = rawHtml.replace(/[\uFEFF\u200B\u200C\u200D]/g, '');
        const text = rawText.replace(/[\uFEFF\u200B\u200C\u200D]/g, '');
        return {
            html,
            text,
            wysiwyg,
            pageMargins: { ...pageMargins },
            isNonPrintingActive,
            isRulerActive,
            actionLog: [...writerActionLog],
            editor
        };
    }

    function emitWriterChange() {
        document.dispatchEvent(new CustomEvent('writer-change', { detail: getWriterState() }));
    }

    function sendTelemetry(actionType, status, success = false) {
        if (disableAutoTelemetry) return;
        const levelMatch = String(missionName || '').match(/Уровень\s*(\d+)/i) || window.location.pathname.match(/level(\d+)/i);
        const resolvedLevel = levelMatch ? parseInt(levelMatch[1], 10) : 1;
        const msg = {
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: actionType,
            status: status,
            start_time: new Date(startTime).toISOString(),
            time_spent_sec: Math.floor((Date.now() - startTime) / 1000),
            attempts_count: attempts,
            success: success,
            action_log: writerActionLog.slice(-50)
        };
        window.parent.postMessage(msg, '*');

        if (window.parent === window) {
            fetch('/api/telemetry', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    student_firstName: 'Test',
                    student_lastName: 'Student',
                    student_class: '7-класс',
                    course_slug: '7-класс',
                    lesson_id: '22',
                    level_number: resolvedLevel,
                    mission_name: missionName,
                    action_type: actionType,
                    status: status,
                    time_spent_sec: Math.floor((Date.now() - startTime) / 1000),
                    attempts_count: attempts,
                    success: success,
                    action_log: writerActionLog.slice(-50),
                    is_hardcore: typeof localStorage !== 'undefined' && localStorage.getItem('hardcore_mode') === 'true'
                })
            }).catch(() => {});
        }
    }

    if (!disableAutoTelemetry) {
        sendTelemetry('in_progress', 'in_progress');
    }

    document.addEventListener('DOMContentLoaded', () => {
        // Инициализация Jodit без родного тулбара, так как мы отрисовали аутентичную панель LibreOffice
        editor = Jodit.make('#writer-editor', {
            theme: 'default',
            toolbar: false,
            toolbarSticky: false,
            showCharsCounter: false,
            showWordsCounter: false,
            showXPathInStatusbar: false,
            statusbar: false,
            disablePlugins: ['size'],
            height: '100%',
            language: 'ru',
            events: {
                change: () => {
                    updateStatusbarWords();
                    emitWriterChange();
                },
                afterInit: () => {
                    // Скрываем родной статусбар Jodit
                    const jsb = document.querySelector('.jodit-status-bar');
                    if (jsb) jsb.style.display = 'none';
                    const wysiwyg = document.querySelector('.jodit-wysiwyg');
                    if (wysiwyg) {
                        wysiwyg.addEventListener('keydown', (e) => {
                            if (e.key === 'Tab') {
                                const sel = window.getSelection();
                                if (sel && sel.rangeCount > 0) {
                                    const startNode = sel.getRangeAt(0).startContainer;
                                    const startEl = startNode.nodeType === 1 ? startNode : startNode.parentElement;
                                    const currentCell = startEl?.closest ? startEl.closest('th, td') : null;
                                    if (currentCell && wysiwyg.contains(currentCell)) {
                                        const tbl = currentCell.closest('table');
                                        if (tbl) {
                                            e.preventDefault();
                                            e.stopPropagation();
                                            const cells = Array.from(tbl.querySelectorAll('th, td'));
                                            const idx = cells.indexOf(currentCell);
                                            const nextIdx = e.shiftKey ? idx - 1 : idx + 1;
                                            if (nextIdx >= 0 && nextIdx < cells.length) {
                                                const nextCell = cells[nextIdx];
                                                const r = document.createRange();
                                                r.selectNodeContents(nextCell);
                                                if (!/^(Заголовок\s+\d+|Ячейка\s+\d+,\d+)$/.test((nextCell.textContent || '').trim())) {
                                                    r.collapse(false);
                                                }
                                                sel.removeAllRanges();
                                                sel.addRange(r);
                                                saveCurrentEditorRange();
                                            }
                                        }
                                    }
                                }
                            }
                        }, true);
                        wysiwyg.addEventListener('input', () => {
                            Object.keys(pendingInlineStates).forEach(k => { pendingInlineStates[k] = false; });
                            saveCurrentEditorRange();
                            updateToolbarActiveStates();
                            updateStatusbarWords();
                            emitWriterChange();
                        });
                        wysiwyg.addEventListener('keyup', () => {
                            saveCurrentEditorRange();
                            updateToolbarActiveStates();
                            emitWriterChange();
                        });
                        wysiwyg.addEventListener('mouseup', (e) => {
                            const targetCell = e.target?.closest ? e.target.closest('th, td') : null;
                            if (targetCell && wysiwyg.contains(targetCell)) {
                                lastActiveCell = targetCell;
                                lastActiveTable = targetCell.closest('table');
                                if (e.ctrlKey || e.metaKey || e.shiftKey) {
                                    if (!selectedTableCells.includes(targetCell)) {
                                        selectedTableCells.push(targetCell);
                                        targetCell.classList.add('lo-selected-cell');
                                    }
                                } else {
                                    wysiwyg.querySelectorAll('.lo-selected-cell').forEach(c => c.classList.remove('lo-selected-cell'));
                                    selectedTableCells = [targetCell];
                                }
                            } else {
                                wysiwyg.querySelectorAll('.lo-selected-cell').forEach(c => c.classList.remove('lo-selected-cell'));
                                selectedTableCells = [];
                                lastActiveCell = null;
                            }
                            if (targetCell && /^(Заголовок\s+\d+|Ячейка\s+\d+,\d+)$/.test((targetCell.textContent || '').trim())) {
                                const sel = window.getSelection();
                                if (sel && sel.isCollapsed) {
                                    const r = document.createRange();
                                    r.selectNodeContents(targetCell);
                                    sel.removeAllRanges();
                                    sel.addRange(r);
                                }
                            }
                            saveCurrentEditorRange();
                            updateToolbarActiveStates();
                        });
                    }
                    updateStatusbarWords();
                    applyPageMargins(pageMargins);
                    emitWriterChange();
                }
            }
        });

        // Инициализация линеек, боковой панели, палитр цветов, контекстного меню ПКМ и таблицы
        initRulersAndDrag();
        initColorPopover();
        initContextMenuAndTableOps();
        initSidebarAndFindbar();

        // Слушатель смены выделения в документе для обновления активных кнопок панели
        document.addEventListener('selectionchange', () => {
            saveCurrentEditorRange();
            updateToolbarActiveStates();
        });

        // Глобальные горячие клавиши LibreOffice (F11 / Ctrl+Shift+J — Fullscreen, Ctrl+F — Findbar, Esc — закрыть поповеры/выход)
        document.addEventListener('keydown', (e) => {
            if ((e.ctrlKey && e.shiftKey && e.key.toLowerCase() === 'j') || e.key === 'F11') {
                e.preventDefault();
                toggleFullscreenMode();
            } else if (e.ctrlKey && !e.shiftKey && e.key.toLowerCase() === 'f') {
                const root = document.getElementById('lo-root-window');
                if (root && root.contains(document.activeElement)) {
                    e.preventDefault();
                    document.getElementById('lo-findbar')?.classList.remove('d-none');
                    document.getElementById('lo-findbar')?.classList.add('d-flex');
                    document.getElementById('findbar-input')?.focus();
                }
            } else if (e.key === 'Escape') {
                document.getElementById('lo-context-menu').style.display = 'none';
                document.getElementById('lo-color-popover')?.classList.add('d-none');
                if (isFullscreenActive && !document.querySelector('.modal.show')) {
                    toggleFullscreenMode(false);
                }
            }
        });

        document.addEventListener('fullscreenchange', () => {
            const root = document.getElementById('lo-root-window');
            if (!document.fullscreenElement && isFullscreenActive) {
                isFullscreenActive = false;
                root?.classList.remove('lo-is-fullscreen');
                document.getElementById('lo-fullscreen-exit-btn')?.classList.add('d-none');
                toggleBtnActive('btn-fullscreen', false);
                toggleBtnActive('btn-window-fullscreen', false);
            }
        });
        
        // Привязка действий тулбара и меню
        bindToolbarAndMenuActions();

        // Инициализация модалок Bootstrap
        initModals();

        // Зум листа
        initZoom();
    });

    function updateStatusbarWords() {
        if (!editor) return;
        const text = editor.text || '';
        const charsNoSpace = text.replace(/\s/g, '').length;
        const charsTotal = text.length;
        const words = text.trim() === '' ? 0 : text.trim().split(/\s+/).length;
        
        const sbWords = document.getElementById('statusbar-words');
        if (sbWords) {
            sbWords.innerText = `${words} слов, ${charsNoSpace} символов`;
        }

        // Статистика в модалке
        const statW = document.getElementById('stat-words');
        const statCNS = document.getElementById('stat-chars-nospace');
        const statCT = document.getElementById('stat-chars-total');
        const statP = document.getElementById('stat-paragraphs');
        if (statW) statW.innerText = words;
        if (statCNS) statCNS.innerText = charsNoSpace;
        if (statCT) statCT.innerText = charsTotal;
        if (statP && editor.editor) {
            const paras = editor.editor.querySelectorAll('p, h1, h2, h3, li');
            statP.innerText = Math.max(1, paras.length);
        }
    }

    // Подсветка активных кнопок форматирования в зависимости от положения курсора (DOM-инспекция closest)
    function updateToolbarActiveStates() {
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        if (!editor || !wysiwyg) return;

        let range = null;
        const sel = window.getSelection();
        if (sel && sel.rangeCount > 0) {
            const r = sel.getRangeAt(0);
            if (wysiwyg.contains(r.commonAncestorContainer)) {
                range = r;
            }
        }
        if (!range && lastSavedRange && wysiwyg.contains(lastSavedRange.commonAncestorContainer)) {
            range = lastSavedRange;
        }

        let startEl = null;
        if (range) {
            startEl = range.startContainer.nodeType === Node.ELEMENT_NODE
                ? range.startContainer
                : range.startContainer.parentElement;
        }

        // 1. Шрифтовое инлайн-начертание
        const isBold = !!(startEl?.closest('b, strong, [style*="font-weight: bold"], [style*="font-weight: 700"], [style*="font-weight: 800"], [style*="font-weight: 900"]') || pendingInlineStates.bold);
        const isItalic = !!(startEl?.closest('i, em, [style*="font-style: italic"]') || pendingInlineStates.italic);
        const isUnderline = !!(startEl?.closest('u, [style*="text-decoration: underline"], [style*="text-decoration-line: underline"]') || pendingInlineStates.underline);
        const isStrike = !!(startEl?.closest('s, strike, del, [style*="text-decoration: line-through"], [style*="text-decoration-line: line-through"]') || pendingInlineStates.strikethrough);
        const isSup = !!(startEl?.closest('sup, [style*="vertical-align: super"]') || pendingInlineStates.superscript);
        const isSub = !!(startEl?.closest('sub, [style*="vertical-align: sub"]') || pendingInlineStates.subscript);

        toggleBtnActive('btn-bold', isBold);
        toggleBtnActive('btn-italic', isItalic);
        toggleBtnActive('btn-underline', isUnderline);
        toggleBtnActive('btn-strikethrough', isStrike);
        toggleBtnActive('btn-sup', isSup);
        toggleBtnActive('btn-sub', isSub);

        // 2. Списки (ul / ol)
        const isUL = !!(startEl?.closest('ul') && wysiwyg.contains(startEl.closest('ul')));
        const isOL = !!(startEl?.closest('ol') && wysiwyg.contains(startEl.closest('ol')));
        toggleBtnActive('btn-ul', isUL);
        toggleBtnActive('btn-ol', isOL);

        // 3. Выравнивание абзаца (гарантированная подсветка ровно одной кнопки)
        let activeBlock = (startEl && wysiwyg.contains(startEl)) ? startEl.closest('p, h1, h2, h3, li, td, th') : null;
        if (!activeBlock) {
            if (lastActivePara && wysiwyg.contains(lastActivePara)) {
                activeBlock = lastActivePara;
            } else {
                activeBlock = wysiwyg.querySelector('p, h1, h2, h3, li, td, th');
            }
        }
        let align = 'left';
        if (activeBlock) {
            const inlineAlign = activeBlock.style.textAlign;
            if (inlineAlign) {
                align = inlineAlign.toLowerCase();
            } else {
                try {
                    const compAlign = window.getComputedStyle(activeBlock).textAlign;
                    if (compAlign) align = compAlign.toLowerCase();
                } catch (_) {}
            }
        }
        if (align === 'start') align = 'left';

        toggleBtnActive('btn-align-left', align === 'left');
        toggleBtnActive('btn-align-center', align === 'center');
        toggleBtnActive('btn-align-right', align === 'right');
        toggleBtnActive('btn-align-justify', align === 'justify');

        // 4. Контекстная панель «Таблица» и вертикальное выравнивание ячейки
        const activeCell = (startEl && wysiwyg.contains(startEl)) ? startEl.closest('th, td') : null;
        const inTable = !!activeCell;
        const tableToolbar = document.getElementById('lo-table-toolbar');
        if (tableToolbar) {
            const shouldShow = inTable || isTableToolbarPinned;
            tableToolbar.classList.toggle('d-none', !shouldShow);
            tableToolbar.classList.toggle('d-flex', shouldShow);
        }
        if (activeCell) {
            lastActiveCell = activeCell;
            lastActiveTable = activeCell.closest('table');
            const va = (activeCell.style.verticalAlign || 'middle').toLowerCase();
            toggleBtnActive('btn-tbl-valign-top', va === 'top');
            toggleBtnActive('btn-tbl-valign-middle', va === 'middle' || va === '');
            toggleBtnActive('btn-tbl-valign-bottom', va === 'bottom');
        }
    }

    function initColorPopover() {
        const paletteColors = [
            '#000000', '#444444', '#666666', '#999999', '#cccccc', '#ffffff',
            '#ff0000', '#ff6600', '#ffcc00', '#009900', '#0066cc', '#6600cc',
            '#c9211e', '#f57900', '#edd400', '#73d216', '#3465a4', '#75507b',
            '#a40000', '#ce5c00', '#c4a000', '#4e9a06', '#204a87', '#5c3566',
            '#fce94f', '#fcaf3e', '#e9b96e', '#8ae234', '#729fcf', '#ad7fa8',
            '#fff2cc', '#fce5cd', '#f4cccc', '#d9ead3', '#cfe2f3', '#d9d2e9'
        ];
        const popover = document.getElementById('lo-color-popover');
        const grid = document.getElementById('lo-color-grid');
        const titleEl = document.getElementById('lo-color-popover-title');
        const autoBtn = document.getElementById('lo-color-auto');
        const customInput = document.getElementById('lo-color-custom');
        if (!popover || !grid) return;

        let activeMode = 'foreColor';

        const applySelectedColor = (colorVal) => {
            restoreSavedEditorRange();
            if (activeMode === 'foreColor') {
                const c = colorVal || '#000000';
                activeFontColor = c;
                const ind = document.getElementById('fontcolor-indicator');
                if (ind) ind.style.backgroundColor = c;
                try { editor.execCommand('foreColor', false, c); } catch (_) {}
                recordWriterAction('fore_color', { value: c });
            } else if (activeMode === 'hiliteColor') {
                const c = colorVal || 'transparent';
                activeBackColor = c === 'transparent' ? '#ffffff' : c;
                const ind = document.getElementById('backcolor-indicator');
                if (ind) ind.style.backgroundColor = activeBackColor;
                try { editor.execCommand('hiliteColor', false, c); } catch (_) {}
                recordWriterAction('hilite_color', { value: c });
            } else if (activeMode === 'cellBg') {
                const cells = getTargetTableCells();
                cells.forEach(cell => { cell.style.backgroundColor = colorVal || ''; });
                recordWriterAction('table_cell_bg', { value: colorVal || 'none' });
            }
            popover.classList.add('d-none');
            emitWriterChange();
        };

        grid.innerHTML = '';
        paletteColors.forEach(hex => {
            const sw = document.createElement('button');
            sw.type = 'button';
            sw.className = 'lo-color-swatch';
            sw.style.backgroundColor = hex;
            sw.title = hex;
            sw.setAttribute('data-color', hex);
            sw.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                applySelectedColor(hex);
            });
            grid.appendChild(sw);
        });

        const openColorPopover = (btnEl, mode, title) => {
            if (!btnEl) return;
            saveCurrentEditorRange();
            activeMode = mode;
            if (titleEl) titleEl.innerText = title;
            if (autoBtn) autoBtn.innerText = mode === 'foreColor' ? 'Авто' : 'Без заливки';
            const rect = btnEl.getBoundingClientRect();
            popover.style.left = `${Math.max(8, Math.min(window.innerWidth - 246, rect.left))}px`;
            const topPos = (rect.bottom + 210 > window.innerHeight) ? Math.max(8, rect.top - 185) : rect.bottom + 2;
            popover.style.top = `${topPos}px`;
            popover.classList.remove('d-none');
        };

        document.getElementById('btn-fontcolor')?.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            openColorPopover(e.currentTarget, 'foreColor', 'Цвет шрифта');
        });
        document.getElementById('btn-backcolor')?.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            openColorPopover(e.currentTarget, 'hiliteColor', 'Цвет выделения');
        });
        document.getElementById('btn-tbl-cellbg')?.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            openColorPopover(e.currentTarget, 'cellBg', 'Цвет фона ячейки');
        });

        autoBtn?.addEventListener('click', (e) => {
            e.preventDefault();
            applySelectedColor(null);
        });
        customInput?.addEventListener('change', (e) => {
            applySelectedColor(e.target.value);
        });
        document.addEventListener('click', (e) => {
            if (!popover.classList.contains('d-none') && !popover.contains(e.target)) {
                popover.classList.add('d-none');
            }
        });
    }

    function getTargetTableCell() {
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        const cur = editor?.selection?.current();
        let cell = cur?.closest ? cur.closest('td, th') : (cur?.parentElement?.closest('td, th') || null);
        if (!cell && lastActiveCell && wysiwyg?.contains(lastActiveCell)) {
            cell = lastActiveCell;
        }
        return cell;
    }

    function getTargetTableCells() {
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        const validSelected = selectedTableCells.filter(c => wysiwyg?.contains(c));
        if (validSelected.length > 0) return validSelected;
        const c = getTargetTableCell();
        return c ? [c] : [];
    }

    function initContextMenuAndTableOps() {
        const ctxMenu = document.getElementById('lo-context-menu');

        // Перехват правого клика внутри листа редактора
        document.addEventListener('contextmenu', (e) => {
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            if (!wysiwyg || !wysiwyg.contains(e.target)) return;
            e.preventDefault();
            saveCurrentEditorRange();
            const targetCell = e.target?.closest ? e.target.closest('td, th') : null;
            if (targetCell) {
                lastActiveCell = targetCell;
                lastActiveTable = targetCell.closest('table');
            }
            if (ctxMenu) {
                ctxMenu.querySelectorAll('.ctx-table-only').forEach(el => {
                    el.style.display = targetCell ? '' : 'none';
                });
                const x = Math.min(window.innerWidth - 250, e.clientX);
                const y = Math.min(window.innerHeight - (targetCell ? 460 : 250), e.clientY);
                ctxMenu.style.left = `${Math.max(4, x)}px`;
                ctxMenu.style.top = `${Math.max(4, y)}px`;
                ctxMenu.style.display = 'block';
            }
        });

        document.addEventListener('click', (e) => {
            if (ctxMenu && ctxMenu.style.display === 'block' && !ctxMenu.contains(e.target)) {
                ctxMenu.style.display = 'none';
            }
        });

        const closeCtx = () => { if (ctxMenu) ctxMenu.style.display = 'none'; };

        // Базовые действия контекстного меню
        document.getElementById('ctx-cut')?.addEventListener('click', (e) => { e.preventDefault(); closeCtx(); restoreSavedEditorRange(); try { editor.execCommand('cut'); } catch (_) {} });
        document.getElementById('ctx-copy')?.addEventListener('click', (e) => { e.preventDefault(); closeCtx(); restoreSavedEditorRange(); try { editor.execCommand('copy'); } catch (_) {} });
        document.getElementById('ctx-paste')?.addEventListener('click', (e) => { e.preventDefault(); closeCtx(); restoreSavedEditorRange(); try { editor.execCommand('paste'); } catch (_) {} });
        document.getElementById('ctx-paste-plain')?.addEventListener('click', (e) => { e.preventDefault(); closeCtx(); document.getElementById('menu-edit-paste-unformatted')?.click(); });
        document.getElementById('ctx-clear')?.addEventListener('click', (e) => { e.preventDefault(); closeCtx(); document.getElementById('btn-eraser')?.click(); });
        document.getElementById('ctx-char')?.addEventListener('click', (e) => { e.preventDefault(); closeCtx(); document.getElementById('menu-format-char')?.click(); });
        document.getElementById('ctx-para')?.addEventListener('click', (e) => { e.preventDefault(); closeCtx(); document.getElementById('menu-format-paragraph')?.click(); });
        document.getElementById('ctx-page')?.addEventListener('click', (e) => { e.preventDefault(); closeCtx(); document.getElementById('menu-format-page')?.click(); });

        // Табличные операции
        const insertRow = (after = true) => {
            closeCtx();
            const cell = getTargetTableCell();
            if (!cell) return;
            const tr = cell.closest('tr');
            if (!tr) return;
            const newTr = tr.cloneNode(true);
            Array.from(newTr.children).forEach(td => { td.innerHTML = '&nbsp;'; td.removeAttribute('colspan'); td.removeAttribute('rowspan'); });
            if (after) tr.after(newTr);
            else tr.parentNode.insertBefore(newTr, tr);
            recordWriterAction(after ? 'table_row_below' : 'table_row_above');
            emitWriterChange();
        };

        const deleteRow = () => {
            closeCtx();
            const cell = getTargetTableCell();
            if (!cell) return;
            cell.closest('tr')?.remove();
            recordWriterAction('table_row_delete');
            updateToolbarActiveStates();
            emitWriterChange();
        };

        const insertColumn = (after = true) => {
            closeCtx();
            const cell = getTargetTableCell();
            if (!cell) return;
            const tbl = cell.closest('table');
            const tr = cell.closest('tr');
            if (!tbl || !tr) return;
            const colIdx = Array.from(tr.children).indexOf(cell);
            Array.from(tbl.rows).forEach(row => {
                const refCell = row.children[colIdx] || row.lastElementChild;
                const tag = refCell && refCell.tagName === 'TH' ? 'th' : 'td';
                const newCell = document.createElement(tag);
                newCell.style.cssText = refCell ? refCell.style.cssText : 'border: 1px solid #000; padding: 6px;';
                newCell.innerHTML = '&nbsp;';
                if (refCell) {
                    if (after) refCell.after(newCell);
                    else row.insertBefore(newCell, refCell);
                } else {
                    row.appendChild(newCell);
                }
            });
            recordWriterAction(after ? 'table_col_right' : 'table_col_left');
            emitWriterChange();
        };

        const deleteColumn = () => {
            closeCtx();
            const cell = getTargetTableCell();
            if (!cell) return;
            const tbl = cell.closest('table');
            const tr = cell.closest('tr');
            if (!tbl || !tr) return;
            const colIdx = Array.from(tr.children).indexOf(cell);
            Array.from(tbl.rows).forEach(row => {
                if (row.children[colIdx]) row.children[colIdx].remove();
            });
            recordWriterAction('table_col_delete');
            updateToolbarActiveStates();
            emitWriterChange();
        };

        const deleteTable = () => {
            closeCtx();
            const cell = getTargetTableCell();
            const tbl = cell?.closest('table') || lastActiveTable;
            if (tbl) {
                tbl.remove();
                lastActiveTable = null;
                lastActiveCell = null;
                selectedTableCells = [];
                recordWriterAction('table_delete');
                updateToolbarActiveStates();
                emitWriterChange();
            }
        };

        const mergeCells = () => {
            closeCtx();
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            let cells = getTargetTableCells();
            if (cells.length === 1) {
                // Если выделена только одна ячейка, объединяем её со следующей соседней в строке
                const next = cells[0].nextElementSibling;
                if (next && (next.tagName === 'TD' || next.tagName === 'TH')) {
                    cells = [cells[0], next];
                }
            }
            if (cells.length < 2) {
                showLoStatusHint('Для объединения выберите 2 или более ячейки (Ctrl+клик).');
                return;
            }
            const first = cells[0];
            const firstRow = first.closest('tr');
            const sameRow = cells.every(c => c.closest('tr') === firstRow);
            if (sameRow) {
                let totalSpan = 0;
                const combinedParts = [];
                cells.forEach(c => {
                    totalSpan += parseInt(c.getAttribute('colspan') || '1', 10);
                    const txt = (c.innerText || '').trim();
                    if (txt && txt !== '\u00a0') combinedParts.push(txt);
                });
                first.setAttribute('colspan', String(totalSpan));
                first.innerHTML = combinedParts.join(' ') || '&nbsp;';
                cells.slice(1).forEach(c => c.remove());
                recordWriterAction('table_merge_cells', { colspan: totalSpan, rowspan: 1 });
            } else {
                const rowSet = new Set(cells.map(c => c.closest('tr')));
                const rowSpan = rowSet.size;
                const colSpan = Math.max(1, Math.round(cells.length / rowSpan));
                const combinedParts = [];
                cells.forEach(c => {
                    const txt = (c.innerText || '').trim();
                    if (txt && txt !== '\u00a0') combinedParts.push(txt);
                });
                first.setAttribute('rowspan', String(rowSpan));
                if (colSpan > 1) first.setAttribute('colspan', String(colSpan));
                first.innerHTML = combinedParts.join(' ') || '&nbsp;';
                cells.slice(1).forEach(c => c.remove());
                recordWriterAction('table_merge_cells', { colspan: colSpan, rowspan: rowSpan });
            }
            wysiwyg?.querySelectorAll('.lo-selected-cell').forEach(c => c.classList.remove('lo-selected-cell'));
            selectedTableCells = [first];
            first.classList.add('lo-selected-cell');
            lastActiveCell = first;
            emitWriterChange();
        };

        const splitCells = () => {
            closeCtx();
            const cell = getTargetTableCell();
            if (!cell) return;
            const cSpan = parseInt(cell.getAttribute('colspan') || '1', 10);
            const rSpan = parseInt(cell.getAttribute('rowspan') || '1', 10);
            if (cSpan > 1) {
                cell.removeAttribute('colspan');
                for (let i = 1; i < cSpan; i++) {
                    const nc = document.createElement(cell.tagName.toLowerCase());
                    nc.style.cssText = cell.style.cssText;
                    nc.innerHTML = '&nbsp;';
                    cell.after(nc);
                }
            }
            if (rSpan > 1) {
                cell.removeAttribute('rowspan');
            }
            recordWriterAction('table_split_cells', { cSpan, rSpan });
            emitWriterChange();
        };

        const setCellValign = (valign) => {
            const cells = getTargetTableCells();
            cells.forEach(c => { c.style.verticalAlign = valign; });
            updateToolbarActiveStates();
            recordWriterAction('table_valign', { value: valign });
            emitWriterChange();
        };

        const applyTableBorders = (mode) => {
            const tbl = getTargetTableCell()?.closest('table') || lastActiveTable || document.querySelector('.jodit-wysiwyg table');
            if (!tbl) return;
            const cells = tbl.querySelectorAll('td, th');
            if (mode === 'all') {
                tbl.style.border = '1px solid #000';
                cells.forEach(c => { c.style.setProperty('border', '1px solid #000000', 'important'); });
            } else if (mode === 'outer') {
                tbl.style.border = '1px solid #000';
                cells.forEach(c => { c.style.setProperty('border', 'none', 'important'); });
            } else if (mode === 'none') {
                tbl.style.border = '1px dashed #cccccc';
                cells.forEach(c => { c.style.setProperty('border', '1px dashed #dddddd', 'important'); });
            }
            recordWriterAction('table_borders', { mode });
            emitWriterChange();
        };

        ['menu-table-row-above', 'btn-tbl-row-above', 'ctx-tbl-row-above'].forEach(id => document.getElementById(id)?.addEventListener('click', (e) => { e.preventDefault(); insertRow(false); }));
        ['menu-table-row-below', 'btn-tbl-row-below', 'ctx-tbl-row-below'].forEach(id => document.getElementById(id)?.addEventListener('click', (e) => { e.preventDefault(); insertRow(true); }));
        ['menu-table-row-delete', 'btn-tbl-row-del', 'ctx-tbl-row-del'].forEach(id => document.getElementById(id)?.addEventListener('click', (e) => { e.preventDefault(); deleteRow(); }));
        ['menu-table-col-left', 'btn-tbl-col-left', 'ctx-tbl-col-left'].forEach(id => document.getElementById(id)?.addEventListener('click', (e) => { e.preventDefault(); insertColumn(false); }));
        ['menu-table-col-right', 'btn-tbl-col-right', 'ctx-tbl-col-right'].forEach(id => document.getElementById(id)?.addEventListener('click', (e) => { e.preventDefault(); insertColumn(true); }));
        ['menu-table-col-delete', 'btn-tbl-col-del', 'ctx-tbl-col-del'].forEach(id => document.getElementById(id)?.addEventListener('click', (e) => { e.preventDefault(); deleteColumn(); }));
        ['menu-table-delete', 'btn-tbl-del'].forEach(id => document.getElementById(id)?.addEventListener('click', (e) => { e.preventDefault(); deleteTable(); }));
        ['menu-table-merge', 'btn-tbl-merge', 'ctx-tbl-merge'].forEach(id => document.getElementById(id)?.addEventListener('click', (e) => { e.preventDefault(); mergeCells(); }));
        ['menu-table-split', 'btn-tbl-split', 'ctx-tbl-split'].forEach(id => document.getElementById(id)?.addEventListener('click', (e) => { e.preventDefault(); splitCells(); }));

        document.getElementById('btn-tbl-valign-top')?.addEventListener('click', () => setCellValign('top'));
        document.getElementById('btn-tbl-valign-middle')?.addEventListener('click', () => setCellValign('middle'));
        document.getElementById('btn-tbl-valign-bottom')?.addEventListener('click', () => setCellValign('bottom'));

        document.getElementById('btn-tbl-sel-cell')?.addEventListener('click', () => {
            const c = getTargetTableCell();
            if (c) {
                c.classList.add('lo-selected-cell');
                if (!selectedTableCells.includes(c)) selectedTableCells.push(c);
            }
        });
        document.getElementById('btn-tbl-sel-table')?.addEventListener('click', () => {
            const tbl = getTargetTableCell()?.closest('table') || lastActiveTable;
            if (tbl) {
                selectedTableCells = Array.from(tbl.querySelectorAll('td, th'));
                selectedTableCells.forEach(c => c.classList.add('lo-selected-cell'));
            }
        });
        document.querySelectorAll('[data-tbl-border], [data-dlg-border]').forEach(el => {
            el.addEventListener('click', (e) => {
                e.preventDefault();
                applyTableBorders(el.getAttribute('data-tbl-border') || el.getAttribute('data-dlg-border'));
            });
        });
    }

