                    <h6 class="modal-title fs-6 fw-bold text-dark mb-0">Экспертная проверка оформления (ОГЭ 13.2)</h6>
                </div>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3" style="max-height: 70vh; overflow-y: auto;">
                <div id="oge-report-alert" class="alert alert-danger rounded-0 py-2 px-3 mb-3" style="font-size: 12px;">
                    <!-- Динамический текст резюме -->
                </div>
                
                <h6 class="fw-bold mb-2 text-secondary" style="font-size: 12px; text-transform: uppercase;">Детализированный отчёт эксперта:</h6>
                <div id="oge-report-items" class="d-flex flex-column gap-2">
                    <!-- Динамические пункты проверки -->
                </div>
            </div>
            <div class="modal-footer py-2 px-3 border-top bg-light d-flex justify-content-between">
                <span class="text-muted" style="font-size: 11px;">Критерии оценивания утверждены ФИПИ для задания 13.2 ОГЭ</span>
                <button type="button" class="btn btn-secondary btn-sm rounded-0 px-4" data-bs-dismiss="modal">Понятно, исправить</button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="/static/jodit/jodit.min.css" />
<script src="/static/bootstrap.bundle.min.js" is:inline></script>
<script src="/static/jodit/jodit.min.js" is:inline></script>

<script define:vars={{ missionName, hardcoreReset, checkOgeFormat }}>
    let attempts = 0;
    let startTime = Date.now();
    let editor = null;
    let isNonPrintingActive = false;
    let isRulerActive = true;
    let lastActivePara = null;
    let lastActiveTable = null;
    let lastOgeReport = null;
    let dynamicCheckOgeFormat = checkOgeFormat !== false;
    let writerActionLog = [];

    // Поля страницы по умолчанию (сырой режим: сброшены в 1.0 см)
    let pageMargins = {
        leftCm: 1.0,
        rightCm: 1.0,
        topCm: 1.0,
        bottomCm: 1.0
    };

    function recordWriterAction(type, details = {}) {
        const entry = {
            timestamp: new Date().toISOString(),
            elapsedMs: Date.now() - startTime,
            type,
            ...details
        };
        writerActionLog.push(entry);
        document.dispatchEvent(new CustomEvent('writer-action', { detail: entry }));
        emitWriterChange();
    }

    function getWriterState() {
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        const html = (wysiwyg && wysiwyg.innerHTML !== undefined) ? wysiwyg.innerHTML : (editor ? editor.value : '');
        const text = wysiwyg ? (wysiwyg.innerText || wysiwyg.textContent || '') : (editor ? editor.text : '');
        return {
            html,
            text,
            wysiwyg,
            pageMargins: { ...pageMargins },
            isNonPrintingActive,
            isRulerActive,
            actionLog: [...writerActionLog],
            editor
        };
    }

    function emitWriterChange() {
        document.dispatchEvent(new CustomEvent('writer-change', { detail: getWriterState() }));
    }

    function sendTelemetry(actionType, status, success = false) {
        const levelMatch = String(missionName || '').match(/Уровень\s*(\d+)/i) || window.location.pathname.match(/level(\d+)/i);
        const resolvedLevel = levelMatch ? parseInt(levelMatch[1], 10) : 1;
        const msg = {
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: actionType,
            status: status,
            start_time: new Date(startTime).toISOString(),
            time_spent_sec: Math.floor((Date.now() - startTime) / 1000),
            attempts_count: attempts,
            success: success,
            action_log: writerActionLog.slice(-50)
        };
        window.parent.postMessage(msg, '*');

        if (window.parent === window) {
            fetch('/api/telemetry', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    student_firstName: 'Test',
                    student_lastName: 'Student',
                    student_class: '7-класс',
                    course_slug: '7-класс',
                    lesson_id: '22',
                    level_number: resolvedLevel,
                    mission_name: missionName,
                    action_type: actionType,
                    status: status,
                    time_spent_sec: Math.floor((Date.now() - startTime) / 1000),
                    attempts_count: attempts,
                    success: success,
                    action_log: writerActionLog.slice(-50),
                    is_hardcore: typeof localStorage !== 'undefined' && localStorage.getItem('hardcore_mode') === 'true'
                })
            }).catch(() => {});
        }
    }

    sendTelemetry('in_progress', 'in_progress');

    document.addEventListener('DOMContentLoaded', () => {
        // Инициализация Jodit без родного тулбара, так как мы отрисовали аутентичную панель LibreOffice
        editor = Jodit.make('#writer-editor', {
            theme: 'default',
            toolbar: false,
            toolbarSticky: false,
            showCharsCounter: false,
            showWordsCounter: false,
            showXPathInStatusbar: false,
            height: '100%',
            language: 'ru',
            events: {
                change: () => {
                    updateStatusbarWords();
                    emitWriterChange();
                },
                afterInit: () => {
                    // Скрываем родной статусбар Jodit
                    const jsb = document.querySelector('.jodit-status-bar');
                    if (jsb) jsb.style.display = 'none';
                    const wysiwyg = document.querySelector('.jodit-wysiwyg');
                    if (wysiwyg) {
                        wysiwyg.addEventListener('input', () => {
                            updateStatusbarWords();
                            emitWriterChange();
                        });
                        wysiwyg.addEventListener('keyup', () => {
                            emitWriterChange();
                        });
                        wysiwyg.addEventListener('mouseup', () => {
                            const sel = editor.selection ? editor.selection.current() : null;
                            if (sel) {
                                const p = sel.closest ? sel.closest('p, h1, h2, h3, li') : (sel.parentElement ? sel.parentElement.closest('p, h1, h2, h3, li') : null);
                                if (p) lastActivePara = p;
                            }
                        });
                    }
                    updateStatusbarWords();
                    applyPageMargins(pageMargins);
                    emitWriterChange();
                }
            }
        });

        // Слушатель смены выделения в документе для обновления активных кнопок панели
        document.addEventListener('selectionchange', updateToolbarActiveStates);
        
        // Привязка действий тулбара и меню
        bindToolbarAndMenuActions();

        // Инициализация модалок Bootstrap
        initModals();

        // Зум листа
        initZoom();
    });

    function updateStatusbarWords() {
        if (!editor) return;
        const text = editor.text || '';
        const charsNoSpace = text.replace(/\s/g, '').length;
        const charsTotal = text.length;
        const words = text.trim() === '' ? 0 : text.trim().split(/\s+/).length;
        
        const sbWords = document.getElementById('statusbar-words');
        if (sbWords) {
            sbWords.innerText = `${words} слов, ${charsNoSpace} символов`;
        }

        // Статистика в модалке
        const statW = document.getElementById('stat-words');
        const statCNS = document.getElementById('stat-chars-nospace');
        const statCT = document.getElementById('stat-chars-total');
        const statP = document.getElementById('stat-paragraphs');
        if (statW) statW.innerText = words;
        if (statCNS) statCNS.innerText = charsNoSpace;
        if (statCT) statCT.innerText = charsTotal;
        if (statP && editor.editor) {
            const paras = editor.editor.querySelectorAll('p, h1, h2, h3, li');
            statP.innerText = Math.max(1, paras.length);
        }
    }

    // Подсветка активных кнопок форматирования в зависимости от положения курсора
    function updateToolbarActiveStates() {
        if (!editor || !document.activeElement) return;
        
        const isBold = document.queryCommandState('bold');
        const isItalic = document.queryCommandState('italic');
        const isUnderline = document.queryCommandState('underline');
        const isStrike = document.queryCommandState('strikethrough');
        const isSup = document.queryCommandState('superscript');
        const isSub = document.queryCommandState('subscript');
        const isJustifyLeft = document.queryCommandState('justifyleft');
        const isJustifyCenter = document.queryCommandState('justifycenter');
        const isJustifyRight = document.queryCommandState('justifyright');
        const isJustifyFull = document.queryCommandState('justifyfull');
        const isUL = document.queryCommandState('insertunorderedlist');
        const isOL = document.queryCommandState('insertorderedlist');

        toggleBtnActive('btn-bold', isBold);
        toggleBtnActive('btn-italic', isItalic);
        toggleBtnActive('btn-underline', isUnderline);
        toggleBtnActive('btn-strikethrough', isStrike);
        toggleBtnActive('btn-sup', isSup);
        toggleBtnActive('btn-sub', isSub);
        toggleBtnActive('btn-align-left', isJustifyLeft);
        toggleBtnActive('btn-align-center', isJustifyCenter);
        toggleBtnActive('btn-align-right', isJustifyRight);
        toggleBtnActive('btn-align-justify', isJustifyFull);
        toggleBtnActive('btn-ul', isUL);
        toggleBtnActive('btn-ol', isOL);
    }

    function toggleBtnActive(id, isActive) {
        const btn = document.getElementById(id);
        if (btn) {
            if (isActive) btn.classList.add('active');
            else btn.classList.remove('active');
        }
    }

    function bindToolbarAndMenuActions() {
        // --- СТАНДАРТНАЯ ПАНЕЛЬ И МЕНЮ ФАЙЛ ---
        const onNew = () => { if (confirm('Создать новый документ?')) editor.value = '<p></p>'; };
        document.getElementById('btn-new')?.addEventListener('click', onNew);
        document.getElementById('menu-file-new')?.addEventListener('click', onNew);

        const onOpen = () => { alert('LibreOffice Writer: функция открытия локального файла отключена в режиме тренажера.'); };
        document.getElementById('btn-open')?.addEventListener('click', onOpen);
        document.getElementById('menu-file-open')?.addEventListener('click', onOpen);

        // Загрузка типового образца текста для ОГЭ 13.2
        // Загрузка типового образца текста для ОГЭ 13.2 (в сыром неотформатированном виде)
        document.getElementById('menu-file-sample')?.addEventListener('click', () => {
            pageMargins = { leftCm: 1.0, rightCm: 1.0, topCm: 1.0, bottomCm: 1.0 };
            applyPageMargins(pageMargins);
            editor.value = `<p>Российская Федерация — крупнейшее государство мира, расположенное на востоке Европы и севере Азии. Территория страны составляет более 17 млн км² и омывается водами 12 морей.</p>
<table>
  <thead>
    <tr>
      <th>Субъект РФ</th>
      <th>Площадь (тыс. км²)</th>
      <th>Население (млн чел.)</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>Москва</td>
      <td>2.56</td>
      <td>13.1</td>
    </tr>
    <tr>
      <td>Санкт-Петербург</td>
      <td>1.44</td>
      <td>5.6</td>
    </tr>
  </tbody>
</table><p></p>`;
            const selFont = document.getElementById('select-font');
            const selSize = document.getElementById('select-fontsize');
            if (selFont) selFont.value = 'Liberation Sans';
            if (selSize) selSize.value = '11pt';
            toggleBtnActive('btn-align-left', true);
            toggleBtnActive('btn-align-justify', false);
        });

        // Сбросить всё в режим по умолчанию
        document.getElementById('menu-file-reset-raw')?.addEventListener('click', () => {
            pageMargins = { leftCm: 1.0, rightCm: 1.0, topCm: 1.0, bottomCm: 1.0 };
            applyPageMargins(pageMargins);
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            if (wysiwyg) {
                wysiwyg.querySelectorAll('p, table, th, td, span').forEach(el => {
                    el.removeAttribute('style');
                });
            }
            const selFont = document.getElementById('select-font');
            const selSize = document.getElementById('select-fontsize');
            if (selFont) selFont.value = 'Liberation Sans';
            if (selSize) selSize.value = '11pt';
            toggleBtnActive('btn-align-left', true);
            toggleBtnActive('btn-align-justify', false);
            const statusEl = document.getElementById('writer-status');
            if (statusEl) {
                statusEl.className = 'text-muted px-2';
                statusEl.innerText = 'Параметры сброшены в режим по умолчанию.';
            }
        });

        const onSave = () => {
            const blob = new Blob([editor.value], { type: 'text/html;charset=utf-8' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'document.html';
            a.click();
        };
        document.getElementById('btn-save')?.addEventListener('click', onSave);
        document.getElementById('menu-file-save')?.addEventListener('click', onSave);

        const onPrint = () => { window.print(); };
        document.getElementById('btn-print')?.addEventListener('click', onPrint);
        document.getElementById('btn-pdf')?.addEventListener('click', onPrint);
        document.getElementById('btn-printpreview')?.addEventListener('click', onPrint);
        document.getElementById('menu-file-print')?.addEventListener('click', onPrint);
        document.getElementById('menu-file-pdf')?.addEventListener('click', onPrint);

        // Буфер обмена и отмена
        document.getElementById('btn-undo')?.addEventListener('click', () => editor.execCommand('undo'));
        document.getElementById('menu-edit-undo')?.addEventListener('click', () => editor.execCommand('undo'));
        document.getElementById('btn-redo')?.addEventListener('click', () => editor.execCommand('redo'));
        document.getElementById('menu-edit-redo')?.addEventListener('click', () => editor.execCommand('redo'));

        document.getElementById('btn-cut')?.addEventListener('click', () => editor.execCommand('cut'));
        document.getElementById('menu-edit-cut')?.addEventListener('click', () => editor.execCommand('cut'));
        document.getElementById('btn-copy')?.addEventListener('click', () => editor.execCommand('copy'));
        document.getElementById('menu-edit-copy')?.addEventListener('click', () => editor.execCommand('copy'));
        document.getElementById('btn-paste')?.addEventListener('click', () => editor.execCommand('paste'));
        document.getElementById('menu-edit-paste')?.addEventListener('click', () => editor.execCommand('paste'));
        document.getElementById('menu-edit-selectall')?.addEventListener('click', () => editor.execCommand('selectall'));

        // Найти и заменить
        const onFind = () => {
            const query = prompt('Введите текст для поиска:');
            if (query) {
                const replaceWith = prompt(`Заменить "${query}" на:`);
                if (replaceWith !== null) {
                    editor.value = editor.value.split(query).join(replaceWith);
                }
            }
        };
        document.getElementById('btn-find')?.addEventListener('click', onFind);
        document.getElementById('menu-edit-find')?.addEventListener('click', onFind);

        // Непечатаемые символы (¶)
        const toggleNonPrinting = () => {
            isNonPrintingActive = !isNonPrintingActive;
            const container = document.getElementById('workspace-wrapper');
            const btn = document.getElementById('btn-nonprinting');
            if (isNonPrintingActive) {
                container?.classList.add('lo-show-nonprinting');
                btn?.classList.add('active');
            } else {
                container?.classList.remove('lo-show-nonprinting');
                btn?.classList.remove('active');
            }
        };
        document.getElementById('btn-nonprinting')?.addEventListener('click', toggleNonPrinting);
        document.getElementById('menu-view-nonprinting')?.addEventListener('click', toggleNonPrinting);

        // Переключение линейки
        document.getElementById('menu-view-ruler')?.addEventListener('click', () => {
            isRulerActive = !isRulerActive;
            const rContainer = document.getElementById('lo-ruler-container');
            const check = document.getElementById('ruler-check-mark');
            if (rContainer) rContainer.style.display = isRulerActive ? 'block' : 'none';
            if (check) check.innerText = isRulerActive ? '✓' : '';
        });

        // Полноэкранный режим
        document.getElementById('menu-view-fullscreen')?.addEventListener('click', () => {
            if (!document.fullscreenElement) {
                document.getElementById('editor-container')?.requestFullscreen().catch(() => {});
            } else {
                document.exitFullscreen().catch(() => {});
            }
        });

        // Вставка разрыва страницы и горизонтальной линии
        const onPageBreak = () => { editor.selection.insertHTML('<hr style="page-break-after: always; border: 1px dashed #999; margin: 20px 0;" />'); };
        document.getElementById('btn-pagebreak')?.addEventListener('click', onPageBreak);
        document.getElementById('menu-insert-pagebreak')?.addEventListener('click', onPageBreak);
        document.getElementById('menu-insert-hr')?.addEventListener('click', () => editor.selection.insertHTML('<hr />'));
        document.getElementById('btn-image')?.addEventListener('click', () => {
            const url = prompt('Введите URL изображения:');
            if (url) editor.selection.insertHTML(`<img src="${url}" style="max-width: 100%; height: auto;" />`);
        });

        // --- ПАНЕЛЬ ФОРМАТИРОВАНИЯ И МЕНЮ ФОРМАТ ---
        // Стиль абзаца
        document.getElementById('select-style')?.addEventListener('change', (e) => {
            const tag = e.target.value;
            editor.execCommand('formatBlock', false, tag);
            recordWriterAction('style_block', { value: tag });
        });

        // Гарнитура шрифта
        document.getElementById('select-font')?.addEventListener('change', (e) => {
            const font = e.target.value;
            try { editor.execCommand('fontname', false, font); } catch (_) {}
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            let p = null;
            try {
                const cur = editor.selection?.current();
                p = cur?.closest ? cur.closest('p, h1, h2, h3, li, td, th') : (cur?.parentElement?.closest('p, h1, h2, h3, li, td, th') || null);
            } catch (_) {}
            const fallbackFont = (font.includes('Serif') || font.includes('Times')) ? `'${font}', serif` : (font.includes('Courier') ? `'${font}', monospace` : `'${font}', sans-serif`);
            if (p) {
                p.style.fontFamily = fallbackFont;
            } else if (lastActivePara && document.contains(lastActivePara)) {
                lastActivePara.style.fontFamily = fallbackFont;
            } else if (wysiwyg) {
                const allBlocks = wysiwyg.querySelectorAll('p, h1, h2, h3, li');
                if (allBlocks.length > 0) allBlocks.forEach(el => { el.style.fontFamily = fallbackFont; });
                else wysiwyg.style.fontFamily = fallbackFont;
            }
            recordWriterAction('font_family', { value: font });
        });

        // Размер шрифта
        document.getElementById('select-fontsize')?.addEventListener('change', (e) => {
            const size = e.target.value;
            try { editor.selection.applyStyle({ fontSize: size }); } catch (_) {}
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            let p = null;
            try {
                const cur = editor.selection?.current();
                p = cur?.closest ? cur.closest('p, h1, h2, h3, li, td, th') : (cur?.parentElement?.closest('p, h1, h2, h3, li, td, th') || null);
            } catch (_) {}
            if (p) {
                p.style.fontSize = size;
            } else if (lastActivePara && document.contains(lastActivePara)) {
                lastActivePara.style.fontSize = size;
            } else if (wysiwyg) {
                const allBlocks = wysiwyg.querySelectorAll('p, h1, h2, h3, li');
                if (allBlocks.length > 0) allBlocks.forEach(el => { el.style.fontSize = size; });
                else wysiwyg.style.fontSize = size;
            }
            recordWriterAction('font_size', { value: size });
        });

        // Форматирование текста
        const bindCmd = (btnId, menuId, cmd) => {
            const fn = () => {
                try { editor.execCommand(cmd); } catch (_) {}
                updateToolbarActiveStates();
                recordWriterAction(`format_${cmd}`, { command: cmd });
            };
            document.getElementById(btnId)?.addEventListener('click', fn);
            if (menuId) document.getElementById(menuId)?.addEventListener('click', fn);
        };
        bindCmd('btn-bold', 'menu-format-bold', 'bold');
        bindCmd('btn-italic', 'menu-format-italic', 'italic');
        bindCmd('btn-underline', 'menu-format-underline', 'underline');
        bindCmd('btn-strikethrough', 'menu-format-strikethrough', 'strikethrough');
        bindCmd('btn-sup', 'menu-format-sup', 'superscript');
        bindCmd('btn-sub', 'menu-format-sub', 'subscript');
        
        // Очистить прямое форматирование (Ctrl+M)
        const onClearFormat = () => {
            try { editor.execCommand('removeFormat'); } catch (_) {}
            // Очищаем локальные инлайн-стили абзаца
            const block = editor.selection ? editor.selection.current() : null;
            if (block) {
                const p = block.closest ? block.closest('p, h1, h2, h3, li') : block.parentElement?.closest('p, h1, h2, h3, li');
                if (p) {
                    p.style.textIndent = '';
                    p.style.lineHeight = '';
                    p.style.textAlign = '';
                    p.style.marginTop = '';
                    p.style.marginBottom = '';
                }
            }
            recordWriterAction('clear_format');
        };
        document.getElementById('btn-eraser')?.addEventListener('click', onClearFormat);
        document.getElementById('menu-format-clear')?.addEventListener('click', onClearFormat);

        // Цвета
        document.getElementById('btn-fontcolor')?.addEventListener('click', () => {
            const color = prompt('Введите цвет текста (например: #ff0000, blue, black):', '#000000');
            if (color) {
                try { editor.execCommand('foreColor', false, color); } catch (_) {}
                recordWriterAction('fore_color', { value: color });
            }
        });
        document.getElementById('btn-backcolor')?.addEventListener('click', () => {
            const color = prompt('Введите цвет фона/выделения (например: yellow, #e0e0e0):', '#ffff00');
            if (color) {
                try { editor.execCommand('hiliteColor', false, color); } catch (_) {}
                recordWriterAction('hilite_color', { value: color });
            }
        });

        // Выравнивание
        const bindAlign = (btnId, menuId, cmd, cssAlign) => {
            const fn = (e) => {
                if (e) e.preventDefault();
                try { editor.execCommand(cmd); } catch (_) {}
                applyParagraphStyle({ textAlign: cssAlign });
                ['btn-align-left', 'btn-align-center', 'btn-align-right', 'btn-align-justify'].forEach(id => {
                    toggleBtnActive(id, id === btnId);
                });
                recordWriterAction(`align_${cssAlign}`, { value: cssAlign });
            };
            document.getElementById(btnId)?.addEventListener('click', fn);
            if (menuId) document.getElementById(menuId)?.addEventListener('click', fn);
        };
        bindAlign('btn-align-left', 'menu-format-align-left', 'justifyleft', 'left');
        bindAlign('btn-align-center', 'menu-format-align-center', 'justifycenter', 'center');
        bindAlign('btn-align-right', 'menu-format-align-right', 'justifyright', 'right');
        bindAlign('btn-align-justify', 'menu-format-align-justify', 'justifyfull', 'justify');

        // Списки
        document.getElementById('btn-ul')?.addEventListener('click', () => {
            editor.execCommand('insertunorderedlist');
            recordWriterAction('list', { value: 'ul' });
        });
        document.getElementById('btn-ol')?.addEventListener('click', () => {
            editor.execCommand('insertorderedlist');
            recordWriterAction('list', { value: 'ol' });
        });

        // Отступы
        document.getElementById('btn-outdent')?.addEventListener('click', () => {
            editor.execCommand('outdent');
            recordWriterAction('outdent');
        });
        document.getElementById('btn-indent')?.addEventListener('click', () => {
            editor.execCommand('indent');
            recordWriterAction('indent');
        });

        // Междустрочный интервал
        document.querySelectorAll('[data-lineheight]').forEach(el => {
            el.addEventListener('click', (e) => {
                e.preventDefault();
                const lh = el.getAttribute('data-lineheight');
                applyParagraphStyle({ lineHeight: lh });
                recordWriterAction('line_height', { value: lh });
            });
        });

        // Межабзацный интервал
        document.getElementById('act-para-add-bottom')?.addEventListener('click', (e) => {
            e.preventDefault();
            applyParagraphStyle({ marginBottom: '6pt' });
            recordWriterAction('para_space', { marginBottom: '6pt' });
        });
        document.getElementById('act-para-add-top')?.addEventListener('click', (e) => {
            e.preventDefault();
            applyParagraphStyle({ marginTop: '6pt' });
            recordWriterAction('para_space', { marginTop: '6pt' });
        });
        document.getElementById('act-para-remove')?.addEventListener('click', (e) => {
            e.preventDefault();
            applyParagraphStyle({ marginTop: '0', marginBottom: '0' });
            recordWriterAction('para_space', { marginTop: '0', marginBottom: '0' });
        });

        // Клик по линейке для быстрой установки красной строки 1 см (ОГЭ)
        document.getElementById('ruler-first-line')?.addEventListener('click', () => {
            applyParagraphStyle({ textIndent: '1.0cm' });
            recordWriterAction('ruler_first_line', { textIndent: '1.0cm' });
            alert('LibreOffice: для текущего абзаца установлен отступ первой строки (красная строка) 1,00 см');
        });

        // Сервис: статистика
        const onWordCount = () => {
            updateStatusbarWords();
            const modalEl = document.getElementById('modal-wordcount');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('menu-tools-wordcount')?.addEventListener('click', onWordCount);
        document.getElementById('menu-tools-spelling')?.addEventListener('click', () => {
            alert('LibreOffice Writer: проверка правописания завершена. Ошибок не обнаружено.');
        });
        document.getElementById('menu-help-about')?.addEventListener('click', () => {
            alert('LibreOffice Writer Community 24.x\nЭмулятор офисного пакета для подготовки к ОГЭ по информатике (Задание 13.2)');
        });
    }

    // Парсер см/px/pt в сантиметры
    function parseCm(val) {
        if (!val) return null;
        val = val.trim().toLowerCase();
        if (val.endsWith('cm')) return parseFloat(val);
        if (val.endsWith('px')) return parseFloat(val) / 37.79527559;
        if (val.endsWith('pt')) return parseFloat(val) * 0.0352778;
        const num = parseFloat(val);
        return isNaN(num) ? null : num;
    }

    // Применение полей листа и синхронизация линейки
    function applyPageMargins(margins) {
        pageMargins = { ...margins };
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        if (wysiwyg) {
            const leftPx = Math.round(margins.leftCm * 40);
            const rightPx = Math.round(margins.rightCm * 40);
            const topPx = Math.round(margins.topCm * 40);
            const bottomPx = Math.round(margins.bottomCm * 40);
            wysiwyg.style.setProperty('padding-left', `${leftPx}px`, 'important');
            wysiwyg.style.setProperty('padding-right', `${rightPx}px`, 'important');
            wysiwyg.style.setProperty('padding-top', `${topPx}px`, 'important');
            wysiwyg.style.setProperty('padding-bottom', `${bottomPx}px`, 'important');
        }
        updateRulerMargins();
    }

    function updateRulerMargins() {
        const leftBox = document.getElementById('ruler-left-margin-box');
        const rightBox = document.getElementById('ruler-right-margin-box');
        const firstLine = document.getElementById('ruler-first-line');
        const leftIndent = document.getElementById('ruler-left-indent');
        const rightIndent = document.getElementById('ruler-right-indent');
        const ticks = document.getElementById('ruler-ticks');

        const leftPx = Math.round(pageMargins.leftCm * 40);
        const rightPx = Math.round(pageMargins.rightCm * 40);

        if (leftBox) leftBox.style.width = `${leftPx}px`;
        if (rightBox) rightBox.style.width = `${rightPx}px`;
        if (leftIndent) leftIndent.style.left = `${leftPx - 5}px`;
        if (rightIndent) rightIndent.style.right = `${rightPx - 5}px`;
        if (firstLine) firstLine.style.left = `${leftPx}px`;
        if (ticks) {
            ticks.style.marginLeft = `${leftPx}px`;
            ticks.style.width = `${Math.max(0, 800 - leftPx - rightPx)}px`;
        }
    }

    function updateRulerFirstLineMarker(indentCm = 0) {
        const firstLine = document.getElementById('ruler-first-line');
        if (firstLine) {
            const leftPx = Math.round(pageMargins.leftCm * 40);
            const indentPx = Math.round(indentCm * 40);
            firstLine.style.left = `${leftPx + indentPx}px`;
        }
    }

    // Применение стилей к текущему абзацу или группе выделенных абзацев
    function applyParagraphStyle(styles) {
        if (!editor) return;
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        if (!wysiwyg) return;

        let targets = [];
        const sel = editor.selection ? editor.selection.current() : null;
        if (sel) {
            const p = sel.closest ? sel.closest('p, h1, h2, h3, li') : (sel.parentElement ? sel.parentElement.closest('p, h1, h2, h3, li') : null);
            if (p) targets = [p];
        }
        if (targets.length === 0 && lastActivePara && document.contains(lastActivePara)) {
            targets = [lastActivePara];
        }
        if (targets.length === 0) {
            const allP = wysiwyg.querySelectorAll('p, h1, h2, h3, li');
            targets = allP.length > 0 ? Array.from(allP) : [wysiwyg];
        }

        targets.forEach(target => {
            if (styles.textIndent !== undefined) {
                target.style.textIndent = styles.textIndent;
                const cm = parseCm(styles.textIndent);
                if (cm !== null) updateRulerFirstLineMarker(cm);
            }
            if (styles.lineHeight !== undefined) target.style.lineHeight = styles.lineHeight;
            if (styles.textAlign !== undefined) target.style.textAlign = styles.textAlign;
            if (styles.marginTop !== undefined) target.style.marginTop = styles.marginTop;
            if (styles.marginBottom !== undefined) target.style.marginBottom = styles.marginBottom;
            if (styles.marginLeft !== undefined) target.style.marginLeft = styles.marginLeft;
            if (styles.marginRight !== undefined) target.style.marginRight = styles.marginRight;
        });
        updateStatusbarWords();
    }

    // Настройка свойств таблицы
    function applyTableProps(props) {
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        if (!wysiwyg) return;

        let table = lastActiveTable;
        if (!table || !document.contains(table)) {
            const sel = editor.selection ? editor.selection.current() : null;
            if (sel) {
                table = sel.closest ? sel.closest('table') : (sel.parentElement ? sel.parentElement.closest('table') : null);
            }
        }
        if (!table) {
            table = wysiwyg.querySelector('table');
        }
        if (!table) {
            alert('В документе не найдена таблица. Вставьте таблицу через меню «Таблица → Вставить таблицу».');
            return;
        }

        // 1. Выравнивание таблицы на листе
        if (props.align === 'center') {
            table.style.marginLeft = 'auto';
            table.style.marginRight = 'auto';
            table.setAttribute('align', 'center');
        } else if (props.align === 'left') {
            table.style.marginLeft = '0';
            table.style.marginRight = 'auto';
            table.setAttribute('align', 'left');
        } else if (props.align === 'right') {
            table.style.marginLeft = 'auto';
            table.style.marginRight = '0';
            table.setAttribute('align', 'right');
        }

        // 2. Шапка таблицы: выравнивание текста и полужирный шрифт
        const headerCells = (table.rows && table.rows.length > 0)
            ? Array.from(table.rows[0].cells)
            : Array.from(table.querySelectorAll('th'));
        headerCells.forEach(cell => {
            if (props.headerAlign) {
                cell.style.textAlign = props.headerAlign;
            }
            if (props.headerBold !== undefined) {
                cell.style.fontWeight = props.headerBold ? 'bold' : 'normal';
            }
        });

        // 3. Размер шрифта во всей таблице
        if (props.fontSize) {
            table.querySelectorAll('td, th').forEach(cell => {
                cell.style.fontSize = props.fontSize;
            });
        }
    }

    // Экспертная проверка документа на соответствие ОГЭ 13.2
    function inspectOgeDocument(rootEl, margins) {
        const items = [];

        if (!rootEl) {
            return {
                valid: false,
                score: 0,
                items: [{ id: 'no_doc', category: 'paragraph', label: 'Документ', passed: false, message: 'Документ пуст или редактор не инициализирован.' }],
                crutchesFound: false,
                summary: 'Документ не содержит текста.'
            };
        }

        const textContent = rootEl.textContent || '';
        const trimmedText = textContent.trim();

        if (trimmedText.length === 0) {
            return {
                valid: false,
                score: 0,
                items: [{ id: 'empty_text', category: 'paragraph', label: 'Текст документа', passed: false, message: 'В документе отсутствует текст. Наберите текст задания.' }],
                crutchesFound: false,
                summary: 'Документ пуст. Наберите текст для проверки.'
            };
        }

        // 1. ДЕТЕКТОР КОСТЫЛЕЙ
        const paras = Array.from(rootEl.querySelectorAll('p, h1, h2, h3'));
        
        // Костыль 1: Красная строка пробелами или табами
        let spaceIndentFound = false;
        for (const p of paras) {
            const html = p.innerHTML || '';
            if (/^(&nbsp;|\s){2,}/i.test(html) || /^\t+/.test(p.textContent || '')) {
                spaceIndentFound = true;
                break;
            }
        }
        if (spaceIndentFound) {
            items.push({
                id: 'crutch_spaces_indent',
                category: 'crutches',
                label: 'Красная строка пробелами',
                passed: false,
                isCrutch: true,
                message: 'Красная строка сделана клавишей Пробел или Tab! По критериям ОГЭ отступ первой строки настраивается в свойствах абзаца (Формат → Абзац → Первая строка: 1.0 см) или на линейке.'
            });
        }

        // Костыль 2: Двойной Enter для пустых строк
        let emptyParasCount = 0;
        for (const p of paras) {
            const pText = (p.textContent || '').trim();
            const inner = (p.innerHTML || '').trim();
            if (pText === '' && (inner === '' || inner === '<br>' || inner === '&nbsp;')) {
                emptyParasCount++;
            }
        }
        if (emptyParasCount > 0) {
            items.push({
                id: 'crutch_double_enter',
                category: 'crutches',
                label: 'Лишние пустые строки (Enter)',
                passed: false,
                isCrutch: true,
                message: `Обнаружено ${emptyParasCount} пустых строк (двойной Enter)! По критериям ОГЭ запрещено разделять абзацы пустыми строками. Используйте межабзацный интервал (Формат → Абзац → Отступ после абзаца).`
            });
        }

        // Костыль 3: Дефис вместо длинного тире между словами
        if (/\s+-\s+/g.test(textContent)) {
            items.push({
                id: 'crutch_hyphen',
                category: 'crutches',
                label: 'Дефис вместо тире',
                passed: false,
                isCrutch: true,
                message: 'Использован дефис (-) вместо длинного тире (—). Вставляйте тире через меню «Вставка → Специальные символы» или Alt+0151.'
            });
        }

        // Костыль 4: Программистские кавычки вместо кавычек-ёлочек
        if (/"[^"]+"/.test(textContent)) {
            items.push({
                id: 'crutch_quotes',
                category: 'crutches',
                label: 'Прямые кавычки вместо кавычек-ёлочек',
                passed: false,
                isCrutch: true,
                message: 'Использованы прямые кавычки (") вместо кавычек-ёлочек (« »). Вставляйте кавычки через меню «Вставка → Специальные символы».'
            });
        }

        // 2. ПАРАМЕТРЫ СТРАНИЦЫ (ПОЛЯ)
        const isLeftMarginOk = margins.leftCm >= 1.8 && margins.leftCm <= 3.2;
        const isRightMarginOk = margins.rightCm >= 1.3 && margins.rightCm <= 2.5;
        const isTopMarginOk = margins.topCm >= 1.3 && margins.topCm <= 2.5;
        const isBottomMarginOk = margins.bottomCm >= 1.3 && margins.bottomCm <= 2.5;

        if (isLeftMarginOk && isRightMarginOk && isTopMarginOk && isBottomMarginOk) {
            items.push({
                id: 'page_margins',
                category: 'page',
                label: 'Поля страницы',
                passed: true,
                message: `Поля страницы настроены верно (Левое: ${margins.leftCm} см, Правое: ${margins.rightCm} см, Верх/Низ: ${margins.topCm} см).`
            });
        } else {
            items.push({
                id: 'page_margins',
                category: 'page',
                label: 'Поля страницы',
                passed: false,
                message: `Поля страницы не настроены под стандарт ОГЭ (сейчас: Л ${margins.leftCm}см, П ${margins.rightCm}см). Настройте поля (Левое 2.0 см, остальные 1.5–2.0 см) через меню «Формат → Страница...».`
            });
        }

        // 3. ПАРАМЕТРЫ АБЗАЦЕВ И ОСНОВНОГО ТЕКСТА
        const contentParas = paras.filter(p => (p.textContent || '').trim().length > 0);

        if (contentParas.length === 0 && trimmedText.length > 0) {
            items.push({
                id: 'para_structure',
                category: 'paragraph',
                label: 'Структура абзацев',
                passed: false,
                message: 'Текст должен быть оформлен в виде абзацев (<p>).'
            });
        } else {
            let indentPassCount = 0;
            let nonJustifyCount = 0;
            let wrongFontCount = 0;
            let wrongSizeCount = 0;

            contentParas.forEach((p) => {
                const style = window.getComputedStyle(p);
                
                // 1. textIndent
                const indentCm = parseCm(p.style.textIndent || style.textIndent) || 0;
                if (indentCm >= 0.85 && indentCm <= 1.25) {
                    indentPassCount++;
                }

                // 2. textAlign
                const align = p.style.textAlign || style.textAlign;
                if (align !== 'justify') {
                    nonJustifyCount++;
                }

                // 3. Гарнитура шрифта (Serif)
                const childWithFont = p.querySelector('[style*="font-family"], font[face]');
                const childFont = childWithFont ? (childWithFont.style.fontFamily || childWithFont.getAttribute('face') || '') : '';
                const fontFam = (childFont || p.style.fontFamily || style.fontFamily || '').toLowerCase();
                const isSans = fontFam.includes('sans-serif') || fontFam.includes('arial') || fontFam.includes('liberation sans');
                const isSerif = !isSans && (fontFam.includes('liberation serif') || fontFam.includes('times') || fontFam.includes('serif'));
                if (!isSerif) {
                    wrongFontCount++;
                }

                // 4. Размер шрифта (14 пт)
                const childWithSize = p.querySelector('[style*="font-size"]');
                const targetEl = childWithSize || p;
                const pxSize = parseFloat(window.getComputedStyle(targetEl).fontSize);
                const ptSize = pxSize * 0.75;
                if (ptSize < 13 || ptSize > 15.5) {
                    wrongSizeCount++;
                }
            });

            // Красная строка
            if (indentPassCount === contentParas.length) {
                items.push({
                    id: 'para_first_line',
                    category: 'paragraph',
                    label: 'Красная строка (1.0 см)',
                    passed: true,
                    message: 'Отступ первой строки равен 1.0 см во всех абзацах текста.'
                });
            } else {
                items.push({
                    id: 'para_first_line',
                    category: 'paragraph',
                    label: 'Красная строка (1.0 см)',
                    passed: false,
                    message: `Красная строка 1.0 см отсутствует в ${contentParas.length - indentPassCount} абзац(ах). Настройте отступ через Меню «Формат → Абзац» (Первая строка: 1.0 см) или передвиньте верхний маркер на линейке.`
                });
            }

            // Выравнивание
            if (nonJustifyCount === 0) {
                items.push({
                    id: 'para_justify',
                    category: 'paragraph',
                    label: 'Выравнивание по ширине',
                    passed: true,
                    message: 'Основной текст выровнен по ширине (Justify).'
                });
            } else {
                items.push({
                    id: 'para_justify',
                    category: 'paragraph',
                    label: 'Выравнивание по ширине',
                    passed: false,
                    message: 'Основной текст выровнен не по ширине. По критериям ОГЭ основной текст должен быть выровнен по ширине (Ctrl+J).'
                });
            }

            // Гарнитура
            if (wrongFontCount === 0) {
                items.push({
                    id: 'font_family',
                    category: 'font',
                    label: 'Гарнитура шрифта (Serif)',
                    passed: true,
                    message: 'Использован шрифт с засечками (Liberation Serif / Times New Roman).'
                });
            } else {
                items.push({
                    id: 'font_family',
                    category: 'font',
                    label: 'Гарнитура шрифта (Serif)',
                    passed: false,
                    message: 'Текст набран шрифтом без засечек. Выберите гарнитуру «Liberation Serif» или «Times New Roman» в выпадающем списке шрифтов.'
                });
            }

            // Размер шрифта
            if (wrongSizeCount === 0) {
                items.push({
                    id: 'font_size',
                    category: 'font',
                    label: 'Размер шрифта (14 пт)',
                    passed: true,
                    message: 'Основной текст набран кеглем 14 пт.'
                });
            } else {
                items.push({
                    id: 'font_size',
                    category: 'font',
                    label: 'Размер шрифта (14 пт)',
                    passed: false,
                    message: 'Размер основного текста отличается от требуемых 14 пт. Выделите текст и установите размер «14 пт» на панели инструментов.'
                });
            }

            // Межстрочный интервал (1.0 - 1.5)
            const pStyle = window.getComputedStyle(contentParas[0]);
            const lh = contentParas[0].style.lineHeight || pStyle.lineHeight;
            let isLhOk = true;
            if (lh) {
                const lhNum = parseFloat(lh);
                const fsNum = parseFloat(pStyle.fontSize);
                const ratio = lh.endsWith('px') ? (lhNum / fsNum) : lhNum;
                if (!isNaN(ratio) && (ratio < 0.95 || ratio > 1.6)) {
                    isLhOk = false;
                }
            }
            if (isLhOk) {
                items.push({
                    id: 'line_spacing',
                    category: 'paragraph',
                    label: 'Межстрочный интервал (1.0–1.5)',
                    passed: true,
                    message: 'Межстрочный интервал соответствует норме (от 1.0 до 1.5).'
                });
            } else {
                items.push({
                    id: 'line_spacing',
                    category: 'paragraph',
                    label: 'Межстрочный интервал (1.0–1.5)',
                    passed: false,
                    message: 'Межстрочный интервал выходит за рамки допустимого (должен быть от 1.0 до 1.5, рекомендуется 1.15).'
                });
            }
        }

        // 4. ТАБЛИЦА (ЕСЛИ ЕСТЬ)
        const tables = Array.from(rootEl.querySelectorAll('table'));
        if (tables.length > 0) {
            tables.forEach((tbl, tIdx) => {
                const tStyle = window.getComputedStyle(tbl);
                const isCentered = tbl.style.marginLeft === 'auto' && tbl.style.marginRight === 'auto'
                    || tbl.getAttribute('align') === 'center'
                    || tStyle.marginLeft === tStyle.marginRight;

                if (isCentered) {
                    items.push({
                        id: `table_align_${tIdx}`,
                        category: 'table',
                        label: 'Центрирование таблицы',
                        passed: true,
                        message: 'Таблица отцентрирована по горизонтали.'
                    });
                } else {
                    items.push({
                        id: `table_align_${tIdx}`,
                        category: 'table',
                        label: 'Центрирование таблицы',
                        passed: false,
                        message: 'Таблица не отцентрирована на листе. Настройте выравнивание таблицы по центру (Меню: Таблица → Свойства таблицы).'
                    });
                }

                // Шапка таблицы
                const headerCells = (tbl.rows && tbl.rows.length > 0)
                    ? Array.from(tbl.rows[0].cells)
                    : Array.from(tbl.querySelectorAll('th'));
                let headersCentered = true;
                for (const hCell of headerCells) {
                    const cStyle = window.getComputedStyle(hCell);
                    const align = hCell.style.textAlign || cStyle.textAlign;
                    if (align !== 'center') {
                        headersCentered = false;
                        break;
                    }
                }
                if (headersCentered && headerCells.length > 0) {
                    items.push({
                        id: `table_headers_${tIdx}`,
                        category: 'table',
                        label: 'Выравнивание шапки таблицы',
                        passed: true,
                        message: 'Заголовки столбцов выровнены по центру.'
                    });
                } else if (headerCells.length > 0) {
                    items.push({
                        id: `table_headers_${tIdx}`,
                        category: 'table',
                        label: 'Выравнивание шапки таблицы',
                        passed: false,
                        message: 'В заголовках столбцов таблицы текст должен быть выровнен строго по центру.'
                    });
                }

                // Размер шрифта в таблице (не больше основного, 12-14 пт)
                const firstCell = tbl.querySelector('td, th');
                if (firstCell) {
                    const cStyle = window.getComputedStyle(firstCell);
                    const px = parseFloat(cStyle.fontSize);
                    const pt = px * 0.75;
                    if (pt <= 15) {
                        items.push({
                            id: `table_font_size_${tIdx}`,
                            category: 'table',
                            label: 'Размер шрифта в таблице',
                            passed: true,
                            message: `Размер шрифта в таблице (${Math.round(pt)} пт) не превышает размер основного текста.`
                        });
                    } else {
                        items.push({
                            id: `table_font_size_${tIdx}`,
                            category: 'table',
                            label: 'Размер шрифта в таблице',
                            passed: false,
                            message: `Размер шрифта в таблице (${Math.round(pt)} пт) больше допустимого. Допускается 12–14 пт.`
                        });
                    }
                }
            });
        }

        // 5. ИТОГОВЫЙ БАЛЛ ПО КРИТЕРИЯМ ОГЭ 13.2
        const failedItems = items.filter(it => !it.passed);
        const crutchesFound = items.some(it => it.isCrutch && !it.passed);

        let score = 2;
        if (failedItems.length > 0) {
            if (failedItems.length <= 2 && !crutchesFound) {
                score = 1;
            } else {
                score = 0;
            }
        }

        const valid = failedItems.length === 0;
        let summary = '';
        if (valid) {
            summary = 'Документ полностью соответствует требованиям ОГЭ по информатике (Задание 13.2)! Набрано 2 из 2 баллов.';
        } else {
            const errorDescriptions = failedItems.map(f => `• ${f.message}`).join('\n');
            summary = `Обнаружены отклонения от стандартов ОГЭ (Оценка: ${score}/2):\n${errorDescriptions}`;
        }

        return {
            valid,
            score,
            items,
            crutchesFound,
            summary
        };
    }

    // Отрисовка протокола ОГЭ в модальном окне
    function renderOgeReportModal(report) {
        const badgeEl = document.getElementById('oge-modal-badge');
        const alertEl = document.getElementById('oge-report-alert');
        const itemsEl = document.getElementById('oge-report-items');

        if (badgeEl) {
            if (report.score === 2) {
                badgeEl.className = 'badge bg-success fs-6 px-2 py-1';
                badgeEl.innerText = '2 / 2 баллов (Отлично)';
            } else if (report.score === 1) {
                badgeEl.className = 'badge bg-warning text-dark fs-6 px-2 py-1';
                badgeEl.innerText = '1 / 2 баллов (Зачтено с замечаниями)';
            } else {
                badgeEl.className = 'badge bg-danger fs-6 px-2 py-1';
                badgeEl.innerText = '0 / 2 баллов (Не зачтено)';
            }
        }

        if (alertEl) {
            alertEl.className = report.valid 
                ? 'alert alert-success rounded-0 py-2 px-3 mb-3' 
                : 'alert alert-danger rounded-0 py-2 px-3 mb-3';
            alertEl.innerText = report.summary;
        }

        if (itemsEl) {
            itemsEl.innerHTML = '';
            report.items.forEach(item => {
                const card = document.createElement('div');
                card.className = `p-2 border ${item.passed ? 'border-success bg-light text-success' : 'border-danger bg-white text-danger'} rounded-0`;
                const icon = item.passed ? '✅' : (item.isCrutch ? '⚠️ [КОСТЫЛЬ]' : '❌');
                card.innerHTML = `
                    <div class="fw-bold mb-1">${icon} ${item.label}</div>
                    <div class="text-secondary small" style="color: #444 !important;">${item.message}</div>
                `;
                itemsEl.appendChild(card);
            });
        }
    }

    // Инициализация диалоговых окон
    function initModals() {
        // 1. Диалог «Абзац...»
        const openParaDialog = (e) => {
            if (e) e.preventDefault();
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            const sel = editor.selection ? editor.selection.current() : null;
            if (sel) {
                lastActivePara = sel.closest ? sel.closest('p, h1, h2, h3, li') : (sel.parentElement ? sel.parentElement.closest('p, h1, h2, h3, li') : null);
            }
            if (!lastActivePara && wysiwyg) {
                lastActivePara = wysiwyg.querySelector('p, h1, h2, h3, li');
            }
            const modalEl = document.getElementById('modal-paragraph');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('menu-format-paragraph')?.addEventListener('click', openParaDialog);

        document.getElementById('btn-apply-paragraph')?.addEventListener('click', () => {
            const firstLine = document.getElementById('dialog-para-firstline')?.value || '1.0';
            const left = document.getElementById('dialog-para-left')?.value || '0.0';
            const right = document.getElementById('dialog-para-right')?.value || '0.0';
            const top = document.getElementById('dialog-para-top')?.value || '0';
            const bottom = document.getElementById('dialog-para-bottom')?.value || '0';
            const lh = document.getElementById('dialog-para-lineheight')?.value || '1.0';
            const alignRadio = document.querySelector('input[name="dialog-align"]:checked')?.value || 'justify';

            applyParagraphStyle({
                textIndent: `${firstLine}cm`,
                marginLeft: `${left}cm`,
                marginRight: `${right}cm`,
                marginTop: `${top}pt`,
                marginBottom: `${bottom}pt`,
                lineHeight: lh,
                textAlign: alignRadio
            });
            recordWriterAction('modal_paragraph', { firstLine, left, right, top, bottom, lh, align: alignRadio });

            const modalEl = document.getElementById('modal-table-fake') || document.getElementById('modal-paragraph');
            if (modalEl && window.bootstrap) bootstrap.Modal.getInstance(modalEl)?.hide();
        });

        // 2. Диалог «Вставить таблицу...»
        const openTableDialog = (e) => {
            if (e) e.preventDefault();
            const modalEl = document.getElementById('modal-table');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('btn-table')?.addEventListener('click', openTableDialog);
        document.getElementById('menu-insert-table')?.addEventListener('click', openTableDialog);
        document.getElementById('menu-table-insert')?.addEventListener('click', openTableDialog);

        document.getElementById('btn-apply-table')?.addEventListener('click', () => {
            const cols = parseInt(document.getElementById('dialog-table-cols')?.value || '3', 10);
            const rows = parseInt(document.getElementById('dialog-table-rows')?.value || '3', 10);
            
            let html = '<table style="width: 100%; border-collapse: collapse; margin: 12px 0;"><thead><tr>';
            for (let c = 1; c <= cols; c++) {
                html += `<th style="border: 1px solid #000; padding: 6px; text-align: center; font-weight: bold; background: #fafafa;">Заголовок ${c}</th>`;
            }
            html += '</tr></thead><tbody>';
            for (let r = 1; r <= rows - 1; r++) {
                html += '<tr>';
                for (let c = 1; c <= cols; c++) {
                    html += `<td style="border: 1px solid #000; padding: 6px; text-align: left;">Ячейка ${r},${c}</td>`;
                }
                html += '</tr>';
            }
            html += '</tbody></table><p></p>';
            editor.selection.insertHTML(html);
            recordWriterAction('insert_table', { cols, rows });
            updateStatusbarWords();
            emitWriterChange();

            const modalEl = document.getElementById('modal-table');
            if (modalEl && window.bootstrap) bootstrap.Modal.getInstance(modalEl)?.hide();
        });

        // Операции над таблицей (строки / столбцы)
        document.getElementById('menu-table-row-above')?.addEventListener('click', () => {
            const cell = editor.selection.current()?.closest('td, th');
            if (cell) {
                const tr = cell.closest('tr');
                const newTr = tr.cloneNode(true);
                Array.from(newTr.children).forEach(td => td.innerHTML = '&nbsp;');
                tr.parentNode.insertBefore(newTr, tr);
                recordWriterAction('table_row_above');
                emitWriterChange();
            }
        });
        document.getElementById('menu-table-row-below')?.addEventListener('click', () => {
            const cell = editor.selection.current()?.closest('td, th');
            if (cell) {
                const tr = cell.closest('tr');
                const newTr = tr.cloneNode(true);
                Array.from(newTr.children).forEach(td => td.innerHTML = '&nbsp;');
                tr.after(newTr);
                recordWriterAction('table_row_below');
                emitWriterChange();
            }
        });
        document.getElementById('menu-table-row-delete')?.addEventListener('click', () => {
            editor.selection.current()?.closest('tr')?.remove();
            recordWriterAction('table_row_delete');
            emitWriterChange();
        });
        document.getElementById('menu-table-delete')?.addEventListener('click', () => {
            editor.selection.current()?.closest('table')?.remove();
            recordWriterAction('table_delete');
            emitWriterChange();
        });

        // 3. Диалог «Свойства таблицы...»
        const openTablePropsDialog = (e) => {
            if (e) e.preventDefault();
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            const sel = editor.selection ? editor.selection.current() : null;
            if (sel) {
                lastActiveTable = sel.closest ? sel.closest('table') : (sel.parentElement ? sel.parentElement.closest('table') : null);
            }
            if (!lastActiveTable && wysiwyg) {
                lastActiveTable = wysiwyg.querySelector('table');
            }
            const modalEl = document.getElementById('modal-table-props');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('menu-table-props')?.addEventListener('click', openTablePropsDialog);
        document.getElementById('menu-table-properties')?.addEventListener('click', openTablePropsDialog);

        document.getElementById('btn-apply-table-props')?.addEventListener('click', () => {
            const align = document.getElementById('dialog-table-align')?.value || 'center';
            const headerAlign = document.getElementById('dialog-table-header-align')?.value || 'center';
            const fontSize = document.getElementById('dialog-table-font-size')?.value || '14pt';
            const headerBold = document.getElementById('dialog-table-header-bold')?.checked ?? true;

            applyTableProps({
                align,
                headerAlign,
                fontSize,
                headerBold
            });
            recordWriterAction('modal_table_props', { align, headerAlign, fontSize, headerBold });

            const modalEl = document.getElementById('modal-table-props');
            if (modalEl && window.bootstrap) bootstrap.Modal.getInstance(modalEl)?.hide();
        });

        // 4. Диалог «Параметры страницы...»
        const openPageDialog = (e) => {
            if (e) e.preventDefault();
            const leftInp = document.getElementById('dialog-page-left');
            const rightInp = document.getElementById('dialog-page-right');
            const topInp = document.getElementById('dialog-page-top');
            const bottomInp = document.getElementById('dialog-page-bottom');
            if (leftInp) leftInp.value = pageMargins.leftCm;
            if (rightInp) rightInp.value = pageMargins.rightCm;
            if (topInp) topInp.value = pageMargins.topCm;
            if (bottomInp) bottomInp.value = pageMargins.bottomCm;

            const modalEl = document.getElementById('modal-page');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('menu-format-page')?.addEventListener('click', openPageDialog);

        document.getElementById('btn-page-set-oge')?.addEventListener('click', () => {
            const leftInp = document.getElementById('dialog-page-left');
            const rightInp = document.getElementById('dialog-page-right');
            const topInp = document.getElementById('dialog-page-top');
            const bottomInp = document.getElementById('dialog-page-bottom');
            if (leftInp) leftInp.value = '2.0';
            if (rightInp) rightInp.value = '2.0';
            if (topInp) topInp.value = '2.0';
            if (bottomInp) bottomInp.value = '2.0';
        });

        document.getElementById('btn-apply-page')?.addEventListener('click', () => {
            const left = parseFloat(document.getElementById('dialog-page-left')?.value || '1.0');
            const right = parseFloat(document.getElementById('dialog-page-right')?.value || '1.0');
            const top = parseFloat(document.getElementById('dialog-page-top')?.value || '1.0');
            const bottom = parseFloat(document.getElementById('dialog-page-bottom')?.value || '1.0');

            applyPageMargins({
                leftCm: left,
                rightCm: right,
                topCm: top,
                bottomCm: bottom
            });
            recordWriterAction('modal_page_margins', { left, right, top, bottom });

            const modalEl = document.getElementById('modal-page');
            if (modalEl && window.bootstrap) bootstrap.Modal.getInstance(modalEl)?.hide();
        });

        // 5. Диалог «Специальные символы...»
        const openSymbolsDialog = (e) => {
            if (e) e.preventDefault();
            const modalEl = document.getElementById('modal-symbols');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('btn-symbol')?.addEventListener('click', openSymbolsDialog);
        document.getElementById('menu-insert-symbols')?.addEventListener('click', openSymbolsDialog);

        document.querySelectorAll('.lo-sym-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const sym = btn.getAttribute('data-sym');
                if (sym) {
                    editor.selection.insertHTML(sym);
                    recordWriterAction('insert_symbol', { sym });
                    updateStatusbarWords();
                    emitWriterChange();
                }
                const modalEl = document.getElementById('modal-symbols');
                if (modalEl && window.bootstrap) bootstrap.Modal.getInstance(modalEl)?.hide();
            });
        });

        // 6. Диалог «Протокол проверки ОГЭ 13.2»
        const openOgeReportDialog = (e) => {
            if (e) e.preventDefault();
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            const report = inspectOgeDocument(wysiwyg, pageMargins);
            lastOgeReport = report;
            renderOgeReportModal(report);
            const modalEl = document.getElementById('modal-oge-report');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('menu-tools-oge-check')?.addEventListener('click', openOgeReportDialog);
        document.getElementById('btn-show-report')?.addEventListener('click', openOgeReportDialog);
    }

    // Зум (масштабирование страницы)
    function initZoom() {
        const slider = document.getElementById('zoom-slider');
        const valText = document.getElementById('zoom-val');
        const applyZoom = (val) => {
            valText.innerText = `${val}%`;
            const scale = val / 100;
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            if (wysiwyg) {
                wysiwyg.style.transform = `scale(${scale})`;
                wysiwyg.style.transformOrigin = 'top center';
            }
        };
        slider?.addEventListener('input', (e) => applyZoom(e.target.value));
        document.getElementById('zoom-in')?.addEventListener('click', () => {
            let v = Math.min(150, parseInt(slider.value, 10) + 10);
            slider.value = v;
            applyZoom(v);
        });
        document.getElementById('zoom-out')?.addEventListener('click', () => {
            let v = Math.max(50, parseInt(slider.value, 10) - 10);
            slider.value = v;
            applyZoom(v);
        });
    }

    // Экспорт вспомогательных функций на window для тестов и интеграций
    window.inspectOgeDocument = inspectOgeDocument;
    window.applyPageMargins = applyPageMargins;
    window.applyParagraphStyle = applyParagraphStyle;
    window.applyTableProps = applyTableProps;
    window.getWriterState = getWriterState;
    window.setWriterOgeCheck = (val) => { dynamicCheckOgeFormat = !!val; };
    window.resetWriterState = (initialHtml = '<p><br></p>', resetLog = false, resetMargins = false) => {
        if (editor) {
            editor.value = initialHtml;
        }
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        if (wysiwyg) {
            wysiwyg.innerHTML = initialHtml;
        }
        if (resetLog) {
            writerActionLog.length = 0;
        }
        if (resetMargins) {
            applyPageMargins({ leftCm: 1.0, rightCm: 1.0, topCm: 1.0, bottomCm: 1.0 });
        }
        updateStatusbarWords();
        emitWriterChange();
    };

    // Валидация решения (кнопка ПРОВЕРИТЬ ДОКУМЕНТ)
    document.getElementById('check-btn').addEventListener('click', () => {
        if (!editor) return;
        attempts++;
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        const content = (wysiwyg && wysiwyg.innerHTML) ? wysiwyg.innerHTML : editor.value;
        const statusEl = document.getElementById('writer-status');
        const reportBtn = document.getElementById('btn-show-report');

        // ЯДЕРНАЯ ФИЧА: Автоматическая экспертная проверка документа и детектор костылей ОГЭ 13.2
        const report = inspectOgeDocument(wysiwyg, pageMargins);
        lastOgeReport = report;

        if ((dynamicCheckOgeFormat && !report.valid) || report.crutchesFound) {
            if (statusEl) {
                statusEl.className = 'text-danger fw-bold px-2';
                statusEl.innerText = `❌ Ошибка ОГЭ 13.2 (${report.score}/2 баллов): несоответствие стандарту!`;
            }
            if (reportBtn) {
                reportBtn.style.display = 'inline-block';
            }
            renderOgeReportModal(report);
            const modalEl = document.getElementById('modal-oge-report');
            if (modalEl && window.bootstrap) {
                new bootstrap.Modal(modalEl).show();
            }
            sendTelemetry('hardcore_reset', 'in_progress', false);
            if (hardcoreReset) {
                editor.value = '';
            }
            document.dispatchEvent(new CustomEvent('writer-error', { detail: { report } }));
            return; // БЛОКИРУЕМ прохождение задания, пока оформление не приведено в норму
        } else if (dynamicCheckOgeFormat) {
            if (reportBtn) {
                reportBtn.style.display = 'inline-block';
            }
            renderOgeReportModal(report);
        }
        
        // Если оформление не содержит костылей (и соответствует ОГЭ при включенном флаге), переходим к проверке условий волны/урока
        const event = new CustomEvent('writer-check', { 
            detail: { 
                html: content,
                text: wysiwyg ? (wysiwyg.innerText || '') : '',
                wysiwyg: wysiwyg,
                pageMargins: { ...pageMargins },
                actionLog: writerActionLog.slice(),
                ogeReport: report,
                resolve: (success, msg, isFinal = true) => {
                    if (success) {
                        statusEl.className = 'text-success fw-bold px-2';
                        statusEl.innerText = msg || '✅ Проверено. Задание выполнено!';
                        if (isFinal) {
                            sendTelemetry('level_complete', 'completed', true);
                        }
                    } else {
                        statusEl.className = 'text-danger fw-bold px-2';
                        statusEl.innerText = msg || '❌ Ошибка форматирования!';
                        sendTelemetry('hardcore_reset', 'in_progress', false);
                        if (hardcoreReset) {
                            editor.value = ''; 
                        }
                    }
                },
                editor: editor
            }
        });
        
        document.dispatchEvent(event);
    });
</script>

