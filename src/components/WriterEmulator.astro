        // --- ПАНЕЛЬ ФОРМАТИРОВАНИЯ И МЕНЮ ФОРМАТ ---
        // Стиль абзаца
        document.getElementById('select-style')?.addEventListener('change', (e) => {
            const tag = e.target.value;
            editor.execCommand('formatBlock', false, tag);
            recordWriterAction('style_block', { value: tag });
        });

        // Гарнитура шрифта
        const applyFontFromSelect = (e) => {
            const font = e.target.value;
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            const sel = window.getSelection();
            if (sel && !sel.isCollapsed && wysiwyg && wysiwyg.contains(sel.anchorNode)) {
                try { editor.execCommand('fontname', false, font); } catch (_) {}
            }
            let p = null;
            try {
                const cur = editor.selection?.current();
                p = cur?.closest ? cur.closest('p, h1, h2, h3, li, td, th') : (cur?.parentElement?.closest('p, h1, h2, h3, li, td, th') || null);
            } catch (_) {}
            const fallbackFont = (font.includes('Serif') || font.includes('Times')) ? `'${font}', serif` : (font.includes('Courier') ? `'${font}', monospace` : `'${font}', sans-serif`);
            const updateBlockFont = (el) => {
                el.style.fontFamily = fallbackFont;
                el.querySelectorAll('[style*="font-family"], font[face]').forEach(child => {
                    child.style.fontFamily = fallbackFont;
                    if (child.hasAttribute('face')) child.setAttribute('face', font);
                });
            };
            if (p && wysiwyg && wysiwyg.contains(p)) {
                updateBlockFont(p);
                if (p.tagName !== 'TD' && p.tagName !== 'TH') {
                    wysiwyg.style.fontFamily = fallbackFont;
                }
            } else if (lastActivePara && document.contains(lastActivePara)) {
                updateBlockFont(lastActivePara);
                if (wysiwyg) wysiwyg.style.fontFamily = fallbackFont;
            } else if (wysiwyg) {
                wysiwyg.style.fontFamily = fallbackFont;
                const allBlocks = wysiwyg.querySelectorAll('p, h1, h2, h3, li');
                if (allBlocks.length > 0) allBlocks.forEach(updateBlockFont);
            }
            recordWriterAction('font_family', { value: font });
        };
        document.getElementById('select-font')?.addEventListener('change', applyFontFromSelect);

        // Размер шрифта
        const applyFontSizeFromSelect = (e) => {
            const size = e.target.value;
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            const sel = window.getSelection();
            if (sel && !sel.isCollapsed && wysiwyg && wysiwyg.contains(sel.anchorNode)) {
                try { editor.selection.applyStyle({ fontSize: size }); } catch (_) {}
            }
            let p = null;
            try {
                const cur = editor.selection?.current();
                p = cur?.closest ? cur.closest('p, h1, h2, h3, li, td, th') : (cur?.parentElement?.closest('p, h1, h2, h3, li, td, th') || null);
            } catch (_) {}
            const updateBlockSize = (el) => {
                el.style.fontSize = size;
                el.querySelectorAll('[style*="font-size"]').forEach(child => {
                    child.style.fontSize = size;
                });
            };
            if (p && wysiwyg && wysiwyg.contains(p)) {
                updateBlockSize(p);
                if (p.tagName !== 'TD' && p.tagName !== 'TH') {
                    wysiwyg.style.fontSize = size;
                }
            } else if (lastActivePara && document.contains(lastActivePara)) {
                updateBlockSize(lastActivePara);
                if (wysiwyg) wysiwyg.style.fontSize = size;
            } else if (wysiwyg) {
                wysiwyg.style.fontSize = size;
                const allBlocks = wysiwyg.querySelectorAll('p, h1, h2, h3, li');
                if (allBlocks.length > 0) allBlocks.forEach(updateBlockSize);
            }
            recordWriterAction('font_size', { value: size });
        };
        document.getElementById('select-fontsize')?.addEventListener('change', applyFontSizeFromSelect);

        // Инлайн-форматирование текста с управляемым выводом курсора за пределы тега
        const INLINE_TAG_MAP = {
            'subscript': { selector: 'sub, [style*="vertical-align: sub"]', btnId: 'btn-sub' },
            'superscript': { selector: 'sup, [style*="vertical-align: super"]', btnId: 'btn-sup' },
            'bold': { selector: 'b, strong, [style*="font-weight: bold"], [style*="font-weight: 700"], [style*="font-weight: 800"], [style*="font-weight: 900"]', btnId: 'btn-bold' },
            'italic': { selector: 'i, em, [style*="font-style: italic"]', btnId: 'btn-italic' },
            'underline': { selector: 'u, [style*="text-decoration: underline"], [style*="text-decoration-line: underline"]', btnId: 'btn-underline' },
            'strikethrough': { selector: 's, strike, del, [style*="text-decoration: line-through"], [style*="text-decoration-line: line-through"]', btnId: 'btn-strikethrough' }
        };

        const executeInlineFormat = (cmd, btnId) => {
            restoreSavedEditorRange();
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            const sel = window.getSelection();

            if (!wysiwyg || !sel || sel.rangeCount === 0) {
                try { editor.execCommand(cmd); } catch (_) {}
                saveCurrentEditorRange();
                updateToolbarActiveStates();
                recordWriterAction(`format_${cmd}`, { command: cmd });
                return;
            }

            const range = sel.getRangeAt(0);
            const mapping = INLINE_TAG_MAP[cmd];

            // 1. Если выделен фрагмент текста (не свёрнутый курсор)
            if (!range.collapsed) {
                try { editor.execCommand(cmd); } catch (_) {}
                if (mapping) pendingInlineStates[cmd] = false;
                saveCurrentEditorRange();
                updateToolbarActiveStates();
                recordWriterAction(`format_${cmd}`, { command: cmd });
                return;
            }

            // 2. Свёрнутый курсор: проверяем, находимся ли мы внутри соответствующего инлайн-тега
            const startEl = range.startContainer.nodeType === Node.ELEMENT_NODE
                ? range.startContainer
                : range.startContainer.parentElement;
            const enclosingTag = (startEl && mapping) ? startEl.closest(mapping.selector) : null;

            if (enclosingTag && wysiwyg.contains(enclosingTag)) {
                // Курсор внутри тега, ученик нажал кнопку повторно для ВЫКЛЮЧЕНИЯ форматирования
                const testRange = document.createRange();
                testRange.setStart(range.endContainer, range.endOffset);
                testRange.setEndAfter(enclosingTag);
                const textAfter = testRange.toString().replace(/[\uFEFF\u200B\u200C\u200D]/g, '');

                if (textAfter.length === 0) {
                    // Выводим курсор за пределы тега с созданием безопасной позиции ввода
                    let targetNode = enclosingTag.nextSibling;
                    let targetOffset = 0;

                    if (targetNode && targetNode.nodeType === Node.TEXT_NODE) {
                        targetOffset = 0;
                    } else {
                        const zwsp = document.createTextNode('\u200B');
                        enclosingTag.parentNode.insertBefore(zwsp, enclosingTag.nextSibling);
                        targetNode = zwsp;
                        targetOffset = 1;
                    }

                    const newRange = document.createRange();
                    newRange.setStart(targetNode, targetOffset);
                    newRange.collapse(true);
                    sel.removeAllRanges();
                    sel.addRange(newRange);

                    try {
                        if (document.queryCommandState(cmd)) {
                            document.execCommand(cmd, false, null);
                        }
                    } catch (_) {}
                    pendingInlineStates[cmd] = false;
                } else {
                    try { editor.execCommand(cmd); } catch (_) {}
                    pendingInlineStates[cmd] = false;
                }
            } else {
                // Курсор вне тега: ученик включает форматирование для последующего набора
                try { editor.execCommand(cmd); } catch (_) {}
                if (mapping) {
                    pendingInlineStates[cmd] = true;
                }
            }

            saveCurrentEditorRange();
            updateToolbarActiveStates();
            recordWriterAction(`format_${cmd}`, { command: cmd });
        };

        // Форматирование текста
        const bindCmd = (btnId, menuId, cmd) => {
            const fn = (e) => {
                if (e) e.preventDefault();
                if (INLINE_TAG_MAP[cmd]) {
                    executeInlineFormat(cmd, btnId);
                } else {
                    restoreSavedEditorRange();
                    try { editor.execCommand(cmd); } catch (_) {}
                    saveCurrentEditorRange();
                    updateToolbarActiveStates();
                    recordWriterAction(`format_${cmd}`, { command: cmd });
                }
            };
            document.getElementById(btnId)?.addEventListener('click', fn);
            if (menuId) document.getElementById(menuId)?.addEventListener('click', fn);
        };
        bindCmd('btn-bold', 'menu-format-bold', 'bold');
        bindCmd('btn-italic', 'menu-format-italic', 'italic');
        bindCmd('btn-underline', 'menu-format-underline', 'underline');
        bindCmd('btn-strikethrough', 'menu-format-strikethrough', 'strikethrough');
        bindCmd('btn-sup', 'menu-format-sup', 'superscript');
        bindCmd('btn-sub', 'menu-format-sub', 'subscript');
        
        // Очистить прямое форматирование (Ctrl+M)
        const onClearFormat = () => {
            Object.keys(pendingInlineStates).forEach(k => { pendingInlineStates[k] = false; });
            try { editor.execCommand('removeFormat'); } catch (_) {}
            // Очищаем локальные инлайн-стили абзаца
            const block = editor.selection ? editor.selection.current() : null;
            if (block) {
                const p = block.closest ? block.closest('p, h1, h2, h3, li') : block.parentElement?.closest('p, h1, h2, h3, li');
                if (p) {
                    p.style.textIndent = '';
                    p.style.lineHeight = '';
                    p.style.textAlign = '';
                    p.style.marginTop = '';
                    p.style.marginBottom = '';
                }
            }
            recordWriterAction('clear_format');
        };
        document.getElementById('btn-eraser')?.addEventListener('click', onClearFormat);
        document.getElementById('menu-format-clear')?.addEventListener('click', onClearFormat);

        // Старые prompt-заглушки цветов заменены визуальной палитрой LibreOffice в initColorPopover()

        // Выравнивание
        const bindAlign = (btnId, menuId, cmd, cssAlign) => {
            const fn = (e) => {
                if (e) e.preventDefault();
                restoreSavedEditorRange();
                try { editor.execCommand(cmd); } catch (_) {}
                applyParagraphStyle({ textAlign: cssAlign });
                saveCurrentEditorRange();
                updateToolbarActiveStates();
                recordWriterAction(`align_${cssAlign}`, { value: cssAlign });
            };
            document.getElementById(btnId)?.addEventListener('click', fn);
            if (menuId) document.getElementById(menuId)?.addEventListener('click', fn);
        };
        bindAlign('btn-align-left', 'menu-format-align-left', 'justifyleft', 'left');
        bindAlign('btn-align-center', 'menu-format-align-center', 'justifycenter', 'center');
        bindAlign('btn-align-right', 'menu-format-align-right', 'justifyright', 'right');
        bindAlign('btn-align-justify', 'menu-format-align-justify', 'justifyfull', 'justify');

        // Списки
        document.getElementById('btn-ul')?.addEventListener('click', () => {
            restoreSavedEditorRange();
            editor.execCommand('insertunorderedlist');
            saveCurrentEditorRange();
            recordWriterAction('list', { value: 'ul' });
        });
        document.getElementById('btn-ol')?.addEventListener('click', () => {
            restoreSavedEditorRange();
            editor.execCommand('insertorderedlist');
            saveCurrentEditorRange();
            recordWriterAction('list', { value: 'ol' });
        });

        // Отступы
        document.getElementById('btn-outdent')?.addEventListener('click', () => {
            editor.execCommand('outdent');
            recordWriterAction('outdent');
        });
        document.getElementById('btn-indent')?.addEventListener('click', () => {
            editor.execCommand('indent');
            recordWriterAction('indent');
        });

        // Междустрочный интервал
        document.querySelectorAll('[data-lineheight]').forEach(el => {
            el.addEventListener('click', (e) => {
                e.preventDefault();
                const lh = el.getAttribute('data-lineheight');
                applyParagraphStyle({ lineHeight: lh });
                recordWriterAction('line_height', { value: lh });
            });
        });

        // Межабзацный интервал
        document.getElementById('act-para-add-bottom')?.addEventListener('click', (e) => {
            e.preventDefault();
            applyParagraphStyle({ marginBottom: '6pt' });
            recordWriterAction('para_space', { marginBottom: '6pt' });
        });
        document.getElementById('act-para-add-top')?.addEventListener('click', (e) => {
            e.preventDefault();
            applyParagraphStyle({ marginTop: '6pt' });
            recordWriterAction('para_space', { marginTop: '6pt' });
        });
        document.getElementById('act-para-add-oge')?.addEventListener('click', (e) => {
            e.preventDefault();
            applyParagraphStyle({ marginBottom: '12pt' });
            recordWriterAction('para_space', { marginBottom: '12pt' });
        });
        document.getElementById('btn-paraspace-dec')?.addEventListener('click', (e) => {
            e.preventDefault();
            applyParagraphStyle({ marginTop: '0pt', marginBottom: '0pt' });
            recordWriterAction('para_space', { marginTop: '0pt', marginBottom: '0pt' });
        });
        document.getElementById('act-para-remove')?.addEventListener('click', (e) => {
            e.preventDefault();
            applyParagraphStyle({ marginTop: '0', marginBottom: '0' });
            recordWriterAction('para_space', { marginTop: '0', marginBottom: '0' });
        });

        // Клик по линейке для быстрой установки красной строки 1 см (ОГЭ) — только если не было drag-перетаскивания
        document.getElementById('ruler-first-line')?.addEventListener('click', () => {
            if (rulerDragState && rulerDragState.moved) return;
            applyParagraphStyle({ textIndent: '1.0cm', lineHeight: '1.15' });
            recordWriterAction('ruler_first_line', { textIndent: '1.0cm' });
            const statusEl = document.getElementById('writer-status');
            if (statusEl) {
                statusEl.className = 'text-primary fw-bold px-2';
                statusEl.innerText = 'Отступ первой строки (красная строка): 1,00 см';
            }
        });

        // Сервис: статистика и статус-бар
        const onWordCount = () => {
            updateStatusbarWords();
            const modalEl = document.getElementById('modal-wordcount');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('menu-tools-wordcount')?.addEventListener('click', onWordCount);
        document.getElementById('statusbar-words')?.addEventListener('dblclick', onWordCount);
        document.getElementById('statusbar-pagestyle')?.addEventListener('dblclick', () => {
            document.getElementById('menu-format-page')?.click();
        });
        document.getElementById('btn-spelling')?.addEventListener('click', () => {
            showLoStatusHint('✅ Проверка орфографии завершена: орфографических ошибок не обнаружено.');
        });
        document.getElementById('menu-tools-spelling')?.addEventListener('click', () => {
            alert('LibreOffice Writer: проверка правописания завершена. Ошибок не обнаружено.');
        });
        document.getElementById('menu-help-oge-guide')?.addEventListener('click', (e) => {
            e.preventDefault();
            showLoStatusHint('ОГЭ 13.2: Шрифт с засечками 14 пт, отступ 1.0 см, по ширине, инт. 1.0–1.5, поля 2.0 см, таблица по центру.');
        });
        document.getElementById('menu-help-about')?.addEventListener('click', () => {
            alert('LibreOffice Writer 26.8 (Colibre)\nСреда тренажёра подготовки к ОГЭ по информатике (Задание 13.2)');
        });
    }

    // Парсер см/px/pt в сантиметры и пункты
    function parseCm(val) {
        if (!val) return null;
        val = val.trim().replace(',', '.').toLowerCase();
        if (val.endsWith('cm')) return parseFloat(val);
        if (val.endsWith('mm')) return parseFloat(val) / 10;
        if (val.endsWith('px')) return parseFloat(val) / 37.79527559;
        if (val.endsWith('pt')) return parseFloat(val) * 0.0352778;
        const num = parseFloat(val);
        return isNaN(num) ? null : num;
    }

    function parsePt(val) {
        if (!val) return null;
        val = val.trim().replace(',', '.').toLowerCase();
        if (val.endsWith('pt')) return parseFloat(val);
        if (val.endsWith('cm')) return parseFloat(val) * 28.3464567;
        if (val.endsWith('mm')) return parseFloat(val) * 2.83464567;
        if (val.endsWith('px')) return parseFloat(val) * 0.75;
        const num = parseFloat(val);
        return isNaN(num) ? null : num;
    }

    // Применение полей листа и синхронизация линейки
    function applyPageMargins(margins) {
        pageMargins = { ...margins };
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        if (wysiwyg) {
            const leftPx = Math.round(margins.leftCm * 40);
            const rightPx = Math.round(margins.rightCm * 40);
            const topPx = Math.round(margins.topCm * 40);
            const bottomPx = Math.round(margins.bottomCm * 40);
            wysiwyg.style.setProperty('padding-left', `${leftPx}px`, 'important');
            wysiwyg.style.setProperty('padding-right', `${rightPx}px`, 'important');
            wysiwyg.style.setProperty('padding-top', `${topPx}px`, 'important');
            wysiwyg.style.setProperty('padding-bottom', `${bottomPx}px`, 'important');
        }
        updateRulerMargins();
    }

    function updateRulerMargins() {
        const leftBox = document.getElementById('ruler-left-margin-box');
        const rightBox = document.getElementById('ruler-right-margin-box');
        const firstLine = document.getElementById('ruler-first-line');
        const leftIndent = document.getElementById('ruler-left-indent');
        const rightIndent = document.getElementById('ruler-right-indent');
        const ticks = document.getElementById('ruler-ticks');
        const vTopBox = document.getElementById('vruler-top-margin');

        const leftPx = Math.round(pageMargins.leftCm * 40);
        const rightPx = Math.round(pageMargins.rightCm * 40);
        const topPx = Math.round(pageMargins.topCm * 40);

        if (leftBox) leftBox.style.width = `${leftPx}px`;
        if (rightBox) rightBox.style.width = `${rightPx}px`;
        if (leftIndent) leftIndent.style.left = `${leftPx - 5}px`;
        if (rightIndent) rightIndent.style.right = `${rightPx - 5}px`;
        if (firstLine) firstLine.style.left = `${leftPx}px`;
        if (ticks) {
            ticks.style.marginLeft = `${leftPx}px`;
            ticks.style.width = `${Math.max(0, 800 - leftPx - rightPx)}px`;
        }
        if (vTopBox) vTopBox.style.height = `${topPx}px`;
    }

    function updateRulerFirstLineMarker(indentCm = 0) {
        const firstLine = document.getElementById('ruler-first-line');
        if (firstLine) {
            const leftPx = Math.round(pageMargins.leftCm * 40);
            const indentPx = Math.round(indentCm * 40);
            firstLine.style.left = `${leftPx + indentPx}px`;
        }
    }

    // Применение стилей к текущему абзацу или группе выделенных абзацев
    function applyParagraphStyle(styles) {
        if (!editor) return;
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        if (!wysiwyg) return;

        let targets = [];
        const sel = editor.selection ? editor.selection.current() : null;
        if (sel) {
            const cell = sel.closest ? sel.closest('th, td') : (sel.parentElement ? sel.parentElement.closest('th, td') : null);
            const p = sel.closest ? sel.closest('p, h1, h2, h3, li') : (sel.parentElement ? sel.parentElement.closest('p, h1, h2, h3, li') : null);
            if (p && (!cell || cell.contains(p))) {
                targets = [p];
            } else if (cell && wysiwyg.contains(cell)) {
                targets = [cell];
                if (styles.textAlign === 'center') {
                    const tbl = cell.closest('table');
                    if (tbl) {
                        tbl.style.marginLeft = 'auto';
                        tbl.style.marginRight = 'auto';
                        tbl.setAttribute('align', 'center');
                    }
                }
            }
        }
        if (targets.length === 0 && lastActivePara && document.contains(lastActivePara)) {
            targets = [lastActivePara];
        }
        if (targets.length === 0) {
            const allP = wysiwyg.querySelectorAll('p, h1, h2, h3, li');
            targets = allP.length > 0 ? Array.from(allP) : [wysiwyg];
        }

        targets.forEach(target => {
            if (target && target.tagName !== 'DIV') {
                lastActivePara = target;
            }
            if (styles.textIndent !== undefined && target.tagName !== 'TD' && target.tagName !== 'TH') {
                target.style.textIndent = styles.textIndent;
                const cm = parseCm(styles.textIndent);
                if (cm !== null) updateRulerFirstLineMarker(cm);
            }
            if (styles.lineHeight !== undefined) target.style.lineHeight = styles.lineHeight;
            if (styles.textAlign !== undefined) target.style.textAlign = styles.textAlign;
            if (styles.marginTop !== undefined) target.style.marginTop = styles.marginTop;
            if (styles.marginBottom !== undefined) target.style.marginBottom = styles.marginBottom;
            if (styles.marginLeft !== undefined) target.style.marginLeft = styles.marginLeft;
            if (styles.marginRight !== undefined) target.style.marginRight = styles.marginRight;
        });
        updateStatusbarWords();
    }

    // Настройка свойств таблицы
    function applyTableProps(props) {
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        if (!wysiwyg) return;

        let table = lastActiveTable;
        if (!table || !document.contains(table)) {
            const sel = editor.selection ? editor.selection.current() : null;
            if (sel) {
                table = sel.closest ? sel.closest('table') : (sel.parentElement ? sel.parentElement.closest('table') : null);
            }
        }
        if (!table) {
            table = wysiwyg.querySelector('table');
        }
        if (!table) {
            alert('В документе не найдена таблица. Вставьте таблицу через меню «Таблица → Вставить таблицу».');
            return;
        }

        // 1. Выравнивание таблицы на листе и ширина
        if (props.widthPct !== undefined && props.widthPct !== null && !isNaN(props.widthPct)) {
            table.style.setProperty('width', `${Math.max(20, Math.min(100, props.widthPct))}%`, 'important');
        }
        if (props.spaceTopPt !== undefined && props.spaceTopPt !== null && !isNaN(props.spaceTopPt)) {
            table.style.setProperty('margin-top', `${props.spaceTopPt}pt`, 'important');
        }
        if (props.spaceBottomPt !== undefined && props.spaceBottomPt !== null && !isNaN(props.spaceBottomPt)) {
            table.style.setProperty('margin-bottom', `${props.spaceBottomPt}pt`, 'important');
        }
        if (props.align === 'center') {
            table.style.marginLeft = 'auto';
            table.style.marginRight = 'auto';
            table.setAttribute('align', 'center');
        } else if (props.align === 'left') {
            table.style.marginLeft = '0';
            table.style.marginRight = 'auto';
            table.setAttribute('align', 'left');
        } else if (props.align === 'right') {
            table.style.marginLeft = 'auto';
            table.style.marginRight = '0';
            table.setAttribute('align', 'right');
        }

        // 2. Шапка таблицы: выравнивание текста и полужирный шрифт
        const headerCells = (table.rows && table.rows.length > 0)
            ? Array.from(table.rows[0].cells)
            : Array.from(table.querySelectorAll('th'));
        headerCells.forEach(cell => {
            if (props.headerAlign) {
                cell.style.textAlign = props.headerAlign;
            }
            if (props.headerBold !== undefined) {
                cell.style.fontWeight = props.headerBold ? 'bold' : 'normal';
            }
        });

        // 3. Размер шрифта и вертикальное выравнивание во всей таблице
        if (props.fontSize || props.valign) {
            table.querySelectorAll('td, th').forEach(cell => {
                if (props.fontSize) cell.style.fontSize = props.fontSize;
                if (props.valign) cell.style.verticalAlign = props.valign;
            });
        }
    }

    // Экспертная проверка документа на соответствие ОГЭ 13.2
    function inspectOgeDocument(rootEl, margins) {
        const items = [];

        if (!rootEl) {
            return {
                valid: false,
                score: 0,
                items: [{ id: 'no_doc', category: 'paragraph', label: 'Документ', passed: false, message: 'Документ пуст или редактор не инициализирован.' }],
                crutchesFound: false,
                summary: 'Документ не содержит текста.'
            };
        }

        const textContent = rootEl.textContent || '';
        const trimmedText = textContent.trim();

        if (trimmedText.length === 0) {
            return {
                valid: false,
                score: 0,
                items: [{ id: 'empty_text', category: 'paragraph', label: 'Текст документа', passed: false, message: 'В документе отсутствует текст. Наберите текст задания.' }],
                crutchesFound: false,
                summary: 'Документ пуст. Наберите текст для проверки.'
            };
        }

        // 1. ДЕТЕКТОР КОСТЫЛЕЙ
        const paras = Array.from(rootEl.querySelectorAll('p, h1, h2, h3'));
        
        // Костыль 1: Красная строка пробелами или табами
        let spaceIndentFound = false;
        for (const p of paras) {
            const html = p.innerHTML || '';
            if (/^(&nbsp;|\s){2,}/i.test(html) || /^\t+/.test(p.textContent || '')) {
                spaceIndentFound = true;
                break;
            }
        }
        if (spaceIndentFound) {
            items.push({
                id: 'crutch_spaces_indent',
                category: 'crutches',
                label: 'Красная строка пробелами',
                passed: false,
                isCrutch: true,
                message: 'Красная строка сделана клавишей Пробел или Tab! По критериям ОГЭ отступ первой строки настраивается в свойствах абзаца (Формат → Абзац → Первая строка: 1.0 см) или на линейке.'
            });
        }

        // Костыль 2: Двойной Enter для пустых строк (игнорируем одиночный технический пустой <p> в самом начале или в самом конце документа, который создаёт браузер/Jodit вокруг таблиц и списков)
        let emptyParasCount = 0;
        for (let idx = 0; idx < paras.length; idx++) {
            const p = paras[idx];
            const pText = (p.textContent || '').replace(/[\uFEFF\u200B\u200C\u200D]/g, '').trim();
            const inner = (p.innerHTML || '').replace(/[\uFEFF\u200B\u200C\u200D]/g, '').trim();
            const isEmptyP = pText === '' && (inner === '' || inner === '<br>' || inner === '&nbsp;');
            if (isEmptyP) {
                // Игнорируем технический замыкающий пустой параграф в самом конце документа (или единственный пустой параграф перед таблицей/списком), если за ним/перед ним нет второго пустого параграфа подряд
                const prevP = idx > 0 ? paras[idx - 1] : null;
                const prevEmpty = prevP && (prevP.textContent || '').replace(/[\uFEFF\u200B\u200C\u200D]/g, '').trim() === '';
                const isTrailingSingle = idx === paras.length - 1 && !prevEmpty;
                const isLeadingBeforeBlock = idx === 0 && paras.length === 1;
                if (!isTrailingSingle && !isLeadingBeforeBlock) {
                    emptyParasCount++;
                }
            }
        }
        if (emptyParasCount > 0) {
            items.push({
                id: 'crutch_double_enter',
                category: 'crutches',
                label: 'Лишние пустые строки (Enter)',
                passed: false,
                isCrutch: true,
                message: `Обнаружено ${emptyParasCount} пустых строк (двойной Enter)! По критериям ОГЭ запрещено разделять абзацы пустыми строками. Используйте межабзацный интервал (Формат → Абзац → Отступ после абзаца).`
            });
        }

        // Костыль 3: Дефис вместо длинного тире между словами
        if (/\s+-\s+/g.test(textContent)) {
            items.push({
                id: 'crutch_hyphen',
                category: 'crutches',
                label: 'Дефис вместо тире',
                passed: false,
                isCrutch: true,
                message: 'Использован дефис (-) вместо длинного тире (—). Вставляйте тире через меню «Вставка → Специальные символы» или Alt+0151.'
            });
        }

        // Костыль 4: Программистские кавычки вместо кавычек-ёлочек
        if (/"[^"]+"/.test(textContent)) {
            items.push({
                id: 'crutch_quotes',
                category: 'crutches',
                label: 'Прямые кавычки вместо кавычек-ёлочек',
                passed: false,
                isCrutch: true,
                message: 'Использованы прямые кавычки (") вместо кавычек-ёлочек (« »). Вставляйте кавычки через меню «Вставка → Специальные символы».'
            });
        }

        // 2. ПАРАМЕТРЫ СТРАНИЦЫ (ПОЛЯ)
        const isLeftMarginOk = margins.leftCm >= 1.8 && margins.leftCm <= 3.2;
        const isRightMarginOk = margins.rightCm >= 1.3 && margins.rightCm <= 2.5;
        const isTopMarginOk = margins.topCm >= 1.3 && margins.topCm <= 2.5;
        const isBottomMarginOk = margins.bottomCm >= 1.3 && margins.bottomCm <= 2.5;

        if (isLeftMarginOk && isRightMarginOk && isTopMarginOk && isBottomMarginOk) {
            items.push({
                id: 'page_margins',
                category: 'page',
                label: 'Поля страницы',
                passed: true,
                message: `Поля страницы настроены верно (Левое: ${margins.leftCm} см, Правое: ${margins.rightCm} см, Верх/Низ: ${margins.topCm} см).`
            });
        } else {
            items.push({
                id: 'page_margins',
                category: 'page',
                label: 'Поля страницы',
                passed: false,
                message: `Поля страницы не настроены под стандарт ОГЭ (сейчас: Л ${margins.leftCm}см, П ${margins.rightCm}см). Настройте поля (Левое 2.0 см, остальные 1.5–2.0 см) через меню «Формат → Страница...».`
            });
        }

        // 3. ПАРАМЕТРЫ АБЗАЦЕВ И ОСНОВНОГО ТЕКСТА
        const contentParas = paras.filter(p => (p.textContent || '').replace(/[\uFEFF\u200B\u200C\u200D]/g, '').trim().length > 0);

        if (contentParas.length === 0 && trimmedText.length > 0) {
            items.push({
                id: 'para_structure',
                category: 'paragraph',
                label: 'Структура абзацев',
                passed: false,
                message: 'Текст должен быть оформлен в виде абзацев (<p>).'
            });
        } else {
            let indentPassCount = 0;
            let nonJustifyCount = 0;
            let wrongFontCount = 0;
            let wrongSizeCount = 0;

            contentParas.forEach((p) => {
                const style = window.getComputedStyle(p);
                
                // 1. textIndent
                const indentCm = parseCm(p.style.textIndent || style.textIndent) || 0;
                if (indentCm >= 0.85 && indentCm <= 1.25) {
                    indentPassCount++;
                }

                // 2. textAlign
                const align = p.style.textAlign || style.textAlign;
                if (align !== 'justify') {
                    nonJustifyCount++;
                }

                // 3. Гарнитура шрифта (Serif)
                const childWithFont = p.querySelector('[style*="font-family"], font[face]');
                const childFont = childWithFont ? (childWithFont.style.fontFamily || childWithFont.getAttribute('face') || '') : '';
                const fontFam = (childFont || p.style.fontFamily || style.fontFamily || '').toLowerCase();
                const isSans = fontFam.includes('sans-serif') || fontFam.includes('arial') || fontFam.includes('liberation sans');
                const isSerif = !isSans && (fontFam.includes('liberation serif') || fontFam.includes('times') || fontFam.includes('serif'));
                if (!isSerif) {
                    wrongFontCount++;
                }

                // 4. Размер шрифта (14 пт)
                const childWithSize = p.querySelector('[style*="font-size"]');
                const targetEl = childWithSize || p;
                const pxSize = parseFloat(window.getComputedStyle(targetEl).fontSize);
                const ptSize = pxSize * 0.75;
                if (ptSize < 13 || ptSize > 15.5) {
                    wrongSizeCount++;
                }
            });

            // Красная строка
            if (indentPassCount === contentParas.length) {
                items.push({
                    id: 'para_first_line',
                    category: 'paragraph',
                    label: 'Красная строка (1.0 см)',
                    passed: true,
                    message: 'Отступ первой строки равен 1.0 см во всех абзацах текста.'
                });
            } else {
                items.push({
                    id: 'para_first_line',
                    category: 'paragraph',
                    label: 'Красная строка (1.0 см)',
                    passed: false,
                    message: `Красная строка 1.0 см отсутствует в ${contentParas.length - indentPassCount} абзац(ах). Настройте отступ через Меню «Формат → Абзац» (Первая строка: 1.0 см) или передвиньте верхний маркер на линейке.`
                });
            }

            // Выравнивание
            if (nonJustifyCount === 0) {
                items.push({
                    id: 'para_justify',
                    category: 'paragraph',
                    label: 'Выравнивание по ширине',
                    passed: true,
                    message: 'Основной текст выровнен по ширине (Justify).'
                });
            } else {
                items.push({
                    id: 'para_justify',
                    category: 'paragraph',
                    label: 'Выравнивание по ширине',
                    passed: false,
                    message: 'Основной текст выровнен не по ширине. По критериям ОГЭ основной текст должен быть выровнен по ширине (Ctrl+J).'
                });
            }

            // Гарнитура
            if (wrongFontCount === 0) {
                items.push({
                    id: 'font_family',
                    category: 'font',
                    label: 'Гарнитура шрифта (Serif)',
                    passed: true,
                    message: 'Использован шрифт с засечками (Liberation Serif / Times New Roman).'
                });
            } else {
                items.push({
                    id: 'font_family',
                    category: 'font',
                    label: 'Гарнитура шрифта (Serif)',
                    passed: false,
                    message: 'Текст набран шрифтом без засечек. Выберите гарнитуру «Liberation Serif» или «Times New Roman» в выпадающем списке шрифтов.'
                });
            }

            // Размер шрифта
            if (wrongSizeCount === 0) {
                items.push({
                    id: 'font_size',
                    category: 'font',
                    label: 'Размер шрифта (14 пт)',
                    passed: true,
                    message: 'Основной текст набран кеглем 14 пт.'
                });
            } else {
                items.push({
                    id: 'font_size',
                    category: 'font',
                    label: 'Размер шрифта (14 пт)',
                    passed: false,
                    message: 'Размер основного текста отличается от требуемых 14 пт. Выделите текст и установите размер «14 пт» на панели инструментов.'
                });
            }

            // Межстрочный интервал (1.0 - 1.5)
            const pStyle = window.getComputedStyle(contentParas[0]);
            const lh = contentParas[0].style.lineHeight || pStyle.lineHeight;
            let isLhOk = true;
            if (lh) {
                const lhNum = parseFloat(lh);
                const fsNum = parseFloat(pStyle.fontSize);
                const ratio = lh.endsWith('px') ? (lhNum / fsNum) : lhNum;
                if (!isNaN(ratio) && (ratio < 0.95 || ratio > 1.6)) {
                    isLhOk = false;
                }
            }
            if (isLhOk) {
                items.push({
                    id: 'line_spacing',
                    category: 'paragraph',
                    label: 'Межстрочный интервал (1.0–1.5)',
                    passed: true,
                    message: 'Межстрочный интервал соответствует норме (от 1.0 до 1.5).'
                });
            } else {
                items.push({
                    id: 'line_spacing',
                    category: 'paragraph',
                    label: 'Межстрочный интервал (1.0–1.5)',
                    passed: false,
                    message: 'Межстрочный интервал выходит за рамки допустимого (должен быть от 1.0 до 1.5, рекомендуется 1.15).'
                });
            }
        }

        // 4. ТАБЛИЦА (ЕСЛИ ЕСТЬ)
        const tables = Array.from(rootEl.querySelectorAll('table'));
        if (tables.length > 0) {
            tables.forEach((tbl, tIdx) => {
                const tStyle = window.getComputedStyle(tbl);
                const isCentered = tbl.style.marginLeft === 'auto' && tbl.style.marginRight === 'auto'
                    || tbl.getAttribute('align') === 'center'
                    || tStyle.marginLeft === tStyle.marginRight;

                if (isCentered) {
                    items.push({
                        id: `table_align_${tIdx}`,
                        category: 'table',
                        label: 'Центрирование таблицы',
                        passed: true,
                        message: 'Таблица отцентрирована по горизонтали.'
                    });
                } else {
                    items.push({
                        id: `table_align_${tIdx}`,
                        category: 'table',
                        label: 'Центрирование таблицы',
                        passed: false,
                        message: 'Таблица не отцентрирована на листе. Настройте выравнивание таблицы по центру (Меню: Таблица → Свойства таблицы).'
                    });
                }

                // Шапка таблицы
                const headerCells = (tbl.rows && tbl.rows.length > 0)
                    ? Array.from(tbl.rows[0].cells)
                    : Array.from(tbl.querySelectorAll('th'));
                let headersCentered = true;
                for (const hCell of headerCells) {
                    const cStyle = window.getComputedStyle(hCell);
                    const align = hCell.style.textAlign || cStyle.textAlign;
                    if (align !== 'center') {
                        headersCentered = false;
                        break;
                    }
                }
                if (headersCentered && headerCells.length > 0) {
                    items.push({
                        id: `table_headers_${tIdx}`,
                        category: 'table',
                        label: 'Выравнивание шапки таблицы',
                        passed: true,
                        message: 'Заголовки столбцов выровнены по центру.'
                    });
                } else if (headerCells.length > 0) {
                    items.push({
                        id: `table_headers_${tIdx}`,
                        category: 'table',
                        label: 'Выравнивание шапки таблицы',
                        passed: false,
                        message: 'В заголовках столбцов таблицы текст должен быть выровнен строго по центру.'
                    });
                }

                // Размер шрифта в таблице (не больше основного, 12-14 пт)
                const firstCell = tbl.querySelector('td, th');
                if (firstCell) {
                    const cStyle = window.getComputedStyle(firstCell);
                    const px = parseFloat(cStyle.fontSize);
                    const pt = px * 0.75;
                    if (pt <= 15) {
                        items.push({
                            id: `table_font_size_${tIdx}`,
                            category: 'table',
                            label: 'Размер шрифта в таблице',
                            passed: true,
                            message: `Размер шрифта в таблице (${Math.round(pt)} пт) не превышает размер основного текста.`
                        });
                    } else {
                        items.push({
                            id: `table_font_size_${tIdx}`,
                            category: 'table',
                            label: 'Размер шрифта в таблице',
                            passed: false,
                            message: `Размер шрифта в таблице (${Math.round(pt)} пт) больше допустимого. Допускается 12–14 пт.`
                        });
                    }
                }
            });
        }

        // 5. ИТОГОВЫЙ БАЛЛ ПО КРИТЕРИЯМ ОГЭ 13.2
        const failedItems = items.filter(it => !it.passed);
        const crutchesFound = items.some(it => it.isCrutch && !it.passed);

        let score = 2;
        if (failedItems.length > 0) {
            if (failedItems.length <= 2 && !crutchesFound) {
                score = 1;
            } else {
                score = 0;
            }
        }

        const valid = failedItems.length === 0;
        let summary = '';
        if (valid) {
            summary = 'Документ полностью соответствует требованиям ОГЭ по информатике (Задание 13.2)! Набрано 2 из 2 баллов.';
        } else {
            const errorDescriptions = failedItems.map(f => `• ${f.message}`).join('\n');
            summary = `Обнаружены отклонения от стандартов ОГЭ (Оценка: ${score}/2):\n${errorDescriptions}`;
        }

        return {
            valid,
            score,
            items,
            crutchesFound,
            summary
        };
    }

    // Отрисовка протокола ОГЭ в модальном окне
    function renderOgeReportModal(report) {
        const badgeEl = document.getElementById('oge-modal-badge');
        const alertEl = document.getElementById('oge-report-alert');
        const itemsEl = document.getElementById('oge-report-items');

        if (badgeEl) {
            if (report.score === 2) {
                badgeEl.className = 'badge bg-success fs-6 px-2 py-1';
                badgeEl.innerText = '2 / 2 баллов (Отлично)';
            } else if (report.score === 1) {
                badgeEl.className = 'badge bg-warning text-dark fs-6 px-2 py-1';
                badgeEl.innerText = '1 / 2 баллов (Зачтено с замечаниями)';
            } else {
                badgeEl.className = 'badge bg-danger fs-6 px-2 py-1';
                badgeEl.innerText = '0 / 2 баллов (Не зачтено)';
            }
        }

        if (alertEl) {
            alertEl.className = report.valid 
                ? 'alert alert-success rounded-0 py-2 px-3 mb-3' 
                : 'alert alert-danger rounded-0 py-2 px-3 mb-3';
            alertEl.innerText = report.summary;
        }

        if (itemsEl) {
            itemsEl.innerHTML = '';
            report.items.forEach(item => {
                const card = document.createElement('div');
                card.className = `p-2 border ${item.passed ? 'border-success bg-light text-success' : 'border-danger bg-white text-danger'} rounded-0`;
                const icon = item.passed ? '✅' : (item.isCrutch ? '⚠️ [КОСТЫЛЬ]' : '❌');
                card.innerHTML = `
                    <div class="fw-bold mb-1">${icon} ${item.label}</div>
                    <div class="text-secondary small" style="color: #444 !important;">${item.message}</div>
                `;
                itemsEl.appendChild(card);
            });
        }
    }

    // Инициализация диалоговых окон
    function initModals() {
        const normalizeDecimalStr = (rawVal, fallback = '0') => {
            const s = String(rawVal ?? '').replace(',', '.').trim();
            return s || fallback;
        };

        // Вспомогательная конвертация значений интервалов (пт / см, с поддержкой запятой)
        const convertSpacingInput = (rawVal, unit) => {
            const cleaned = String(rawVal || '0').trim().replace(',', '.').toLowerCase();
            if (cleaned.endsWith('cm') || cleaned.endsWith('см')) {
                const cm = parseFloat(cleaned) || 0;
                return `${Math.round(cm * 28.3464567)}pt`;
            }
            if (cleaned.endsWith('pt') || cleaned.endsWith('пт')) {
                return `${parseFloat(cleaned) || 0}pt`;
            }
            const num = parseFloat(cleaned) || 0;
            if (unit === 'cm') {
                return `${Math.round(num * 28.3464567)}pt`;
            }
            return `${num}pt`;
        };

        const bindUnitSwitch = (inputId, unitId) => {
            const inp = document.getElementById(inputId);
            const sel = document.getElementById(unitId);
            if (!inp || !sel) return;
            let prevUnit = sel.value;
            sel.addEventListener('change', () => {
                const val = parseFloat(String(inp.value || '0').replace(',', '.')) || 0;
                if (prevUnit === 'pt' && sel.value === 'cm') {
                    inp.value = (val / 28.3464567).toFixed(2);
                } else if (prevUnit === 'cm' && sel.value === 'pt') {
                    inp.value = String(Math.round(val * 28.3464567));
                }
                prevUnit = sel.value;
            });
        };
        bindUnitSwitch('dialog-para-top', 'dialog-para-top-unit');
        bindUnitSwitch('dialog-para-bottom', 'dialog-para-bottom-unit');

        const updateParaPreview = () => {
            const pActive = document.getElementById('lo-para-preview-active');
            const pAlignPrev = document.getElementById('lo-align-preview');
            const firstLine = parseFloat(String(document.getElementById('dialog-para-firstline')?.value || '1.0').replace(',', '.')) || 0;
            const lh = document.getElementById('dialog-para-lineheight')?.value || '1.15';
            const alignVal = document.querySelector('input[name="dialog-align"]:checked')?.value || 'justify';
            if (pActive) {
                pActive.style.textIndent = `${Math.round(firstLine * 12)}px`;
                pActive.style.lineHeight = lh;
                pActive.style.textAlign = alignVal;
            }
            if (pAlignPrev) {
                pAlignPrev.style.textAlign = alignVal;
            }
        };

        // Синхронизация #dialog-para-lineheight и скрытого #dialog-para-linespacing
        const lhMain = document.getElementById('dialog-para-lineheight');
        const lhAlias = document.getElementById('dialog-para-linespacing');
        lhMain?.addEventListener('change', () => { if (lhAlias) lhAlias.value = lhMain.value; updateParaPreview(); });
        lhAlias?.addEventListener('change', () => { if (lhMain) lhMain.value = lhAlias.value; updateParaPreview(); });

        // Синхронизация селекта #dialog-para-align и радиокнопок align-radio-*
        const alignSelect = document.getElementById('dialog-para-align');
        alignSelect?.addEventListener('change', () => {
            const radio = document.querySelector(`input[name="dialog-align"][value="${alignSelect.value}"]`);
            if (radio) radio.checked = true;
            updateParaPreview();
        });
        document.querySelectorAll('input[name="dialog-align"]').forEach(r => {
            r.addEventListener('change', () => {
                if (alignSelect) alignSelect.value = r.value;
                updateParaPreview();
            });
        });
        document.getElementById('dialog-para-firstline')?.addEventListener('input', updateParaPreview);

        // 1. Диалог «Абзац...»
        const openParaDialog = (e) => {
            if (e) e.preventDefault();
            saveCurrentEditorRange();
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            const sel = editor.selection ? editor.selection.current() : null;
            if (sel) {
                lastActivePara = sel.closest ? sel.closest('p, h1, h2, h3, li') : (sel.parentElement ? sel.parentElement.closest('p, h1, h2, h3, li') : null);
            }
            if (!lastActivePara && wysiwyg) {
                lastActivePara = wysiwyg.querySelector('p, h1, h2, h3, li');
            }
            if (lastActivePara && lastActivePara.style) {
                if (lastActivePara.style.lineHeight) {
                    if (lhMain) lhMain.value = lastActivePara.style.lineHeight;
                    if (lhAlias) lhAlias.value = lastActivePara.style.lineHeight;
                }
                if (lastActivePara.style.textAlign) {
                    const radio = document.querySelector(`input[name="dialog-align"][value="${lastActivePara.style.textAlign}"]`);
                    if (radio) radio.checked = true;
                    if (alignSelect) alignSelect.value = lastActivePara.style.textAlign;
                }
                const curTopPt = parsePt(lastActivePara.style.marginTop);
                const curBotPt = parsePt(lastActivePara.style.marginBottom);
                const topInp = document.getElementById('dialog-para-top');
                const botInp = document.getElementById('dialog-para-bottom');
                const topUnit = document.getElementById('dialog-para-top-unit')?.value || 'pt';
                const botUnit = document.getElementById('dialog-para-bottom-unit')?.value || 'pt';
                if (topInp && curTopPt !== null) topInp.value = topUnit === 'cm' ? (curTopPt / 28.3464567).toFixed(2) : String(Math.round(curTopPt));
                if (botInp && curBotPt !== null) botInp.value = botUnit === 'cm' ? (curBotPt / 28.3464567).toFixed(2) : String(Math.round(curBotPt));
            }
            updateParaPreview();
            const modalEl = document.getElementById('modal-paragraph');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('menu-format-paragraph')?.addEventListener('click', openParaDialog);
        document.getElementById('btn-open-para-dialog')?.addEventListener('click', openParaDialog);

        document.getElementById('btn-reset-paragraph')?.addEventListener('click', () => {
            if (document.getElementById('dialog-para-firstline')) document.getElementById('dialog-para-firstline').value = '1.0';
            if (document.getElementById('dialog-para-left')) document.getElementById('dialog-para-left').value = '0.0';
            if (document.getElementById('dialog-para-right')) document.getElementById('dialog-para-right').value = '0.0';
            if (document.getElementById('dialog-para-top')) document.getElementById('dialog-para-top').value = '0';
            if (document.getElementById('dialog-para-bottom')) document.getElementById('dialog-para-bottom').value = '0';
            if (lhMain) lhMain.value = '1.15';
            if (lhAlias) lhAlias.value = '1.15';
            const rJustify = document.getElementById('align-radio-justify');
            if (rJustify) rJustify.checked = true;
            if (alignSelect) alignSelect.value = 'justify';
            updateParaPreview();
        });

        document.getElementById('btn-apply-paragraph')?.addEventListener('click', () => {
            const firstLine = normalizeDecimalStr(document.getElementById('dialog-para-firstline')?.value, '1.0');
            const left = normalizeDecimalStr(document.getElementById('dialog-para-left')?.value, '0.0');
            const right = normalizeDecimalStr(document.getElementById('dialog-para-right')?.value, '0.0');
            const topRaw = document.getElementById('dialog-para-top')?.value || '0';
            const bottomRaw = document.getElementById('dialog-para-bottom')?.value || '0';
            const topUnit = document.getElementById('dialog-para-top-unit')?.value || 'pt';
            const bottomUnit = document.getElementById('dialog-para-bottom-unit')?.value || 'pt';
            const topPtCss = convertSpacingInput(topRaw, topUnit);
            const bottomPtCss = convertSpacingInput(bottomRaw, bottomUnit);
            const lh = document.getElementById('dialog-para-lineheight')?.value || '1.15';
            const alignRadio = document.querySelector('input[name="dialog-align"]:checked')?.value || 'justify';

            applyParagraphStyle({
                textIndent: `${firstLine}cm`,
                marginLeft: `${left}cm`,
                marginRight: `${right}cm`,
                marginTop: topPtCss,
                marginBottom: bottomPtCss,
                lineHeight: lh,
                textAlign: alignRadio
            });
            recordWriterAction('modal_paragraph', { firstLine, left, right, top: topPtCss, bottom: bottomPtCss, lh, align: alignRadio });

            const modalEl = document.getElementById('modal-paragraph');
            if (modalEl && window.bootstrap) bootstrap.Modal.getInstance(modalEl)?.hide();
        });

        // 1.5 Диалог «Символ» (#modal-char)
        const openCharDialog = (e) => {
            if (e) e.preventDefault();
            saveCurrentEditorRange();
            const modalEl = document.getElementById('modal-char');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('menu-format-char')?.addEventListener('click', openCharDialog);
        document.getElementById('btn-open-char-dialog')?.addEventListener('click', openCharDialog);

        const updateCharPreview = () => {
            const prev = document.getElementById('dialog-char-preview');
            if (!prev) return;
            const font = document.getElementById('dialog-char-font')?.value || 'Liberation Sans';
            const st = document.getElementById('dialog-char-style')?.value || 'normal';
            const sz = document.getElementById('dialog-char-size')?.value || '11pt';
            prev.style.fontFamily = font;
            prev.style.fontSize = sz;
            prev.style.fontWeight = st.includes('bold') ? 'bold' : 'normal';
            prev.style.fontStyle = st.includes('italic') ? 'italic' : 'normal';
        };
        ['dialog-char-font', 'dialog-char-style', 'dialog-char-size'].forEach(id => {
            document.getElementById(id)?.addEventListener('change', updateCharPreview);
        });
        document.getElementById('btn-apply-char')?.addEventListener('click', () => {
            const font = document.getElementById('dialog-char-font')?.value || 'Liberation Sans';
            const st = document.getElementById('dialog-char-style')?.value || 'normal';
            const sz = document.getElementById('dialog-char-size')?.value || '11pt';
            const isUnder = !!document.getElementById('dialog-char-underline')?.checked;
            const isStrike = !!document.getElementById('dialog-char-strike')?.checked;
            const color = document.getElementById('dialog-char-color')?.value || '#000000';
            const pos = document.querySelector('input[name="dialog-char-pos"]:checked')?.value || 'normal';

            restoreSavedEditorRange();
            const selFont = document.getElementById('select-font');
            const selSize = document.getElementById('select-fontsize');
            if (selFont) { selFont.value = font; selFont.dispatchEvent(new Event('change')); }
            if (selSize) { selSize.value = sz; selSize.dispatchEvent(new Event('change')); }
            try {
                if (st.includes('bold')) editor.execCommand('bold');
                if (st.includes('italic')) editor.execCommand('italic');
                if (isUnder) editor.execCommand('underline');
                if (isStrike) editor.execCommand('strikethrough');
                if (color && color !== '#000000') editor.execCommand('foreColor', false, color);
                if (pos === 'superscript') editor.execCommand('superscript');
                if (pos === 'subscript') editor.execCommand('subscript');
            } catch (_) {}
            recordWriterAction('modal_char', { font, st, sz, isUnder, isStrike, color, pos });
            const modalEl = document.getElementById('modal-char');
            if (modalEl && window.bootstrap) bootstrap.Modal.getInstance(modalEl)?.hide();
        });

        // 2. Диалог «Вставить таблицу...»
        const openTableDialog = (e) => {
            if (e) e.preventDefault();
            saveCurrentEditorRange();
            const modalEl = document.getElementById('modal-table');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('btn-table')?.addEventListener('click', openTableDialog);
        document.getElementById('menu-insert-table')?.addEventListener('click', openTableDialog);
        document.getElementById('menu-table-insert')?.addEventListener('click', openTableDialog);

        document.getElementById('btn-apply-table')?.addEventListener('click', () => {
            const cols = parseInt(document.getElementById('dialog-table-cols')?.value || '3', 10);
            const rows = parseInt(document.getElementById('dialog-table-rows')?.value || '3', 10);
            const hasHeader = document.getElementById('dialog-table-has-header')?.checked ?? true;
            
            let html = '<table style="width: 100%; border-collapse: collapse; margin: 12px 0;">';
            if (hasHeader && rows >= 1) {
                html += '<thead><tr>';
                for (let c = 1; c <= cols; c++) {
                    html += `<th style="border: 1px solid #000; padding: 6px; text-align: center; font-weight: bold; background: #fafafa;">Заголовок ${c}</th>`;
                }
                html += '</tr></thead><tbody>';
                for (let r = 1; r <= rows - 1; r++) {
                    html += '<tr>';
                    for (let c = 1; c <= cols; c++) {
                        html += `<td style="border: 1px solid #000; padding: 6px; text-align: left;">Ячейка ${r},${c}</td>`;
                    }
                    html += '</tr>';
                }
                html += '</tbody>';
            } else {
                html += '<tbody>';
                for (let r = 1; r <= rows; r++) {
                    html += '<tr>';
                    for (let c = 1; c <= cols; c++) {
                        html += `<td style="border: 1px solid #000; padding: 6px; text-align: left;">Ячейка ${r},${c}</td>`;
                    }
                    html += '</tr>';
                }
                html += '</tbody>';
            }
            html += '</table>';

            const modalEl = document.getElementById('modal-table');
            if (modalEl && window.bootstrap) bootstrap.Modal.getInstance(modalEl)?.hide();

            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            if (wysiwyg) {
                // Удаляем пустые параграфы-заглушки (<p><br></p>) перед вставкой блочной таблицы, чтобы таблица вставлялась чистым блочным соседом <p>
                Array.from(wysiwyg.querySelectorAll('p')).forEach(p => {
                    const pText = (p.textContent || '').replace(/[\uFEFF\u200B\u200C\u200D]/g, '').trim();
                    const pInner = (p.innerHTML || '').replace(/[\uFEFF\u200B\u200C\u200D]/g, '').trim();
                    if (pText === '' && (pInner === '' || pInner === '<br>' || pInner === '&nbsp;') && !p.querySelector('table, img')) {
                        p.remove();
                    }
                });
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                const tblNode = tempDiv.firstElementChild;
                if (tblNode) {
                    wysiwyg.appendChild(tblNode);
                    lastActiveTable = tblNode;
                }
            } else {
                editor.selection.insertHTML(html);
            }
            recordWriterAction('insert_table', { cols, rows });
            updateStatusbarWords();
            emitWriterChange();
        });

        // 3. Диалог «Свойства таблицы...»
        const openTablePropsDialog = (e) => {
            if (e) e.preventDefault();
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            const sel = editor.selection ? editor.selection.current() : null;
            if (sel) {
                lastActiveTable = sel.closest ? sel.closest('table') : (sel.parentElement ? sel.parentElement.closest('table') : null);
            }
            if (!lastActiveTable && wysiwyg) {
                lastActiveTable = wysiwyg.querySelector('table');
            }
            const modalEl = document.getElementById('modal-table-props');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('menu-table-props')?.addEventListener('click', openTablePropsDialog);
        document.getElementById('menu-table-properties')?.addEventListener('click', openTablePropsDialog);
        document.getElementById('btn-tbl-props')?.addEventListener('click', openTablePropsDialog);
        document.getElementById('ctx-tbl-props')?.addEventListener('click', (e) => {
            const ctx = document.getElementById('lo-context-menu');
            if (ctx) ctx.style.display = 'none';
            openTablePropsDialog(e);
        });

        document.getElementById('btn-apply-table-props')?.addEventListener('click', () => {
            const align = document.getElementById('dialog-table-align')?.value || 'center';
            const headerAlign = document.getElementById('dialog-table-header-align')?.value || 'center';
            const fontSize = document.getElementById('dialog-table-font-size')?.value || '14pt';
            const headerBold = document.getElementById('dialog-table-header-bold')?.checked ?? true;
            const valign = document.getElementById('dialog-table-valign')?.value || 'middle';
            const widthPct = parseFloat(document.getElementById('dialog-table-width')?.value || '85');
            const spaceTopPt = parseFloat(document.getElementById('dialog-table-space-top')?.value || '12');
            const spaceBottomPt = parseFloat(document.getElementById('dialog-table-space-bottom')?.value || '12');

            applyTableProps({
                align,
                headerAlign,
                fontSize,
                headerBold,
                valign,
                widthPct,
                spaceTopPt,
                spaceBottomPt
            });
            recordWriterAction('modal_table_props', { align, headerAlign, fontSize, headerBold, valign, widthPct });

            const modalEl = document.getElementById('modal-table-props');
            if (modalEl && window.bootstrap) bootstrap.Modal.getInstance(modalEl)?.hide();
        });

        // 4. Диалог «Параметры страницы...»
        const parseFieldCm = (id, defVal) => {
            const n = parseFloat(normalizeDecimalStr(document.getElementById(id)?.value, String(defVal)));
            return Number.isFinite(n) ? n : defVal;
        };
        const updatePagePreview = () => {
            const inner = document.getElementById('lo-page-preview-inner');
            if (!inner) return;
            const l = parseFieldCm('dialog-page-left', 2) * 4;
            const r = parseFieldCm('dialog-page-right', 2) * 4;
            const t = parseFieldCm('dialog-page-top', 2) * 4;
            const b = parseFieldCm('dialog-page-bottom', 2) * 4;
            inner.style.left = `${Math.max(2, l)}px`;
            inner.style.right = `${Math.max(2, r)}px`;
            inner.style.top = `${Math.max(2, t)}px`;
            inner.style.bottom = `${Math.max(2, b)}px`;
        };
        ['dialog-page-left', 'dialog-page-right', 'dialog-page-top', 'dialog-page-bottom'].forEach(id => {
            document.getElementById(id)?.addEventListener('input', updatePagePreview);
        });
        const openPageDialog = (e) => {
            if (e) e.preventDefault();
            const leftInp = document.getElementById('dialog-page-left');
            const rightInp = document.getElementById('dialog-page-right');
            const topInp = document.getElementById('dialog-page-top');
            const bottomInp = document.getElementById('dialog-page-bottom');
            if (leftInp) leftInp.value = pageMargins.leftCm;
            if (rightInp) rightInp.value = pageMargins.rightCm;
            if (topInp) topInp.value = pageMargins.topCm;
            if (bottomInp) bottomInp.value = pageMargins.bottomCm;
            updatePagePreview();

            const modalEl = document.getElementById('modal-page');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('menu-format-page')?.addEventListener('click', openPageDialog);

        document.getElementById('btn-page-set-oge')?.addEventListener('click', () => {
            const leftInp = document.getElementById('dialog-page-left');
            const rightInp = document.getElementById('dialog-page-right');
            const topInp = document.getElementById('dialog-page-top');
            const bottomInp = document.getElementById('dialog-page-bottom');
            if (leftInp) leftInp.value = '2.0';
            if (rightInp) rightInp.value = '2.0';
            if (topInp) topInp.value = '2.0';
            if (bottomInp) bottomInp.value = '2.0';
            updatePagePreview();
        });

        document.getElementById('btn-apply-page')?.addEventListener('click', () => {
            const left = parseFieldCm('dialog-page-left', 1.0);
            const right = parseFieldCm('dialog-page-right', 1.0);
            const top = parseFieldCm('dialog-page-top', 1.0);
            const bottom = parseFieldCm('dialog-page-bottom', 1.0);

            applyPageMargins({
                leftCm: left,
                rightCm: right,
                topCm: top,
                bottomCm: bottom
            });
            recordWriterAction('modal_page_margins', { left, right, top, bottom });

            const modalEl = document.getElementById('modal-page');
            if (modalEl && window.bootstrap) bootstrap.Modal.getInstance(modalEl)?.hide();
        });

        // 5. Диалог «Выбор символа» (с фильтрацией и Unicode-инспектором)
        const openSymbolsDialog = (e) => {
            if (e) e.preventDefault();
            saveCurrentEditorRange();
            const modalEl = document.getElementById('modal-symbols');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('btn-symbol')?.addEventListener('click', openSymbolsDialog);
        document.getElementById('menu-insert-symbols')?.addEventListener('click', openSymbolsDialog);

        const filterSymbols = () => {
            const cat = document.getElementById('dialog-symbol-block')?.value || 'all';
            const q = (document.getElementById('dialog-symbol-search')?.value || '').trim().toLowerCase();
            document.querySelectorAll('.lo-sym-btn').forEach(btn => {
                const bCat = btn.getAttribute('data-cat') || '';
                const bName = (btn.getAttribute('data-name') || btn.getAttribute('title') || '').toLowerCase();
                const matchCat = cat === 'all' || bCat === cat;
                const matchQ = !q || bName.includes(q) || (btn.getAttribute('data-sym') || '').toLowerCase().includes(q);
                btn.style.display = (matchCat && matchQ) ? 'inline-flex' : 'none';
            });
        };
        document.getElementById('dialog-symbol-block')?.addEventListener('change', filterSymbols);
        document.getElementById('dialog-symbol-search')?.addEventListener('input', filterSymbols);

        document.querySelectorAll('.lo-sym-btn').forEach(btn => {
            btn.addEventListener('mouseenter', () => {
                const sym = btn.getAttribute('data-sym') || '';
                const name = btn.getAttribute('data-name') || btn.getAttribute('title') || '';
                const code = sym ? sym.charCodeAt(0) : 0;
                const hex = 'U+' + code.toString(16).toUpperCase().padStart(4, '0');
                const gEl = document.getElementById('sym-preview-glyph');
                const nEl = document.getElementById('sym-preview-name');
                const hEl = document.getElementById('sym-preview-hex');
                const dEl = document.getElementById('sym-preview-dec');
                if (gEl) gEl.innerText = sym;
                if (nEl) nEl.innerText = name;
                if (hEl) hEl.innerText = hex;
                if (dEl) dEl.innerText = String(code);
            });
            btn.addEventListener('click', () => {
                const sym = btn.getAttribute('data-sym');
                const modalEl = document.getElementById('modal-symbols');
                if (modalEl && window.bootstrap) bootstrap.Modal.getInstance(modalEl)?.hide();
                if (sym) {
                    const wysiwyg = document.querySelector('.jodit-wysiwyg');
                    if (wysiwyg) {
                        wysiwyg.focus();
                        const sel = window.getSelection();
                        let range = null;
                        if (lastSavedRange && wysiwyg.contains(lastSavedRange.commonAncestorContainer)) {
                            range = lastSavedRange.cloneRange();
                        } else {
                            const lastBlock = wysiwyg.querySelector('p:last-of-type, li:last-of-type, td:last-of-type, th:last-of-type') || wysiwyg;
                            range = document.createRange();
                            range.selectNodeContents(lastBlock);
                            range.collapse(false);
                        }
                        if (range && sel) {
                            const containerEl = range.startContainer.nodeType === 1 ? range.startContainer : range.startContainer.parentElement;
                            if (containerEl && containerEl.tagName === 'P' && containerEl.innerHTML.trim() === '<br>') {
                                containerEl.innerHTML = '';
                                range.selectNodeContents(containerEl);
                                range.collapse(false);
                            }
                            range.deleteContents();
                            const textNode = document.createTextNode(sym);
                            range.insertNode(textNode);
                            range.setStartAfter(textNode);
                            range.setEndAfter(textNode);
                            sel.removeAllRanges();
                            sel.addRange(range);
                            lastSavedRange = range.cloneRange();
                        }
                    }
                    recordWriterAction('insert_symbol', { sym });
                    updateStatusbarWords();
                    emitWriterChange();
                }
            });
        });

        // 5.5 Диалог «Найти и заменить» (#modal-find-replace)
        document.getElementById('btn-apply-replace-all')?.addEventListener('click', () => {
            const q = document.getElementById('dialog-find-query')?.value || '';
            const rep = document.getElementById('dialog-find-replace-val')?.value || '';
            const msgEl = document.getElementById('dialog-find-msg');
            if (!q) return;
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            if (wysiwyg) {
                const walker = document.createTreeWalker(wysiwyg, NodeFilter.SHOW_TEXT);
                let count = 0;
                let node;
                while ((node = walker.nextNode())) {
                    if (node.textContent && node.textContent.includes(q)) {
                        const parts = node.textContent.split(q);
                        count += parts.length - 1;
                        node.textContent = parts.join(rep);
                    }
                }
                if (msgEl) msgEl.innerText = `Выполнено замен: ${count}`;
                recordWriterAction('find_replace', { q, rep, count });
                updateStatusbarWords();
                emitWriterChange();
            }
        });

        // 6. Диалог «Протокол проверки ОГЭ 13.2»
        const openOgeReportDialog = (e) => {
            if (e) e.preventDefault();
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            const report = inspectOgeDocument(wysiwyg, pageMargins);
            lastOgeReport = report;
            renderOgeReportModal(report);
            const modalEl = document.getElementById('modal-oge-report');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('menu-tools-oge-check')?.addEventListener('click', openOgeReportDialog);
        document.getElementById('btn-show-report')?.addEventListener('click', openOgeReportDialog);
    }

    // Зум (масштабирование страницы)
    function initZoom() {
        const slider = document.getElementById('zoom-slider');
        const valText = document.getElementById('zoom-val');
        const applyZoom = (val) => {
            valText.innerText = `${val}%`;
            const scale = val / 100;
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            if (wysiwyg) {
                wysiwyg.style.transform = `scale(${scale})`;
                wysiwyg.style.transformOrigin = 'top center';
            }
        };
        slider?.addEventListener('input', (e) => applyZoom(e.target.value));
        document.getElementById('zoom-in')?.addEventListener('click', () => {
            let v = Math.min(150, parseInt(slider.value, 10) + 10);
            slider.value = v;
            applyZoom(v);
        });
        document.getElementById('zoom-out')?.addEventListener('click', () => {
            let v = Math.max(50, parseInt(slider.value, 10) - 10);
            slider.value = v;
            applyZoom(v);
        });
    }

    // Экспорт вспомогательных функций на window для тестов и интеграций
    window.inspectOgeDocument = inspectOgeDocument;
    window.applyPageMargins = applyPageMargins;
    window.applyParagraphStyle = applyParagraphStyle;
    window.applyTableProps = applyTableProps;
    window.getWriterState = getWriterState;
    window.setWriterOgeCheck = (val) => { dynamicCheckOgeFormat = !!val; };
    window.resetWriterState = (initialHtml = '<p><br></p>', resetLog = false, resetMargins = false) => {
        lastActivePara = null;
        lastActiveTable = null;
        lastSavedRange = null;
        if (editor) {
            editor.value = initialHtml;
        }
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        if (wysiwyg) {
            wysiwyg.innerHTML = initialHtml;
            wysiwyg.style.fontFamily = '';
            wysiwyg.style.fontSize = '';
        }
        const selFont = document.getElementById('select-font');
        const selSize = document.getElementById('select-fontsize');
        const selStyle = document.getElementById('select-style');
        if (selFont) selFont.value = 'Liberation Sans';
        if (selSize) selSize.value = '11pt';
        if (selStyle) selStyle.value = 'p';
        Object.keys(pendingInlineStates).forEach(k => { pendingInlineStates[k] = false; });
        ['btn-bold', 'btn-italic', 'btn-underline', 'btn-strikethrough', 'btn-sup', 'btn-sub', 'btn-align-center', 'btn-align-right', 'btn-align-justify', 'btn-ul', 'btn-ol'].forEach(id => toggleBtnActive(id, false));
        toggleBtnActive('btn-align-left', true);
        updateRulerFirstLineMarker(0);
        if (resetLog) {
            writerActionLog.length = 0;
        }
        if (resetMargins) {
            applyPageMargins({ leftCm: 1.0, rightCm: 1.0, topCm: 1.0, bottomCm: 1.0 });
        }
        updateStatusbarWords();
        emitWriterChange();
    };

    // Валидация решения (кнопка ПРОВЕРИТЬ ДОКУМЕНТ)
    document.getElementById('check-btn').addEventListener('click', () => {
        if (!editor) return;
        attempts++;
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        const content = (wysiwyg && wysiwyg.innerHTML) ? wysiwyg.innerHTML : editor.value;
        const statusEl = document.getElementById('writer-status');
        const reportBtn = document.getElementById('btn-show-report');

        // ЯДЕРНАЯ ФИЧА: Автоматическая экспертная проверка документа и детектор костылей ОГЭ 13.2
        const report = inspectOgeDocument(wysiwyg, pageMargins);
        lastOgeReport = report;

        if (dynamicCheckOgeFormat && (!report.valid || report.crutchesFound)) {
            if (statusEl) {
                statusEl.className = 'text-danger fw-bold px-2';
                statusEl.innerText = `❌ Ошибка ОГЭ 13.2 (${report.score}/2 баллов): несоответствие стандарту!`;
            }
            if (reportBtn) {
                reportBtn.style.display = 'inline-block';
            }
            renderOgeReportModal(report);
            const modalEl = document.getElementById('modal-oge-report');
            if (modalEl && window.bootstrap) {
                new bootstrap.Modal(modalEl).show();
            }
            sendTelemetry('hardcore_reset', 'in_progress', false);
            if (hardcoreReset) {
                editor.value = '';
            }
            document.dispatchEvent(new CustomEvent('writer-error', { detail: { report } }));
            return; // БЛОКИРУЕМ прохождение задания, пока оформление не приведено в норму
        } else if (dynamicCheckOgeFormat) {
            if (reportBtn) {
                reportBtn.style.display = 'inline-block';
            }
            renderOgeReportModal(report);
        }
        
        // Если оформление не содержит костылей (и соответствует ОГЭ при включенном флаге), переходим к проверке условий волны/урока
        const event = new CustomEvent('writer-check', { 
            detail: { 
                html: content,
                text: wysiwyg ? (wysiwyg.innerText || '') : '',
                wysiwyg: wysiwyg,
                pageMargins: { ...pageMargins },
                actionLog: writerActionLog.slice(),
                ogeReport: report,
                resolve: (success, msg, isFinal = true) => {
                    if (success) {
                        statusEl.className = 'text-success fw-bold px-2';
                        statusEl.innerText = msg || '✅ Проверено. Задание выполнено!';
                        if (isFinal) {
                            sendTelemetry('level_complete', 'completed', true);
                        }
                    } else {
                        statusEl.className = 'text-danger fw-bold px-2';
                        statusEl.innerText = msg || '❌ Ошибка форматирования!';
                        sendTelemetry('hardcore_reset', 'in_progress', false);
                        if (hardcoreReset) {
                            editor.value = ''; 
                        }
                    }
                },
                editor: editor
            }
        });
        
        document.dispatchEvent(event);
    });
</script>
