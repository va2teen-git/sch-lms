---
export interface Props {
  missionName: string;
  initialHTML?: string;
  hardcoreReset?: boolean;
  checkOgeFormat?: boolean;
  disableAutoTelemetry?: boolean;
}

const { 
  missionName, 
  initialHTML = '<p></p>', 
  hardcoreReset = false,
  checkOgeFormat = true,
  disableAutoTelemetry = false
} = Astro.props;
---
<div id="lo-root-window" class="d-flex flex-column h-100 lo-window-shell user-select-none-header">
    <!-- Плавающая кнопка выхода из полноэкранного режима (как в LibreOffice) -->
    <button type="button" id="lo-fullscreen-exit-btn" class="lo-fullscreen-pill d-none" title="Выйти из полноэкранного режима (Esc / F11)">
        <span class="lo-icon" style="background-image: url('/static/colibre/fullscreen.svg'); width:14px; height:14px;"></span>
        <span>Во весь экран</span>
    </button>

    <!-- 0. Оконная шапка LibreOffice Writer 26.8 -->
    <div id="lo-titlebar" class="d-flex justify-content-between align-items-center px-2 py-1 lo-titlebar">
        <div class="d-flex align-items-center gap-2 overflow-hidden">
            <img src="/static/colibre/writer_app.svg" alt="" width="18" height="18" class="flex-shrink-0" />
            <span class="fw-semibold text-truncate" id="lo-doc-title">Без имени 1 — LibreOffice Writer</span>
        </div>
        <div class="d-flex align-items-center gap-2 flex-shrink-0">
            <button id="check-btn" class="btn btn-outline-success btn-sm rounded-0 fw-bold px-3 py-0" style="font-size: 12px; height: 24px;">ПРОВЕРИТЬ ДОКУМЕНТ</button>
            <div class="lo-win-controls d-flex align-items-center">
                <button type="button" class="lo-win-btn lo-disabled-hint" data-lo-hint="Сворачивание окна недоступно в браузере" title="Свернуть">—</button>
                <button type="button" id="btn-window-fullscreen" class="lo-win-btn" title="Развернуть на весь экран (F11)">□</button>
                <button type="button" class="lo-win-btn lo-win-close lo-disabled-hint" data-lo-hint="Закрытие вкладки отключено" title="Закрыть">×</button>
            </div>
        </div>
    </div>
    
    <div class="flex-grow-1 bg-light text-dark rounded-0 overflow-hidden d-flex flex-column border border-secondary position-relative" id="editor-container" style="background-color: #f3f3f3 !important;">
        
        <!-- 1. Главное меню LibreOffice 26.8 (все 11 пунктов из menubar.xml) -->
        <div class="d-flex px-1 user-select-none lo-menu-bar border-bottom flex-wrap" id="lo-menubar">
            <!-- 1. ФАЙЛ -->
            <div class="dropdown">
                <div class="px-2 py-1 lo-menu-item" data-bs-toggle="dropdown" aria-expanded="false">Файл</div>
                <ul class="dropdown-menu rounded-0 shadow-sm lo-dropdown-menu">
                    <li><a class="dropdown-item" href="#" id="menu-file-new"><span class="lo-micon" style="background-image:url('/static/colibre/new.svg')"></span><span class="lo-mlabel">Создать</span><span class="lo-mkey">Ctrl+N</span></a></li>
                    <li><a class="dropdown-item" href="#" id="menu-file-open"><span class="lo-micon" style="background-image:url('/static/colibre/open.svg')"></span><span class="lo-mlabel">Открыть…</span><span class="lo-mkey">Ctrl+O</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Удалённое хранилище не используется на ОГЭ"><span class="lo-micon"></span><span class="lo-mlabel">Открыть удалённо…</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Недавние документы недоступны в тренажёре"><span class="lo-micon"></span><span class="lo-mlabel">Недавние документы</span><span class="lo-mkey">▸</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Закрытие документа отключено"><span class="lo-micon" style="background-image:url('/static/colibre/close.svg')"></span><span class="lo-mlabel">Закрыть</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item" href="#" id="menu-file-sample"><span class="lo-micon" style="background-image:url('/static/colibre/odt_app.svg')"></span><span class="lo-mlabel">Загрузить пример текста (ОГЭ 13.2)</span></a></li>
                    <li><a class="dropdown-item text-danger" href="#" id="menu-file-reset-raw"><span class="lo-micon" style="background-image:url('/static/colibre/eraser.svg')"></span><span class="lo-mlabel">Сбросить всё (Режим по умолчанию)</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Мастера писем/факсов не требуются на ОГЭ"><span class="lo-micon"></span><span class="lo-mlabel">Мастер</span><span class="lo-mkey">▸</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Шаблоны не используются"><span class="lo-micon"></span><span class="lo-mlabel">Шаблоны</span><span class="lo-mkey">▸</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Сравнение документов не требуется на ОГЭ"><span class="lo-micon"></span><span class="lo-mlabel">Сравнить документ…</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item" href="#" id="menu-file-save"><span class="lo-micon" style="background-image:url('/static/colibre/save.svg')"></span><span class="lo-mlabel">Сохранить</span><span class="lo-mkey">Ctrl+S</span></a></li>
                    <li><a class="dropdown-item" href="#" id="menu-file-saveas"><span class="lo-micon" style="background-image:url('/static/colibre/saveas.svg')"></span><span class="lo-mlabel">Сохранить как…</span><span class="lo-mkey">Ctrl+Shift+S</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Удалённое сохранение недоступно"><span class="lo-micon"></span><span class="lo-mlabel">Сохранить удалённо…</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Сохранение копии недоступно"><span class="lo-micon"></span><span class="lo-mlabel">Сохранить копию…</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item" href="#" id="menu-file-pdf"><span class="lo-micon" style="background-image:url('/static/colibre/pdf.svg')"></span><span class="lo-mlabel">Экспорт в PDF…</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Отправка почтой не требуется"><span class="lo-micon"></span><span class="lo-mlabel">Отправить</span><span class="lo-mkey">▸</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item" href="#" id="menu-file-printpreview"><span class="lo-micon" style="background-image:url('/static/colibre/printpreview.svg')"></span><span class="lo-mlabel">Просмотр печати</span><span class="lo-mkey">Ctrl+Shift+O</span></a></li>
                    <li><a class="dropdown-item" href="#" id="menu-file-print"><span class="lo-micon" style="background-image:url('/static/colibre/print.svg')"></span><span class="lo-mlabel">Печать…</span><span class="lo-mkey">Ctrl+P</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Свойства файла не требуются на ОГЭ"><span class="lo-micon" style="background-image:url('/static/colibre/properties.svg')"></span><span class="lo-mlabel">Свойства…</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Цифровые подписи не используются"><span class="lo-micon"></span><span class="lo-mlabel">Цифровые подписи</span><span class="lo-mkey">▸</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Выход из приложения отключён"><span class="lo-micon"></span><span class="lo-mlabel">Выход</span><span class="lo-mkey">Ctrl+Q</span></a></li>
                </ul>
            </div>

            <!-- 2. ПРАВКА -->
            <div class="dropdown">
                <div class="px-2 py-1 lo-menu-item" data-bs-toggle="dropdown" aria-expanded="false">Правка</div>
                <ul class="dropdown-menu rounded-0 shadow-sm lo-dropdown-menu">
                    <li><a class="dropdown-item" href="#" id="menu-edit-undo"><span class="lo-micon" style="background-image:url('/static/colibre/undo.svg')"></span><span class="lo-mlabel">Отменить</span><span class="lo-mkey">Ctrl+Z</span></a></li>
                    <li><a class="dropdown-item" href="#" id="menu-edit-redo"><span class="lo-micon" style="background-image:url('/static/colibre/redo.svg')"></span><span class="lo-mlabel">Вернуть</span><span class="lo-mkey">Ctrl+Y</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Повтор последнего действия недоступен"><span class="lo-micon"></span><span class="lo-mlabel">Повторить</span><span class="lo-mkey">Ctrl+Shift+Y</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item" href="#" id="menu-edit-cut"><span class="lo-micon" style="background-image:url('/static/colibre/cut.svg')"></span><span class="lo-mlabel">Вырезать</span><span class="lo-mkey">Ctrl+X</span></a></li>
                    <li><a class="dropdown-item" href="#" id="menu-edit-copy"><span class="lo-micon" style="background-image:url('/static/colibre/copy.svg')"></span><span class="lo-mlabel">Копировать</span><span class="lo-mkey">Ctrl+C</span></a></li>
                    <li><a class="dropdown-item" href="#" id="menu-edit-paste"><span class="lo-micon" style="background-image:url('/static/colibre/paste.svg')"></span><span class="lo-mlabel">Вставить</span><span class="lo-mkey">Ctrl+V</span></a></li>
                    <li><a class="dropdown-item" href="#" id="menu-edit-paste-unformatted"><span class="lo-micon" style="background-image:url('/static/colibre/pastespecial.svg')"></span><span class="lo-mlabel">Вставить как неформатированный текст</span><span class="lo-mkey">Ctrl+Alt+Shift+V</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item" href="#" id="menu-edit-selectall"><span class="lo-micon" style="background-image:url('/static/colibre/selectall.svg')"></span><span class="lo-mlabel">Выбрать всё</span><span class="lo-mkey">Ctrl+A</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Режим блочного выделения не требуется на ОГЭ"><span class="lo-micon"></span><span class="lo-mlabel">Режим выбора</span><span class="lo-mkey">▸</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item" href="#" id="menu-edit-findbar"><span class="lo-micon"></span><span class="lo-mlabel">Найти…</span><span class="lo-mkey">Ctrl+F</span></a></li>
                    <li><a class="dropdown-item" href="#" id="menu-edit-find"><span class="lo-micon" style="background-image:url('/static/colibre/find.svg')"></span><span class="lo-mlabel">Найти и заменить…</span><span class="lo-mkey">Ctrl+H</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Переход к странице недоступен"><span class="lo-micon"></span><span class="lo-mlabel">Перейти к странице…</span><span class="lo-mkey">Ctrl+G</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Отслеживание исправлений не используется на ОГЭ"><span class="lo-micon" style="background-image:url('/static/colibre/trackchanges.svg')"></span><span class="lo-mlabel">Отслеживать исправления</span><span class="lo-mkey">▸</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Комментарии не требуются на ОГЭ"><span class="lo-micon" style="background-image:url('/static/colibre/comment.svg')"></span><span class="lo-mlabel">Комментарий</span><span class="lo-mkey">▸</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Внешние связи и поля не требуются"><span class="lo-micon"></span><span class="lo-mlabel">Внешние связи…</span></a></li>
                </ul>
            </div>

            <!-- 3. ВИД -->
            <div class="dropdown">
                <div class="px-2 py-1 lo-menu-item" data-bs-toggle="dropdown" aria-expanded="false">Вид</div>
                <ul class="dropdown-menu rounded-0 shadow-sm lo-dropdown-menu">
                    <li><a class="dropdown-item lo-menu-checked" href="#" id="menu-view-normal"><span class="lo-micon">✓</span><span class="lo-mlabel">Обычный</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Режим веб-страницы не используется на ОГЭ"><span class="lo-micon"></span><span class="lo-mlabel">Веб-страница</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Выбор пользовательского интерфейса зафиксирован (Стандартные панели)"><span class="lo-micon"></span><span class="lo-mlabel">Пользовательский интерфейс…</span></a></li>
                    <li><a class="dropdown-item" href="#" id="menu-view-toggle-tablebar"><span class="lo-micon" id="tablebar-check-mark"></span><span class="lo-mlabel">Панель инструментов: Таблица</span></a></li>
                    <li><a class="dropdown-item lo-menu-checked" href="#" id="menu-view-statusbar"><span class="lo-micon" id="statusbar-check-mark">✓</span><span class="lo-mlabel">Строка состояния</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item" href="#" id="menu-view-ruler"><span class="lo-micon" id="ruler-check-mark">✓</span><span class="lo-mlabel">Линейки</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Сетка не используется в текстовых заданиях"><span class="lo-micon"></span><span class="lo-mlabel">Сетки и вспомогательные линии</span><span class="lo-mkey">▸</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item" href="#" id="menu-view-nonprinting"><span class="lo-micon" style="background-image:url('/static/colibre/nonprinting.svg')"></span><span class="lo-mlabel">Непечатаемые символы</span><span class="lo-mkey">Ctrl+F10</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Затенение полей недоступно"><span class="lo-micon"></span><span class="lo-mlabel">Затенение полей</span><span class="lo-mkey">Ctrl+F8</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item" href="#" id="menu-view-sidebar"><span class="lo-micon" style="background-image:url('/static/colibre/sidebar.svg')"></span><span class="lo-mlabel">Боковая панель</span><span class="lo-mkey">Ctrl+F5</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Галерея не требуется на ОГЭ"><span class="lo-micon" style="background-image:url('/static/colibre/gallery.svg')"></span><span class="lo-mlabel">Галерея</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Навигатор не требуется на ОГЭ"><span class="lo-micon" style="background-image:url('/static/colibre/navigator.svg')"></span><span class="lo-mlabel">Навигатор</span><span class="lo-mkey">F5</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item" href="#" id="menu-view-fullscreen"><span class="lo-micon" style="background-image:url('/static/colibre/fullscreen.svg')"></span><span class="lo-mlabel">Во весь экран</span><span class="lo-mkey">Ctrl+Shift+J</span></a></li>
                    <li><a class="dropdown-item" href="#" id="menu-view-zoom-100"><span class="lo-micon" style="background-image:url('/static/colibre/zoom.svg')"></span><span class="lo-mlabel">Масштаб 100%</span></a></li>
                </ul>
            </div>

            <!-- 4. ВСТАВКА -->
            <div class="dropdown">
                <div class="px-2 py-1 lo-menu-item" data-bs-toggle="dropdown" aria-expanded="false">Вставка</div>
                <ul class="dropdown-menu rounded-0 shadow-sm lo-dropdown-menu">
                    <li><a class="dropdown-item" href="#" id="menu-insert-pagebreak"><span class="lo-micon" style="background-image:url('/static/colibre/pagebreak.svg')"></span><span class="lo-mlabel">Разрыв страницы</span><span class="lo-mkey">Ctrl+Enter</span></a></li>
                    <li><a class="dropdown-item" href="#" id="menu-insert-hr"><span class="lo-micon" style="background-image:url('/static/colibre/hr.svg')"></span><span class="lo-mlabel">Горизонтальная линия</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item" href="#" id="menu-insert-table"><span class="lo-micon" style="background-image:url('/static/colibre/table.svg')"></span><span class="lo-mlabel">Таблица…</span><span class="lo-mkey">Ctrl+F12</span></a></li>
                    <li><a class="dropdown-item" href="#" id="menu-insert-image"><span class="lo-micon" style="background-image:url('/static/colibre/image.svg')"></span><span class="lo-mlabel">Изображение…</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Диаграммы не используются в задании ОГЭ 13.2"><span class="lo-micon" style="background-image:url('/static/colibre/chart.svg')"></span><span class="lo-mlabel">Диаграмма…</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Медиаобъекты не используются в ОГЭ"><span class="lo-micon"></span><span class="lo-mlabel">Медиа</span><span class="lo-mkey">▸</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Объекты OLE не используются"><span class="lo-micon"></span><span class="lo-mlabel">Объект OLE</span><span class="lo-mkey">▸</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Фигуры не требуются в ОГЭ 13.2"><span class="lo-micon" style="background-image:url('/static/colibre/shapes.svg')"></span><span class="lo-mlabel">Фигуры</span><span class="lo-mkey">▸</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Текстовое поле не используется"><span class="lo-micon" style="background-image:url('/static/colibre/textbox.svg')"></span><span class="lo-mlabel">Текстовое поле</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Комментарии не требуются"><span class="lo-micon" style="background-image:url('/static/colibre/comment.svg')"></span><span class="lo-mlabel">Комментарий</span><span class="lo-mkey">Ctrl+Alt+C</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Гиперссылки не требуются в ОГЭ 13.2"><span class="lo-micon" style="background-image:url('/static/colibre/link.svg')"></span><span class="lo-mlabel">Гиперссылка…</span><span class="lo-mkey">Ctrl+K</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Закладки не используются"><span class="lo-micon" style="background-image:url('/static/colibre/bookmark.svg')"></span><span class="lo-mlabel">Закладка…</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item fw-semibold" href="#" id="menu-insert-symbols"><span class="lo-micon" style="background-image:url('/static/colibre/symbol.svg')"></span><span class="lo-mlabel">Специальные символы…</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Непечатаемые знаки форматирования вставляются стандартно"><span class="lo-micon"></span><span class="lo-mlabel">Знак форматирования</span><span class="lo-mkey">▸</span></a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Сноски не требуются в ОГЭ 13.2"><span class="lo-micon" style="background-image:url('/static/colibre/footnote.svg')"></span><span class="lo-mlabel">Сноска</span><span class="lo-mkey">▸</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Оглавление не требуется"><span class="lo-micon"></span><span class="lo-mlabel">Оглавление и указатели</span><span class="lo-mkey">▸</span></a></li>
                    <li><a class="dropdown-item lo-menu-disabled" href="#" data-lo-hint="Колонтитулы не требуются в ОГЭ 13.2"><span class="lo-micon"></span><span class="lo-mlabel">Колонтитулы</span><span class="lo-mkey">▸</span></a></li>
                </ul>
            </div>

            <!-- 5. ФОРМАТ -->
            <div class="dropdown">
                <div class="px-2 py-1 lo-menu-item" data-bs-toggle="dropdown" aria-expanded="false">Формат</div>
                <ul class="dropdown-menu rounded-0 shadow-sm lo-dropdown-menu">
                    <li><h6 class="dropdown-header py-0 text-muted" style="font-size: 11px;">Текст</h6></li>
                    <li><a class="dropdown-item" href="#" id="menu-format-bold"><span class="lo-micon" style="background-image:url('/static/colibre/bold_ru.svg')"></span><span class="lo-mlabel"><b>Полужирный</b></span><span class="lo-mkey">Ctrl+B</span></a></li>
                    <li><a class="dropdown-item" href="#" id="menu-format-italic"><span class="lo-micon" style="background-image:url('/static/colibre/italic_ru.svg')"></span><span class="lo-mlabel"><i>Курсив</i></span><span class="lo-mkey">Ctrl+I</span></a></li>
                    <li><a class="dropdown-item" href="#" id="menu-format-underline"><span class="lo-micon" style="background-image:url('/static/colibre/underline_ru.svg')"></span><span class="lo-mlabel"><u>Подчёркнутый</u></span><span class="lo-mkey">Ctrl+U</span></a></li>
