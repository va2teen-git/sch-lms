                                <span class="text-muted">Формат:</span><span>A4 (21×29,7 см)</span>
                            </div>
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 rounded-0 w-100" id="sb-open-page" style="font-size:11px;">Настроить поля страницы…</button>
                        </div>
                    </div>
                </div>
                <div id="lo-sidebar-tabs" class="d-flex flex-column align-items-center py-1 gap-1" style="width: 28px; background: #ebebeb;">
                    <button type="button" class="lo-sb-tab" id="sb-tab-props" data-sb-panel="Свойства" title="Свойства (Ctrl+F5)"><span class="lo-icon" style="background-image:url('/static/colibre/properties.svg')"></span></button>
                    <button type="button" class="lo-sb-tab" id="sb-tab-styles" data-sb-panel="Стили" title="Стили (F11)"><span class="lo-icon" style="background-image:url('/static/colibre/designerdialog.svg')"></span></button>
                    <button type="button" class="lo-sb-tab lo-btn-inert" data-lo-hint="Галерея не требуется на ОГЭ" title="Галерея"><span class="lo-icon" style="background-image:url('/static/colibre/gallery.svg')"></span></button>
                    <button type="button" class="lo-sb-tab lo-btn-inert" data-lo-hint="Навигатор не требуется на ОГЭ" title="Навигатор"><span class="lo-icon" style="background-image:url('/static/colibre/navigator.svg')"></span></button>
                </div>
            </div>
        </div>

        <!-- 5.5 Контекстная панель «Таблица» (tableobjectbar.xml LibreOffice 26.8) -->
        <div id="lo-table-toolbar" class="d-none align-items-center px-1 py-1 lo-toolbar border-top flex-wrap gap-0">
            <span class="badge bg-secondary rounded-0 me-1" style="font-size:10px; font-weight:500;">Таблица</span>
            <button type="button" class="lo-btn" id="btn-tbl-row-above" title="Строки выше"><span class="lo-icon" style="background-image: url('/static/colibre/rowabove.svg');"></span></button>
            <button type="button" class="lo-btn" id="btn-tbl-row-below" title="Строки ниже"><span class="lo-icon" style="background-image: url('/static/colibre/rowbelow.svg');"></span></button>
            <button type="button" class="lo-btn" id="btn-tbl-col-left" title="Столбцы перед"><span class="lo-icon" style="background-image: url('/static/colibre/colleft.svg');"></span></button>
            <button type="button" class="lo-btn" id="btn-tbl-col-right" title="Столбцы после"><span class="lo-icon" style="background-image: url('/static/colibre/colright.svg');"></span></button>
            <div class="lo-divider"></div>
            <button type="button" class="lo-btn" id="btn-tbl-row-del" title="Удалить строки"><span class="lo-icon" style="background-image: url('/static/colibre/rowdelete.svg');"></span></button>
            <button type="button" class="lo-btn" id="btn-tbl-col-del" title="Удалить столбцы"><span class="lo-icon" style="background-image: url('/static/colibre/coldelete.svg');"></span></button>
            <button type="button" class="lo-btn" id="btn-tbl-del" title="Удалить таблицу"><span class="lo-icon" style="background-image: url('/static/colibre/tabledelete.svg');"></span></button>
            <div class="lo-divider"></div>
            <button type="button" class="lo-btn" id="btn-tbl-sel-cell" title="Выделить ячейку (Ctrl+клик — выделить несколько)"><span class="lo-icon" style="background-image: url('/static/colibre/selectcell.svg');"></span></button>
            <button type="button" class="lo-btn" id="btn-tbl-sel-table" title="Выделить таблицу"><span class="lo-icon" style="background-image: url('/static/colibre/selecttable.svg');"></span></button>
