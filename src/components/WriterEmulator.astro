<link rel="stylesheet" href="/static/jodit/jodit.min.css" />
<script src="/static/bootstrap.bundle.min.js" is:inline></script>
<script src="/static/jodit/jodit.min.js" is:inline></script>

<script define:vars={{ missionName, hardcoreReset }}>
    let attempts = 0;
    let startTime = Date.now();
    let editor = null;
    let isNonPrintingActive = false;
    let isRulerActive = true;

    function sendTelemetry(actionType, status, success = false) {
        const msg = {
            type: 'TELEMETRY_EVENT',
            mission_name: missionName,
            action_type: actionType,
            status: status,
            start_time: new Date(startTime).toISOString(),
            time_spent_sec: Math.floor((Date.now() - startTime) / 1000),
            attempts_count: attempts,
            success: success
        };
        window.parent.postMessage(msg, '*');

        if (window.parent === window) {
            fetch('/api/telemetry', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    student_firstName: 'Test',
                    student_lastName: 'Student',
                    student_class: '7-класс',
                    course_slug: '7-класс',
                    lesson_id: '22',
                    level_number: 1,
                    mission_name: missionName,
                    action_type: actionType,
                    status: status,
                    time_spent_sec: Math.floor((Date.now() - startTime) / 1000),
                    attempts_count: attempts,
                    success: success,
                    is_hardcore: typeof localStorage !== 'undefined' && localStorage.getItem('hardcore_mode') === 'true'
                })
            }).catch(() => {});
        }
    }

    sendTelemetry('in_progress', 'in_progress');

    document.addEventListener('DOMContentLoaded', () => {
        // Инициализация Jodit без родного тулбара, так как мы отрисовали аутентичную панель LibreOffice
        editor = Jodit.make('#writer-editor', {
            theme: 'default',
            toolbar: false,
            toolbarSticky: false,
            showCharsCounter: false,
            showWordsCounter: false,
            showXPathInStatusbar: false,
            height: '100%',
            language: 'ru',
            events: {
                change: () => {
                    updateStatusbarWords();
                },
                afterInit: () => {
                    // Скрываем родной статусбар Jodit
                    const jsb = document.querySelector('.jodit-status-bar');
                    if (jsb) jsb.style.display = 'none';
                    updateStatusbarWords();
                }
            }
        });

        // Слушатель смены выделения в документе для обновления активных кнопок панели
        document.addEventListener('selectionchange', updateToolbarActiveStates);
        
        // Привязка действий тулбара и меню
        bindToolbarAndMenuActions();

        // Инициализация модалок Bootstrap
        initModals();

        // Зум листа
        initZoom();
    });

    function updateStatusbarWords() {
        if (!editor) return;
        const text = editor.text || '';
        const charsNoSpace = text.replace(/\s/g, '').length;
        const charsTotal = text.length;
        const words = text.trim() === '' ? 0 : text.trim().split(/\s+/).length;
        
        const sbWords = document.getElementById('statusbar-words');
        if (sbWords) {
            sbWords.innerText = `${words} слов, ${charsNoSpace} символов`;
        }

        // Статистика в модалке
        const statW = document.getElementById('stat-words');
        const statCNS = document.getElementById('stat-chars-nospace');
        const statCT = document.getElementById('stat-chars-total');
        const statP = document.getElementById('stat-paragraphs');
        if (statW) statW.innerText = words;
        if (statCNS) statCNS.innerText = charsNoSpace;
        if (statCT) statCT.innerText = charsTotal;
        if (statP && editor.editor) {
            const paras = editor.editor.querySelectorAll('p, h1, h2, h3, li');
            statP.innerText = Math.max(1, paras.length);
        }
    }

    // Подсветка активных кнопок форматирования в зависимости от положения курсора
    function updateToolbarActiveStates() {
        if (!editor || !document.activeElement) return;
        
        const isBold = document.queryCommandState('bold');
        const isItalic = document.queryCommandState('italic');
        const isUnderline = document.queryCommandState('underline');
        const isStrike = document.queryCommandState('strikethrough');
        const isSup = document.queryCommandState('superscript');
        const isSub = document.queryCommandState('subscript');
        const isJustifyLeft = document.queryCommandState('justifyleft');
        const isJustifyCenter = document.queryCommandState('justifycenter');
        const isJustifyRight = document.queryCommandState('justifyright');
        const isJustifyFull = document.queryCommandState('justifyfull');
        const isUL = document.queryCommandState('insertunorderedlist');
        const isOL = document.queryCommandState('insertorderedlist');

        toggleBtnActive('btn-bold', isBold);
        toggleBtnActive('btn-italic', isItalic);
        toggleBtnActive('btn-underline', isUnderline);
        toggleBtnActive('btn-strikethrough', isStrike);
        toggleBtnActive('btn-sup', isSup);
        toggleBtnActive('btn-sub', isSub);
        toggleBtnActive('btn-align-left', isJustifyLeft);
        toggleBtnActive('btn-align-center', isJustifyCenter);
        toggleBtnActive('btn-align-right', isJustifyRight);
        toggleBtnActive('btn-align-justify', isJustifyFull);
        toggleBtnActive('btn-ul', isUL);
        toggleBtnActive('btn-ol', isOL);
    }

    function toggleBtnActive(id, isActive) {
        const btn = document.getElementById(id);
        if (btn) {
            if (isActive) btn.classList.add('active');
            else btn.classList.remove('active');
        }
    }

    function bindToolbarAndMenuActions() {
        // --- СТАНДАРТНАЯ ПАНЕЛЬ И МЕНЮ ФАЙЛ ---
        const onNew = () => { if (confirm('Создать новый документ?')) editor.value = '<p></p>'; };
        document.getElementById('btn-new')?.addEventListener('click', onNew);
        document.getElementById('menu-file-new')?.addEventListener('click', onNew);

        const onOpen = () => { alert('LibreOffice Writer: функция открытия локального файла отключена в режиме тренажера.'); };
        document.getElementById('btn-open')?.addEventListener('click', onOpen);
        document.getElementById('menu-file-open')?.addEventListener('click', onOpen);

        // Загрузка типового образца текста для ОГЭ 13.2
        document.getElementById('menu-file-sample')?.addEventListener('click', () => {
            editor.value = `<p>Российская Федерация — крупнейшее государство мира, расположенное на востоке Европы и севере Азии. Территория страны составляет более 17 млн км² и омывается водами 12 морей.</p>
<table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
  <thead>
    <tr>
      <th style="border: 1px solid #000; padding: 6px; text-align: center; font-weight: bold;">Субъект РФ</th>
      <th style="border: 1px solid #000; padding: 6px; text-align: center; font-weight: bold;">Площадь (тыс. км²)</th>
      <th style="border: 1px solid #000; padding: 6px; text-align: center; font-weight: bold;">Население (млн чел.)</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td style="border: 1px solid #000; padding: 6px; text-align: left;">Москва</td>
      <td style="border: 1px solid #000; padding: 6px; text-align: center;">2.56</td>
      <td style="border: 1px solid #000; padding: 6px; text-align: center;">13.1</td>
    </tr>
    <tr>
      <td style="border: 1px solid #000; padding: 6px; text-align: left;">Санкт-Петербург</td>
      <td style="border: 1px solid #000; padding: 6px; text-align: center;">1.44</td>
      <td style="border: 1px solid #000; padding: 6px; text-align: center;">5.6</td>
    </tr>
  </tbody>
</table>`;
        });

        const onSave = () => {
            const blob = new Blob([editor.value], { type: 'text/html;charset=utf-8' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'document.html';
            a.click();
        };
        document.getElementById('btn-save')?.addEventListener('click', onSave);
        document.getElementById('menu-file-save')?.addEventListener('click', onSave);

        const onPrint = () => { window.print(); };
        document.getElementById('btn-print')?.addEventListener('click', onPrint);
        document.getElementById('btn-pdf')?.addEventListener('click', onPrint);
        document.getElementById('btn-printpreview')?.addEventListener('click', onPrint);
        document.getElementById('menu-file-print')?.addEventListener('click', onPrint);
        document.getElementById('menu-file-pdf')?.addEventListener('click', onPrint);

        // Буфер обмена и отмена
        document.getElementById('btn-undo')?.addEventListener('click', () => editor.execCommand('undo'));
        document.getElementById('menu-edit-undo')?.addEventListener('click', () => editor.execCommand('undo'));
        document.getElementById('btn-redo')?.addEventListener('click', () => editor.execCommand('redo'));
        document.getElementById('menu-edit-redo')?.addEventListener('click', () => editor.execCommand('redo'));

        document.getElementById('btn-cut')?.addEventListener('click', () => editor.execCommand('cut'));
        document.getElementById('menu-edit-cut')?.addEventListener('click', () => editor.execCommand('cut'));
        document.getElementById('btn-copy')?.addEventListener('click', () => editor.execCommand('copy'));
        document.getElementById('menu-edit-copy')?.addEventListener('click', () => editor.execCommand('copy'));
        document.getElementById('btn-paste')?.addEventListener('click', () => editor.execCommand('paste'));
        document.getElementById('menu-edit-paste')?.addEventListener('click', () => editor.execCommand('paste'));
        document.getElementById('menu-edit-selectall')?.addEventListener('click', () => editor.execCommand('selectall'));

        // Найти и заменить
        const onFind = () => {
            const query = prompt('Введите текст для поиска:');
            if (query) {
                const replaceWith = prompt(`Заменить "${query}" на:`);
                if (replaceWith !== null) {
                    editor.value = editor.value.split(query).join(replaceWith);
                }
            }
        };
        document.getElementById('btn-find')?.addEventListener('click', onFind);
        document.getElementById('menu-edit-find')?.addEventListener('click', onFind);

        // Непечатаемые символы (¶)
        const toggleNonPrinting = () => {
            isNonPrintingActive = !isNonPrintingActive;
            const container = document.getElementById('workspace-wrapper');
            const btn = document.getElementById('btn-nonprinting');
            if (isNonPrintingActive) {
                container?.classList.add('lo-show-nonprinting');
                btn?.classList.add('active');
            } else {
                container?.classList.remove('lo-show-nonprinting');
                btn?.classList.remove('active');
            }
        };
        document.getElementById('btn-nonprinting')?.addEventListener('click', toggleNonPrinting);
        document.getElementById('menu-view-nonprinting')?.addEventListener('click', toggleNonPrinting);

        // Переключение линейки
        document.getElementById('menu-view-ruler')?.addEventListener('click', () => {
            isRulerActive = !isRulerActive;
            const rContainer = document.getElementById('lo-ruler-container');
            const check = document.getElementById('ruler-check-mark');
            if (rContainer) rContainer.style.display = isRulerActive ? 'block' : 'none';
            if (check) check.innerText = isRulerActive ? '✓' : '';
        });

        // Полноэкранный режим
        document.getElementById('menu-view-fullscreen')?.addEventListener('click', () => {
            if (!document.fullscreenElement) {
                document.getElementById('editor-container')?.requestFullscreen().catch(() => {});
            } else {
                document.exitFullscreen().catch(() => {});
            }
        });

        // Вставка разрыва страницы и горизонтальной линии
        const onPageBreak = () => { editor.selection.insertHTML('<hr style="page-break-after: always; border: 1px dashed #999; margin: 20px 0;" />'); };
        document.getElementById('btn-pagebreak')?.addEventListener('click', onPageBreak);
        document.getElementById('menu-insert-pagebreak')?.addEventListener('click', onPageBreak);
        document.getElementById('menu-insert-hr')?.addEventListener('click', () => editor.selection.insertHTML('<hr />'));
        document.getElementById('btn-image')?.addEventListener('click', () => {
            const url = prompt('Введите URL изображения:');
            if (url) editor.selection.insertHTML(`<img src="${url}" style="max-width: 100%; height: auto;" />`);
        });

        // --- ПАНЕЛЬ ФОРМАТИРОВАНИЯ И МЕНЮ ФОРМАТ ---
        // Стиль абзаца
        document.getElementById('select-style')?.addEventListener('change', (e) => {
            const tag = e.target.value;
            editor.execCommand('formatBlock', false, tag);
        });

        // Гарнитура шрифта
        document.getElementById('select-font')?.addEventListener('change', (e) => {
            const font = e.target.value;
            editor.execCommand('fontname', false, font);
        });

        // Размер шрифта
        document.getElementById('select-fontsize')?.addEventListener('change', (e) => {
            const size = e.target.value;
            // Применяем CSS-размер шрифта к текущему выделению
            editor.selection.applyStyle({ fontSize: size });
        });

        // Форматирование текста
        const bindCmd = (btnId, menuId, cmd) => {
            const fn = () => { editor.execCommand(cmd); updateToolbarActiveStates(); };
            document.getElementById(btnId)?.addEventListener('click', fn);
            if (menuId) document.getElementById(menuId)?.addEventListener('click', fn);
        };
        bindCmd('btn-bold', 'menu-format-bold', 'bold');
        bindCmd('btn-italic', 'menu-format-italic', 'italic');
        bindCmd('btn-underline', 'menu-format-underline', 'underline');
        bindCmd('btn-strikethrough', 'menu-format-strikethrough', 'strikethrough');
        bindCmd('btn-sup', 'menu-format-sup', 'superscript');
        bindCmd('btn-sub', 'menu-format-sub', 'subscript');
        
        // Очистить прямое форматирование (Ctrl+M)
        const onClearFormat = () => {
            editor.execCommand('removeFormat');
            // Очищаем локальные инлайн-стили абзаца
            const block = editor.selection.current();
            if (block) {
                const p = block.closest('p, h1, h2, h3, li');
                if (p) {
                    p.style.textIndent = '';
                    p.style.lineHeight = '';
                    p.style.textAlign = '';
                    p.style.marginTop = '';
                    p.style.marginBottom = '';
                }
            }
        };
        document.getElementById('btn-eraser')?.addEventListener('click', onClearFormat);
        document.getElementById('menu-format-clear')?.addEventListener('click', onClearFormat);

        // Цвета
        document.getElementById('btn-fontcolor')?.addEventListener('click', () => {
            const color = prompt('Введите цвет текста (например: #ff0000, blue, black):', '#000000');
            if (color) editor.execCommand('foreColor', false, color);
        });
        document.getElementById('btn-backcolor')?.addEventListener('click', () => {
            const color = prompt('Введите цвет фона/выделения (например: yellow, #e0e0e0):', '#ffff00');
            if (color) editor.execCommand('hiliteColor', false, color);
        });

        // Выравнивание
        bindCmd('btn-align-left', 'menu-format-align-left', 'justifyleft');
        bindCmd('btn-align-center', 'menu-format-align-center', 'justifycenter');
        bindCmd('btn-align-right', 'menu-format-align-right', 'justifyright');
        bindCmd('btn-align-justify', 'menu-format-align-justify', 'justifyfull');

        // Списки
        document.getElementById('btn-ul')?.addEventListener('click', () => editor.execCommand('insertunorderedlist'));
        document.getElementById('btn-ol')?.addEventListener('click', () => editor.execCommand('insertorderedlist'));

        // Отступы
        document.getElementById('btn-outdent')?.addEventListener('click', () => editor.execCommand('outdent'));
        document.getElementById('btn-indent')?.addEventListener('click', () => editor.execCommand('indent'));

        // Междустрочный интервал
        document.querySelectorAll('[data-lineheight]').forEach(el => {
            el.addEventListener('click', (e) => {
                e.preventDefault();
                const lh = el.getAttribute('data-lineheight');
                applyParagraphStyle({ lineHeight: lh });
            });
        });

        // Межабзацный интервал
        document.getElementById('act-para-add-bottom')?.addEventListener('click', (e) => {
            e.preventDefault();
            applyParagraphStyle({ marginBottom: '6pt' });
        });
        document.getElementById('act-para-add-top')?.addEventListener('click', (e) => {
            e.preventDefault();
            applyParagraphStyle({ marginTop: '6pt' });
        });
        document.getElementById('act-para-remove')?.addEventListener('click', (e) => {
            e.preventDefault();
            applyParagraphStyle({ marginTop: '0', marginBottom: '0' });
        });

        // Клик по линейке для быстрой установки красной строки 1 см (ОГЭ)
        document.getElementById('ruler-first-line')?.addEventListener('click', () => {
            applyParagraphStyle({ textIndent: '1.0cm' });
            alert('LibreOffice: для текущего абзаца установлен отступ первой строки (красная строка) 1,00 см');
        });

        // Сервис: статистика
        const onWordCount = () => {
            updateStatusbarWords();
            const modalEl = document.getElementById('modal-wordcount');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('menu-tools-wordcount')?.addEventListener('click', onWordCount);
        document.getElementById('menu-tools-spelling')?.addEventListener('click', () => {
            alert('LibreOffice Writer: проверка правописания завершена. Ошибок не обнаружено.');
        });
        document.getElementById('menu-help-about')?.addEventListener('click', () => {
            alert('LibreOffice Writer Community 24.x\nЭмулятор офисного пакета для подготовки к ОГЭ по информатике (Задание 13.2)');
        });
    }

    let lastActivePara = null;

    // Применение стилей к текущему абзацу или группе выделенных абзацев
    function applyParagraphStyle(styles) {
        if (!editor) return;
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        if (!wysiwyg) return;

        let targets = [];
        const sel = editor.selection ? editor.selection.current() : null;
        if (sel) {
            const p = sel.closest ? sel.closest('p, h1, h2, h3, li') : (sel.parentElement ? sel.parentElement.closest('p, h1, h2, h3, li') : null);
            if (p) targets = [p];
        }
        if (targets.length === 0 && lastActivePara && document.contains(lastActivePara)) {
            targets = [lastActivePara];
        }
        if (targets.length === 0) {
            const allP = wysiwyg.querySelectorAll('p, h1, h2, h3, li');
            targets = allP.length > 0 ? Array.from(allP) : [wysiwyg];
        }

        targets.forEach(target => {
            if (styles.textIndent !== undefined) target.style.textIndent = styles.textIndent;
            if (styles.lineHeight !== undefined) target.style.lineHeight = styles.lineHeight;
            if (styles.textAlign !== undefined) target.style.textAlign = styles.textAlign;
            if (styles.marginTop !== undefined) target.style.marginTop = styles.marginTop;
            if (styles.marginBottom !== undefined) target.style.marginBottom = styles.marginBottom;
            if (styles.marginLeft !== undefined) target.style.marginLeft = styles.marginLeft;
            if (styles.marginRight !== undefined) target.style.marginRight = styles.marginRight;
        });
        updateStatusbarWords();
    }

    // Инициализация диалоговых окон
    function initModals() {
        // 1. Диалог «Абзац...»
        const openParaDialog = (e) => {
            if (e) e.preventDefault();
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            const sel = editor.selection ? editor.selection.current() : null;
            if (sel) {
                lastActivePara = sel.closest ? sel.closest('p, h1, h2, h3, li') : (sel.parentElement ? sel.parentElement.closest('p, h1, h2, h3, li') : null);
            }
            if (!lastActivePara && wysiwyg) {
                lastActivePara = wysiwyg.querySelector('p, h1, h2, h3, li');
            }
            const modalEl = document.getElementById('modal-paragraph');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('menu-format-paragraph')?.addEventListener('click', openParaDialog);

        document.getElementById('btn-apply-paragraph')?.addEventListener('click', () => {
            const firstLine = document.getElementById('dialog-para-firstline')?.value || '1.0';
            const left = document.getElementById('dialog-para-left')?.value || '0.0';
            const right = document.getElementById('dialog-para-right')?.value || '0.0';
            const top = document.getElementById('dialog-para-top')?.value || '0';
            const bottom = document.getElementById('dialog-para-bottom')?.value || '0';
            const lh = document.getElementById('dialog-para-lineheight')?.value || '1.0';
            const alignRadio = document.querySelector('input[name="dialog-align"]:checked')?.value || 'justify';

            applyParagraphStyle({
                textIndent: `${firstLine}cm`,
                marginLeft: `${left}cm`,
                marginRight: `${right}cm`,
                marginTop: `${top}pt`,
                marginBottom: `${bottom}pt`,
                lineHeight: lh,
                textAlign: alignRadio
            });

            // Закрываем модалку
            const modalEl = document.getElementById('modal-paragraph');
            if (modalEl && window.bootstrap) bootstrap.Modal.getInstance(modalEl)?.hide();
        });

        // 2. Диалог «Таблица...»
        const openTableDialog = (e) => {
            if (e) e.preventDefault();
            const modalEl = document.getElementById('modal-table');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('btn-table')?.addEventListener('click', openTableDialog);
        document.getElementById('menu-insert-table')?.addEventListener('click', openTableDialog);
        document.getElementById('menu-table-insert')?.addEventListener('click', openTableDialog);

        document.getElementById('btn-apply-table')?.addEventListener('click', () => {
            const cols = parseInt(document.getElementById('dialog-table-cols')?.value || '3', 10);
            const rows = parseInt(document.getElementById('dialog-table-rows')?.value || '3', 10);
            
            let html = '<table style="width: 100%; border-collapse: collapse; margin: 12px 0;"><thead><tr>';
            for (let c = 1; c <= cols; c++) {
                html += `<th style="border: 1px solid #000; padding: 6px; text-align: center; font-weight: bold; background: #fafafa;">Заголовок ${c}</th>`;
            }
            html += '</tr></thead><tbody>';
            for (let r = 1; r <= rows - 1; r++) {
                html += '<tr>';
                for (let c = 1; c <= cols; c++) {
                    html += `<td style="border: 1px solid #000; padding: 6px; text-align: left;">Ячейка ${r},${c}</td>`;
                }
                html += '</tr>';
            }
            html += '</tbody></table><p></p>';
            editor.selection.insertHTML(html);

            const modalEl = document.getElementById('modal-table');
            if (modalEl && window.bootstrap) bootstrap.Modal.getInstance(modalEl)?.hide();
        });

        // Операции над таблицей (строки / столбцы)
        document.getElementById('menu-table-row-above')?.addEventListener('click', () => {
            const cell = editor.selection.current()?.closest('td, th');
            if (cell) {
                const tr = cell.closest('tr');
                const newTr = tr.cloneNode(true);
                Array.from(newTr.children).forEach(td => td.innerHTML = '&nbsp;');
                tr.parentNode.insertBefore(newTr, tr);
            }
        });
        document.getElementById('menu-table-row-below')?.addEventListener('click', () => {
            const cell = editor.selection.current()?.closest('td, th');
            if (cell) {
                const tr = cell.closest('tr');
                const newTr = tr.cloneNode(true);
                Array.from(newTr.children).forEach(td => td.innerHTML = '&nbsp;');
                tr.after(newTr);
            }
        });
        document.getElementById('menu-table-row-delete')?.addEventListener('click', () => {
            editor.selection.current()?.closest('tr')?.remove();
        });
        document.getElementById('menu-table-delete')?.addEventListener('click', () => {
            editor.selection.current()?.closest('table')?.remove();
        });

        // 3. Диалог «Специальные символы...»
        const openSymbolsDialog = (e) => {
            if (e) e.preventDefault();
            const modalEl = document.getElementById('modal-symbols');
            if (modalEl && window.bootstrap) new bootstrap.Modal(modalEl).show();
        };
        document.getElementById('btn-symbol')?.addEventListener('click', openSymbolsDialog);
        document.getElementById('menu-insert-symbols')?.addEventListener('click', openSymbolsDialog);

        document.querySelectorAll('.lo-sym-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const sym = btn.getAttribute('data-sym');
                if (sym) editor.selection.insertHTML(sym);
                const modalEl = document.getElementById('modal-symbols');
                if (modalEl && window.bootstrap) bootstrap.Modal.getInstance(modalEl)?.hide();
            });
        });
    }

    // Зум (масштабирование страницы)
    function initZoom() {
        const slider = document.getElementById('zoom-slider');
        const valText = document.getElementById('zoom-val');
        const applyZoom = (val) => {
            valText.innerText = `${val}%`;
            const scale = val / 100;
            const wysiwyg = document.querySelector('.jodit-wysiwyg');
            if (wysiwyg) {
                wysiwyg.style.transform = `scale(${scale})`;
                wysiwyg.style.transformOrigin = 'top center';
            }
        };
        slider?.addEventListener('input', (e) => applyZoom(e.target.value));
        document.getElementById('zoom-in')?.addEventListener('click', () => {
            let v = Math.min(150, parseInt(slider.value, 10) + 10);
            slider.value = v;
            applyZoom(v);
        });
        document.getElementById('zoom-out')?.addEventListener('click', () => {
            let v = Math.max(50, parseInt(slider.value, 10) - 10);
            slider.value = v;
            applyZoom(v);
        });
    }

    // Валидация решения (кнопка ПРОВЕРИТЬ ДОКУМЕНТ)
    document.getElementById('check-btn').addEventListener('click', () => {
        if (!editor) return;
        attempts++;
        const wysiwyg = document.querySelector('.jodit-wysiwyg');
        const content = (wysiwyg && wysiwyg.innerHTML) ? wysiwyg.innerHTML : editor.value;
        const statusEl = document.getElementById('writer-status');
        
        const event = new CustomEvent('writer-check', { 
            detail: { 
                html: content, 
                resolve: (success, msg, isFinal = true) => {
                    if (success) {
                        statusEl.className = 'text-success fw-bold px-2';
                        statusEl.innerText = msg || '✅ Проверено. Задание выполнено!';
                        if (isFinal) {
                            sendTelemetry('level_complete', 'completed', true);
                        }
                    } else {
                        statusEl.className = 'text-danger fw-bold px-2';
                        statusEl.innerText = msg || '❌ Ошибка форматирования!';
                        sendTelemetry('hardcore_reset', 'in_progress', false);
                        if (hardcoreReset) {
                            editor.value = ''; 
                        }
                    }
                },
                editor: editor
            }
        });
        
        document.dispatchEvent(event);
    });
</script>

