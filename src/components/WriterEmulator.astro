            <button type="button" class="lo-btn lo-btn-inert" data-lo-hint="Панель исправлений не требуется" title="Панель исправлений (не используется)"><span class="lo-icon" style="background-image: url('/static/colibre/trackchanges.svg');"></span></button>
            <div class="lo-divider"></div>
            <button type="button" class="lo-btn lo-btn-inert" data-lo-hint="Инструменты рисования не используются в ОГЭ 13.2" title="Линия (не используется)"><span class="lo-icon" style="background-image: url('/static/colibre/line.svg');"></span></button>
            <button type="button" class="lo-btn lo-btn-inert" data-lo-hint="Фигуры не используются в ОГЭ 13.2" title="Основные фигуры (не используется)"><span class="lo-icon" style="background-image: url('/static/colibre/shapes.svg');"></span></button>
            <button type="button" class="lo-btn lo-btn-inert" data-lo-hint="Панель рисования не требуется" title="Панель рисования (не используется)"><span class="lo-icon" style="background-image: url('/static/colibre/draw.svg');"></span></button>
            <div class="lo-divider"></div>
            <button type="button" class="lo-btn" id="btn-fullscreen" title="Во весь экран (F11)"><span class="lo-icon" style="background-image: url('/static/colibre/fullscreen.svg');"></span></button>
        </div>

        <!-- 3. Панель инструментов 2: «Форматирование» (textobjectbar.xml LibreOffice 26.8) -->
        <div class="d-flex align-items-center px-1 py-1 lo-toolbar border-bottom flex-wrap gap-0" id="lo-formatting-toolbar">
            <!-- Стиль абзаца -->
            <select id="select-style" class="lo-select me-1" style="width: 132px;" title="Стиль абзаца">
                <option value="p">Базовый</option>
                <option value="p">Основной текст</option>
                <option value="h1">Заголовок 1</option>
                <option value="h2">Заголовок 2</option>
                <option value="h3">Заголовок 3</option>
            </select>
            <button type="button" class="lo-btn lo-btn-inert" data-lo-hint="Обновление стилей отключено" title="Обновить выбранный стиль"><span class="lo-icon" style="background-image: url('/static/colibre/styleupdate.svg');"></span></button>
            <button type="button" class="lo-btn lo-btn-inert" data-lo-hint="Создание стилей отключено" title="Создать стиль по выбранному"><span class="lo-icon" style="background-image: url('/static/colibre/stylenew.svg');"></span></button>
            <div class="lo-divider"></div>

            <!-- Гарнитура шрифта (по умолчанию Liberation Sans - сырой режим) -->
