            <!-- Размер шрифта (по умолчанию 11 пт - сырой режим) -->
            <select id="select-fontsize" class="lo-select" style="width: 72px;" title="Кегль">
                <option value="8pt">8 пт</option>
                <option value="9pt">9 пт</option>
                <option value="10pt">10 пт</option>
